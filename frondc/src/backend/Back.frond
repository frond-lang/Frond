// backend/Back.frond — Stage 2 Back lowering 切片 0+1+2(BOOTSTRAP_PLAN 八/附八):
// 切片 0:字面量/一元负/算术/比较/位运算/AsCast/局部 val/var + return;
// 切片 1:IfE 值表达式(槽位+merge)/块作用域(副本式)/while/loop/
// break/continue/&&-|| 短路/入口模块多函数(原型先行互递归)+ CallE,
// 经 sema(已单态化、类型完备)直接 lower 成 LLVM IR 的 SSA → verify
// → default<O2>(mem2reg 吃掉 naive alloca)→ TargetMachine emit .obj。
// 切片 2:record/数组/str 三聚合(附八)——值 = opaque ptr(引用语义,
// 镜像引擎 Arc 单块共享),分配走 bump arena(§2 策略丙:@frond_heap
// 1GiB .bss + @frond_heap_top + frond_alloc,零外部符号)。
//
// 值表示(切片 2,附八裁决):record = ptr → 字面 struct {f0,...}
// (字段序 = ctor 声明序);str = ptr → {i64 len, [N x i8] bytes}
// (字面量 = 私有全局常量块);数组 = ptr → {i64 len, elem...} 弹性尾
// (ArrayLitE 经 frond_alloc 运行时构造,原地写语义)。标量维持切片 0/1
// SSA/栈槽不动。布局键:str 值 = "ptr"(opaque 单例)/record 布局 =
// "prec:{detail_id}"/str 块 = "strblk:{N}"。
//
// 工程约束(handleprobe 实证 2026-09-04):LLVM u64 句柄经局部值/函数
// 参数/函数返回/数组/List/Map/nullable/模块 var 读回后 FFI marshal 全部
// 安全;**record 字段读回是软类型值,call 收 0**(引擎已知洞)——本文件
// 一切状态(Map 槽表/类型缓存/计数器)不得使用含 u64 字段的 record。
//
// 错误通道:统一 Throw<_, FfiError>;切片边界(不支持的节点/类型/
// 转型)以 FfiError(Other, "...") 报出,消息带节点 id 与模块名。
//
// 语义记账(切片 0 有界差异,均待 frond_rt/后续切片收编):
// - 整型溢出 = 环绕(无 nsw/nuw);除零/移位越界 = LLVM UB(C 语义);
// - f128 字面量经 LLVMConstRealOfString 全精度,不经 double 中转;
// - usize/isize 与 char 按位宽并入整型族(char = i32 无符号码点;
//   usize/isize = host 词长,交叉目标未开);
// - 切片 2:arena 不回收(4e 已接受,v0 可泄漏);str 拼接/索引/切片、
//   数组 ++/push、多 ctor ADT/match、nullable 族、引用、RecordLitE/
//   RecordExtendE、深相等、跨模块与 monomorph——响亮报错,后续切片。
import backend.Llvm
import backend.Toolchain
import syntax.Ast
import sema.Semares
import sema.Envs
import sema.Ictx
import sema.Data
import sema.Mono
import sema.Typeast
import types.Arena
import types.Ty
import std.collections.List
import std.collections.Map
import std.os.Env

// ── 类型分类(纯函数)──────────────────────────────────────────────

// 类型分类标签(0=int 1=float 2=bool 3=char 4=void 5=str 6=array
// 7=record -1=其他)。不返回 ADT:frondc 模块规模下 match 臂返回裸零参
// 变体会被静默吞成 null(引擎洞,handleprobe 小规模复刻不触发,
// 2026-09-04 实证);整数字面量臂稳定。
// 切片 6c:方法分派——(canonical 类型名\0方法名)→ fn 行。方法以
// 独立函数发射(名 frond_m_<Type>_<method>),this 作首参注入
// (槽名 "this");trait 默认方法默认体按 TDefI 实例同型注册
// (_d 后缀),自有方法声明优先。
var method_rows: Map<str, i64> = Map.empty<str, i64>()

// 切片 6c:方法体 this 上下文(发射期置位;expr_ty/Ident/lower_call
// 查询位消费)。
var cur_this_slot: u64 = 0
var cur_this_h: u32 = 0
// 切片 6d:可达性发射(声明提前:mark_reachable 消费)。
var work_rows: List<i64> = List.empty<i64>()
var work_marked: Map<str, bool> = Map.empty<str, bool>()

// 切片 6d:rt_itoa 单件句柄(声明提前:MethodCallE 位消费)。
var itoa_fn: u64 = 0

// 切片 6d:标记可达行(未标记才入队)。
fun mark_reachable(ri: usize): void {
    val key = "{ri}"
    if work_marked.get(key) == null {
        work_marked.set(key, true)
        work_rows.push(ri as i64)
    }
}


// 切片 6d:@extern("C") 表(name → LLVM 句柄/函数型/Frond 参数型列;
// 调用点按 C ABI 编组:str = (data, len) 双参)。
var cur_is_windows: bool = false
var extern_llvm: Map<str, u64> = Map.empty<str, u64>()
var extern_fts: Map<str, u64> = Map.empty<str, u64>()
var extern_params: Map<str, u32[]> = Map.empty<str, u32[]>()
// 切片 6e:extern 返回 void 表(建后清名纪律,切片 5 同款)。
var extern_voids: Map<str, bool> = Map.empty<str, bool>()
// 切片 6e:构造点实参反推的类型覆写表(module\u{0}expr → 句柄);实例
// 发射窗口(重放→lower)内有效,窗口切换清空(expr_ty 先于 6e 状态区
// 引用,故住顶部区)。
var ty_overlay: Map<str, u32> = Map.empty<str, u32>()
// ── 切片 6g:模块级 var/val(全局槽)──────────────────────────────
// 引擎口径(Core.rs 0b):入口函数体前按收集序初始化全部模块顶层
// var/val(global_store);所有函数经 global_load 读写。模块级 var 在
// decls 里 = ExprDeclD(expr, stmt) 包裹的 VarDeclS/ValDeclS。
// native 镜像:LLVM private 全局 + main 入口序初始化;键 = 模块名
// + NUL + 名(主)+ 裸名(首胜别名)。类型 = 注解优先(无注解 =
// init 求值时补)。
var gvar_slots: Map<str, u64> = Map.empty<str, u64>()
var gvar_tys: Map<str, u32> = Map.empty<str, u32>()
var gvar_n: i64 = 0

fun collect_gvars(lib: Lib, ctx: u64, module: u64, a: TypeArena, s: SemaRes,
    cache: Map<str, u64>, mods: List<ModuleAst>): Throw<void, FfiError> {
    gvar_slots = Map.empty<str, u64>()
    gvar_tys = Map.empty<str, u32>()
    var mi: usize = 0
    while mi < mods.len() {
        val m = mods.get(mi) ?? (mods.get(0) ?? ModuleAst("", null,
            AstArena(List.empty<Se>(), List.empty<Ss>(), List.empty<St>(), List.empty<Spn>()), []))
        var di: usize = 0
        while di < m.decls.len() {
            match m.decls[di].decl {
                ExprDeclD(_, stmt0) => {
                    match stmt0 {
                        null => {}
                        st0 => {
                            match m.arena.stmt(st0 ?? 0).node {
                                VarDeclS(name, ta, _, _) | ValDeclS(name, ta, _, _) => {
                                    collect_one_gvar(lib, ctx, module, a, s, cache, m, name, ta)?
                                },
                                _ => {},
                            }
                        },
                    }
                },
                _ => {},
            }
            di = di + 1
        }
        mi = mi + 1
    }
    Ok(void)
}

fun collect_one_gvar(lib: Lib, ctx: u64, module: u64, a: TypeArena, s: SemaRes,
    cache: Map<str, u64>, m: ModuleAst, name: str, ta: i64?): Throw<void, FfiError> {
    // 型:注解优先;无注解槽型 i8 哑(init 序补)。
    var th = 0u32
    match ta {
        null => {}
        t0 => { th = type_repr_h(a, s, m.arena, t0 ?? 0) }
    }
    val key = "{m.name}\u{0}{name}"
    if gvar_slots.get(key) == null {
        val lt = if th != 0 {
            llty_for_h(lib, ctx, cache, a, s, th)?
        } else {
            llty_for(lib, ctx, cache, TI8)?
        }
        gvar_n = gvar_n + 1
        val g = Llvm.add_global(lib, module, lt, "frond_gv{gvar_n}")?
        Llvm.set_linkage_private(lib, g)?
        Llvm.set_initializer(lib, g, Llvm.const_null(lib, lt)?)?
        gvar_slots.set(key, g)
        if th != 0 {
            gvar_tys.set(key, th)
        }
        if gvar_slots.get(name) == null {
            gvar_slots.set(name, g)
            if th != 0 {
                gvar_tys.set(name, th)
            }
        }
    }
    Ok(void)
}

// 注解 AST → 句柄(注册期;inst_param_ty 空 tps/args = 名字占位解析)。
fun type_repr_h(a: TypeArena, s: SemaRes, ast: AstArena, tn: i64): u32 {
    sanitize_arg(a, s, inst_param_ty(a, s, ast, tn, [], []))
}

// 全局槽查找(out-param 全局模式,house place_ptr/place_ty 同款)。
var gv_ptr: u64 = 0
var gv_key: str = ""

fun find_gvar(mname: str, name: str): bool {
    gv_key = "{mname}\u{0}{name}"
    match gvar_slots.get(gv_key) {
        null => {
            gv_key = name
            match gvar_slots.get(name) {
                null => { return false }
                g1 => { gv_ptr = g1 ?? 0 }
            }
        }
        g0 => { gv_ptr = g0 ?? 0 }
    }
    true
}

// 切片 6f:当前发射行的类型参绑定上下文(自由函数实例行与方法实例行
// 发射前置位;名字 → 实参句柄)。幽灵实例派生(List.empty() 的 K →
// str)按名代换的键源。
var cur_gtps: str[] = []
var cur_gargs: u32[] = []
// 切片 6g:当前发射函数引用(conv 内建块用,免穿参)。
var cur_fn_ref: u64 = 0
// 切片 6f:当前发射行的体上下文(语句/表达式扫描源)+ 扫描结果暂存。
var cur_body_eid: i64 = 0
var cur_farena: AstArena? = null
var gu_bind_name: str = ""
var gu_use_found: bool = false
var gu_use_method: str = ""
var gu_use_args: i64[] = []
var gu_target_eid: i64 = -1

// 切片 6b 续:嵌套泛型调用点物化用声明表(lower_entry 装配后置位;
// expr_ty 查询位消费——inst 模式重放跳 unify,内层泛型调用的记录型
// 是悬空 fresh var,从路由实例物化真型)。
var cur_ftab: Mono.FTabs? = null

pub fun ty_kind(t: Ty): i64 {
    match t {
        TBool => 2
        TChar => 3
        TI8 | TI16 | TI32 | TI64 | TI128 => 0
        TU8 | TU16 | TU32 | TU64 | TU128 => 0
        TIsize | TUsize => 0
        TF16 | TF32 | TF64 | TF128 => 1
        TVoid => 4
        TStr => 5
        TArray(_) => 6
        TRecord(_) => 7
        _ => -1
    }
}

// 整型位宽(char 计 32)。
pub fun ty_bits(t: Ty): i64 {
    match t {
        TBool => 1
        TChar => 32
        TI8 | TU8 => 8
        TI16 | TU16 => 16
        TI32 | TU32 => 32
        TI64 | TU64 | TIsize | TUsize => 64
        _ => 128
    }
}

pub fun ty_signed(t: Ty): bool {
    match t {
        TU8 | TU16 | TU32 | TU64 | TU128 | TUsize => false
        TBool | TChar => false
        _ => true
    }
}

pub fun ty_float_bits(t: Ty): i64 {
    match t {
        TF16 => 16
        TF32 => 32
        TF64 => 64
        _ => 128
    }
}

// 整型族(含 char:i32 无符号码点)——宽窄/符号转型走同一条整型路径。
pub fun is_intish(t: Ty): bool {
    val k = ty_kind(t)
    k == 0 || k == 3
}

// LLVM 类型(context-scoped;LLVM 自身驻留,Map 缓存只省重复 FFI)。
// 键 = 展示名;cache 值为句柄(Map 值通道,handleprobe 实证安全)。
pub fun llty_key(t: Ty): str {
    val k = ty_kind(t)
    if k == 2 {
        "i1"
    } else if k == 3 {
        "i32c"
    } else if k == 0 {
        "i{ty_bits(t)}"
    } else if k == 1 {
        "f{ty_float_bits(t)}"
    } else {
        "?"
    }
}

pub fun llty_for(lib: Lib, ctx: u64, cache: Map<str, u64>, t: Ty): Throw<u64, FfiError> {
    val key = llty_key(t)
    match cache.get(key) {
        null => {}
        h => { return Ok(h ?? 0) }
    }
    val k0 = ty_kind(t)
    val built = if k0 == 2 {
        Llvm.int_type(lib, ctx, 1u32)?
    } else if k0 == 3 {
        Llvm.int_type(lib, ctx, 32u32)?
    } else if k0 == 0 {
        Llvm.int_type(lib, ctx, ty_bits(t) as u32)?
    } else if k0 == 1 {
        if ty_float_bits(t) == 16 {
            Llvm.half_type(lib, ctx)?
        } else if ty_float_bits(t) == 32 {
            Llvm.float_type(lib, ctx)?
        } else if ty_float_bits(t) == 64 {
            Llvm.double_type(lib, ctx)?
        } else {
            Llvm.fp128_type(lib, ctx)?
        }
    } else {
        throw FfiError(Other, "slice 0: unsupported type for LLVM lowering: {ty_variant_name(t)}")
    }
    cache.set(key, built)
    Ok(built)
}

// 类型变体名(诊断专用:llty_for 兜底报错定位非标量类型形态)。
fun ty_variant_name(t: Ty): str {
    match t {
        TVoid => "TVoid"
        TStr => "TStr"
        TNull => "TNull"
        TLib => "TLib"
        TThrow(_) => "TThrow"
        TChannel(_) => "TChannel"
        TAsync(_) => "TAsync"
        TLazy(_) => "TLazy"
        TAtomic(_) => "TAtomic"
        TSender(_) => "TSender"
        TReceiver(_) => "TReceiver"
        TForeignFn(_) => "TForeignFn"
        TTimer(_) => "TTimer"
        TArray(_) => "TArray"
        TRef(_) => "TRef"
        TFn(_) => "TFn"
        TNullable(_) => "TNullable"
        TAdt(_) => "TAdt"
        TRecord(_) => "TRecord"
        TTrait(_) => "TTrait"
        TTraitObject(_) => "TTraitObject"
        TModuleRef(_) => "TModuleRef"
        TGeneric(_) => "TGeneric"
        TNever => "TNever"
        TTypeVar(_) => "TTypeVar"
        TUnknown => "TUnknown"
        _ => "?"
    }
}

// ── 聚合类型映射(切片 2,附八)───────────────────────────────────

// 聚合值形态 = opaque ptr(str/数组/record/多 ctor ADT/nullable 五形态
// 统一;opaque ptr 在 context 内单例,缓存键 "ptr" 共享)。
fun is_agg_kind(k: i64): bool {
    k == 5 || k == 6 || k == 7 || k == 8 || k == 9 || k == 10
}

fun opaque_ptr(lib: Lib, ctx: u64, cache: Map<str, u64>): Throw<u64, FfiError> {
    match cache.get("ptr") {
        null => {
            val p = Llvm.ptr_type(lib, ctx)?
            cache.set("ptr", p)
            Ok(p)
        }
        h => Ok(h ?? 0)
    }
}

// 句柄聚合分类(切片 2/3/6e):ty_kind 的名义扩展——TAdt 且类型名为单
// ctor 非泛型聚合(record_shape 命中)→ 7;多 ctor 非泛型 TAdt(kind==
// TAdt 且 constructors.len()>1)→ 8(切片 3:per-ctor struct {i64 tag,
// ...});TNullable → 9(切片 3:2-ctor 特例 {i64 tag, payload},tag0=
// null)。切片 6e:泛型实例 TAdt(canonical, args≠∅)同面收编——单
// ctor record → 7 / 多 ctor ADT → 8(布局与字段访问按 type_params →
// args 代换,布局键含实参)。其余 TAdt(别名/newtype/未知名)→ -1,
// lowering 触点响亮报错。TRecord(detail)保持 ty_kind 直判。
pub fun agg_kind(a: TypeArena, s: SemaRes, h: u32): i64 {
    val rh = Arena.resolve(a, h)
    val raw = Arena.get(a, rh)
    val k = ty_kind(raw)
    if k >= 0 {
        return k
    }
    match raw {
        TNullable(_) => 9
        TThrow(_) => 10
        // 切片 6g:TGeneric(用户泛型聚合)≡ TAdt —— 声明位 List<Se> 可被
        // 存成 TGeneric(Typeast 回落:canonical 解析在模块名==类型名时
        // 拼错键,has_params 误判)。值形态同为 ptr;名字经 glob/双键表
        // 可查,分类与 TAdt 同径。
        TGeneric(_) => {
            val gparts = Arena.generic_parts(a, rh)
            match Semares.get_type_def(s, gparts.a) {
                null => -1
                gd0 => {
                    val gd = gd0 ?? Data.TDef("", Data.TAlias, [], [], null, null, [], [])
                    if gd.constructors.len() != 1 {
                        if gd.kind == Data.TAdt && gd.constructors.len() > 1 {
                            8
                        } else {
                            -1
                        }
                    } else {
                        if gd.kind == Data.TRecord || gd.kind == Data.TAdt {
                            7
                        } else {
                            -1
                        }
                    }
                },
            }
        },
        TAdt(_) => {
            val parts = Arena.adt_parts(a, rh)
            match Semares.get_type_def(s, parts.a) {
                null => {
                    if Semares.type_def_is_multi_ctor_adt(s, parts.a) {
                        8
                    } else {
                        -1
                    }
                }
                d0 => {
                    val d = d0 ?? Data.TDef("", Data.TAlias, [], [], null, null, [], [])
                    if d.constructors.len() != 1 {
                        if d.kind == Data.TAdt && d.constructors.len() > 1 {
                            8
                        } else {
                            -1
                        }
                    } else {
                        if d.kind == Data.TRecord || d.kind == Data.TAdt {
                            7
                        } else {
                            -1
                        }
                    }
                },
            }
        },
        _ => -1
    }
}

// 句柄形态的类型映射(聚合 → opaque ptr;标量回落 llty_for)。TArray
// 元素未定长(size=null)在此不炸——值形态只看 ptr;元素访问另有校验。
pub fun llty_for_h(lib: Lib, ctx: u64, cache: Map<str, u64>, a: TypeArena, s: SemaRes, h: u32): Throw<u64, FfiError> {
    if is_agg_kind(agg_kind(a, s, h)) {
        return opaque_ptr(lib, ctx, cache)
    }
    // 切片 6e:void 值位(引擎合法:`val x = void调用()`,x 不可用)
    // —— i8 哑位(conv void→void 恒等,store 哑值)。
    if ty_kind(Arena.get(a, Arena.resolve(a, h))) == 4 {
        return llty_for(lib, ctx, cache, TI8)
    }
    llty_for(lib, ctx, cache, Arena.get(a, Arena.resolve(a, h)))
}

// record 名义类型句柄的 ADT 名(record 布局/字段访问的公用入口):
// TAdt → detail 名(切片 6e:泛型实例同用——名字携带,实参代换由
// 布局/字段触点自理);TRecord(结构 record,RecordLitE 族)无名义,
// null——本切片构造面不走此形态。
pub fun record_name_of(a: TypeArena, h: u32): str? {
    val rh = Arena.resolve(a, h)
    match Arena.get(a, rh) {
        TAdt(_) => {
            Arena.adt_parts(a, rh).a
        },
        TGeneric(_) => {
            Arena.generic_parts(a, rh).a
        },
        _ => null,
    }
}

// record 布局 {f0,...}(字段序 = ctor 声明序 = record_field_idx 口径;
// 字段值形态:标量 = 本体,聚合 = ptr)。名义键 prec:{name}——构造器
// 调用推断产 TAdt(detail 只挂名,detail id 每次推断新分配,不可作键);
// 同名即同型(切片 2 非泛型约束),跨模块同构各自成键无害。
pub fun record_layout(lib: Lib, ctx: u64, cache: Map<str, u64>, a: TypeArena, s: SemaRes, name: str): Throw<u64, FfiError> {
    val key = "prec:{name}"
    match cache.get(key) {
        null => {}
        h => { return Ok(h ?? 0) }
    }
    match Semares.record_shape(s, name) {
        null => throw FfiError(Other, "slice 2: '{name}' is not a single-constructor non-generic record")
        fts0 => {
            val fts = fts0 ?? []
            if fts.len() == 0 {
                val lt = Llvm.struct_type0(lib, ctx)?
                cache.set(key, lt)
                return Ok(lt)
            }
            var ftys: u64[] = []
            var i: usize = 0
            while i < fts.len() {
                ftys = ftys ++ [llty_for_h(lib, ctx, cache, a, s, fts[i])?]
                i = i + 1
            }
            val lt = Llvm.struct_type(lib, ctx, ftys)?
            cache.set(key, lt)
            Ok(lt)
        },
    }
}

// 切片 6e:泛型实例 record 布局——句柄入口(名字布局的泛型扩展)。
// 无实参 TAdt → 原 record_layout;泛型实例 = 声明字段经
// type_params → args 代换后的 {f0,...};键 = "prec:" + ty_key
// (实参感知,同型不同实参各自成键)。
fun record_layout_h(lib: Lib, ctx: u64, cache: Map<str, u64>, a: TypeArena, s: SemaRes,
    h: u32): Throw<u64, FfiError> {
    val rh = Arena.resolve(a, h)
    match Arena.get(a, rh) {
        TAdt(_) => {
            val parts = Arena.adt_parts(a, rh)
            if parts.b.len() == 0 {
                return record_layout(lib, ctx, cache, a, s, parts.a)
            }
            val key = "prec:" + ty_key(a, s, rh)
            match cache.get(key) {
                null => {}
                h0 => { return Ok(h0 ?? 0) }
            }
            match Semares.get_type_def(s, parts.a) {
                null => throw FfiError(Other, "slice 6e: unknown generic aggregate '{parts.a}'")
                d0 => {
                    val d = d0 ?? Data.TDef("", Data.TAlias, [], [], null, null, [], [])
                    if d.constructors.len() != 1 {
                        throw FfiError(Other, "slice 6e: '{parts.a}' is not single-constructor (generic layouts)")
                    }
                    val fts = d.constructors[0].field_types
                    if fts.len() == 0 {
                        val lt = Llvm.struct_type0(lib, ctx)?
                        cache.set(key, lt)
                        return Ok(lt)
                    }
                    var ftys: u64[] = []
                    var i: usize = 0
                    while i < fts.len() {
                        ftys = ftys ++ [llty_for_h(lib, ctx, cache, a, s,
                            sanitize_arg(a, s, subst_ty(a, d.type_params, parts.b, fts[i])))?]
                        i = i + 1
                    }
                    val lt = Llvm.struct_type(lib, ctx, ftys)?
                    cache.set(key, lt)
                    Ok(lt)
                },
            }
        },
        _ => record_layout(lib, ctx, cache, a, s, record_name_of(a, rh) ?? "?"),
    }
}

// str 块布局 {i64, [N x i8]}(字面量全局常量与堆拷贝共用的头部形态;
// len 在 offset 0,字节在 offset 8)。
pub fun str_layout(lib: Lib, ctx: u64, cache: Map<str, u64>, n: usize): Throw<u64, FfiError> {
    val key = "strblk:{n}"
    match cache.get(key) {
        null => {}
        h => { return Ok(h ?? 0) }
    }
    val i64ty = llty_for(lib, ctx, cache, TI64)?
    val i8ty = llty_for(lib, ctx, cache, TI8)?
    val bytes = Llvm.array_type2(lib, i8ty, n as u64)?
    val lt = Llvm.struct_type(lib, ctx, [i64ty, bytes])?
    cache.set(key, lt)
    Ok(lt)
}

// ── 聚合类型映射(切片 3,附九)───────────────────────────────────
// 多 ctor ADT = ptr → per-ctor struct {i64 tag, f0, f1, ...}(B 案,
// 探针实测裁决:复用 record struct 全链 + per-ctor 精确尺寸;tag@0 =
// 构造器在 TDef.constructors 里的 0 基索引,payload 字段从 1 起)。
// T? = ptr → {i64 tag, T payload}(2-ctor 特例:tag0=null,tag1=值);
// null = 每类型一个私有 zeroinit 全局常量块(零 arena 消耗)。

// 类型结构键(nullable 布局/null 常量的缓存键:句柄 id 不稳定——
// TAdt/TNullable 每次推断新分配,双份句柄同型不同 id)。
// 切片 6e:命名空间接收者路径段(Ident/字段链,源序;镜像
// recv_path_segments 的 Back 侧等价——FTabs 路径后缀匹配的输入)。
fun recv_segs(ast: AstArena, recv0: i64): str[]? {
    val rev = List.empty<str>()
    var recv = recv0
    var go = true
    while go {
        match ast.expr(recv).node {
            Ident(name) => {
                rev.push(name)
                go = false
            },
            FieldAccessE(r, field) => {
                rev.push(field)
                recv = r
            },
            _ => { return null }
        }
    }
    var out: str[] = []
    var i: i64 = rev.len() as i64 - 1
    while i >= 0 {
        out = out ++ [rev.get(i as usize) ?? ""]
        i = i - 1
    }
    if out.len() == 0 {
        null
    } else {
        if true { out } else { null }
    }
}

// 切片 6e:泛型实例代换——声明位类型(ctor 字段/方法签名)的
// TAdt("T") 名字占位按 type_params → type_args 代换;结构族(数组/
// nullable/throw/泛型聚合实参)递归;标量与无参聚合原样。代换键 =
// 名字(探针实证:声明字段类型里 T = TAdt 名字占位,非刚性 tvar)。
fun subst_ty(a: TypeArena, tps: str[], args: u32[], h: u32): u32 {
    subst_ty_d(a, tps, args, h, 10i64)
}

// 深度上限版(循环类型防御:超深原样返回——泛型声明字段深度事实有界)。
fun subst_ty_d(a: TypeArena, tps: str[], args: u32[], h: u32, depth: i64): u32 {
    if depth <= 0 {
        return h
    }
    val r = Arena.resolve(a, h)
    val raw = Arena.get(a, r)
    // 名字命中。
    var hit: i64 = -1
    match raw {
        TAdt(_) => {
            val p = Arena.adt_parts(a, r)
            if p.b.len() == 0 {
                var k: usize = 0
                while k < tps.len() {
                    if tps[k] == p.a {
                        hit = k as i64
                    }
                    k = k + 1
                }
            }
        },
        TGeneric(_) => {
            val p2 = Arena.generic_parts(a, r)
            if p2.b.len() == 0 {
                var k2: usize = 0
                while k2 < tps.len() {
                    if tps[k2] == p2.a {
                        hit = k2 as i64
                    }
                    k2 = k2 + 1
                }
            }
        },
        _ => {},
    }
    if hit >= 0 && (hit as usize) < args.len() {
        return args[hit as usize]
    }
    // 结构族递归。
    match raw {
        TArray(_) => {
            val pp = Arena.array_parts(a, r)
            Arena.make_array(a, subst_ty_d(a, tps, args, pp.a, depth - 1), pp.b)
        },
        TNullable(_) => {
            Arena.make_nullable(a, subst_ty_d(a, tps, args, Arena.nullable_inner(a, r), depth - 1))
        },
        TThrow(_) => {
            val tp = Arena.thr_parts(a, r)
            Arena.make_throw(a, subst_ty_d(a, tps, args, tp.a, depth - 1), subst_ty_d(a, tps, args, tp.b, depth - 1))
        },
        TAdt(_) => {
            val p = Arena.adt_parts(a, r)
            var na: u32[] = []
            var i: usize = 0
            while i < p.b.len() {
                na = na ++ [subst_ty_d(a, tps, args, p.b[i], depth - 1)]
                i = i + 1
            }
            Arena.make_adt(a, p.a, na)
        },
        TGeneric(_) => {
            val p2 = Arena.generic_parts(a, r)
            var na2: u32[] = []
            var i2: usize = 0
            while i2 < p2.b.len() {
                na2 = na2 ++ [subst_ty_d(a, tps, args, p2.b[i2], depth - 1)]
                i2 = i2 + 1
            }
            Arena.make_generic(a, p2.a, na2)
        },
        _ => r,
    }
}

// 切片 6e:泛型聚合句柄的 (type_params, 实参) 对——TAdt(canonical,
// args);canonical 取 TDef 查 type_params。非泛型/非 TAdt = null。
fun generic_bind_of(a: TypeArena, s: SemaRes, h: u32): TPair? {
    val r = Arena.resolve(a, h)
    match Arena.get(a, r) {
        TAdt(_) => {
            val p = Arena.adt_parts(a, r)
            match Semares.get_type_def(s, p.a) {
                null => {}
                d0 => {
                    val d = d0 ?? Data.TDef("", Data.TAlias, [], [], null, null, [], [])
                    if d.type_params.len() > 0 {
                        return if true { TPair(d.type_params, p.b) } else { null }
                    }
                },
            }
        },
        _ => {},
    }
    null
}

// 切片 6e:泛型构造实例实参反推——声明字段类型(TAdt("T") 名字占位)
// 与调用点实参类型结构对位:field T[] ~ arg i32[] → T:=i32;直撞
// field K ~ arg str → K:=str。多字段重复命中取首解;未命中位 = 0
// 占位(触点响亮报错)。
fun infer_ctor_args(a: TypeArena, s: SemaRes, tps: str[], fts: u32[], arghs: u32[]): u32[] {
    var args: u32[] = []
    var ti: usize = 0
    while ti < tps.len() {
        var bound: u32 = 0
        var fi: usize = 0
        while fi < fts.len() && bound == 0 {
            if fi < arghs.len() {
                bound = match_param_arg(a, tps[ti], fts[fi], arghs[fi])
            }
            fi = fi + 1
        }
        args = args ++ [bound]
        ti = ti + 1
    }
    args
}

// 单字段位参数匹配:param 含 TAdt(tp) 名字占位(任意嵌套深度)与
// arg(具体)对位 → 该占位的解。0 = 未命中。
fun match_param_arg(a: TypeArena, tp: str, param_h: u32, arg_h: u32): u32 {
    mpa_d(a, tp, param_h, arg_h, 10i64)
}

fun mpa_d(a: TypeArena, tp: str, param_h: u32, arg_h: u32, depth: i64): u32 {
    if depth <= 0 {
        return 0
    }
    val p = Arena.resolve(a, param_h)
    val g = Arena.resolve(a, arg_h)
    match Arena.get(a, p) {
        TAdt(_) => {
            val pp = Arena.adt_parts(a, p)
            if pp.b.len() == 0 {
                if pp.a == tp {
                    return g
                }
                0
            } else {
                // 泛型聚合嵌套位对位(List<T> vs List<i32>)。
                val gg = Arena.adt_parts(a, g)
                if gg.a == pp.a && gg.b.len() == pp.b.len() {
                    var i: usize = 0
                    while i < pp.b.len() {
                        val m = mpa_d(a, tp, pp.b[i], gg.b[i], depth - 1)
                        if m != 0 {
                            return m
                        }
                        i = i + 1
                    }
                    0
                } else {
                    0
                }
            }
        },
        TArray(_) => {
            val pe = Arena.resolve(a, arr_elem_of(a, p))
            match Arena.get(a, pe) {
                TAdt(_) => {
                    val ppe = Arena.adt_parts(a, pe)
                    if ppe.b.len() == 0 && ppe.a == tp {
                        arr_elem_of(a, g)
                    } else {
                        0
                    }
                },
                _ => 0,
            }
        },
        TNullable(_) => {
            val pi = Arena.resolve(a, Arena.nullable_inner(a, p))
            match Arena.get(a, pi) {
                TAdt(_) => {
                    val ppi = Arena.adt_parts(a, pi)
                    if ppi.b.len() == 0 && ppi.a == tp {
                        // T? ~ arg nullable → inner;arg 直值 → arg 本身。
                        match Arena.get(a, g) {
                            TNullable(_) => Arena.nullable_inner(a, g)
                            _ => g,
                        }
                    } else {
                        0
                    }
                },
                _ => 0,
            }
        },
        _ => 0,
    }
}

// 切片 6e:泛型绑定对载体(免 Map 双型)。
pub type TPair = TPair(pub tps: str[], pub args: u32[])

// 切片 6e:泛型毒型判定 —— TAdt 实例的某实参槽被 TVoid/TUnknown/
// open tvar 覆写(check 期方法糖调用的共享刚性槽末者胜;引擎软值
// 不可见,native 静态布局受害)。true = 受毒。
fun ty_generic_poisoned(a: TypeArena, s: SemaRes, h: u32): bool {
    ty_gp_depth(a, s, h, 8i64)
}

// 深度上限版(循环类型防御:毒判定是读侧兜底,超深即视为不毒走原路)。
fun ty_gp_depth(a: TypeArena, s: SemaRes, h: u32, depth: i64): bool {
    if depth <= 0 {
        return false
    }
    val r = Arena.resolve(a, h)
    match Arena.get(a, r) {
        TArray(_) => {
            ty_gp_depth(a, s, (Arena.array_parts(a, r)).a, depth - 1)
        },
        TNullable(_) => {
            ty_gp_depth(a, s, Arena.nullable_inner(a, r), depth - 1)
        },
        TThrow(_) => {
            val tp2 = Arena.thr_parts(a, r)
            ty_gp_depth(a, s, tp2.a, depth - 1) || ty_gp_depth(a, s, tp2.b, depth - 1)
        },
        TAdt(_) => {
            val p = Arena.adt_parts(a, r)
            if p.b.len() == 0 {
                return false
            }
            match Semares.get_type_def(s, p.a) {
                null => false
                d0 => {
                    if (d0 ?? Data.TDef("", Data.TAlias, [], [], null, null, [], [])).type_params.len() == 0 {
                        return false
                    }
                    var i: usize = 0
                    while i < p.b.len() {
                        val ar = Arena.resolve(a, p.b[i])
                        match Arena.get(a, ar) {
                            TVoid => { return true }
                            TUnknown => { return true }
                            TTypeVar(_) => { return true }
                            _ => {},
                        }
                        i = i + 1
                    }
                    false
                },
            }
        },
        _ => false,
    }
}

fun ty_key(a: TypeArena, s: SemaRes, h: u32): str {
    ty_key_d(a, s, h, 10i64)
}

// 深度上限版(循环类型防御:键仅缓存用,截断无损正确性)。
fun ty_key_d(a: TypeArena, s: SemaRes, h: u32, depth: i64): str {
    if depth <= 0 {
        return "!"
    }
    val rh = Arena.resolve(a, h)
    val k = agg_kind(a, s, rh)
    if k == 5 {
        return "s"
    }
    if k == 6 {
        return "a" + ty_key_d(a, s, arr_elem_of(a, rh), depth - 1)
    }
    if k == 7 {
        match Arena.get(a, rh) {
            TRecord(d) => { return "r{d}" }
            _ => {},
        }
        // 切片 6e:泛型实例键含实参(同型名不同实参 = 不同布局)。
        val nm = record_name_of(a, rh) ?? "?"
        val gargs = Arena.adt_parts(a, rh).b
        if gargs.len() == 0 {
            return "rn" + nm
        }
        var out = "rg" + nm
        var i: usize = 0
        while i < gargs.len() {
            out = out + "<" + ty_key_d(a, s, gargs[i], depth - 1)
            i = i + 1
        }
        return out
    }
    if k == 8 {
        val nm8 = record_name_of(a, rh) ?? "?"
        val gargs8 = Arena.adt_parts(a, rh).b
        if gargs8.len() == 0 {
            return "d" + nm8
        }
        var out8 = "dg" + nm8
        var i8: usize = 0
        while i8 < gargs8.len() {
            out8 = out8 + "<" + ty_key_d(a, s, gargs8[i8], depth - 1)
            i8 = i8 + 1
        }
        return out8
    }
    if k == 9 {
        return "o" + ty_key_d(a, s, Arena.nullable_inner(a, rh), depth - 1)
    }
    llty_key(Arena.get(a, rh))
}

// per-ctor struct 布局 {i64, fields...}(多 ctor ADT;键含类型名与
// ctor 索引,同型同键共享)。
fun adt_ctor_layout(lib: Lib, ctx: u64, cache: Map<str, u64>, a: TypeArena, s: SemaRes,
    type_name: str, ctor_idx: i64): Throw<u64, FfiError> {
    val key = "adtc:{type_name}:{ctor_idx}"
    match cache.get(key) {
        null => {}
        h => { return Ok(h ?? 0) }
    }
    match Semares.adt_ctor_fields(s, type_name, ctor_idx) {
        null => throw FfiError(Other, "slice 3: no constructor #{ctor_idx} on '{type_name}'")
        fts0 => {
            val fts = fts0 ?? []
            val i64ty = llty_for(lib, ctx, cache, TI64)?
            var ftys: u64[] = [i64ty]
            var i: usize = 0
            while i < fts.len() {
                ftys = ftys ++ [llty_for_h(lib, ctx, cache, a, s, fts[i])?]
                i = i + 1
            }
            val lt = Llvm.struct_type(lib, ctx, ftys)?
            cache.set(key, lt)
            Ok(lt)
        },
    }
}

// nullable 块布局 {i64, T}(tag@0:0=null,1=Some;payload@1)。
fun nullable_layout(lib: Lib, ctx: u64, cache: Map<str, u64>, a: TypeArena, s: SemaRes,
    inner_h: u32): Throw<u64, FfiError> {
    val key = "nulv:" + ty_key(a, s, inner_h)
    match cache.get(key) {
        null => {}
        h => { return Ok(h ?? 0) }
    }
    val i64ty = llty_for(lib, ctx, cache, TI64)?
    val pt = llty_for_h(lib, ctx, cache, a, s, inner_h)?
    val lt = Llvm.struct_type(lib, ctx, [i64ty, pt])?
    cache.set(key, lt)
    Ok(lt)
}

// null 全局常量块(每 nullable 类型一个:私有 zeroinit {i64, T};
// tag@0=0 即 null,payload 零值永不被读——判 null 后短路)。
// cur_td/cur_module 提前声明(切片 3 布局族在切片 2 状态区之前引用;
// var 顺序敏感,函数前向引用不受限)。
var cur_td: u64 = 0
var cur_module: u64 = 0
var nuln: i64 = 0

fun nullable_null_global(lib: Lib, ctx: u64, cache: Map<str, u64>, a: TypeArena, s: SemaRes,
    inner_h: u32): Throw<u64, FfiError> {
    val key = "nulcst:" + ty_key(a, s, inner_h)
    match cache.get(key) {
        null => {}
        g => { return Ok(g ?? 0) }
    }
    val blk_ty = nullable_layout(lib, ctx, cache, a, s, inner_h)?
    nuln = nuln + 1
    val g = Llvm.add_global(lib, cur_module, blk_ty, ".nul{nuln}")?
    Llvm.set_linkage_private(lib, g)?
    Llvm.set_global_constant(lib, g, true)?
    Llvm.set_initializer(lib, g, Llvm.const_null(lib, blk_ty)?)?
    cache.set(key, g)
    Ok(g)
}

// nullable tag 读取(i64 在 offset 0,ptr 直 load 免 gep)。
fun nullable_tag(lib: Lib, ctx: u64, builder: u64, cache: Map<str, u64>, p: u64): Throw<u64, FfiError> {
    val i64ty = llty_for(lib, ctx, cache, TI64)?
    Llvm.build_load(lib, builder, i64ty, p, "ntag")
}

// Some 包装:frond_alloc {i64, T} → store tag=1 → store payload;返回
// 块地址(= nullable 值)。v 已是 inner 类型值(调用方 conv 保证)。
fun nullable_box_val(lib: Lib, ctx: u64, builder: u64, cache: Map<str, u64>,
    a: TypeArena, s: SemaRes, v: u64, inner_h: u32): Throw<u64, FfiError> {
    val lt = nullable_layout(lib, ctx, cache, a, s, inner_h)?
    val sz = Llvm.abi_size_of_type(lib, cur_td, lt)?
    val p = call_alloc(lib, ctx, cache, builder, sz)?
    val i64ty = llty_for(lib, ctx, cache, TI64)?
    val one = Llvm.const_int(lib, i64ty, 1u64, false)?
    val tag_at = Llvm.build_struct_gep(lib, builder, lt, p, 0u32, tmp())?
    Llvm.build_store(lib, builder, one, tag_at)?
    val f_at = Llvm.build_struct_gep(lib, builder, lt, p, 1u32, tmp())?
    Llvm.build_store(lib, builder, v, f_at)?
    Ok(p)
}

// unbox:payload@1 装载(inner 类型;窄化路径调用方保证非 null)。
fun nullable_unbox_val(lib: Lib, ctx: u64, builder: u64, cache: Map<str, u64>,
    a: TypeArena, s: SemaRes, p: u64, inner_h: u32): Throw<u64, FfiError> {
    val lt = nullable_layout(lib, ctx, cache, a, s, inner_h)?
    val f_at = Llvm.build_struct_gep(lib, builder, lt, p, 1u32, tmp())?
    load_at(lib, ctx, builder, cache, a, s, f_at, inner_h)
}

// ─── 切片 4:Throw 两态值直落 ───
// 布局:per-臂 {i64 tag, payload}(tag 0=Ok / 1=Err;V、E 各自 payload
// 型,聚合载荷 = ptr——同 nullable 纪律)。值 = 块地址(opaque ptr);
// tag@0 读取复用 nullable_tag。Err-Throw 的构造仅经 throw 语句
// (引擎无 Error 构造器 builtin,只有 Ok)。

// per-臂块布局(键含臂别 + payload 型;V/E 异型 → 两布局)。
fun throw_arm_layout(lib: Lib, ctx: u64, cache: Map<str, u64>, a: TypeArena, s: SemaRes,
    payload_h: u32, is_err: bool): Throw<u64, FfiError> {
    val arm = if is_err { "e" } else { "o" }
    val key = "thr:" + arm + ":" + ty_key(a, s, payload_h)
    match cache.get(key) {
        null => {}
        h => { return Ok(h ?? 0) }
    }
    // 切片 6d:Throw<void, E> 的 V 臂 = i64 哑(llty_for(TVoid) 不存在;
    //open 载荷 = 重放未绑定,同按哑处理)。
    val pk0r = Arena.get(a, Arena.resolve(a, payload_h))
    val pk0open = match pk0r { TTypeVar(_) => true, TUnknown => true, _ => false }
    if ty_kind(pk0r) == 4 || pk0open {
        val iv = llty_for(lib, ctx, cache, TI64)?
        val lt0 = Llvm.struct_type(lib, ctx, [iv, iv])?
        cache.set(key, lt0)
        return Ok(lt0)
    }
    val i64ty = llty_for(lib, ctx, cache, TI64)?
    val pt = llty_for_h(lib, ctx, cache, a, s, payload_h)?
    val lt = Llvm.struct_type(lib, ctx, [i64ty, pt])?
    cache.set(key, lt)
    Ok(lt)
}

// 两态包装:frond_alloc {i64, T} → store tag → store payload;返回块
// 地址(= Throw 值)。v 已是 payload 类型值(调用方 conv 保证)。
fun throw_box_val(lib: Lib, ctx: u64, builder: u64, cache: Map<str, u64>,
    a: TypeArena, s: SemaRes, v: u64, payload_h: u32, is_err: bool): Throw<u64, FfiError> {
    val lt = throw_arm_layout(lib, ctx, cache, a, s, payload_h, is_err)?
    val sz = Llvm.abi_size_of_type(lib, cur_td, lt)?
    val p = call_alloc(lib, ctx, cache, builder, sz)?
    val i64ty = llty_for(lib, ctx, cache, TI64)?
    val tagv = Llvm.const_int(lib, i64ty, if is_err { 1u64 } else { 0u64 }, false)?
    val tag_at = Llvm.build_struct_gep(lib, builder, lt, p, 0u32, tmp())?
    Llvm.build_store(lib, builder, tagv, tag_at)?
    val f_at = Llvm.build_struct_gep(lib, builder, lt, p, 1u32, tmp())?
    Llvm.build_store(lib, builder, v, f_at)?
    Ok(p)
}

// payload 装载(臂已由 tag 检查确定;窄化路径调用方保证臂正确)。
fun throw_unbox_val(lib: Lib, ctx: u64, builder: u64, cache: Map<str, u64>,
    a: TypeArena, s: SemaRes, p: u64, payload_h: u32, is_err: bool): Throw<u64, FfiError> {
    val lt = throw_arm_layout(lib, ctx, cache, a, s, payload_h, is_err)?
    val f_at = Llvm.build_struct_gep(lib, builder, lt, p, 1u32, tmp())?
    load_at(lib, ctx, builder, cache, a, s, f_at, payload_h)
}

// 多 ctor ADT 构造:frond_alloc per-ctor struct → store tag@0=ctor_idx →
// 逐字段 store@1..(vals 已 conv 到字段类型;聚合字段存 ptr);返回块
// 地址(= ADT 值)。B 案:复用 record 构造全链,仅多 tag 写入。
fun adt_ctor_build(lib: Lib, ctx: u64, builder: u64, cache: Map<str, u64>,
    a: TypeArena, s: SemaRes, type_name: str, ctor_idx: i64, vals: u64[]): Throw<u64, FfiError> {
    val lt = adt_ctor_layout(lib, ctx, cache, a, s, type_name, ctor_idx)?
    val sz = Llvm.abi_size_of_type(lib, cur_td, lt)?
    val p = call_alloc(lib, ctx, cache, builder, sz)?
    val i64ty = llty_for(lib, ctx, cache, TI64)?
    val tagv = Llvm.const_int(lib, i64ty, ctor_idx as u64, false)?
    val tag_at = Llvm.build_struct_gep(lib, builder, lt, p, 0u32, tmp())?
    Llvm.build_store(lib, builder, tagv, tag_at)?
    var fi: usize = 0
    while fi < vals.len() {
        val faddr = Llvm.build_struct_gep(lib, builder, lt, p, (fi + 1) as u32, tmp())?
        Llvm.build_store(lib, builder, vals[fi], faddr)?
        fi = fi + 1
    }
    Ok(p)
}

// 开放类型变量(悬空 TypeVar/Unknown):NullLit 的 nullable inner 形态。
fun is_open_var(a: TypeArena, h: u32): bool {
    match Arena.get(a, Arena.resolve(a, h)) {
        TTypeVar(_) | TUnknown => true
        _ => false
    }
}

// 裸 null 规范全局(NullLit 专属):zeroinit {i64, i64}(tag=0;
// payload 为 i64 哑型——判空短路保证永不读,与具体 nullable 布局差异
// 不可观察)。所有裸 null 共享一块,零 arena 消耗。
fun null_global_canon(lib: Lib, ctx: u64, cache: Map<str, u64>): Throw<u64, FfiError> {
    match cache.get("nulcst:?") {
        null => {}
        g => { return Ok(g ?? 0) }
    }
    val i64ty = llty_for(lib, ctx, cache, TI64)?
    val blk_ty = Llvm.struct_type(lib, ctx, [i64ty, i64ty])?
    nuln = nuln + 1
    val g = Llvm.add_global(lib, cur_module, blk_ty, ".nul{nuln}")?
    Llvm.set_linkage_private(lib, g)?
    Llvm.set_global_constant(lib, g, true)?
    Llvm.set_initializer(lib, g, Llvm.const_null(lib, blk_ty)?)?
    cache.set("nulcst:?", g)
    Ok(g)
}

// 十进制下标解析(PRecord 按位模式的 Prf.name = int_to_key 形态;
// 非全数字 → null)。
fun parse_dec_idx(name: str): i64? {
    val b = name.bytes()
    if b.len() == 0 {
        return null
    }
    var v: i64 = 0
    var i: usize = 0
    while i < b.len() {
        val c = b[i]
        if c < 48 || c > 57 {
            return null
        }
        v = v * 10 + ((c - 48) as i64)
        i = i + 1
    }
    v
}

// ── 字面量文本(LLVMConstIntOfString 的 radix/数字段分离)──────────

// 前缀识别:0x/0X=16,0o/0O=8,0b/0B=2,其余 10。
pub fun int_radix(text: str): u8 {
    val b = text.bytes()
    if b.len() > 2 && b[0] == (48 as u8) {
        val p = b[1]
        if p == (120 as u8) || p == (88 as u8) {
            return 16u8
        }
        if p == (111 as u8) || p == (79 as u8) {
            return 8u8
        }
        if p == (98 as u8) || p == (66 as u8) {
            return 2u8
        }
    }
    10u8
}

// 剥前缀 + 剥 '_' 分隔符(词法器允许;APInt 字符串口径不保证),保负号。
pub fun int_digits(text: str): str {
    val b = text.bytes()
    var start: usize = 0
    if b.len() > 2 && b[0] == (48 as u8) {
        val p = b[1]
        if p == (120 as u8) || p == (88 as u8) || p == (111 as u8)
            || p == (79 as u8) || p == (98 as u8) || p == (66 as u8) {
            start = 2
        }
    }
    var out = ""
    var i: usize = start
    while i < b.len() {
        val c = b[i]
        if c != (95 as u8) {
            out = out + (b[i..i + 1] as str)
        }
        i = i + 1
    }
    out
}

// ── sema 类型查询 ──────────────────────────────────────────────────

// 表达式的解析后类型句柄(经 Arena.resolve;悬空 TypeVar = 报错——
// 切片 0 只吃类型完备的程序)。
// 切片 6b 续:泛型调用点的物化返回型——call_instantiations 路由到
// 泛型实例时,用声明返回 AST + 实例 type_args 经 inst_param_ty 重建
// (非泛型/未路由 → null,回落记录型)。
fun instance_call_ret(a: TypeArena, s: SemaRes, ftab: Mono.FTabs,
    mname: str, eid: i64): u32? {
    match s.call_instantiations.get(Semares.module_expr_key(mname, eid)) {
        null => null
        iid0 => {
            val iid = iid0 ?? 0
            if iid < 0 || iid >= s.monomorph_instances.len() as i64 {
                return null
            }
            val inst = s.monomorph_instances.get(iid as usize) ?? Data.Mono(0, "", "", [], 0, false, 0)
            if inst.type_args.len() == 0 {
                return null
            }
            val key = "{inst.module_name}\u{0}{inst.func_name}"
            match ftab.decls.get(key) {
                null => null
                sd0 => {
                    match ftab.arenas.get(key) {
                        null => null
                        ast0 => {
                            val astv = ast0 ?? Arena.new_arena()
                            match (sd0 ?? Mono.m_decls_dummy()).decl {
                                FunDeclD(_, _, tps, _, rt, _, _, _, _, _) => {
                                    var itps: str[] = []
                                    var k: usize = 0
                                    while k < tps.len() {
                                        itps = itps ++ [tps[k].name]
                                        k = k + 1
                                    }
                                    match rt {
                                        null => null
                                        r0 => {
                                            val h = inst_param_ty(a, s, astv, r0, itps, inst.type_args)
                                            match Arena.get(a, Arena.resolve(a, h)) {
                                                TTypeVar(_) | TUnknown => null
                                                _ => h
                                            }
                                        },
                                    }
                                },
                                _ => null,
                            }
                        },
                    }
                },
            }
        },
    }
}

pub fun expr_ty(a: TypeArena, s: SemaRes, mname: str, eid: i64): Throw<u32, FfiError> {
    val raw = expr_ty_raw(a, s, mname, eid)?
    // 切片 6e:出口归一 —— sema 全局位(局部声明/方法糖调用)的嵌套
    // 泛型聚合是 TGeneric 句柄,消费面(conv/布局/代换)统一 TAdt。
    Ok(sanitize_arg(a, s, raw))
}

fun expr_ty_raw(a: TypeArena, s: SemaRes, mname: str, eid: i64): Throw<u32, FfiError> {
    val key = Semares.module_expr_key(mname, eid)
    // 切片 6e:构造点实参反推的本地覆写(实例发射窗口内有效;窗口
    // 切换时随重放清空——同体多实例互不渗透)。
    match ty_overlay.get(key) {
        null => {}
        oh => { return Ok(oh ?? 0) }
    }
    match Semares.get_expr(s, key) {
        null => throw FfiError(Other, "slice 0: no sema type for expr {eid} in module '{mname}'")
        h => {
            val rh = Arena.resolve(a, h ?? 0)
            // 切片 6b 续:嵌套泛型调用点——记录型 open(悬空 var 或壳内
            // open elem)且路由到泛型实例 → 物化重建。
            var open_ty = false
            match Arena.get(a, rh) {
                TTypeVar(_) | TUnknown => { open_ty = true }
                TArray(_) => {
                    val eh = Arena.resolve(a, (Arena.array_parts(a, rh)).a)
                    match Arena.get(a, eh) {
                        TTypeVar(_) | TUnknown => { open_ty = true }
                        _ => {}
                    }
                },
                _ => {}
            }
            // 切片 6c:方法体 this 表达式——sema 记录占位 Adt("This"),
            // 发射期以行 this 型(cur_this_h)替换。
            match Arena.get(a, rh) {
                TAdt(_) => {
                    if Arena.adt_parts(a, rh).a == "This" && cur_this_h != 0 {
                        return Ok(cur_this_h)
                    }
                },
                _ => {},
            }
            if open_ty {
                match cur_ftab {
                    null => {}
                    ftab0 => {
                        match instance_call_ret(a, s, ftab0 ?? Mono.ftabs_new(), mname, eid) {
                            null => {}
                            mat => { return Ok(mat ?? 0) }
                        }
                    },
                }
            }
            match Arena.get(a, rh) {
                TTypeVar(_) | TUnknown => throw FfiError(Other, "slice 0: unresolved type for expr {eid} in module '{mname}'")
                _ => Ok(rh)
            }
        },
    }
}

// 切片 6e:槽位感知读型 —— 毒型(泛型实参 void/unknown/open,含
// nullable/数组壳内)且表达式为本地绑定 Ident 时回落槽型(tyslots 经
// ValDeclS 的 overlay 序 = 实例返回,干净;泛型容器无流窄化,安全)。
fun expr_ty_sl(a: TypeArena, s: SemaRes, mname: str, eid: i64, ast: AstArena,
    tyslots: Map<str, u32>): Throw<u32, FfiError> {
    val h0 = expr_ty(a, s, mname, eid)?
    if ty_generic_poisoned(a, s, h0) {
        match ast.expr(eid).node {
            Ident(iname) => {
                match tyslots.get(iname) {
                    null => {}
                    st => { return Ok(st ?? h0) }
                }
            },
            _ => {},
        }
    }
    Ok(h0)
}

// ── 结构同型判定(切片 2)─────────────────────────────────────────
// conv_value 聚合恒等的公用:detail id 每次推断新分配,裸句柄比较不可
// 靠(TAdt/TArray 双份句柄同型不同 id)。str 恒同;数组 = size 相等 +
// elem 递归;record = TAdt 同名(零类型参)或 TRecord 同 detail;标量
// = 同 LLVM 表示键;其余(-1 族)= false。
// 切片 6b:深解析——数组/nullable 壳内的 var 经 unify 已绑定,浅
// resolve 不入 detail;递归重建到底(elem resolve 后重组)。Throw/Adt
// 泛型实参 = 6d 面。
fun deep_resolve(a: TypeArena, h: u32): u32 {
    val rh = Arena.resolve(a, h)
    match Arena.get(a, rh) {
        TArray(_) => {
            val eh = Arena.resolve(a, (Arena.array_parts(a, rh)).a)
            match Arena.get(a, eh) {
                TTypeVar(_) | TUnknown => rh
                _ => Arena.make_array(a, deep_resolve(a, eh), null)
            }
        },
        TNullable(_) => {
            val ih = Arena.resolve(a, Arena.nullable_inner(a, rh))
            match Arena.get(a, ih) {
                TTypeVar(_) | TUnknown => rh
                _ => Arena.make_nullable(a, deep_resolve(a, ih))
            }
        },
        _ => rh,
    }
}

// 切片 6b 续:数组壳内 elem 是否 open(悬空 var)。
fun has_open_elem(a: TypeArena, h: u32): bool {
    val rh = Arena.resolve(a, h)
    match Arena.get(a, rh) {
        TArray(_) => {
            match Arena.get(a, Arena.resolve(a, (Arena.array_parts(a, rh)).a)) {
                TTypeVar(_) | TUnknown => true
                _ => false
            }
        },
        _ => false,
    }
}

fun ty_same(a: TypeArena, s: SemaRes, h1: u32, h2: u32): bool {
    if h1 == h2 {
        return true
    }
    val r1 = Arena.resolve(a, h1)
    val r2 = Arena.resolve(a, h2)
    if r1 == r2 {
        return true
    }
    val k1 = agg_kind(a, s, r1)
    val k2 = agg_kind(a, s, r2)
    if k1 != k2 {
        return false
    }
    if k1 == 5 {
        return true
    }
    if k1 == 6 {
        // size 不参与:引擎允许 [T; N] 宽化到 T[](数组 = 堆引用,
        // len 运行时),值形态同为 ptr。
        val q1 = Arena.array_parts(a, r1)
        val q2 = Arena.array_parts(a, r2)
        return ty_same(a, s, q1.a, q2.a)
    }
    if k1 == 7 {
        val n1 = record_name_of(a, r1)
        val n2 = record_name_of(a, r2)
        if n1 != null || n2 != null {
            return n1 != null && n2 != null && (n1 ?? "") == (n2 ?? "")
        }
        match Arena.get(a, r1) {
            TRecord(d1) => {
                match Arena.get(a, r2) {
                    TRecord(d2) => { d1 == d2 }
                    _ => false
                }
            },
            _ => false
        }
    }
    if k1 == 8 {
        // 多 ctor ADT:非泛型面同名即同型(tag/字段布局由 TDef 决定)。
        val n1 = record_name_of(a, r1)
        val n2 = record_name_of(a, r2)
        return n1 != null && n2 != null && (n1 ?? "") == (n2 ?? "")
    }
    if k1 == 9 {
        // nullable:inner 递归(T?[] 的元素形态与 T 一致,折叠嵌套同键)。
        return ty_same(a, s, Arena.nullable_inner(a, r1), Arena.nullable_inner(a, r2))
    }
    if k1 == 10 {
        // 切片 4:Throw——V/E 递归同型即同型(Ok/Err 两臂布局各自
        // 按 payload 型键,同型必同键)。
        val q1 = Arena.thr_parts(a, r1)
        val q2 = Arena.thr_parts(a, r2)
        return ty_same(a, s, q1.a, q2.a) && ty_same(a, s, q1.b, q2.b)
    }
    if k1 < 0 {
        return false
    }
    llty_key(Arena.get(a, r1)) == llty_key(Arena.get(a, r2))
}

// ── 值转型 ─────────────────────────────────────────────────────────

// v: from → to(两类型句柄)。同类宽窄/符号化、int↔float、bool↔X;
// 位宽相同 = 恒等(char↔i32 走此短路,免非法 same-size trunc)。
pub fun conv_value(lib: Lib, ctx: u64, builder: u64, cache: Map<str, u64>,
    a: TypeArena, s: SemaRes, v: u64, from_h: u32, to_h: u32, name: str): Throw<u64, FfiError> {
    if from_h == to_h {
        return Ok(v)
    }
    // 切片 6e:双侧先归一(sema 局部声明/实参位的嵌套泛型聚合是
    // arena TGeneric 句柄,消费面统一 TAdt)。
    val from_h1 = sanitize_arg(a, s, from_h)
    val to_h1 = sanitize_arg(a, s, to_h)
    if from_h1 == to_h1 {
        return Ok(v)
    }
    // 切片 6b:深解析双侧(壳内 var 已绑定,浅 resolve 不入 detail)。
    val from_h2 = deep_resolve(a, from_h1)
    val to_h2 = deep_resolve(a, to_h1)
    if from_h2 != from_h || to_h2 != to_h {
        if from_h2 == to_h2 {
            return Ok(v)
        }
    }
    // 切片 6b 续:单侧 open 的同形聚合转换 = 直通——open 侧是 inst
    // 重放跳 unify 的悬空记录型,无布局信息;值本体已按具体派生构造
    //(字面量 elem 从元素派生 / 调用点物化)。
    {
        val ofk = agg_kind(a, s, from_h2)
        val otk = agg_kind(a, s, to_h2)
        if ofk == otk && is_agg_kind(ofk) {
            val fo = has_open_elem(a, from_h2)
            val to2 = has_open_elem(a, to_h2)
            if fo != to2 {
                return Ok(v)
            }
        }
    }
    val from = Arena.get(a, Arena.resolve(a, from_h2))
    val to = Arena.get(a, Arena.resolve(a, to_h2))
    val fk = agg_kind(a, s, from_h2)
    val tk = agg_kind(a, s, to_h2)
    // 聚合族(切片 2/3):值 = opaque ptr,同型即恒等(str↔str;数组须
    // elem 同型;record 须同名义类型——TAdt 同名或 TRecord 同 detail;
    // 多 ctor ADT 同名;nullable inner 同型)。切片 3 新通道:T → T?
    // = Some 包装(box:frond_alloc 块);T? → T = payload 装载(unbox:
    // 流窄化路径,sema 已保证非 null)。跨形态/异型 = 响亮报错。
    if is_agg_kind(fk) || is_agg_kind(tk) {
        // 切片 3:T → T? = Some 包装(box:标量/聚合统一——聚合值本就是
        // ptr,store payload 即可);T? → T = payload 装载(unbox:流窄化
        // 路径,sema 已保证非 null)。
        if fk != 9 && tk == 9 {
            // T → T? = Some 包装。inner 同型直 box;标量族先 conv 到
            // inner 再 box(字面量 arm 体/初值形态:i32 → i64?);聚合
            // 须同型(str → str?)。
            val inner = Arena.nullable_inner(a, Arena.resolve(a, to_h2))
            if ty_same(a, s, from_h, inner) {
                return nullable_box_val(lib, ctx, builder, cache, a, s, v, inner)
            }
            if fk >= 0 && fk < 5 {
                val wv = conv_value(lib, ctx, builder, cache, a, s, v, from_h, inner, name + "w")?
                return nullable_box_val(lib, ctx, builder, cache, a, s, wv, inner)
            }
        }
        if fk == 9 && tk != 9 {
            // T? → T = payload 装载后 conv 到目标(流窄化路径,sema 已
            // 保证非 null;inner → 目标走常规 conv:i64? → i32 截窄等)。
            val inner = Arena.nullable_inner(a, Arena.resolve(a, from_h2))
            val uv = nullable_unbox_val(lib, ctx, builder, cache, a, s, v, inner)?
            return conv_value(lib, ctx, builder, cache, a, s, uv, inner, to_h, name)
        }
        if (fk == 0 || fk == 3) && tk == 5 {
            // 切片 6f:标量→str as 死分支哑值(__hash_key_str(k as str)
            // 的非 str 键位;type_name 折叠后不可达,但 IR 须类型正确
            // —— 原值直通会令下游 str 拆参 gep 到标量,verifier 拒)。
            return Llvm.const_null(lib, opaque_ptr(lib, ctx, cache)?)
        }
        if fk == 4 && tk == 10 {
            // 切片 6g:void→Throw = Ok(void) 哑盒(载荷永不被读;同
            // lower_call Ok builtin 的 void 载荷路径)。
            val vp = Arena.thr_parts(a, to_h2)
            val vc0 = throw_box_val(lib, ctx, builder, cache, a, s,
                Llvm.const_int(lib, llty_for(lib, ctx, cache, TI64)?, 0u64, false)?,
                Arena.from_scalar_name(a, "i64"), false)?
            return Ok(vc0)
        }
        if (fk < 5 || tk < 5) && fk != tk {
            throw FfiError(Other, "slice 3: aggregate/scalar conversion '{name}' ({fk}->{tk}, {ty_key(a, s, from_h2)}~{ty_key(a, s, to_h2)}) is not supported")
        }
        if fk == 5 && tk == 5 {
            return Ok(v)
        }
        if fk == 6 && tk == 6 {
            if ty_same(a, s, from_h2, to_h2) {
                return Ok(v)
            }
        }
        if fk == 7 && tk == 7 {
            match from {
                TAdt(_) => {
                    match to {
                        TAdt(_) => {
                            // 名义恒等:detail id 每次推断新分配,不可靠;
                            // 非泛型面同名即同型。
                            val fname = record_name_of(a, from_h2) ?? ""
                            val tname = record_name_of(a, to_h2) ?? ""
                            if fname.len() > 0 && fname == tname {
                                return Ok(v)
                            }
                        },
                        _ => {}
                    }
                },
                TRecord(fid) => {
                    match to {
                        TRecord(tid) => {
                            if fid == tid {
                                return Ok(v)
                            }
                        },
                        _ => {}
                    }
                },
                _ => {}
            }
        }
        if fk == 8 && tk == 8 {
            // 多 ctor ADT:非泛型面同名即同型。
            val fname = record_name_of(a, from_h2) ?? ""
            val tname = record_name_of(a, to_h2) ?? ""
            if fname.len() > 0 && fname == tname {
                return Ok(v)
            }
        }
        if fk == 10 && tk == 10 {
            // 切片 4/6d:Throw→Throw 恒等(值同为块地址 ptr;V 位
            // void/open 哑表示差异不改 ptr 语义)。
            return Ok(v)
        }
        if fk == 9 && tk == 9 {
            // nullable:inner 递归同型即恒等(块布局同键)。
            // 裸 null 直通:NullLit 的 sema 类型 = TNullable(fresh var),
            // 任一侧 inner 是开放类型变量即视为 null 块传递(payload 永不
            // 读——判空后短路,块布局差异不可观察)。
            val ifr = Arena.resolve(a, from_h2)
            val itr = Arena.resolve(a, to_h2)
            val fi = Arena.nullable_inner(a, ifr)
            val ti = Arena.nullable_inner(a, itr)
            if is_open_var(a, fi) || is_open_var(a, ti) {
                return Ok(v)
            }
            if ty_same(a, s, from_h2, to_h2) {
                return Ok(v)
            }
        }
        if fk == 6 && tk == 6 {
            // 切片 6e:数组→数组 as 改判直通(值同为块地址 ptr;
            // type_name 分派族的死分支 cast——Mem.copy 链——O2 常量
            // 折叠 type_name 比较后全灭;活分支恒同型不经此)。
            return Ok(v)
        }
        if fk == 6 && tk == 5 {
            // 切片 6g:数组→str 真转换(块头 16→8 重排;活路径 =
            // Proc.args 的 (buf[0..len]) as str;6e 的直通对死分支
            // 合法但活路径读 cap 当数据)。
            val i64ty2 = llty_for(lib, ctx, cache, TI64)?
            val i8ty2 = llty_for(lib, ctx, cache, TI8)?
            val one2 = Llvm.const_int(lib, i64ty2, 1u64, false)?
            val c82 = Llvm.const_int(lib, i64ty2, 8u64, false)?
            val c162 = Llvm.const_int(lib, i64ty2, 16u64, false)?
            val n2 = Llvm.build_load(lib, builder, i64ty2, v, "a2s.n")?
            val sz2 = Llvm.build_add(lib, builder, c82, n2, "a2s.sz")?
            val blk2 = call_alloc_dyn(lib, builder, cache, sz2)?
            Llvm.build_store(lib, builder, n2, blk2)?
            val is2 = Llvm.build_alloca(lib, builder, i64ty2, "a2s.i")?
            Llvm.build_store(lib, builder, Llvm.const_int(lib, i64ty2, 0u64, false)?, is2)?
            val l2 = Llvm.append_block(lib, ctx, cur_fn_ref, "a2s.loop")?
            val b2 = Llvm.append_block(lib, ctx, cur_fn_ref, "a2s.body")?
            val e2 = Llvm.append_block(lib, ctx, cur_fn_ref, "a2s.end")?
            Llvm.build_br(lib, builder, l2)?
            Llvm.position_builder_at_end(lib, builder, l2)?
            val i2 = Llvm.build_load(lib, builder, i64ty2, is2, "a2s.iv")?
            val m2 = Llvm.build_icmp(lib, builder, i2, n2, 36u32, "a2s.more")?
            Llvm.build_cond_br(lib, builder, m2, b2, e2)?
            Llvm.position_builder_at_end(lib, builder, b2)?
            val sp2 = Llvm.build_inbounds_gep2(lib, builder, i8ty2, v,
                [Llvm.build_add(lib, builder, c162, i2, "a2s.so")?], tmp())?
            val by2 = Llvm.build_load(lib, builder, i8ty2, sp2, "a2s.b")?
            val dp2 = Llvm.build_inbounds_gep2(lib, builder, i8ty2, blk2,
                [Llvm.build_add(lib, builder, c82, i2, "a2s.do")?], tmp())?
            Llvm.build_store(lib, builder, by2, dp2)?
            Llvm.build_store(lib, builder, Llvm.build_add(lib, builder, i2, one2, "a2s.nx")?, is2)?
            Llvm.build_br(lib, builder, l2)?
            Llvm.position_builder_at_end(lib, builder, e2)?
            return Ok(blk2)
        }
        if fk == 5 && tk == 6 {
            // 切片 6g:str→数组真转换(len@0 共享;数据 8→16;cap=len)。
            val i64ty3 = llty_for(lib, ctx, cache, TI64)?
            val i8ty3 = llty_for(lib, ctx, cache, TI8)?
            val one3 = Llvm.const_int(lib, i64ty3, 1u64, false)?
            val c83 = Llvm.const_int(lib, i64ty3, 8u64, false)?
            val c163 = Llvm.const_int(lib, i64ty3, 16u64, false)?
            val n3 = Llvm.build_load(lib, builder, i64ty3, v, "s2a.n")?
            val sz3 = Llvm.build_add(lib, builder, c163, n3, "s2a.sz")?
            val blk3 = call_alloc_dyn(lib, builder, cache, sz3)?
            Llvm.build_store(lib, builder, n3, blk3)?
            val cap3 = Llvm.build_inbounds_gep2(lib, builder, i8ty3, blk3, [c83], "s2a.cap")?
            Llvm.build_store(lib, builder, n3, cap3)?
            val is3 = Llvm.build_alloca(lib, builder, i64ty3, "s2a.i")?
            Llvm.build_store(lib, builder, Llvm.const_int(lib, i64ty3, 0u64, false)?, is3)?
            val l3 = Llvm.append_block(lib, ctx, cur_fn_ref, "s2a.loop")?
            val b3 = Llvm.append_block(lib, ctx, cur_fn_ref, "s2a.body")?
            val e3 = Llvm.append_block(lib, ctx, cur_fn_ref, "s2a.end")?
            Llvm.build_br(lib, builder, l3)?
            Llvm.position_builder_at_end(lib, builder, l3)?
            val i3 = Llvm.build_load(lib, builder, i64ty3, is3, "s2a.iv")?
            val m3 = Llvm.build_icmp(lib, builder, i3, n3, 36u32, "s2a.more")?
            Llvm.build_cond_br(lib, builder, m3, b3, e3)?
            Llvm.position_builder_at_end(lib, builder, b3)?
            val sp3 = Llvm.build_inbounds_gep2(lib, builder, i8ty3, v,
                [Llvm.build_add(lib, builder, c83, i3, "s2a.so")?], tmp())?
            val by3 = Llvm.build_load(lib, builder, i8ty3, sp3, "s2a.b")?
            val dp3 = Llvm.build_inbounds_gep2(lib, builder, i8ty3, blk3,
                [Llvm.build_add(lib, builder, c163, i3, "s2a.do")?], tmp())?
            Llvm.build_store(lib, builder, by3, dp3)?
            Llvm.build_store(lib, builder, Llvm.build_add(lib, builder, i3, one3, "s2a.nx")?, is3)?
            Llvm.build_br(lib, builder, l3)?
            Llvm.position_builder_at_end(lib, builder, e3)?
            return Ok(blk3)
        }
        throw FfiError(Other, "slice 2: mismatched aggregate conversion '{name}' ({fk}->{tk}, {ty_key(a, s, from_h2)}~{ty_key(a, s, to_h2)})")
    }
    if (fk == 0 || fk == 3) && (tk == 0 || tk == 3) {
        val fb = ty_bits(from)
        val tb = ty_bits(to)
        if fb == tb {
            return Ok(v)
        }
        val to_ty = llty_for(lib, ctx, cache, to)?
        if fb < tb {
            if ty_signed(from) {
                Llvm.build_sext(lib, builder, v, to_ty, name)
            } else {
                Llvm.build_zext(lib, builder, v, to_ty, name)
            }
        } else {
            Llvm.build_trunc(lib, builder, v, to_ty, name)
        }
    } else if fk == 1 && tk == 1 {
        val to_ty = llty_for(lib, ctx, cache, to)?
        if ty_float_bits(from) < ty_float_bits(to) {
            Llvm.build_fpext(lib, builder, v, to_ty, name)
        } else {
            Llvm.build_fptrunc(lib, builder, v, to_ty, name)
        }
    } else if fk == 2 && tk == 0 {
        val to_ty = llty_for(lib, ctx, cache, to)?
        Llvm.build_zext(lib, builder, v, to_ty, name)
    } else if fk == 0 && tk == 2 {
        val zero = Llvm.const_int_str(lib, llty_for(lib, ctx, cache, from)?, "0", 10u8)?
        Llvm.build_icmp(lib, builder, v, zero, 33u32, name)
    } else if fk == 0 && tk == 1 {
        val to_ty = llty_for(lib, ctx, cache, to)?
        if ty_signed(from) {
            Llvm.build_sitofp(lib, builder, v, to_ty, name)
        } else {
            Llvm.build_uitofp(lib, builder, v, to_ty, name)
        }
    } else if fk == 1 && tk == 0 {
        val to_ty = llty_for(lib, ctx, cache, to)?
        if ty_signed(to) {
            Llvm.build_fptosi(lib, builder, v, to_ty, name)
        } else {
            Llvm.build_fptoui(lib, builder, v, to_ty, name)
        }
    } else if fk == 2 && tk == 1 {
        // 经 i32 中转(zext → sitofp)。
        val i32ty = llty_for(lib, ctx, cache, TI32)?
        val w = Llvm.build_zext(lib, builder, v, i32ty, name + "w")?
        val to_ty = llty_for(lib, ctx, cache, to)?
        Llvm.build_sitofp(lib, builder, w, to_ty, name)
    } else if fk == 1 && tk == 2 {
        val zero = Llvm.const_real_str(lib, llty_for(lib, ctx, cache, from)?, "0")?
        Llvm.build_fcmp(lib, builder, v, zero, 6u32, name)
    } else if fk == 2 && tk == 2 {
        Ok(v)
    } else if fk == 4 && tk == 4 {
        // 切片 6e:void→void 恒等(extern/void 调用在语句位的收尾 conv)。
        Ok(v)
    } else {
        throw FfiError(Other, "slice 0: unsupported conversion '{name}'")
    }
}

// ── 表达式 lowering ────────────────────────────────────────────────

var tmpn: i64 = 0

// ── 切片 6g:repr 递归 IR(引擎 Reflect.format_value 对齐)────────
// 格式:record = Name(f: v, ...);ADT = Ctor(f: v, ...)(零参 = 裸名);
// 数组 = [v, ...];nullable = null/内层;Throw = Ok(v)/Err(e);
// bool = true/false;void = "void";整型 = itoa;str = 恒等;
// 深度 > 5 = "..."(引擎 FORMAT_MAX_DEPTH 防环)。
// 注:循环体内的递归 repr 会 per-迭代 alloca(诊断面规模可接受)。
fun repr_value_ir(lib: Lib, ctx: u64, builder: u64, fref: u64, cache: Map<str, u64>,
    a: TypeArena, s: SemaRes, v: u64, ty_h: u32, depth: i64): Throw<u64, FfiError> {
    if depth > 5 {
        return str_lit_global(lib, ctx, cache, "...")
    }
    val rh = Arena.resolve(a, ty_h)
    val k = agg_kind(a, s, rh)
    if k == 5 {
        return Ok(v)
    }
    if k == 4 {
        return str_lit_global(lib, ctx, cache, "void")
    }
    if k == 0 || k == 3 {
        val i64ty = llty_for(lib, ctx, cache, TI64)?
        val i64_h = Arena.from_scalar_name(a, "i64")
        val v64 = conv_value(lib, ctx, builder, cache, a, s, v, ty_h, i64_h, tmp())?
        emit_itoa_once(lib, ctx, cur_module, cache)?
        val ift = Llvm.function_type(lib, Llvm.ptr_type(lib, ctx)?, [i64ty], false)?
        return Llvm.build_call2(lib, builder, ift, itoa_fn, [v64], tmp())
    }
    if ty_same(a, s, ty_h, Arena.from_scalar_name(a, "bool")) {
        val i8ty = llty_for(lib, ctx, cache, TI8)?
        val i1ty = Llvm.int_type(lib, ctx, 1u32)?
        val zero8 = Llvm.const_int(lib, i8ty, 0u64, false)?
        val bv = Llvm.build_trunc(lib, builder, v, i1ty, tmp())?
        val z1 = Llvm.const_int(lib, i1ty, 0u64, false)?
        val isz = Llvm.build_icmp(lib, builder, bv, z1, 32u32, "isz")?
        return Llvm.build_select(lib, builder, isz,
            str_lit_global(lib, ctx, cache, "false")?,
            str_lit_global(lib, ctx, cache, "true")?, "bs")
    }
    if k == 9 {
        // nullable:tag@0 = 0 → "null";1 → unbox 内层递归。
        val i64ty2 = llty_for(lib, ctx, cache, TI64)?
        val inner = Arena.nullable_inner(a, rh)
        val pt = llty_for_h(lib, ctx, cache, a, s, rh)?
        val slot = Llvm.build_alloca(lib, builder, pt, "nv.r")?
        val t = nullable_tag(lib, ctx, builder, cache, v)?
        val z = Llvm.const_int(lib, i64ty2, 0u64, false)?
        val isnull = Llvm.build_icmp(lib, builder, t, z, 32u32, "nv.n")?
        val null_blk = Llvm.append_block(lib, ctx, fref, "nv.null")?
        val some_blk = Llvm.append_block(lib, ctx, fref, "nv.some")?
        val end_blk = Llvm.append_block(lib, ctx, fref, "nv.end")?
        Llvm.build_cond_br(lib, builder, isnull, null_blk, some_blk)?
        Llvm.position_builder_at_end(lib, builder, null_blk)?
        Llvm.build_store(lib, builder, str_lit_global(lib, ctx, cache, "null")?, slot)?
        Llvm.build_br(lib, builder, end_blk)?
        Llvm.position_builder_at_end(lib, builder, some_blk)?
        val uv = nullable_unbox_val(lib, ctx, builder, cache, a, s, v, inner)?
        val rv = repr_value_ir(lib, ctx, builder, fref, cache, a, s, uv, inner, depth + 1)?
        Llvm.build_store(lib, builder, rv, slot)?
        Llvm.build_br(lib, builder, end_blk)?
        Llvm.position_builder_at_end(lib, builder, end_blk)?
        return Llvm.build_load(lib, builder, pt, slot, "nv.v")
    }
    if k == 10 {
        // Throw:tag@0 = 0 → Ok(V@1);1 → Err(E@1)(per 臂布局,payload@1)。
        val i64ty3 = llty_for(lib, ctx, cache, TI64)?
        val parts = Arena.thr_parts(a, rh)
        val pt3 = llty_for_h(lib, ctx, cache, a, s, rh)?
        val slot3 = Llvm.build_alloca(lib, builder, pt3, "tw.r")?
        val t3 = nullable_tag(lib, ctx, builder, cache, v)?
        val z3 = Llvm.const_int(lib, i64ty3, 0u64, false)?
        val isok = Llvm.build_icmp(lib, builder, t3, z3, 32u32, "tw.o")?
        val ok_blk = Llvm.append_block(lib, ctx, fref, "tw.ok")?
        val er_blk = Llvm.append_block(lib, ctx, fref, "tw.err")?
        val end3 = Llvm.append_block(lib, ctx, fref, "tw.end")?
        Llvm.build_cond_br(lib, builder, isok, ok_blk, er_blk)?
        Llvm.position_builder_at_end(lib, builder, ok_blk)?
        val ov = throw_unbox_val(lib, ctx, builder, cache, a, s, v, parts.a, false)?
        val orv = repr_value_ir(lib, ctx, builder, fref, cache, a, s, ov, parts.a, depth + 1)?
        val ol = str_lit_global(lib, ctx, cache, "Ok(")?
        val oc = str_concat(lib, ctx, builder, cache, fref, ol, orv)?
        val oc2 = str_concat(lib, ctx, builder, cache, fref, oc, str_lit_global(lib, ctx, cache, ")")?)?
        Llvm.build_store(lib, builder, oc2, slot3)?
        Llvm.build_br(lib, builder, end3)?
        Llvm.position_builder_at_end(lib, builder, er_blk)?
        val ev = throw_unbox_val(lib, ctx, builder, cache, a, s, v, parts.b, true)?
        val erv = repr_value_ir(lib, ctx, builder, fref, cache, a, s, ev, parts.b, depth + 1)?
        val el = str_lit_global(lib, ctx, cache, "Err(")?
        val ec = str_concat(lib, ctx, builder, cache, fref, el, erv)?
        val ec2 = str_concat(lib, ctx, builder, cache, fref, ec, str_lit_global(lib, ctx, cache, ")")?)?
        Llvm.build_store(lib, builder, ec2, slot3)?
        Llvm.build_br(lib, builder, end3)?
        Llvm.position_builder_at_end(lib, builder, end3)?
        return Llvm.build_load(lib, builder, pt3, slot3, "tw.v")
    }
    if k == 7 {
        // record:Name(f: v, ...)——静态拼段(字段数编译期已知)。
        // 名取尾段(引擎 display_type_name:末 '.' 后)。
        val name0 = record_name_of(a, rh) ?? "?"
        val name = Semares.tail_seg(name0)
        match Semares.get_type_def(s, name) {
            null => throw FfiError(Other, "slice 6g: repr on unknown record '{name}'")
            d0 => {
                val d = d0 ?? Data.TDef("", Data.TAlias, [], [], null, null, [], [])
                val lt = record_layout_h(lib, ctx, cache, a, s, rh)?
                var acc = str_lit_global(lib, ctx, cache, "{name}(")?
                val fts = d.constructors[0].field_types
                var i: usize = 0
                while i < fts.len() {
                    if i > 0 {
                        acc = str_concat(lib, ctx, builder, cache, fref, acc, str_lit_global(lib, ctx, cache, ", ")?)?
                    }
                    match d.constructors[0].field_names[i] {
                        null => {}
                        fn0 => {
                            acc = str_concat(lib, ctx, builder, cache, fref, acc,
                                str_lit_global(lib, ctx, cache, "{fn0 ?? ""}: ")?)?
                        },
                    }
                    val fth = sanitize_arg(a, s,
                        subst_ty(a, d.type_params, Arena.adt_parts(a, rh).b, fts[i]))
                    val faddr = Llvm.build_struct_gep(lib, builder, lt, v, i as u32, tmp())?
                    val fv = load_at(lib, ctx, builder, cache, a, s, faddr, fth)?
                    val frv = repr_value_ir(lib, ctx, builder, fref, cache, a, s, fv, fth, depth + 1)?
                    acc = str_concat(lib, ctx, builder, cache, fref, acc, frv)?
                    i = i + 1
                }
                str_concat(lib, ctx, builder, cache, fref, acc, str_lit_global(lib, ctx, cache, ")")?)
            },
        }
    } else if k == 8 {
        // 多 ctor ADT:tag@0 运行期分派 → Ctor(f: v, ...)。
        val tn = record_name_of(a, rh) ?? "?"
        val nctor = Semares.adt_ctor_count(s, tn)
        if nctor <= 0 {
            throw FfiError(Other, "slice 6g: repr on unknown ADT '{tn}'")
        }
        val i64ty4 = llty_for(lib, ctx, cache, TI64)?
        val pt4 = llty_for_h(lib, ctx, cache, a, s, rh)?
        val slot4 = Llvm.build_alloca(lib, builder, pt4, "ad.r")?
        val tag = Llvm.build_load(lib, builder, i64ty4, v, "ad.t")?
        val merge = Llvm.append_block(lib, ctx, fref, "ad.end")?
        var chk = Llvm.append_block(lib, ctx, fref, "ad.chk0")?
        Llvm.build_br(lib, builder, chk)?
        var ci: i64 = 0
        while ci < nctor {
            val body = Llvm.append_block(lib, ctx, fref, "ad.b{ci}")?
            val next = if ci + 1 < nctor {
                if true { Llvm.append_block(lib, ctx, fref, "ad.chk{ci + 1}")? } else { 0u64 }
            } else {
                if true { merge } else { 0u64 }
            }
            Llvm.position_builder_at_end(lib, builder, chk)?
            val tv = Llvm.const_int(lib, i64ty4, ci as u64, false)?
            val hit = Llvm.build_icmp(lib, builder, tag, tv, 32u32, "ad.h")?
            Llvm.build_cond_br(lib, builder, hit, body, next)?
            Llvm.position_builder_at_end(lib, builder, body)?
            val cdefs = (Semares.get_type_def(s, tn) ?? Data.TDef("", Data.TAlias, [], [], null, null, [], [])).constructors
            if (ci as usize) >= cdefs.len() {
                Llvm.build_store(lib, builder, str_lit_global(lib, ctx, cache, "?")?, slot4)?
            } else {
                {
                    val c = cdefs[ci as usize]
                    val lt = adt_ctor_layout(lib, ctx, cache, a, s, tn, ci)?
                    if c.field_names.len() == 0 {
                        // 引擎口径:零参 ADT ctor = 裸名(无括号)。
                        Llvm.build_store(lib, builder, str_lit_global(lib, ctx, cache, "{c.name}")?, slot4)?
                    } else {
                    var acc4 = str_lit_global(lib, ctx, cache, "{c.name}(")?
                    val fts4 = Semares.adt_ctor_fields(s, tn, ci) ?? []
                    var fi: usize = 0
                    while fi < fts4.len() {
                        if fi > 0 {
                            acc4 = str_concat(lib, ctx, builder, cache, fref, acc4, str_lit_global(lib, ctx, cache, ", ")?)?
                        }
                        match c.field_names[fi] {
                            null => {}
                            fn4 => {
                                acc4 = str_concat(lib, ctx, builder, cache, fref, acc4,
                                    str_lit_global(lib, ctx, cache, "{fn4 ?? ""}: ")?)?
                            },
                        }
                        val fth4 = sanitize_arg(a, s, fts4[fi])
                        val faddr4 = Llvm.build_struct_gep(lib, builder, lt, v, (fi + 1) as u32, tmp())?
                        val fv4 = load_at(lib, ctx, builder, cache, a, s, faddr4, fth4)?
                        val frv4 = repr_value_ir(lib, ctx, builder, fref, cache, a, s, fv4, fth4, depth + 1)?
                        acc4 = str_concat(lib, ctx, builder, cache, fref, acc4, frv4)?
                        fi = fi + 1
                    }
                    val done = str_concat(lib, ctx, builder, cache, fref, acc4, str_lit_global(lib, ctx, cache, ")")?)?
                    Llvm.build_store(lib, builder, done, slot4)?
                    }
                }
            }
            Llvm.build_br(lib, builder, merge)?
            chk = next
            ci = ci + 1
        }
        Llvm.position_builder_at_end(lib, builder, merge)?
        return Llvm.build_load(lib, builder, pt4, slot4, "ad.v")
    } else if k == 6 {
        // 数组:[v, ...]——运行期循环拼接。
        val elem = sanitize_arg(a, s, arr_elem_of(a, rh))
        val i64ty5 = llty_for(lib, ctx, cache, TI64)?
        val i8ty5 = llty_for(lib, ctx, cache, TI8)?
        val one5 = Llvm.const_int(lib, i64ty5, 1u64, false)?
        val zero5 = Llvm.const_int(lib, i64ty5, 0u64, false)?
        val c16x = Llvm.const_int(lib, i64ty5, 16u64, false)?
        val esz = agg_size(lib, ctx, cache, a, s, elem)?
        val esz_c = Llvm.const_int(lib, i64ty5, esz, false)?
        val n5 = Llvm.build_load(lib, builder, i64ty5, v, "ar.n")?
        val accslot = Llvm.build_alloca(lib, builder, Llvm.ptr_type(lib, ctx)?, "ar.acc")?
        Llvm.build_store(lib, builder, str_lit_global(lib, ctx, cache, "[")?, accslot)?
        val islot5 = Llvm.build_alloca(lib, builder, i64ty5, "ar.i")?
        Llvm.build_store(lib, builder, zero5, islot5)?
        val head5 = Llvm.append_block(lib, ctx, fref, "ar.head")?
        val body5 = Llvm.append_block(lib, ctx, fref, "ar.body")?
        val tail5 = Llvm.append_block(lib, ctx, fref, "ar.tail")?
        Llvm.build_br(lib, builder, head5)?
        Llvm.position_builder_at_end(lib, builder, head5)?
        val i5 = Llvm.build_load(lib, builder, i64ty5, islot5, "ar.iv")?
        val more5 = Llvm.build_icmp(lib, builder, i5, n5, 36u32, "ar.m")?
        Llvm.build_cond_br(lib, builder, more5, body5, tail5)?
        Llvm.position_builder_at_end(lib, builder, body5)?
        val notfirst = Llvm.build_icmp(lib, builder, i5, zero5, 33u32, "ar.f")?
        val cur5 = Llvm.build_load(lib, builder, Llvm.ptr_type(lib, ctx)?, accslot, "ar.cur")?
        val sepstr = Llvm.build_select(lib, builder, notfirst,
            str_lit_global(lib, ctx, cache, ", ")?,
            str_lit_global(lib, ctx, cache, "")?, "ar.sep")?
        val withsep = str_concat(lib, ctx, builder, cache, fref, cur5, sepstr)?
        val off5 = Llvm.build_add(lib, builder, c16x,
            Llvm.build_mul(lib, builder, i5, esz_c, "ar.x")?, "ar.o")?
        val eaddr5 = Llvm.build_inbounds_gep2(lib, builder, i8ty5, v, [off5], "ar.e")?
        val ev5 = load_at(lib, ctx, builder, cache, a, s, eaddr5, elem)?
        val erv5 = repr_value_ir(lib, ctx, builder, fref, cache, a, s, ev5, elem, depth + 1)?
        val c1 = str_concat(lib, ctx, builder, cache, fref, withsep, erv5)?
        Llvm.build_store(lib, builder, c1, accslot)?
        Llvm.build_store(lib, builder, Llvm.build_add(lib, builder, i5, one5, "ar.nx")?, islot5)?
        Llvm.build_br(lib, builder, head5)?
        Llvm.position_builder_at_end(lib, builder, tail5)?
        val fin5 = Llvm.build_load(lib, builder, Llvm.ptr_type(lib, ctx)?, accslot, "ar.fin")?
        str_concat(lib, ctx, builder, cache, fref, fin5, str_lit_global(lib, ctx, cache, "]")?)
    } else {
        throw FfiError(Other, "slice 6g: repr of unsupported kind {k}")
    }
}

fun tmp(): str {
    tmpn = tmpn + 1
    "t{tmpn}"
}

// ── bump arena(切片 2,附八 §2 策略丙)────────────────────────────
// @frond_heap = 1GiB [i8] 零页(.bss);@frond_heap_top = ptr 前沿
// (初值 = heap 基址);frond_alloc(size) -> ptr:load top →
// (top+size+15) & -16 → ule heap基址+1GiB(越界 llvm.trap)→
// store 新顶 → ret 旧顶。零外部符号(macOS 零库链接不破,零新资产);
// arena 不回收 = 4e 已接受(v0 可泄漏);frond_rt 真进场时 frond_alloc
// 换 C 实现即可,调用点不动。

var arena_fn: u64 = 0
var arena_ft: u64 = 0
// 切片 2 模块级通道:cur_module(str 常量全局挂载点)/trap(越界内联)/
// str_consts(字面量内容去重)/place_ptr-place_ty(lower_place 出参,
// 调用点即读,禁止跨嵌套持有——u64 record 字段读回是软类型洞,禁用)。
var trap_fn: u64 = 0

// 切片 6d:rt_itoa 单件发射——define ptr @frond_rt_itoa(i64):
// 负号 + 逐位除余自尾向前填 24 字节栈缓冲,再拷贝到 frond_alloc 的
// str 块 {len, bytes}。
fun emit_itoa_once(lib: Lib, ctx: u64, module: u64, cache: Map<str, u64>): Throw<void, FfiError> {
    if itoa_fn != 0 {
        return Ok(void)
    }
    val ptrty = opaque_ptr(lib, ctx, cache)?
    val i64ty = llty_for(lib, ctx, cache, TI64)?
    val i8ty = llty_for(lib, ctx, cache, TI8)?
    val ft = Llvm.function_type(lib, ptrty, [i64ty], false)?
    itoa_fn = Llvm.add_function(lib, module, "frond_rt_itoa", ft)?
    val fnh = itoa_fn
    val builder = Llvm.create_builder(lib, ctx)?
    val entry_blk = Llvm.append_block(lib, ctx, fnh, "entry")?
    Llvm.position_builder_at_end(lib, builder, entry_blk)?
    val v = Llvm.get_param(lib, fnh, 0u32)?
    val zero = Llvm.const_int(lib, i64ty, 0u64, false)?
    val one = Llvm.const_int(lib, i64ty, 1u64, false)?
    val ten = Llvm.const_int(lib, i64ty, 10u64, false)?
    val c48 = Llvm.const_int(lib, i64ty, 48u64, false)?
    val c24 = Llvm.const_int(lib, i64ty, 24u64, false)?
    val bufty = Llvm.array_type2(lib, i8ty, 24u64)?
    val buf = Llvm.build_alloca(lib, builder, bufty, "buf")?
    val isneg = Llvm.build_icmp(lib, builder, v, zero, 40u32, "isneg")?
    val negv = Llvm.build_sub(lib, builder, zero, v, "negv")?
    val av = Llvm.build_select(lib, builder, isneg, negv, v, "av")?
    val pslot = Llvm.build_alloca(lib, builder, i64ty, "p")?
    val rslot = Llvm.build_alloca(lib, builder, i64ty, "rem")?
    Llvm.build_store(lib, builder, c24, pslot)?
    Llvm.build_store(lib, builder, av, rslot)?
    val loop_blk = Llvm.append_block(lib, ctx, fnh, "loop")?
    val body_blk = Llvm.append_block(lib, ctx, fnh, "body")?
    val neg_blk = Llvm.append_block(lib, ctx, fnh, "neg")?
    val done_blk = Llvm.append_block(lib, ctx, fnh, "done")?
    Llvm.build_br(lib, builder, loop_blk)?
    Llvm.position_builder_at_end(lib, builder, loop_blk)?
    val rem0 = Llvm.build_load(lib, builder, i64ty, rslot, "rem")?
    val more = Llvm.build_icmp(lib, builder, rem0, zero, 34u32, "more")?
    Llvm.build_cond_br(lib, builder, more, body_blk, neg_blk)?
    Llvm.position_builder_at_end(lib, builder, body_blk)?
    val d = Llvm.build_srem(lib, builder, rem0, ten, "d")?
    val bc = Llvm.build_add(lib, builder, d, c48, "bc")?
    val p0 = Llvm.build_load(lib, builder, i64ty, pslot, "p0")?
    val p1 = Llvm.build_sub(lib, builder, p0, one, "p1")?
    Llvm.build_store(lib, builder, p1, pslot)?
    val baddr = Llvm.build_inbounds_gep2(lib, builder, i8ty, buf, [p1], "ba")?
    val b8 = Llvm.build_trunc(lib, builder, bc, i8ty, "b8")?
    Llvm.build_store(lib, builder, b8, baddr)?
    val rem1 = Llvm.build_sdiv(lib, builder, rem0, ten, "rem1")?
    Llvm.build_store(lib, builder, rem1, rslot)?
    Llvm.build_br(lib, builder, loop_blk)?
    Llvm.position_builder_at_end(lib, builder, neg_blk)?
    val p2 = Llvm.build_load(lib, builder, i64ty, pslot, "p2")?
    val p3 = Llvm.build_sub(lib, builder, p2, one, "p3")?
    val pfinal = Llvm.build_select(lib, builder, isneg, p3, p2, "pfinal")?
    Llvm.build_store(lib, builder, pfinal, pslot)?
    val negaddr = Llvm.build_inbounds_gep2(lib, builder, i8ty, buf, [p3], "na")?
    val dash = Llvm.const_int(lib, i8ty, 45u64, false)?
    Llvm.build_store(lib, builder, dash, negaddr)?
    Llvm.build_br(lib, builder, done_blk)?
    Llvm.position_builder_at_end(lib, builder, done_blk)?
    val len = Llvm.build_sub(lib, builder, c24, pfinal, "len")?
    val c8v = Llvm.const_int(lib, i64ty, 8u64, false)?
    val sz = Llvm.build_add(lib, builder, len, c8v, "sz")?
    val blk2 = Llvm.build_call2(lib, builder, arena_ft, arena_fn, [sz], "blk")?
    Llvm.build_store(lib, builder, len, blk2)?
    val islot = Llvm.build_alloca(lib, builder, i64ty, "ci")?
    Llvm.build_store(lib, builder, zero, islot)?
    val cloop = Llvm.append_block(lib, ctx, fnh, "cloop")?
    val cbody = Llvm.append_block(lib, ctx, fnh, "cbody")?
    val cstep = Llvm.append_block(lib, ctx, fnh, "cstep")?
    val cend = Llvm.append_block(lib, ctx, fnh, "cend")?
    Llvm.build_br(lib, builder, cloop)?
    Llvm.position_builder_at_end(lib, builder, cloop)?
    val iv = Llvm.build_load(lib, builder, i64ty, islot, "i")?
    val cmore = Llvm.build_icmp(lib, builder, iv, len, 36u32, "cmore")?
    Llvm.build_cond_br(lib, builder, cmore, cbody, cend)?
    Llvm.position_builder_at_end(lib, builder, cbody)?
    val srcp = Llvm.build_add(lib, builder, pfinal, iv, "srcp")?
    val srcaddr = Llvm.build_inbounds_gep2(lib, builder, i8ty, buf, [srcp], "sa")?
    val bv = Llvm.build_load(lib, builder, i8ty, srcaddr, "bv")?
    val dstoff = Llvm.build_add(lib, builder, c8v, iv, "dstoff")?
    val dstaddr = Llvm.build_inbounds_gep2(lib, builder, i8ty, blk2, [dstoff], "da")?
    Llvm.build_store(lib, builder, bv, dstaddr)?
    Llvm.build_br(lib, builder, cstep)?
    Llvm.position_builder_at_end(lib, builder, cstep)?
    val i2 = Llvm.build_load(lib, builder, i64ty, islot, "i2")?
    Llvm.build_store(lib, builder, Llvm.build_add(lib, builder, i2, one, "i3")?, islot)?
    Llvm.build_br(lib, builder, cloop)?
    Llvm.position_builder_at_end(lib, builder, cend)?
    Llvm.build_ret(lib, builder, blk2)?
    Llvm.dispose_builder(lib, builder)
    Ok(void)
}
var trap_ft: u64 = 0
var str_consts: Map<str, u64> = Map.empty<str, u64>()
var strn: i64 = 0
var place_ptr: u64 = 0
var place_ty: u32 = 0
// flow_stopped 提前声明(切片 2 部件在切片 1 状态区之前引用;
// var 顺序敏感,函数前向引用不受限)。语义不变:当前线性路径已终止
// (return/break/continue),stopped=true 时该路径必已发出终结指令,
// 组合器一律跳过后续 build(null 句柄进 FFI = 段错误)。
var flow_stopped: bool = false

pub fun emit_arena(lib: Lib, ctx: u64, module: u64, cache: Map<str, u64>, a: TypeArena): Throw<void, FfiError> {
    // 切片 6d:rt-as-IR(策略丙)——frond_alloc 换 malloc 实现(CRT
    // declare;链接视图已含 CRT,零新资产);1GiB bump 段退役。短命
    // 进程免 free(一次性程序语义;引擎侧 arena 同为进程期)。
    val ptrty = opaque_ptr(lib, ctx, cache)?
    val i64ty = llty_for(lib, ctx, cache, TI64)?
    val voidty = Llvm.void_type(lib, ctx)?
    arena_ft = Llvm.function_type(lib, ptrty, [i64ty], false)?
    arena_fn = Llvm.add_function(lib, module, "frond_alloc", arena_ft)?
    trap_ft = Llvm.function_type0(lib, voidty, false)?
    trap_fn = Llvm.add_function(lib, module, "llvm.trap", trap_ft)?
    cur_module = module
    val malloc_ft = Llvm.function_type(lib, ptrty, [i64ty], false)?
    val malloc_fn = Llvm.add_function(lib, module, "malloc", malloc_ft)?
    val builder = Llvm.create_builder(lib, ctx)?
    val blk = Llvm.append_block(lib, ctx, arena_fn, "entry")?
    Llvm.position_builder_at_end(lib, builder, blk)?
    val size = Llvm.get_param(lib, arena_fn, 0u32)?
    val p = Llvm.build_call2(lib, builder, malloc_ft, malloc_fn, [size], "mp")?
    val nullv = Llvm.const_null(lib, ptrty)?
    val isnull = Llvm.build_icmp(lib, builder, p, nullv, 32u32, "oom")?
    val ok_blk = Llvm.append_block(lib, ctx, arena_fn, "ok")?
    val oom_blk = Llvm.append_block(lib, ctx, arena_fn, "oom")?
    Llvm.build_cond_br(lib, builder, isnull, oom_blk, ok_blk)?
    Llvm.position_builder_at_end(lib, builder, oom_blk)?
    val trapcall = Llvm.build_call2_0(lib, builder, trap_ft, trap_fn, "")?
    Llvm.build_unreachable(lib, builder)?
    Llvm.position_builder_at_end(lib, builder, ok_blk)?
    Llvm.build_ret(lib, builder, p)?
    Llvm.dispose_builder(lib, builder)
    // ── 切片 6d:rt 写原语(__stdout/__stderr_write_raw;C ABI =
    // (data ptr, len) → i32,0 成功/-1 失败;CRT fwrite 承载,控制台
    // ANSI 渲染为 v0 已知近似,管道/重定向精确)。 ──
    emit_rt_write(lib, ctx, module, cache, a, "__stdout_write_raw", "stdout")?
    emit_rt_write(lib, ctx, module, cache, a, "__stderr_write_raw", "stderr")?
    Ok(void)
}

// rt 写原语单件:define <name>(ptr %d, i64 %len) -> i32 {
//   %f = load @<stream>; %w = call fwrite(d, 1, len, f);
//   %ok = icmp eq w, len; ret (ok ? 0 : -1) }
fun emit_rt_write(lib: Lib, ctx: u64, module: u64, cache: Map<str, u64>,
    a: TypeArena, cname: str, stream: str): Throw<void, FfiError> {
    // Windows:kernel32 GetStdHandle + WriteFile(已链接;免 CRT 流符号
    // 不对称);Unix:write(fd)。rc:成功 0 / 失败 -1。
    val is_win = cur_is_windows
    val ptrty = opaque_ptr(lib, ctx, cache)?
    val i64ty = llty_for(lib, ctx, cache, TI64)?
    val i32ty = llty_for(lib, ctx, cache, TI32)?
    val ft = Llvm.function_type(lib, i32ty, [ptrty, i64ty], false)?
    val fnh = Llvm.add_function(lib, module, cname, ft)?
    extern_llvm.set(cname, fnh)
    extern_fts.set(cname, ft)
    extern_params.set(cname, [Arena.from_scalar_name(a, "str")])
    val zero = Llvm.const_int(lib, i32ty, 0u64, false)?
    val neg1 = Llvm.const_int(lib, i32ty, 18446744073709551615u64, false)?
    val builder = Llvm.create_builder(lib, ctx)?
    val blk = Llvm.append_block(lib, ctx, fnh, "entry")?
    Llvm.position_builder_at_end(lib, builder, blk)?
    val d = Llvm.get_param(lib, fnh, 0u32)?
    val len = Llvm.get_param(lib, fnh, 1u32)?
    var rc: u64 = 0
    if is_win {
        // n = stream == "stdout" ? -11 : -12(STD_OUTPUT/ERROR_HANDLE)
        val n = if stream == "stdout" {
            Llvm.const_int(lib, i32ty, 18446744073709551605u64, false)?
        } else {
            Llvm.const_int(lib, i32ty, 18446744073709551604u64, false)?
        }
        val gsh_ft = Llvm.function_type(lib, ptrty, [i32ty], false)?
        val gsh = match cache.get("crtdecl:GetStdHandle") {
            null => {
                val f0 = Llvm.add_function(lib, module, "GetStdHandle", gsh_ft)?
                cache.set("crtdecl:GetStdHandle", f0)
                f0
            }
            h => h ?? 0
        }
        val wf_ft = Llvm.function_type(lib, i32ty, [ptrty, ptrty, i32ty, ptrty, ptrty], false)?
        val wf = match cache.get("crtdecl:WriteFile") {
            null => {
                val f0 = Llvm.add_function(lib, module, "WriteFile", wf_ft)?
                cache.set("crtdecl:WriteFile", f0)
                f0
            }
            h => h ?? 0
        }
        val h = Llvm.build_call2(lib, builder, gsh_ft, gsh, [n], "h")?
        val nullp = Llvm.const_null(lib, ptrty)?
        val len32 = Llvm.build_trunc(lib, builder, len, i32ty, "len32")?
        val ok = Llvm.build_call2(lib, builder, wf_ft, wf, [h, d, len32, nullp, nullp], "ok")?
        val oknz = Llvm.build_icmp(lib, builder, ok, zero, 33u32, "oknz")?
        rc = Llvm.build_select(lib, builder, oknz, zero, neg1, "rc")?
    } else {
        val fd = if stream == "stdout" {
            Llvm.const_int(lib, i32ty, 1u64, false)?
        } else {
            Llvm.const_int(lib, i32ty, 2u64, false)?
        }
        val write_ft = Llvm.function_type(lib, i64ty, [i32ty, ptrty, i64ty], false)?
        val wfn = match cache.get("crtdecl:write") {
            null => {
                val f0 = Llvm.add_function(lib, module, "write", write_ft)?
                cache.set("crtdecl:write", f0)
                f0
            }
            h => h ?? 0
        }
        val w = Llvm.build_call2(lib, builder, write_ft, wfn, [fd, d, len], "w")?
        val wok = Llvm.build_icmp(lib, builder, w, len, 32u32, "wok")?
        rc = Llvm.build_select(lib, builder, wok, zero, neg1, "rc")?
    }
    Llvm.build_ret(lib, builder, rc)?
    Llvm.dispose_builder(lib, builder)
    Ok(void)
}

// ── 切片 6e:rt 原语(std 依赖闭包 C builtin 的 IR 等价)────────────

// __mem_copy 族(18 元素型;Frond 数组块 = {i64 len, i64 cap, 数据@16})
// → 元素字节循环拷贝(常量 elsz 内层循环,O2 展开/向量化;同块后移
// 重叠 = memmove 倒序语义,与引擎 C 版"as-if taken out first"对齐;
// 越界不查——调用方已按引擎口径先行校验,坏形状属 abort 域)。
fun emit_rt_mem_copy(lib: Lib, ctx: u64, module: u64, cache: Map<str, u64>,
    a: TypeArena, cname: str, elem_name: str, elsz: u64): Throw<void, FfiError> {
    if extern_llvm.get(cname) != null {
        return Ok(void)
    }
    val ptrty = opaque_ptr(lib, ctx, cache)?
    val i64ty = llty_for(lib, ctx, cache, TI64)?
    val i8ty = llty_for(lib, ctx, cache, TI8)?
    val voidty = Llvm.void_type(lib, ctx)?
    val ft = Llvm.function_type(lib, voidty, [ptrty, i64ty, ptrty, i64ty, i64ty], false)?
    val fnh = Llvm.add_function(lib, module, cname, ft)?
    Llvm.set_linkage_private(lib, fnh)?
    val builder = Llvm.create_builder(lib, ctx)?
    val entry_blk = Llvm.append_block(lib, ctx, fnh, "entry")?
    Llvm.position_builder_at_end(lib, builder, entry_blk)?
    val dst = Llvm.get_param(lib, fnh, 0u32)?
    val dat = Llvm.get_param(lib, fnh, 1u32)?
    val src = Llvm.get_param(lib, fnh, 2u32)?
    val sat = Llvm.get_param(lib, fnh, 3u32)?
    val n = Llvm.get_param(lib, fnh, 4u32)?
    val zero = Llvm.const_int(lib, i64ty, 0u64, false)?
    val one = Llvm.const_int(lib, i64ty, 1u64, false)?
    val mone = Llvm.const_int(lib, i64ty, 18446744073709551615u64, true)?
    val elsz_c = Llvm.const_int(lib, i64ty, elsz, false)?
    val c16 = Llvm.const_int(lib, i64ty, 16u64, false)?
    // 方向:同块且 dst_at > src_at → 倒序(memmove)。
    val same = Llvm.build_icmp(lib, builder, dst, src, 32u32, "same")?
    val gt = Llvm.build_icmp(lib, builder, dat, sat, 34u32, "gt")?
    val back = Llvm.build_and(lib, builder, same, gt, "back")?
    val n_m1 = Llvm.build_sub(lib, builder, n, one, "nm1")?
    val start0 = Llvm.build_select(lib, builder, back, n_m1, zero, "start")?
    val end0 = Llvm.build_select(lib, builder, back, mone, n, "end")?
    val step0 = Llvm.build_select(lib, builder, back, mone, one, "step")?
    val islot = Llvm.build_alloca(lib, builder, i64ty, "i")?
    Llvm.build_store(lib, builder, start0, islot)?
    val loop_blk = Llvm.append_block(lib, ctx, fnh, "loop")?
    val body_blk = Llvm.append_block(lib, ctx, fnh, "body")?
    val kloop_blk = Llvm.append_block(lib, ctx, fnh, "kloop")?
    val kbody_blk = Llvm.append_block(lib, ctx, fnh, "kbody")?
    val kdone_blk = Llvm.append_block(lib, ctx, fnh, "kdone")?
    val done_blk = Llvm.append_block(lib, ctx, fnh, "done")?
    Llvm.build_br(lib, builder, loop_blk)?
    Llvm.position_builder_at_end(lib, builder, loop_blk)?
    val i0 = Llvm.build_load(lib, builder, i64ty, islot, "i")?
    val fin = Llvm.build_icmp(lib, builder, i0, end0, 32u32, "fin")?
    Llvm.build_cond_br(lib, builder, fin, done_blk, body_blk)?
    Llvm.position_builder_at_end(lib, builder, body_blk)?
    val si = Llvm.build_add(lib, builder, sat, i0, "si")?
    val soff = Llvm.build_add(lib, builder, c16,
        Llvm.build_mul(lib, builder, si, elsz_c, "sx")?, "so")?
    val saddr = Llvm.build_inbounds_gep2(lib, builder, i8ty, src, [soff], "sa")?
    val di = Llvm.build_add(lib, builder, dat, i0, "di")?
    val doff = Llvm.build_add(lib, builder, c16,
        Llvm.build_mul(lib, builder, di, elsz_c, "dx")?, "dob")?
    val daddr = Llvm.build_inbounds_gep2(lib, builder, i8ty, dst, [doff], "da")?
    val kslot = Llvm.build_alloca(lib, builder, i64ty, "k")?
    Llvm.build_store(lib, builder, zero, kslot)?
    Llvm.build_br(lib, builder, kloop_blk)?
    Llvm.position_builder_at_end(lib, builder, kloop_blk)?
    val k0 = Llvm.build_load(lib, builder, i64ty, kslot, "k")?
    val kmore = Llvm.build_icmp(lib, builder, k0, elsz_c, 36u32, "kmore")?
    Llvm.build_cond_br(lib, builder, kmore, kbody_blk, kdone_blk)?
    Llvm.position_builder_at_end(lib, builder, kbody_blk)?
    val sb = Llvm.build_inbounds_gep2(lib, builder, i8ty, saddr, [k0], "sb")?
    val db = Llvm.build_inbounds_gep2(lib, builder, i8ty, daddr, [k0], "db")?
    val b0 = Llvm.build_load(lib, builder, i8ty, sb, "b")?
    Llvm.build_store(lib, builder, b0, db)?
    val k1 = Llvm.build_add(lib, builder, k0, one, "k1")?
    Llvm.build_store(lib, builder, k1, kslot)?
    Llvm.build_br(lib, builder, kloop_blk)?
    Llvm.position_builder_at_end(lib, builder, kdone_blk)?
    val i1 = Llvm.build_add(lib, builder, i0, step0, "i1")?
    Llvm.build_store(lib, builder, i1, islot)?
    Llvm.build_br(lib, builder, loop_blk)?
    Llvm.position_builder_at_end(lib, builder, done_blk)?
    Llvm.build_ret_void(lib, builder)?
    Llvm.dispose_builder(lib, builder)
    extern_llvm.set(cname, fnh)
    extern_fts.set(cname, ft)
    extern_voids.set(cname, true)
    val elem_h = Arena.from_scalar_name(a, elem_name)
    val arr_h = Arena.make_array(a, elem_h, null)
    val usize_h = Arena.from_scalar_name(a, "usize")
    extern_params.set(cname, [arr_h, usize_h, arr_h, usize_h, usize_h])
    Ok(void)
}

// __hash_key_str:C ABI = (data ptr, len i64) → u64。FNV-1a 64 + "-0"
// 打印形归一('-' + '0' + 非数字非'.' → 该 token 按 '0' 哈希,i += 2)
// —— builtin/str/Raw.frond C 体逐字节对齐。
fun emit_rt_hash_key_str(lib: Lib, ctx: u64, module: u64, cache: Map<str, u64>,
    a: TypeArena): Throw<void, FfiError> {
    if extern_llvm.get("__hash_key_str") != null {
        return Ok(void)
    }
    val ptrty = opaque_ptr(lib, ctx, cache)?
    val i64ty = llty_for(lib, ctx, cache, TI64)?
    val i8ty = llty_for(lib, ctx, cache, TI8)?
    val ft = Llvm.function_type(lib, i64ty, [ptrty, i64ty], false)?
    val fnh = Llvm.add_function(lib, module, "__hash_key_str", ft)?
    Llvm.set_linkage_private(lib, fnh)?
    val builder = Llvm.create_builder(lib, ctx)?
    val entry_blk = Llvm.append_block(lib, ctx, fnh, "entry")?
    Llvm.position_builder_at_end(lib, builder, entry_blk)?
    val data = Llvm.get_param(lib, fnh, 0u32)?
    val len = Llvm.get_param(lib, fnh, 1u32)?
    val zero = Llvm.const_int(lib, i64ty, 0u64, false)?
    val one = Llvm.const_int(lib, i64ty, 1u64, false)?
    val two = Llvm.const_int(lib, i64ty, 2u64, false)?
    val basis = Llvm.const_int(lib, i64ty, 14695981039346656037u64, false)?
    val prime = Llvm.const_int(lib, i64ty, 1099511628211u64, false)?
    val c45 = Llvm.const_int(lib, i64ty, 45u64, false)?
    val c48 = Llvm.const_int(lib, i64ty, 48u64, false)?
    val c46 = Llvm.const_int(lib, i64ty, 46u64, false)?
    val c57 = Llvm.const_int(lib, i64ty, 57u64, false)?
    val hslot = Llvm.build_alloca(lib, builder, i64ty, "h")?
    Llvm.build_store(lib, builder, basis, hslot)?
    val islot = Llvm.build_alloca(lib, builder, i64ty, "i")?
    Llvm.build_store(lib, builder, zero, islot)?
    val loop_blk = Llvm.append_block(lib, ctx, fnh, "loop")?
    val body_blk = Llvm.append_block(lib, ctx, fnh, "body")?
    val tok_blk = Llvm.append_block(lib, ctx, fnh, "tok")?
    val tok_yes_blk = Llvm.append_block(lib, ctx, fnh, "tok.yes")?
    val tok_no_blk = Llvm.append_block(lib, ctx, fnh, "tok.no")?
    val step_blk = Llvm.append_block(lib, ctx, fnh, "step")?
    val done_blk = Llvm.append_block(lib, ctx, fnh, "done")?
    Llvm.build_br(lib, builder, loop_blk)?
    Llvm.position_builder_at_end(lib, builder, loop_blk)?
    val i0 = Llvm.build_load(lib, builder, i64ty, islot, "i")?
    val more = Llvm.build_icmp(lib, builder, i0, len, 36u32, "more")?
    Llvm.build_cond_br(lib, builder, more, body_blk, done_blk)?
    Llvm.position_builder_at_end(lib, builder, body_blk)?
    val addr = Llvm.build_inbounds_gep2(lib, builder, i8ty, data, [i0], "cp")?
    val cb = Llvm.build_load(lib, builder, i8ty, addr, "c")?
    val cw = Llvm.build_zext(lib, builder, cb, i64ty, "cw")?
    val i1 = Llvm.build_add(lib, builder, i0, one, "i1")?
    val inlen = Llvm.build_icmp(lib, builder, i1, len, 36u32, "inlen")?
    // c == '-' 且 i+1 < len → 查后继。
    val isdash = Llvm.build_icmp(lib, builder, cw, c45, 32u32, "isdash")?
    val dashok = Llvm.build_and(lib, builder, isdash, inlen, "dashok")?
    Llvm.build_cond_br(lib, builder, dashok, tok_blk, tok_no_blk)?
    Llvm.position_builder_at_end(lib, builder, tok_blk)?
    val a1 = Llvm.build_inbounds_gep2(lib, builder, i8ty, data, [i1], "n1p")?
    val n1b = Llvm.build_load(lib, builder, i8ty, a1, "n1b")?
    val n1w = Llvm.build_zext(lib, builder, n1b, i64ty, "n1w")?
    val is0 = Llvm.build_icmp(lib, builder, n1w, c48, 32u32, "is0")?
    Llvm.build_cond_br(lib, builder, is0, tok_yes_blk, tok_no_blk)?
    Llvm.position_builder_at_end(lib, builder, tok_yes_blk)?
    // next = (i+2 < len) ? data[i+2] : 0;非数字且非'.' → '0' token。
    val i2 = Llvm.build_add(lib, builder, i0, two, "i2")?
    val i2in = Llvm.build_icmp(lib, builder, i2, len, 36u32, "i2in")?
    val a2 = Llvm.build_inbounds_gep2(lib, builder, i8ty, data, [i2], "n2p")?
    val n2b = Llvm.build_load(lib, builder, i8ty, a2, "n2b")?
    val n2w = Llvm.build_zext(lib, builder, n2b, i64ty, "n2w")?
    val n2v = Llvm.build_select(lib, builder, i2in, n2w, zero, "n2v")?
    val dlo = Llvm.build_icmp(lib, builder, n2v, c48, 35u32, "dlo")?
    val dhi = Llvm.build_icmp(lib, builder, n2v, c57, 37u32, "dhi")?
    val dig = Llvm.build_and(lib, builder, dlo, dhi, "dig")?
    val dot = Llvm.build_icmp(lib, builder, n2v, c46, 32u32, "dot")?
    val skipok = Llvm.build_or(lib, builder, dig, dot, "skipok")?
    Llvm.build_cond_br(lib, builder, skipok, tok_no_blk, step_blk)?
    Llvm.position_builder_at_end(lib, builder, step_blk)?
    // "-0" token:h = (h ^ '0') * prime;i += 2。
    val h0s = Llvm.build_load(lib, builder, i64ty, hslot, "h0s")?
    val xs = Llvm.build_xor(lib, builder, h0s, c48, "xs")?
    val hs = Llvm.build_mul(lib, builder, xs, prime, "hs")?
    Llvm.build_store(lib, builder, hs, hslot)?
    Llvm.build_store(lib, builder, i2, islot)?
    Llvm.build_br(lib, builder, loop_blk)?
    Llvm.position_builder_at_end(lib, builder, tok_no_blk)?
    val h0 = Llvm.build_load(lib, builder, i64ty, hslot, "h0")?
    val x0 = Llvm.build_xor(lib, builder, h0, cw, "x0")?
    val h1 = Llvm.build_mul(lib, builder, x0, prime, "h1")?
    Llvm.build_store(lib, builder, h1, hslot)?
    Llvm.build_store(lib, builder, i1, islot)?
    Llvm.build_br(lib, builder, loop_blk)?
    Llvm.position_builder_at_end(lib, builder, done_blk)?
    val hf = Llvm.build_load(lib, builder, i64ty, hslot, "hf")?
    Llvm.build_ret(lib, builder, hf)?
    Llvm.dispose_builder(lib, builder)
    extern_llvm.set("__hash_key_str", fnh)
    extern_fts.set("__hash_key_str", ft)
    extern_params.set("__hash_key_str", [Arena.from_scalar_name(a, "str")])
    Ok(void)
}

// __fnv1a_bytes(u8[]) → u64:FNV-1a 64(数组块 {len@0, cap@8, 数据@16},
// 逐字节;builtin/str/Raw.frond C 体对齐)。
fun emit_rt_fnv1a_bytes(lib: Lib, ctx: u64, module: u64, cache: Map<str, u64>,
    a: TypeArena): Throw<void, FfiError> {
    if extern_llvm.get("__fnv1a_bytes") != null {
        return Ok(void)
    }
    val ptrty = opaque_ptr(lib, ctx, cache)?
    val i64ty = llty_for(lib, ctx, cache, TI64)?
    val i8ty = llty_for(lib, ctx, cache, TI8)?
    val ft = Llvm.function_type(lib, i64ty, [ptrty], false)?
    val fnh = Llvm.add_function(lib, module, "__fnv1a_bytes", ft)?
    Llvm.set_linkage_private(lib, fnh)?
    val builder = Llvm.create_builder(lib, ctx)?
    val entry_blk = Llvm.append_block(lib, ctx, fnh, "entry")?
    Llvm.position_builder_at_end(lib, builder, entry_blk)?
    val data = Llvm.get_param(lib, fnh, 0u32)?
    val len = Llvm.build_load(lib, builder, i64ty, data, "len")?
    val zero = Llvm.const_int(lib, i64ty, 0u64, false)?
    val one = Llvm.const_int(lib, i64ty, 1u64, false)?
    val basis = Llvm.const_int(lib, i64ty, 14695981039346656037u64, false)?
    val prime = Llvm.const_int(lib, i64ty, 1099511628211u64, false)?
    val c16 = Llvm.const_int(lib, i64ty, 16u64, false)?
    val hslot = Llvm.build_alloca(lib, builder, i64ty, "h")?
    Llvm.build_store(lib, builder, basis, hslot)?
    val islot = Llvm.build_alloca(lib, builder, i64ty, "i")?
    Llvm.build_store(lib, builder, zero, islot)?
    val loop_blk = Llvm.append_block(lib, ctx, fnh, "loop")?
    val body_blk = Llvm.append_block(lib, ctx, fnh, "body")?
    val done_blk = Llvm.append_block(lib, ctx, fnh, "done")?
    Llvm.build_br(lib, builder, loop_blk)?
    Llvm.position_builder_at_end(lib, builder, loop_blk)?
    val i0 = Llvm.build_load(lib, builder, i64ty, islot, "i")?
    val more = Llvm.build_icmp(lib, builder, i0, len, 36u32, "more")?
    Llvm.build_cond_br(lib, builder, more, body_blk, done_blk)?
    Llvm.position_builder_at_end(lib, builder, body_blk)?
    val addr = Llvm.build_inbounds_gep2(lib, builder, i8ty, data,
        [Llvm.build_add(lib, builder, c16, i0, "off")?], "bp")?
    val cb = Llvm.build_load(lib, builder, i8ty, addr, "c")?
    val cw = Llvm.build_zext(lib, builder, cb, i64ty, "cw")?
    val h0 = Llvm.build_load(lib, builder, i64ty, hslot, "h0")?
    val h1 = Llvm.build_mul(lib, builder, Llvm.build_xor(lib, builder, h0, cw, "x")?, prime, "h1")?
    Llvm.build_store(lib, builder, h1, hslot)?
    Llvm.build_store(lib, builder, Llvm.build_add(lib, builder, i0, one, "i1")?, islot)?
    Llvm.build_br(lib, builder, loop_blk)?
    Llvm.position_builder_at_end(lib, builder, done_blk)?
    val hf = Llvm.build_load(lib, builder, i64ty, hslot, "hf")?
    Llvm.build_ret(lib, builder, hf)?
    Llvm.dispose_builder(lib, builder)
    extern_llvm.set("__fnv1a_bytes", fnh)
    extern_fts.set("__fnv1a_bytes", ft)
    extern_params.set("__fnv1a_bytes", [Arena.make_array(a, Arena.from_scalar_name(a, "u8"), null)])
    Ok(void)
}

// 分配调用(大小为编译期常量;16 对齐由 frond_alloc 内部完成)。
fun call_alloc(lib: Lib, ctx: u64, cache: Map<str, u64>, builder: u64, size: u64): Throw<u64, FfiError> {
    val i64ty = llty_for(lib, ctx, cache, TI64)?
    val sz = Llvm.const_int(lib, i64ty, size, false)?
    Llvm.build_call2(lib, builder, arena_ft, arena_fn, [sz], tmp())
}

// ── 切片 2 聚合部件(附八 §3-§5)─────────────────────────────────

// 无符号整数字面量解析(fill count 编译期取值;int_digits 已剥前缀/'_')。
fun parse_u64(digits: str, radix: u8): u64 {
    val b = digits.bytes()
    var v: u64 = 0u64
    var i: usize = 0
    while i < b.len() {
        val c = b[i]
        var d: u64 = 0u64
        if c >= 48 && c <= 57 {
            d = (c - 48) as u64
        } else if c >= 97 && c <= 122 {
            d = (c - 97 + 10) as u64
        } else if c >= 65 && c <= 90 {
            d = (c - 65 + 10) as u64
        }
        v = v * (radix as u64) + d
        i = i + 1
    }
    v
}

// 值形态字节宽:聚合 = ptr(8);标量 = ABI size(TargetData)。
fun agg_size(lib: Lib, ctx: u64, cache: Map<str, u64>, a: TypeArena, s: SemaRes,
    h: u32): Throw<u64, FfiError> {
    if is_agg_kind(agg_kind(a, s, h)) {
        return Ok(8u64)
    }
    val lt = llty_for(lib, ctx, cache, Arena.get(a, h))?
    Llvm.abi_size_of_type(lib, cur_td, lt)
}

// str 字面量 → 私有全局常量块 {i64 字节数, [N x i8]}(内容去重);
// 返回块地址句柄(= str 值)。空串走 const_null [0 x i8] 兜底。
fun str_lit_global(lib: Lib, ctx: u64, cache: Map<str, u64>, text: str): Throw<u64, FfiError> {
    val key = "strlit:{text}"
    match str_consts.get(key) {
        null => {}
        g => { return Ok(g ?? 0) }
    }
    val n = text.bytes().len()
    val blk_ty = str_layout(lib, ctx, cache, n)?
    strn = strn + 1
    val g = Llvm.add_global(lib, cur_module, blk_ty, ".str{strn}")?
    Llvm.set_linkage_private(lib, g)?
    Llvm.set_global_constant(lib, g, true)?
    val i64ty = llty_for(lib, ctx, cache, TI64)?
    val i8ty = llty_for(lib, ctx, cache, TI8)?
    val nconst = Llvm.const_int(lib, i64ty, n as u64, false)?
    val bytesv = if n == 0 {
        Llvm.const_null(lib, Llvm.array_type2(lib, i8ty, 0u64)?)?
    } else {
        Llvm.const_string2(lib, ctx, text, n)?
    }
    Llvm.set_initializer(lib, g, Llvm.const_struct(lib, ctx, [nconst, bytesv])?)?
    str_consts.set(key, g)
    Ok(g)
}

// str.len():UTF-8 码点数(引擎语义 = 字符数,非字节数)。内联循环:
// (b & 0xC0) != 0x80 → 新码点。循环状态走 alloca 槽(mem2reg 吃掉,
// 引擎无 phi 构造器)。返回 i64 位宽值(usize 同宽,后续 conv 恒等)。
fun str_len_chars(lib: Lib, ctx: u64, builder: u64, cache: Map<str, u64>,
    fref: u64, sp: u64): Throw<u64, FfiError> {
    val i64ty = llty_for(lib, ctx, cache, TI64)?
    val i8ty = llty_for(lib, ctx, cache, TI8)?
    val nbytes = Llvm.build_load(lib, builder, i64ty, sp, "slen")?
    val islot = Llvm.build_alloca(lib, builder, i64ty, "si")?
    val cslot = Llvm.build_alloca(lib, builder, i64ty, "sc")?
    val zero = Llvm.const_int(lib, i64ty, 0u64, false)?
    val one = Llvm.const_int(lib, i64ty, 1u64, false)?
    Llvm.build_store(lib, builder, zero, islot)?
    Llvm.build_store(lib, builder, zero, cslot)?
    val loop_blk = Llvm.append_block(lib, ctx, fref, "slen.loop")?
    val body_blk = Llvm.append_block(lib, ctx, fref, "slen.body")?
    val inc_blk = Llvm.append_block(lib, ctx, fref, "slen.inc")?
    val step_blk = Llvm.append_block(lib, ctx, fref, "slen.step")?
    val end_blk = Llvm.append_block(lib, ctx, fref, "slen.end")?
    // 字节区 offset 8(str 块 {i64, [N x i8]} 头 8 字节)。
    val c8 = Llvm.const_int(lib, i64ty, 8u64, false)?
    Llvm.build_br(lib, builder, loop_blk)?
    Llvm.position_builder_at_end(lib, builder, loop_blk)?
    val iv = Llvm.build_load(lib, builder, i64ty, islot, "i")?
    val more = Llvm.build_icmp(lib, builder, iv, nbytes, 36u32, "more")?
    Llvm.build_cond_br(lib, builder, more, body_blk, end_blk)?
    Llvm.position_builder_at_end(lib, builder, body_blk)?
    // i8 基型仅容单索引:头 8 + i 先加总再 gep。
    val boff = Llvm.build_add(lib, builder, c8, iv, "boff")?
    val baddr = Llvm.build_inbounds_gep2(lib, builder, i8ty, sp, [boff], "bp")?
    val bv = Llvm.build_load(lib, builder, i8ty, baddr, "b")?
    val mask = Llvm.const_int(lib, i8ty, 192u64, false)?
    val contb = Llvm.const_int(lib, i8ty, 128u64, false)?
    val masked = Llvm.build_and(lib, builder, bv, mask, "m")?
    // 续字节判定 (b & 0xC0) == 0x80:EQ——iscont 真 = 续字节,跳过计数;
    // 首字节才 inc(此前误用 NE,语义反转成数续字节,诊断 71040016 实证)。
    val iscont = Llvm.build_icmp(lib, builder, masked, contb, 32u32, "iscont")?
    Llvm.build_cond_br(lib, builder, iscont, step_blk, inc_blk)?
    Llvm.position_builder_at_end(lib, builder, inc_blk)?
    val c0 = Llvm.build_load(lib, builder, i64ty, cslot, "c")?
    val c1 = Llvm.build_add(lib, builder, c0, one, "c1")?
    Llvm.build_store(lib, builder, c1, cslot)?
    Llvm.build_br(lib, builder, step_blk)?
    Llvm.position_builder_at_end(lib, builder, step_blk)?
    val i2 = Llvm.build_load(lib, builder, i64ty, islot, "i")?
    val i3 = Llvm.build_add(lib, builder, i2, one, "i3")?
    Llvm.build_store(lib, builder, i3, islot)?
    Llvm.build_br(lib, builder, loop_blk)?
    Llvm.position_builder_at_end(lib, builder, end_blk)?
    Llvm.build_load(lib, builder, i64ty, cslot, "nchars")
}

// str ==(内联):len 不等 → false;等长逐字节循环,首异即短路 false;
// 全同 → true。结果走 alloca i1 槽。Neq = xor true。
fun str_eq_inline(lib: Lib, ctx: u64, builder: u64, cache: Map<str, u64>,
    fref: u64, ap: u64, bp: u64): Throw<u64, FfiError> {
    val i64ty = llty_for(lib, ctx, cache, TI64)?
    val i8ty = llty_for(lib, ctx, cache, TI8)?
    val i1ty = llty_for(lib, ctx, cache, TBool)?
    val la = Llvm.build_load(lib, builder, i64ty, ap, "la")?
    val lb = Llvm.build_load(lib, builder, i64ty, bp, "lb")?
    val lendiff = Llvm.build_icmp(lib, builder, la, lb, 33u32, "lendiff")?
    val res_slot = Llvm.build_alloca(lib, builder, i1ty, "seqr")?
    val t = Llvm.const_int(lib, i1ty, 1u64, false)?
    val f = Llvm.const_int(lib, i1ty, 0u64, false)?
    Llvm.build_store(lib, builder, t, res_slot)?
    val ne_blk = Llvm.append_block(lib, ctx, fref, "seq.ne")?
    val pre_blk = Llvm.append_block(lib, ctx, fref, "seq.pre")?
    val loop_blk = Llvm.append_block(lib, ctx, fref, "seq.loop")?
    val byte_blk = Llvm.append_block(lib, ctx, fref, "seq.byte")?
    val diff_blk = Llvm.append_block(lib, ctx, fref, "seq.diff")?
    val step_blk = Llvm.append_block(lib, ctx, fref, "seq.step")?
    val end_blk = Llvm.append_block(lib, ctx, fref, "seq.end")?
    Llvm.build_cond_br(lib, builder, lendiff, ne_blk, pre_blk)?
    Llvm.position_builder_at_end(lib, builder, ne_blk)?
    Llvm.build_store(lib, builder, f, res_slot)?
    Llvm.build_br(lib, builder, end_blk)?
    Llvm.position_builder_at_end(lib, builder, pre_blk)?
    val islot = Llvm.build_alloca(lib, builder, i64ty, "seqi")?
    val zero = Llvm.const_int(lib, i64ty, 0u64, false)?
    val one = Llvm.const_int(lib, i64ty, 1u64, false)?
    val c8 = Llvm.const_int(lib, i64ty, 8u64, false)?
    Llvm.build_store(lib, builder, zero, islot)?
    Llvm.build_br(lib, builder, loop_blk)?
    Llvm.position_builder_at_end(lib, builder, loop_blk)?
    val iv = Llvm.build_load(lib, builder, i64ty, islot, "i")?
    val more = Llvm.build_icmp(lib, builder, iv, la, 36u32, "more")?
    Llvm.build_cond_br(lib, builder, more, byte_blk, end_blk)?
    Llvm.position_builder_at_end(lib, builder, byte_blk)?
    // i8 基型仅容单索引:头 8 + i 先加总再 gep(两操作数共用)。
    val boff = Llvm.build_add(lib, builder, c8, iv, "boff")?
    val ab = Llvm.build_load(lib, builder, i8ty,
        Llvm.build_inbounds_gep2(lib, builder, i8ty, ap, [boff], "abp")?, "ab")?
    val bb = Llvm.build_load(lib, builder, i8ty,
        Llvm.build_inbounds_gep2(lib, builder, i8ty, bp, [boff], "bbp")?, "bb")?
    val same = Llvm.build_icmp(lib, builder, ab, bb, 32u32, "same")?
    Llvm.build_cond_br(lib, builder, same, step_blk, diff_blk)?
    Llvm.position_builder_at_end(lib, builder, diff_blk)?
    Llvm.build_store(lib, builder, f, res_slot)?
    Llvm.build_br(lib, builder, end_blk)?
    Llvm.position_builder_at_end(lib, builder, step_blk)?
    val i2 = Llvm.build_load(lib, builder, i64ty, islot, "i")?
    val i3 = Llvm.build_add(lib, builder, i2, one, "i3")?
    Llvm.build_store(lib, builder, i3, islot)?
    Llvm.build_br(lib, builder, loop_blk)?
    Llvm.position_builder_at_end(lib, builder, end_blk)?
    Llvm.build_load(lib, builder, i1ty, res_slot, "eqr")
}

// ── 切片 5:动态聚合部件(附十一)───────────────────────────────

// 数组元素型(resolve 到底:++ 表达式的 sema 型 elem 是经 unify 绑定
// 的 TypeVar,裸 array_parts().a 拿到 var 句柄)。
fun arr_elem_of(a: TypeArena, h: u32): u32 {
    Arena.resolve(a, (Arena.array_parts(a, Arena.resolve(a, h))).a)
}

// 动态尺寸分配(n 为运行期值;16 对齐由 frond_alloc 内部完成)。
fun call_alloc_dyn(lib: Lib, builder: u64, cache: Map<str, u64>, size_v: u64): Throw<u64, FfiError> {
    Llvm.build_call2(lib, builder, arena_ft, arena_fn, [size_v], tmp())
}

// str 拼接(+):新块 {len=l1+l2, bytes=并置};逐字节双循环拷贝。
fun str_concat(lib: Lib, ctx: u64, builder: u64, cache: Map<str, u64>,
    fref: u64, ap: u64, bp: u64): Throw<u64, FfiError> {
    val i64ty = llty_for(lib, ctx, cache, TI64)?
    val i8ty = llty_for(lib, ctx, cache, TI8)?
    val la = Llvm.build_load(lib, builder, i64ty, ap, "la")?
    val lb = Llvm.build_load(lib, builder, i64ty, bp, "lb")?
    val n = Llvm.build_add(lib, builder, la, lb, "sn")?
    val sz = Llvm.build_add(lib, builder, n, Llvm.const_int(lib, i64ty, 8u64, false)?, "ssz")?
    val p = call_alloc_dyn(lib, builder, cache, sz)?
    Llvm.build_store(lib, builder, n, p)?
    val c8 = Llvm.const_int(lib, i64ty, 8u64, false)?
    // 拷贝 A:dst 字节 8+k ← src 8+k(k < la)。
    val k1 = Llvm.build_alloca(lib, builder, i64ty, "ck1")?
    Llvm.build_store(lib, builder, Llvm.const_int(lib, i64ty, 0u64, false)?, k1)?
    val l1_blk = Llvm.append_block(lib, ctx, fref, "sc.l1")?
    val b1_blk = Llvm.append_block(lib, ctx, fref, "sc.b1")?
    val s1_blk = Llvm.append_block(lib, ctx, fref, "sc.s1")?
    val l2_blk = Llvm.append_block(lib, ctx, fref, "sc.l2")?
    val b2_blk = Llvm.append_block(lib, ctx, fref, "sc.b2")?
    val s2_blk = Llvm.append_block(lib, ctx, fref, "sc.s2")?
    val done_blk = Llvm.append_block(lib, ctx, fref, "sc.done")?
    Llvm.build_br(lib, builder, l1_blk)?
    Llvm.position_builder_at_end(lib, builder, l1_blk)?
    val kv1 = Llvm.build_load(lib, builder, i64ty, k1, "k1")?
    val more1 = Llvm.build_icmp(lib, builder, kv1, la, 36u32, "m1")?
    Llvm.build_cond_br(lib, builder, more1, b1_blk, l2_blk)?
    Llvm.position_builder_at_end(lib, builder, b1_blk)?
    val off1 = Llvm.build_add(lib, builder, c8, kv1, "o1")?
    val bv1 = Llvm.build_load(lib, builder, i8ty,
        Llvm.build_inbounds_gep2(lib, builder, i8ty, ap, [off1], "sap")?, "sb1")?
    Llvm.build_store(lib, builder, bv1,
        Llvm.build_inbounds_gep2(lib, builder, i8ty, p, [off1], "dp1")?)?
    Llvm.build_br(lib, builder, s1_blk)?
    Llvm.position_builder_at_end(lib, builder, s1_blk)?
    val k1b = Llvm.build_load(lib, builder, i64ty, k1, "k1b")?
    Llvm.build_store(lib, builder, Llvm.build_add(lib, builder, k1b, Llvm.const_int(lib, i64ty, 1u64, false)?, "k1n")?, k1)?
    Llvm.build_br(lib, builder, l1_blk)?
    // 拷贝 B:dst 字节 8+(la+k) ← src 8+k(k < lb)。
    Llvm.position_builder_at_end(lib, builder, l2_blk)?
    Llvm.build_store(lib, builder, Llvm.const_int(lib, i64ty, 0u64, false)?, k1)?
    Llvm.build_br(lib, builder, b2_blk)?
    Llvm.position_builder_at_end(lib, builder, b2_blk)?
    val kv2 = Llvm.build_load(lib, builder, i64ty, k1, "k2")?
    val more2 = Llvm.build_icmp(lib, builder, kv2, lb, 36u32, "m2")?
    Llvm.build_cond_br(lib, builder, more2, s2_blk, done_blk)?
    Llvm.position_builder_at_end(lib, builder, s2_blk)?
    val d2 = Llvm.build_add(lib, builder, la, Llvm.build_load(lib, builder, i64ty, k1, "k2b")?, "d2")?
    val doff = Llvm.build_add(lib, builder, c8, d2, "o2")?
    val soff = Llvm.build_add(lib, builder, c8, Llvm.build_load(lib, builder, i64ty, k1, "k2c")?, "o3")?
    val bv2 = Llvm.build_load(lib, builder, i8ty,
        Llvm.build_inbounds_gep2(lib, builder, i8ty, bp, [soff], "sbp")?, "sb2")?
    Llvm.build_store(lib, builder, bv2,
        Llvm.build_inbounds_gep2(lib, builder, i8ty, p, [doff], "dp2")?)?
    val k2b2 = Llvm.build_load(lib, builder, i64ty, k1, "k2d")?
    Llvm.build_store(lib, builder, Llvm.build_add(lib, builder, k2b2, Llvm.const_int(lib, i64ty, 1u64, false)?, "k2n")?, k1)?
    Llvm.build_br(lib, builder, b2_blk)?
    Llvm.position_builder_at_end(lib, builder, done_blk)?
    Ok(p)
}

// str 码点索引(引擎语义):走字节计非续字节,命中第 idx 个码点的首
// 字节 → UTF-8 解码为 i32 码点(1-4 字节按首字节形态分派)。
fun str_index_char(lib: Lib, ctx: u64, builder: u64, cache: Map<str, u64>,
    fref: u64, sp: u64, idx: u64): Throw<u64, FfiError> {
    val i64ty = llty_for(lib, ctx, cache, TI64)?
    val i8ty = llty_for(lib, ctx, cache, TI8)?
    val i32ty = llty_for(lib, ctx, cache, TI32)?
    val nbytes = Llvm.build_load(lib, builder, i64ty, sp, "nb")?
    val islot = Llvm.build_alloca(lib, builder, i64ty, "sii")?
    val cslot = Llvm.build_alloca(lib, builder, i64ty, "sic")?
    val one = Llvm.const_int(lib, i64ty, 1u64, false)?
    val c8 = Llvm.const_int(lib, i64ty, 8u64, false)?
    Llvm.build_store(lib, builder, Llvm.const_int(lib, i64ty, 0u64, false)?, islot)?
    Llvm.build_store(lib, builder, Llvm.const_int(lib, i64ty, 0u64, false)?, cslot)?
    val loop_blk = Llvm.append_block(lib, ctx, fref, "si.loop")?
    val body_blk = Llvm.append_block(lib, ctx, fref, "si.body")?
    val step_blk = Llvm.append_block(lib, ctx, fref, "si.step")?
    val oob_blk = Llvm.append_block(lib, ctx, fref, "si.oob")?
    Llvm.build_br(lib, builder, loop_blk)?
    // 越界(码点数耗尽未命中 idx)→ llvm.trap(引擎 OOB panic 同口径)。
    Llvm.position_builder_at_end(lib, builder, oob_blk)?
    Llvm.build_call2_0(lib, builder, trap_ft, trap_fn, "")?
    Llvm.build_unreachable(lib, builder)?
    Llvm.position_builder_at_end(lib, builder, loop_blk)?
    val iv = Llvm.build_load(lib, builder, i64ty, islot, "i")?
    val more = Llvm.build_icmp(lib, builder, iv, nbytes, 36u32, "more")?
    Llvm.build_cond_br(lib, builder, more, body_blk, oob_blk)?
    Llvm.position_builder_at_end(lib, builder, body_blk)?
    val boff = Llvm.build_add(lib, builder, c8, iv, "boff")?
    val bv = Llvm.build_load(lib, builder, i8ty,
        Llvm.build_inbounds_gep2(lib, builder, i8ty, sp, [boff], "bp")?, "b")?
    val mask = Llvm.const_int(lib, i8ty, 192u64, false)?
    val contb = Llvm.const_int(lib, i8ty, 128u64, false)?
    val masked = Llvm.build_and(lib, builder, bv, mask, "m")?
    val iscont = Llvm.build_icmp(lib, builder, masked, contb, 32u32, "iscont")?
    val first_blk = Llvm.append_block(lib, ctx, fref, "si.first")?
    Llvm.build_cond_br(lib, builder, iscont, step_blk, first_blk)?
    Llvm.position_builder_at_end(lib, builder, first_blk)?
    val cv = Llvm.build_load(lib, builder, i64ty, cslot, "c")?
    val hit = Llvm.build_icmp(lib, builder, cv, idx, 32u32, "hit")?
    val dec_blk = Llvm.append_block(lib, ctx, fref, "si.dec")?
    Llvm.build_cond_br(lib, builder, hit, dec_blk, step_blk)?
    Llvm.position_builder_at_end(lib, builder, step_blk)?
    val cv2 = Llvm.build_load(lib, builder, i64ty, cslot, "c2")?
    Llvm.build_store(lib, builder, Llvm.build_add(lib, builder, cv2, one, "c2n")?, cslot)?
    val iv2 = Llvm.build_load(lib, builder, i64ty, islot, "i2")?
    Llvm.build_store(lib, builder, Llvm.build_add(lib, builder, iv2, one, "i2n")?, islot)?
    Llvm.build_br(lib, builder, loop_blk)?
    // UTF-8 解码(四路链,每块恰一定位):b0<0x80→1B;(b0&0xE0)==0xC0
    // →2B;(b0&0xF0)==0xE0→3B;否则 4B。
    Llvm.position_builder_at_end(lib, builder, dec_blk)?
    val b0v = Llvm.build_load(lib, builder, i8ty,
        Llvm.build_inbounds_gep2(lib, builder, i8ty, sp, [boff], "b0p")?, "b0")?
    val b0 = Llvm.build_zext(lib, builder, b0v, i32ty, "b0z")?
    val res_slot = Llvm.build_alloca(lib, builder, i32ty, "cpr")?
    val w1_blk = Llvm.append_block(lib, ctx, fref, "si.w1")?
    val c2_blk = Llvm.append_block(lib, ctx, fref, "si.c2")?
    val d2_blk = Llvm.append_block(lib, ctx, fref, "si.d2")?
    val c3_blk = Llvm.append_block(lib, ctx, fref, "si.c3")?
    val d3_blk = Llvm.append_block(lib, ctx, fref, "si.d3")?
    val d4_blk = Llvm.append_block(lib, ctx, fref, "si.d4")?
    val dend_blk = Llvm.append_block(lib, ctx, fref, "si.dend")?
    val is1 = Llvm.build_icmp(lib, builder, b0, Llvm.const_int(lib, i32ty, 128u64, false)?, 36u32, "is1")?
    Llvm.build_cond_br(lib, builder, is1, w1_blk, c2_blk)?
    Llvm.position_builder_at_end(lib, builder, w1_blk)?
    Llvm.build_store(lib, builder, b0, res_slot)?
    Llvm.build_br(lib, builder, dend_blk)?
    Llvm.position_builder_at_end(lib, builder, c2_blk)?
    val is2 = Llvm.build_icmp(lib, builder,
        Llvm.build_and(lib, builder, b0, Llvm.const_int(lib, i32ty, 224u64, false)?, "m2h")?,
        Llvm.const_int(lib, i32ty, 192u64, false)?, 32u32, "is2")?
    Llvm.build_cond_br(lib, builder, is2, d2_blk, c3_blk)?
    Llvm.position_builder_at_end(lib, builder, d2_blk)?
    // 2 字节:cp = ((b0&0x1F)<<6) | (b1&0x3F)。
    val b1a = Llvm.build_zext(lib, builder, Llvm.build_load(lib, builder, i8ty,
        Llvm.build_inbounds_gep2(lib, builder, i8ty, sp, [Llvm.build_add(lib, builder, boff, one, "b1o")?], "b1p")?, "b1l")?, i32ty, "b1z")?
    val cp2 = Llvm.build_or(lib, builder,
        Llvm.build_shl(lib, builder, Llvm.build_and(lib, builder, b0, Llvm.const_int(lib, i32ty, 31u64, false)?, "a2")?,
            Llvm.const_int(lib, i32ty, 6u64, false)?, "s2")?,
        Llvm.build_and(lib, builder, b1a, Llvm.const_int(lib, i32ty, 63u64, false)?, "a3")?, "cp2")?
    Llvm.build_store(lib, builder, cp2, res_slot)?
    Llvm.build_br(lib, builder, dend_blk)?
    Llvm.position_builder_at_end(lib, builder, c3_blk)?
    val is3 = Llvm.build_icmp(lib, builder,
        Llvm.build_and(lib, builder, b0, Llvm.const_int(lib, i32ty, 240u64, false)?, "m3h")?,
        Llvm.const_int(lib, i32ty, 224u64, false)?, 32u32, "is3")?
    Llvm.build_cond_br(lib, builder, is3, d3_blk, d4_blk)?
    Llvm.position_builder_at_end(lib, builder, d3_blk)?
    // 3 字节:cp = ((b0&0x0F)<<12) | ((b1&0x3F)<<6) | (b2&0x3F)。
    val two = Llvm.const_int(lib, i64ty, 2u64, false)?
    val b1b = Llvm.build_zext(lib, builder, Llvm.build_load(lib, builder, i8ty,
        Llvm.build_inbounds_gep2(lib, builder, i8ty, sp, [Llvm.build_add(lib, builder, boff, one, "b1o2")?], "b1p2")?, "b1l2")?, i32ty, "b1z2")?
    val b2b = Llvm.build_zext(lib, builder, Llvm.build_load(lib, builder, i8ty,
        Llvm.build_inbounds_gep2(lib, builder, i8ty, sp, [Llvm.build_add(lib, builder, boff, two, "b2o")?], "b2p")?, "b2l")?, i32ty, "b2z")?
    val cp3 = Llvm.build_or(lib, builder,
        Llvm.build_or(lib, builder,
            Llvm.build_shl(lib, builder, Llvm.build_and(lib, builder, b0, Llvm.const_int(lib, i32ty, 15u64, false)?, "a4")?,
                Llvm.const_int(lib, i32ty, 12u64, false)?, "s4")?,
            Llvm.build_shl(lib, builder, Llvm.build_and(lib, builder, b1b, Llvm.const_int(lib, i32ty, 63u64, false)?, "a5")?,
                Llvm.const_int(lib, i32ty, 6u64, false)?, "s5")?, "c3a")?,
        Llvm.build_and(lib, builder, b2b, Llvm.const_int(lib, i32ty, 63u64, false)?, "a6")?, "cp3")?
    Llvm.build_store(lib, builder, cp3, res_slot)?
    Llvm.build_br(lib, builder, dend_blk)?
    Llvm.position_builder_at_end(lib, builder, d4_blk)?
    // 4 字节:cp = ((b0&0x07)<<18) | ((b1&0x3F)<<12) | ((b2&0x3F)<<6) | (b3&0x3F)。
    val three = Llvm.const_int(lib, i64ty, 3u64, false)?
    val b1c = Llvm.build_zext(lib, builder, Llvm.build_load(lib, builder, i8ty,
        Llvm.build_inbounds_gep2(lib, builder, i8ty, sp, [Llvm.build_add(lib, builder, boff, one, "b1o3")?], "b1p3")?, "b1l3")?, i32ty, "b1z3")?
    val b2c = Llvm.build_zext(lib, builder, Llvm.build_load(lib, builder, i8ty,
        Llvm.build_inbounds_gep2(lib, builder, i8ty, sp, [Llvm.build_add(lib, builder, boff, two, "b2o2")?], "b2p2")?, "b2l2")?, i32ty, "b2z2")?
    val b3c = Llvm.build_zext(lib, builder, Llvm.build_load(lib, builder, i8ty,
        Llvm.build_inbounds_gep2(lib, builder, i8ty, sp, [Llvm.build_add(lib, builder, boff, three, "b3o")?], "b3p")?, "b3l")?, i32ty, "b3z")?
    val cp4 = Llvm.build_or(lib, builder,
        Llvm.build_or(lib, builder,
            Llvm.build_or(lib, builder,
                Llvm.build_shl(lib, builder, Llvm.build_and(lib, builder, b0, Llvm.const_int(lib, i32ty, 7u64, false)?, "a7")?,
                    Llvm.const_int(lib, i32ty, 18u64, false)?, "s7")?,
                Llvm.build_shl(lib, builder, Llvm.build_and(lib, builder, b1c, Llvm.const_int(lib, i32ty, 63u64, false)?, "a8")?,
                    Llvm.const_int(lib, i32ty, 12u64, false)?, "s8")?, "c4a")?,
            Llvm.build_shl(lib, builder, Llvm.build_and(lib, builder, b2c, Llvm.const_int(lib, i32ty, 63u64, false)?, "a9")?,
                Llvm.const_int(lib, i32ty, 6u64, false)?, "s9")?, "c4b")?,
        Llvm.build_and(lib, builder, b3c, Llvm.const_int(lib, i32ty, 63u64, false)?, "a10")?, "cp4")?
    Llvm.build_store(lib, builder, cp4, res_slot)?
    Llvm.build_br(lib, builder, dend_blk)?
    Llvm.position_builder_at_end(lib, builder, dend_blk)?
    Llvm.build_load(lib, builder, i32ty, res_slot, "cpv")
}

// str 切片 [lo..hi)(码点语义):单趟走字节,记 cp==lo 的字节偏移与
// cp==hi 的字节偏移(未命中 hi → nbytes);新块拷贝该字节区间。
fun str_slice(lib: Lib, ctx: u64, builder: u64, cache: Map<str, u64>,
    fref: u64, sp: u64, lo: u64, hi: u64): Throw<u64, FfiError> {
    val i64ty = llty_for(lib, ctx, cache, TI64)?
    val i8ty = llty_for(lib, ctx, cache, TI8)?
    val nbytes = Llvm.build_load(lib, builder, i64ty, sp, "nb")?
    val islot = Llvm.build_alloca(lib, builder, i64ty, "sli")?
    val cslot = Llvm.build_alloca(lib, builder, i64ty, "slc")?
    val lo_slot = Llvm.build_alloca(lib, builder, i64ty, "slo")?
    val hi_slot = Llvm.build_alloca(lib, builder, i64ty, "shi")?
    val zero = Llvm.const_int(lib, i64ty, 0u64, false)?
    val one = Llvm.const_int(lib, i64ty, 1u64, false)?
    val c8 = Llvm.const_int(lib, i64ty, 8u64, false)?
    Llvm.build_store(lib, builder, zero, islot)?
    Llvm.build_store(lib, builder, zero, cslot)?
    Llvm.build_store(lib, builder, zero, lo_slot)?
    Llvm.build_store(lib, builder, nbytes, hi_slot)?
    val loop_blk = Llvm.append_block(lib, ctx, fref, "sl.loop")?
    val body_blk = Llvm.append_block(lib, ctx, fref, "sl.body")?
    val first_blk = Llvm.append_block(lib, ctx, fref, "sl.first")?
    val loy_blk = Llvm.append_block(lib, ctx, fref, "sl.loy")?
    val lon_blk = Llvm.append_block(lib, ctx, fref, "sl.lon")?
    val hiy_blk = Llvm.append_block(lib, ctx, fref, "sl.hiy")?
    val step_blk = Llvm.append_block(lib, ctx, fref, "sl.step")?
    val done_blk = Llvm.append_block(lib, ctx, fref, "sl.done")?
    Llvm.build_br(lib, builder, loop_blk)?
    Llvm.position_builder_at_end(lib, builder, loop_blk)?
    val iv = Llvm.build_load(lib, builder, i64ty, islot, "i")?
    val more = Llvm.build_icmp(lib, builder, iv, nbytes, 36u32, "more")?
    Llvm.build_cond_br(lib, builder, more, body_blk, done_blk)?
    Llvm.position_builder_at_end(lib, builder, body_blk)?
    val boff = Llvm.build_add(lib, builder, c8, iv, "boff")?
    val bv = Llvm.build_load(lib, builder, i8ty,
        Llvm.build_inbounds_gep2(lib, builder, i8ty, sp, [boff], "bp")?, "b")?
    val mask = Llvm.const_int(lib, i8ty, 192u64, false)?
    val contb = Llvm.const_int(lib, i8ty, 128u64, false)?
    val masked = Llvm.build_and(lib, builder, bv, mask, "m")?
    val iscont = Llvm.build_icmp(lib, builder, masked, contb, 32u32, "iscont")?
    Llvm.build_cond_br(lib, builder, iscont, step_blk, first_blk)?
    Llvm.position_builder_at_end(lib, builder, first_blk)?
    val cv = Llvm.build_load(lib, builder, i64ty, cslot, "c")?
    val islo = Llvm.build_icmp(lib, builder, cv, lo, 32u32, "islo")?
    Llvm.build_cond_br(lib, builder, islo, loy_blk, lon_blk)?
    Llvm.position_builder_at_end(lib, builder, loy_blk)?
    Llvm.build_store(lib, builder, iv, lo_slot)?
    Llvm.build_br(lib, builder, lon_blk)?
    Llvm.position_builder_at_end(lib, builder, lon_blk)?
    val cv2 = Llvm.build_load(lib, builder, i64ty, cslot, "c2")?
    val ishi = Llvm.build_icmp(lib, builder, cv2, hi, 32u32, "ishi")?
    Llvm.build_cond_br(lib, builder, ishi, hiy_blk, step_blk)?
    Llvm.position_builder_at_end(lib, builder, hiy_blk)?
    Llvm.build_store(lib, builder, iv, hi_slot)?
    Llvm.build_br(lib, builder, done_blk)?
    Llvm.position_builder_at_end(lib, builder, step_blk)?
    val cv3 = Llvm.build_load(lib, builder, i64ty, cslot, "c3")?
    Llvm.build_store(lib, builder, Llvm.build_add(lib, builder, cv3, one, "c3n")?, cslot)?
    val iv2 = Llvm.build_load(lib, builder, i64ty, islot, "i2")?
    Llvm.build_store(lib, builder, Llvm.build_add(lib, builder, iv2, one, "i2n")?, islot)?
    Llvm.build_br(lib, builder, loop_blk)?
    Llvm.position_builder_at_end(lib, builder, done_blk)?
    val lo_off = Llvm.build_load(lib, builder, i64ty, lo_slot, "lof")?
    val hi_off = Llvm.build_load(lib, builder, i64ty, hi_slot, "hif")?
    val n = Llvm.build_sub(lib, builder, hi_off, lo_off, "sn")?
    val sz = Llvm.build_add(lib, builder, n, c8, "ssz")?
    val p = call_alloc_dyn(lib, builder, cache, sz)?
    Llvm.build_store(lib, builder, n, p)?
    val kslot = Llvm.build_alloca(lib, builder, i64ty, "slk")?
    Llvm.build_store(lib, builder, zero, kslot)?
    val cloop_blk = Llvm.append_block(lib, ctx, fref, "slc.loop")?
    val cbody_blk = Llvm.append_block(lib, ctx, fref, "slc.body")?
    val cstep_blk = Llvm.append_block(lib, ctx, fref, "slc.step")?
    val cend_blk = Llvm.append_block(lib, ctx, fref, "slc.end")?
    Llvm.build_br(lib, builder, cloop_blk)?
    Llvm.position_builder_at_end(lib, builder, cloop_blk)?
    val kv = Llvm.build_load(lib, builder, i64ty, kslot, "k")?
    val kmore = Llvm.build_icmp(lib, builder, kv, n, 36u32, "kmore")?
    Llvm.build_cond_br(lib, builder, kmore, cbody_blk, cend_blk)?
    Llvm.position_builder_at_end(lib, builder, cbody_blk)?
    val src_off = Llvm.build_add(lib, builder, c8, Llvm.build_add(lib, builder, lo_off, kv, "so")?, "sp2")?
    val dst_off = Llvm.build_add(lib, builder, c8, kv, "dp3")?
    val cb = Llvm.build_load(lib, builder, i8ty,
        Llvm.build_inbounds_gep2(lib, builder, i8ty, sp, [src_off], "cbp")?, "cb")?
    Llvm.build_store(lib, builder, cb,
        Llvm.build_inbounds_gep2(lib, builder, i8ty, p, [dst_off], "cdp")?)?
    Llvm.build_br(lib, builder, cstep_blk)?
    Llvm.position_builder_at_end(lib, builder, cstep_blk)?
    val kb = Llvm.build_load(lib, builder, i64ty, kslot, "kb")?
    Llvm.build_store(lib, builder, Llvm.build_add(lib, builder, kb, one, "kn")?, kslot)?
    Llvm.build_br(lib, builder, cloop_blk)?
    Llvm.position_builder_at_end(lib, builder, cend_blk)?
    Ok(p)
}

// 数组拼接(++):新块 {len=l1+l2, elems=并置};元素按 elem 型
// load/store(标量本体/聚合 ptr 通用)。
fun arr_concat(lib: Lib, ctx: u64, builder: u64, cache: Map<str, u64>,
    fref: u64, a: TypeArena, s: SemaRes, ap: u64, bp: u64,
    elem_h: u32): Throw<u64, FfiError> {
    val i64ty = llty_for(lib, ctx, cache, TI64)?
    val i8ty = llty_for(lib, ctx, cache, TI8)?
    val elt = llty_for_h(lib, ctx, cache, a, s, elem_h)?
    val esz = agg_size(lib, ctx, cache, a, s, elem_h)?
    val la = Llvm.build_load(lib, builder, i64ty, ap, "la")?
    val lb = Llvm.build_load(lib, builder, i64ty, bp, "lb")?
    val n = Llvm.build_add(lib, builder, la, lb, "an")?
    val c16 = Llvm.const_int(lib, i64ty, 16u64, false)?
    val eszc = Llvm.const_int(lib, i64ty, esz, false)?
    val sz = Llvm.build_add(lib, builder, c16, Llvm.build_mul(lib, builder, n, eszc, "asz")?, "asum")?
    val p = call_alloc_dyn(lib, builder, cache, sz)?
    Llvm.build_store(lib, builder, n, p)?
    val one = Llvm.const_int(lib, i64ty, 1u64, false)?
    val kslot = Llvm.build_alloca(lib, builder, i64ty, "ack")?
    Llvm.build_store(lib, builder, Llvm.const_int(lib, i64ty, 0u64, false)?, kslot)?
    // 拷贝 A。
    val l1_blk = Llvm.append_block(lib, ctx, fref, "ac.l1")?
    val b1_blk = Llvm.append_block(lib, ctx, fref, "ac.b1")?
    val s1_blk = Llvm.append_block(lib, ctx, fref, "ac.s1")?
    val l2_blk = Llvm.append_block(lib, ctx, fref, "ac.l2")?
    val b2_blk = Llvm.append_block(lib, ctx, fref, "ac.b2")?
    val s2_blk = Llvm.append_block(lib, ctx, fref, "ac.s2")?
    val done_blk = Llvm.append_block(lib, ctx, fref, "ac.done")?
    Llvm.build_br(lib, builder, l1_blk)?
    Llvm.position_builder_at_end(lib, builder, l1_blk)?
    val kv1 = Llvm.build_load(lib, builder, i64ty, kslot, "k1")?
    val more1 = Llvm.build_icmp(lib, builder, kv1, la, 36u32, "m1")?
    Llvm.build_cond_br(lib, builder, more1, b1_blk, l2_blk)?
    Llvm.position_builder_at_end(lib, builder, b1_blk)?
    val off1 = Llvm.build_add(lib, builder, c16, Llvm.build_mul(lib, builder, kv1, eszc, "o1m")?, "o1")?
    val ev1 = Llvm.build_load(lib, builder, elt,
        Llvm.build_inbounds_gep2(lib, builder, i8ty, ap, [off1], "aep")?, "ae1")?
    Llvm.build_store(lib, builder, ev1,
        Llvm.build_inbounds_gep2(lib, builder, i8ty, p, [off1], "adp")?)?
    Llvm.build_br(lib, builder, s1_blk)?
    Llvm.position_builder_at_end(lib, builder, s1_blk)?
    val k1b = Llvm.build_load(lib, builder, i64ty, kslot, "k1b")?
    Llvm.build_store(lib, builder, Llvm.build_add(lib, builder, k1b, one, "k1n")?, kslot)?
    Llvm.build_br(lib, builder, l1_blk)?
    // 拷贝 B(dst 偏移含 la 前缀)。
    Llvm.position_builder_at_end(lib, builder, l2_blk)?
    Llvm.build_store(lib, builder, Llvm.const_int(lib, i64ty, 0u64, false)?, kslot)?
    Llvm.build_br(lib, builder, b2_blk)?
    Llvm.position_builder_at_end(lib, builder, b2_blk)?
    val kv2 = Llvm.build_load(lib, builder, i64ty, kslot, "k2")?
    val more2 = Llvm.build_icmp(lib, builder, kv2, lb, 36u32, "m2")?
    Llvm.build_cond_br(lib, builder, more2, s2_blk, done_blk)?
    Llvm.position_builder_at_end(lib, builder, s2_blk)?
    val d2 = Llvm.build_add(lib, builder, la, Llvm.build_load(lib, builder, i64ty, kslot, "k2b")?, "d2")?
    val doff = Llvm.build_add(lib, builder, c16, Llvm.build_mul(lib, builder, d2, eszc, "o2m")?, "o2")?
    val soff = Llvm.build_add(lib, builder, c16, Llvm.build_mul(lib, builder, Llvm.build_load(lib, builder, i64ty, kslot, "k2c")?, eszc, "o3m")?, "o3")?
    val ev2 = Llvm.build_load(lib, builder, elt,
        Llvm.build_inbounds_gep2(lib, builder, i8ty, bp, [soff], "bep")?, "ae2")?
    Llvm.build_store(lib, builder, ev2,
        Llvm.build_inbounds_gep2(lib, builder, i8ty, p, [doff], "bdp")?)?
    val k2b2 = Llvm.build_load(lib, builder, i64ty, kslot, "k2d")?
    Llvm.build_store(lib, builder, Llvm.build_add(lib, builder, k2b2, one, "k2n")?, kslot)?
    Llvm.build_br(lib, builder, b2_blk)?
    Llvm.position_builder_at_end(lib, builder, done_blk)?
    Ok(p)
}

// 数组切片 [lo..hi):新块 {len=hi-lo, elems=拷贝}。
fun arr_slice(lib: Lib, ctx: u64, builder: u64, cache: Map<str, u64>,
    fref: u64, a: TypeArena, s: SemaRes, ap: u64, lo: u64, hi: u64,
    elem_h: u32): Throw<u64, FfiError> {
    val i64ty = llty_for(lib, ctx, cache, TI64)?
    val i8ty = llty_for(lib, ctx, cache, TI8)?
    val elt = llty_for_h(lib, ctx, cache, a, s, elem_h)?
    val esz = agg_size(lib, ctx, cache, a, s, elem_h)?
    val eszc = Llvm.const_int(lib, i64ty, esz, false)?
    val c16 = Llvm.const_int(lib, i64ty, 16u64, false)?
    val one = Llvm.const_int(lib, i64ty, 1u64, false)?
    val n = Llvm.build_sub(lib, builder, hi, lo, "asn")?
    val sz = Llvm.build_add(lib, builder, c16, Llvm.build_mul(lib, builder, n, eszc, "asz2")?, "asum2")?
    val p = call_alloc_dyn(lib, builder, cache, sz)?
    Llvm.build_store(lib, builder, n, p)?
    val kslot = Llvm.build_alloca(lib, builder, i64ty, "ask")?
    Llvm.build_store(lib, builder, Llvm.const_int(lib, i64ty, 0u64, false)?, kslot)?
    val loop_blk = Llvm.append_block(lib, ctx, fref, "as.loop")?
    val body_blk = Llvm.append_block(lib, ctx, fref, "as.body")?
    val step_blk = Llvm.append_block(lib, ctx, fref, "as.step")?
    val end_blk = Llvm.append_block(lib, ctx, fref, "as.end")?
    Llvm.build_br(lib, builder, loop_blk)?
    Llvm.position_builder_at_end(lib, builder, loop_blk)?
    val kv = Llvm.build_load(lib, builder, i64ty, kslot, "k")?
    val more = Llvm.build_icmp(lib, builder, kv, n, 36u32, "more")?
    Llvm.build_cond_br(lib, builder, more, body_blk, end_blk)?
    Llvm.position_builder_at_end(lib, builder, body_blk)?
    val src_k = Llvm.build_add(lib, builder, lo, kv, "sk")?
    val soff = Llvm.build_add(lib, builder, c16, Llvm.build_mul(lib, builder, src_k, eszc, "som")?, "so4")?
    val doff = Llvm.build_add(lib, builder, c16, Llvm.build_mul(lib, builder, kv, eszc, "dom")?, "do4")?
    val ev = Llvm.build_load(lib, builder, elt,
        Llvm.build_inbounds_gep2(lib, builder, i8ty, ap, [soff], "asep")?, "ase")?
    Llvm.build_store(lib, builder, ev,
        Llvm.build_inbounds_gep2(lib, builder, i8ty, p, [doff], "adp2")?)?
    Llvm.build_br(lib, builder, step_blk)?
    Llvm.position_builder_at_end(lib, builder, step_blk)?
    val kb = Llvm.build_load(lib, builder, i64ty, kslot, "kb")?
    Llvm.build_store(lib, builder, Llvm.build_add(lib, builder, kb, one, "kn2")?, kslot)?
    Llvm.build_br(lib, builder, loop_blk)?
    Llvm.position_builder_at_end(lib, builder, end_blk)?
    Ok(p)
}

// 深相等(引擎内容相等语义,镜像 record-shape ptr_eq 短路仅同型优化
// 不改语义):str = 字节循环;数组 = len + 逐元素递归(双侧各按己型
// 装载,叶级 conv 统一——peer 型数组 i32[] vs i64[] 引擎语义相等);
// record = 逐字段递归;标量 = icmp(异宽先 conv 到 LHS 型)。
// ADT/Throw/nullable 深相等不在本切片(响亮报错)。
fun deep_eq(lib: Lib, ctx: u64, builder: u64, cache: Map<str, u64>,
    fref: u64, a: TypeArena, s: SemaRes, lv: u64, rv: u64,
    lh: u32, rh: u32): Throw<u64, FfiError> {
    val k = agg_kind(a, s, lh)
    if k == 5 {
        return str_eq_inline(lib, ctx, builder, cache, fref, lv, rv)
    }
    val i1ty = llty_for(lib, ctx, cache, TBool)?
    val i64ty = llty_for(lib, ctx, cache, TI64)?
    val t = Llvm.const_int(lib, i1ty, 1u64, false)?
    val f = Llvm.const_int(lib, i1ty, 0u64, false)?
    val res_slot = Llvm.build_alloca(lib, builder, i1ty, "der")?
    Llvm.build_store(lib, builder, t, res_slot)?
    if k == 6 {
        val elh = arr_elem_of(a, lh)
        val erh = arr_elem_of(a, rh)
        val la = Llvm.build_load(lib, builder, i64ty, lv, "la")?
        val lb = Llvm.build_load(lib, builder, i64ty, rv, "lb")?
        val lendiff = Llvm.build_icmp(lib, builder, la, lb, 33u32, "lendiff")?
        val ne_blk = Llvm.append_block(lib, ctx, fref, "de.ne")?
        val pre_blk = Llvm.append_block(lib, ctx, fref, "de.pre")?
        val loop_blk = Llvm.append_block(lib, ctx, fref, "de.loop")?
        val body_blk = Llvm.append_block(lib, ctx, fref, "de.body")?
        val diff_blk = Llvm.append_block(lib, ctx, fref, "de.diff")?
        val step_blk = Llvm.append_block(lib, ctx, fref, "de.step")?
        val end_blk = Llvm.append_block(lib, ctx, fref, "de.end")?
        Llvm.build_cond_br(lib, builder, lendiff, ne_blk, pre_blk)?
        Llvm.position_builder_at_end(lib, builder, ne_blk)?
        Llvm.build_store(lib, builder, f, res_slot)?
        Llvm.build_br(lib, builder, end_blk)?
        Llvm.position_builder_at_end(lib, builder, pre_blk)?
        val kslot = Llvm.build_alloca(lib, builder, i64ty, "dek")?
        val zero = Llvm.const_int(lib, i64ty, 0u64, false)?
        val one = Llvm.const_int(lib, i64ty, 1u64, false)?
        Llvm.build_store(lib, builder, zero, kslot)?
        Llvm.build_br(lib, builder, loop_blk)?
        Llvm.position_builder_at_end(lib, builder, loop_blk)?
        val kv = Llvm.build_load(lib, builder, i64ty, kslot, "k")?
        val more = Llvm.build_icmp(lib, builder, kv, la, 36u32, "more")?
        Llvm.build_cond_br(lib, builder, more, body_blk, end_blk)?
        Llvm.position_builder_at_end(lib, builder, body_blk)?
        val ea = arr_elem_addr(lib, ctx, builder, cache, fref, a, s, lv, lh, kv, Arena.from_scalar_name(a, "i64"), 0)?
        val ev1 = load_at(lib, ctx, builder, cache, a, s, ea, elh)?
        val ea2 = arr_elem_addr(lib, ctx, builder, cache, fref, a, s, rv, rh, kv, Arena.from_scalar_name(a, "i64"), 0)?
        val ev2 = load_at(lib, ctx, builder, cache, a, s, ea2, erh)?
        val eqv = deep_eq(lib, ctx, builder, cache, fref, a, s, ev1, ev2, elh, erh)?
        Llvm.build_cond_br(lib, builder, eqv, step_blk, diff_blk)?
        Llvm.position_builder_at_end(lib, builder, diff_blk)?
        Llvm.build_store(lib, builder, f, res_slot)?
        Llvm.build_br(lib, builder, end_blk)?
        Llvm.position_builder_at_end(lib, builder, step_blk)?
        val kb = Llvm.build_load(lib, builder, i64ty, kslot, "kb")?
        Llvm.build_store(lib, builder, Llvm.build_add(lib, builder, kb, one, "kn")?, kslot)?
        Llvm.build_br(lib, builder, loop_blk)?
        Llvm.position_builder_at_end(lib, builder, end_blk)?
        return Llvm.build_load(lib, builder, i1ty, res_slot, "dev")
    }
    if k == 7 {
        val rn = record_name_of(a, lh) ?? "?"
        val fts = Semares.record_shape(s, rn) ?? []
        val lt = record_layout(lib, ctx, cache, a, s, rn)?
        var fi: usize = 0
        val done_blk = Llvm.append_block(lib, ctx, fref, "de.fend")?
        while fi < fts.len() {
            val fa = Llvm.build_struct_gep(lib, builder, lt, lv, fi as u32, tmp())?
            val fb = Llvm.build_struct_gep(lib, builder, lt, rv, fi as u32, tmp())?
            val fv1 = load_at(lib, ctx, builder, cache, a, s, fa, fts[fi])?
            val fv2 = load_at(lib, ctx, builder, cache, a, s, fb, fts[fi])?
            val eqv = deep_eq(lib, ctx, builder, cache, fref, a, s, fv1, fv2, fts[fi], fts[fi])?
            val diff_blk = Llvm.append_block(lib, ctx, fref, "de.fdiff")?
            val next_blk = Llvm.append_block(lib, ctx, fref, "de.fnext")?
            Llvm.build_cond_br(lib, builder, eqv, next_blk, diff_blk)?
            Llvm.position_builder_at_end(lib, builder, diff_blk)?
            Llvm.build_store(lib, builder, f, res_slot)?
            Llvm.build_br(lib, builder, done_blk)?
            Llvm.position_builder_at_end(lib, builder, next_blk)?
            fi = fi + 1
        }
        Llvm.build_br(lib, builder, done_blk)?
        Llvm.position_builder_at_end(lib, builder, done_blk)?
        return Llvm.build_load(lib, builder, i1ty, res_slot, "dev")
    }
    if k == 8 {
        // 切片 6a:多 ctor ADT 深相等——tag 相等后按 tag 走 per-ctor
        // 字段比较(字段型 = adt_ctor_fields;布局 gep 1..n 同构造)。
        val tn = record_name_of(a, lh) ?? "?"
        val nctors = Semares.adt_ctor_count(s, tn)
        if nctors <= 0 {
            throw FfiError(Other, "slice 6: deep equality on unknown ADT '{tn}'")
        }
        val end8_blk = Llvm.append_block(lib, ctx, fref, "deq.end8")?
        val tl = nullable_tag(lib, ctx, builder, cache, lv)?
        val tr = nullable_tag(lib, ctx, builder, cache, rv)?
        val tags_eq = Llvm.build_icmp(lib, builder, tl, tr, 32u32, "deq.tg")?
        val tne_blk = Llvm.append_block(lib, ctx, fref, "deq.tne")?
        val tok_blk = Llvm.append_block(lib, ctx, fref, "deq.tok")?
        Llvm.build_cond_br(lib, builder, tags_eq, tok_blk, tne_blk)?
        Llvm.position_builder_at_end(lib, builder, tne_blk)?
        Llvm.build_store(lib, builder, f, res_slot)?
        Llvm.build_br(lib, builder, end8_blk)?
        Llvm.position_builder_at_end(lib, builder, tok_blk)?
        var ci: i64 = 0
        while ci < nctors {
            val is_this = Llvm.build_icmp(lib, builder, tl,
                Llvm.const_int(lib, i64ty, ci as u64, false)?, 32u32, "deq.ct")?
            val cf_blk = Llvm.append_block(lib, ctx, fref, "deq.cf")?
            val cn_blk = Llvm.append_block(lib, ctx, fref, "deq.cn")?
            Llvm.build_cond_br(lib, builder, is_this, cf_blk, cn_blk)?
            Llvm.position_builder_at_end(lib, builder, cf_blk)?
            val fts = Semares.adt_ctor_fields(s, tn, ci) ?? []
            val lt = adt_ctor_layout(lib, ctx, cache, a, s, tn, ci)?
            var fi: usize = 0
            while fi < fts.len() {
                val fa = Llvm.build_struct_gep(lib, builder, lt, lv, (fi + 1) as u32, tmp())?
                val fb = Llvm.build_struct_gep(lib, builder, lt, rv, (fi + 1) as u32, tmp())?
                val fv1 = load_at(lib, ctx, builder, cache, a, s, fa, fts[fi])?
                val fv2 = load_at(lib, ctx, builder, cache, a, s, fb, fts[fi])?
                val eqv = deep_eq(lib, ctx, builder, cache, fref, a, s, fv1, fv2, fts[fi], fts[fi])?
                val fd_blk = Llvm.append_block(lib, ctx, fref, "deq.fd")?
                val fn_blk = Llvm.append_block(lib, ctx, fref, "deq.fn")?
                Llvm.build_cond_br(lib, builder, eqv, fn_blk, fd_blk)?
                Llvm.position_builder_at_end(lib, builder, fd_blk)?
                Llvm.build_store(lib, builder, f, res_slot)?
                Llvm.build_br(lib, builder, end8_blk)?
                Llvm.position_builder_at_end(lib, builder, fn_blk)?
                fi = fi + 1
            }
            Llvm.build_br(lib, builder, end8_blk)?
            Llvm.position_builder_at_end(lib, builder, cn_blk)?
            ci = ci + 1
        }
        // 全部 ctor 未命中(tag 越界,不可达)→ false。
        Llvm.build_store(lib, builder, f, res_slot)?
        Llvm.build_br(lib, builder, end8_blk)?
        Llvm.position_builder_at_end(lib, builder, end8_blk)?
        return Llvm.build_load(lib, builder, i1ty, res_slot, "dev")
    }
    if k == 9 || k == 10 {
        throw FfiError(Other, "slice 5: deep equality on nullable/Throw not supported (kind {k})")
    }
    // 标量叶:同 llty 键直 icmp;异宽/异号先 conv RHS 到 LHS 型。
    if llty_key(Arena.get(a, Arena.resolve(a, lh))) == llty_key(Arena.get(a, Arena.resolve(a, rh))) {
        return cmp_build(lib, builder, Arena.get(a, Arena.resolve(a, lh)), lv, rv, 32u32, 1u32)
    }
    val rvc = conv_value(lib, ctx, builder, cache, a, s, rv, rh, lh, "dew")?
    cmp_build(lib, builder, Arena.get(a, Arena.resolve(a, lh)), lv, rvc, 32u32, 1u32)
}

// 数组元素地址(读/写共用):idx conv i64 → 越界(uge len)llvm.trap →
// 字节 gep(头 16 = i64 len + 8 pad,elem 16 对齐保 f128;步进 =
// idx*esz)。返回元素地址;elem 类型由调用方 array_parts 取。
fun arr_elem_addr(lib: Lib, ctx: u64, builder: u64, cache: Map<str, u64>, fref: u64,
    a: TypeArena, s: SemaRes, arr_ptr: u64, arr_h: u32,
    idx_v: u64, idx_h: u32, eid: i64): Throw<u64, FfiError> {
    val i64ty = llty_for(lib, ctx, cache, TI64)?
    val i8ty = llty_for(lib, ctx, cache, TI8)?
    val i64_h = Arena.from_scalar_name(a, "i64")
    val idx = conv_value(lib, ctx, builder, cache, a, s, idx_v, idx_h, i64_h, tmp())?
    val len = Llvm.build_load(lib, builder, i64ty, arr_ptr, "alen")?
    val oob = Llvm.build_icmp(lib, builder, idx, len, 35u32, "oob")?
    val ok_blk = Llvm.append_block(lib, ctx, fref, "idx.ok")?
    val trap_blk = Llvm.append_block(lib, ctx, fref, "idx.oob")?
    Llvm.build_cond_br(lib, builder, oob, trap_blk, ok_blk)?
    Llvm.position_builder_at_end(lib, builder, trap_blk)?
    Llvm.build_call2_0(lib, builder, trap_ft, trap_fn, "")?
    Llvm.build_unreachable(lib, builder)?
    Llvm.position_builder_at_end(lib, builder, ok_blk)?
    val elem_h = Arena.resolve(a, (Arena.array_parts(a, arr_h)).a)
    val esz = agg_size(lib, ctx, cache, a, s, elem_h)?
    val off = Llvm.build_mul(lib, builder, idx,
        Llvm.const_int(lib, i64ty, esz, false)?, "off")?
    val c16 = Llvm.const_int(lib, i64ty, 16u64, false)?
    // i8 基型仅容单索引:头 16 + off 先加总再 gep。
    val eoff = Llvm.build_add(lib, builder, c16, off, "eoff")?
    Llvm.build_inbounds_gep2(lib, builder, i8ty, arr_ptr, [eoff], "ep")
}

// 地址装载(读路径收尾):标量 load 本体;聚合 load ptr(槽/字段/
// 元素里存的是块地址)。llty_for_h 统一二形。
fun load_at(lib: Lib, ctx: u64, builder: u64, cache: Map<str, u64>,
    a: TypeArena, s: SemaRes, addr: u64, ty_h: u32): Throw<u64, FfiError> {
    val lt = llty_for_h(lib, ctx, cache, a, s, ty_h)?
    Llvm.build_load(lib, builder, lt, addr, tmp())
}

// record 字段定位(读/写/FieldAssignS 共用):rec_ptr + rec_h + 字段名
// → place_ptr(字段地址)/place_ty(字段类型)。field_id 0 基
// (record_field_idx 口径)。非名义 record / 无此字段 = 响亮报错。
fun rec_field_place(lib: Lib, ctx: u64, builder: u64, cache: Map<str, u64>,
    a: TypeArena, s: SemaRes, rec_ptr: u64, rec_h: u32,
    field: str, nid: i64): Throw<void, FfiError> {
    match record_name_of(a, rec_h) {
        null => throw FfiError(Other, "slice 2: field access on non-nominal record (node {nid})")
        rn => {
            val name = rn ?? ""
            val fid = Semares.record_field_idx(s, name, field)
            if fid < 0 {
                throw FfiError(Other, "slice 2: record '{name}' has no field '{field}' (node {nid})")
            }
            // 切片 6e:泛型实例字段类型 = 声明类型经 type_params → args
            // 代换(record_shape 对泛型 null;实参从接收者句柄取)。
            val rhr = Arena.resolve(a, rec_h)
            val gargs = Arena.adt_parts(a, rhr).b
            if gargs.len() > 0 {
                match Semares.get_type_def(s, name) {
                    null => {}
                    d0 => {
                        val d = d0 ?? Data.TDef("", Data.TAlias, [], [], null, null, [], [])
                        // 切片 6g:sanitize —— 声明位 List<Se> 可被存成
                        // TGeneric(Typeast 回落;canonical 解析在模块名==
                        // 类型名时拼错键),消费面统一 TAdt。
                        place_ty = sanitize_arg(a, s, subst_ty(a, d.type_params, gargs,
                            d.constructors[0].field_types[fid as usize]))
                    },
                }
            } else {
                place_ty = sanitize_arg(a, s, (Semares.record_shape(s, name) ?? [])[(fid as usize)])
            }
            val lt = record_layout_h(lib, ctx, cache, a, s, rec_h)?
            place_ptr = Llvm.build_struct_gep(lib, builder, lt, rec_ptr, fid as u32, tmp())?
            Ok(void)
        },
    }
}

// 写目标定位(赋值/复合赋值共用):target 表达式 → place_ptr(存储
// 地址)/place_ty(类型)。Ident → 栈槽;FieldAccessE → record 字段
// 地址(聚合字段 = 存 ptr 的槽位);IndexE → 数组元素地址(越界 trap)。
// 出参即读即用;嵌套赋值表达式会覆盖,调用方须先拷贝局部。
fun lower_place(lib: Lib, ctx: u64, builder: u64, fref: u64,
    a: TypeArena, s: SemaRes, mname: str, ast: AstArena,
    slots: Map<str, u64>, tyslots: Map<str, u32>, cache: Map<str, u64>,
    eid: i64): Throw<void, FfiError> {
    match ast.expr(eid).node {
        Ident(name) => {
            match slots.get(name) {
                null => {
                    // 切片 6g:模块级 var/val place(复合赋值/取址面)。
                    if find_gvar(mname, name) {
                        var gth3 = gvar_tys.get(gv_key)
                        if gth3 == null {
                            gth3 = if true { expr_ty(a, s, mname, eid)? } else { null }
                            gvar_tys.set(gv_key, gth3 ?? 0u32)
                        }
                        place_ptr = gv_ptr
                        place_ty = gth3 ?? 0u32
                        return Ok(void)
                    }
                    throw FfiError(Other, "slice 2: assignment to non-local '{name}' (expr {eid})")
                }
                slot => {
                    place_ptr = slot ?? 0
                    place_ty = tyslots.get(name) ?? (expr_ty(a, s, mname, eid)?)
                    Ok(void)
                },
            }
        },
        FieldAccessE(recv, field) => {
            val recv_h = expr_ty(a, s, mname, recv)?
            if agg_kind(a, s, recv_h) != 7 {
                throw FfiError(Other, "slice 2: field write on non-record (expr {eid})")
            }
            val rec_ptr = lower_expr(lib, ctx, builder, fref, a, s, mname, ast, slots, tyslots, cache, recv)?
            if flow_stopped {
                return Ok(void)
            }
            rec_field_place(lib, ctx, builder, cache, a, s, rec_ptr, recv_h, field, eid)?
            Ok(void)
        },
        IndexE(arr, idx) => {
            val arr_h = expr_ty(a, s, mname, arr)?
            if agg_kind(a, s, arr_h) != 6 {
                throw FfiError(Other, "slice 2: index write on non-array (expr {eid})")
            }
            val arr_ptr = lower_expr(lib, ctx, builder, fref, a, s, mname, ast, slots, tyslots, cache, arr)?
            if flow_stopped {
                return Ok(void)
            }
            val idx_h = expr_ty(a, s, mname, idx)?
            val idx_v = lower_expr(lib, ctx, builder, fref, a, s, mname, ast, slots, tyslots, cache, idx)?
            if flow_stopped {
                return Ok(void)
            }
            place_ptr = arr_elem_addr(lib, ctx, builder, cache, fref, a, s, arr_ptr, arr_h, idx_v, idx_h, eid)?
            place_ty = (Arena.array_parts(a, arr_h)).a
            Ok(void)
        },
        _ => throw FfiError(Other, "slice 2: invalid assignment target (expr {eid})"),
    }
}

// 复合赋值算术(镜像 lower_binary 的 COp 族;ty_raw 已 resolve)。
fun cop_apply(lib: Lib, ctx: u64, builder: u64, cache: Map<str, u64>, op: COp,
    old: u64, rv: u64, ty_raw: Ty, name: str): Throw<u64, FfiError> {
    val k = ty_kind(ty_raw)
    match op {
        AddA => {
            if k == 1 { Llvm.build_fadd(lib, builder, old, rv, name) }
            else { Llvm.build_add(lib, builder, old, rv, name) }
        },
        SubA => {
            if k == 1 { Llvm.build_fsub(lib, builder, old, rv, name) }
            else { Llvm.build_sub(lib, builder, old, rv, name) }
        },
        MulA => {
            if k == 1 { Llvm.build_fmul(lib, builder, old, rv, name) }
            else { Llvm.build_mul(lib, builder, old, rv, name) }
        },
        DivA => {
            if k == 1 { Llvm.build_fdiv(lib, builder, old, rv, name) }
            else if ty_signed(ty_raw) { Llvm.build_sdiv(lib, builder, old, rv, name) }
            else { Llvm.build_udiv(lib, builder, old, rv, name) }
        },
        ModA => {
            if k == 1 { Llvm.build_frem(lib, builder, old, rv, name) }
            else if ty_signed(ty_raw) { Llvm.build_srem(lib, builder, old, rv, name) }
            else { Llvm.build_urem(lib, builder, old, rv, name) }
        },
        BitAndA => Llvm.build_and(lib, builder, old, rv, name),
        BitOrA => Llvm.build_or(lib, builder, old, rv, name),
        BitXorA => Llvm.build_xor(lib, builder, old, rv, name),
        ShlA => Llvm.build_shl(lib, builder, old, rv, name),
        ShrA => {
            if ty_signed(ty_raw) { Llvm.build_ashr(lib, builder, old, rv, name) }
            else { Llvm.build_lshr(lib, builder, old, rv, name) }
        },
    }
}

// 复合赋值核心(语句/表达式位共用):place 定位 → load 旧值 → op →
// store;返回新值句柄。聚合 place = 响亮报错。
fun lower_comp_place(lib: Lib, ctx: u64, builder: u64, fref: u64,
    a: TypeArena, s: SemaRes, mname: str, ast: AstArena,
    slots: Map<str, u64>, tyslots: Map<str, u32>, cache: Map<str, u64>,
    nid: i64, op: COp, target: i64, value: i64): Throw<u64, FfiError> {
    lower_place(lib, ctx, builder, fref, a, s, mname, ast, slots, tyslots, cache, target)?
    if flow_stopped {
        return Ok(0u64)
    }
    val addr = place_ptr
    val ty_h = place_ty
    if is_agg_kind(agg_kind(a, s, ty_h)) {
        throw FfiError(Other, "slice 2: compound assignment on aggregate (node {nid})")
    }
    val old = load_at(lib, ctx, builder, cache, a, s, addr, ty_h)?
    val val_h = expr_ty(a, s, mname, value)?
    val v = lower_expr(lib, ctx, builder, fref, a, s, mname, ast, slots, tyslots, cache, value)?
    if flow_stopped {
        return Ok(0u64)
    }
    val rvc = conv_value(lib, ctx, builder, cache, a, s, v, val_h, ty_h, tmp())?
    val nv = cop_apply(lib, ctx, builder, cache, op, old, rvc,
        Arena.get(a, Arena.resolve(a, ty_h)), tmp())?
    Llvm.build_store(lib, builder, nv, addr)?
    Ok(nv)
}

// 数组字面量(含 fill):frond_alloc(16 + n*esz) → store len 头 →
// 逐元素 store(标量本体/聚合 ptr;fill = 展开拷贝)。fill count 编译期
// 取值(IntLit;非字面量响亮报错)。返回块地址(= 数组值)。
fun lower_array_lit(lib: Lib, ctx: u64, builder: u64, fref: u64,
    a: TypeArena, s: SemaRes, mname: str, ast: AstArena,
    slots: Map<str, u64>, tyslots: Map<str, u32>, cache: Map<str, u64>,
    eid: i64, my_h: u32, elements: i64[], fv: i64, fc: i64,
    has_fill: bool): Throw<u64, FfiError> {
    // 切片 6b:elem resolve 到底(泛型调用点的字面量型 elem 是 unify
    // 绑定的 var——裸取即炸);仍未解(inst 重放跳 unify 的悬空 var)
    // → 从首元素物化型派生。
    var elem_h = arr_elem_of(a, my_h)
    if has_open_elem(a, my_h) {
        if has_fill {
            match expr_ty(a, s, mname, fv) {
                Ok(fh0) => {
                    val fh = Arena.resolve(a, fh0)
                    if !has_open_elem(a, fh) {
                        if agg_kind(a, s, fh) == 6 {
                            elem_h = arr_elem_of(a, fh)
                        } else {
                            elem_h = fh
                        }
                    }
                },
                Error(_) => {}
            }
        } else {
            if elements.len() > 0 {
                match expr_ty(a, s, mname, elements[0]) {
                    Ok(eh0) => {
                        val eh = Arena.resolve(a, eh0)
                        if !has_open_elem(a, eh) {
                            elem_h = eh
                        }
                    },
                    Error(_) => {}
                }
            }
        }
    }
    val esz = agg_size(lib, ctx, cache, a, s, elem_h)?
    val i64ty = llty_for(lib, ctx, cache, TI64)?
    val i8ty = llty_for(lib, ctx, cache, TI8)?
    var n: u64 = 0u64
    var vals: u64[] = []
    if has_fill {
        match ast.expr(fc).node {
            IntLit(txt, _) => {
                n = parse_u64(int_digits(txt), int_radix(txt))
                val fv_h = expr_ty(a, s, mname, fv)?
                val v = lower_expr(lib, ctx, builder, fref, a, s, mname, ast, slots, tyslots, cache, fv)?
                if flow_stopped {
                    return Ok(0u64)
                }
                vals = vals ++ [conv_value(lib, ctx, builder, cache, a, s, v, fv_h, elem_h, tmp())?]
            },
            _ => {
                // 切片 6e:动态 fill 计数(List 增长路径 [buf[0],
                // ..buf.len() * 2])——count 运行期求值,frond_alloc_dyn
                // 分配,循环逐槽填(值型 = elem 代换型)。
                val fc_h = expr_ty(a, s, mname, fc)?
                val fc_v = lower_expr(lib, ctx, builder, fref, a, s, mname, ast, slots, tyslots, cache, fc)?
                if flow_stopped {
                    return Ok(0u64)
                }
                val i64_h2 = Arena.from_scalar_name(a, "i64")
                val cnt = conv_value(lib, ctx, builder, cache, a, s, fc_v, fc_h, i64_h2, tmp())?
                val fv_h2 = expr_ty(a, s, mname, fv)?
                val v2 = lower_expr(lib, ctx, builder, fref, a, s, mname, ast, slots, tyslots, cache, fv)?
                if flow_stopped {
                    return Ok(0u64)
                }
                val fill_v = conv_value(lib, ctx, builder, cache, a, s, v2, fv_h2, elem_h, tmp())?
                val esz_c = Llvm.const_int(lib, i64ty, esz, false)?
                val c16d = Llvm.const_int(lib, i64ty, 16u64, false)?
                val bytes = Llvm.build_mul(lib, builder, cnt, esz_c, "fb")?
                val sz = Llvm.build_add(lib, builder, c16d, bytes, "fsz")?
                val pd = call_alloc_dyn(lib, builder, cache, sz)?
                Llvm.build_store(lib, builder, cnt, pd)?
                val jslot = Llvm.build_alloca(lib, builder, i64ty, "fj")?
                Llvm.build_store(lib, builder, Llvm.const_int(lib, i64ty, 0u64, false)?, jslot)?
                val fl_blk = Llvm.append_block(lib, ctx, fref, "fill.loop")?
                val fb_blk = Llvm.append_block(lib, ctx, fref, "fill.body")?
                val fe_blk = Llvm.append_block(lib, ctx, fref, "fill.end")?
                Llvm.build_br(lib, builder, fl_blk)?
                Llvm.position_builder_at_end(lib, builder, fl_blk)?
                val jv = Llvm.build_load(lib, builder, i64ty, jslot, "fjv")?
                val jmore = Llvm.build_icmp(lib, builder, jv, cnt, 36u32, "fmore")?
                Llvm.build_cond_br(lib, builder, jmore, fb_blk, fe_blk)?
                Llvm.position_builder_at_end(lib, builder, fb_blk)?
                val joff = Llvm.build_add(lib, builder, c16d,
                    Llvm.build_mul(lib, builder, jv, esz_c, "fjx")?, "fjo")?
                val jaddr = Llvm.build_inbounds_gep2(lib, builder, i8ty, pd, [joff], tmp())?
                Llvm.build_store(lib, builder, fill_v, jaddr)?
                val jn = Llvm.build_add(lib, builder, jv, Llvm.const_int(lib, i64ty, 1u64, false)?, "fjn")?
                Llvm.build_store(lib, builder, jn, jslot)?
                Llvm.build_br(lib, builder, fl_blk)?
                Llvm.position_builder_at_end(lib, builder, fe_blk)?
                return Ok(pd)
            },
        }
    } else {
        n = elements.len() as u64
        var i: usize = 0
        while i < elements.len() {
            val eh = expr_ty(a, s, mname, elements[i])?
            val v = lower_expr(lib, ctx, builder, fref, a, s, mname, ast, slots, tyslots, cache, elements[i])?
            if flow_stopped {
                return Ok(0u64)
            }
            vals = vals ++ [conv_value(lib, ctx, builder, cache, a, s, v, eh, elem_h, tmp())?]
            i = i + 1
        }
    }
    val p = call_alloc(lib, ctx, cache, builder, 16u64 + n * esz)?
    Llvm.build_store(lib, builder, Llvm.const_int(lib, i64ty, n, false)?, p)?
    var j: u64 = 0u64
    while j < n {
        // i8 基型仅容单索引:头 16 + j*esz 编译期加总成单常量偏移。
        val eaddr = Llvm.build_inbounds_gep2(lib, builder, i8ty, p,
            [Llvm.const_int(lib, i64ty, 16u64 + j * esz, false)?], tmp())?
        Llvm.build_store(lib, builder, vals[if has_fill { 0u64 } else { j } as usize], eaddr)?
        j = j + 1u64
    }
    Ok(p)
}

// ── 切片 1 状态(模块 var 通道;gvar 探针实证 List/Map 初始化安全)──
// flow_stopped 已提前至切片 2 通道区声明(var 顺序敏感)。
var cur_ret_h: u32 = 0
var cur_is_main: bool = false

// 循环上下文:break/continue 目标块(句柄走 List 通道,handleprobe 实证)。
var loop_breaks: List<u64> = List.empty<u64>()
var loop_conts: List<u64> = List.empty<u64>()

// 切片 5:defer 链(函数级,直线形态)——DeferS 注册,出口统一发射
// (LIFO,镜像引擎语义);每函数入口清空。块级作用域/循环体内 defer
// 为近似(函数出口统一触发),自举面 frondc 两处均为函数级清理。
var defer_bodies: List<i64> = List.empty<i64>()

// 出口发射:后注册先跑(LIFO);在 return/throw/函数尾统一调用。
// DeferS 载荷 = 表达式(Parse 侧实证:DeferS(expr)/DeferS(assign_expr))。
fun emit_pending_defers(lib: Lib, ctx: u64, builder: u64, fref: u64,
    a: TypeArena, s: SemaRes, mname: str, ast: AstArena,
    slots: Map<str, u64>, tyslots: Map<str, u32>, cache: Map<str, u64>): Throw<void, FfiError> {
    var k: usize = defer_bodies.len()
    while k > 0 {
        k = k - 1
        val e0 = defer_bodies.get(k) ?? 0
        val _ = lower_expr(lib, ctx, builder, fref, a, s, mname, ast, slots, tyslots, cache, e0)?
    }
    Ok(void)
}

// 函数表(切片 1:入口模块非泛型 sync 非抛 fun + main)。
var fn_names: List<str> = List.empty<str>()
var fn_llvm: List<u64> = List.empty<u64>()
var fn_lty: List<u64> = List.empty<u64>()
var fn_params: List<u32[]> = List.empty<u32[]>()
var fn_rets: List<u32> = List.empty<u32>()
var fn_ast_params: List<Prm[]> = List.empty<Prm[]>()
var fn_bodies: List<i64> = List.empty<i64>()
// 切片 6a:函数的模块列(键 = ModuleAst.name 文件路径,与 sema 的
// expr_types/module_envs 键同源)+ 每函数所属模块 AST(体用己 arena)。
var fn_mods: List<str> = List.empty<str>()
var fn_asts: List<ModuleAst> = List.empty<ModuleAst>()
// register_fn 当前模块(fn_index 键隔离用;注册循环逐函数置位)。
var cur_fn_mod: str = ""
// main 入口序:按收集序求值各 init 并 store(模块切换上下文 ——
// init 里的裸名/实例调用按声明模块解析)。
fun emit_gvar_inits(lib: Lib, ctx: u64, builder: u64, fref: u64, a: TypeArena, s: SemaRes,
    cache: Map<str, u64>, mods: List<ModuleAst>): Throw<void, FfiError> {
    var mi: usize = 0
    while mi < mods.len() {
        val m = mods.get(mi) ?? (mods.get(0) ?? ModuleAst("", null,
            AstArena(List.empty<Se>(), List.empty<Ss>(), List.empty<St>(), List.empty<Spn>()), []))
        var di: usize = 0
        while di < m.decls.len() {
            match m.decls[di].decl {
                ExprDeclD(_, stmt0) => {
                    match stmt0 {
                        null => {}
                        st0 => {
                            match m.arena.stmt(st0 ?? 0).node {
                                VarDeclS(name, _, init, _) | ValDeclS(name, _, init, _) => {
                                    emit_one_gvar_init(lib, ctx, builder, fref, a, s, cache, m, name, init)?
                                },
                                _ => {},
                            }
                        },
                    }
                },
                _ => {},
            }
            di = di + 1
        }
        mi = mi + 1
    }
    Ok(void)
}

fun emit_one_gvar_init(lib: Lib, ctx: u64, builder: u64, fref: u64, a: TypeArena, s: SemaRes,
    cache: Map<str, u64>, m: ModuleAst, name: str, init: i64): Throw<void, FfiError> {
    val key = "{m.name}\u{0}{name}"
    match gvar_slots.get(key) {
        null => {}
        g0 => {
            val saved_mod = s.current_module_name
            s.current_module_name = m.name
            val saved_fnmod = cur_fn_mod
            cur_fn_mod = m.name
            val saved_body = cur_body_eid
            val saved_farena = cur_farena
            cur_body_eid = init
            cur_farena = if true { m.arena } else { null }
            val slots = Map.empty<str, u64>()
            val tyslots = Map.empty<str, u32>()
            val iv = lower_expr(lib, ctx, builder, fref, a, s, m.name, m.arena,
                slots, tyslots, cache, init)?
            val ih = expr_ty(a, s, m.name, init)?
            if gvar_tys.get(key) == null {
                gvar_tys.set(key, ih)
                gvar_tys.set(name, ih)
            }
            val th2 = gvar_tys.get(key) ?? ih
            val vc = conv_value(lib, ctx, builder, cache, a, s, iv, ih, th2, tmp())?
            Llvm.build_store(lib, builder, vc, g0 ?? 0)?
            s.current_module_name = saved_mod
            cur_fn_mod = saved_fnmod
            cur_body_eid = saved_body
            cur_farena = saved_farena
        },
    }
    Ok(void)
}


// 切片 6b:泛型实例行(instance_id → fn 行号)+ 行级"lower 前重放"
// 标记(多实例共享体 expr 键,按序重放→立即 lower)。
var inst_rows: Map<str, i64> = Map.empty<str, i64>()
// 切片 6e:泛型类型方法实例——行号表(键 = canonical\0method\0ty_key
// (接收者))+ 行键回收表(行号字符串 → canonical\0method;发射期重放
// 取 Md/实参用)+ 类型方法归属表(canonical\0method → 声明模块名)+
// 全模块表(名字 → ModuleAst;TypeDeclD/Md 检索面)。
var meth_inst_rows: Map<str, i64> = Map.empty<str, i64>()
var meth_row_keys: Map<str, str> = Map.empty<str, str>()
var gen_method_mods: Map<str, str> = Map.empty<str, str>()
var all_mods: List<ModuleAst> = List.empty<ModuleAst>()
var meth_seq: i64 = 0

var fn_replays: List<bool> = List.empty<bool>()
// 行 → 实例 id(非实例 = -1;发射期重放定位)。
var fn_inst_ids: List<i64> = List.empty<i64>()
// 切片 6c:行 → this 型(非方法 = 0;方法体发射期置 cur_this_*,
// Ident 裸字段/裸方法调用回落消费)。
var fn_this: List<u32> = List.empty<u32>()
var fn_index: Map<str, i64> = Map.empty<str, i64>()

// 块作用域:副本式——块内定义只进副本,退出即弃,外层天然"恢复"。
fun copy_slots(m: Map<str, u64>): Map<str, u64> {
    val out = Map.empty<str, u64>()
    val ks = m.keys()
    var i: usize = 0
    while i < ks.len() {
        out.set(ks[i], m.get(ks[i]) ?? 0)
        i = i + 1
    }
    out
}

fun copy_tys(m: Map<str, u32>): Map<str, u32> {
    val out = Map.empty<str, u32>()
    val ks = m.keys()
    var i: usize = 0
    while i < ks.len() {
        out.set(ks[i], m.get(ks[i]) ?? 0)
        i = i + 1
    }
    out
}

fun clear_u64_list(lst: List<u64>): void {
    while lst.len() > 0 {
        lst.pop()
    }
}

// 返回值 = LLVM 值句柄;类型 = 该表达式的 sema 类型。slots(name→栈槽
// 句柄)/tyslots(name→类型句柄)/cache(LLVM 类型缓存)均为句柄安全通道。
pub fun lower_expr(lib: Lib, ctx: u64, builder: u64, fref: u64,
    a: TypeArena, s: SemaRes, mname: str, ast: AstArena,
    slots: Map<str, u64>, tyslots: Map<str, u32>, cache: Map<str, u64>,
    eid: i64): Throw<u64, FfiError> {
    val node = ast.expr(eid).node
    val my_ty = expr_ty(a, s, mname, eid)?
    match node {
        IntLit(text, _) => {
            val lt = llty_for(lib, ctx, cache, Arena.get(a, my_ty))?
            Llvm.const_int_str(lib, lt, int_digits(text), int_radix(text))
        },
        FloatLit(text, _) => {
            val lt = llty_for(lib, ctx, cache, Arena.get(a, my_ty))?
            Llvm.const_real_str(lib, lt, text)
        },
        BoolLit(bv) => {
            val lt = llty_for(lib, ctx, cache, TBool)?
            val bits = if bv { 1u64 } else { 0u64 }
            Llvm.const_int(lib, lt, bits, false)
        },
        CharLit(cp) => {
            val lt = llty_for(lib, ctx, cache, TChar)?
            Llvm.const_int(lib, lt, cp as u64, false)
        },
        VoidLit => { Ok(0u64) },
        StrLit(text) => {
            // 切片 2:str 字面量 = 私有全局常量块地址(值 = ptr)。
            str_lit_global(lib, ctx, cache, text)
        },
        StrInterp(parts) => {
            // 切片 6e:字符串插值 "{k}"(Hash.key 打印形路径)——逐段
            // repr 后 concat。本片段面:str(恒等)/整型族(itoa)/bool
            // (true/false);其余复合 repr = repr 扩面(质量项)。
            var acc: u64 = 0
            var lit = ""
            var pi: usize = 0
            while pi < parts.len() {
                match parts[pi] {
                    IpLit(txt) => {
                        lit = lit + txt
                    },
                    IpExpr(pe) => {
                        // 累积字面量先落段。
                        if lit.len() > 0 {
                            val lp = str_lit_global(lib, ctx, cache, lit)?
                            acc = if acc == 0 { lp } else { str_concat(lib, ctx, builder, cache, fref, acc, lp)? }
                            lit = ""
                        }
                        val pe_h = expr_ty(a, s, mname, pe)?
                        val pe_k = agg_kind(a, s, pe_h)
                        val pv = lower_expr(lib, ctx, builder, fref, a, s, mname, ast, slots, tyslots, cache, pe)?
                        if flow_stopped {
                            return Ok(0u64)
                        }
                        // 切片 6g:全 repr 面(record/ADT/数组/nullable/
                        // Throw/bool/void 经 repr_value_ir;str/整型快路)。
                        val seg = if pe_k == 5 {
                            pv
                        } else if pe_k == 0 || pe_k == 3 {
                            val i64ty2 = llty_for(lib, ctx, cache, TI64)?
                            val i64_h2 = Arena.from_scalar_name(a, "i64")
                            val v64 = conv_value(lib, ctx, builder, cache, a, s, pv, pe_h, i64_h2, tmp())?
                            emit_itoa_once(lib, ctx, cur_module, cache)?
                            val ift2 = Llvm.function_type(lib, Llvm.ptr_type(lib, ctx)?, [i64ty2], false)?
                            Llvm.build_call2(lib, builder, ift2, itoa_fn, [v64], tmp())?
                        } else {
                            repr_value_ir(lib, ctx, builder, fref, cache, a, s, pv, pe_h, 0i64)?
                        }
                        acc = if acc == 0 { seg } else { str_concat(lib, ctx, builder, cache, fref, acc, seg)? }
                    },
                }
                pi = pi + 1
            }
            if lit.len() > 0 {
                val lp2 = str_lit_global(lib, ctx, cache, lit)?
                acc = if acc == 0 { lp2 } else { str_concat(lib, ctx, builder, cache, fref, acc, lp2)? }
            }
            if acc == 0 {
                str_lit_global(lib, ctx, cache, "")
            } else {
                Ok(acc)
            }
        },
        NullLit => {
            // 切片 3:裸 null = 规范全局常量块地址({i64,i64} zeroinit,
            // tag@0=0;判空短路保证 payload 永不读,哑型差异不可观察)。
            null_global_canon(lib, ctx, cache)
        },
        Ident(name) => {
            match slots.get(name) {
                null => {
                    // 切片 6c:方法体内裸字段名(隐式 this.x;引擎同口径,
                    // sema 已按字段型记录)——ctor 判定之前。this 槽存
                    // 切片 6g:模块级 var/val(全局槽读取)。
                    if find_gvar(mname, name) {
                        val gth = gvar_tys.get(gv_key) ?? (expr_ty(a, s, mname, eid)?)
                        if gvar_tys.get(gv_key) == null {
                            gvar_tys.set(gv_key, gth)
                        }
                        val glt = llty_for_h(lib, ctx, cache, a, s, gth)?
                        return Llvm.build_load(lib, builder, glt, gv_ptr, "gv.{name}")
                    }
                    // 记录 ptr,先装载再定位字段。
                    if cur_this_h != 0 {
                        val fdecl_h = Arena.resolve(a, cur_this_h)
                        if agg_kind(a, s, fdecl_h) == 7 {
                            val frn = record_name_of(a, fdecl_h) ?? "?"
                            val ffid = Semares.record_field_idx(s, frn, name)
                            if ffid >= 0 {
                                val pt0 = llty_for_h(lib, ctx, cache, a, s, fdecl_h)?
                                val thisv = Llvm.build_load(lib, builder, pt0, cur_this_slot, "tfv")?
                                rec_field_place(lib, ctx, builder, cache, a, s,
                                    thisv, fdecl_h, name, eid)?
                                return load_at(lib, ctx, builder, cache, a, s, place_ptr, place_ty)
                            }
                        }
                    }
                    // 切片 3:零参 ADT 构造器(parser 裸名形态,如 Nil/Red;
                    // 局部绑定优先,ctor 次之——同名遮蔽由 sema 保证)。
                    match Semares.get_ctor_def(s, name) {
                        null => throw FfiError(Other, "slice 0: identifier '{name}' is not a local (params/globals arrive in later slices)")
                        cd => {
                            val tn = (cd ?? Ctor("", "", [], [], [], false, null, null, [], Span(0, 0), "")).type_name
                            if !Semares.type_def_is_multi_ctor_adt(s, tn) {
                                throw FfiError(Other, "slice 0: identifier '{name}' is not a local (params/globals arrive in later slices)")
                            }
                            val cidx = Semares.adt_ctor_index(s, tn, name)
                            if cidx < 0 {
                                throw FfiError(Other, "slice 3: ctor '{name}' not found on '{tn}' (expr {eid})")
                            }
                            val fts = Semares.adt_ctor_fields(s, tn, cidx) ?? []
                            if fts.len() != 0 {
                                throw FfiError(Other, "slice 3: ctor '{name}' takes {fts.len()} args — use '{name}(...)' (expr {eid})")
                            }
                            adt_ctor_build(lib, ctx, builder, cache, a, s, tn, cidx, [])
                        },
                    }
                },
                slot => {
                    // 切片 3:流窄化读取——声明槽 T? 而使用点 T(sema 经
                    // != null / match null-arm 窄化):槽装 nullable ptr,
                    // load ptr → unbox(inner)。其余按使用类型装载(聚合
                    // 变量槽存 ptr,llty_for_h 统一二形)。
                    val decl_h = tyslots.get(name) ?? my_ty
                    val dk = agg_kind(a, s, decl_h)
                    if dk == 9 && agg_kind(a, s, my_ty) != 9 {
                        val inner = Arena.nullable_inner(a, Arena.resolve(a, decl_h))
                        if ty_same(a, s, inner, my_ty) {
                            val pt = llty_for_h(lib, ctx, cache, a, s, decl_h)?
                            val p = Llvm.build_load(lib, builder, pt, slot ?? 0, name)?
                            return nullable_unbox_val(lib, ctx, builder, cache, a, s, p, inner)
                        }
                    }
                    val lt = llty_for_h(lib, ctx, cache, a, s, my_ty)?
                    Llvm.build_load(lib, builder, lt, slot ?? 0, name)
                },
            }
        },
        UnaryE(op, sub) => {
            val v = lower_expr(lib, ctx, builder, fref, a, s, mname, ast, slots, tyslots, cache, sub)?
            if flow_stopped {
                return Ok(0u64)
            }
            match op {
                Neg => {
                    val k1 = ty_kind(Arena.get(a, my_ty))
                    if k1 == 1 {
                        Llvm.build_fneg(lib, builder, v, tmp())
                    } else if k1 == 0 || k1 == 3 {
                        val lt = llty_for(lib, ctx, cache, Arena.get(a, my_ty))?
                        val zero = Llvm.const_int_str(lib, lt, "0", 10u8)?
                        Llvm.build_sub(lib, builder, zero, v, tmp())
                    } else {
                        throw FfiError(Other, "slice 0: neg on non-numeric (expr {eid})")
                    }
                },
                Not => {
                    val k2 = ty_kind(Arena.get(a, my_ty))
                    if k2 == 2 {
                        val lt = llty_for(lib, ctx, cache, TBool)?
                        val one = Llvm.const_int(lib, lt, 1u64, false)?
                        Llvm.build_xor(lib, builder, v, one, tmp())
                    } else {
                        throw FfiError(Other, "slice 0: logical not on non-bool (expr {eid})")
                    }
                },
                BitNot => {
                    val k3 = ty_kind(Arena.get(a, my_ty))
                    if k3 == 0 || k3 == 3 {
                        val lt = llty_for(lib, ctx, cache, Arena.get(a, my_ty))?
                        val ones = Llvm.const_int_str(lib, lt, "-1", 10u8)?
                        Llvm.build_xor(lib, builder, v, ones, tmp())
                    } else {
                        throw FfiError(Other, "slice 0: bit-not on non-int (expr {eid})")
                    }
                },
            }
        },
        BinaryE(op, lhs, rhs) => {
            lower_binary(lib, ctx, builder, fref, a, s, mname, ast, slots, tyslots, cache, eid, op, lhs, rhs)
        },
        AsCast(sub, _) => {
            // 目标类型 = 本表达式 sema 类型;操作数按自身类型 lower 后转型。
            val v = lower_expr(lib, ctx, builder, fref, a, s, mname, ast, slots, tyslots, cache, sub)?
            if flow_stopped {
                return Ok(0u64)
            }
            val from_h = expr_ty(a, s, mname, sub)?
            conv_value(lib, ctx, builder, cache, a, s,v, from_h, my_ty, tmp())
        },
        IfE(cond, then_e, else_e) => {
            lower_if(lib, ctx, builder, fref, a, s, mname, ast, slots, tyslots, cache, eid, cond, then_e, else_e)
        },
        MatchE(scrut, arms) => {
            // 切片 3:match 值表达式(全模式族 + guard)。
            lower_match(lib, ctx, builder, fref, a, s, mname, ast, slots, tyslots, cache, eid, scrut, arms)
        },
        BlockE(stmts, tail) => {
            lower_block(lib, ctx, builder, fref, a, s, mname, ast, slots, tyslots, cache, stmts, tail)
        },
        CallE(callee, args, _) => {
            lower_call(lib, ctx, builder, fref, a, s, mname, ast, slots, tyslots, cache, eid, callee, args)
        },
        MethodCallE(recv, method, args, _) => {
            // 切片 4:async 直通降级:.await(e) = e 恒等(async fun 已
            // lower 为返内型的普通函数,调用产物即 payload 原值)。
            if method == "await" && args.len() == 0 {
                lower_expr(lib, ctx, builder, fref, a, s, mname, ast, slots, tyslots, cache, recv)
            } else {
            // 切片 6e:命名空间接收者(List.empty() / Hash.key(k) 形)——
            // sema 已标 module_func_recv_exprs;泛型实例经
            // call_instantiations 分派(sema 实例化在先;std 命名规则 =
            // 模块名承载工厂),非泛型经 ftab 路径后缀定归属。接收者
            // 不进实参(与镜像 process_method_call 命名空间口径一致)。
            if s.module_func_recv_exprs.has(Semares.module_expr_key(mname, recv)) {
                match s.call_instantiations.get(Semares.module_expr_key(mname, eid)) {
                    null => {}
                    inst_id0 => {
                        match inst_rows.get("{inst_id0 ?? 0}") {
                            null => {}
                            rowi => {
                                return lower_call_row(lib, ctx, builder, fref, a, s, mname, ast,
                                    slots, tyslots, cache, eid, (rowi ?? 0) as usize, method, args)
                            },
                        }
                    },
                }
                match recv_segs(ast, recv) {
                    null => {}
                    segs => {
                        match cur_ftab {
                            null => {}
                            ft0 => {
                                match Mono.ftabs_module_by_path(ft0 ?? Mono.ftabs_new(), segs) {
                                    null => {}
                                    owner0 => {
                                        val okey = fn_key(owner0 ?? "", method)
                                        match fn_index.get(okey) {
                                            null => {}
                                            row2 => {
                                                return lower_call_row(lib, ctx, builder, fref, a, s, mname, ast,
                                                    slots, tyslots, cache, eid, (row2 ?? 0) as usize, method, args)
                                            },
                                        }
                                    },
                                }
                            },
                        }
                    },
                }
                // 切片 6f:实例行缺失且非泛型归属 miss —— 幽灵实例派生
                //(零参工厂的 check 期实例,实参按当前行绑定上下文代换)。
match s.call_instantiations.get(Semares.module_expr_key(mname, eid)) {
                    null => {}
                    gid0 => {
                        match cur_ftab {
                            null => {}
                            ftb => {
                                match derive_ghost_instance(lib, ctx, cur_module, a, s, cache,
                                    ftb ?? Mono.ftabs_new(), gid0 ?? 0, mname, eid) {
                                    null => {}
                                    vid0 => {
                                        match inst_rows.get("{vid0 ?? 0}") {
                                            null => {}
                                            vrow => {
                                                return lower_call_row(lib, ctx, builder, fref, a, s, mname, ast,
                                                    slots, tyslots, cache, eid, (vrow ?? 0) as usize, method, args)
                                            },
                                        }
                                    },
                                }
                            },
                        }
                    },
                }
                throw FfiError(Other, "slice 6e: namespace call '{method}' not collected (expr {eid} in '{mname}')")
            }
            var recv_h = expr_ty(a, s, mname, recv)?
            // 切片 6e:毒型回落 —— 方法糖调用的共享刚性槽毒(见
            // ty_generic_poisoned),接收者 Ident 有绑定槽型(经 overlay
            // = 实例返回,干净)即取槽型(泛型容器无流窄化,安全)。
            if ty_generic_poisoned(a, s, recv_h) {
                match ast.expr(recv).node {
                    Ident(iname) => {
                        match tyslots.get(iname) {
                            null => {}
                            st => { recv_h = st ?? recv_h }
                        }
                    },
                    _ => {},
                }
            }
            val rk = agg_kind(a, s, recv_h)
            // 切片 6d:repr() 反射 intrinsic(str 恒等;整型 itoa =
            // frond_rt_itoa)。名字即分派(镜像 reflect 同口径)。
            if method == "repr" && args.len() == 0 {
                val rv = lower_expr(lib, ctx, builder, fref, a, s, mname, ast, slots, tyslots, cache, recv)?
                if flow_stopped {
                    return Ok(0u64)
                }
                if rk == 5 {
                    return Ok(rv)
                }
                if rk == 0 || rk == 3 {
                    val i64ty = llty_for(lib, ctx, cache, TI64)?
                    val i64_h = Arena.from_scalar_name(a, "i64")
                    val v64 = conv_value(lib, ctx, builder, cache, a, s, rv, recv_h, i64_h, tmp())?
                    emit_itoa_once(lib, ctx, cur_module, cache)?
                    val ift = Llvm.function_type(lib, Llvm.ptr_type(lib, ctx)?, [i64ty], false)?
                    return Llvm.build_call2(lib, builder, ift, itoa_fn, [v64], tmp())
                }
                // 切片 6g:复合面经 repr_value_ir(record/ADT/数组/
                // nullable/Throw/bool/void)。
                return repr_value_ir(lib, ctx, builder, fref, cache, a, s, rv, recv_h, 0i64)
            }
            // 切片 6e:s.bytes() intrinsic —— str 块 {len@0, data@8} →
            // u8[] 块 {len@0, cap@8, data@16}(Hash 非快路死分支需要可
            // lower;逐字节拷,O2 向量化)。
            if method == "bytes" && args.len() == 0 && rk == 5 {
                val sp = lower_expr(lib, ctx, builder, fref, a, s, mname, ast, slots, tyslots, cache, recv)?
                if flow_stopped {
                    return Ok(0u64)
                }
                val i64ty3 = llty_for(lib, ctx, cache, TI64)?
                val i8ty3 = llty_for(lib, ctx, cache, TI8)?
                val slen = Llvm.build_load(lib, builder, i64ty3, sp, "bl")?
                val one3 = Llvm.const_int(lib, i64ty3, 1u64, false)?
                val c163 = Llvm.const_int(lib, i64ty3, 16u64, false)?
                val c83 = Llvm.const_int(lib, i64ty3, 8u64, false)?
                val szb = Llvm.build_add(lib, builder, c163, slen, "bsz")?
                val bp = call_alloc_dyn(lib, builder, cache, szb)?
                Llvm.build_store(lib, builder, slen, bp)?
                Llvm.build_store(lib, builder, slen, Llvm.build_inbounds_gep2(lib, builder, i8ty3, bp, [c83], "bcap")?)?
                val js = Llvm.build_alloca(lib, builder, i64ty3, "bj")?
                Llvm.build_store(lib, builder, Llvm.const_int(lib, i64ty3, 0u64, false)?, js)?
                val bl_blk = Llvm.append_block(lib, ctx, fref, "bloop")?
                val bb_blk = Llvm.append_block(lib, ctx, fref, "bbody")?
                val be_blk = Llvm.append_block(lib, ctx, fref, "bend")?
                Llvm.build_br(lib, builder, bl_blk)?
                Llvm.position_builder_at_end(lib, builder, bl_blk)?
                val jv3 = Llvm.build_load(lib, builder, i64ty3, js, "bjv")?
                val jmore3 = Llvm.build_icmp(lib, builder, jv3, slen, 36u32, "bmore")?
                Llvm.build_cond_br(lib, builder, jmore3, bb_blk, be_blk)?
                Llvm.position_builder_at_end(lib, builder, bb_blk)?
                val saddr3 = Llvm.build_inbounds_gep2(lib, builder, i8ty3, sp, [Llvm.build_add(lib, builder, c83, jv3, "bsrc")?], tmp())?
                val bv3 = Llvm.build_load(lib, builder, i8ty3, saddr3, "bbyte")?
                val daddr3 = Llvm.build_inbounds_gep2(lib, builder, i8ty3, bp, [Llvm.build_add(lib, builder, c163, jv3, "bdst")?], tmp())?
                Llvm.build_store(lib, builder, bv3, daddr3)?
                Llvm.build_store(lib, builder, Llvm.build_add(lib, builder, jv3, one3, "bjn")?, js)?
                Llvm.build_br(lib, builder, bl_blk)?
                Llvm.position_builder_at_end(lib, builder, be_blk)?
                Ok(bp)
            } else
            // 切片 6e:type_name() 反射 intrinsic——静态折叠为类型名
            // 字面量(display 口径 = 引擎 Reflect type_name 打印形;
            // 实例体内接收者型已由实例化重放代换,与标量族/str 的
            // 比较链 O2 常量折叠)。
            if method == "type_name" && args.len() == 0 {
                Ok(str_lit_global(lib, ctx, cache, Arena.display(a, Arena.resolve(a, recv_h)))?)
            } else
            // 切片 6c:静态方法分派——record/ADT 接收者按 canonical
            // 类型名查 method_rows(自有声明优先,trait 默认 _d 注册
            // 同键;调用 = [recv] + args)。
            // 切片 6e:泛型实例接收者(TAdt 带实参)→ 方法实例分派
            // (meth_inst_rows;miss 即注册——行动态增长,可达性由
            // 调用点标记;发射期 this 绑定重放体类型)。
            if rk == 7 || rk == 8 {
                val tn0 = record_name_of(a, recv_h) ?? "?"
                val tn1 = Semares.resolve_type_key(s, tn0)
                val gargs = Arena.adt_parts(a, Arena.resolve(a, recv_h)).b
                if gargs.len() > 0 {
                    val mkey = mkey_of(a, s, tn1 ?? tn0, method, recv_h)
                    match meth_inst_rows.get(mkey) {
                        null => {
                            match register_method_instance(lib, ctx, cur_module, a, s, cache, recv_h, method, eid) {
                                Ok(nrow) => {
                                    meth_inst_rows.set(mkey, nrow)
                                    lower_method_call(lib, ctx, builder, fref, a, s, mname, ast,
                                        slots, tyslots, cache, eid, nrow as usize, recv, recv_h, args)
                                },
                                Error(e) => throw e,
                            }
                        },
                        rowg => {
                            lower_method_call(lib, ctx, builder, fref, a, s, mname, ast,
                                slots, tyslots, cache, eid, (rowg ?? 0) as usize,
                                recv, recv_h, args)
                        },
                    }
                } else {
                val mrow = method_rows.get((tn1 ?? tn0) + "\u{0}" + method)
                match mrow {
                    null => {
                        throw FfiError(Other, "slice 6c: no method '{method}' on type '{tn0}' (expr {eid})")
                    },
                    row0 => {
                        lower_method_call(lib, ctx, builder, fref, a, s, mname, ast,
                            slots, tyslots, cache, eid, (row0 ?? 0) as usize,
                            recv, recv_h, args)
                    },
                }
                }
            } else if method == "len" && args.len() == 0 && (rk == 5 || rk == 6) {
                val sp = lower_expr(lib, ctx, builder, fref, a, s, mname, ast, slots, tyslots, cache, recv)?
                if flow_stopped {
                    return Ok(0u64)
                }
                if rk == 5 {
                    str_len_chars(lib, ctx, builder, cache, fref, sp)?
                } else {
                    val i64ty = llty_for(lib, ctx, cache, TI64)?
                    Llvm.build_load(lib, builder, i64ty, sp, tmp())
                }
            } else {
                throw FfiError(Other, "slice 2: unsupported method call '.{method}()' (expr {eid})")
            }
            }
        },
        FieldAccessE(recv, field) => {
            // 切片 2:record 字段读(标量 load 本体/聚合 load ptr)。
            var recv_h = expr_ty(a, s, mname, recv)?
            if ty_generic_poisoned(a, s, recv_h) {
                match ast.expr(recv).node {
                    Ident(iname2) => {
                        match tyslots.get(iname2) {
                            null => {}
                            st2 => { recv_h = st2 ?? recv_h }
                        }
                    },
                    _ => {},
                }
            }
            if agg_kind(a, s, recv_h) != 7 {
                throw FfiError(Other, "slice 2: field read on non-record (expr {eid})")
            }
            val rec_ptr = lower_expr(lib, ctx, builder, fref, a, s, mname, ast, slots, tyslots, cache, recv)?
            if flow_stopped {
                return Ok(0u64)
            }
            rec_field_place(lib, ctx, builder, cache, a, s, rec_ptr, recv_h, field, eid)?
            load_at(lib, ctx, builder, cache, a, s, place_ptr, place_ty)
        },
        IndexE(arr, idx) => {
            // 切片 2:数组元素读(越界 trap;标量/聚合按元素类型装载)。
            // 切片 5:str 码点索引(引擎语义;越界 trap)。
            val arr_h = expr_ty(a, s, mname, arr)?
            val ak = agg_kind(a, s, arr_h)
            if ak != 6 && ak != 5 {
                throw FfiError(Other, "slice 2: index read on non-array (expr {eid})")
            }
            val arr_ptr = lower_expr(lib, ctx, builder, fref, a, s, mname, ast, slots, tyslots, cache, arr)?
            if flow_stopped {
                return Ok(0u64)
            }
            val idx_h = expr_ty(a, s, mname, idx)?
            val idx_v = lower_expr(lib, ctx, builder, fref, a, s, mname, ast, slots, tyslots, cache, idx)?
            if flow_stopped {
                return Ok(0u64)
            }
            if ak == 5 {
                val i64_h = Arena.from_scalar_name(a, "i64")
                val idx64 = conv_value(lib, ctx, builder, cache, a, s, idx_v, idx_h, i64_h, tmp())?
                str_index_char(lib, ctx, builder, cache, fref, arr_ptr, idx64)
            } else {
                val eaddr = arr_elem_addr(lib, ctx, builder, cache, fref, a, s, arr_ptr, arr_h, idx_v, idx_h, eid)?
                val elem_h = arr_elem_of(a, arr_h)
                load_at(lib, ctx, builder, cache, a, s, eaddr, elem_h)
            }
        },
        SliceE(base, lo, hi, incl) => {
            // 切片 5:[a..b](incl = [a..=b] → hi+1)——str 按码点 /
            // 数组按元素;新块拷贝。
            val base_h = expr_ty(a, s, mname, base)?
            val bk = agg_kind(a, s, base_h)
            if bk != 6 && bk != 5 {
                throw FfiError(Other, "slice 5: slice on non-array/str (expr {eid})")
            }
            val base_ptr = lower_expr(lib, ctx, builder, fref, a, s, mname, ast, slots, tyslots, cache, base)?
            if flow_stopped {
                return Ok(0u64)
            }
            val i64_h = Arena.from_scalar_name(a, "i64")
            val lo_h = expr_ty(a, s, mname, lo)?
            val lo_v = lower_expr(lib, ctx, builder, fref, a, s, mname, ast, slots, tyslots, cache, lo)?
            if flow_stopped {
                return Ok(0u64)
            }
            val lo64 = conv_value(lib, ctx, builder, cache, a, s, lo_v, lo_h, i64_h, tmp())?
            val hi_h = expr_ty(a, s, mname, hi)?
            val hi_v = lower_expr(lib, ctx, builder, fref, a, s, mname, ast, slots, tyslots, cache, hi)?
            if flow_stopped {
                return Ok(0u64)
            }
            var hi64 = conv_value(lib, ctx, builder, cache, a, s, hi_v, hi_h, i64_h, tmp())?
            if incl {
                val i64ty = llty_for(lib, ctx, cache, TI64)?
                hi64 = Llvm.build_add(lib, builder, hi64, Llvm.const_int(lib, i64ty, 1u64, false)?, "hii")?
            }
            if bk == 5 {
                str_slice(lib, ctx, builder, cache, fref, base_ptr, lo64, hi64)
            } else {
                val elem_h = arr_elem_of(a, base_h)
                arr_slice(lib, ctx, builder, cache, fref, a, s, base_ptr, lo64, hi64, elem_h)
            }
        },
        ArrayLitE(elements, fv, fc, has_fill) => {
            lower_array_lit(lib, ctx, builder, fref, a, s, mname, ast, slots, tyslots, cache,
                eid, my_ty, elements, fv, fc, has_fill)
        },
        AssignE(target, value) => {
            // 表达式位赋值(免花括号循环体形态):store 后返回被存值。
            match ast.expr(target).node {
                Ident(tn) => {
                    match slots.get(tn) {
                        null => throw FfiError(Other, "slice 1: assignment to non-local '{tn}'")
                        slot => {
                            val val_h = expr_ty(a, s, mname, value)?
                            val v = lower_expr(lib, ctx, builder, fref, a, s, mname, ast, slots, tyslots, cache, value)?
                            if flow_stopped {
                                return Ok(0u64)
                            }
                            val slot_h = tyslots.get(tn) ?? val_h
                            val vc = conv_value(lib, ctx, builder, cache, a, s,v, val_h, slot_h, tmp())?
                            match Llvm.build_store(lib, builder, vc, slot ?? 0) {
                                Ok(_) => {}
                                Error(e) => throw e
                            }
                            Ok(vc)
                        },
                    }
                },
                _ => {
                    // 切片 2:place 赋值(IndexE/FieldAccessE 深链;其余
                    // lower_place 报错)。
                    lower_place(lib, ctx, builder, fref, a, s, mname, ast, slots, tyslots, cache, target)?
                    if flow_stopped {
                        return Ok(0u64)
                    }
                    val addr = place_ptr
                    val ty_h = place_ty
                    val val_h = expr_ty(a, s, mname, value)?
                    val v = lower_expr(lib, ctx, builder, fref, a, s, mname, ast, slots, tyslots, cache, value)?
                    if flow_stopped {
                        return Ok(0u64)
                    }
                    val vc = conv_value(lib, ctx, builder, cache, a, s, v, val_h, ty_h, tmp())?
                    Llvm.build_store(lib, builder, vc, addr)?
                    Ok(vc)
                },
            }
        },
        CompAssignE(op, target, value) => {
            // 切片 2:表达式位复合赋值(load-op-store;值 = 新值)。
            lower_comp_place(lib, ctx, builder, fref, a, s, mname, ast, slots, tyslots, cache,
                eid, op, target, value)
        },
        NonNullAssertE(sub) => {
            // 切片 3:e! —— 非 null 断言:tag==0 → llvm.trap;否则
            // unbox(inner = 表达式类型)。
            val sh = expr_ty(a, s, mname, sub)?
            if agg_kind(a, s, sh) != 9 {
                throw FfiError(Other, "slice 3: '!' assertion on non-nullable (expr {eid})")
            }
            val inner = Arena.nullable_inner(a, Arena.resolve(a, sh))
            val v = lower_expr(lib, ctx, builder, fref, a, s, mname, ast, slots, tyslots, cache, sub)?
            if flow_stopped {
                return Ok(0u64)
            }
            val i64ty = llty_for(lib, ctx, cache, TI64)?
            val t = nullable_tag(lib, ctx, builder, cache, v)?
            val z = Llvm.const_int(lib, i64ty, 0u64, false)?
            val b = Llvm.build_icmp(lib, builder, t, z, 32u32, "nna.n")?
            val ok_blk = Llvm.append_block(lib, ctx, fref, "nna.ok")?
            val trap_blk = Llvm.append_block(lib, ctx, fref, "nna.trap")?
            Llvm.build_cond_br(lib, builder, b, trap_blk, ok_blk)?
            Llvm.position_builder_at_end(lib, builder, trap_blk)?
            Llvm.build_call2_0(lib, builder, trap_ft, trap_fn, "")?
            Llvm.build_unreachable(lib, builder)?
            Llvm.position_builder_at_end(lib, builder, ok_blk)?
            nullable_unbox_val(lib, ctx, builder, cache, a, s, v, inner)
        },
        PropagateE(sub) => {
            // 切片 4:`?` 传播——sub 为 Throw 值:tag==0(Ok)→ unbox V
            // 续行;tag==1(Err)→ 当前函数早退回传 Throw 本值(调用方
            // 函数必须也是 Throw 返回)。零 setjmp、零运行时。
            val sh = expr_ty(a, s, mname, sub)?
            if agg_kind(a, s, sh) != 10 {
                throw FfiError(Other, "slice 4: '?' propagation on non-Throw (expr {eid})")
            }
            val cr = Arena.resolve(a, cur_ret_h)
            match Arena.get(a, cr) {
                TThrow(_) => {}
                _ => throw FfiError(Other, "slice 4: '?' outside a Throw-returning function (expr {eid})"),
            }
            val v = lower_expr(lib, ctx, builder, fref, a, s, mname, ast, slots, tyslots, cache, sub)?
            if flow_stopped {
                return Ok(0u64)
            }
            val i64ty = llty_for(lib, ctx, cache, TI64)?
            val t = nullable_tag(lib, ctx, builder, cache, v)?
            val one = Llvm.const_int(lib, i64ty, 1u64, false)?
            val iserr = Llvm.build_icmp(lib, builder, t, one, 32u32, "pr.e")?
            val err_blk = Llvm.append_block(lib, ctx, fref, "pr.err")?
            val ok_blk = Llvm.append_block(lib, ctx, fref, "pr.ok")?
            Llvm.build_cond_br(lib, builder, iserr, err_blk, ok_blk)?
            Llvm.position_builder_at_end(lib, builder, err_blk)?
            val rv = conv_value(lib, ctx, builder, cache, a, s, v, sh, cur_ret_h, tmp())?
            emit_pending_defers(lib, ctx, builder, fref, a, s, mname, ast, slots, tyslots, cache)?
            Llvm.build_ret(lib, builder, rv)?
            Llvm.position_builder_at_end(lib, builder, ok_blk)?
            val vp = Arena.thr_parts(a, Arena.resolve(a, sh)).a
            val vpr = Arena.get(a, Arena.resolve(a, vp))
            val vpopen = match vpr { TTypeVar(_) => true, TUnknown => true, _ => false }
            if ty_kind(vpr) == 4 || vpopen {
                Ok(0u64)
            } else {
                throw_unbox_val(lib, ctx, builder, cache, a, s, v, vp, false)
            }
        },
        _ => throw FfiError(Other, "slice 1: unsupported expression form (expr {eid} in module '{mname}')"),
    }
}

// ── 切片 1 表达式部件 ──────────────────────────────────────────────

// if 值表达式:结果槽(cond_br 两臂 store,merge load);void 形免槽;
// 无 else 且非 void = 报错(引擎同口径)。双臂终止 → merge 无前驱,
// 补 unreachable;stopped 传播 = then_stopped && else_stopped。
pub fun lower_if(lib: Lib, ctx: u64, builder: u64, fref: u64,
    a: TypeArena, s: SemaRes, mname: str, ast: AstArena,
    slots: Map<str, u64>, tyslots: Map<str, u32>, cache: Map<str, u64>,
    eid: i64, cond: i64, then_e: i64, else_e: i64?): Throw<u64, FfiError> {
    val cv = lower_expr(lib, ctx, builder, fref, a, s, mname, ast, slots, tyslots, cache, cond)?
    if flow_stopped {
        return Ok(0u64)
    }
    val cond_h = expr_ty(a, s, mname, cond)?
    val cvb = conv_to_bool(lib, ctx, builder, cache, a, cv, cond_h, tmp())?
    // 结果类型:缺表项或 TVoid → void。
    var is_void = true
    var my_h = cur_ret_h
    match Semares.get_expr(s, Semares.module_expr_key(mname, eid)) {
        null => {}
        h => {
            val rh = Arena.resolve(a, h ?? 0)
            if ty_kind(Arena.get(a, rh)) != 4 {
                is_void = false
                my_h = rh
            }
        },
    }
    if !is_void && else_e == null {
        throw FfiError(Other, "slice 1: if-expression without else in value position (expr {eid})")
    }
    var slot = 0u64
    if !is_void {
        val st = llty_for_h(lib, ctx, cache, a, s,my_h)?
        slot = Llvm.build_alloca(lib, builder, st, "if.res")?
    }
    // 块按形态创建:无 else 不建 else 块(then 臂终止时空块无终结
    // 指令 = Broken module,fib 早 return 形态踩中)。
    val then_blk = Llvm.append_block(lib, ctx, fref, "if.then")?
    val merge_blk = Llvm.append_block(lib, ctx, fref, "if.end")?
    var else_blk = 0u64
    match else_e {
        null => { Llvm.build_cond_br(lib, builder, cvb, then_blk, merge_blk)? }
        ee => {
            else_blk = Llvm.append_block(lib, ctx, fref, "if.else")?
            Llvm.build_cond_br(lib, builder, cvb, then_blk, else_blk)?
        },
    }
    Llvm.position_builder_at_end(lib, builder, then_blk)?
    flow_stopped = false
    val tv = lower_expr(lib, ctx, builder, fref, a, s, mname, ast, slots, tyslots, cache, then_e)?
    if !flow_stopped && !is_void {
        val th = expr_ty(a, s, mname, then_e)?
        val tvc = conv_value(lib, ctx, builder, cache, a, s, tv, th, my_h, tmp())?
        match Llvm.build_store(lib, builder, tvc, slot) {
            Ok(_) => {}
            Error(e) => throw e
        }
    }
    if !flow_stopped {
        Llvm.build_br(lib, builder, merge_blk)?
    }
    val then_stopped = flow_stopped
    var else_stopped = false
    match else_e {
        null => {}
        ee => {
            Llvm.position_builder_at_end(lib, builder, else_blk)?
            flow_stopped = false
            val ev = lower_expr(lib, ctx, builder, fref, a, s, mname, ast, slots, tyslots, cache, ee ?? 0)?
            if !flow_stopped && !is_void {
                val eh = expr_ty(a, s, mname, ee ?? 0)?
                val evc = conv_value(lib, ctx, builder, cache, a, s,ev, eh, my_h, tmp())?
                match Llvm.build_store(lib, builder, evc, slot) {
                    Ok(_) => {}
                    Error(e) => throw e
                }
            }
            if !flow_stopped {
                Llvm.build_br(lib, builder, merge_blk)?
            }
            else_stopped = flow_stopped
        },
    }
    Llvm.position_builder_at_end(lib, builder, merge_blk)?
    if then_stopped && else_stopped {
        // 双臂死路:merge 无前驱,仍需终结指令保 verifier。
        Llvm.build_unreachable(lib, builder)?
        flow_stopped = true
        return Ok(0u64)
    }
    flow_stopped = false
    if is_void {
        return Ok(0u64)
    }
    val lt = llty_for_h(lib, ctx, cache, a, s,my_h)?
    Llvm.build_load(lib, builder, lt, slot, tmp())
}

// ── 切片 3 match 编译(附九)───────────────────────────────────────
// 镜像引擎 ControlFlow::compile_match:scrutinee 一次求值 → arm 链
// (模式判别 + 可选 guard → body);非穷尽 = 引擎 panic → native
// unreachable(切片 3 面全穷尽,响亮注释)。模式测试用 CPS 双续体
// (成功 br ok_blk / 失败 br fail_blk,完成后 builder 位于 ok_blk):
// ctor 层短路(tag 确认后才 load 字段,防 per-ctor 布局越界读)。
// 绑定 = alloca 槽 + store(值形态同 ValDecl:标量本体/聚合 ptr);
// 槽类型 = 绑定位置原生形态,使用处 Ident 按 sema 类型 conv 窄化
// (nullable 槽 + inner 使用 = unbox,镜像 sema 的 nullable arm
// narrowing:null arm 后的绑定 arm 窄化到 inner)。

// 模式变量绑定:槽类型 = 绑定位置类型(scrut/ctor 字段/record 字段)。
fun pat_bind(lib: Lib, ctx: u64, builder: u64, cache: Map<str, u64>,
    a: TypeArena, s: SemaRes, name: str, v: u64, v_h: u32,
    aslots: Map<str, u64>, atys: Map<str, u32>): Throw<void, FfiError> {
    val st = llty_for_h(lib, ctx, cache, a, s, v_h)?
    val p = Llvm.build_alloca(lib, builder, st, "pb.{name}")?
    Llvm.build_store(lib, builder, v, p)?
    aslots.set(name, p)
    atys.set(name, v_h)
    Ok(void)
}

// ctor 字段链(ADT per-ctor 与单 ctor record 共用):逐字段 gep+load →
// 子模式递归;第 i 字段成功续体 = 第 i+1 字段测试起点块,末字段 = ok_blk。
// base_idx:ADT per-ctor 字段从 1(tag@0);record 从 0。零字段 = 恒真。
fun field_chain(lib: Lib, ctx: u64, builder: u64, fref: u64,
    a: TypeArena, s: SemaRes, mname: str, ast: AstArena,
    aslots: Map<str, u64>, atys: Map<str, u32>, cache: Map<str, u64>,
    subpats: i64[], fts: u32[], lt: u64, base_idx: u32, base: u64,
    ok_blk: u64, fail_blk: u64): Throw<void, FfiError> {
    if fts.len() == 0 {
        Llvm.build_br(lib, builder, ok_blk)?
        Llvm.position_builder_at_end(lib, builder, ok_blk)?
        return Ok(void)
    }
    var i: usize = 0
    while i < fts.len() {
        val oknext = if i + 1 < fts.len() {
            Llvm.append_block(lib, ctx, fref, "fc.n{i}")?
        } else {
            ok_blk
        }
        val addr = Llvm.build_struct_gep(lib, builder, lt, base, base_idx + (i as u32), tmp())?
        val fv = load_at(lib, ctx, builder, cache, a, s, addr, fts[i])?
        pat_test(lib, ctx, builder, fref, a, s, mname, ast, aslots, atys, cache,
            subpats[i], fv, fts[i], oknext, fail_blk)?
        i = i + 1
    }
    Ok(void)
}

// 构造器模式:scrut 三形态——k8 ADT(tag 判别 + per-ctor 字段链)、
// k9 nullable(tag==1 → unbox → inner k8/k7 递归)、k7 record(ctor 名
// = 类型名,无 tag 直链)。PVar 形态的零参 ctor 由 pat_test 转入。
fun ctor_test(lib: Lib, ctx: u64, builder: u64, fref: u64,
    a: TypeArena, s: SemaRes, mname: str, ast: AstArena,
    aslots: Map<str, u64>, atys: Map<str, u32>, cache: Map<str, u64>,
    cname: str, subpats: i64[], sv: u64, sh: u32,
    ok_blk: u64, fail_blk: u64): Throw<void, FfiError> {
    val k = agg_kind(a, s, sh)
    val i64ty = llty_for(lib, ctx, cache, TI64)?
    if k == 8 {
        val tn = record_name_of(a, sh) ?? "?"
        match Semares.get_ctor_def(s, cname) {
            null => throw FfiError(Other, "slice 3: unknown constructor '{cname}' in pattern (type '{tn}')")
            cd => {
                val ctn = (cd ?? Ctor("", "", [], [], [], false, null, null, [], Span(0, 0), "")).type_name
                if ctn != tn {
                    throw FfiError(Other, "slice 3: constructor '{cname}' belongs to '{ctn}', scrutinee is '{tn}'")
                }
            },
        }
        val cidx = Semares.adt_ctor_index(s, tn, cname)
        if cidx < 0 {
            throw FfiError(Other, "slice 3: constructor '{cname}' not found on '{tn}'")
        }
        val fts = Semares.adt_ctor_fields(s, tn, cidx) ?? []
        if fts.len() != subpats.len() {
            throw FfiError(Other, "slice 3: pattern '{cname}' expects {fts.len()} sub-patterns, got {subpats.len()}")
        }
        val t = nullable_tag(lib, ctx, builder, cache, sv)?
        val c = Llvm.const_int(lib, i64ty, cidx as u64, false)?
        val b = Llvm.build_icmp(lib, builder, t, c, 32u32, "ctag")?
        val tok = Llvm.append_block(lib, ctx, fref, "ct.ok")?
        Llvm.build_cond_br(lib, builder, b, tok, fail_blk)?
        Llvm.position_builder_at_end(lib, builder, tok)?
        val lt = adt_ctor_layout(lib, ctx, cache, a, s, tn, cidx)?
        field_chain(lib, ctx, builder, fref, a, s, mname, ast, aslots, atys, cache,
            subpats, fts, lt, 1u32, sv, ok_blk, fail_blk)
    } else if k == 9 {
        // nullable 上的 ctor 模式:tag==1 后解 inner 递归(sema 剥壳 unify 同口径)。
        val inner_h = Arena.nullable_inner(a, Arena.resolve(a, sh))
        val t = nullable_tag(lib, ctx, builder, cache, sv)?
        val one = Llvm.const_int(lib, i64ty, 1u64, false)?
        val b = Llvm.build_icmp(lib, builder, t, one, 32u32, "ntag")?
        val tok = Llvm.append_block(lib, ctx, fref, "nt.ok")?
        Llvm.build_cond_br(lib, builder, b, tok, fail_blk)?
        Llvm.position_builder_at_end(lib, builder, tok)?
        val pv = nullable_unbox_val(lib, ctx, builder, cache, a, s, sv, inner_h)?
        val ik = agg_kind(a, s, inner_h)
        if ik == 8 || ik == 7 {
            ctor_test(lib, ctx, builder, fref, a, s, mname, ast, aslots, atys, cache,
                cname, subpats, pv, inner_h, ok_blk, fail_blk)
        } else {
            throw FfiError(Other, "slice 3: constructor pattern on non-aggregate nullable inner ('{cname}')")
        }
    } else if k == 10 {
        // 切片 4:Throw 臂——Ok(tag 0)/Error|Err(tag 1);tag 检查后
        // payload unbox,单子模式按 payload 型递归(镜像 Infer 的
        // refine_constructor_pattern 同口径)。
        val tp = Arena.thr_parts(a, Arena.resolve(a, sh))
        val is_err_arm = cname == "Error" || cname == "Err"
        if !(cname == "Ok" || is_err_arm) {
            throw FfiError(Other, "slice 4: unknown Throw variant '{cname}' in pattern (expr scrutinee kind 10)")
        }
        if subpats.len() != 1 {
            throw FfiError(Other, "slice 4: Throw pattern '{cname}' expects 1 sub-pattern, got {subpats.len()}")
        }
        val t = nullable_tag(lib, ctx, builder, cache, sv)?
        val want = Llvm.const_int(lib, i64ty, if is_err_arm { 1u64 } else { 0u64 }, false)?
        val b = Llvm.build_icmp(lib, builder, t, want, 32u32, "thtag")?
        val tok = Llvm.append_block(lib, ctx, fref, "th.ok")?
        Llvm.build_cond_br(lib, builder, b, tok, fail_blk)?
        Llvm.position_builder_at_end(lib, builder, tok)?
        val payload_h = if is_err_arm { tp.b } else { tp.a }
        val pv = throw_unbox_val(lib, ctx, builder, cache, a, s, sv, payload_h, is_err_arm)?
        pat_test(lib, ctx, builder, fref, a, s, mname, ast, aslots, atys, cache,
            subpats[0], pv, payload_h, ok_blk, fail_blk)
    } else if k == 7 {
        // 单 ctor record:ctor 名即类型名,无 tag。
        val rn = record_name_of(a, sh) ?? "?"
        match Semares.get_ctor_def(s, cname) {
            null => throw FfiError(Other, "slice 3: unknown constructor '{cname}' in pattern (record '{rn}')")
            cd => {
                val ctn = (cd ?? Ctor("", "", [], [], [], false, null, null, [], Span(0, 0), "")).type_name
                if ctn != rn {
                    throw FfiError(Other, "slice 3: constructor '{cname}' belongs to '{ctn}', scrutinee is '{rn}'")
                }
            },
        }
        val fts = Semares.record_shape(s, rn) ?? []
        if fts.len() != subpats.len() {
            throw FfiError(Other, "slice 3: pattern '{cname}' expects {fts.len()} sub-patterns, got {subpats.len()}")
        }
        val lt = record_layout(lib, ctx, cache, a, s, rn)?
        field_chain(lib, ctx, builder, fref, a, s, mname, ast, aslots, atys, cache,
            subpats, fts, lt, 0u32, sv, ok_blk, fail_blk)
    } else {
        throw FfiError(Other, "slice 3: constructor pattern '{cname}' on non-ADT scrutinee")
    }
}

// 模式测试(CPS 双续体):全模式族——通配/绑定(含零参 ctor 转发)/
// 字面量(int/float/bool/char/str/null)/ctor/record(按名+按位)/
// or/guard。成功路径汇聚 br ok_blk,失败 br fail_blk;完成后 builder
// 位于 ok_blk(body/guard 在此续编)。
fun pat_test(lib: Lib, ctx: u64, builder: u64, fref: u64,
    a: TypeArena, s: SemaRes, mname: str, ast: AstArena,
    aslots: Map<str, u64>, atys: Map<str, u32>, cache: Map<str, u64>,
    pid: i64, sv: u64, sh: u32, ok_blk: u64, fail_blk: u64): Throw<void, FfiError> {
    match ast.pat(pid).node {
        PWild => {
            Llvm.build_br(lib, builder, ok_blk)?
            Llvm.position_builder_at_end(lib, builder, ok_blk)?
            Ok(void)
        },
        PVar(name) => {
            // ctor 名消歧(镜像引擎 Variable 分支:ctor_def 命中即 ctor 模式)。
            match Semares.get_ctor_def(s, name) {
                null => {
                    pat_bind(lib, ctx, builder, cache, a, s, name, sv, sh, aslots, atys)?
                    Llvm.build_br(lib, builder, ok_blk)?
                    Llvm.position_builder_at_end(lib, builder, ok_blk)?
                    Ok(void)
                },
                cd => {
                    if !Semares.type_def_is_multi_ctor_adt(s,
                        (cd ?? Ctor("", "", [], [], [], false, null, null, [], Span(0, 0), "")).type_name) {
                        throw FfiError(Other, "slice 3: single-ctor record name '{name}' needs explicit field patterns")
                    }
                    ctor_test(lib, ctx, builder, fref, a, s, mname, ast, aslots, atys, cache,
                        name, [], sv, sh, ok_blk, fail_blk)
                },
            }
        },
        PLit(pl) => {
            val k = agg_kind(a, s, sh)
            match pl {
                PLNull => {
                    if k != 9 {
                        throw FfiError(Other, "slice 3: null pattern on non-nullable scrutinee")
                    }
                    val t = nullable_tag(lib, ctx, builder, cache, sv)?
                    val i64ty = llty_for(lib, ctx, cache, TI64)?
                    val z = Llvm.const_int(lib, i64ty, 0u64, false)?
                    val b = Llvm.build_icmp(lib, builder, t, z, 32u32, "isnull")?
                    Llvm.build_cond_br(lib, builder, b, ok_blk, fail_blk)?
                    Llvm.position_builder_at_end(lib, builder, ok_blk)?
                    Ok(void)
                },
                PLStr(txt) => {
                    if k != 5 {
                        throw FfiError(Other, "slice 3: string pattern on non-str scrutinee")
                    }
                    val sp = str_lit_global(lib, ctx, cache, txt)?
                    val b = str_eq_inline(lib, ctx, builder, cache, fref, sv, sp)?
                    Llvm.build_cond_br(lib, builder, b, ok_blk, fail_blk)?
                    Llvm.position_builder_at_end(lib, builder, ok_blk)?
                    Ok(void)
                },
                PLInt(txt) => {
                    if k >= 5 {
                        throw FfiError(Other, "slice 3: int pattern on aggregate/nullable scrutinee (unsupported narrowing)")
                    }
                    val lt = llty_for_h(lib, ctx, cache, a, s, sh)?
                    val c = Llvm.const_int_str(lib, lt, int_digits(txt), int_radix(txt))?
                    val b = Llvm.build_icmp(lib, builder, sv, c, 32u32, tmp())?
                    Llvm.build_cond_br(lib, builder, b, ok_blk, fail_blk)?
                    Llvm.position_builder_at_end(lib, builder, ok_blk)?
                    Ok(void)
                },
                PLFloat(txt) => {
                    if k >= 5 {
                        throw FfiError(Other, "slice 3: float pattern on aggregate/nullable scrutinee (unsupported narrowing)")
                    }
                    val lt = llty_for_h(lib, ctx, cache, a, s, sh)?
                    val c = Llvm.const_real_str(lib, lt, txt)?
                    val b = Llvm.build_fcmp(lib, builder, sv, c, 2u32, tmp())?
                    Llvm.build_cond_br(lib, builder, b, ok_blk, fail_blk)?
                    Llvm.position_builder_at_end(lib, builder, ok_blk)?
                    Ok(void)
                },
                PLBool(bv) => {
                    if k >= 5 {
                        throw FfiError(Other, "slice 3: bool pattern on aggregate/nullable scrutinee (unsupported narrowing)")
                    }
                    val lt = llty_for(lib, ctx, cache, TBool)?
                    val bits = if bv { 1u64 } else { 0u64 }
                    val c = Llvm.const_int(lib, lt, bits, false)?
                    val b = Llvm.build_icmp(lib, builder, sv, c, 32u32, tmp())?
                    Llvm.build_cond_br(lib, builder, b, ok_blk, fail_blk)?
                    Llvm.position_builder_at_end(lib, builder, ok_blk)?
                    Ok(void)
                },
                PLChar(cp) => {
                    if k >= 5 {
                        throw FfiError(Other, "slice 3: char pattern on aggregate/nullable scrutinee (unsupported narrowing)")
                    }
                    val lt = llty_for(lib, ctx, cache, TChar)?
                    val c = Llvm.const_int(lib, lt, cp as u64, false)?
                    val b = Llvm.build_icmp(lib, builder, sv, c, 32u32, tmp())?
                    Llvm.build_cond_br(lib, builder, b, ok_blk, fail_blk)?
                    Llvm.position_builder_at_end(lib, builder, ok_blk)?
                    Ok(void)
                },
            }
        },
        PCtor(name, subpats) => {
            ctor_test(lib, ctx, builder, fref, a, s, mname, ast, aslots, atys, cache,
                name, subpats, sv, sh, ok_blk, fail_blk)
        },
        PRecord(fields) => {
            val k = agg_kind(a, s, sh)
            if k != 7 {
                throw FfiError(Other, "slice 3: record pattern on non-record scrutinee")
            }
            val rn = record_name_of(a, sh) ?? "?"
            val fts = Semares.record_shape(s, rn) ?? []
            val lt = record_layout(lib, ctx, cache, a, s, rn)?
            if fields.len() == 0 {
                Llvm.build_br(lib, builder, ok_blk)?
                Llvm.position_builder_at_end(lib, builder, ok_blk)?
                return Ok(void)
            }
            var fi: usize = 0
            while fi < fields.len() {
                val f = fields[fi]
                val fid = match parse_dec_idx(f.name) {
                    null => Semares.record_field_idx(s, rn, f.name)
                    d => d ?? 0,
                }
                if fid < 0 || (fid as usize) >= fts.len() {
                    throw FfiError(Other, "slice 3: record '{rn}' has no field '{f.name}' in pattern")
                }
                val fidx = fid as usize
                val oknext = if fi + 1 < fields.len() {
                    Llvm.append_block(lib, ctx, fref, "rc.n{fi}")?
                } else {
                    ok_blk
                }
                val addr = Llvm.build_struct_gep(lib, builder, lt, sv, fidx as u32, tmp())?
                val fv = load_at(lib, ctx, builder, cache, a, s, addr, fts[fidx])?
                pat_test(lib, ctx, builder, fref, a, s, mname, ast, aslots, atys, cache,
                    f.pattern, fv, fts[fidx], oknext, fail_blk)?
                fi = fi + 1
            }
            Ok(void)
        },
        POr(l, r) => {
            // 左右各自完整测试;成功同汇 or_true → br ok。绑定按序累积
            // (镜像引擎 bind_var 两侧都执行)。
            val or_true = Llvm.append_block(lib, ctx, fref, "or.t")?
            val r_start = Llvm.append_block(lib, ctx, fref, "or.r")?
            pat_test(lib, ctx, builder, fref, a, s, mname, ast, aslots, atys, cache,
                l, sv, sh, or_true, r_start)?
            Llvm.position_builder_at_end(lib, builder, r_start)?
            pat_test(lib, ctx, builder, fref, a, s, mname, ast, aslots, atys, cache,
                r, sv, sh, or_true, fail_blk)?
            Llvm.build_br(lib, builder, ok_blk)?
            Llvm.position_builder_at_end(lib, builder, ok_blk)?
            Ok(void)
        },
        PGuard(p, cond) => {
            val gok = Llvm.append_block(lib, ctx, fref, "pg.ok")?
            pat_test(lib, ctx, builder, fref, a, s, mname, ast, aslots, atys, cache,
                p, sv, sh, gok, fail_blk)?
            val gv = lower_expr(lib, ctx, builder, fref, a, s, mname, ast, aslots, atys, cache, cond)?
            if flow_stopped {
                // guard 内终止(罕见):补 br ok 保 verifier;stopped 传播。
                Llvm.build_br(lib, builder, ok_blk)?
                Llvm.position_builder_at_end(lib, builder, ok_blk)?
                return Ok(void)
            }
            val gh = expr_ty(a, s, mname, cond)?
            val gb = conv_to_bool(lib, ctx, builder, cache, a, gv, gh, tmp())?
            Llvm.build_cond_br(lib, builder, gb, ok_blk, fail_blk)?
            Llvm.position_builder_at_end(lib, builder, ok_blk)?
            Ok(void)
        },
    }
}

// match 值表达式:scrutinee 一次求值 → arm 链(模式测试 + guard →
// body,失败 → 下一 arm);结果槽 + merge(同 lower_if);全 arm 终止
// → merge 无前驱补 unreachable;非穷尽 = m.dead 块 unreachable
// (引擎 panic 语义,切片 3 面全穷尽)。
pub fun lower_match(lib: Lib, ctx: u64, builder: u64, fref: u64,
    a: TypeArena, s: SemaRes, mname: str, ast: AstArena,
    slots: Map<str, u64>, tyslots: Map<str, u32>, cache: Map<str, u64>,
    eid: i64, scrut: i64, arms: Marm[]): Throw<u64, FfiError> {
    val scrut_v = lower_expr(lib, ctx, builder, fref, a, s, mname, ast, slots, tyslots, cache, scrut)?
    if flow_stopped {
        return Ok(0u64)
    }
    val scrut_h = expr_ty(a, s, mname, scrut)?
    // 结果形态:缺表项或 TVoid → void(同 lower_if)。
    var is_void = true
    var my_h = cur_ret_h
    match Semares.get_expr(s, Semares.module_expr_key(mname, eid)) {
        null => {}
        h => {
            val rh = Arena.resolve(a, h ?? 0)
            if ty_kind(Arena.get(a, rh)) != 4 {
                is_void = false
                my_h = rh
            }
        },
    }
    var slot = 0u64
    if !is_void {
        val st = llty_for_h(lib, ctx, cache, a, s, my_h)?
        slot = Llvm.build_alloca(lib, builder, st, "m.res")?
    }
    val merge_blk = Llvm.append_block(lib, ctx, fref, "m.end")?
    // 切片 3:nullable arm 窄化(镜像引擎 Match.rs:null arm 之后的非
    // null arm 已知非 null——PVar 绑定/ctor 解构/字面量模式统一按
    // inner 型处理;scrut 值 conv unbox 一次入 arm)。
    val scrut_k = agg_kind(a, s, scrut_h)
    val scrut_inner = if scrut_k == 9 {
        Arena.nullable_inner(a, Arena.resolve(a, scrut_h))
    } else {
        scrut_h
    }
    var null_arm_seen = false
    var all_stopped = true
    var i: usize = 0
    while i < arms.len() {
        val arm = arms[i]
        // 本 arm 失败目标:下一 arm 测试起点(末 arm = m.dead)。
        val next_blk = if i + 1 < arms.len() {
            Llvm.append_block(lib, ctx, fref, "m.arm{i + 1}")?
        } else {
            Llvm.append_block(lib, ctx, fref, "m.dead")?
        }
        val aslots = copy_slots(slots)
        val atys = copy_tys(tyslots)
        val body_blk = Llvm.append_block(lib, ctx, fref, "m.ok{i}")?
        val is_null_arm = match ast.pat(arm.pattern).node {
            PLit(pl) => {
                match pl {
                    PLNull => true
                    _ => false
                }
            },
            _ => false,
        }
        var arm_h = scrut_h
        var arm_v = scrut_v
        if scrut_k == 9 && null_arm_seen && !is_null_arm && !is_open_var(a, scrut_inner) {
            arm_h = scrut_inner
            arm_v = conv_value(lib, ctx, builder, cache, a, s, scrut_v, scrut_h, arm_h, tmp())?
        }
        null_arm_seen = null_arm_seen || is_null_arm
        flow_stopped = false
        pat_test(lib, ctx, builder, fref, a, s, mname, ast, aslots, atys, cache,
            arm.pattern, arm_v, arm_h, body_blk, next_blk)?
        match arm.guard {
            null => {}
            g => {
                val gv = lower_expr(lib, ctx, builder, fref, a, s, mname, ast, aslots, atys, cache, g ?? 0)?
                if !flow_stopped {
                    val gh = expr_ty(a, s, mname, g ?? 0)?
                    val gb = conv_to_bool(lib, ctx, builder, cache, a, gv, gh, tmp())?
                    val gok = Llvm.append_block(lib, ctx, fref, "m.grd{i}")?
                    Llvm.build_cond_br(lib, builder, gb, gok, next_blk)?
                    Llvm.position_builder_at_end(lib, builder, gok)?
                }
            },
        }
        if !flow_stopped {
            val bv = lower_expr(lib, ctx, builder, fref, a, s, mname, ast, aslots, atys, cache, arm.body)?
            if !flow_stopped && !is_void {
                val bh = expr_ty(a, s, mname, arm.body)?
                val bvc = conv_value(lib, ctx, builder, cache, a, s, bv, bh, my_h, tmp())?
                match Llvm.build_store(lib, builder, bvc, slot) {
                    Ok(_) => {}
                    Error(e) => throw e
                }
            }
            if !flow_stopped {
                Llvm.build_br(lib, builder, merge_blk)?
            }
        }
        all_stopped = all_stopped && flow_stopped
        Llvm.position_builder_at_end(lib, builder, next_blk)?
        i = i + 1
    }
    // m.dead:全 arm 不匹配(引擎 panic;切片 3 面全穷尽,不可达)。
    Llvm.build_unreachable(lib, builder)?
    Llvm.position_builder_at_end(lib, builder, merge_blk)?
    if all_stopped {
        Llvm.build_unreachable(lib, builder)?
        flow_stopped = true
        return Ok(0u64)
    }
    flow_stopped = false
    if is_void {
        return Ok(0u64)
    }
    val lt = llty_for_h(lib, ctx, cache, a, s, my_h)?
    Llvm.build_load(lib, builder, lt, slot, tmp())
}

// 块表达式(表达式位):作用域副本 + 语句列 + 尾表达式即块值。
pub fun lower_block(lib: Lib, ctx: u64, builder: u64, fref: u64,
    a: TypeArena, s: SemaRes, mname: str, ast: AstArena,
    slots: Map<str, u64>, tyslots: Map<str, u32>, cache: Map<str, u64>,
    stmts: i64[], tail: i64?): Throw<u64, FfiError> {
    val bslots = copy_slots(slots)
    val btys = copy_tys(tyslots)
    var k: usize = 0
    while k < stmts.len() && !flow_stopped {
        match lower_stmt(lib, ctx, builder, fref, a, s, mname, ast, bslots, btys, cache, stmts[k]) {
            Ok(_) => {}
            Error(e) => throw e
        }
        k = k + 1
    }
    if flow_stopped {
        return Ok(0u64)
    }
    match tail {
        null => Ok(0u64)
        te => lower_expr(lib, ctx, builder, fref, a, s, mname, ast, bslots, btys, cache, te ?? 0),
    }
}

// 调用(切片 1:入口模块非泛型 sync fun;被调名必须在函数表)。
// 已收集函数行的调用发射(切片 6a:本地/跨模块两路共用;切片 5 的
// void 清名纪律在此)。
fun lower_call_row(lib: Lib, ctx: u64, builder: u64, fref: u64,
    a: TypeArena, s: SemaRes, mname: str, ast: AstArena,
    slots: Map<str, u64>, tyslots: Map<str, u32>, cache: Map<str, u64>,
    eid: i64, ri: usize, name: str, args: i64[]): Throw<u64, FfiError> {
    mark_reachable(ri)
    // 切片 6e:实例行的调用值型覆写 —— 实例化重放的构造器返回槽
    // 有 void 毒点(List<T> 构造在全局表末者胜,实参槽被 TVoid 覆写),
    // 调用点的值型以注册行返回型(经 inst_param_ty 代换,可信)为准。
    if (fn_inst_ids.get(ri) ?? -1) != -1 {
        match fn_rets.get(ri) {
            null => {}
            r0v => { ty_overlay.set(Semares.module_expr_key(mname, eid), r0v ?? 0) }
        }
    }
    val ph = fn_params.get(ri) ?? []
    if ph.len() != args.len() {
        throw FfiError(Other, "slice 1: arity mismatch calling '{name}' (expr {eid})")
    }
    var vals: u64[] = []
    var ai: usize = 0
    while ai < args.len() {
        val av = lower_expr(lib, ctx, builder, fref, a, s, mname, ast, slots, tyslots, cache, args[ai])?
        if flow_stopped {
            return Ok(0u64)
        }
        val ah = expr_ty_sl(a, s, mname, args[ai], ast, tyslots)?
        vals = vals ++ [conv_value(lib, ctx, builder, cache, a, s,av, ah, ph[ai], tmp())?]
        ai = ai + 1
    }
    val ft = fn_lty.get(ri) ?? 0
    val fr = fn_llvm.get(ri) ?? 0
    // 切片 5(雷):void 返回 call 建后清名(带名 = verifier 拒;空串
    // cstr = Twine UB)。尾值 Ok 包裹(裸 0u64 强转 null Throw 即崩)。
    val ret_is_void = ty_kind(Arena.get(a, Arena.resolve(a, fn_rets.get(ri) ?? 0))) == 4
    if ret_is_void {
        val ch = if vals.len() == 0 {
            Llvm.build_call2_0(lib, builder, ft, fr, tmp())?
        } else {
            Llvm.build_call2(lib, builder, ft, fr, vals, tmp())?
        }
        Llvm.clear_value_name(lib, ch)?
        Ok(0u64)
    } else if vals.len() == 0 {
        Llvm.build_call2_0(lib, builder, ft, fr, tmp())
    } else {
        Llvm.build_call2(lib, builder, ft, fr, vals, tmp())
    }
}

// 切片 6c:方法调用发射——[recv] + args 逐位 conv 到方法签名
// (ph[0] = this 型;void 纪律同 lower_call_row)。
fun lower_method_call(lib: Lib, ctx: u64, builder: u64, fref: u64,
    a: TypeArena, s: SemaRes, mname: str, ast: AstArena,
    slots: Map<str, u64>, tyslots: Map<str, u32>, cache: Map<str, u64>,
    eid: i64, ri: usize, recv: i64, recv_h: u32, args: i64[]): Throw<u64, FfiError> {
    mark_reachable(ri)
    // 切片 6e:调用值型覆写(同 lower_call_row;方法实例行的返回 =
    // 代换后签名返回)。
    match fn_rets.get(ri) {
        null => {}
        r0m => { ty_overlay.set(Semares.module_expr_key(mname, eid), r0m ?? 0) }
    }
    val ph = fn_params.get(ri) ?? []
    if ph.len() != args.len() + 1 {
        throw FfiError(Other, "slice 6c: method arity mismatch (expr {eid}): expects {ph.len() - 1} args, got {args.len()}")
    }
    var vals: u64[] = []
    // recv < 0 = 隐式 this(从 this 槽装载)。
    val rv = if recv < 0 {
        val pt = llty_for_h(lib, ctx, cache, a, s, recv_h)
        match pt {
            Ok(pt0) => Llvm.build_load(lib, builder, pt0, cur_this_slot, "thisv")
            Error(e) => throw e
        }
    } else {
        lower_expr(lib, ctx, builder, fref, a, s, mname, ast, slots, tyslots, cache, recv)
    }
    match rv {
        Ok(rv0) => {
            if !flow_stopped {
                vals = vals ++ [conv_value(lib, ctx, builder, cache, a, s, rv0, recv_h, ph[0], tmp())?]
            } else {
                return Ok(0u64)
            }
        },
        Error(e) => throw e,
    }
    var ai: usize = 0
    while ai < args.len() {
        val av = lower_expr(lib, ctx, builder, fref, a, s, mname, ast, slots, tyslots, cache, args[ai])?
        if flow_stopped {
            return Ok(0u64)
        }
        val ah = expr_ty_sl(a, s, mname, args[ai], ast, tyslots)?
        vals = vals ++ [conv_value(lib, ctx, builder, cache, a, s, av, ah, ph[ai + 1], tmp())?]
        ai = ai + 1
    }
    val ft = fn_lty.get(ri) ?? 0
    val fr = fn_llvm.get(ri) ?? 0
    val ret_is_void = ty_kind(Arena.get(a, Arena.resolve(a, fn_rets.get(ri) ?? 0))) == 4
    if ret_is_void {
        val ch = if vals.len() == 0 {
            Llvm.build_call2_0(lib, builder, ft, fr, tmp())?
        } else {
            Llvm.build_call2(lib, builder, ft, fr, vals, tmp())?
        }
        Llvm.clear_value_name(lib, ch)?
        Ok(0u64)
    } else if vals.len() == 0 {
        Llvm.build_call2_0(lib, builder, ft, fr, tmp())
    } else {
        Llvm.build_call2(lib, builder, ft, fr, vals, tmp())
    }
}

// 切片 6d:@extern("C") 调用——C ABI 编组:str 参数 = 块地址拆
// (data@8 ptr, len@0) 双参;标量按声明宽 conv;返回标量直传。
fun lower_extern_call(lib: Lib, ctx: u64, builder: u64, fref: u64,
    a: TypeArena, s: SemaRes, mname: str, ast: AstArena,
    slots: Map<str, u64>, tyslots: Map<str, u32>, cache: Map<str, u64>,
    eid: i64, name: str, args: i64[]): Throw<u64, FfiError> {
    val efn = extern_llvm.get(name) ?? 0
    val eft = extern_fts.get(name) ?? 0
    val eph = extern_params.get(name) ?? []
    if eph.len() != args.len() {
        throw FfiError(Other, "slice 6d: extern '{name}' arity mismatch (expr {eid})")
    }
    var vals: u64[] = []
    var ai: usize = 0
    while ai < args.len() {
        val av = lower_expr(lib, ctx, builder, fref, a, s, mname, ast, slots, tyslots, cache, args[ai])?
        if flow_stopped {
            return Ok(0u64)
        }
        val ah = expr_ty_sl(a, s, mname, args[ai], ast, tyslots)?
        if agg_kind(a, s, eph[ai]) == 5 {
            // str → (data, len)。
            val i64ty = llty_for(lib, ctx, cache, TI64)?
            val i8ty = llty_for(lib, ctx, cache, TI8)?
            val c8 = Llvm.const_int(lib, i64ty, 8u64, false)?
            val daddr = Llvm.build_inbounds_gep2(lib, builder, i8ty, av, [c8], "xd")?
            val lval = Llvm.build_load(lib, builder, i64ty, av, "xl")?
            vals = vals ++ [daddr, lval]
        } else {
            vals = vals ++ [conv_value(lib, ctx, builder, cache, a, s, av, ah, eph[ai], tmp())?]
        }
        ai = ai + 1
    }
    // 切片 6e:void 返回建后清名(verifier 拒带名 void call;空串
    // cstr = Twine UB——两不可,唯清名)。切片 6g:零参 extern 走 _0。
    if extern_voids.get(name) == true {
        val ch = if vals.len() == 0 {
            Llvm.build_call2_0(lib, builder, eft, efn, tmp())?
        } else {
            Llvm.build_call2(lib, builder, eft, efn, vals, tmp())?
        }
        Llvm.clear_value_name(lib, ch)?
        Ok(0u64)
    } else if vals.len() == 0 {
        Llvm.build_call2_0(lib, builder, eft, efn, tmp())
    } else {
        Llvm.build_call2(lib, builder, eft, efn, vals, tmp())
    }
}

pub fun lower_call(lib: Lib, ctx: u64, builder: u64, fref: u64,
    a: TypeArena, s: SemaRes, mname: str, ast: AstArena,
    slots: Map<str, u64>, tyslots: Map<str, u32>, cache: Map<str, u64>,
    eid: i64, callee: i64, args: i64[]): Throw<u64, FfiError> {
    match ast.expr(callee).node {
        Ident(name) => {
            // 切片 6b:泛型调用路由(sema 裁决的 call_instantiations,
            // 键 = 调用表达式 id)优先于常规解析;空实参实例不进
            // inst_rows(与常规收集重复),未命中自然回落。
            match s.call_instantiations.get(Semares.module_expr_key(mname, eid)) {
                null => {}
                inst_id0 => {
                    match inst_rows.get("{inst_id0 ?? 0}") {
                        null => {}
                        rowi => {
                            return lower_call_row(lib, ctx, builder, fref, a, s, mname, ast,
                                slots, tyslots, cache, eid, (rowi ?? 0) as usize, name, args)
                        },
                    }
                },
            }
            // 切片 6d:@extern("C") 表(rt 写原语或 builtin Raw 族
            // declare)——先于跨模块解析(builtin 拥有者不在收集面)。
            if extern_llvm.get(name) != null {
                return lower_extern_call(lib, ctx, builder, fref, a, s, mname, ast,
                    slots, tyslots, cache, eid, name, args)
            }
            // 切片 6a:模块隔离键(本地先行);跨模块裸名经
            // func_sig_owners 唯一 USER 拥有者解析。
            var idx_key = fn_key(mname, name)
            match fn_index.get(idx_key) {
                null => {
                    match resolve_cross_module(s, mname, name) {
                        null => {}
                        owner => {
                            val okey = fn_key(owner ?? "", name)
                            match fn_index.get(okey) {
                                null => {
                                    throw FfiError(Other, "slice 6: cross-module callee '{name}' (owner '{owner ?? ""}') not collected (expr {eid} in '{mname}')")
                                }
                                row2 => {
                                    return lower_call_row(lib, ctx, builder, fref, a, s, mname, ast,
                                        slots, tyslots, cache, eid, (row2 ?? 0) as usize, name, args)
                                },
                            }
                        },
                    }
                    // 切片 4:Ok(v) 两态值构造(root builtin fn,fn_index
                    // 不含)——按调用点 sema 型 TThrow 的 V 部装箱 tag=0。
                    // Err-Throw 不经此路(仅 throw 语句构造)。
                    if name == "Ok" && args.len() == 1 {
                        val my_h = expr_ty(a, s, mname, eid)?
                        val mr = Arena.resolve(a, my_h)
                        match Arena.get(a, mr) {
                            TThrow(_) => {
                                // Throw<void, E>:载荷 void/open → i64 0 哑box
                                //(open = 重放未绑定的 V 位,按 void 处理)。
                                val vp0 = Arena.thr_parts(a, mr).a
                                val vp0r = Arena.get(a, Arena.resolve(a, vp0))
                                val vp0open = match vp0r { TTypeVar(_) => true, TUnknown => true, _ => false }
                                if ty_kind(vp0r) == 4 || vp0open {
                                    val vc0 = throw_box_val(lib, ctx, builder, cache, a, s,
                                        Llvm.const_int(lib, llty_for(lib, ctx, cache, TI64)?, 0u64, false)?,
                                        Arena.from_scalar_name(a, "i64"), false)?
                                    return Ok(vc0)
                                }
                                val vp = vp0
                                val av = lower_expr(lib, ctx, builder, fref, a, s, mname, ast, slots, tyslots, cache, args[0])?
                                if flow_stopped {
                                    return Ok(0u64)
                                }
                                val ah = expr_ty(a, s, mname, args[0])?
                                val vc = conv_value(lib, ctx, builder, cache, a, s, av, ah, vp, tmp())?
                                throw_box_val(lib, ctx, builder, cache, a, s, vc, vp, false)
                            },
                            _ => throw FfiError(Other, "slice 4: 'Ok' construction with non-Throw expected type (expr {eid})"),
                        }
                    } else {
                    // 切片 2:record 构造器(单 ctor 非泛型聚合;args 逐个
                    // conv 到字段类型 → frond_alloc → 逐字段 store;值 =
                    // 块地址)。非函数非 record = 响亮报错。
                    match Semares.record_shape(s, name) {
                        null => {
                            // 切片 3:多 ctor ADT 构造器(callee 名 = ctor 名;
                            // per-ctor struct {i64 tag, fields...},tag = ctor 在
                            // TDef.constructors 的 0 基索引)。
                            match Semares.get_ctor_def(s, name) {
                                null => {
                                    // 切片 6c:方法体内裸方法调用(隐式
                                    // this.m(args))。切片 6e:this 为泛型
                                    // 实例 → 方法实例分派(同显式接收者)。
                                    if cur_this_h != 0 {
                                        val frn = record_name_of(a, Arena.resolve(a, cur_this_h)) ?? "?"
                                        val tn1 = Semares.resolve_type_key(s, frn) ?? frn
                                        val tgargs = Arena.adt_parts(a, Arena.resolve(a, cur_this_h)).b
                                        if tgargs.len() > 0 {
                                            val tkey2 = mkey_of(a, s, tn1, name, cur_this_h)
                                            match meth_inst_rows.get(tkey2) {
                                                null => {
                                                    match register_method_instance(lib, ctx, cur_module, a, s, cache, cur_this_h, name, eid) {
                                                        Ok(trow) => {
                                                            meth_inst_rows.set(tkey2, trow)
                                                            return lower_method_call(lib, ctx, builder, fref, a, s, mname, ast,
                                                                slots, tyslots, cache, eid, trow as usize,
                                                                -1i64, cur_this_h, args)
                                                        },
                                                        Error(_) => {},
                                                    }
                                                },
                                                trow0 => {
                                                    return lower_method_call(lib, ctx, builder, fref, a, s, mname, ast,
                                                        slots, tyslots, cache, eid, (trow0 ?? 0) as usize,
                                                        -1i64, cur_this_h, args)
                                                },
                                            }
                                        }
                                        match method_rows.get(tn1 + "\u{0}" + name) {
                                            null => {}
                                            row0 => {
                                                return lower_method_call(lib, ctx, builder, fref, a, s, mname, ast,
                                                    slots, tyslots, cache, eid, (row0 ?? 0) as usize,
                                                    -1i64, cur_this_h, args)
                                            },
                                        }
                                    }
                                    throw FfiError(Other, "slice 1: callee '{name}' not slice-1 function (generic/async/throwing/std/cross-module arrive in later slices)")
                                },
                                cd => {
                                    val tn0 = (cd ?? Ctor("", "", [], [], [], false, null, null, [], Span(0, 0), "")).type_name
                                    // 切片 6e:泛型 record 构造器(单 ctor 泛型聚合
                                    // List(buf,0)/MapEntry(k,v) 族)——声明字段经
                                    // 实参类型结构对位反推 type_args,字段类型/
                                    // 布局按代换;构造产物型入 overlay(下游读
                                    // 众取实例型,不依赖 sema 全局末者胜)。
                                    // ctor.type_name 是声明位裸名,TAdt 表键 =
                                    // canonical(resolve_type_key)。
                                    val tn = Semares.resolve_type_key(s, tn0) ?? tn0
                                    match Semares.get_type_def(s, tn) {
                                        null => {}
                                        td0 => {
                                            val td = td0 ?? Data.TDef("", Data.TAlias, [], [], null, null, [], [])
                                            if td.type_params.len() > 0 && td.constructors.len() == 1 {
                                                if td.constructors[0].field_types.len() != args.len() {
                                                    throw FfiError(Other, "slice 6e: arity mismatch constructing '{name}' (expr {eid})")
                                                }
                                                var arghs: u32[] = []
                                                var ai2: usize = 0
                                                while ai2 < args.len() {
                                                    arghs = arghs ++ [expr_ty(a, s, mname, args[ai2])?]
                                                    ai2 = ai2 + 1
                                                }
                                                val gargs = infer_ctor_args(a, s, td.type_params,
                                                    td.constructors[0].field_types, arghs)
                                                val inst_h = Arena.make_adt(a, tn, gargs)
                                                ty_overlay.set(Semares.module_expr_key(mname, eid), inst_h)
                                                var vals: u64[] = []
                                                var ai3: usize = 0
                                                while ai3 < args.len() {
                                                    val av = lower_expr(lib, ctx, builder, fref, a, s, mname, ast, slots, tyslots, cache, args[ai3])?
                                                    if flow_stopped {
                                                        return Ok(0u64)
                                                    }
                                                    val ah = expr_ty(a, s, mname, args[ai3])?
                                                    val fth = subst_ty(a, td.type_params, gargs,
                                                        td.constructors[0].field_types[ai3])
                                                    vals = vals ++ [conv_value(lib, ctx, builder, cache, a, s, av, ah, fth, tmp())?]
                                                    ai3 = ai3 + 1
                                                }
                                                val lt = record_layout_h(lib, ctx, cache, a, s, inst_h)?
                                                val sz = Llvm.abi_size_of_type(lib, cur_td, lt)?
                                                val p = call_alloc(lib, ctx, cache, builder, sz)?
                                                var fi4: usize = 0
                                                while fi4 < vals.len() {
                                                    val faddr = Llvm.build_struct_gep(lib, builder, lt, p, fi4 as u32, tmp())?
                                                    Llvm.build_store(lib, builder, vals[fi4], faddr)?
                                                    fi4 = fi4 + 1
                                                }
                                                return Ok(p)
                                            }
                                        },
                                    }
                                    if !Semares.type_def_is_multi_ctor_adt(s, tn) {
                                        throw FfiError(Other, "slice 3: ctor '{name}' on non-slice-3 shape (generic/newtype ctors arrive in later slices)")
                                    }
                                    val cidx = Semares.adt_ctor_index(s, tn, name)
                                    if cidx < 0 {
                                        throw FfiError(Other, "slice 3: ctor '{name}' not found on '{tn}' (expr {eid})")
                                    }
                                    val fts = Semares.adt_ctor_fields(s, tn, cidx) ?? []
                                    if fts.len() != args.len() {
                                        throw FfiError(Other, "slice 3: arity mismatch constructing '{name}' (expr {eid})")
                                    }
                                    var vals: u64[] = []
                                    var ai: usize = 0
                                    while ai < args.len() {
                                        val av = lower_expr(lib, ctx, builder, fref, a, s, mname, ast, slots, tyslots, cache, args[ai])?
                                        if flow_stopped {
                                            return Ok(0u64)
                                        }
                                        val ah = expr_ty_sl(a, s, mname, args[ai], ast, tyslots)?
                                        vals = vals ++ [conv_value(lib, ctx, builder, cache, a, s, av, ah, fts[ai], tmp())?]
                                        ai = ai + 1
                                    }
                                    adt_ctor_build(lib, ctx, builder, cache, a, s, tn, cidx, vals)
                                },
                            }
                        },
                        fts0 => {
                            val fts = fts0 ?? []
                            if fts.len() != args.len() {
                                throw FfiError(Other, "slice 2: arity mismatch constructing '{name}' (expr {eid})")
                            }
                            var vals: u64[] = []
                            var ai: usize = 0
                            while ai < args.len() {
                                val av = lower_expr(lib, ctx, builder, fref, a, s, mname, ast, slots, tyslots, cache, args[ai])?
                                if flow_stopped {
                                    return Ok(0u64)
                                }
                                val ah = expr_ty_sl(a, s, mname, args[ai], ast, tyslots)?
                                vals = vals ++ [conv_value(lib, ctx, builder, cache, a, s, av, ah, fts[ai], tmp())?]
                                ai = ai + 1
                            }
                            val lt = record_layout(lib, ctx, cache, a, s, name)?
                            val sz = Llvm.abi_size_of_type(lib, cur_td, lt)?
                            val p = call_alloc(lib, ctx, cache, builder, sz)?
                            var fi: usize = 0
                            while fi < fts.len() {
                                val faddr = Llvm.build_struct_gep(lib, builder, lt, p, fi as u32, tmp())?
                                Llvm.build_store(lib, builder, vals[fi], faddr)?
                                fi = fi + 1
                            }
                            Ok(p)
                        },
                    }
                    }
                },
                row => {
                    lower_call_row(lib, ctx, builder, fref, a, s, mname, ast,
                        slots, tyslots, cache, eid, (row ?? 0) as usize, name, args)
                },
            }
        },
        _ => throw FfiError(Other, "slice 1: call target must be a plain identifier (expr {eid})"),
    }
}

// Elvis(??,切片 3):lhs ?? rhs——lhs 非 null → unbox(inner = 表达式
// 类型);null → rhs(短路:rhs 仅 null 分支求值)。lhs 形:nullable 块
// (或裸 null 规范块——tag@0=0 恒 null)。结果槽 + cond_br 双臂
// store,merge load(同 short_circuit 骨架)。
pub fun elvis_build(lib: Lib, ctx: u64, builder: u64, fref: u64,
    a: TypeArena, s: SemaRes, mname: str, ast: AstArena,
    slots: Map<str, u64>, tyslots: Map<str, u32>, cache: Map<str, u64>,
    eid: i64, lhs: i64, rhs: i64, my_h: u32): Throw<u64, FfiError> {
    val lv = lower_expr(lib, ctx, builder, fref, a, s, mname, ast, slots, tyslots, cache, lhs)?
    if flow_stopped {
        return Ok(0u64)
    }
    // 切片 6e:lhs 先 lower(实例调用 overlay 落表)再取型——毒型
    //(方法糖调用的共享刚性槽)经 overlay 复原。
    val lh = expr_ty(a, s, mname, lhs)?
    val lk = agg_kind(a, s, lh)
    if lk != 9 && !is_open_var(a, lh) {
        throw FfiError(Other, "slice 3: '??' lhs must be nullable (expr {eid}, got kind {lk})")
    }
    val i64ty = llty_for(lib, ctx, cache, TI64)?
    val t = nullable_tag(lib, ctx, builder, cache, lv)?
    val z = Llvm.const_int(lib, i64ty, 0u64, false)?
    val isnull = Llvm.build_icmp(lib, builder, t, z, 32u32, "elv.n")?
    val st = llty_for_h(lib, ctx, cache, a, s, my_h)?
    val slot = Llvm.build_alloca(lib, builder, st, "elv.res")?
    val some_blk = Llvm.append_block(lib, ctx, fref, "elv.some")?
    val null_blk = Llvm.append_block(lib, ctx, fref, "elv.null")?
    val merge_blk = Llvm.append_block(lib, ctx, fref, "elv.end")?
    Llvm.build_cond_br(lib, builder, isnull, null_blk, some_blk)?
    // some:unbox(窄化路径 null 不可达;inner = 表达式类型)。
    Llvm.position_builder_at_end(lib, builder, some_blk)?
    val uv = nullable_unbox_val(lib, ctx, builder, cache, a, s, lv, my_h)?
    Llvm.build_store(lib, builder, uv, slot)?
    Llvm.build_br(lib, builder, merge_blk)?
    // null:rhs(短路求值)→ conv 入槽。
    Llvm.position_builder_at_end(lib, builder, null_blk)?
    flow_stopped = false
    val rv = lower_expr(lib, ctx, builder, fref, a, s, mname, ast, slots, tyslots, cache, rhs)?
    if !flow_stopped {
        val rh = expr_ty(a, s, mname, rhs)?
        val rvc = conv_value(lib, ctx, builder, cache, a, s, rv, rh, my_h, tmp())?
        Llvm.build_store(lib, builder, rvc, slot)?
        Llvm.build_br(lib, builder, merge_blk)?
    }
    Llvm.position_builder_at_end(lib, builder, merge_blk)?
    Llvm.build_load(lib, builder, st, slot, tmp())
}

// nullable 相等族(切片 3):Eq/Neq 任一侧 nullable。三形态——
// ①一侧 null 形(inner 开放变量,即 NullLit):判对侧 tag;
// ②双 nullable:tag 相等 && (null 或 payload 相等)——纯数据流公式,
//   payload 零值安全(null 块 zeroinit,标量 icmp/聚合 ptr eq 不解引用);
// ③nullable vs 标量:peel unbox 后常规比较(镜像引擎 ExprInfer 剥壳)。
pub fun nullable_eq_dispatch(lib: Lib, ctx: u64, builder: u64, fref: u64,
    a: TypeArena, s: SemaRes, mname: str, ast: AstArena,
    slots: Map<str, u64>, tyslots: Map<str, u32>, cache: Map<str, u64>,
    eid: i64, op: BOp, lhs: i64, rhs: i64,
    lh: u32, rh: u32, lk: i64, rk: i64): Throw<u64, FfiError> {
    val i64ty = llty_for(lib, ctx, cache, TI64)?
    val i1ty = llty_for(lib, ctx, cache, TBool)?
    val tru = Llvm.const_int(lib, i1ty, 1u64, false)?
    val z = Llvm.const_int(lib, i64ty, 0u64, false)?
    val lnull_lit = lk == 9 && is_open_var(a, Arena.nullable_inner(a, Arena.resolve(a, lh)))
    val rnull_lit = rk == 9 && is_open_var(a, Arena.nullable_inner(a, Arena.resolve(a, rh)))
    // Neq = eq 取反(xor true)。
    fun finish_impl(b: u64): Throw<u64, FfiError> {
        if op == Ast.Neq {
            Llvm.build_xor(lib, builder, b, tru, tmp())
        } else {
            Ok(b)
        }
    }
    if rnull_lit && lk == 9 {
        // e == null:判 e 的 tag。
        val lv = lower_expr(lib, ctx, builder, fref, a, s, mname, ast, slots, tyslots, cache, lhs)?
        if flow_stopped {
            return Ok(0u64)
        }
        val t = nullable_tag(lib, ctx, builder, cache, lv)?
        val b = Llvm.build_icmp(lib, builder, t, z, 32u32, "nq.z")?
        finish_impl(b)
    } else if lnull_lit && rk == 9 {
        // null == e:判 e 的 tag。
        val rv = lower_expr(lib, ctx, builder, fref, a, s, mname, ast, slots, tyslots, cache, rhs)?
        if flow_stopped {
            return Ok(0u64)
        }
        val t = nullable_tag(lib, ctx, builder, cache, rv)?
        val b = Llvm.build_icmp(lib, builder, t, z, 32u32, "nq.z")?
        finish_impl(b)
    } else if lk == 9 && rk == 9 {
        // 双 nullable:tag+payload 公式。
        val lv = lower_expr(lib, ctx, builder, fref, a, s, mname, ast, slots, tyslots, cache, lhs)?
        if flow_stopped {
            return Ok(0u64)
        }
        val rv = lower_expr(lib, ctx, builder, fref, a, s, mname, ast, slots, tyslots, cache, rhs)?
        if flow_stopped {
            return Ok(0u64)
        }
        val pi = Arena.nullable_inner(a, Arena.resolve(a, lh))
        val ltag = nullable_tag(lib, ctx, builder, cache, lv)?
        val rtag = nullable_tag(lib, ctx, builder, cache, rv)?
        val tags_eq = Llvm.build_icmp(lib, builder, ltag, rtag, 32u32, "nq.te")?
        val lnull = Llvm.build_icmp(lib, builder, ltag, z, 32u32, "nq.ln")?
        val lp = nullable_unbox_val(lib, ctx, builder, cache, a, s, lv, pi)?
        val rp = nullable_unbox_val(lib, ctx, builder, cache, a, s, rv, pi)?
        // payload 相等:标量 icmp/fcmp;聚合/str ptr eq(引用近似;null
        // 侧 payload 零值,不解引用安全)。
        val peq = if agg_kind(a, s, pi) == 1 {
            Llvm.build_fcmp(lib, builder, lp, rp, 2u32, tmp())?
        } else {
            Llvm.build_icmp(lib, builder, lp, rp, 32u32, tmp())?
        }
        val orv = Llvm.build_or(lib, builder, lnull, peq, tmp())?
        val eq = Llvm.build_and(lib, builder, tags_eq, orv, "nq.eq")?
        finish_impl(eq)
    } else if lk == 9 && rk >= 0 && rk < 5 {
        // nullable vs 标量:peel unbox(窄化调用方保证)。
        val lv = lower_expr(lib, ctx, builder, fref, a, s, mname, ast, slots, tyslots, cache, lhs)?
        if flow_stopped {
            return Ok(0u64)
        }
        val rv = lower_expr(lib, ctx, builder, fref, a, s, mname, ast, slots, tyslots, cache, rhs)?
        if flow_stopped {
            return Ok(0u64)
        }
        val pi = Arena.nullable_inner(a, Arena.resolve(a, lh))
        val lp = nullable_unbox_val(lib, ctx, builder, cache, a, s, lv, pi)?
        val lpc = conv_value(lib, ctx, builder, cache, a, s, lp, pi, rh, tmp())?
        val rvc = conv_value(lib, ctx, builder, cache, a, s, rv, rh, rh, tmp())?
        finish_impl(cmp_build(lib, builder, Arena.get(a, Arena.resolve(a, rh)), lpc, rvc, 32u32, 2u32)?)
    } else if rk == 9 && lk >= 0 && lk < 5 {
        val lv = lower_expr(lib, ctx, builder, fref, a, s, mname, ast, slots, tyslots, cache, lhs)?
        if flow_stopped {
            return Ok(0u64)
        }
        val rv = lower_expr(lib, ctx, builder, fref, a, s, mname, ast, slots, tyslots, cache, rhs)?
        if flow_stopped {
            return Ok(0u64)
        }
        val pi = Arena.nullable_inner(a, Arena.resolve(a, rh))
        val rp = nullable_unbox_val(lib, ctx, builder, cache, a, s, rv, pi)?
        val rpc = conv_value(lib, ctx, builder, cache, a, s, rp, pi, lh, tmp())?
        val lvc = conv_value(lib, ctx, builder, cache, a, s, lv, lh, lh, tmp())?
        finish_impl(cmp_build(lib, builder, Arena.get(a, Arena.resolve(a, lh)), lvc, rpc, 32u32, 2u32)?)
    } else {
        throw FfiError(Other, "slice 3: unsupported nullable comparison kinds {lk} vs {rk} (expr {eid})")
    }
}

pub fun lower_binary(lib: Lib, ctx: u64, builder: u64, fref: u64,
    a: TypeArena, s: SemaRes, mname: str, ast: AstArena,
    slots: Map<str, u64>, tyslots: Map<str, u32>, cache: Map<str, u64>,
    eid: i64, op: BOp, lhs: i64, rhs: i64): Throw<u64, FfiError> {
    // &&/|| 短路(引擎 Bug#38 同语义):RHS 不得预求值,在通用操作数
    // lowering 之前分派。
    match op {
        And => { return short_circuit(lib, ctx, builder, fref, a, s, mname, ast, slots, tyslots, cache, lhs, rhs, true) }
        Or => { return short_circuit(lib, ctx, builder, fref, a, s, mname, ast, slots, tyslots, cache, lhs, rhs, false) }
        ElvisOp => {
            // 切片 3:?? 短路(nullable 专用通道,不走通用操作数路径)。
            return elvis_build(lib, ctx, builder, fref, a, s, mname, ast, slots, tyslots, cache,
                eid, lhs, rhs, expr_ty(a, s, mname, eid)?)
        }
        _ => {}
    }
    val my_ty = expr_ty(a, s, mname, eid)?
    // 切片 3:nullable 相等族任一侧 nullable → 独立分派(null 形判
    // tag/双 nullable tag+payload;不 peel)。
    if op == Ast.Eq || op == Ast.Neq {
        val lh0 = expr_ty(a, s, mname, lhs)?
        val rh0 = expr_ty(a, s, mname, rhs)?
        val lk0 = agg_kind(a, s, lh0)
        val rk0 = agg_kind(a, s, rh0)
        if lk0 == 9 || rk0 == 9 {
            return nullable_eq_dispatch(lib, ctx, builder, fref, a, s, mname, ast, slots, tyslots, cache,
                eid, op, lhs, rhs, lh0, rh0, lk0, rk0)
        }
        // 切片 5/6a:数组/record/多 ctor ADT 深相等(引擎内容相等;
        // 此前静默 ptr 比较 = 引用相等,语义错)。str 在下方 opk==5。
        if (lk0 == 6 || lk0 == 7 || lk0 == 8) && lk0 == rk0 {
            val lv0 = lower_expr(lib, ctx, builder, fref, a, s, mname, ast, slots, tyslots, cache, lhs)?
            if flow_stopped {
                return Ok(0u64)
            }
            val rv0 = lower_expr(lib, ctx, builder, fref, a, s, mname, ast, slots, tyslots, cache, rhs)?
            if flow_stopped {
                return Ok(0u64)
            }
            val eqv = deep_eq(lib, ctx, builder, cache, fref, a, s, lv0, rv0, lh0, rh0)?
            if op == Ast.Eq {
                return Ok(eqv)
            }
            val i1ty = llty_for(lib, ctx, cache, TBool)?
            val tv = Llvm.const_int(lib, i1ty, 1u64, false)?
            return Llvm.build_xor(lib, builder, eqv, tv, tmp())
        }
    }
    // 比较族:操作数统一到 LHS 类型(sema peer 合一),产出 i1;
    // 其余:操作数统一到表达式类型。
    val is_cmp = match op {
        Eq | Neq | Lt | Gt | LtEq | GtEq => true
        _ => false
    }
    val operand_h = if is_cmp { expr_ty(a, s, mname, lhs)? } else { my_ty }
    // 切片 3:nullable 操作数剥壳(镜像引擎 ExprInfer:算术/比较族 peel
    // 到 inner numeric;conv (T?→T) unbox 通道)。
    var op_h = operand_h
    if agg_kind(a, s, op_h) == 9 {
        op_h = Arena.nullable_inner(a, Arena.resolve(a, op_h))
    }
    // 切片 6b 续:嵌套泛型体内非调用表达式(如 ++)的记录型 elem 悬空
    // (inst 重放跳 unify);LHS 型已经 expr_ty 物化——open 时以 LHS
    // 深解析型为操作数基准型。
    if has_open_elem(a, op_h) {
        val lh_m = Arena.resolve(a, expr_ty(a, s, mname, lhs)?)
        if !has_open_elem(a, lh_m) {
            op_h = lh_m
        }
    }
    val operand_raw = Arena.get(a, op_h)
    val lv = lower_expr(lib, ctx, builder, fref, a, s, mname, ast, slots, tyslots, cache, lhs)?
    if flow_stopped {
        return Ok(0u64)
    }
    val lhs_h = expr_ty(a, s, mname, lhs)?
    val lvc = conv_value(lib, ctx, builder, cache, a, s, lv, lhs_h, op_h, tmp())?
    val rv = lower_expr(lib, ctx, builder, fref, a, s, mname, ast, slots, tyslots, cache, rhs)?
    if flow_stopped {
        return Ok(0u64)
    }
    val rhs_h = expr_ty(a, s, mname, rhs)?
    val rvc = conv_value(lib, ctx, builder, cache, a, s,rv, rhs_h, op_h, tmp())?
    val opk = ty_kind(operand_raw)
    // 切片 2:str 相等族:== / != 内联字节循环(引擎 Arc<str> 语义 =
    // 内容相等);RefEq/RefNeq = ptr 比较(引用同一块)。其余 str 操作
    //(拼接/索引/切片/排序)= 响亮报错,后续切片。
    if opk == 5 {
        match op {
            Add => { return str_concat(lib, ctx, builder, cache, fref, lvc, rvc) }
            Eq => { return str_eq_inline(lib, ctx, builder, cache, fref, lvc, rvc) }
            Neq => {
                val eq = str_eq_inline(lib, ctx, builder, cache, fref, lvc, rvc)?
                val i1ty = llty_for(lib, ctx, cache, TBool)?
                val t = Llvm.const_int(lib, i1ty, 1u64, false)?
                return Llvm.build_xor(lib, builder, eq, t, tmp())
            }
            RefEq => { return Llvm.build_icmp(lib, builder, lvc, rvc, 32u32, tmp()) }
            RefNeq => { return Llvm.build_icmp(lib, builder, lvc, rvc, 33u32, tmp()) }
            _ => throw FfiError(Other, "slice 2: unsupported str operator (expr {eid})"),
        }
    }
    match op {
        ConcatList => {
            // 切片 5:数组 ++ 拼接。元素型取 LHS 具体型(++ 表达式的
            // sema 型 elem 可能悬空 TypeVar,后续使用点才约束)。
            if ty_kind(operand_raw) != 6 {
                throw FfiError(Other, "slice 5: '++' on non-array (expr {eid})")
            }
            val elem_h = arr_elem_of(a, lhs_h)
            arr_concat(lib, ctx, builder, cache, fref, a, s, lvc, rvc, elem_h)
        },
        Add => {
            if opk == 1 {
                Llvm.build_fadd(lib, builder, lvc, rvc, tmp())
            } else {
                Llvm.build_add(lib, builder, lvc, rvc, tmp())
            }
        },
        Sub => {
            if opk == 1 {
                Llvm.build_fsub(lib, builder, lvc, rvc, tmp())
            } else {
                Llvm.build_sub(lib, builder, lvc, rvc, tmp())
            }
        },
        Mul => {
            if opk == 1 {
                Llvm.build_fmul(lib, builder, lvc, rvc, tmp())
            } else {
                Llvm.build_mul(lib, builder, lvc, rvc, tmp())
            }
        },
        Div => {
            if opk == 1 {
                Llvm.build_fdiv(lib, builder, lvc, rvc, tmp())
            } else if ty_signed(operand_raw) {
                Llvm.build_sdiv(lib, builder, lvc, rvc, tmp())
            } else {
                Llvm.build_udiv(lib, builder, lvc, rvc, tmp())
            }
        },
        Mod => {
            if opk == 1 {
                Llvm.build_frem(lib, builder, lvc, rvc, tmp())
            } else if ty_signed(operand_raw) {
                Llvm.build_srem(lib, builder, lvc, rvc, tmp())
            } else {
                Llvm.build_urem(lib, builder, lvc, rvc, tmp())
            }
        },
        BitAnd => Llvm.build_and(lib, builder, lvc, rvc, tmp()),
        BitOr => Llvm.build_or(lib, builder, lvc, rvc, tmp()),
        BitXor => Llvm.build_xor(lib, builder, lvc, rvc, tmp()),
        Shl => Llvm.build_shl(lib, builder, lvc, rvc, tmp()),
        Shr => {
            if ty_signed(operand_raw) {
                Llvm.build_ashr(lib, builder, lvc, rvc, tmp())
            } else {
                Llvm.build_lshr(lib, builder, lvc, rvc, tmp())
            }
        },
        And | Or => throw FfiError(Other, "unreachable: short-circuit dispatched before operand lowering"),
        Eq => cmp_build(lib, builder, operand_raw, lvc, rvc, 32u32, 1u32),
        Neq => cmp_build(lib, builder, operand_raw, lvc, rvc, 33u32, 14u32),
        Lt => cmp_build(lib, builder, operand_raw, lvc, rvc, 40u32, 4u32),
        Gt => cmp_build(lib, builder, operand_raw, lvc, rvc, 38u32, 2u32),
        LtEq => cmp_build(lib, builder, operand_raw, lvc, rvc, 41u32, 5u32),
        GtEq => cmp_build(lib, builder, operand_raw, lvc, rvc, 39u32, 3u32),
        _ => throw FfiError(Other, "slice 0: unsupported binary operator (expr {eid})"),
    }
}

// 整型比较谓词按操作数符号族选 S/U 镜像;浮点恒用 O 族(NaN 参与 =
// false,对齐引擎 IEEE754 比较语义)。signed_pred 取 SLT=40/SGT=38/
// SLE=41/SGE=39(带严格方向);无符号族翻 ULT=36/UGT=34/ULE=37/UGE=35。
pub fun cmp_build(lib: Lib, builder: u64, operand_raw: Ty, lvc: u64, rvc: u64,
    signed_pred: u32, float_pred: u32): Throw<u64, FfiError> {
    if ty_kind(operand_raw) == 1 {
        Llvm.build_fcmp(lib, builder, lvc, rvc, float_pred, tmp())
    } else {
        if ty_signed(operand_raw) {
            Llvm.build_icmp(lib, builder, lvc, rvc, signed_pred, tmp())
        } else {
            val upred = if signed_pred == 40u32 {
                36u32
            } else if signed_pred == 38u32 {
                34u32
            } else if signed_pred == 41u32 {
                37u32
            } else if signed_pred == 39u32 {
                35u32
            } else {
                signed_pred
            }
            Llvm.build_icmp(lib, builder, lvc, rvc, upred, tmp())
        }
    }
}

// 条件值 → i1(bool 恒等;整型 icmp ne 0;浮点 fcmp ONE 0)。
pub fun conv_to_bool(lib: Lib, ctx: u64, builder: u64, cache: Map<str, u64>,
    a: TypeArena, v: u64, from_h: u32, name: str): Throw<u64, FfiError> {
    val from = Arena.get(a, from_h)
    val k = ty_kind(from)
    if k == 2 {
        Ok(v)
    } else if k == 0 || k == 3 {
        val zero = Llvm.const_int_str(lib, llty_for(lib, ctx, cache, from)?, "0", 10u8)?
        Llvm.build_icmp(lib, builder, v, zero, 33u32, name)
    } else if k == 1 {
        val zero = Llvm.const_real_str(lib, llty_for(lib, ctx, cache, from)?, "0")?
        Llvm.build_fcmp(lib, builder, v, zero, 6u32, name)
    } else {
        throw FfiError(Other, "slice 0: condition must be bool/int/float")
    }
}

// &&/|| 短路(对齐引擎 Bug#38:lhs && rhs => if lhs { rhs } else { false }):
// 结果槽预存短路值(false/true);cond_br 真值侧求值 RHS 覆写槽,另侧直达
// merge;load 收口。RHS 含控制流的场景随切片 1 语句机械收编。
pub fun short_circuit(lib: Lib, ctx: u64, builder: u64, fref: u64,
    a: TypeArena, s: SemaRes, mname: str, ast: AstArena,
    slots: Map<str, u64>, tyslots: Map<str, u32>, cache: Map<str, u64>,
    lhs: i64, rhs: i64, is_and: bool): Throw<u64, FfiError> {
    val lhs_h = expr_ty(a, s, mname, lhs)?
    val lv = lower_expr(lib, ctx, builder, fref, a, s, mname, ast, slots, tyslots, cache, lhs)?
    if flow_stopped {
        return Ok(0u64)
    }
    val lvc = conv_to_bool(lib, ctx, builder, cache, a, lv, lhs_h, tmp())?
    val bty = llty_for(lib, ctx, cache, TBool)?
    val slot = Llvm.build_alloca(lib, builder, bty, "sc")?
    val short_bits = if is_and { 0u64 } else { 1u64 }
    val short_v = Llvm.const_int(lib, bty, short_bits, false)?
    match Llvm.build_store(lib, builder, short_v, slot) {
        Ok(_) => {}
        Error(e) => throw e
    }
    val rhs_blk = Llvm.append_block(lib, ctx, fref, "sc.rhs")?
    val end_blk = Llvm.append_block(lib, ctx, fref, "sc.end")?
    if is_and {
        Llvm.build_cond_br(lib, builder, lvc, rhs_blk, end_blk)?
    } else {
        Llvm.build_cond_br(lib, builder, lvc, end_blk, rhs_blk)?
    }
    Llvm.position_builder_at_end(lib, builder, rhs_blk)?
    val rhs_h = expr_ty(a, s, mname, rhs)?
    flow_stopped = false
    val rv = lower_expr(lib, ctx, builder, fref, a, s, mname, ast, slots, tyslots, cache, rhs)?
    if !flow_stopped {
        val rvc = conv_to_bool(lib, ctx, builder, cache, a, rv, rhs_h, tmp())?
        match Llvm.build_store(lib, builder, rvc, slot) {
            Ok(_) => {}
            Error(e) => throw e
        }
        Llvm.build_br(lib, builder, end_blk)?
    }
    Llvm.position_builder_at_end(lib, builder, end_blk)?
    flow_stopped = false
    Llvm.build_load(lib, builder, bty, slot, tmp())
}

// ── 语句 lowering(返回 true = 已发出终止指令,调用方停止)────────

pub fun lower_stmt(lib: Lib, ctx: u64, builder: u64, fref: u64,
    a: TypeArena, s: SemaRes, mname: str, ast: AstArena,
    slots: Map<str, u64>, tyslots: Map<str, u32>, cache: Map<str, u64>,
    sid: i64): Throw<bool, FfiError> {
    match ast.stmt(sid).node {
        ValDeclS(name, _, init, _) | VarDeclS(name, _, init, _) => {
            // 切片 6e:初值先 lower(实例调用的返回型 overlay 在其内落
            // 表),后取型 —— init_h/bind_h 才能吃到干净的实例返回。
            val v = lower_expr(lib, ctx, builder, fref, a, s, mname, ast, slots, tyslots, cache, init)?
            if flow_stopped {
                return Ok(true)
            }
            val init_h = expr_ty(a, s, mname, init)?
            // 切片 3:绑定类型 = sema bind_ty(注解优先,键 = module+stmt;
            // 无注解 = 初值类型)。槽位按绑定类型分配;初值 conv 到绑定
            // 类型后入槽(T → T? = Some 包装 box;整型族同走拓窄)。
            var bind_h = Semares.get_local_decl(s, Semares.local_decl_key(mname, sid)) ?? init_h
            if ty_generic_poisoned(a, s, bind_h) {
                bind_h = init_h
            }
            // 切片 6e:void 初值(val x = void调用())——conv 恒等返 0u64
            // 伪句柄,store 会拿 NULL 进 FFI;哑 i8 常量入槽。
            var vc = v
            if ty_kind(Arena.get(a, Arena.resolve(a, bind_h))) == 4 {
                vc = Llvm.const_int(lib, llty_for(lib, ctx, cache, TI8)?, 0u64, false)?
            } else {
                vc = conv_value(lib, ctx, builder, cache, a, s, v, init_h, bind_h, tmp())?
            }
            val slot_ty = llty_for_h(lib, ctx, cache, a, s, bind_h)?
            val slot = Llvm.build_alloca(lib, builder, slot_ty, name)?
            match Llvm.build_store(lib, builder, vc, slot) {
                Ok(_) => {}
                Error(e) => throw e
            }
            slots.set(name, slot)
            tyslots.set(name, bind_h)
            Ok(false)
        },
        AssignS(target, value) => {
            match ast.expr(target).node {
                Ident(name) => {
                    match slots.get(name) {
                        null => {
                            // 切片 6g:模块级 var/val 写(全局槽)。
                            if find_gvar(mname, name) {
                                var gth2 = gvar_tys.get(gv_key)
                                if gth2 == null {
                                    gth2 = if true { expr_ty(a, s, mname, target)? } else { null }
                                    gvar_tys.set(gv_key, gth2 ?? 0u32)
                                }
                                val val_h1 = expr_ty(a, s, mname, value)?
                                val v1 = lower_expr(lib, ctx, builder, fref, a, s, mname, ast, slots, tyslots, cache, value)?
                                if flow_stopped {
                                    return Ok(true)
                                }
                                val vc1 = conv_value(lib, ctx, builder, cache, a, s, v1, val_h1, gth2 ?? val_h1, tmp())?
                                Llvm.build_store(lib, builder, vc1, gv_ptr)?
                                return Ok(false)
                            }
                            // 切片 6e:方法体内隐式 this 字段写(buf = ...;
                            // 镜像读路径的写侧——slots miss + this 为
                            // record 且具此字段 → this 槽装载后字段位
                            // store)。
                            var wrote = false
                            if cur_this_h != 0 {
                                val fdecl_h = Arena.resolve(a, cur_this_h)
                                if agg_kind(a, s, fdecl_h) == 7 {
                                    val frn = record_name_of(a, fdecl_h) ?? "?"
                                    if Semares.record_field_idx(s, frn, name) >= 0 {
                                        val pt0 = llty_for_h(lib, ctx, cache, a, s, fdecl_h)
                                        match pt0 {
                                            Ok(ptv) => {
                                                val thisv = Llvm.build_load(lib, builder, ptv, cur_this_slot, "tfv")
                                                match thisv {
                                                    Ok(tv) => {
                                                        match rec_field_place(lib, ctx, builder, cache, a, s,
                                                            tv, fdecl_h, name, sid) {
                                                            Ok(_) => {
                                                                val val_h0 = expr_ty(a, s, mname, value)?
                                                                val v0 = lower_expr(lib, ctx, builder, fref, a, s, mname, ast, slots, tyslots, cache, value)?
                                                                if flow_stopped {
                                                                    return Ok(true)
                                                                }
                                                                val vc0 = conv_value(lib, ctx, builder, cache, a, s, v0, val_h0, place_ty, tmp())?
                                                                Llvm.build_store(lib, builder, vc0, place_ptr)?
                                                                wrote = true
                                                            },
                                                            Error(e) => throw e,
                                                        }
                                                    },
                                                    Error(e) => throw e,
                                                }
                                            },
                                            Error(e) => throw e,
                                        }
                                    }
                                }
                            }
                            if !wrote {
                                throw FfiError(Other, "slice 0: assignment to non-local '{name}'")
                            }
                            Ok(false)
                        },
                        slot => {
                            val val_h = expr_ty(a, s, mname, value)?
                            val v = lower_expr(lib, ctx, builder, fref, a, s, mname, ast, slots, tyslots, cache, value)?
                            if flow_stopped {
                                return Ok(true)
                            }
                            val slot_h = tyslots.get(name) ?? val_h
                            val vc = conv_value(lib, ctx, builder, cache, a, s,v, val_h, slot_h, tmp())?
                            match Llvm.build_store(lib, builder, vc, slot ?? 0) {
                                Ok(_) => {}
                                Error(e) => throw e
                            }
                            Ok(false)
                        },
                    }
                },
                _ => {
                    // 切片 2:place 赋值(IndexE/FieldAccessE 深链写)。
                    lower_place(lib, ctx, builder, fref, a, s, mname, ast, slots, tyslots, cache, target)?
                    if flow_stopped {
                        return Ok(true)
                    }
                    val addr = place_ptr
                    val ty_h = place_ty
                    val val_h = expr_ty(a, s, mname, value)?
                    val v = lower_expr(lib, ctx, builder, fref, a, s, mname, ast, slots, tyslots, cache, value)?
                    if flow_stopped {
                        return Ok(true)
                    }
                    val vc = conv_value(lib, ctx, builder, cache, a, s, v, val_h, ty_h, tmp())?
                    Llvm.build_store(lib, builder, vc, addr)?
                    Ok(false)
                },
            }
        },
        FieldAssignS(object, field, value) => {
            // 切片 2:record 字段写(object 任意表达式 → record ptr →
            // 字段地址 store)。place 出参即读即拷。
            val obj_h = expr_ty(a, s, mname, object)?
            if agg_kind(a, s, obj_h) != 7 {
                throw FfiError(Other, "slice 2: field write on non-record (stmt {sid})")
            }
            val rec_ptr = lower_expr(lib, ctx, builder, fref, a, s, mname, ast, slots, tyslots, cache, object)?
            if flow_stopped {
                return Ok(true)
            }
            rec_field_place(lib, ctx, builder, cache, a, s, rec_ptr, obj_h, field, sid)?
            val addr = place_ptr
            val ty_h = place_ty
            val val_h = expr_ty(a, s, mname, value)?
            val v = lower_expr(lib, ctx, builder, fref, a, s, mname, ast, slots, tyslots, cache, value)?
            if flow_stopped {
                return Ok(true)
            }
            val vc = conv_value(lib, ctx, builder, cache, a, s, v, val_h, ty_h, tmp())?
            Llvm.build_store(lib, builder, vc, addr)?
            Ok(false)
        },
        CompAssignS(target, op, value) => {
            // 切片 2:复合赋值(place 定位 → load-op-store)。
            match lower_comp_place(lib, ctx, builder, fref, a, s, mname, ast, slots, tyslots, cache,
                sid, op, target, value) {
                Ok(_) => {}
                Error(e) => throw e
            }
            Ok(false)
        },
        ExprS(e) => {
            match lower_expr(lib, ctx, builder, fref, a, s, mname, ast, slots, tyslots, cache, e) {
                Ok(_) => {}
                Error(err) => throw err
            }
            Ok(false)
        },
        ThrowS(ve) => {
            // 切片 4:throw 两态值直落——载荷 conv 到当前函数 Throw 的
            // E 部,box tag=1,ret 早退(仅当前函数;调用方按数据消费)。
            val cr = Arena.resolve(a, cur_ret_h)
            match Arena.get(a, cr) {
                TThrow(_) => {}
                _ => throw FfiError(Other, "slice 4: throw outside a Throw-returning function (stmt {sid})"),
            }
            val ep = Arena.thr_parts(a, cr).b
            val v = lower_expr(lib, ctx, builder, fref, a, s, mname, ast, slots, tyslots, cache, ve)?
            if !flow_stopped {
                val v_h = expr_ty(a, s, mname, ve)?
                val vc = conv_value(lib, ctx, builder, cache, a, s, v, v_h, ep, tmp())?
                val boxed = throw_box_val(lib, ctx, builder, cache, a, s, vc, ep, true)?
                emit_pending_defers(lib, ctx, builder, fref, a, s, mname, ast, slots, tyslots, cache)?
                Llvm.build_ret(lib, builder, boxed)?
            }
            flow_stopped = true
            Ok(true)
        },
        DeferS(body) => {
            // 切片 5:注册进函数级链(载荷 = 表达式);出口统一 LIFO 发射。
            defer_bodies.push(body)
            Ok(false)
        },
        ReturnS(opt) => {
            if cur_is_main {
                // C main 惯例:整型返回值 → 进程退出码;void/缺省 → 0。
                match opt {
                    null => {
                        val i32ty = llty_for(lib, ctx, cache, TI32)?
                        val z = Llvm.const_int_str(lib, i32ty, "0", 10u8)?
                        emit_pending_defers(lib, ctx, builder, fref, a, s, mname, ast, slots, tyslots, cache)?
                        match Llvm.build_ret(lib, builder, z) {
                            Ok(_) => {}
                            Error(e) => throw e
                        }
                    },
                    ve => {
                        val v = lower_expr(lib, ctx, builder, fref, a, s, mname, ast, slots, tyslots, cache, ve ?? 0)?
                        if !flow_stopped {
                            val v_h = expr_ty(a, s, mname, ve ?? 0)?
                            // 切片 6g:async void main 的带值 return(void/
                            // Throw 尾族)→ ret 0。
                            if main_tail_nonint(a, v_h) {
                                emit_pending_defers(lib, ctx, builder, fref, a, s, mname, ast, slots, tyslots, cache)?
                                match Llvm.build_ret(lib, builder, Llvm.const_int_str(lib,
                                    llty_for(lib, ctx, cache, TI32)?, "0", 10u8)?) {
                                    Ok(_) => {}
                                    Error(e) => throw e
                                }
                            } else {
                                val vc = conv_to_i32(lib, ctx, builder, cache, a, v, v_h, tmp())?
                                emit_pending_defers(lib, ctx, builder, fref, a, s, mname, ast, slots, tyslots, cache)?
                                match Llvm.build_ret(lib, builder, vc) {
                                    Ok(_) => {}
                                    Error(e) => throw e
                                }
                            }
                        }
                    },
                }
            } else {
                match opt {
                    null => {
                        emit_pending_defers(lib, ctx, builder, fref, a, s, mname, ast, slots, tyslots, cache)?
                        Llvm.build_ret_void(lib, builder)?
                    }
                    ve => {
                        val v = lower_expr(lib, ctx, builder, fref, a, s, mname, ast, slots, tyslots, cache, ve ?? 0)?
                        if !flow_stopped {
                            val v_h = expr_ty(a, s, mname, ve ?? 0)?
                            val vc = conv_value(lib, ctx, builder, cache, a, s,v, v_h, cur_ret_h, tmp())?
                            emit_pending_defers(lib, ctx, builder, fref, a, s, mname, ast, slots, tyslots, cache)?
                            match Llvm.build_ret(lib, builder, vc) {
                                Ok(_) => {}
                                Error(e) => throw e
                            }
                        }
                    },
                }
            }
            flow_stopped = true
            Ok(true)
        },
        WhileS(cond, body) => {
            val cond_blk = Llvm.append_block(lib, ctx, fref, "while.cond")?
            Llvm.build_br(lib, builder, cond_blk)?
            Llvm.position_builder_at_end(lib, builder, cond_blk)?
            flow_stopped = false
            val cv = lower_expr(lib, ctx, builder, fref, a, s, mname, ast, slots, tyslots, cache, cond)?
            if flow_stopped {
                return Ok(true)
            }
            val cond_h = expr_ty(a, s, mname, cond)?
            val cvb = conv_to_bool(lib, ctx, builder, cache, a, cv, cond_h, tmp())?
            val body_blk = Llvm.append_block(lib, ctx, fref, "while.body")?
            val end_blk = Llvm.append_block(lib, ctx, fref, "while.end")?
            Llvm.build_cond_br(lib, builder, cvb, body_blk, end_blk)?
            Llvm.position_builder_at_end(lib, builder, body_blk)?
            loop_breaks.push(end_blk)
            loop_conts.push(cond_blk)
            flow_stopped = false
            match lower_expr(lib, ctx, builder, fref, a, s, mname, ast, slots, tyslots, cache, body) {
                Ok(_) => {}
                Error(e) => throw e
            }
            if !flow_stopped {
                Llvm.build_br(lib, builder, cond_blk)?
            }
            loop_breaks.pop()
            loop_conts.pop()
            flow_stopped = false
            Llvm.position_builder_at_end(lib, builder, end_blk)?
            Ok(false)
        },
        LoopS(body) => {
            val body_blk = Llvm.append_block(lib, ctx, fref, "loop.body")?
            val end_blk = Llvm.append_block(lib, ctx, fref, "loop.end")?
            Llvm.build_br(lib, builder, body_blk)?
            Llvm.position_builder_at_end(lib, builder, body_blk)?
            loop_breaks.push(end_blk)
            loop_conts.push(body_blk)
            flow_stopped = false
            match lower_expr(lib, ctx, builder, fref, a, s, mname, ast, slots, tyslots, cache, body) {
                Ok(_) => {}
                Error(e) => throw e
            }
            if !flow_stopped {
                Llvm.build_br(lib, builder, body_blk)?
            }
            loop_breaks.pop()
            loop_conts.pop()
            flow_stopped = false
            Llvm.position_builder_at_end(lib, builder, end_blk)?
            Ok(false)
        },
        BreakS => {
            if loop_breaks.len() == 0 {
                throw FfiError(Other, "slice 1: break outside loop (stmt {sid})")
            }
            val tgt = loop_breaks.get(loop_breaks.len() - 1) ?? 0
            Llvm.build_br(lib, builder, tgt)?
            flow_stopped = true
            Ok(true)
        },
        ContinueS => {
            if loop_conts.len() == 0 {
                throw FfiError(Other, "slice 1: continue outside loop (stmt {sid})")
            }
            val tgt = loop_conts.get(loop_conts.len() - 1) ?? 0
            Llvm.build_br(lib, builder, tgt)?
            flow_stopped = true
            Ok(true)
        },
        _ => throw FfiError(Other, "slice 1: unsupported statement form (stmt {sid} in module '{mname}')"),
    }
}

// main 返回值 → i32 ABI(int 族窄化/零拓;float = 报错)。
pub fun conv_to_i32(lib: Lib, ctx: u64, builder: u64, cache: Map<str, u64>,
    a: TypeArena, v: u64, from_h: u32, name: str): Throw<u64, FfiError> {
    val from = Arena.get(a, from_h)
    val k4 = ty_kind(from)
    if k4 == 0 || k4 == 3 || k4 == 2 {
        if ty_bits(from) == 32 {
            return Ok(v)
        }
        val i32ty = llty_for(lib, ctx, cache, TI32)?
        if ty_bits(from) < 32 {
            Llvm.build_zext(lib, builder, v, i32ty, name)
        } else {
            Llvm.build_trunc(lib, builder, v, i32ty, name)
        }
    } else {
        throw FfiError(Other, "slice 0: main must return an integer type (exit code) or void")
    }
}

// ── 入口编译:sema 产物 → .obj ─────────────────────────────────────

// 非 main 函数的符号名(CRT/llvm.* 碰撞隔离;模块限定随跨模块切片)。
// main 尾值族判定:void / Throw(async void main 的尾/return 族)。
fun main_tail_nonint(a: TypeArena, h: u32): bool {
    val raw = Arena.get(a, Arena.resolve(a, h))
    if ty_kind(raw) == 4 {
        return true
    }
    match raw {
        TThrow(_) => { true }
        _ => { false }
    }
}

fun mangle(name: str): str {
    if name == "main" {
        return "main"
    }
    "frond_" + name
}

// ── 切片 6a:跨模块 ────────────────────────────────────────────────

// 模块的签名查询 env(方案 B:用户模块函数住模块专属 env;兜底 root)。
fun env_of_module(s: SemaRes, mod_name: str, root_env: u32): u32 {
    match Semares.module_logical_path(mod_name) {
        null => root_env
        el => {
            match s.module_envs.get(el ?? "") {
                null => root_env
                me => me ?? root_env
            }
        }
    }
}

// 跨模块函数的 LLVM 名(入口模块保持旧 mangle 保 ABI;依赖模块
// frond_u_<逻辑路径清洗>_<名>;清洗 '/'/'.'→'_')。
fun mangled_mod_fn(entry_name: str, mod_name: str, fname: str): str {
    if mod_name == entry_name {
        return mangle(fname)
    }
    var mp = mod_name
    if Str.ends_with(mp, ".frond") {
        mp = Str.substring(mp, 0, mp.len() - (6 as usize))
    }
    mp = Str.replace(mp, "/", "_")
    mp = Str.replace(mp, ".", "_")
    "frond_u_" + mp + "_" + fname
}

// 函数表键(模块隔离:同名函数跨模块不撞)。
fun fn_key(mod_name: str, fname: str): str {
    mod_name + "\u{0}" + fname
}

// 裸名的跨模块解析:func_sig_owners 的 USER 拥有者(std/builtin 前缀
// 排除;当前模块本地已在调用点先行命中)。多主 = 放弃(响亮报错由
// 调用点负责)。
fun resolve_cross_module(s: SemaRes, cur_mod: str, name: str): str? {
    match s.func_sig_owners.get(name) {
        null => null
        csv => {
            // 切片 6g:std/builtin 放行(已进收集面;sema 的全局唯一
            // 裸名契约 —— 多主仍弃;func_sig_owners 键形 = 逻辑点分,
            // fn_index 行键 = 路径形,点斜互换 + .frond)。
            val parts = Str.split(csv ?? "", ",")
            var found: str? = null
            var hits: i64 = 0
            var i: usize = 0
            while i < parts.len() {
                var own = parts[i]
                if own != cur_mod {
                    if Str.starts_with(own, "std.") || Str.starts_with(own, "builtin.") {
                        own = Str.replace(own, ".", "/") + ".frond"
                    }
                    found = if true { own } else { null }
                    hits = hits + 1
                }
                i = i + 1
            }
            if hits == 1 {
                found
            } else {
                null
            }
        }
    }
}

// 原型注册:env 里的 fn 类型(lookup_local:入口模块 fun 定义在 root_env
// 本层,不误取 std/内建)→ LLVM 函数;main 强制 i32() ABI。
fun register_fn(lib: Lib, ctx: u64, module: u64, a: TypeArena, s: SemaRes,
    lookup_env: u32, cache: Map<str, u64>, name: str, is_main: bool,
    llvm_name: str): Throw<void, FfiError> {
    var fnty = 0u64
    var ret_h = 0u32
    var ph: u32[] = []
    if is_main {
        val i32ty = Llvm.int_type(lib, ctx, 32u32)?
        cache.set("i32", i32ty)
        // Stage 3 前哨(6g):main(argc, argv) ABI —— argv 经全局通道
        // 供 __os_arg_count/__os_arg_get_into(Proc.args)。
        val ptrty = opaque_ptr(lib, ctx, cache)?
        fnty = Llvm.function_type(lib, i32ty, [i32ty, ptrty], false)?
    } else {
        match Envs.lookup_local(s.env, lookup_env, name) {
            null => throw FfiError(Other, "slice 1: no env type for fun '{name}'")
            fh => {
                val parts = Arena.fn_parts(a, Arena.resolve(a, fh ?? 0))
                ph = parts.ps
                ret_h = parts.ret
                // 切片 4:async 直通:声明 Async<T> → 按内型 T 注册
                // (LLVM 返回型与 fn_rets 均存 T;体尾 conv 目标即 T)。
                val rr0 = Arena.resolve(a, ret_h)
                match Arena.get(a, rr0) {
                    TAsync(_) => { ret_h = Arena.async_value(a, rr0) }
                    _ => {}
                }
                var ptys: u64[] = []
                var j: usize = 0
                while j < ph.len() {
                    ptys = ptys ++ [llty_for_h(lib, ctx, cache, a, s,ph[j])?]
                    j = j + 1
                }
                val ret_res = Arena.resolve(a, ret_h)
                val ret_llvm = if ty_kind(Arena.get(a, ret_res)) == 4 {
                    Llvm.void_type(lib, ctx)?
                } else {
                    llty_for_h(lib, ctx, cache, a, s,ret_res)?
                }
                if ptys.len() == 0 {
                    fnty = Llvm.function_type0(lib, ret_llvm, false)?
                } else {
                    fnty = Llvm.function_type(lib, ret_llvm, ptys, false)?
                }
            },
        }
    }
    val fref = Llvm.add_function(lib, module, llvm_name, fnty)?
    fn_names.push(name)
    fn_llvm.push(fref)
    fn_lty.push(fnty)
    fn_params.push(ph)
    fn_rets.push(ret_h)
    fn_index.set(fn_key(cur_fn_mod, name), fn_names.len() as i64 - 1)
    Ok(void)
}

// 切片 6b:实例参数类型解析——type_params 按名位置映射到 type_args
// (Mono.return_type 对直接类型参数是未解占位 Adt("T"),镜像 dump 自
// 留口径,Back 不可用);非参数名回落 resolve_tn_flat(空实参,标量/
// 具名聚合面);T[]/T? 递归。TGeneric(泛型聚合实参)= 6d 面。
fun inst_param_ty(a: TypeArena, s: SemaRes, ast: AstArena, tn: i64?,
    tps: str[], type_args: u32[]): u32 {
    match tn {
        null => { return Arena.fresh_type_var(a) }
        t0 => {
            val t = t0 ?? 0
            match ast.ty(t).node {
                TNamed(name) => {
                    var k: usize = 0
                    while k < tps.len() {
                        if tps[k] == name && k < type_args.len() {
                            return type_args[k]
                        }
                        k = k + 1
                    }
                    match Mono.resolve_tn_flat(a, s, t, [], ast) {
                        null => Arena.fresh_type_var(a)
                        h => h ?? 0
                    }
                },
                TArray(elem, _) => {
                    val eh = inst_param_ty(a, s, ast, elem, tps, type_args)
                    Arena.make_array(a, eh, null)
                },
                TGeneric(gname, gargs) => {
                    // 实参递归代换先行(多参通用)。
                    var ghs: u32[] = []
                    var gi: usize = 0
                    while gi < gargs.len() {
                        ghs = ghs ++ [inst_param_ty(a, s, ast, gargs[gi], tps, type_args)]
                        gi = gi + 1
                    }
                    // 内建泛型族 = 专属结构变体(镜像 concretize_type 口径,
                    // 实参必须真实携带——签名身份才对)。
                    if gname == "Throw" && ghs.len() == 2 {
                        return Arena.make_throw(a, ghs[0], ghs[1])
                    }
                    if gname == "Channel" && ghs.len() == 1 {
                        return Arena.make_channel(a, ghs[0])
                    }
                    if gname == "Async" && ghs.len() == 1 {
                        return Arena.make_async(a, ghs[0])
                    }
                    if gname == "Lazy" && ghs.len() == 1 {
                        return Arena.make_lazy(a, ghs[0])
                    }
                    if gname == "Atomic" && ghs.len() == 1 {
                        return Arena.make_atomic(a, ghs[0])
                    }
                    if gname == "Sender" && ghs.len() == 1 {
                        return Arena.make_sender(a, ghs[0])
                    }
                    if gname == "Receiver" && ghs.len() == 1 {
                        return Arena.make_receiver(a, ghs[0])
                    }
                    if gname == "ForeignFn" && ghs.len() == 1 {
                        return Arena.make_foreign_fn(a, ghs[0])
                    }
                    // 用户泛型聚合(List<T>/Map<K,V> 族):canonical 名 +
                    // 代换实参 → TAdt 实例(镜像 Typeast 用户泛型 ADT 口径)。
                    val gcanon = Semares.resolve_type_key(s, gname)
                    match Semares.get_type_def(s, gcanon) {
                        null => {}
                        gd => {
                            if (gd ?? Data.TDef("", Data.TAlias, [], [], null, null, [], [])).type_params.len() > 0 {
                                return Arena.make_adt(a, gcanon, ghs)
                            }
                        },
                    }
                    match Mono.resolve_tn_flat(a, s, t, [], ast) {
                        null => Arena.fresh_type_var(a)
                        h => h ?? 0
                    }
                },
                TNullable(inner) => {
                    val ih = inst_param_ty(a, s, ast, inner, tps, type_args)
                    Arena.make_nullable(a, ih)
                },
                _ => {
                    match Mono.resolve_tn_flat(a, s, t, [], ast) {
                        null => Arena.fresh_type_var(a)
                        h => h ?? 0
                    }
                },
            }
        },
    }
}

// 切片 6e:实例实参归一 —— sema 的 type_args/接收者 TAdt 实参里嵌套
// 泛型聚合是 arena TGeneric 句柄(Typeast 回落路径;TAdt 实参面只在
// 推断主径),签名代换/布局键/字段代换统一消费 TAdt——先归一:
// 用户泛型 → TAdt(canonical, 归一实参);内建泛型 → 结构变体;
// 其余原样。
fun sanitize_arg(a: TypeArena, s: SemaRes, h: u32): u32 {
    val r = Arena.resolve(a, h)
    match Arena.get(a, r) {
        TGeneric(_) => {
            val p = Arena.generic_parts(a, r)
            var ghs: u32[] = []
            var i: usize = 0
            while i < p.b.len() {
                ghs = ghs ++ [sanitize_arg(a, s, p.b[i])]
                i = i + 1
            }
            if p.a == "Throw" && ghs.len() == 2 {
                return Arena.make_throw(a, ghs[0], ghs[1])
            }
            if p.a == "Async" && ghs.len() == 1 {
                return Arena.make_async(a, ghs[0])
            }
            if p.a == "Lazy" && ghs.len() == 1 {
                return Arena.make_lazy(a, ghs[0])
            }
            val gcanon = Semares.resolve_type_key(s, p.a)
            match Semares.get_type_def(s, gcanon) {
                null => {}
                d0 => {
                    if (d0 ?? Data.TDef("", Data.TAlias, [], [], null, null, [], [])).type_params.len() > 0 {
                        return Arena.make_adt(a, gcanon, ghs)
                    }
                },
            }
            r
        },
        TAdt(_) => {
            // 实参位嵌套归一(List<TGeneric> → List<TAdt>)。
            val p2 = Arena.adt_parts(a, r)
            if p2.b.len() == 0 {
                return r
            }
            var na: u32[] = []
            var j: usize = 0
            while j < p2.b.len() {
                na = na ++ [sanitize_arg(a, s, p2.b[j])]
                j = j + 1
            }
            Arena.make_adt(a, p2.a, na)
        },
        TArray(_) => {
            Arena.make_array(a, sanitize_arg(a, s, (Arena.array_parts(a, r)).a), null)
        },
        TNullable(_) => {
            Arena.make_nullable(a, sanitize_arg(a, s, Arena.nullable_inner(a, r)))
        },
        _ => r,
    }
}

// 切片 6e:实例实参可解性门 —— check 期为泛型体内嵌套调用创建的
// 自引用实例(实参 = 未解类型参 K/V,Adt 无 TDef 或开放 var)在
// native 不可布局;重放产出的具体实例接管调用点,幻影实例不注册。
fun args_resolvable(a: TypeArena, s: SemaRes, args: u32[]): bool {
    var i: usize = 0
    while i < args.len() {
        // 先归一(sanitize):嵌套泛型聚合的 TGeneric 句柄可归一为 TAdt,
        // 归一后再判形(误杀 = 调用点找不到实例行)。
        val r = Arena.resolve(a, sanitize_arg(a, s, args[i]))
        match Arena.get(a, r) {
            TTypeVar(_) | TUnknown | TVoid | TGeneric(_) => { return false }
            TAdt(_) => {
                val p2 = Arena.adt_parts(a, r)
                if p2.b.len() > 0 {
                    if !args_resolvable(a, s, p2.b) {
                        return false
                    }
                } else {
                    val nm = p2.a
                    if Semares.get_type_def(s, nm) == null && nm != "This" {
                        return false
                    }
                }
            },
            TArray(_) => {
                if !args_resolvable(a, s, [(Arena.array_parts(a, r)).a]) {
                    return false
                }
            },
            TNullable(_) => {
                if !args_resolvable(a, s, [Arena.nullable_inner(a, r)]) {
                    return false
                }
            },
            _ => {},
        }
        i = i + 1
    }
    true
}

// 切片 6b:泛型实例注册——专用签名(参数类型 = 声明类型 AST 经
// resolve_tn_flat + type_args 代换;返回 = Mono.return_type,Async 剥
// 壳同 register_fn);LLVM 名 frond_g<id>_<fn>(实例唯一)。行标记
// replay = true(发射前逐实例重放类型)。
fun register_instance_fn(lib: Lib, ctx: u64, module: u64, a: TypeArena, s: SemaRes,
    cache: Map<str, u64>, tables: Mono.FTabs, inst: Data.Mono): Throw<void, FfiError> {
    val key = "{inst.module_name}\u{0}{inst.func_name}"
    match tables.decls.get(key) {
        null => throw FfiError(Other, "slice 6: no declaration for instance '{inst.func_name}' in '{inst.module_name}'")
        sd0 => {
            val sd = sd0 ?? Mono.m_decls_dummy()
            match sd.decl {
                FunDeclD(_, _, tps, ps, irt, _, _, _, _, _) => {
                    // 切片 6e:签名解析置声明模块上下文(裸名 List/
                    // MapEntry 的 canonical 解析与 check 期同径;收尾
                    // 复位 —— 镜像 Mono 重放的同款保存/恢复)。
                    val saved_cmod = s.current_module_name
                    s.current_module_name = inst.module_name
                    var itps: str[] = []
                    var tk: usize = 0
                    while tk < tps.len() {
                        itps = itps ++ [tps[tk].name]
                        tk = tk + 1
                    }
                    var ph: u32[] = []
                    var ret_h = inst.return_type
                    match tables.arenas.get(key) {
                        null => {}
                        ast0 => {
                            val astv = ast0 ?? Arena.new_arena()
                            var sargs: u32[] = []
                            var si: usize = 0
                            while si < inst.type_args.len() {
                                sargs = sargs ++ [sanitize_arg(a, s, inst.type_args[si])]
                                si = si + 1
                            }
                            var pi: usize = 0
                            while pi < ps.len() {
                                ph = ph ++ [inst_param_ty(a, s, astv, ps[pi].ta, itps, sargs)]
                                pi = pi + 1
                            }
                            // 返回类型同径解析(Mono.return_type 对直接
                            // 类型参数是未解占位 Adt,不可用)。
                            ret_h = inst_param_ty(a, s, astv, irt, itps, sargs)
                        },
                    }
                    val rr0 = Arena.resolve(a, ret_h)
                    match Arena.get(a, rr0) {
                        TAsync(_) => { ret_h = Arena.async_value(a, rr0) }
                        _ => {}
                    }
                    var ptys: u64[] = []
                    var j: usize = 0
                    while j < ph.len() {
                        ptys = ptys ++ [llty_for_h(lib, ctx, cache, a, s, ph[j])?]
                        j = j + 1
                    }
                    val ret_res = Arena.resolve(a, ret_h)
                    val ret_llvm = if ty_kind(Arena.get(a, ret_res)) == 4 {
                        Llvm.void_type(lib, ctx)?
                    } else {
                        llty_for_h(lib, ctx, cache, a, s, ret_res)?
                    }
                    val fnty = if ptys.len() == 0 {
                        Llvm.function_type0(lib, ret_llvm, false)?
                    } else {
                        Llvm.function_type(lib, ret_llvm, ptys, false)?
                    }
                    val fref = Llvm.add_function(lib, module,
                        "frond_g{inst.instance_id}_{inst.func_name}", fnty)?
                    // 仅 LLVM 五列;ast_params/bodies/mods/asts/
                    // replays/inst_ids 由收集循环统一 push(行对齐)。
                    fn_names.push(inst.func_name)
                    fn_llvm.push(fref)
                    fn_lty.push(fnty)
                    fn_params.push(ph)
                    fn_rets.push(ret_h)
                    inst_rows.set("{inst.instance_id}", fn_names.len() as i64 - 1)
                    s.current_module_name = saved_cmod
                },
                _ => throw FfiError(Other, "slice 6: instance decl is not a function"),
            }
        },
    }
    Ok(void)
}

// ── 切片 6g:std 尺寸族常量 C builtin 桩(Usize/Isize 的 MAX/MIN
// 模块 val init 依赖;LLP64:x64 usize/isize = i64 域)─────────────
fun emit_rt_size_consts(lib: Lib, ctx: u64, module: u64, cache: Map<str, u64>,
    a: TypeArena): Throw<void, FfiError> {
    val i64ty = llty_for(lib, ctx, cache, TI64)?
    val specs: str[] = [
        "__os_usize_max", "18446744073709551615",
        "__os_isize_max", "9223372036854775807",
        "__os_isize_min", "-9223372036854775808",
        "__os_usize_min", "0",
    ]
    var i: usize = 0
    while i < specs.len() {
        val nm = specs[i]
        val txt = specs[i + 1]
        if extern_llvm.get(nm) == null {
            val ft = Llvm.function_type0(lib, i64ty, false)?
            val fh = Llvm.add_function(lib, module, nm, ft)?
            Llvm.set_linkage_private(lib, fh)?
            val b = Llvm.create_builder(lib, ctx)?
            val blk = Llvm.append_block(lib, ctx, fh, "entry")?
            Llvm.position_builder_at_end(lib, b, blk)?
            Llvm.build_ret(lib, b, Llvm.const_int_str(lib, i64ty, txt, 10u8)?)?
            Llvm.dispose_builder(lib, b)
            extern_llvm.set(nm, fh)
            extern_fts.set(nm, ft)
            extern_voids.set(nm, false)
            extern_params.set(nm, [])
        }
        i = i + 2
    }
    Ok(void)
}

// ── Stage 3 前哨(6g):命令行 rt(argv 通道)──────────────────────
// 发射 main(i32 argc, ptr argv) ABI;入口把 argc/argv 存入私有全局;
// __os_arg_count = argc-1(引擎口径:不含程序名);__os_arg_get_into
// 按 builtin/os/Raw 合同(越界 -1 / 超 buf 容量 -2 / 拷贝 n 返回 n;
// buf = u8[] 块,数据@16)。
var rt_argc_g: u64 = 0
var rt_argv_g: u64 = 0

fun emit_rt_args(lib: Lib, ctx: u64, module: u64, cache: Map<str, u64>,
    a: TypeArena): Throw<void, FfiError> {
    if rt_argc_g != 0 {
        return Ok(void)
    }
    val ptrty = opaque_ptr(lib, ctx, cache)?
    val i32ty = llty_for(lib, ctx, cache, TI32)?
    val i64ty = llty_for(lib, ctx, cache, TI64)?
    val i8ty = llty_for(lib, ctx, cache, TI8)?
    rt_argc_g = Llvm.add_global(lib, module, i32ty, "frond_rt_argc")?
    Llvm.set_linkage_private(lib, rt_argc_g)?
    Llvm.set_initializer(lib, rt_argc_g, Llvm.const_int(lib, i32ty, 0u64, false)?)?
    rt_argv_g = Llvm.add_global(lib, module, ptrty, "frond_rt_argv")?
    Llvm.set_linkage_private(lib, rt_argv_g)?
    Llvm.set_initializer(lib, rt_argv_g, Llvm.const_null(lib, ptrty)?)?
    // __os_arg_count(): i32 = max(argc - 1, 0)。
    val cnt_ft = Llvm.function_type0(lib, i32ty, false)?
    val cnt_fn = Llvm.add_function(lib, module, "__os_arg_count", cnt_ft)?
    Llvm.set_linkage_private(lib, cnt_fn)?
    {
        val builder = Llvm.create_builder(lib, ctx)?
        val blk = Llvm.append_block(lib, ctx, cnt_fn, "entry")?
        Llvm.position_builder_at_end(lib, builder, blk)?
        val ac = Llvm.build_load(lib, builder, i32ty, rt_argc_g, "ac")?
        val one = Llvm.const_int(lib, i32ty, 1u64, false)?
        val zero = Llvm.const_int(lib, i32ty, 0u64, false)?
        val dec = Llvm.build_sub(lib, builder, ac, one, "dec")?
        val neg = Llvm.build_icmp(lib, builder, dec, zero, 40u32, "neg")?
        val clamped = Llvm.build_select(lib, builder, neg, zero, dec, "n")?
        Llvm.build_ret(lib, builder, clamped)?
        Llvm.dispose_builder(lib, builder)
    }
    extern_llvm.set("__os_arg_count", cnt_fn)
    extern_fts.set("__os_arg_count", cnt_ft)
    extern_voids.set("__os_arg_count", false)
    // __os_arg_get_into(i: i32, buf: ptr) -> i64。
    val get_ft = Llvm.function_type(lib, i64ty, [i32ty, ptrty], false)?
    val get_fn = Llvm.add_function(lib, module, "__os_arg_get_into", get_ft)?
    Llvm.set_linkage_private(lib, get_fn)?
    {
        val builder = Llvm.create_builder(lib, ctx)?
        val fref = get_fn
        val entry_blk = Llvm.append_block(lib, ctx, fref, "entry")?
        Llvm.position_builder_at_end(lib, builder, entry_blk)?
        val iv = Llvm.get_param(lib, fref, 0u32)?
        val buf = Llvm.get_param(lib, fref, 1u32)?
        val zero32 = Llvm.const_int(lib, i32ty, 0u64, false)?
        val one32 = Llvm.const_int(lib, i32ty, 1u64, false)?
        val one64 = Llvm.const_int(lib, i64ty, 1u64, false)?
        val c8 = Llvm.const_int(lib, i64ty, 8u64, false)?
        val c16 = Llvm.const_int(lib, i64ty, 16u64, false)?
        val m1 = Llvm.const_int(lib, i64ty, 18446744073709551615u64, true)?
        val m2 = Llvm.const_int(lib, i64ty, 18446744073709551614u64, true)?
        // 越界:i < 0 || i >= argc-1 → -1。
        val ac32 = Llvm.build_load(lib, builder, i32ty, rt_argc_g, "ac")?
        val fwd = Llvm.build_sub(lib, builder, ac32, one32, "fwd")?
        val iv64 = Llvm.build_sext(lib, builder, iv, i64ty, "iv64")?
        val fwd64 = Llvm.build_sext(lib, builder, fwd, i64ty, "fwd64")?
        val zero64 = Llvm.const_int(lib, i64ty, 0u64, false)?
        val lt0 = Llvm.build_icmp(lib, builder, iv64, zero64, 40u32, "lt0")?
        val geN = Llvm.build_icmp(lib, builder, iv64, fwd64, 39u32, "geN")?
        val oob = Llvm.build_or(lib, builder, lt0, geN, "oob")?
        val oob_blk = Llvm.append_block(lib, ctx, fref, "oob")?
        val ok_blk = Llvm.append_block(lib, ctx, fref, "ok")?
        Llvm.build_cond_br(lib, builder, oob, oob_blk, ok_blk)?
        Llvm.position_builder_at_end(lib, builder, oob_blk)?
        Llvm.build_ret(lib, builder, m1)?
        Llvm.position_builder_at_end(lib, builder, ok_blk)?
        // argp = argv[i + 1](char*);n = 字节长(NUL 终止扫描)。
        val argvp = Llvm.build_load(lib, builder, ptrty, rt_argv_g, "argvp")?
        val idx64 = Llvm.build_add(lib, builder, iv64, one64, "idx")?
        // char** 元素 = 8 字节:i8 基型 gep 须按字节偏移(×8)。
        val c8i = Llvm.const_int(lib, i64ty, 8u64, false)?
        val byteoff = Llvm.build_mul(lib, builder, idx64, c8i, "bo")?
        val argvp8 = Llvm.build_inbounds_gep2(lib, builder, i8ty, argvp, [byteoff], "av8")?
        val argp = Llvm.build_load(lib, builder, ptrty, argvp8, "argp")?
        val nslot = Llvm.build_alloca(lib, builder, i64ty, "n")?
        val islot = Llvm.build_alloca(lib, builder, i64ty, "k")?
        Llvm.build_store(lib, builder, Llvm.const_int(lib, i64ty, 0u64, false)?, islot)?
        val sl_blk = Llvm.append_block(lib, ctx, fref, "sloop")?
        val sb_blk = Llvm.append_block(lib, ctx, fref, "sbody")?
        val se_blk = Llvm.append_block(lib, ctx, fref, "send")?
        Llvm.build_br(lib, builder, sl_blk)?
        Llvm.position_builder_at_end(lib, builder, sl_blk)?
        val k0 = Llvm.build_load(lib, builder, i64ty, islot, "k")?
        val ap = Llvm.build_inbounds_gep2(lib, builder, i8ty, argp, [k0], "ap")?
        val ch = Llvm.build_load(lib, builder, i8ty, ap, "ch")?
        val z8 = Llvm.const_int(lib, i8ty, 0u64, false)?
        val done = Llvm.build_icmp(lib, builder, ch, z8, 32u32, "done")?
        Llvm.build_cond_br(lib, builder, done, se_blk, sb_blk)?
        Llvm.position_builder_at_end(lib, builder, sb_blk)?
        val k1 = Llvm.build_add(lib, builder, k0, one64, "k1")?
        Llvm.build_store(lib, builder, k1, islot)?
        Llvm.build_br(lib, builder, sl_blk)?
        Llvm.position_builder_at_end(lib, builder, se_blk)?
        val n = k0
        Llvm.build_store(lib, builder, n, nslot)?
        // n >= buf.len(块头 len@0)→ -2。
        val buflen = Llvm.build_load(lib, builder, i64ty, buf, "bl")?
        val big = Llvm.build_icmp(lib, builder, n, buflen, 39u32, "big")?
        val ovf_blk = Llvm.append_block(lib, ctx, fref, "ovf")?
        val cp_blk = Llvm.append_block(lib, ctx, fref, "cp")?
        Llvm.build_cond_br(lib, builder, big, ovf_blk, cp_blk)?
        Llvm.position_builder_at_end(lib, builder, ovf_blk)?
        Llvm.build_ret(lib, builder, m2)?
        Llvm.position_builder_at_end(lib, builder, cp_blk)?
        // 逐字节拷贝 argp[0..n) → buf 数据@16。
        Llvm.build_store(lib, builder, Llvm.const_int(lib, i64ty, 0u64, false)?, islot)?
        val cl_blk = Llvm.append_block(lib, ctx, fref, "cloop")?
        val cb_blk = Llvm.append_block(lib, ctx, fref, "cbody")?
        val ce_blk = Llvm.append_block(lib, ctx, fref, "cend")?
        Llvm.build_br(lib, builder, cl_blk)?
        Llvm.position_builder_at_end(lib, builder, cl_blk)?
        val j0 = Llvm.build_load(lib, builder, i64ty, islot, "j")?
        val jmore = Llvm.build_icmp(lib, builder, j0, n, 36u32, "jmore")?
        Llvm.build_cond_br(lib, builder, jmore, cb_blk, ce_blk)?
        Llvm.position_builder_at_end(lib, builder, cb_blk)?
        val srcp = Llvm.build_inbounds_gep2(lib, builder, i8ty, argp, [j0], "srcp")?
        val b0 = Llvm.build_load(lib, builder, i8ty, srcp, "b")?
        val dstoff = Llvm.build_add(lib, builder, c16, j0, "dstoff")?
        val dstp = Llvm.build_inbounds_gep2(lib, builder, i8ty, buf, [dstoff], "dstp")?
        Llvm.build_store(lib, builder, b0, dstp)?
        Llvm.build_store(lib, builder, Llvm.build_add(lib, builder, j0, one64, "j1")?, islot)?
        Llvm.build_br(lib, builder, cl_blk)?
        Llvm.position_builder_at_end(lib, builder, ce_blk)?
        Llvm.build_ret(lib, builder, n)?
        Llvm.dispose_builder(lib, builder)
    }
    extern_llvm.set("__os_arg_get_into", get_fn)
    extern_fts.set("__os_arg_get_into", get_ft)
    extern_voids.set("__os_arg_get_into", false)
    val i32_h = Arena.from_scalar_name(a, "i32")
    val u8arr_h = Arena.make_array(a, Arena.from_scalar_name(a, "u8"), null)
    val i64_h = Arena.from_scalar_name(a, "i64")
    extern_params.set("__os_arg_get_into", [i32_h, u8arr_h])
    extern_params.set("__os_arg_count", [])
    Ok(void)
}

// main 入口序:argc/argv 落全局(发射于 main 行体首)。
fun emit_main_prologue(lib: Lib, ctx: u64, builder: u64, fref: u64,
    cache: Map<str, u64>): Throw<void, FfiError> {
    if rt_argc_g == 0 {
        return Ok(void)
    }
    val i32ty = llty_for(lib, ctx, cache, TI32)?
    val ptrty = opaque_ptr(lib, ctx, cache)?
    val ac = Llvm.get_param(lib, fref, 0u32)?
    val av = Llvm.get_param(lib, fref, 1u32)?
    Llvm.build_store(lib, builder, ac, rt_argc_g)?
    Llvm.build_store(lib, builder, av, rt_argv_g)?
    Ok(void)
}

// ── 切片 6f:使用驱动绑定(零参工厂的静态回流)──────────────────
// 递归语句/表达式扫描:目标 (a) init == 目标调用 eid 的 Val 绑定名;
// (b) 该绑定名上的首个带实参方法调用(out.push(x) 形)。
fun scan_stmt_uses(ast: AstArena, sid: i64, name: str): void {
    match ast.stmt(sid).node {
        ValDeclS(n2, _, init, _) | VarDeclS(n2, _, init, _) => {
            if init == gu_target_eid {
                gu_bind_name = n2
            }
            if n2 == name {
                scan_expr_uses(ast, init, name)
            }
        },
        AssignS(t2, v2) => {
            scan_expr_uses(ast, t2, name)
            scan_expr_uses(ast, v2, name)
        },
        FieldAssignS(o2, _, v3) => {
            scan_expr_uses(ast, o2, name)
            scan_expr_uses(ast, v3, name)
        },
        CompAssignS(t3, _, v4) => {
            scan_expr_uses(ast, t3, name)
            scan_expr_uses(ast, v4, name)
        },
        ExprS(e2) => { scan_expr_uses(ast, e2, name) },
        ReturnS(e3) => {
            match e3 {
                null => {}
                ee => { scan_expr_uses(ast, ee ?? 0, name) }
            }
        },
        DeferS(e4) => { scan_expr_uses(ast, e4, name) },
        ThrowS(e5) => { scan_expr_uses(ast, e5, name) },
        ForS(n3, it, body) => {
            if n3 != name {
                scan_expr_uses(ast, it, name)
                scan_expr_uses(ast, body, name)
            }
        },
        WhileS(c2, body2) => {
            scan_expr_uses(ast, c2, name)
            scan_expr_uses(ast, body2, name)
        },
        LoopS(body3) => { scan_expr_uses(ast, body3, name) },
        LocalDeclS(_) => {},
        BreakS => {},
        ContinueS => {},
    }
}

fun scan_expr_uses(ast: AstArena, eid: i64, name: str): void {
    match ast.expr(eid).node {
        BlockE(stmts, tail) => {
            var i: usize = 0
            while i < stmts.len() {
                scan_stmt_uses(ast, stmts[i], name)
                i = i + 1
            }
            match tail {
                null => {}
                te => { scan_expr_uses(ast, te ?? 0, name) }
            }
        },
        MethodCallE(recv, m, args, _) => {
            match ast.expr(recv).node {
                Ident(rn) => {
                    if rn == name && !gu_use_found && args.len() > 0 {
                        gu_use_found = true
                        gu_use_method = m
                        gu_use_args = args
                    }
                },
                _ => {},
            }
            scan_expr_uses(ast, recv, name)
            var j: usize = 0
            while j < args.len() {
                scan_expr_uses(ast, args[j], name)
                j = j + 1
            }
        },
        SafeMethodCallE(recv2, _, args2, _) => {
            scan_expr_uses(ast, recv2, name)
            var j2: usize = 0
            while j2 < args2.len() {
                scan_expr_uses(ast, args2[j2], name)
                j2 = j2 + 1
            }
        },
        CallE(callee, args3, _) => {
            scan_expr_uses(ast, callee, name)
            var j3: usize = 0
            while j3 < args3.len() {
                scan_expr_uses(ast, args3[j3], name)
                j3 = j3 + 1
            }
        },
        AssignE(t4, v5) => {
            scan_expr_uses(ast, t4, name)
            scan_expr_uses(ast, v5, name)
        },
        BinaryE(_, t4, v5) => {
            scan_expr_uses(ast, t4, name)
            scan_expr_uses(ast, v5, name)
        },
        ElvisE(t4, v5) => {
            scan_expr_uses(ast, t4, name)
            scan_expr_uses(ast, v5, name)
        },
        CompAssignE(_, t5, v6) => {
            scan_expr_uses(ast, t5, name)
            scan_expr_uses(ast, v6, name)
        },
        UnaryE(_, u2) => { scan_expr_uses(ast, u2, name) },
        AsCast(su2, _) => { scan_expr_uses(ast, su2, name) },
        RefOfE(r3) => { scan_expr_uses(ast, r3, name) },
        DerefE(d3) => { scan_expr_uses(ast, d3, name) },
        FieldAccessE(r4, _) => { scan_expr_uses(ast, r4, name) },
        IndexE(a4, i4) => {
            scan_expr_uses(ast, a4, name)
            scan_expr_uses(ast, i4, name)
        },
        SliceE(b5, l5, h5, _) => {
            scan_expr_uses(ast, b5, name)
            scan_expr_uses(ast, l5, name)
            scan_expr_uses(ast, h5, name)
        },
        SafeAccessE(r5, _) => { scan_expr_uses(ast, r5, name) },
        PropagateE(p3) => { scan_expr_uses(ast, p3, name) },
        NonNullAssertE(n4) => { scan_expr_uses(ast, n4, name) },
        ArrayLitE(elems, fv2, _, _) => {
            var k2: usize = 0
            while k2 < elems.len() {
                scan_expr_uses(ast, elems[k2], name)
                k2 = k2 + 1
            }
            scan_expr_uses(ast, fv2, name)
        },
        StrInterp(parts) => {
            var k3: usize = 0
            while k3 < parts.len() {
                match parts[k3] {
                    IpExpr(pe2) => { scan_expr_uses(ast, pe2, name) }
                    IpLit(_) => {},
                }
                k3 = k3 + 1
            }
        },
        IfE(c3, t6, e6) => {
            scan_expr_uses(ast, c3, name)
            scan_expr_uses(ast, t6, name)
            match e6 {
                null => {}
                ee2 => { scan_expr_uses(ast, ee2 ?? 0, name) }
            }
        },
        MatchE(scrut, arms) => {
            scan_expr_uses(ast, scrut, name)
            var a5: usize = 0
            while a5 < arms.len() {
                match arms[a5].guard {
                    null => {}
                    g2 => { scan_expr_uses(ast, g2 ?? 0, name) }
                }
                scan_expr_uses(ast, arms[a5].body, name)
                a5 = a5 + 1
            }
        },
        _ => {},
    }
}

// 工厂返回模式对位:声明 rt AST(类型参名字占位)vs 具体句柄 →
// 工厂类型参绑定表。true = 对位成功(绑定入 bmap)。
fun match_rt_pattern(a: TypeArena, s: SemaRes, astv: AstArena, tn: i64?,
    h: u32, tps: str[], bmap: Map<str, u32>): bool {
    match tn {
        null => true
        t0 => {
            match astv.ty(t0 ?? 0).node {
                TNamed(n2) => {
                    var k: usize = 0
                    while k < tps.len() {
                        if tps[k] == n2 {
                            match bmap.get(n2) {
                                null => { bmap.set(n2, h) }
                                pb => {
                                    if !ty_same(a, s, pb ?? 0, h) {
                                        return false
                                    }
                                },
                            }
                        }
                        k = k + 1
                    }
                    true
                },
                TGeneric(gn, gargs) => {
                    val hr = Arena.resolve(a, h)
                    val hp = Arena.adt_parts(a, hr)
                    val gcanon = Semares.resolve_type_key(s, gn)
                    if hp.a != gcanon && hp.a != gn {
                        return false
                    }
                    if hp.b.len() != gargs.len() {
                        return false
                    }
                    var i: usize = 0
                    while i < gargs.len() {
                        if !match_rt_pattern(a, s, astv, gargs[i], hp.b[i], tps, bmap) {
                            return false
                        }
                        i = i + 1
                    }
                    true
                },
                TArray(elem, _) => {
                    val hr2 = Arena.resolve(a, h)
                    match Arena.get(a, hr2) {
                        TArray(_) => {
                            match_rt_pattern(a, s, astv, elem, (Arena.array_parts(a, hr2)).a, tps, bmap)
                        },
                        _ => false,
                    }
                },
                TNullable(inner) => {
                    val hr3 = Arena.resolve(a, h)
                    match Arena.get(a, hr3) {
                        TNullable(_) => {
                            match_rt_pattern(a, s, astv, inner, Arena.nullable_inner(a, hr3), tps, bmap)
                        },
                        _ => false,
                    }
                },
                _ => true,
            }
        },
    }
}

// 切片 6f:幽灵实例派生 —— 泛型体内零参工厂(List.empty())的 check
// 期实例实参 = 未解占位(TAdt("T"),工厂自身参名;真值由 check 期
// solver 回流绑定,Back 的一次性重放不跑)。两路派生:
//   A. 名字代换 —— 占位名 ∈ 当前发射行类型参(K/V 形)→ subst_ty;
//   B. 使用驱动 —— 扫函数体找绑定名上的首个带参方法调用
//      (out.push(x)),方法声明参型(T 占位)与实参类型对位闭包
//      接收者开放槽 → 工厂 rt 模式对位 → 工厂类型参绑定。
// 派生成虚拟实例(追加进 monomorph_instances,id = 追加索引;
// register_instance_fn + 行簿记 + worklist 重放机制全复用)。
// null = 不可派生(调用方报错)。
fun derive_ghost_instance(lib: Lib, ctx: u64, module: u64, a: TypeArena, s: SemaRes,
    cache: Map<str, u64>, ftab: Mono.FTabs, ghost_id: i64, mname: str, eid: i64): i64? {
    match s.monomorph_instances.get(ghost_id as usize) {
        null => null
        g0 => {
            val g = g0 ?? Data.Mono(0, "", "", [], 0, false, 0)
            if g.type_args.len() == 0 {
                return null
            }
            if args_resolvable(a, s, g.type_args) {
                return null
            }
            var dargs: u32[] = []
            // A. 名字代换。
            if cur_gargs.len() > 0 {
                var i: usize = 0
                while i < g.type_args.len() {
                    dargs = dargs ++ [sanitize_arg(a, s, subst_ty(a, cur_gtps, cur_gargs, g.type_args[i]))]
                    i = i + 1
                }
                if !args_resolvable(a, s, dargs) {
                    dargs = []
                }
            }
            // B. 使用驱动。
            if dargs.len() == 0 && cur_body_eid != 0 {
                match cur_farena {
                    null => {}
                    fa0 => {
                        val fa = fa0 ?? (all_mods.get(0) ?? ModuleAst("", null,
                            AstArena(List.empty<Se>(), List.empty<Ss>(), List.empty<St>(), List.empty<Spn>()), [])).arena
                        // 绑定名 + 首个带参方法调用(两扫:先名后用)。
                        gu_target_eid = eid
                        gu_bind_name = ""
                        gu_use_found = false
                        gu_use_method = ""
                        gu_use_args = []
                        scan_expr_uses(fa, cur_body_eid, "")
                        if gu_bind_name != "" {
                            gu_use_found = false
                            gu_use_method = ""
                            gu_use_args = []
                            scan_expr_uses(fa, cur_body_eid, gu_bind_name)
                        }
                        if gu_use_found && gu_bind_name != "" {
                            dargs = derive_by_use(a, s, ftab, g, gu_use_method, gu_use_args, mname)
                        }
                    },
                }
            }
            if dargs.len() == 0 || !args_resolvable(a, s, dargs) {
                return null
            }
            // 虚拟实例 = 追加行(id = 追加后索引),复用标准注册/重放。
            val vid = s.monomorph_instances.len() as i64
            s.monomorph_instances.push(Data.Mono(vid, g.func_name, g.module_name, dargs, 0u32, false, 0i64))
            match register_instance_fn(lib, ctx, module, a, s, cache, ftab,
                s.monomorph_instances.get(vid as usize) ?? Data.Mono(0, "", "", [], 0, false, 0)) {
                Error(_) => null
                Ok(_) => {
                    var dmast: ModuleAst? = null
                    var di: usize = 0
                    while di < all_mods.len() {
                        if (all_mods.get(di) ?? (all_mods.get(0) ?? ModuleAst("", null,
                            AstArena(List.empty<Se>(), List.empty<Ss>(), List.empty<St>(), List.empty<Spn>()), []))).name == g.module_name {
                            dmast = if true { all_mods.get(di) } else { null }
                        }
                        di = di + 1
                    }
                    match dmast {
                        null => null
                        dma => {
                            val dkey = "{g.module_name}\u{0}{g.func_name}"
                            match (ftab.decls.get(dkey) ?? Mono.m_decls_dummy()).decl {
                                FunDeclD(_, _, _, ips, _, ibody, _, _, _, _) => {
                                    fn_ast_params.push(ips)
                                    fn_bodies.push(ibody)
                                    fn_mods.push(g.module_name)
                                    fn_asts.push(dma ?? (all_mods.get(0) ?? ModuleAst("", null,
                                        AstArena(List.empty<Se>(), List.empty<Ss>(), List.empty<St>(), List.empty<Spn>()), [])))
                                    fn_replays.push(true)
                                    fn_inst_ids.push(vid)
                                    fn_this.push(0u32)
                                    if true { vid } else { null }
                                },
                                _ => null,
                            }
                        },
                    }
                },
            }
        },
    }
}

// 使用驱动派生内核:方法声明参型(类型参名字占位)与调用实参类型
// 对位 → 接收者开放槽闭包 → 工厂 rt 模式对位 → 工厂类型参实参序。
fun derive_by_use(a: TypeArena, s: SemaRes, ftab: Mono.FTabs, g: Data.Mono,
    use_method: str, use_args: i64[], mname: str): u32[] {
    val dkey = "{g.module_name}\u{0}{g.func_name}"
    // 工厂声明:rt 节点 + 类型参名 + arena。
    var f_rt: i64? = null
    var f_tps: str[] = []
    var f_ast: AstArena? = null
    match ftab.decls.get(dkey) {
        null => { return [] }
        fd0 => {
            match (fd0 ?? Mono.m_decls_dummy()).decl {
                FunDeclD(_, _, tps, _, rt, _, _, _, _, _) => {
                    var k: usize = 0
                    while k < tps.len() {
                        f_tps = f_tps ++ [tps[k].name]
                        k = k + 1
                    }
                    f_rt = rt
                },
                _ => { return [] },
            }
        },
    }
    match ftab.arenas.get(dkey) {
        null => {}
        fa1 => { f_ast = if true { fa1 } else { null } }
    }
    val fav = f_ast ?? (all_mods.get(0) ?? ModuleAst("", null,
        AstArena(List.empty<Se>(), List.empty<Ss>(), List.empty<St>(), List.empty<Spn>()), [])).arena
    // 工厂 rt 头型(canonical)——使用方法所在类型。
    val head_canon = match f_rt {
        null => { return [] }
        r0 => {
            match fav.ty(r0 ?? 0).node {
                TGeneric(gn, _) => Semares.resolve_type_key(s, gn) ?? gn
                TNamed(nn) => Semares.resolve_type_key(s, nn) ?? nn
                _ => { return [] }
            }
        },
    }
    // 方法声明(使用位)→ 类型参 + 参型占位对位闭包。
    match find_method_decl(s, head_canon, use_method) {
        null => []
        mf0 => {
            val mf = mf0 ?? MFound([], Md("", [], [], null, 0i64, false, null, Priv, false),
                all_mods.get(0) ?? ModuleAst("", null,
                    AstArena(List.empty<Se>(), List.empty<Ss>(), List.empty<St>(), List.empty<Spn>()), []), "")
            var closed: u32[] = []
            var ck: usize = 0
            while ck < mf.tps.len() {
                closed = closed ++ [0u32]
                ck = ck + 1
            }
            // 方法参位(0 = this,实参 j ↔ params[j+1])。
            var pj: usize = 1
            while pj < mf.md.params.len() {
                if (pj - 1) < use_args.len() {
                    val ph2 = inst_param_ty(a, s, mf.mast.arena, mf.md.params[pj].ta, [], [])
                    match expr_ty(a, s, mname, use_args[pj - 1]) {
                        Ok(ah2) => {
                            var tk: usize = 0
                            while tk < mf.tps.len() {
                                if closed[tk] == 0 {
                                    val bnd = match_param_arg(a, mf.tps[tk], ph2, ah2)
                                    if bnd != 0 {
                                        closed[tk] = bnd
                                    }
                                }
                                tk = tk + 1
                            }
                        },
                        Error(_) => {},
                    }
                }
                pj = pj + 1
            }
            var zi: usize = 0
            while zi < closed.len() {
                if closed[zi] == 0 {
                    return []
                }
                zi = zi + 1
            }
            // 工厂 rt 模式对位 → 工厂类型参绑定。
            val recv_h = Arena.make_adt(a, head_canon, closed)
            val bmap = Map.empty<str, u32>()
            if !match_rt_pattern(a, s, fav, f_rt, recv_h, f_tps, bmap) {
                return []
            }
            var out: u32[] = []
            var oi: usize = 0
            while oi < f_tps.len() {
                match bmap.get(f_tps[oi]) {
                    null => { return [] }
                    b2 => { out = out ++ [sanitize_arg(a, s, b2 ?? 0)] }
                }
                oi = oi + 1
            }
            out
        },
    }
}

// 切片 6b:发射期拾取重放中新追加的实例(嵌套泛型调用)。
fun register_pending_instances(lib: Lib, ctx: u64, module: u64, a: TypeArena, s: SemaRes,
    cache: Map<str, u64>, ftab: Mono.FTabs, entry: ModuleAst, dep_mods: List<ModuleAst>): Throw<void, FfiError> {
    var ii: usize = 0
    while ii < s.monomorph_instances.len() {
        val inst = s.monomorph_instances.get(ii) ?? Data.Mono(0, "", "", [], 0, false, 0)
        if inst.type_args.len() > 0 && inst_rows.get("{inst.instance_id}") == null
            && args_resolvable(a, s, inst.type_args) {
            var dmast: ModuleAst? = null
            if inst.module_name == entry.name {
                dmast = if true { entry } else { null }
            }
            var kmi: usize = 0
            while kmi < dep_mods.len() {
                val dm = dep_mods.get(kmi) ?? entry
                if dm.name == inst.module_name {
                    dmast = if true { dm } else { null }
                }
                kmi = kmi + 1
            }
            match dmast {
                null => {}
                dma => {
                    match register_instance_fn(lib, ctx, module, a, s, cache, ftab, inst) {
                        Error(_) => {}
                        Ok(_) => {
                    match (ftab.decls.get("{inst.module_name}\u{0}{inst.func_name}") ?? Mono.m_decls_dummy()).decl {
                        FunDeclD(_, _, _, ips, _, ibody, _, _, _, _) => {
                            fn_ast_params.push(ips)
                            fn_bodies.push(ibody)
                            fn_mods.push(inst.module_name)
                            fn_asts.push(dma ?? entry)
                            fn_replays.push(true)
                            fn_inst_ids.push(inst.instance_id)
                            fn_this.push(0u32)
                        },
                        _ => {},
                    }
                },
            }
                        },
                    }
        }
        ii = ii + 1
    }
    Ok(void)
}

// 切片 6c:方法注册——声明 Md(非泛型、有体)以独立函数发射;
// 首参 this(类型 = Adt<canonical>,值 = ptr);参数/返回从 AST 注解
// 解析(空 type_args 面,同 inst_param_ty 回落)。
fun register_method_fn(lib: Lib, ctx: u64, module: u64, a: TypeArena, s: SemaRes,
    cache: Map<str, u64>, type_name: str, md: Md, mname: str, ast: AstArena,
    suffix: str): Throw<bool, FfiError> {
    match md.body {
        null => { return Ok(false) }
        b0 => {},
    }
    if md.tps.len() > 0 {
        return Ok(false)
    }
    // 切片 6e:泛型类型的方法不走共享行(this 型不带实参,布局必错;
    // 经 register_method_instance 逐实例特化——调用点动态注册)。
    match Semares.get_type_def(s, type_name) {
        null => {}
        td0 => {
            if (td0 ?? Data.TDef("", Data.TAlias, [], [], null, null, [], [])).type_params.len() > 0 {
                return Ok(false)
            }
        },
    }
    // 签名:[this] + 参数。
    val this_h = Arena.make_adt(a, type_name, [])
    // parser 已注入 this:TThis 首参(Params[0])——TThis 解析为接收者
    // 型,其余参数走常规解析。
    var ph: u32[] = []
    var pi: usize = 0
    while pi < md.params.len() {
        var one_h = inst_param_ty(a, s, ast, md.params[pi].ta, [], [])
        if pi == 0 {
            val ta0 = md.params[pi].ta
            var is_this = false
            match ta0 {
                null => {}
                t0 => {
                    match ast.ty(t0 ?? 0).node {
                        TThis => { is_this = true }
                        _ => {}
                    }
                },
            }
            if is_this {
                one_h = this_h
            }
        }
        ph = ph ++ [one_h]
        pi = pi + 1
    }
    var ret_h = Arena.fresh_type_var(a)
    match md.rt {
        null => {}
        r0 => { ret_h = inst_param_ty(a, s, ast, r0, [], []) }
    }
    val rr0 = Arena.resolve(a, ret_h)
    match Arena.get(a, rr0) {
        TAsync(_) => { ret_h = Arena.async_value(a, rr0) }
        _ => {}
    }
    var ptys: u64[] = []
    var j: usize = 0
    while j < ph.len() {
        ptys = ptys ++ [llty_for_h(lib, ctx, cache, a, s, ph[j])?]
        j = j + 1
    }
    val ret_res = Arena.resolve(a, ret_h)
    val ret_llvm = if ty_kind(Arena.get(a, ret_res)) == 4 {
        Llvm.void_type(lib, ctx)?
    } else {
        llty_for_h(lib, ctx, cache, a, s, ret_res)?
    }
    val fnty = Llvm.function_type(lib, ret_llvm, ptys, false)?
    val fref = Llvm.add_function(lib, module,
        "frond_m_{type_name}_{md.name}{suffix}", fnty)?
    fn_names.push("{type_name}.{md.name}")
    fn_llvm.push(fref)
    fn_lty.push(fnty)
    fn_params.push(ph)
    fn_rets.push(ret_h)
    fn_replays.push(false)
    fn_inst_ids.push(-1)
    fn_this.push(this_h)
    method_rows.set(type_name + "\u{0}" + md.name,
        fn_names.len() as i64 - 1)
    Ok(true)
}

// ── 切片 6e:泛型类型方法实例 ──────────────────────────────────────

// 方法声明检索结果(canonical 类型的方法:类型参数 + Md + 声明模块)。
type MFound = MFound(pub tps: str[], pub md: Md, pub mast: ModuleAst, pub mname: str)

// canonical 类型方法检索:归属表(lower_entry 收集期填)直取;miss 扫
// 全模块 TypeDeclD(canonical 对位)。null = 未找到。
fun find_method_decl(s: SemaRes, canon: str, method: str): MFound? {
    var owner: str? = null
    match gen_method_mods.get("{canon}\u{0}{method}") {
        null => {}
        o => { owner = if true { o } else { null } }
    }
    var mi: usize = 0
    while mi < all_mods.len() {
        val m = all_mods.get(mi) ?? (all_mods.get(0) ?? ModuleAst("", null, AstArena(List.empty<Se>(), List.empty<Ss>(), List.empty<St>(), List.empty<Spn>()), []))
        if owner != null && m.name != (owner ?? "") {
            mi = mi + 1
            continue
        }
        var di: usize = 0
        while di < m.decls.len() {
            match m.decls[di].decl {
                TypeDeclD(_, tname, tps, _, _, _, tmethods) => {
                    val tcanon = Semares.resolve_type_key(s, tname) ?? tname
                    if tcanon == canon {
                        var tnames: str[] = []
                        var tk2: usize = 0
                        while tk2 < tps.len() {
                            tnames = tnames ++ [tps[tk2].name]
                            tk2 = tk2 + 1
                        }
                        var ti: usize = 0
                        while ti < tmethods.len() {
                            if tmethods[ti].name == method {
                                return if true { MFound(tnames, tmethods[ti], m, m.name) } else { null }
                            }
                            ti = ti + 1
                        }
                    }
                },
                _ => {},
            }
            di = di + 1
        }
        if owner != null {
            return null
        }
        mi = mi + 1
    }
    null
}

// 方法实例键(canonical + 方法 + 接收者结构键;同型不同实参各自成键)。
fun mkey_of(a: TypeArena, s: SemaRes, canon: str, method: str, recv_h: u32): str {
    "{canon}\u{0}{method}\u{0}{ty_key(a, s, Arena.resolve(a, recv_h))}"
}

// 泛型类型方法实例注册(调用点动态注册):接收者 TAdt(canonical,
// args)——this = 接收者实例型;参数/返回经 type_params → args 代换
// (inst_param_ty);体 = 声明 Md;行标记 fn_inst_id = -2(发射期经
// Mono.replay_method_body 重放体类型,含 this 绑定)。
fun register_method_instance(lib: Lib, ctx: u64, module: u64, a: TypeArena, s: SemaRes,
    cache: Map<str, u64>, recv_h: u32, method: str, eid: i64): Throw<i64, FfiError> {
    val rh = Arena.resolve(a, recv_h)
    match Arena.get(a, rh) {
        TAdt(_) => {
            val parts = Arena.adt_parts(a, rh)
            val canon = parts.a
            var args: u32[] = []
            var sai: usize = 0
            while sai < parts.b.len() {
                args = args ++ [sanitize_arg(a, s, parts.b[sai])]
                sai = sai + 1
            }
            // 归一后的干净接收者句柄(签名/this 槽/重放共用)。
            val srh = Arena.make_adt(a, canon, args)
            if args.len() == 0 {
                throw FfiError(Other, "slice 6e: method instance on non-generic receiver '{canon}' (expr {eid})")
            }
            match Semares.get_type_def(s, canon) {
                null => throw FfiError(Other, "slice 6e: unknown type '{canon}' for method instance (expr {eid})")
                td0 => {
                    val td = td0 ?? Data.TDef("", Data.TAlias, [], [], null, null, [], [])
                    if td.type_params.len() != args.len() {
                        throw FfiError(Other, "slice 6e: '{canon}' takes {td.type_params.len()} type arg(s), receiver has {args.len()} (expr {eid})")
                    }
                                        match find_method_decl(s, canon, method) {
                        null => throw FfiError(Other, "slice 6e: no method '{method}' on generic type '{canon}' (expr {eid})")
                        f0 => {
                            val f = f0 ?? MFound([], Md("", [], [], null, 0i64, false, null, Priv, false),
                                all_mods.get(0) ?? ModuleAst("", null, AstArena(List.empty<Se>(), List.empty<Ss>(), List.empty<St>(), List.empty<Spn>()), []), "")
                            // 声明模块上下文(裸名 canonical 同径)。
                            val saved_cmod = s.current_module_name
                            s.current_module_name = f.mname
                            // 签名:[this=接收者实例型] + 代换参数。
                            var ph: u32[] = [srh]
                            var pi: usize = 1
                            while pi < f.md.params.len() {
                                ph = ph ++ [inst_param_ty(a, s, f.mast.arena, f.md.params[pi].ta, f.tps, args)]
                                pi = pi + 1
                            }
                            var ret_h = Arena.fresh_type_var(a)
                            match f.md.rt {
                                null => {}
                                r0 => { ret_h = inst_param_ty(a, s, f.mast.arena, r0, f.tps, args) }
                            }
                            val rr0 = Arena.resolve(a, ret_h)
                            match Arena.get(a, rr0) {
                                TAsync(_) => { ret_h = Arena.async_value(a, rr0) }
                                _ => {}
                            }
                            var ptys: u64[] = []
                            var j: usize = 0
                            while j < ph.len() {
                                ptys = ptys ++ [llty_for_h(lib, ctx, cache, a, s, ph[j])?]
                                j = j + 1
                            }
                            val ret_res = Arena.resolve(a, ret_h)
                            val ret_llvm = if ty_kind(Arena.get(a, ret_res)) == 4 {
                                Llvm.void_type(lib, ctx)?
                            } else {
                                llty_for_h(lib, ctx, cache, a, s, ret_res)?
                            }
                            val fnty = Llvm.function_type(lib, ret_llvm, ptys, false)?
                            meth_seq = meth_seq + 1
                            val llvm_name = "frond_tm{meth_seq}_{mangle(canon)}_{method}"
                            val fref = Llvm.add_function(lib, module, llvm_name, fnty)?
                            fn_names.push("{canon}.{method}")
                            fn_llvm.push(fref)
                            fn_lty.push(fnty)
                            fn_params.push(ph)
                            fn_rets.push(ret_h)
                            fn_ast_params.push(f.md.params)
                            fn_bodies.push(f.md.body ?? 0)
                            fn_mods.push(f.mname)
                            fn_asts.push(f.mast)
                            fn_replays.push(false)
                            fn_inst_ids.push(-2)
                            fn_this.push(srh)
                            val row = fn_names.len() as i64 - 1
                            meth_inst_rows.set(mkey_of(a, s, canon, method, rh), row)
                            meth_row_keys.set("{row}", "{canon}\u{0}{method}")
                            s.current_module_name = saved_cmod
                            Ok(row)
                        },
                    }
                },
            }
        },
        _ => throw FfiError(Other, "slice 6e: method instance on non-Adt receiver (expr {eid})"),
    }
}

// 隐式返回(main → i32 0;void → ret void;值类型 → 零值兜底)。
fun emit_implicit_ret(lib: Lib, ctx: u64, builder: u64, cache: Map<str, u64>,
    a: TypeArena, s: SemaRes, ret_h: u32, is_main: bool): Throw<void, FfiError> {
    if is_main {
        val i32ty = llty_for(lib, ctx, cache, TI32)?
        val z = Llvm.const_int_str(lib, i32ty, "0", 10u8)?
        match Llvm.build_ret(lib, builder, z) {
            Ok(_) => {}
            Error(e) => throw e
        }
        return Ok(void)
    }
    val rt = Arena.resolve(a, ret_h)
    if ty_kind(Arena.get(a, rt)) == 4 {
        Llvm.build_ret_void(lib, builder)?
        return Ok(void)
    }
    val raw = Arena.get(a, rt)
    // 聚合隐式返回 = null ptr 兜底(切片 2:控制流完整性优先,语义
    // 上"漏 return 的聚合值"本就是残缺程序)。
    if is_agg_kind(agg_kind(a, s, rt)) {
        val lt = opaque_ptr(lib, ctx, cache)?
        val z = Llvm.const_null(lib, lt)?
        match Llvm.build_ret(lib, builder, z) {
            Ok(_) => {}
            Error(e) => throw e
        }
        return Ok(void)
    }
    val lt = llty_for(lib, ctx, cache, raw)?
    val z = if ty_kind(raw) == 1 {
        Llvm.const_real_str(lib, lt, "0")?
    } else {
        Llvm.const_int_str(lib, lt, "0", 10u8)?
    }
    match Llvm.build_ret(lib, builder, z) {
        Ok(_) => {}
        Error(e) => throw e
    }
    Ok(void)
}

// 成功 = obj 已落盘;入口形状不符切片 1 → FfiError。
pub fun lower_entry(a: TypeArena, s: SemaRes, entry: ModuleAst,
    dep_mods: List<ModuleAst>, obj_path: str,
    root_env: u32): Throw<void, FfiError> {
    // 1) 收集(切片 6a:多模块):main(形状门:零泛型参/零参/非 async/
    // 非 extern C)+ 各用户模块非泛型 fun(Throw/async 切片 4 直落;
    // 其余静默跳过,调用点报错)。fn_mods/fn_asts 记录归属(体用己
    // arena,sema 表键同源)。
    var main_body: i64? = null
    var main_params: Prm[] = []
    val bodies = List.empty<i64>()
    val ast_params = List.empty<Prm[]>()
    val names = List.empty<str>()
    val mods = List.empty<str>()
    val masts = List.empty<ModuleAst>()
    var i: usize = 0
    while i < entry.decls.len() {
        match entry.decls[i].decl {
            FunDeclD(_, nm, tps, params, _, body, is_async, is_throwing, _, extern_c) => {
                if nm == "main" {
                    if tps.len() > 0 {
                        throw FfiError(Other, "slice 1: generic main is not supported")
                    }
                    if params.len() > 0 {
                        throw FfiError(Other, "slice 1: main with parameters is not supported")
                    }
                    // Stage 3 前哨(6g):async main 放行(async fun 已按
                    // 返内型直通降级;体尾 await 产物即 payload)。命令行
                    // 经 Proc.args()(rt argv)取。
                    if extern_c != null {
                        throw FfiError(Other, "slice 1: extern-C main is not supported")
                    }
                    // T → T? 赋值不自动放宽(引擎写法约束):if 两臂 join。
                    main_body = if true { body } else { null }
                    main_params = params
                } else {
                    // 切片 4:Throw 直落(is_throwing,签名返 TThrow)+
                    // async 直通降级(is_async,签名返 Async<T> → 按内型
                    // T 注册;体尾/await 产物即 payload 原值)。
                    if tps.len() == 0 && extern_c == null {
                        names.push(nm)
                        ast_params.push(params)
                        bodies.push(body)
                        mods.push(entry.name)
                        masts.push(entry)
                    }
                }
            },
            _ => {}
        }
        i = i + 1
    }
    match main_body {
        null => throw FfiError(Other, "slice 1: entry module has no 'main' function")
        _ => {}
    }
    // 切片 6a:依赖用户模块(去重;std/builtin 由调用方过滤)。
    var di: usize = 0
    while di < dep_mods.len() {
        val dm = dep_mods.get(di) ?? entry
        var dup = false
        if dm.name == entry.name {
            dup = true
        }
        var dj: usize = 0
        while dj < mods.len() {
            if (mods.get(dj) ?? "") == dm.name {
                dup = true
            }
            dj = dj + 1
        }
        if !dup {
            var k: usize = 0
            while k < dm.decls.len() {
                match dm.decls[k].decl {
                    FunDeclD(_, nm, tps, params, _, body, _, _, _, extern_c) => {
                        if nm != "main" && tps.len() == 0 && extern_c == null {
                            names.push(nm)
                            ast_params.push(params)
                            bodies.push(body)
                            mods.push(dm.name)
                            masts.push(dm)
                        }
                    },
                    _ => {}
                }
                k = k + 1
            }
        }
        di = di + 1
    }
    // 2) LLVM 装配 + 原型先行(main 首位,互递归由原型解耦)。
    val lib = Toolchain.open_llvm()?
    Llvm.init_host_target(lib)?
    val ctx = Llvm.create_context(lib)?
    val module = Llvm.create_module(lib, "frondc_out", ctx)?
    // tm/td 提前(切片 2:聚合大小经 TargetData;布局规则与 emit 一致)。
    // reloc=LLVMRelocPIC(2):x86-64 ELF 默认 Static 用绝对 32 位寻址
    // (R_X86_64_32S),glibc PIE 链接直接拒(lld "recompile with -fPIC",
    // CI linux-x64 slice2 16_str_fields 实证);PIC 走 RIP 相对,全平台
    // 安全(COFF→REL32,Mach-O/arm64 本就 PC 相对)。
    val triple = Llvm.host_triple()
    cur_is_windows = Str.starts_with(triple, "x86_64-pc-windows")
        || Str.starts_with(triple, "aarch64-pc-windows")
    val target = Llvm.get_target(lib, triple)?
    val tm = Llvm.create_target_machine(lib, target, triple, "generic", "", 2u32, 2u32, 0u32)?
    cur_td = Llvm.create_target_data_layout(lib, tm)?
    str_consts = Map.empty<str, u64>()
    strn = 0
    tmpn = 0
    clear_u64_list(fn_llvm)
    clear_u64_list(fn_lty)
    while fn_names.len() > 0 { fn_names.pop() }
    while fn_params.len() > 0 { fn_params.pop() }
    while fn_rets.len() > 0 { fn_rets.pop() }
    while fn_ast_params.len() > 0 { fn_ast_params.pop() }
    while fn_bodies.len() > 0 { fn_bodies.pop() }
    while fn_mods.len() > 0 { fn_mods.pop() }
    while fn_asts.len() > 0 { fn_asts.pop() }
    while fn_replays.len() > 0 { fn_replays.pop() }
    while fn_inst_ids.len() > 0 { fn_inst_ids.pop() }
    while fn_this.len() > 0 { fn_this.pop() }
    method_rows = Map.empty<str, i64>()
    inst_rows = Map.empty<str, i64>()
    fn_index = Map.empty<str, i64>()
    val cache = Map.empty<str, u64>()
    // 方案 B:用户模块函数住模块专属 env(module_envs),不再进 root
    // 环境面 —— 签名查询按各模块逻辑路径取(切片 6a:per-module),
    // 兜底 root(builtin)。
    val entry_env = env_of_module(s, entry.name, root_env)
    cur_fn_mod = entry.name
    register_fn(lib, ctx, module, a, s, entry_env, cache, "main", true, "main")?
    fn_ast_params.push(main_params)
    fn_bodies.push(main_body ?? 0)
    fn_mods.push(entry.name)
    fn_asts.push(entry)
    fn_replays.push(false)
    fn_inst_ids.push(-1)
    fn_this.push(0u32)
    i = 0
    while i < names.len() {
        val fmod = mods.get(i) ?? entry.name
        val fmast = masts.get(i) ?? entry
        val fenv = env_of_module(s, fmod, root_env)
        val fname = names.get(i) ?? ""
        cur_fn_mod = fmod
        // 切片 6d:builtin 模块容错注册(unsupported 签名跳过;可达性
        // 发射下未被调即不编;被调而未注册 = 调用点响亮报错)。
        match register_fn(lib, ctx, module, a, s, fenv, cache, fname, false,
            mangled_mod_fn(entry.name, fmod, fname)) {
            Ok(_) => {
                fn_ast_params.push(ast_params.get(i) ?? [])
                fn_bodies.push(bodies.get(i) ?? 0)
                fn_mods.push(fmod)
                fn_asts.push(fmast)
                fn_replays.push(false)
                fn_inst_ids.push(-1)
                fn_this.push(0u32)
            },
            Error(_) => {}
        }
        i = i + 1
    }
    // 切片 6b:泛型实例注册(monomorph_instances;空实参实例与常规
    // 收集重复 → 跳过;声明模块不在收集面 = std 泛型,6d 面)。
    val ftab = Mono.ftabs_new()
    Mono.ftabs_register(ftab, entry)
    var tmi: usize = 0
    while tmi < dep_mods.len() {
        Mono.ftabs_register(ftab, dep_mods.get(tmi) ?? entry)
        tmi = tmi + 1
    }
    cur_ftab = if true { ftab } else { null }
    val mono_inprog = Map.empty<str, i64>()
    var inst_i: usize = 0
    while inst_i < s.monomorph_instances.len() {
        val inst = s.monomorph_instances.get(inst_i) ?? Data.Mono(0, "", "", [], 0, false, 0)
        if inst.type_args.len() > 0 && args_resolvable(a, s, inst.type_args) {
            var dmast: ModuleAst? = null
            if inst.module_name == entry.name {
                dmast = if true { entry } else { null }
            }
            var kmi: usize = 0
            while kmi < dep_mods.len() {
                val dm = dep_mods.get(kmi) ?? entry
                if dm.name == inst.module_name {
                    dmast = if true { dm } else { null }
                }
                kmi = kmi + 1
            }
            match dmast {
                null => {}
                dma => {
                    match register_instance_fn(lib, ctx, module, a, s, cache, ftab, inst) {
                        Error(_) => {}
                        Ok(_) => {
                    match (ftab.decls.get("{inst.module_name}\u{0}{inst.func_name}") ?? Mono.m_decls_dummy()).decl {
                        FunDeclD(_, _, _, ips, _, ibody, _, _, _, _) => {
                            fn_ast_params.push(ips)
                            fn_bodies.push(ibody)
                            fn_mods.push(inst.module_name)
                            fn_asts.push(dma ?? entry)
                            fn_replays.push(true)
                            fn_inst_ids.push(inst.instance_id)
                            fn_this.push(0u32)
                        },
                        _ => {},
                    }
                        },
                    }
                },
            }
        }
        inst_i = inst_i + 1
    }
    // 切片 6c:方法收集——各模块 TypeDeclD 的自有方法(非泛型有体;
    // canonical 名注册 method_rows)+ trait 默认(TDefI 实例,默认体
    // 从声明模块的 TraitDeclD 取;自有覆写优先——键已占用即跳过)。
    // 切片 6e:同步填 all_mods(全模块检索面)与 gen_method_mods
    // (canonical\0method → 声明模块;泛型类型方法实例的检索表)。
    var mod_list = List.empty<ModuleAst>()
    mod_list.push(entry)
    var mli: usize = 0
    while mli < dep_mods.len() {
        mod_list.push(dep_mods.get(mli) ?? entry)
        mli = mli + 1
    }
    all_mods = mod_list
    // 切片 6g:模块级 var/val 全局槽(std/Rand 有先例;frondc Back
    // 状态区是主用户)。
    collect_gvars(lib, ctx, module, a, s, cache, mod_list)?
    gen_method_mods = Map.empty<str, str>()
    meth_inst_rows = Map.empty<str, i64>()
    meth_row_keys = Map.empty<str, str>()
    meth_seq = 0
    var gmli: usize = 0
    while gmli < mod_list.len() {
        val gmmod = mod_list.get(gmli) ?? entry
        var gdi: usize = 0
        while gdi < gmmod.decls.len() {
            match gmmod.decls[gdi].decl {
                TypeDeclD(_, gtname, _, _, _, _, gtmethods) => {
                    val gtcanon = Semares.resolve_type_key(s, gtname) ?? gtname
                    // 切片 6g:双键 —— 模块名与类型同名(std.collections.List
                    // 装 List)时 canonical 解析步 2 拼错键落裸名("List"),
                    // TAdt 细节名以裸形存储(引擎同形);canonical 与裸尾段
                    // 都入表(首键优先)。
                    val gtbare = Semares.tail_seg(gtcanon)
                    var gmi: usize = 0
                    while gmi < gtmethods.len() {
                        gen_method_mods.set("{gtcanon}\u{0}{gtmethods[gmi].name}", gmmod.name)
                        if gtbare != gtcanon && !gen_method_mods.has("{gtbare}\u{0}{gtmethods[gmi].name}") {
                            gen_method_mods.set("{gtbare}\u{0}{gtmethods[gmi].name}", gmmod.name)
                        }
                        gmi = gmi + 1
                    }
                },
                _ => {},
            }
            gdi = gdi + 1
        }
        gmli = gmli + 1
    }
    var mli2: usize = 0
    while mli2 < mod_list.len() {
        val mmod = mod_list.get(mli2) ?? entry
        var di2: usize = 0
        while di2 < mmod.decls.len() {
            match mmod.decls[di2].decl {
                TypeDeclD(_, tname, _, _, _, _, tmethods) => {
                    val tcanon = Semares.resolve_type_key(s, tname) ?? tname
                    var mi2: usize = 0
                    while mi2 < tmethods.len() {
                        val md = tmethods[mi2]
                        match register_method_fn(lib, ctx, module, a, s, cache,
                            tcanon, md, mmod.name, mmod.arena, "") {
                            Error(_) => {}
                            Ok(true) => {
                                fn_ast_params.push(md.params)
                                fn_bodies.push(md.body ?? 0)
                                fn_mods.push(mmod.name)
                                fn_asts.push(mmod)
                            },
                            Ok(false) => {}
                            Error(e) => throw e
                        }
                        mi2 = mi2 + 1
                    }
                },
                _ => {},
            }
            di2 = di2 + 1
        }
        mli2 = mli2 + 1
    }
    // trait 默认方法(TDefI:默认体在 trait 声明模块的 TraitDeclD)。
    var tdi: usize = 0
    while tdi < s.trait_default_instances.len() {
        val tdefi = s.trait_default_instances.get(tdi)
            ?? Data.TDefI(0, "", 0, "", 0)
        val key0 = tdefi.type_name + "\u{0}"
        // 方法名 = trait 方法的名(从 trait 定义取)。
        var tmethod_name = ""
        var tmd: Md? = null
        var tmd_ast: AstArena? = null
        var tmd_mod: ModuleAst? = null
        match Semares.get_trait_def(s, tdefi.trait_name) {
            null => {}
            tt0 => {
                val tt = tt0 ?? Data.TTDef("", [], [])
                if tdefi.method_idx >= 0 && tdefi.method_idx < tt.methods.len() as i64 {
                    tmethod_name = tt.methods[tdefi.method_idx as usize].name
                }
            },
        }
        // 默认体:扫模块找 TraitDeclD。
        var smi: usize = 0
        while smi < mod_list.len() && tmd == null {
            val smod = mod_list.get(smi) ?? entry
            var sdi: usize = 0
            while sdi < smod.decls.len() && tmd == null {
                match smod.decls[sdi].decl {
                    TraitDeclD(_, tname2, _, _, _, tms2) => {
                        val tcanon2 = Semares.resolve_trait_key(s, tname2)
                        if (tcanon2 ?? tname2) == tdefi.trait_name || tname2 == tdefi.trait_name {
                            var tk2: usize = 0
                            while tk2 < tms2.len() {
                                if tms2[tk2].name == tmethod_name {
                                    tmd = if true { tms2[tk2] } else { null }
                                    tmd_ast = if true { smod.arena } else { null }
                                    tmd_mod = if true { smod } else { null }
                                }
                                tk2 = tk2 + 1
                            }
                        }
                    },
                    _ => {},
                }
                sdi = sdi + 1
            }
            smi = smi + 1
        }
        match tmd {
            null => {}
            md0 => {
                val mdv = md0 ?? Md("", [], [], null, 0i64, false, null, Priv, false)
                if !method_rows.has(key0 + mdv.name) {
                    match register_method_fn(lib, ctx, module, a, s, cache,
                        tdefi.type_name, mdv, "", tmd_ast ?? entry.arena, "_d") {
                        Error(_) => {}
                        Ok(true) => {
                            fn_ast_params.push(mdv.params)
                            fn_bodies.push(mdv.body ?? 0)
                            // 默认体在声明 trait 的模块 arena——发射须用
                            // 该模块(键/arena 同源)。
                            fn_mods.push((tmd_mod ?? entry).name)
                            fn_asts.push(tmd_mod ?? entry)
                        },
                        Ok(false) => {}
                        Error(e) => throw e
                    }
                }
            },
        }
        tdi = tdi + 1
    }
    // 切片 2:bump arena(每模块无条件 emit;纯标量程序 frond_alloc
    // 无调用者,O2 死码删除,仅 .bss 零页残留——1GiB 虚拟段 Windows PE
    // 表现见附八风险注记)。
    emit_arena(lib, ctx, module, cache, a)?
    // 切片 6e:rt 原语——std 依赖闭包的 C builtin IR 等价(mem_copy 族
    // 18 元素型 + hash_key_str;private 链接,未引用 O2 删)。
    emit_rt_mem_copy(lib, ctx, module, cache, a, "__mem_copy", "u8", 1u64)?
    emit_rt_mem_copy(lib, ctx, module, cache, a, "__mem_copy_i8", "i8", 1u64)?
    emit_rt_mem_copy(lib, ctx, module, cache, a, "__mem_copy_i16", "i16", 2u64)?
    emit_rt_mem_copy(lib, ctx, module, cache, a, "__mem_copy_i32", "i32", 4u64)?
    emit_rt_mem_copy(lib, ctx, module, cache, a, "__mem_copy_i64", "i64", 8u64)?
    emit_rt_mem_copy(lib, ctx, module, cache, a, "__mem_copy_u16", "u16", 2u64)?
    emit_rt_mem_copy(lib, ctx, module, cache, a, "__mem_copy_u32", "u32", 4u64)?
    emit_rt_mem_copy(lib, ctx, module, cache, a, "__mem_copy_u64", "u64", 8u64)?
    emit_rt_mem_copy(lib, ctx, module, cache, a, "__mem_copy_isize", "isize", 8u64)?
    emit_rt_mem_copy(lib, ctx, module, cache, a, "__mem_copy_usize", "usize", 8u64)?
    emit_rt_mem_copy(lib, ctx, module, cache, a, "__mem_copy_f32", "f32", 4u64)?
    emit_rt_mem_copy(lib, ctx, module, cache, a, "__mem_copy_f64", "f64", 8u64)?
    emit_rt_mem_copy(lib, ctx, module, cache, a, "__mem_copy_bool", "bool", 1u64)?
    emit_rt_mem_copy(lib, ctx, module, cache, a, "__mem_copy_char", "char", 4u64)?
    emit_rt_mem_copy(lib, ctx, module, cache, a, "__mem_copy_i128", "i128", 16u64)?
    emit_rt_mem_copy(lib, ctx, module, cache, a, "__mem_copy_u128", "u128", 16u64)?
    emit_rt_mem_copy(lib, ctx, module, cache, a, "__mem_copy_f128", "f128", 16u64)?
    emit_rt_mem_copy(lib, ctx, module, cache, a, "__mem_copy_f16", "f16", 2u64)?
    emit_rt_hash_key_str(lib, ctx, module, cache, a)?
    emit_rt_fnv1a_bytes(lib, ctx, module, cache, a)?
    emit_rt_args(lib, ctx, module, cache, a)?
    emit_rt_size_consts(lib, ctx, module, cache, a)?
    // 3) 函数体(切片 6d:可达性 worklist)——游标消费;行由调用/
    // 方法分派位动态标记(main 起始)。builtin 全量原型注册后,仅
    // 可达体发射(~230 个 __ 包装含不支持构造,不触即不编)。
    work_rows = List.empty<i64>()
    work_marked = Map.empty<str, bool>()
    itoa_fn = 0
    mark_reachable(0)
    var wcur: usize = 0
    while wcur < work_rows.len() {
        val r = (work_rows.get(wcur) ?? 0) as usize
        wcur = wcur + 1
        if r >= fn_names.len() as usize {
            continue
        }
        val fref = fn_llvm.get(r) ?? 0
        val builder = Llvm.create_builder(lib, ctx)?
        val blk = Llvm.append_block(lib, ctx, fref, "entry")?
        Llvm.position_builder_at_end(lib, builder, blk)?
        // Stage 3 前哨(6g):main 入口序(argc/argv 落全局)。
        if (fn_names.get(r) ?? "") == "main" {
            emit_main_prologue(lib, ctx, builder, fref, cache)?
            // 切片 6g:模块级 var/val 初始化序(引擎口径:入口体前)。
            emit_gvar_inits(lib, ctx, builder, fref, a, s, cache, all_mods)?
        }
        val slots = Map.empty<str, u64>()
        val tyslots = Map.empty<str, u32>()
        val ph = fn_params.get(r) ?? []
        val apron = fn_ast_params.get(r) ?? []
        var pi: usize = 0
        while pi < ph.len() {
            val pname = apron[pi].name
            val pv = Llvm.get_param(lib, fref, pi as u32)?
            val plt = llty_for_h(lib, ctx, cache, a, s, ph[pi])?
            val pslot = Llvm.build_alloca(lib, builder, plt, pname)?
            match Llvm.build_store(lib, builder, pv, pslot) {
                Ok(_) => {}
                Error(e) => throw e
            }
            slots.set(pname, pslot)
            tyslots.set(pname, ph[pi])
            pi = pi + 1
        }
        cur_ret_h = fn_rets.get(r) ?? 0
        cur_is_main = (fn_names.get(r) ?? "") == "main"
        // 切片 6c:方法行——this 槽/型置位(发射后复位)。
        val this_h_row = fn_this.get(r) ?? 0
        cur_this_h = this_h_row
        cur_this_slot = 0
        flow_stopped = false
        clear_u64_list(loop_breaks)
        clear_u64_list(loop_conts)
        while defer_bodies.len() > 0 { defer_bodies.pop() }
        val fmod = fn_mods.get(r) ?? entry.name
        val fmast = fn_asts.get(r) ?? entry
        cur_fn_mod = fmod
        // 切片 6f:体上下文(使用驱动扫描源)。6g:函数引用(conv 建块)。
        cur_body_eid = fn_bodies.get(r) ?? 0
        cur_farena = if true { fmast.arena } else { null }
        cur_fn_ref = fref
        if this_h_row != 0 {
            match slots.get("this") {
                null => {}
                ts0 => { cur_this_slot = ts0 ?? 0 }
            }
        }
        // 切片 6b:泛型实例行——重放类型到全局 expr_types(与 check
        // 期同序);重放内嵌套实例化追加新实例,pending 拾取续注册。
        // 切片 6e:-2 = 泛型类型方法实例行——this 绑定重放(接收者
        // 实例型;TThis/裸字段经 this 解析,类型参数 → 实参代换)。
        // 切片 6f:两类实例行发射前置类型参绑定上下文(幽灵派生键源)。
        cur_gtps = []
        cur_gargs = []
        val rid = fn_inst_ids.get(r) ?? -1
        if rid >= 0 {
            ty_overlay = Map.empty<str, u32>()
            match s.monomorph_instances.get(rid as usize) {
                null => {}
                m2 => {
                    val mi2 = m2 ?? Data.Mono(0, "", "", [], 0, false, 0)
                    Mono.replay_instance_types(a, s, mi2, ftab, mono_inprog)
                    match (ftab.decls.get("{mi2.module_name}\u{0}{mi2.func_name}") ?? Mono.m_decls_dummy()).decl {
                        FunDeclD(_, _, gtps2, _, _, _, _, _, _, _) => {
                            var gn: str[] = []
                            var gk: usize = 0
                            while gk < gtps2.len() {
                                gn = gn ++ [gtps2[gk].name]
                                gk = gk + 1
                            }
                            cur_gtps = gn
                        },
                        _ => {},
                    }
                    var ga: u32[] = []
                    var gi: usize = 0
                    while gi < mi2.type_args.len() {
                        ga = ga ++ [sanitize_arg(a, s, mi2.type_args[gi])]
                        gi = gi + 1
                    }
                    cur_gargs = ga
                },
            }
            register_pending_instances(lib, ctx, module, a, s, cache, ftab, entry, dep_mods)
        }
        if rid == -2 {
            ty_overlay = Map.empty<str, u32>()
            match meth_row_keys.get("{r}") {
                null => {}
                mk0 => {
                    val mk = mk0 ?? ""
                    val pos = Semares.find_last_sub(mk, "\u{0}")
                    if pos >= 0 {
                        val mcanon = Str.substring(mk, 0, pos as usize)
                        val mname2 = Str.substring(mk, (pos + 1) as usize, mk.len())
                        val mrecv = fn_this.get(r) ?? 0
                        val margs = Arena.adt_parts(a, Arena.resolve(a, mrecv)).b
                        match find_method_decl(s, mcanon, mname2) {
                            null => {}
                            mf0 => {
                                val mf = mf0 ?? MFound([], Md("", [], [], null, 0i64, false, null, Priv, false),
                                    all_mods.get(0) ?? ModuleAst("", null, AstArena(List.empty<Se>(), List.empty<Ss>(), List.empty<St>(), List.empty<Spn>()), []), "")
                                Mono.replay_method_body(a, s, mf.tps, mf.md.params, mf.md.rt,
                                    mf.md.body ?? 0, mname2, margs, mrecv, mf.mast.arena, ftab, mono_inprog, mf.mname)
                                cur_gtps = mf.tps
                                cur_gargs = margs
                                register_pending_instances(lib, ctx, module, a, s, cache, ftab, entry, dep_mods)
                            },
                        }
                    }
                },
            }
        }
        val body = fn_bodies.get(r) ?? 0
        match fmast.arena.expr(body).node {
            BlockE(stmts, tail) => {
                var k: usize = 0
                while k < stmts.len() && !flow_stopped {
                    match lower_stmt(lib, ctx, builder, fref, a, s, fmod, fmast.arena,
                        slots, tyslots, cache, stmts[k]) {
                        Ok(_) => {}
                        Error(e) => throw e
                    }
                    k = k + 1
                }
                if !flow_stopped {
                    match tail {
                        null => {
                            emit_pending_defers(lib, ctx, builder, fref, a, s, fmod, fmast.arena,
                                slots, tyslots, cache)?
                            emit_implicit_ret(lib, ctx, builder, cache, a, s, cur_ret_h, cur_is_main)?
                            // 终止指令已发——必须置位,否则外层兜底
                            // emit_implicit_ret 再补一发 = 双终结符
                            // (void 函数首证,切片 1 起潜伏)。
                            flow_stopped = true
                        }
                        te => {
                            val v = lower_expr(lib, ctx, builder, fref, a, s, fmod, fmast.arena,
                                slots, tyslots, cache, te ?? 0)?
                            if !flow_stopped {
                                if cur_is_main {
                                    val v_h = expr_ty(a, s, fmod, te ?? 0)?
                                    // 切片 6g:async void main 的尾表达式 =
                                    // void(async 分支族)→ 隐式 ret 0。
                                    if main_tail_nonint(a, v_h) {
                                        emit_pending_defers(lib, ctx, builder, fref, a, s, fmod, fmast.arena,
                                            slots, tyslots, cache)?
                                        Llvm.build_ret(lib, builder, Llvm.const_int(lib,
                                            llty_for(lib, ctx, cache, TI32)?, 0u64, false)?)?
                                    } else {
                                        val vc = conv_to_i32(lib, ctx, builder, cache, a, v, v_h, tmp())?
                                        emit_pending_defers(lib, ctx, builder, fref, a, s, fmod, fmast.arena,
                                            slots, tyslots, cache)?
                                        Llvm.build_ret(lib, builder, vc)?
                                    }
                                } else {
                                    val v_h = expr_ty(a, s, fmod, te ?? 0)?
                                    val vc = conv_value(lib, ctx, builder, cache, a, s,v, v_h, cur_ret_h, tmp())?
                                    emit_pending_defers(lib, ctx, builder, fref, a, s, fmod, fmast.arena,
                                        slots, tyslots, cache)?
                                    Llvm.build_ret(lib, builder, vc)?
                                }
                                flow_stopped = true
                            }
                        },
                    }
                }
            },
            _ => {
                val v = lower_expr(lib, ctx, builder, fref, a, s, fmod, fmast.arena,
                    slots, tyslots, cache, body)?
                if !flow_stopped {
                    if cur_is_main {
                        val v_h = expr_ty(a, s, entry.name, body)?
                        if main_tail_nonint(a, v_h) {
                            Llvm.build_ret(lib, builder, Llvm.const_int(lib,
                                llty_for(lib, ctx, cache, TI32)?, 0u64, false)?)?
                        } else {
                            val vc = conv_to_i32(lib, ctx, builder, cache, a, v, v_h, tmp())?
                            Llvm.build_ret(lib, builder, vc)?
                        }
                    } else {
                        val v_h = expr_ty(a, s, entry.name, body)?
                        val vc = conv_value(lib, ctx, builder, cache, a, s,v, v_h, cur_ret_h, tmp())?
                        Llvm.build_ret(lib, builder, vc)?
                    }
                    flow_stopped = true
                }
            },
        }
        if !flow_stopped {
            emit_implicit_ret(lib, ctx, builder, cache, a, s, cur_ret_h, cur_is_main)?
        }
        Llvm.dispose_builder(lib, builder)
        r = r + 1
    }
    // 4) verify → O2 IR 优化 → emit .obj(verify 失败透传 IR 文本辅助定位)。
    if !(Llvm.verify_module(lib, module)?) {
        match Llvm.print_module_ir(lib, module) {
            Ok(text) => { eprintln(text) }
            Error(_) => {}
        }
        throw FfiError(Other, "slice 0: emitted module failed LLVM verification")
    }
    // 调试门(FROND_NATIVE_DUMP_IR=1):verify 后、O2 前导出模块 IR 文本
    // 到 stderr(native 语义对拍定位用;不影响产物)。
    if Env.get("FROND_NATIVE_DUMP_IR") == "1" {
        match Llvm.print_module_ir(lib, module) {
            Ok(text) => { eprintln(text) }
            Error(_) => {}
        }
    }
    Llvm.run_passes(lib, module, "default<O2>", tm)?
    Llvm.emit_to_file(lib, tm, module, obj_path, true)?
    Llvm.dispose_target_machine(lib, tm)
    Llvm.dispose_module(lib, module)
    Llvm.dispose_context(lib, ctx)
    lib.close()
    Ok(void)
}
