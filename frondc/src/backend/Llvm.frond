// pred:LLVMIntPredicate 枚举值(EQ=32..SLE=41;Core.h)。⚠ LLVM 21 参数
// 序 = (builder, pred, lhs, rhs, name)——谓词在第 2 位(与旧文献的
// 第 4 位相反;传错位 = 小整数被当 Value* unwrap,段错误,实测)。
pub fun build_icmp(lib: Lib, builder: u64, lhs: u64, rhs: u64, pred: u32, name: str): Throw<u64, FfiError> {
    val f: ForeignFn<u64> = lib.lookup("LLVMBuildICmp", "u64, u32, u64, u64, cstr")?
    f.call(builder, pred, lhs, rhs, name)
}

// pred:LLVMRealPredicate 枚举值(OEQ=1..UNE=14;NaN 参与即假 = O 族,
// 与引擎 IEEE754 比较语义一致)。参数序同上(谓词第 2 位)。
pub fun build_fcmp(lib: Lib, builder: u64, lhs: u64, rhs: u64, pred: u32, name: str): Throw<u64, FfiError> {
    val f: ForeignFn<u64> = lib.lookup("LLVMBuildFCmp", "u64, u32, u64, u64, cstr")?
    f.call(builder, pred, lhs, rhs, name)
}

