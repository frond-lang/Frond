}

// ── PassBuilder(O2 IR 优化;mem2reg 吃掉 naive alloca)────────────

// LLVMRunPasses(module, passes, tm, options);成功 = 0。options **不可为
// NULL**——21.1.8 实现直接 unwrap(Options) 解引用(实测段错误),必须
// LLVMCreatePassBuilderOptions 真建对象,用毕 Dispose。
// 失败消息走 LLVMGetErrorMessage(配 LLVMDisposeErrorMessage 释放,与
// LLVMDisposeMessage 不同族)。
pub fun run_passes(lib: Lib, module: u64, passes: str, tm: u64): Throw<void, FfiError> {
    val mk: ForeignFn<u64> = lib.lookup("LLVMCreatePassBuilderOptions", "")?
    val opts = mk.call()?
    val f: ForeignFn<u64> = lib.lookup("LLVMRunPasses", "u64, cstr, u64, u64")?
    val rc = f.call(module, passes, tm, opts)?
    match lib.lookup("LLVMDisposePassBuilderOptions", "u64") {
        Ok(free_opts) => {
            match free_opts.call(opts) {
                Ok(_) => {}
                Error(_) => {}
            }
        },
        Error(_) => {}
    }
    if rc != 0u64 {
        var msg = "unknown pass error"
        val get_msg: ForeignFn<u64> = lib.lookup("LLVMGetErrorMessage", "u64")?
        val mptr = get_msg.call(rc)?
        if mptr != 0u64 {
            val crt = Lib.open(crt_lib_name())?
            msg = read_cstr(crt, mptr)?
            crt.close()
            val free_msg: ForeignFn<void> = lib.lookup("LLVMDisposeErrorMessage", "cstr")?
            match free_msg.call(mptr) {
                Ok(_) => {}
                Error(_) => {}
            }
        }
        throw FfiError(CallFailed, "LLVMRunPasses('{passes}') failed: {msg}")
    }
    Ok(void)
}

// ── 控制流 + 调用(Stage 2 切片 1)────────────────────────────────

pub fun void_type(lib: Lib, ctx: u64): Throw<u64, FfiError> {
    val f: ForeignFn<u64> = lib.lookup("LLVMVoidTypeInContext", "u64")?
    f.call(ctx)
}

pub fun build_cond_br(lib: Lib, builder: u64, cond: u64, then_blk: u64, else_blk: u64): Throw<void, FfiError> {
    val f: ForeignFn<void> = lib.lookup("LLVMBuildCondBr", "u64, u64, u64, u64")?
    f.call(builder, cond, then_blk, else_blk)
}

pub fun build_br(lib: Lib, builder: u64, blk: u64): Throw<void, FfiError> {
    val f: ForeignFn<void> = lib.lookup("LLVMBuildBr", "u64, u64")?
    f.call(builder, blk)
}

// 两个分支都终止后的空 merge 块需要终结指令,否则 verifier 拒绝。
pub fun build_unreachable(lib: Lib, builder: u64): Throw<void, FfiError> {
    val f: ForeignFn<void> = lib.lookup("LLVMBuildUnreachable", "u64")?
    f.call(builder)
}

// LLVMBuildCall2(opaque pointers 必须带 fn 类型);args 走 cbuf 整体编组。
pub fun build_call2(lib: Lib, builder: u64, fn_ty: u64, fn_ref: u64, args: u64[], name: str): Throw<u64, FfiError> {
    val f: ForeignFn<u64> = lib.lookup("LLVMBuildCall2", "u64, u64, u64, cbuf, u32, cstr")?
    f.call(builder, fn_ty, fn_ref, args, args.len() as u32, name)
}

// 零参变体(空 u64[] 不能按 cbuf 编组,元素类型无从判定;NULL 合法)。
pub fun build_call2_0(lib: Lib, builder: u64, fn_ty: u64, fn_ref: u64, name: str): Throw<u64, FfiError> {
    val f: ForeignFn<u64> = lib.lookup("LLVMBuildCall2", "u64, u64, u64, u64, u32, cstr")?
    f.call(builder, fn_ty, fn_ref, 0u64, 0u32, name)
}

// ── 聚合/全局(Stage 2 切片 2)────────────────────────────────────
// 签名逐条对照仓库内 llvm-c/Core.h(LLVM 21 源码,行号注记)——谓词
// 位次教训(附二雷 1)的落地纪律:不看旧文献,只看本地头文件。

// opaque ptr(context-scoped;record/str/数组三形态的统一值表示)。
// Core.h L1682:LLVMPointerTypeInContext(C, AddressSpace)。
pub fun ptr_type(lib: Lib, ctx: u64): Throw<u64, FfiError> {
    val f: ForeignFn<u64> = lib.lookup("LLVMPointerTypeInContext", "u64, u32")?
    f.call(ctx, 0u32)
}

// 字面 struct 类型(record 指针指向的布局)。Core.h L1493:
// LLVMStructTypeInContext(C, ElementTypes, ElementCount, Packed)。
pub fun struct_type(lib: Lib, ctx: u64, elem_types: u64[]): Throw<u64, FfiError> {
    val f: ForeignFn<u64> = lib.lookup("LLVMStructTypeInContext", "u64, cbuf, u32, u32")?
    f.call(ctx, elem_types, elem_types.len() as u32, 0u32)
}

// 零字段变体(空 record 的 {} 布局;空 u64[] 不能按 cbuf 编组,params 位
// 传 NULL,同 function_type0 口径)。
pub fun struct_type0(lib: Lib, ctx: u64): Throw<u64, FfiError> {
    val f: ForeignFn<u64> = lib.lookup("LLVMStructTypeInContext", "u64, u64, u32, u32")?
    f.call(ctx, 0u64, 0u32, 0u32)
}

// 定长数组类型。Core.h L1634:LLVMArrayType2(ElementType, uint64 Count)
// (LLVMArrayType 的 u32 计数版已弃用)。
pub fun array_type2(lib: Lib, elem_ty: u64, count: u64): Throw<u64, FfiError> {
    val f: ForeignFn<u64> = lib.lookup("LLVMArrayType2", "u64, u64")?
    f.call(elem_ty, count)
}

// 匿名 struct 常量(str 全局常量的 {i64, [N x i8]} 初始化;与具名
// struct 类型结构同一即合法)。Core.h L2425。
pub fun const_struct(lib: Lib, ctx: u64, vals: u64[]): Throw<u64, FfiError> {
    val f: ForeignFn<u64> = lib.lookup("LLVMConstStructInContext", "u64, cbuf, u32, u32")?
    f.call(ctx, vals, vals.len() as u32, 0u32)
}

// 字节常量 [N x i8]。Core.h L2378 ConstStringInContext2:size_t 显式
// 长度(内嵌 NUL 安全);DontNullTerminate=1 不追加 NUL。空串由调用方
// 走 const_null 兜底(空常量的 null 返回歧义)。
pub fun const_string2(lib: Lib, ctx: u64, s: str, byte_len: usize): Throw<u64, FfiError> {
    val f: ForeignFn<u64> = lib.lookup("LLVMConstStringInContext2", "u64, cstr, usize, u32")?
    val v = f.call(ctx, s, byte_len, 1u32)?
    if v == 0u64 {
        throw FfiError(Other, "LLVMConstStringInContext2 failed (len {byte_len})")
    }
    Ok(v)
}

// 零Initializer(zeroinitializer/@frond_heap 零页;也作 ptr null 兜底)。
// Core.h L2201。
pub fun const_null(lib: Lib, ty: u64): Throw<u64, FfiError> {
    val f: ForeignFn<u64> = lib.lookup("LLVMConstNull", "u64")?
    f.call(ty)
}

// 模块全局变量(返回值即 ptr 形句柄,可直接 load/store/传参)。
// Core.h L2753:LLVMAddGlobal(M, Ty, Name)。
pub fun add_global(lib: Lib, module: u64, ty: u64, name: str): Throw<u64, FfiError> {
    val f: ForeignFn<u64> = lib.lookup("LLVMAddGlobal", "u64, u64, cstr")?
    f.call(module, ty, name)
}

// Core.h L2769(LLVMSetInitializer, void API):初始值可以是常量,
// 也可以是另一个全局变量句柄(@frond_heap_top = global ptr @frond_heap)。
pub fun set_initializer(lib: Lib, global: u64, v: u64): Throw<void, FfiError> {
    val f: ForeignFn<void> = lib.lookup("LLVMSetInitializer", "u64, u64")?
    f.call(global, v)
}

// Core.h L2775(LLVMSetGlobalConstant, void):str 字面量全局只读。
pub fun set_global_constant(lib: Lib, global: u64, is_const: bool): Throw<void, FfiError> {
    val flag = if is_const { 1u32 } else { 0u32 }
    val f: ForeignFn<void> = lib.lookup("LLVMSetGlobalConstant", "u64, u32")?
    f.call(global, flag)
}

// Core.h L2631(LLVMSetLinkage, void):Private=9(枚举序:External=0
// …Appending=7, Internal=8, Private=9),str 字面量私有防链接撞名。
pub fun set_linkage_private(lib: Lib, global: u64): Throw<void, FfiError> {
    val f: ForeignFn<void> = lib.lookup("LLVMSetLinkage", "u64, u32")?
    f.call(global, 9u32)
}

// 字段地址。Core.h L4716 StructGEP2:opaque pointers 须显式给 struct
// 类型(builder, ty, ptr, idx, name)。
pub fun build_struct_gep(lib: Lib, builder: u64, struct_ty: u64, ptr: u64, idx: u32,
    name: str): Throw<u64, FfiError> {
    val f: ForeignFn<u64> = lib.lookup("LLVMBuildStructGEP2", "u64, u64, u64, u32, cstr")?
    f.call(builder, struct_ty, ptr, idx, name)
}

// 逐索引元素地址(inbounds)。Core.h L4701 InBoundsGEP2:(builder, ty,
// ptr, indices, count, name);indices 形如 [i64 0, i32 1, i64 i]
// (struct 头弹性尾)。注意:i8 基型仅容单索引——字节步进须先把偏移
// 加总成单索引(i8 无嵌套层可索引,双索引会被 LLVM 以
// "Invalid indices for GEP pointer type" 拒绝)。
pub fun build_inbounds_gep2(lib: Lib, builder: u64, ty: u64, ptr: u64, indices: u64[],
    name: str): Throw<u64, FfiError> {
    val f: ForeignFn<u64> = lib.lookup("LLVMBuildInBoundsGEP2", "u64, u64, u64, cbuf, u32, cstr")?
    f.call(builder, ty, ptr, indices, indices.len() as u32, name)
}

// Core.h L4758/4760:ptr ↔ 整型(bump arena 的 top 前沿整数算术)。
pub fun build_ptrtoint(lib: Lib, builder: u64, v: u64, dest_ty: u64, name: str): Throw<u64, FfiError> {
    val f: ForeignFn<u64> = lib.lookup("LLVMBuildPtrToInt", "u64, u64, u64, cstr")?
    f.call(builder, v, dest_ty, name)
}

pub fun build_inttoptr(lib: Lib, builder: u64, v: u64, dest_ty: u64, name: str): Throw<u64, FfiError> {
    val f: ForeignFn<u64> = lib.lookup("LLVMBuildIntToPtr", "u64, u64, u64, cstr")?
    f.call(builder, v, dest_ty, name)
}

// ── TargetData(聚合大小;Stage 2 切片 2)─────────────────────────

// TargetMachine.h:LLVMCreateTargetDataLayout(TM) — 从目标机导出
// DataLayout(布局规则与 emit 的 .obj 一致)。
pub fun create_target_data_layout(lib: Lib, tm: u64): Throw<u64, FfiError> {
    val f: ForeignFn<u64> = lib.lookup("LLVMCreateTargetDataLayout", "u64")?
    val td = f.call(tm)?
    if td == 0u64 {
        throw FfiError(Other, "LLVMCreateTargetDataLayout returned null")
    }
    Ok(td)
}

// Target.h L263:LLVMABISizeOfType(TD, Ty) — 含 padding 的分配尺寸
// (frond_alloc 的大小参数;unsigned long long = u64)。
pub fun abi_size_of_type(lib: Lib, td: u64, ty: u64): Throw<u64, FfiError> {
    val f: ForeignFn<u64> = lib.lookup("LLVMABISizeOfType", "u64, u64")?
    f.call(td, ty)
}

// Target.h L294:LLVMOffsetOfElement(TD, StructTy, Element) — struct 字段
// 字节偏移(数组块 {i64 len, elem...} 的元素基址 = 8;record 字段 GEP
// 按位次已由 StructGEP2 覆盖,此查询用于 i8 步进 GEP 路径)。
pub fun offset_of_element(lib: Lib, td: u64, struct_ty: u64, element: u32): Throw<u64, FfiError> {
    val f: ForeignFn<u64> = lib.lookup("LLVMOffsetOfElement", "u64, u64, u32")?
    f.call(td, struct_ty, element)
}

// ── TargetMachine ──────────────────────────────────────────────────

pub fun get_target(lib: Lib, triple: str): Throw<u64, FfiError> {
    val f: ForeignFn<i32> = lib.lookup("LLVMGetTargetFromTriple", "cstr, cbuf, cbuf")?
    val target_buf: u64[] = [0u64]
    val err_buf: u64[] = [0u64]
    val rc = f.call(triple, target_buf, err_buf)?
    if rc != 0 || target_buf[0] == 0u64 {
        throw FfiError(Other, "LLVMGetTargetFromTriple failed for " + triple)
    }
    Ok(target_buf[0])
}

// opt_level/reloc/code_model 对应 LLVMCodeGenOptLevel/LLVMRelocMode/
// LLVMCodeModel 的枚举值(Default 分别为 2/0/0)。
pub fun create_target_machine(
    lib: Lib, target: u64, triple: str, cpu: str, features: str,
    opt_level: u32, reloc: u32, code_model: u32,
): Throw<u64, FfiError> {
    val f: ForeignFn<u64> = lib.lookup(
        "LLVMCreateTargetMachine", "u64, cstr, cstr, cstr, u32, u32, u32")?
    val tm = f.call(target, triple, cpu, features, opt_level, reloc, code_model)?
    if tm == 0u64 {
        throw FfiError(Other, "LLVMCreateTargetMachine returned null")
    }
    Ok(tm)
}

pub fun dispose_target_machine(lib: Lib, tm: u64): void {
    match lib.lookup("LLVMDisposeTargetMachine", "u64") {
        Ok(f) => {
            match f.call(tm) {
                Ok(_) => {}
                Error(_) => {}
            }
        },
        Error(_) => {}
    }
}

// object_file=false 产出目标汇编(Windows 上 MASM 风格);true 产出目标文件。
pub fun emit_to_file(lib: Lib, tm: u64, module: u64, path: str, object_file: bool): Throw<void, FfiError> {
    val ft = if object_file { 1u32 } else { 0u32 }
    val f: ForeignFn<i32> = lib.lookup("LLVMTargetMachineEmitToFile", "u64, u64, cstr, u32, cbuf")?
    // 错误消息出参必须给真缓冲:传 NULL 时 emit 失败(如输出目录不存在)
    // 会直接段错误而不是返回错误——CI 全新 checkout 无 out/ 目录时踩中。
    val err_buf: u64[] = [0u64]
    val rc = f.call(tm, module, path, ft, err_buf)?
    if rc != 0 {
        var msg = "unknown emit failure"
        if err_buf[0] != 0u64 {
            val crt = Lib.open(crt_lib_name())?
            msg = read_cstr(crt, err_buf[0])?
            crt.close()
            match lib.lookup("LLVMDisposeMessage", "cstr") {
                Ok(free_msg) => {
                    match free_msg.call(err_buf[0]) {
                        Ok(_) => {}
                        Error(_) => {}
                    }
                },
                Error(_) => {}
            }
        }
        throw FfiError(CallFailed, "LLVMTargetMachineEmitToFile failed for " + path + ": " + msg)
    }
    Ok(void)
}
