// 整常量(LLVMConstInt;负数按位型传,如 (-1i64) as u64)。
pub fun const_int(lib: Lib, int_ty: u64, value: u64, sign_extend: bool): Throw<u64, FfiError> {
    val flag = if sign_extend { 1u32 } else { 0u32 }
    val f: ForeignFn<u64> = lib.lookup("LLVMConstInt", "u64, u64, u32")?
    f.call(int_ty, value, flag)
}

pub fun build_ret(lib: Lib, builder: u64, v: u64): Throw<void, FfiError> {
    val f: ForeignFn<void> = lib.lookup("LLVMBuildRet", "u64, u64")?
    f.call(builder, v)
}

pub fun build_ret_void(lib: Lib, builder: u64): Throw<void, FfiError> {
    val f: ForeignFn<void> = lib.lookup("LLVMBuildRetVoid", "u64")?
    f.call(builder)
}

