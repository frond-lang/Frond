// backend/Llvm.frond — frondc 后端的 LLVM C API 绑定(Stage 2)。
// 单一来源(2026-09-04 裁决删除 libs/llvm 模板:零 import 消费者、
// 三副本发散、val 参数名 bug 潜伏数日无人发现);llvm_bind/llvm_probe
// 测试仍持各自副本,随引擎验收演进。
//
// v1 形态:句柄一律裸 u64,API 全自由函数(lib 为首参)。
// 裸 u64 形态保留原因(历史注记更正 2026-09-04):曾因"record 字段读回
// 软类型值,FFI marshal 只认硬 tag"禁 record 封装——该洞已被引擎治好
// (handleprobe 实证:单字段/混合家族/嵌套/List 装载的 record 字段读回
// 值过 LLVMTypeOf 全绿);裸形态纯属简洁,非性能或正确性约束。
//
// 其余约定:
// - const char* 参数走 cstr 原子(单槽 NUL 结尾);缓冲/出参走 cbuf;
//   裸句柄参数位传 0u64 表示 NULL。
// - 每个 API 内部 lookup + call:正确性优先(lookup 的 parse + dlsym 相对
//   LLVM 操作本身是小开销);热路径用户应直接缓存 ForeignFn。
// - 平台自适应:target 初始化按 arch 选 X86/AArch64;read_cstr 的 CRT
//   库名按 os 选。

import std.os.Info

// ── 平台映射 ────────────────────────────────────────────────────────

// read_cstr 所用的系统 CRT 库名(只依赖 strlen/memcpy 两个符号)。
pub fun crt_lib_name(): str {
    val os = Info.os_name()
    if os == "windows" {
        return "msvcrt.dll"
    }
    if os == "macos" {
        return "libSystem.B.dylib"
    }
    "libc.so.6"
}

// 宿主 triple(与 llvm-static CI 资产命名一致);交叉目标由用户自传。
pub fun host_triple(): str {
    val os = Info.os_name()
    val arch = Info.arch()
    if os == "windows" {
        return "x86_64-pc-windows-msvc"
    }
    if os == "linux" {
        if arch == "aarch64" {
            return "aarch64-unknown-linux-gnu"
        }
        return "x86_64-unknown-linux-gnu"
    }
    if os == "macos" {
        if arch == "aarch64" {
            return "aarch64-apple-darwin"
        }
        return "x86_64-apple-darwin"
    }
    ""
}

// ── 跨世界字符串桥 ──────────────────────────────────────────────────

// 把 C 世界的 char* 读成 Frond str:strlen 定长 + memcpy(cbuf 写回)
// + u8[] as str(UTF-8 校验保留)。零原生原语。
pub fun read_cstr(lib: Lib, ptr: u64): Throw<str, FfiError> {
    val strlen_fn: ForeignFn<u64> = lib.lookup("strlen", "cstr")?
    val n = strlen_fn.call(ptr)?
    val count = n as usize
    val buf: u8[] = [0u8, ..count]
    val memcpy_fn: ForeignFn<u64> = lib.lookup("memcpy", "cbuf, cstr, usize")?
    memcpy_fn.call(buf, ptr, count)?
    Ok(buf as str)
}

// ── target 初始化(重复调用幂等)───────────────────────────────────
// 注:曾展开显式符号名规避"迭代器元素 str 拼接经 lookup 判非 str"的
// 疑似洞——已实证不成立(2026-09-04 handleprobe:迭代拼接名过 lookup+
// call 全绿);保留展开写法仅为直白。

fun init_one(lib: Lib, name: str): Throw<void, FfiError> {
    val f: ForeignFn<void> = lib.lookup(name, "")?
    f.call()?
    Ok(void)
}

pub fun init_host_target(lib: Lib): Throw<void, FfiError> {
    if Info.arch() == "aarch64" {
        init_one(lib, "LLVMInitializeAArch64TargetInfo")?
        init_one(lib, "LLVMInitializeAArch64Target")?
        init_one(lib, "LLVMInitializeAArch64TargetMC")?
        init_one(lib, "LLVMInitializeAArch64AsmPrinter")?
    } else {
        init_one(lib, "LLVMInitializeX86TargetInfo")?
        init_one(lib, "LLVMInitializeX86Target")?
        init_one(lib, "LLVMInitializeX86TargetMC")?
        init_one(lib, "LLVMInitializeX86AsmPrinter")?
    }
    Ok(void)
}

// ── Context / Module ───────────────────────────────────────────────

pub fun create_context(lib: Lib): Throw<u64, FfiError> {
    val f: ForeignFn<u64> = lib.lookup("LLVMContextCreate", "")?
    f.call()
}

pub fun dispose_context(lib: Lib, ctx: u64): void {
    match lib.lookup("LLVMContextDispose", "u64") {
        Ok(f) => {
            match f.call(ctx) {
                Ok(_) => {}
                Error(_) => {}
            }
        },
        Error(_) => {}
    }
}

pub fun create_module(lib: Lib, name: str, ctx: u64): Throw<u64, FfiError> {
    val f: ForeignFn<u64> = lib.lookup("LLVMModuleCreateWithNameInContext", "cstr, u64")?
    f.call(name, ctx)
}

pub fun dispose_module(lib: Lib, module: u64): void {
    match lib.lookup("LLVMDisposeModule", "u64") {
        Ok(f) => {
            match f.call(module) {
                Ok(_) => {}
                Error(_) => {}
            }
        },
        Error(_) => {}
    }
}

// ── 类型构造(context-scoped)──────────────────────────────────────

pub fun i32_type(lib: Lib, ctx: u64): Throw<u64, FfiError> {
    val f: ForeignFn<u64> = lib.lookup("LLVMInt32TypeInContext", "u64")?
    f.call(ctx)
}

pub fun i64_type(lib: Lib, ctx: u64): Throw<u64, FfiError> {
    val f: ForeignFn<u64> = lib.lookup("LLVMInt64TypeInContext", "u64")?
    f.call(ctx)
}

pub fun function_type(lib: Lib, ret: u64, params: u64[], is_vararg: bool): Throw<u64, FfiError> {
    val flag = if is_vararg { 1u32 } else { 0u32 }
    val f: ForeignFn<u64> = lib.lookup("LLVMFunctionType", "u64, cbuf, u32, u32")?
    f.call(ret, params, params.len() as u32, flag)
}

// 零参变体:params 位传 NULL(裸 u64 句柄位 0u64 = NULL,见文件头约定);
// 空 u64[] 无法按 cbuf 编组(元素类型无从判定)。
pub fun function_type0(lib: Lib, ret: u64, is_vararg: bool): Throw<u64, FfiError> {
    val flag = if is_vararg { 1u32 } else { 0u32 }
    val f: ForeignFn<u64> = lib.lookup("LLVMFunctionType", "u64, u64, u32, u32")?
    f.call(ret, 0u64, 0u32, flag)
}

// ── 函数 / 块 ──────────────────────────────────────────────────────

pub fun add_function(lib: Lib, module: u64, name: str, fn_type: u64): Throw<u64, FfiError> {
    val f: ForeignFn<u64> = lib.lookup("LLVMAddFunction", "u64, cstr, u64")?
    f.call(module, name, fn_type)
}

// 在函数末尾追加基本块。func = LLVMValueRef(LLVMAddFunction 的返回),
// 注意不是 module —— LLVMAppendBasicBlockInContext 收的是函数值引用。
pub fun append_block(lib: Lib, ctx: u64, func: u64, name: str): Throw<u64, FfiError> {
    val f: ForeignFn<u64> = lib.lookup("LLVMAppendBasicBlockInContext", "u64, u64, cstr")?
    f.call(ctx, func, name)
}

pub fun get_param(lib: Lib, func: u64, index: u32): Throw<u64, FfiError> {
    val f: ForeignFn<u64> = lib.lookup("LLVMGetParam", "u64, u32")?
    f.call(func, index)
}

// 返回 true 当且仅当模块通过 verifier(action=ReturnStatus,消息丢弃)。
pub fun verify_module(lib: Lib, module: u64): Throw<bool, FfiError> {
    val f: ForeignFn<i32> = lib.lookup("LLVMVerifyModule", "u64, u32, cbuf")?
    val rc = f.call(module, 0u32, 0u64)?
    Ok(rc == 0)
}

// 模块 IR 文本(LLVMPrintModuleToString → read_cstr;消息内存当场释放)。
pub fun print_module_ir(lib: Lib, module: u64): Throw<str, FfiError> {
    val f: ForeignFn<u64> = lib.lookup("LLVMPrintModuleToString", "u64")?
    val ptr = f.call(module)?
    if ptr == 0u64 {
        throw FfiError(Other, "LLVMPrintModuleToString returned null")
    }
    val free_msg: ForeignFn<void> = lib.lookup("LLVMDisposeMessage", "cstr")?
    val crt = Lib.open(crt_lib_name())?
    val text = read_cstr(crt, ptr)?
    match free_msg.call(ptr) {
        Ok(_) => {}
        Error(_) => {}
    }
    crt.close()
    Ok(text)
}

