// ── 常量(字符串形态;radix 0 = 前缀自动识别,负号按二补位型)──────

// 整常量自文本(LLVMConstIntOfString;解析失败返回 null)。
pub fun const_int_str(lib: Lib, int_ty: u64, text: str, radix: u8): Throw<u64, FfiError> {
    val f: ForeignFn<u64> = lib.lookup("LLVMConstIntOfString", "u64, cstr, u8")?
    val v = f.call(int_ty, text, radix)?
    if v == 0u64 {
        throw FfiError(Other, "LLVMConstIntOfString failed for '{text}' radix {radix}")
    }
    Ok(v)
}

// 浮点常量自文本(LLVMConstRealOfString;十进制与 0x1p3 十六进制浮点
// 全精度直达 APFloat,f128 不丢精度;失败返回 null)。
pub fun const_real_str(lib: Lib, real_ty: u64, text: str): Throw<u64, FfiError> {
    val f: ForeignFn<u64> = lib.lookup("LLVMConstRealOfString", "u64, cstr")?
    val v = f.call(real_ty, text)?
    if v == 0u64 {
        throw FfiError(Other, "LLVMConstRealOfString failed for '{text}'")
    }
    Ok(v)
}

