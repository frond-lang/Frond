// backend/Toolchain.frond — Stage 2 工具链消费(BOOTSTRAP_PLAN 4b/4c)。
//
// 资产解析序(单产物 + 全内嵌 + 无工具链子命令,2026-08-31 裁决):
//   发布态默认 = Assets.extract 从内嵌字节解出(落地前的过渡形态 =
//   下方两级)→ FRONDC_TOOLCHAIN 环境变量(开发态换版本不重编)→
//   <cwd>/assets/toolchain(套件/便携形态)。
// lld 是通用驱动:按 -flavor 分派 darwin/gnu/link。链接参数表按
// 4c 下限矩阵:macOS 零库(无外部符号的程序)+ -platform_version 11.0;
// Linux 用资产 linkview 的 crt + 真身 libc;Windows 用 mingw 视图。
import std.os.Env
import std.os.Info
import std.os.Proc
import std.core.types.Str

pub fun toolchain_dir(): str {
    val env = Env.get("FRONDC_TOOLCHAIN")
    if env != "" {
        return env
    }
    "assets/toolchain"
}

// 资产 LLVM 动态库(统一逻辑名,lib/ 下按平台扩展名;Lib 按内容识别,
// 后缀无关)。dev/发布同一条路径:发布态资产先经 Assets.extract 落到
// 解析序指向的目录。
pub fun open_llvm(): Throw<Lib, FfiError> {
    val os = Info.os_name()
    val file = if os == "windows" {
        "llvm.dll"
    } else if os == "macos" {
        "llvm.dylib"
    } else {
        "llvm.so"
    }
    Lib.open(toolchain_dir() + "/lib/" + file)
}

pub fun link_args(tc: str, os: str, arch: str, obj: str, exe: str): str[] {
    if os == "macos" {
        // 零外部符号 → 零库链接(产物无 LC_LOAD_DYLIB)。真 C 层时代
        // 需 macOS 链接视图(系统盘上已无 libSystem 真身),见 4c 记账。
        val a = if arch == "aarch64" { "arm64" } else { "x86_64" }
        return ["-flavor", "darwin", obj,
                "-arch", a, "-platform_version", "macos", "11.0", "15.0",
                "-o", exe]
    }
    if os == "windows" {
        return ["-flavor", "link", obj,
                tc + "/linkview/crt2.o",
                tc + "/linkview/libmingw32.a",
                tc + "/linkview/libmingwex.a",
                tc + "/linkview/libgcc.a",
                tc + "/linkview/libmsvcrt.a",
                tc + "/linkview/libkernel32.a",
                "/entry:mainCRTStartup", "/subsystem:console",
                "/out:" + exe]
    }
    val loader = if arch == "aarch64" {
        "/lib/ld-linux-aarch64.so.1"
    } else {
        "/lib64/ld-linux-x86-64.so.2"
    }
    return ["-flavor", "gnu", obj,
            tc + "/linkview/Scrt1.o",
            tc + "/linkview/crti.o",
            tc + "/linkview/crtn.o",
            tc + "/linkview/libc.so.6",
            tc + "/linkview/libc_nonshared.a",
            "-pie",
            "-dynamic-linker", loader,
            "-o", exe]
}

// 链接失败必须透传诊断:spawn 的子进程输出不落控制台,失败时逐行回显
// (llvm_probe CI 首跑教训——没有它每轮失败都是盲改)。
pub fun link(tc: str, os: str, arch: str, obj: str, exe: str): Throw<i32, str> {
    val out = match Proc.capture(tc + "/bin/lld", link_args(tc, os, arch, obj, exe)) {
        Ok(o) => o,
        Error(e) => throw "spawn lld failed: {e.message}",
    }
    if out.exit_code != 0 {
        val lines = Str.split(out.output, "\n")
        var li: usize = 0
        while li < lines.len() && li < 12 {
            val line = lines[li]
            if line.len() > 0 {
                println("lld| {line}")
            }
            li = li + 1
        }
    }
    Ok(out.exit_code)
}

pub fun run(exe: str): Throw<i32, str> {
    val proc = match Proc.spawn("./" + exe, []) {
        Ok(p) => p,
        Error(e) => throw "spawn {exe} failed: {e.message}",
    }
    match proc.wait() {
        Ok(rc) => Ok(rc),
        Error(e) => throw "wait {exe} failed: {e.message}",
    }
}
