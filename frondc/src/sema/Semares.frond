// Semares.frond — SemaResult(1E):Rust Sema.rs 注册表族的镜像。
//
// 表示裁决(超越镜像原则):
// - type_defs/trait_defs/func_sigs = List(位置即 u16 分配序,从不回收,
//   差分管线无 incremental purge → 无空洞);
// - 五张 Sym 键表 → Map<str, i64> / Map<str, str>(Rust 侧 Sym 是行为中立
//   优化,dump 全节显式排序,str 键语义等价);
// - ctor_def_index 多值 → Map<str, str>(packed u32 → 十进制串,',' 连接;
//   查询侧解析。省一个 List 值类型);
// - witness 表 = List<WEnt> + Map(trait\0type_id → entry 位);
// - module_imports 多值 → Map<str, str>(',' 连接)。

import std.collections.List
import std.collections.Map
import std.core.types.Str
import syntax.Ast
import sema.Data.{new_err_path}
import sema.Envs.{new_enva}

pub type SemaRes = SemaRes(
    // ── 类型定义表 ──
    pub type_defs: List<TDef>,
    pub type_def_index: Map<str, i64>,
    // idx(str) → 注册模块(put_type_def 的同模块幂等判定)。
    pub type_def_owner: Map<str, str>,
    // ── trait 定义表 ──
    pub trait_defs: List<TTDef>,
    pub trait_def_index: Map<str, i64>,
    // ── 函数签名表(键 = "module\0name")──
    pub func_sigs: List<FSig>,
    pub func_sig_index: Map<str, i64>,
    // 裸名 → 拥有模块(',' 连接,注册序;get_func_sig 裸名消歧用)。
    pub func_sig_owners: Map<str, str>,
    // ── 构造器多值索引(ctor 名 → packed 列表,',' 连接)──
    pub ctor_def_index: Map<str, List<i64>>,
    // ── field_id(键 = "type\0field")──
    pub field_id_map: Map<str, i64>,
    // ── 见证表 ──
    pub witness_entries: List<WEnt>,
    pub witness_index: Map<str, i64>,
    // ── 模块上下文 ──
    pub current_module_name: str,
    pub module_imports: Map<str, str>,
    pub user_module_paths: List<str>,
    pub pending_own_types: List<str>,
    pub pending_own_traits: List<str>,
    pub module_envs: Map<str, u32>,
    pub env: EnvA,
    // std 层绑定 → origin 模块(',' 连接;Bug#103 导入再输出清单)。
    pub std_binding_origins: Map<str, str>,
    // ── 实例表 ──
    pub monomorph_instances: List<Mono>,
    pub trait_default_instances: List<TDefI>,
    pub inherited_method_instances: List<InhI>,
    // ── 表达式访问集(片4a:键 = module + NUL + expr_id,len = stats expr_types)──
    pub expr_keys_len: i64,
    // ── 片4b:表达式类型表(键 = module_expr_key;值 = 解析后类型句柄;
    // put_expr 为 upsert,键集大小 = stats expr_types)。expr_keys_len
    // (片4a 遍历计数)由真实推断取代,保留字段作探针遗留。──
    pub expr_types: Map<str, u32>,
    // 方法分派表(intrinsic 标记 + 泛型方法糖 monomorph 条目;
    // 键 = module_expr_key)。
    pub method_dispatches: Map<str, bool>,
    // ── 片5:monomorph 表 ──
    // 实例缓存键(module\0x01func\0x01args 展示串)→ instance_id。
    pub monomorph_index: Map<str, i64>,
    // 调用点 → 实例(键 = module_expr_key)。
    pub call_instantiations: Map<str, i64>,
    // 实例化模式存储的解析类型(键 = module_expr_key;大小 = stats)。
    pub resolved_types: Map<str, u32>,
    // 模块函数接收者标记(Path 0a/0b/限定 ctor/Lib;monomorph 消费)。
    pub module_func_recv_exprs: Map<str, bool>,
    // super 目标三元组 "type\0trait\0method"(trait-defaults 收集消费)。
    pub super_targets: Map<str, bool>,
    // std origin 子树/目录索引(process_import_decls 一次预建,查询 O(命中数))。
    pub origin_subtree: Map<str, List<str>>,
    pub origin_direct: Map<str, List<str>>,
    pub origin_index_built: bool,
    // alias/dup 检查水位(增量化:每模块只扫新增 type_defs)。
    pub checks_scan_base: usize,
    // ── S2c:选择性导入条目归属(键 = module + NUL + 本地名 → true;
    // 裸名多主零静默的显式豁免面;不进 dump/stats)──
    pub import_alias_owners: Map<str, bool>,
    // ── 诊断 ──
    pub errors: List<SErr>,
    pub warnings: List<SErr>,
    pub has_error: bool,
)

pub fun new_semares(): SemaRes {
    SemaRes(
        List.empty<TDef>(), Map.empty<str, i64>(), Map.empty<str, str>(),
        List.empty<TTDef>(), Map.empty<str, i64>(),
        List.empty<FSig>(), Map.empty<str, i64>(), Map.empty<str, str>(),
        Map.empty<str, List<i64>>(), Map.empty<str, i64>(),
        List.empty<WEnt>(), Map.empty<str, i64>(),
        "", Map.empty<str, str>(), List.empty<str>(), List.empty<str>(), List.empty<str>(),
        Map.empty<str, u32>(), new_enva(), Map.empty<str, str>(),
        List.empty<Mono>(), List.empty<TDefI>(), List.empty<InhI>(),
        0,
        Map.empty<str, u32>(), Map.empty<str, bool>(),
        Map.empty<str, i64>(), Map.empty<str, i64>(), Map.empty<str, u32>(),
        Map.empty<str, bool>(), Map.empty<str, bool>(),
        Map.empty<str, List<str>>(), Map.empty<str, List<str>>(), false,
        0,
        Map.empty<str, bool>(),
        List.empty<SErr>(), List.empty<SErr>(), false,
    )
}

// ─── 小工具 ───────────────────────────────────────────────────────

pub fun list_has_str(items: List<str>, key: str): bool {
    var i: usize = 0
    while i < items.len() {
        if (items.get(i) ?? "") == key {
            return true
        }
        i = i + 1
    }
    false
}

pub fun list_remove_str(items: List<str>, key: str): void {
    var i: usize = 0
    while i < items.len() {
        if (items.get(i) ?? "") == key {
            var k = i
            while k + 1 < items.len() {
                items.set(k, items.get(k + 1) ?? "")
                k = k + 1
            }
            items.pop()
            return
        }
        i = i + 1
    }
}

pub fun str_join(parts: str[], sep: str): str {
    var out = ""
    var i: usize = 0
    while i < parts.len() {
        if i > 0 {
            out = out + sep
        }
        out = out + parts[i]
        i = i + 1
    }
    out
}

// 尾段:last '.' 之后(无 '.' 则原样)。
pub fun tail_seg(s: str): str {
    val parts = Str.split(s, ".")
    if parts.len() == 0 {
        return s
    }
    parts[parts.len() - 1]
}

// 子串最后出现位置(无 = -1)。
pub fun find_last_sub(s: str, sub: str): i64 {
    val sb = s.bytes()
    val ub = sub.bytes()
    if ub.len() == 0 || sb.len() < ub.len() {
        return -1
    }
    var i: i64 = sb.len() as i64 - ub.len() as i64
    while i >= 0 {
        var j: usize = 0
        var hit = true
        while j < ub.len() {
            if sb[(i as usize) + j] != ub[j] {
                hit = false
                break
            }
            j = j + 1
        }
        if hit {
            return i
        }
        i = i - 1
    }
    -1
}

// ',' 连接值追加(去重)。
fun csv_push(m: Map<str, str>, key: str, item: str): void {
    match m.get(key) {
        null => { m.set(key, item) }
        prev => {
            val parts = Str.split(prev, ",")
            var k: usize = 0
            while k < parts.len() {
                if parts[k] == item {
                    return
                }
                k = k + 1
            }
            m.set(key, prev + ",{item}")
        },
    }
}

fun csv_parts(joined: str): str[] {
    if joined.len() == 0 {
        return []
    }
    Str.split(joined, ",")
}

// ─── 键规则(Rust Sema.rs 自由函数)─────────────────────────────────

// "std/io/File.frond" → "std.io.File"(stdlib/ 前缀剥离;非 .frond 尾 = null)。
pub fun module_logical_path(name: str): str? {
    if !Str.ends_with(name, ".frond") {
        return null
    }
    var p = Str.substring(name, 0, name.len() - 6)
    if Str.starts_with(p, "stdlib/") {
        p = Str.substring(p, 7, p.len())
    }
    if p.len() == 0 {
        return null
    }
    Str.replace(p, "/", ".")
}

// 模块内类型的注册键:用户模块带路径前缀("src.Main.List"),std/builtin 裸名。
pub fun canonical_type_key(module_name: str, bare: str): str {
    val is_std = module_name.len() == 0 || Str.starts_with(module_name, "std/")
        || Str.starts_with(module_name, "builtin/")
    if is_std {
        return bare
    }
    match module_logical_path(module_name) {
        null => { bare }
        mp0 => {
            var mp = mp0
            // 入口模块的 loader 键可能是绝对 OS 路径;类型身份锚定最后
            // 一个 ".src." 段 → "src.Main"。
            val pos = find_last_sub(mp, ".src.")
            if pos >= 0 {
                mp = Str.substring(mp, (pos + 1) as usize, mp.len())
            }
            mp + "." + bare
        },
    }
}

// "X[]" → "array"(其余原样)。
pub fun canonical_type_name(name: str): str {
    if Str.ends_with(name, "[]") {
        "array"
    } else {
        name
    }
}

pub fun make_field_key(type_name: str, field_name: str): str {
    type_name + "\u{0}" + field_name
}

fun func_sig_qualified_key(module: str, name: str): str {
    module + "\u{0}" + name
}

// ─── 诊断 ─────────────────────────────────────────────────────────

pub fun add_error(s: SemaRes, err: SErr): void {
    s.has_error = true
    s.errors.push(err)
}

pub fun add_warning(s: SemaRes, err: SErr): void {
    s.warnings.push(err)
}

// ─── 索引读写 ─────────────────────────────────────────────────────

pub fun type_def_idx(s: SemaRes, name: str): i64? {
    s.type_def_index.get(name)
}

pub fun type_def_has(s: SemaRes, name: str): bool {
    s.type_def_index.has(name)
}

fun type_def_set(s: SemaRes, name: str, idx: i64): void {
    s.type_def_index.set(name, idx)
}

pub fun trait_def_idx(s: SemaRes, name: str): i64? {
    s.trait_def_index.get(name)
}

pub fun trait_def_has(s: SemaRes, name: str): bool {
    s.trait_def_index.has(name)
}

fun trait_def_set(s: SemaRes, name: str, idx: i64): void {
    s.trait_def_index.set(name, idx)
}

pub fun func_sig_idx_of(s: SemaRes, module: str, name: str): i64? {
    s.func_sig_index.get(func_sig_qualified_key(module, name))
}

// packed 列表解析(ctor_def_index 值)。
pub fun ctor_packed_list(s: SemaRes, name: str): List<i64> {
    match s.ctor_def_index.get(name) {
        null => { List.empty<i64>() }
        l => { l }
    }
}

pub fun parse_i64_dec(s: str): i64 {
    var v: i64 = 0
    var neg = false
    val b = s.bytes()
    var i: usize = 0
    if b.len() > 0 && b[0] == 45 {
        neg = true
        i = 1
    }
    while i < b.len() {
        if b[i] >= 48 && b[i] <= 57 {
            v = v * 10 + (b[i] as i64 - 48)
        }
        i = i + 1
    }
    if neg {
        -v
    } else {
        v
    }
}

fun ctor_packed_push(s: SemaRes, name: str, packed: i64): void {
    match s.ctor_def_index.get(name) {
        null => {
            val l = List.empty<i64>()
            l.push(packed)
            s.ctor_def_index.set(name, l)
        }
        l => { l.push(packed) },
    }
}

// ─── 类型定义注册 ─────────────────────────────────────────────────

// 插入类型定义 + 索引 + field_id;同名冲突返回 false。
// 同模块重注册(populate 跑两遍)= 静默 no-op;跨模块同名 = 硬错。
pub fun put_type_def(s: SemaRes, def: TDef, module_name: str): bool {
    match type_def_idx(s, def.name) {
        null => {}
        existing => {
            val existing_module = s.type_def_owner.get("{existing}") ?? ""
            if existing_module == module_name {
                return false
            }
            add_error(s, new_err_path("duplicate type definition: '{def.name}'", module_name, 1, 1))
            return false
        },
    }
    val idx = s.type_defs.len() as i64
    populate_field_ids(s, def, module_name)
    var ci: usize = 0
    while ci < def.constructors.len() {
        val ctor = def.constructors[ci]
        val packed = (idx << 16) | (ci as i64)
        ctor_packed_push(s, ctor.name, packed)
        ci = ci + 1
    }
    type_def_set(s, def.name, idx)
    s.type_def_owner.set("{idx}", module_name)
    s.type_defs.push(def)
    true
}

// field_id 规则:adt/newtype __tag=0 字段从 1;record 声明序 0..N-1;alias 无。
fun populate_field_ids(s: SemaRes, def: TDef, module_name: str): void {
    match def.kind {
        TAdt => {
            var ci: usize = 0
            while ci < def.constructors.len() {
                val ctor = def.constructors[ci]
                var fi: usize = 0
                while fi < ctor.field_names.len() {
                    match ctor.field_names[fi] {
                        null => {}
                        name => { put_field_id(s, def.name, name, (fi + 1) as i64) }
                    }
                    fi = fi + 1
                }
                ci = ci + 1
            }
            put_field_id(s, def.name, "__tag", 0)
        },
        TNewtype => {
            var fi: i64 = 0
            if def.constructors.len() > 0 {
                val ctor = def.constructors[0]
                var k: usize = 0
                while k < ctor.field_names.len() {
                    val field_id = fi + 1
                    match ctor.field_names[k] {
                        null => { put_field_id(s, def.name, "_{fi}", field_id) }
                        name => { put_field_id(s, def.name, name, field_id) }
                    }
                    fi = fi + 1
                    k = k + 1
                }
            }
            put_field_id(s, def.name, "__tag", 0)
        },
        TRecord => {
            if def.constructors.len() > 0 {
                val ctor = def.constructors[0]
                var fi: usize = 0
                while fi < ctor.field_names.len() {
                    match ctor.field_names[fi] {
                        null => {}
                        name => { put_field_id(s, def.name, name, fi as i64) }
                    }
                    fi = fi + 1
                }
            }
        },
        TAlias => {}
    }
}

fun put_field_id(s: SemaRes, type_name: str, field_name: str, field_id: i64): void {
    s.field_id_map.set(make_field_key(type_name, field_name), field_id)
}

pub fun lookup_field_id(s: SemaRes, type_name: str, field_name: str): i64? {
    s.field_id_map.get(make_field_key(type_name, field_name))
}

// ─── 类型定义查询 ─────────────────────────────────────────────────

pub fun get_type_def(s: SemaRes, name: str): TDef? {
    val key = canonical_type_name(name)
    val resolved = resolve_type_key(s, key)
    match type_def_idx(s, resolved) {
        null => { null }
        idx => { s.type_defs.get(idx as usize) }
    }
}

pub fun get_type_def_in(s: SemaRes, module: str, name: str): TDef? {
    val key = canonical_type_name(name)
    val resolved = resolve_type_key_in(s, module, key)
    match type_def_idx(s, resolved) {
        null => { null }
        idx => { s.type_defs.get(idx as usize) }
    }
}

// ─── trait 定义注册/查询 ──────────────────────────────────────────

pub fun put_trait_def(s: SemaRes, def: TTDef): bool {
    if trait_def_has(s, def.name) {
        return false
    }
    val idx = s.trait_defs.len() as i64
    trait_def_set(s, def.name, idx)
    s.trait_defs.push(def)
    true
}

pub fun get_trait_def(s: SemaRes, name: str): TTDef? {
    val resolved = resolve_trait_key(s, name)
    match trait_def_idx(s, resolved) {
        null => { null }
        idx => { s.trait_defs.get(idx as usize) }
    }
}

pub fun get_trait_def_in(s: SemaRes, module: str, name: str): TTDef? {
    val resolved = resolve_trait_key_in(s, module, name)
    match trait_def_idx(s, resolved) {
        null => { null }
        idx => { s.trait_defs.get(idx as usize) }
    }
}

// ─── 函数签名注册/查询 ────────────────────────────────────────────

pub fun put_func_sig(s: SemaRes, sig: FSig): bool {
    val qualified = func_sig_qualified_key(sig.module_name, sig.name)
    if s.func_sig_index.has(qualified) {
        return false
    }
    val idx = s.func_sigs.len() as i64
    csv_push(s.func_sig_owners, sig.name, sig.module_name)
    s.func_sig_index.set(qualified, idx)
    s.func_sigs.push(sig)
    true
}

// 裸名严格查询:恰好一个拥有者才有答案(竞争名 = null)。
pub fun get_func_sig(s: SemaRes, name: str): FSig? {
    match s.func_sig_owners.get(name) {
        null => { null }
        owners => {
            val parts = csv_parts(owners)
            if parts.len() != 1 {
                return null
            }
            match s.func_sig_index.get(func_sig_qualified_key(parts[0], name)) {
                null => { null }
                idx => { s.func_sigs.get(idx as usize) }
            }
        },
    }
}

pub fun get_func_sig_in(s: SemaRes, module: str, name: str): FSig? {
    match func_sig_idx_of(s, module, name) {
        null => { null }
        idx => { s.func_sigs.get(idx as usize) }
    }
}

// ─── 构造器查询 ───────────────────────────────────────────────────

// 按构造器名取第一个 packed(type_idx<<16|ctor_idx);带 canonical 回退。
pub fun get_ctor_def(s: SemaRes, name: str): Ctor? {
    val list = ctor_packed_list(s, name)
    if list.len() > 0 {
        val packed = list.get(0) ?? 0
        val type_idx = (packed >> 16) as usize
        val ctor_idx = (packed & 0xFFFF) as usize
        match s.type_defs.get(type_idx) {
            null => { return null }
            def => {
                if ctor_idx < def.constructors.len() {
                    return def.constructors[ctor_idx]
                }
                return null
            },
        }
    }
    if !Str.contains(name, ".") {
        return null
    }
    val bare = tail_seg(name)
    val list2 = ctor_packed_list(s, bare)
    var i: usize = 0
    while i < list2.len() {
        val packed = list2.get(i) ?? 0
        val type_idx = (packed >> 16) as usize
        val ctor_idx = (packed & 0xFFFF) as usize
        match s.type_defs.get(type_idx) {
            null => {}
            def => {
                if def.name == name && ctor_idx < def.constructors.len() {
                    return def.constructors[ctor_idx]
                }
            },
        }
        i = i + 1
    }
    null
}

// ─── 名称消歧(模块作用域单点)──────────────────────────────────────

pub fun resolve_type_key_in(s: SemaRes, module_name: str, bare: str): str {
    if Str.contains(bare, ".") {
        // 带点拼写:canonical 精确命中优先;否则按源码限定词映射
        // (std.collections.List → std 裸键 List);映射失败原样。
        if type_def_has(s, bare) {
            return bare
        }
        match map_qualified_key_in(s, module_name, bare) {
            null => {}
            key => { return key ?? bare }
        }
        return bare
    }
    // 1. 本模块(含 pending 前向引用)。
    val own = canonical_type_key(module_name, bare)
    if type_def_has(s, own) || (own != bare && list_has_str(s.pending_own_types, bare)) {
        return own
    }
    // 2. 导入的用户模块(声明序)。
    match s.module_imports.get(module_name) {
        null => {}
        imports => {
            val parts = csv_parts(imports)
            var i: usize = 0
            while i < parts.len() {
                val key = parts[i] + "." + bare
                if type_def_has(s, key) {
                    return key
                }
                i = i + 1
            }
        },
    }
    // 3. std/builtin 裸键。
    if type_def_has(s, bare) {
        return bare
    }
    // 4. 全局唯一用户类型(尾段匹配;竞争 → 落到裸回退)。
    var unique_key = ""
    val keys = s.type_def_index.keys()
    var i: usize = 0
    while i < keys.len() {
        val key = keys[i]
        if Str.contains(key, ".") && tail_seg(key) == bare {
            if unique_key.len() > 0 {
                return bare
            }
            unique_key = key
        }
        i = i + 1
    }
    if unique_key.len() > 0 {
        return unique_key
    }
    bare
}

pub fun resolve_type_key(s: SemaRes, bare: str): str {
    resolve_type_key_in(s, s.current_module_name, bare)
}

pub fun resolve_trait_key_in(s: SemaRes, module_name: str, bare: str): str {
    if Str.contains(bare, ".") {
        // resolve_type_key_in 的 trait 孪生:精确命中 → 限定词映射 → 原样。
        if trait_def_has(s, bare) {
            return bare
        }
        match map_qualified_key_in(s, module_name, bare) {
            null => {}
            key => { return key ?? bare }
        }
        return bare
    }
    val own = canonical_type_key(module_name, bare)
    if trait_def_has(s, own) || (own != bare && list_has_str(s.pending_own_traits, bare)) {
        return own
    }
    match s.module_imports.get(module_name) {
        null => {}
        imports => {
            val parts = csv_parts(imports)
            var i: usize = 0
            while i < parts.len() {
                val key = parts[i] + "." + bare
                if trait_def_has(s, key) {
                    return key
                }
                i = i + 1
            }
        },
    }
    if trait_def_has(s, bare) {
        return bare
    }
    var unique_key = ""
    val keys = s.trait_def_index.keys()
    var i: usize = 0
    while i < keys.len() {
        val key = keys[i]
        if Str.contains(key, ".") && tail_seg(key) == bare {
            if unique_key.len() > 0 {
                return bare
            }
            unique_key = key
        }
        i = i + 1
    }
    if unique_key.len() > 0 {
        return unique_key
    }
    bare
}

pub fun resolve_trait_key(s: SemaRes, bare: str): str {
    resolve_trait_key_in(s, s.current_module_name, bare)
}

// trait 传递父闭包(声明序 BFS 去重;环/缺失安全,hops ≤ 128)。
pub fun trait_parent_closure(s: SemaRes, trait_name: str): List<str> {
    val out = List.empty<str>()
    val queue = List.empty<str>()
    match get_trait_def(s, trait_name) {
        null => {}
        td => {
            var i: usize = 0
            while i < td.parents.len() {
                queue.push(td.parents[i])
                i = i + 1
            }
        },
    }
    var hops: i64 = 0
    var head: usize = 0
    while head < queue.len() {
        hops = hops + 1
        if hops > 128 {
            break
        }
        val t = queue.get(head) ?? ""
        head = head + 1
        if list_has_str(out, t) {
            continue
        }
        out.push(t)
        match get_trait_def(s, t) {
            null => {}
            td => {
                var i: usize = 0
                while i < td.parents.len() {
                    queue.push(td.parents[i])
                    i = i + 1
                }
            },
        }
    }
    out
}

// ─── 导入簿记(record_module_import)───────────────────────────────

// 导入拼写 → 用户模块逻辑路径(精确或尾段匹配;std/builtin 跳过)。
pub fun record_module_import(s: SemaRes, module_name: str, full_path: str): void {
    if Str.starts_with(full_path, "std.") || Str.starts_with(full_path, "builtin.") {
        return
    }
    var i: usize = 0
    while i < s.user_module_paths.len() {
        val lp = s.user_module_paths.get(i) ?? ""
        if lp == full_path || Str.ends_with(lp, ".{full_path}") {
            csv_push(s.module_imports, module_name, lp)
        }
        i = i + 1
    }
}

// ─── 见证表 ───────────────────────────────────────────────────────

fun witness_key(trait_name: str, type_id: i64): str {
    "{trait_name}\u{0}{type_id}"
}

pub fun witness_register(s: SemaRes, trait_name: str, type_id: i64, type_name: str, slots: Map<str, i64>): void {
    val key = witness_key(trait_name, type_id)
    match s.witness_index.get(key) {
        null => {
            val id = s.witness_entries.len() as i64
            s.witness_entries.push(WEnt(trait_name, type_id, slots, type_name))
            s.witness_index.set(key, id)
        },
        // 覆盖重定义(同 entry 位,不新分配)。
        id => {
            s.witness_entries.set(id as usize, WEnt(trait_name, type_id, slots, type_name))
        },
    }
}

pub fun witness_implements(s: SemaRes, trait_name: str, type_id: i64): bool {
    s.witness_index.has(witness_key(trait_name, type_id))
}

pub fun witness_resolve_method(s: SemaRes, trait_name: str, type_id: i64, method_name: str): i64? {
    match s.witness_index.get(witness_key(trait_name, type_id)) {
        null => { null }
        id => {
            match s.witness_entries.get(id as usize) {
                null => { null }
                ent => { ent.method_slots.get(method_name) }
            }
        },
    }
}

// dynamic_type_id = FIRST_DYNAMIC_TYPE_ID(22) + type_def_index。
pub fun dynamic_type_id(type_def_index: i64): i64 {
    22 + type_def_index
}

// ─── 片4b:推断支撑 ───────────────────────────────────────────────

// 模块内表达式键(复合键;内部表示自由,注入即可)。
pub fun module_expr_key(module_name: str, expr_id: i64): str {
    "{module_name}\u{0}{expr_id}"
}

// 表达式类型 upsert(put_expr 语义;键集大小 = stats expr_types)。
pub fun put_expr(s: SemaRes, key: str, ty: u32): void {
    s.expr_types.set(key, ty)
}

pub fun get_expr(s: SemaRes, key: str): u32? {
    s.expr_types.get(key)
}

// 方法分派标记(intrinsic await/recv;计数进 stats)。
pub fun put_dispatch(s: SemaRes, key: str): void {
    s.method_dispatches.set(key, true)
}

// 类型名 → type_id 名反查(witness 条目匹配)。
pub fun witness_type_name(s: SemaRes, trait_name: str, type_id: i64): str? {
    var i: usize = 0
    while i < s.witness_entries.len() {
        val e = s.witness_entries.get(i) ?? WEnt("", 0, Map.empty<str, i64>(), "")
        if e.trait_name == trait_name && e.type_id == type_id {
            return e.type_name
        }
        i = i + 1
    }
    null
}

// 按名取全部构造器定义(同名多类型消歧用)。
pub fun ctor_defs_of(s: SemaRes, name: str): List<Ctor> {
    val out = List.empty<Ctor>()
    val list = ctor_packed_list(s, name)
    var i: usize = 0
    while i < list.len() {
        val packed = list.get(i) ?? 0
        val type_idx = (packed >> 16) as usize
        val ctor_idx = (packed & 0xFFFF) as usize
        match s.type_defs.get(type_idx) {
            null => {}
            def => {
                if ctor_idx < def.constructors.len() {
                    out.push(def.constructors[ctor_idx])
                }
            },
        }
        i = i + 1
    }
    out
}

pub fun ctor_def_has(s: SemaRes, name: str): bool {
    ctor_packed_list(s, name).len() > 0
}

// 类型方法位次(方法表内名匹配;无 = null)。
pub fun lookup_method_idx(s: SemaRes, type_name: str, method_name: str): i64? {
    match get_type_def(s, type_name) {
        null => { null }
        def => {
            var i: usize = 0
            while i < def.methods.len() {
                if def.methods[i].name == method_name {
                    return i as i64
                }
                i = i + 1
            }
            null
        },
    }
}

// 源码模块限定词 → canonical 锚:(锚逻辑路径, is_std)。导入序优先 →
// std/builtin 前缀(裸键,true)→ 全局唯一用户模块尾匹配(竞争 = null)。
pub type QRes = QRes(pub anchor: str, pub is_std: bool)

pub fun resolve_module_qualifier(s: SemaRes, module_name: str, qual: str): QRes? {
    match s.module_imports.get(module_name) {
        null => {}
        imports => {
            val parts = csv_parts(imports)
            var i: usize = 0
            while i < parts.len() {
                val path = parts[i]
                if path == qual || Str.ends_with(path, ".{qual}") {
                    return QRes(anchored_logical_path(path), false)
                }
                i = i + 1
            }
        },
    }
    if qual == "std" || Str.starts_with(qual, "std.")
        || qual == "builtin" || Str.starts_with(qual, "builtin.") {
        return QRes("", true)
    }
    var unique = ""
    var i: usize = 0
    while i < s.user_module_paths.len() {
        val lp = s.user_module_paths.get(i) ?? ""
        if lp == qual || Str.ends_with(lp, ".{qual}") {
            if unique.len() > 0 {
                return null
            }
            unique = lp
        }
        i = i + 1
    }
    if unique.len() > 0 {
        return QRes(anchored_logical_path(unique), false)
    }
    null
}

// 锚定逻辑路径:最后一个 ".src." 之后。
fun anchored_logical_path(lp: str): str {
    val pos = find_last_sub(lp, ".src.")
    if pos >= 0 {
        return Str.substring(lp, (pos + 5) as usize, lp.len())
    }
    lp
}

// 源码限定键("A.Point"/"std.collections.List")→ canonical 注册键。
pub fun map_qualified_key_in(s: SemaRes, module_name: str, dotted: str): str? {
    val pos = find_last_sub(dotted, ".")
    if pos < 0 {
        return null
    }
    val qual = Str.substring(dotted, 0, pos as usize)
    val tail = Str.substring(dotted, (pos + 1) as usize, dotted.len())
    match resolve_module_qualifier(s, module_name, qual) {
        null => { null }
        QRes(_, true) => { tail }
        QRes(anchor, false) => { "{anchor}.{tail}" },
    }
}

// ─── trait 有效方法面(super/方法绑定)─────────────────────────────

// (origin trait, 方法签名) 对。
pub type ET = ET(pub origin: str, pub m: TMS)

// 自身 + 传递父的方法面(自身条目遮蔽同名父条目)。
pub fun trait_effective_methods(s: SemaRes, trait_name: str): List<ET> {
    val out = List.empty<ET>()
    match get_trait_def(s, trait_name) {
        null => {}
        td => {
            var i: usize = 0
            while i < td.methods.len() {
                out.push(ET(trait_name, td.methods[i]))
                i = i + 1
            }
        },
    }
    val closure = trait_parent_closure(s, trait_name)
    var ci: usize = 0
    while ci < closure.len() {
        val p = closure.get(ci) ?? ""
        match get_trait_def(s, p) {
            null => {}
            td => {
                var i: usize = 0
                while i < td.methods.len() {
                    val m = td.methods[i]
                    var shadowed = false
                    var k: usize = 0
                    while k < out.len() && !shadowed {
                        val om = out.get(k) ?? ET("", m)
                        if om.m.name == m.name {
                            shadowed = true
                        }
                        k = k + 1
                    }
                    if !shadowed {
                        out.push(ET(p, m))
                    }
                    i = i + 1
                }
            },
        }
        ci = ci + 1
    }
    out
}

// ─── 方法绑定裁决(super 用)───────────────────────────────────────

pub type MB =
    | MBBound(str, bool)
    | MBUnbound
    | MBAmbiguous(str[])

// 解析序:显式 delegate 压倒一切 → 唯一默认提供者隐绑 → 多者歧义
// (子 trait 遮蔽裁决优先)。
pub fun resolve_method_binding(s: SemaRes, implemented_traits: List<str>,
    type_name: str, method_name: str): MB {
    var declared: MSig? = null
    match get_type_def(s, type_name) {
        null => {}
        td => {
            var i: usize = 0
            while i < td.methods.len() && declared == null {
                if td.methods[i].name == method_name {
                    declared = if true { td.methods[i] } else { null }
                }
                i = i + 1
            }
        },
    }
    val providers = List.empty<str>()
    var ti: usize = 0
    while ti < implemented_traits.len() {
        val t = implemented_traits.get(ti) ?? ""
        var has_default = false
        match get_trait_def(s, t) {
            null => {}
            td => {
                var i: usize = 0
                while i < td.methods.len() && !has_default {
                    if td.methods[i].name == method_name && td.methods[i].has_body {
                        has_default = true
                    }
                    i = i + 1
                }
            },
        }
        if has_default {
            providers.push(t)
        }
        ti = ti + 1
    }
    match declared {
        null => {}
        m0 => {
            match m0.delegate_trait {
                null => {}
                t => { return MBBound(t, m0.has_body) }
            }
        },
    }
    var overridden = false
    match declared {
        null => {}
        m0 => { overridden = m0.has_body },
    }
    // 子 trait 遮蔽:某提供者的父闭包包含其余全部 → 子声明胜出。
    if providers.len() > 1 {
        var winner: i64 = -1
        var i: usize = 0
        while i < providers.len() && winner < 0 {
            val c = providers.get(i) ?? ""
            var all_covered = true
            var k: usize = 0
            while k < providers.len() && all_covered {
                val o = providers.get(k) ?? ""
                if o != c {
                    if !Semares.list_has_str(trait_parent_closure(s, c), o) {
                        all_covered = false
                    }
                }
                k = k + 1
            }
            if all_covered {
                winner = i as i64
            }
            i = i + 1
        }
        if winner >= 0 {
            val t = providers.get(winner as usize) ?? ""
            return MBBound(t, overridden)
        }
    }
    if providers.len() == 0 {
        return MBUnbound
    }
    if providers.len() == 1 {
        return MBBound(providers.get(0) ?? "", overridden)
    }
    var amb: str[] = []
    var i: usize = 0
    while i < providers.len() {
        amb = amb ++ [providers.get(i) ?? ""]
        i = i + 1
    }
    MBAmbiguous(amb)
}
