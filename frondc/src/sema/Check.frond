// Check.frond — 模块检查编排(1E):Rust tooling/Common/Pipeline.rs
// sema_prepipeline + Inference/Core.rs check_module_with_env 的镜像。
//
// 片4b:populate → alias 环/ctor 重名检查 → 状态复位 → import 处理 →
// predeclare → witness 填充 → **真实体推断(Infer.check_decl)** → kind
// 检查 → solver 定点 + 9.1 歧义上报 + 9.2 挂起重试 + 9.4 未绑默认 void。
// monomorph 实例收集(第 8 步)属片5:引擎侧该步只写 resolved_types/
// call_instantiations 等(不进 HM 错误面),跳过无行为差异。

import std.collections.List
import std.collections.Map
import std.core.types.Str
import syntax.Ast
import types.Arena
import types.Ty

import sema.Data
import sema.Envs
import sema.Semares
import sema.Ictx
import sema.Populate
import sema.Modenv
import sema.Relate
import sema.Infer
import sema.Mono

// ─── check_alias_cycles(Bug#80)────────────────────────────────────

pub fun check_alias_cycles(s: SemaRes): void {
    // 已报环的去重(跨模块累积表)。
    val reported = List.empty<str>()
    var i: usize = 0
    while i < s.errors.len() {
        val e = s.errors.get(i) ?? SErr("", 0, 0, "")
        if Str.starts_with(e.message, "cyclic type alias: ") {
            reported.push(Str.substring(e.message, 19, e.message.len()))
        }
        i = i + 1
    }
    val to_report = List.empty<str>()
    // 增量:只扫本模块新增(环在末成员落位时被发现,旧成员已扫)。
    i = s.checks_scan_base
    while i < s.type_defs.len() {
        val td = s.type_defs.get(i) ?? TDef("", TAlias, [], [], null, null, [], [])
        if td.kind == TAlias {
            val chain = List.empty<str>()
            val visiting = List.empty<str>()
            chain.push(td.name)
            visiting.push(td.name)
            var current = td.target_type_name
            var go = true
            while go {
                match current {
                    null => { go = false }
                    target_name => {
                        if Semares.list_has_str(visiting, target_name) {
                            chain.push(target_name)
                            // 环起点 = 链中该名首现。
                            var start: usize = 0
                            var k: usize = 0
                            while k < chain.len() {
                                if (chain.get(k) ?? "") == target_name {
                                    start = k
                                    k = chain.len()
                                }
                                k = k + 1
                            }
                            var segs: str[] = []
                            var q: usize = start
                            while q < chain.len() {
                                segs = segs ++ [chain.get(q) ?? ""]
                                q = q + 1
                            }
                            val cycle_path = Semares.str_join(segs, " -> ")
                            if !Semares.list_has_str(reported, cycle_path) {
                                reported.push(cycle_path)
                                to_report.push(cycle_path)
                            }
                            go = false
                        } else {
                            match Semares.get_type_def(s, target_name) {
                                null => { go = false }
                                t => {
                                    if t.kind == TAlias {
                                        visiting.push(target_name)
                                        chain.push(target_name)
                                        current = t.target_type_name
                                    } else {
                                        // 非 alias:无环。
                                        go = false
                                    }
                                },
                            }
                        }
                    },
                }
            }
        }
        i = i + 1
    }
    i = 0
    while i < to_report.len() {
        Semares.add_error(s, Data.new_err("cyclic type alias: {to_report.get(i)}", 0, 0))
        i = i + 1
    }
}

// ─── check_duplicate_ctor_fields(Bug#82)───────────────────────────

pub fun check_duplicate_ctor_fields(s: SemaRes): void {
    val reported = List.empty<str>()
    val new_errors = List.empty<str>()
    // 增量:重复字段只可能来自新类型的构造器。
    var i: usize = s.checks_scan_base
    while i < s.type_defs.len() {
        val td = s.type_defs.get(i) ?? TDef("", TAlias, [], [], null, null, [], [])
        var ci: usize = 0
        while ci < td.constructors.len() {
            val ctor = td.constructors[ci]
            val seen = List.empty<str>()
            var fi: usize = 0
            while fi < ctor.field_names.len() {
                match ctor.field_names[fi] {
                    null => {}
                    fname => {
                        if !Semares.list_has_str(seen, fname) {
                            seen.push(fname)
                        } else {
                            val key = fname + "\u{0}" + ctor.name
                            if !Semares.list_has_str(reported, key) {
                                reported.push(key)
                                new_errors.push("duplicate field '{fname}' in constructor {ctor.name}")
                            }
                        }
                    },
                }
                fi = fi + 1
            }
            ci = ci + 1
        }
        i = i + 1
    }
    i = 0
    while i < new_errors.len() {
        Semares.add_error(s, Data.new_err(new_errors.get(i) ?? "", 0, 0))
        i = i + 1
    }
}

// ─── builtin 合成类型注册(define_builtin_types 的数据)────────────

// sig 构造便捷。
fun bsig(name: str, param_reprs: TR[], return_repr: TR?, intrinsic: IK?): MSig {
    var pir: bool[] = []
    var i: usize = 0
    while i < param_reprs.len() {
        pir = pir ++ [false]
        i = i + 1
    }
    MSig(name, pir, false, false, false, param_reprs, return_repr, intrinsic, true, null, true)
}

fun reg_builtin_type(s: SemaRes, type_name: str, type_params: str[], methods: MSig[]): void {
    if Semares.type_def_has(s, type_name) {
        return
    }
    Semares.put_type_def(s, TDef(type_name, TAlias, [], type_params, null, null, methods, []), "")
}

pub fun register_builtin_method_sigs(s: SemaRes): void {
    reg_builtin_type(s, "Throw", ["T", "E"], [
        bsig("is_ok", [TRThis], TRNamed("bool"), null),
    ])
    reg_builtin_type(s, "Channel", ["T"], [
        bsig("send", [TRThis, TRNamed("T")], TRNamed("void"), IKBinOp(282)),
        bsig("recv", [TRThis], TRNamed("T"), IKChannelAwait),
        bsig("close", [TRThis], TRNamed("void"), IKUnOp(283)),
    ])
    reg_builtin_type(s, "Atomic", ["T"], [
        bsig("swap", [TRThis, TRNamed("T")], TRNamed("T"), IKBinOp(314)),
        bsig("compare_exchange", [TRThis, TRNamed("T"), TRNamed("T")], TRNamed("bool"), IKTriOp(315)),
        bsig("load", [TRThis], TRNamed("T"), IKUnOp(312)),
        bsig("store", [TRThis, TRNamed("T")], TRNamed("void"), IKBinOp(313)),
    ])
    reg_builtin_type(s, "Async", ["T"], [
        bsig("status", [TRThis], TRNamed("str"), null),
        bsig("await", [TRThis], TRNamed("T"), IKAwait),
        bsig("cancel", [TRThis], TRNamed("void"), IKUnOp(42)),
    ])
    reg_builtin_type(s, "Sender", ["T"], [
        bsig("send", [TRThis, TRNamed("T")], TRNamed("void"), IKBinOp(282)),
        bsig("close", [TRThis], TRNamed("void"), IKUnOp(283)),
    ])
    reg_builtin_type(s, "Receiver", ["T"], [
        bsig("recv", [TRThis], TRNamed("T"), IKChannelAwait),
        bsig("close", [TRThis], TRNamed("void"), IKUnOp(283)),
    ])
    reg_builtin_type(s, "Lazy", ["T"], [])
    reg_builtin_type(s, "ForeignFn", ["R"], [])
    reg_builtin_type(s, "Lib", [], [])
    reg_builtin_type(s, "array", ["T"], [
        bsig("len", [TRThis], TRNamed("usize"), IKUnOp(35)),
        bsig("is_empty", [TRThis], TRNamed("bool"), IKUnOp(340)),
    ])
    reg_builtin_type(s, "str", [], [
        bsig("len", [TRThis], TRNamed("usize"), IKUnOp(35)),
        bsig("is_empty", [TRThis], TRNamed("bool"), IKUnOp(340)),
        bsig("bytes", [TRThis], TRArray(TRNamed("u8"), null), IKUnOp(285)),
    ])
    reg_builtin_type(s, "nullable", ["T"], [
        bsig("is_null", [TRThis], TRNamed("bool"), IKUnOp(34)),
    ])
}

// ─── kind 检查(第 7 步;注解树逐节点元数核对)────────────────────

pub fun run_kind_checks(s: SemaRes, m: ModuleAst): void {
    val errors = List.empty<SErr>()
    val no_params = List.empty<str>()
    var di: usize = 0
    while di < m.decls.len() {
        match m.decls[di].decl {
            FunDeclD(_, _, _, params, return_type, _, _, _, _, _) => {
                var pi: usize = 0
                while pi < params.len() {
                    match params[pi].ta {
                        null => {}
                        ta => { Relate.check_type_node(s, m.arena, ta, no_params, errors) }
                    }
                    pi = pi + 1
                }
                match return_type {
                    null => {}
                    rt => { Relate.check_type_node(s, m.arena, rt, no_params, errors) }
                }
            },
            TypeDeclD(_, _, _, _, _, AdtD(constructors), _) => {
                var ci: usize = 0
                while ci < constructors.len() {
                    val ctor = constructors[ci]
                    var fi: usize = 0
                    while fi < ctor.fields.len() {
                        Relate.check_type_node(s, m.arena, ctor.fields[fi].ty, no_params, errors)
                        fi = fi + 1
                    }
                    match ctor.return_type {
                        null => {}
                        rt => { Relate.check_type_node(s, m.arena, rt, no_params, errors) }
                    }
                    ci = ci + 1
                }
            },
            _ => {},
        }
        di = di + 1
    }
    var i: usize = 0
    while i < errors.len() {
        Semares.add_error(s, errors.get(i) ?? new_err("", 0, 0))
        i = i + 1
    }
}

// ─── check_module_with_env(片4b:真实体推断)────────────────────────

pub fun check_module_with_env(ctx: ICtx, a: TypeArena, s: SemaRes,
    m: ModuleAst, root_env: u32, all_modules: List<ModuleAst>): void {
    // 1. populate(幂等)。
    Populate.populate_module(a, s, m, all_modules)
    // 1b/1d. alias 环 + ctor 字段重名(增量化水位)。
    check_alias_cycles(s)
    check_duplicate_ctor_fields(s)
    s.checks_scan_base = s.type_defs.len()
    // 2. 状态复位 + 模块上下文 + tvars 基线(诊断只计本模块新增)。
    Ictx.reset_state(ctx)
    ctx.current_module_env = null
    ctx.current_module_logical_path = Semares.module_logical_path(m.name)
    ctx.current_module_name = m.name
    s.current_module_name = m.name
    val type_vars_baseline = Arena.tvars_len(a)
    // 3. import 处理。
    Modenv.process_import_decls(ctx, a, s, m, root_env)
    // 4. predeclare(幂等;含泛型签名绑定)。
    Modenv.predeclare_declarations(ctx, a, s, m, root_env)
    // 5. witness 填充。
    Modenv.populate_witness_table(ctx, s, m)
    // builtin 合成类型注册是 collect_monomorph_instances 的第一步,
    // types 节依赖它,无条件先落。
    register_builtin_method_sigs(s)
    // 6. 声明体推断(module_env 为基:函数体经 env 链解析同模块符号)。
    val check_env = ctx.current_module_env ?? root_env
    var di: usize = 0
    while di < m.decls.len() {
        val sd = m.decls[di]
        Infer.check_decl(ctx, a, s, sd.decl, sd.span, m.arena, check_env)
        di = di + 1
    }
    // 7. kind 检查。
    run_kind_checks(s, m)
    // 8. monomorph 实例收集(泛型调用点 → 实例集 + 实例化重放)。
    Mono.collect_monomorph_instances(a, s, m, all_modules)
    // 9. 求解定点 + 9.1 歧义上报(仅 "ambiguous" 理由)。
    Infer.solver_solve(ctx, a)
    {
        var ei: usize = 0
        while ei < ctx.solver.errors.len() {
            val ce = ctx.solver.errors.get(ei) ?? CErr(0, 0, "")
            if Str.contains(ce.reason, "ambiguous") {
                val r1 = Arena.resolve(a, ce.t1)
                val r2 = Arena.resolve(a, ce.t2)
                Semares.add_error(s, new_err(
                    "type mismatch: {Arena.display(a, r1)} does not unify with {Arena.display(a, r2)} ({ce.reason})",
                    0, 0))
            }
            ei = ei + 1
        }
    }
    // 9.2 挂起方法调用重试轮(裸 var 接收者;求解后重推,≤8 轮)。
    {
        var rounds: i64 = 0
        var go = true
        while go {
            if ctx.deferred_calls.len() == 0 || rounds >= 8 {
                go = false
            } else {
                rounds = rounds + 1
                val deferred = ctx.deferred_calls
                ctx.deferred_calls = List.empty<DCall>()
                var i: usize = 0
                while i < deferred.len() {
                    val d = deferred.get(i) ?? DCall(0, 0)
                    val _t = Infer.infer_expr(ctx, a, s, d.expr, m.arena, d.env, null)
                    i = i + 1
                }
            }
        }
        ctx.deferred_calls = List.empty<DCall>()
    }
    // 9.4 未绑非 rigid TypeVar 默认 void(ML 默认化;非错误回退)。
    {
        val void_ty = Arena.make(a, TVoid)
        var i: usize = type_vars_baseline
        while i < Arena.tvars_len(a) {
            match a.tvars.get(i) {
                null => {}
                tv => {
                    if !tv.is_rigid && tv.bound == null {
                        Arena.bind_var(a, i as u32, void_ty)
                    }
                },
            }
            i = i + 1
        }
    }
    // 9.5/11. 残留 TypeVar 诊断(9.4 后恒空;保形)。
    {
        var count: i64 = 0
        var i: usize = type_vars_baseline
        while i < Arena.tvars_len(a) {
            match a.tvars.get(i) {
                null => {}
                tv => {
                    if !tv.is_rigid && tv.bound == null {
                        count = count + 1
                    }
                },
            }
            i = i + 1
        }
        if count > 0 {
            Semares.add_error(s, new_err("{count} unresolved type variable(s) after constraint solving", 0, 0))
        }
    }
    // 10a. trait 方法绑定/继承验证 + trait 默认实例收集(依赖见证表)。
    Mono.validate_trait_method_bindings(a, s, m)
    Mono.validate_trait_inheritance(a, s, m)
    Mono.collect_trait_default_instances(a, s, m)
}
