// Infer.frond — 体推断主体(1E 片4b):Rust core/src/sema/Inference/ 的
// 镜像(拆分前的 Inference.rs 单文件形态):Subst / Solver 行为 / Flow
// 行为 / Helpers / Unify / StmtInfer / ExprInfer / CallInfer / Match /
// check_decl。
//
// 表示与范围裁决:
// - 所有 InferContext 方法 → 自由函数(ctx: ICtx, a: TypeArena, s: SemaRes);
// - 实例化模式(monomorph)属片5:ctx.instantiation_mode 恒 false,
//   相应分支按引擎语义短路;
// - IR 专用写表跳过:ctor_resolutions / dispatch_targets / captures /
//   module_*_recv_exprs / pattern_ctor_types / super_dispatches —— 不进
//   dump、不进 stats、HM 推断无回读;
// - method_dispatches 仅 intrinsic await/recv 标记(stats 的 HM 部分);
// - expr_types = Map<键, 解析后句柄>(upsert;键集大小 = stats)。
//
// 语言写法约束(1D/1E 已踩坑清单沿用):字符串插值大括号转义;match 臂
// 会窄化 var(计数器用整型,勿以 ADT 值作循环游标);标识符禁关键字开头。

import std.collections.List
import std.collections.Map
import std.core.types.Str
import syntax.Ast
import types.Arena.{adt_parts, array_parts, async_value, atomic_elem, bind_var, channel_elem, detail_of, display, fn_parts, foreign_fn_ret, fresh_rigid_var, fresh_type_var, generic_parts, lazy_value, make, make_adt, make_array, make_async, make_atomic, make_channel, make_fn, make_foreign_fn, make_generic, make_lazy, make_nullable, make_receiver, make_record, make_ref, make_sender, make_throw, make_trait, make_trait_object, module_ref_parts, nullable_inner, receiver_elem, record_fields, ref_parts, resolve, sender_elem, thr_parts, trait_object_parts, trait_parts, tvar_is_rigid, unify}
import types.Ty

import sema.Data
import sema.Envs.{define, lookup, lookup_local, redefine}
import sema.Semares.{add_warning, ctor_defs_of, dynamic_type_id, find_last_sub, get_ctor_def, get_expr, get_trait_def, get_type_def, list_has_str, lookup_field_id, lookup_method_idx, module_expr_key, parse_i64_dec, put_dispatch, put_expr, resolve_method_binding, resolve_module_qualifier, resolve_trait_key, resolve_type_key, tail_seg, trait_effective_methods, trait_parent_closure, type_def_idx}
import sema.Ictx.{current_this_type, insert_top, is_builtin_generic_type, lookup_type_binding, make_builtin_generic, numeric_builtin_names, pop_frame, pop_this_type, push_frame, push_this_type, push_type_bindings}
import sema.Populate.{ast_method_to_func_sig, ast_trait_decl_to_trait_def, ast_type_decl_to_type_def, from_type_name_full}
import sema.Typeast.{resolve_name_to_type, type_from_ast}
import sema.Relate.{children, peer_type, peer_type_binary, resolve_has_typevar, ty_is_float, ty_is_int, ty_is_numeric, type_contains_typevar, type_name_concrete, types_equal}

// ─── 小工具 ───────────────────────────────────────────────────────

fun unify_ok(a: TypeArena, x: u32, y: u32): bool {
    match unify(a, x, y) {
        Ok(_) => { true }
        Error(_) => { false }
    }
}

fun add_error(s: SemaRes, msg: str): void {
    Semares.add_error(s, new_err(msg, 0, 0))
}

fun add_error_at(s: SemaRes, msg: str, line: i64, column: i64): void {
    Semares.add_error(s, new_err(msg, line, column))
}


fun add_warning_at(s: SemaRes, msg: str, line: i64, column: i64): void {
    add_warning(s, new_err(msg, line, column))
}

// env 沿父链查找(镜像 lookup;局部重写以支持谓词版)。
fun env_node(s: SemaRes, env: u32): ENode {
    s.env.envs.get(env as usize) ?? ENode(Map.empty<str, u32>(), null)
}

// 谓词查找:首个使谓词为真的同名绑定(Bug#103 路径 0 用,跳过同名非 Fn)。
// want_fn = true:仅接受 Fn 类型绑定。
fun env_lookup_with_pred(s: SemaRes, a: TypeArena, env: u32, name: str, want_fn: bool): u32? {
    var cur = env
    var guard: i64 = 0
    while guard < 1000000 {
        val node = env_node(s, cur)
        match node.bindings.get(name) {
            null => {}
            ty => {
                var pass = true
                if want_fn {
                    pass = is_fn_ty(a, ty)
                }
                if pass {
                    return ty
                }
            },
        }
        match node.parent {
            null => { return null }
            p => { cur = p }
        }
        guard = guard + 1
    }
    null
}

fun is_fn_ty(a: TypeArena, h: u32): bool {
    match Arena.get(a, h) {
        TFn(_) => { true }
        _ => { false }
    }
}

// ─── Subst:类型变量替换与实例化 ───────────────────────────────────

// (var_idx → 句柄) 对;小规模线性查表。
pub type Sub = Sub(pub idx: u32, pub h: u32)

fun sub_get(subst: List<Sub>, idx: u32): u32? {
    var i: usize = 0
    while i < subst.len() {
        val p = subst.get(i) ?? Sub(0, 0)
        if p.idx == idx {
            return p.h
        }
        i = i + 1
    }
    null
}

// 递归收集类型内全部未绑 TypeVar idx(去重)。
pub fun collect_type_vars(a: TypeArena, ty: u32, out: List<u32>): void {
    val resolved = resolve(a, ty)
    match Arena.get(a, resolved) {
        TTypeVar(idx) => {
            var has = false
            var i: usize = 0
            while i < out.len() && !has {
                if (out.get(i) ?? 0) == idx {
                    has = true
                }
                i = i + 1
            }
            if !has {
                out.push(idx)
            }
        },
        _ => {
            val kids = children(a, resolved)
            var i: usize = 0
            while i < kids.len() {
                collect_type_vars(a, kids[i], out)
                i = i + 1
            }
        },
    }
}

// 函数类型实例化:签名内未绑 TypeVar → 全新非 rigid 拷贝。
pub fun instantiate_fn_type(a: TypeArena, fn_ty: u32): u32 {
    val resolved = resolve(a, fn_ty)
    match Arena.get(a, resolved) {
        TFn(_) => {
            val f = fn_parts(a, resolved)
            val vars = List.empty<u32>()
            var i: usize = 0
            while i < f.ps.len() {
                collect_type_vars(a, f.ps[i], vars)
                i = i + 1
            }
            collect_type_vars(a, f.ret, vars)
            if vars.len() == 0 {
                return resolved
            }
            val subst = List.empty<Sub>()
            i = 0
            while i < vars.len() {
                subst.push(Sub(vars.get(i) ?? 0, fresh_type_var(a)))
                i = i + 1
            }
            substitute_type(a, resolved, subst)
        },
        _ => { resolved },
    }
}

// 按替换表重建类型(命中的 TypeVar 换新;其余臂按结构重建)。
pub fun substitute_type(a: TypeArena, ty: u32, subst: List<Sub>): u32 {
    val resolved = resolve(a, ty)
    match Arena.get(a, resolved) {
        TTypeVar(idx) => {
            match sub_get(subst, idx) {
                null => { resolved }
                h => { h }
            }
        },
        TFn(_) => {
            val f = fn_parts(a, resolved)
            var ps: u32[] = []
            var i: usize = 0
            while i < f.ps.len() {
                ps = ps ++ [substitute_type(a, f.ps[i], subst)]
                i = i + 1
            }
            make_fn(a, ps, substitute_type(a, f.ret, subst))
        },
        TRecord(_) => {
            val fs = record_fields(a, resolved)
            var nfs: FT[] = []
            var i: usize = 0
            while i < fs.len() {
                nfs = nfs ++ [FT(fs[i].name, substitute_type(a, fs[i].ty, subst))]
                i = i + 1
            }
            make_record(a, nfs, record_name_local(a, resolved))
        },
        TAdt(_) => {
            val p = adt_parts(a, resolved)
            var args: u32[] = []
            var i: usize = 0
            while i < p.b.len() {
                args = args ++ [substitute_type(a, p.b[i], subst)]
                i = i + 1
            }
            make_adt(a, p.a, args)
        },
        TNullable(_) => {
            make_nullable(a, substitute_type(a, nullable_inner(a, resolved), subst))
        },
        TGeneric(_) => {
            val p = generic_parts(a, resolved)
            var args: u32[] = []
            var i: usize = 0
            while i < p.b.len() {
                args = args ++ [substitute_type(a, p.b[i], subst)]
                i = i + 1
            }
            make_generic(a, p.a, args)
        },
        TArray(_) => {
            val p = array_parts(a, resolved)
            make_array(a, substitute_type(a, p.a, subst), p.b)
        },
        TThrow(_) => {
            val p = thr_parts(a, resolved)
            make_throw(a, substitute_type(a, p.a, subst), substitute_type(a, p.b, subst))
        },
        TTrait(_) => {
            val p = trait_parts(a, resolved)
            var args: u32[] = []
            var i: usize = 0
            while i < p.b.len() {
                args = args ++ [substitute_type(a, p.b[i], subst)]
                i = i + 1
            }
            make_trait(a, p.a, args)
        },
        TTraitObject(_) => {
            val p = trait_object_parts(a, resolved)
            make_trait_object(a, p.a, p.b)
        },
        TRef(_) => {
            val p = ref_parts(a, resolved)
            make_ref(a, substitute_type(a, p.a, subst), p.b)
        },
        TChannel(_) => {
            make_channel(a, substitute_type(a, channel_elem(a, resolved), subst))
        },
        TAsync(_) => {
            make_async(a, substitute_type(a, async_value(a, resolved), subst))
        },
        TLazy(_) => {
            make_lazy(a, substitute_type(a, lazy_value(a, resolved), subst))
        },
        TAtomic(_) => {
            make_atomic(a, substitute_type(a, atomic_elem(a, resolved), subst))
        },
        TSender(_) => {
            make_sender(a, substitute_type(a, sender_elem(a, resolved), subst))
        },
        TReceiver(_) => {
            make_receiver(a, substitute_type(a, receiver_elem(a, resolved), subst))
        },
        TForeignFn(_) => {
            make_foreign_fn(a, substitute_type(a, foreign_fn_ret(a, resolved), subst))
        },
        // 标量/Never/Unknown/Void/Null/ModuleRef/Timer:无子节点。
        _ => { resolved },
    }
}

fun record_name_local(a: TypeArena, h: u32): str? {
    match detail_of(a, detail_id_of_ty_local(a, h)) {
        DRecord(_, name) => { name }
        _ => { null }
    }
}

fun detail_id_of_ty_local(a: TypeArena, h: u32): u32 {
    match Arena.get(a, h) {
        TThrow(id) => id
        TChannel(id) => id
        TAsync(id) => id
        TLazy(id) => id
        TAtomic(id) => id
        TSender(id) => id
        TReceiver(id) => id
        TForeignFn(id) => id
        TArray(id) => id
        TRef(id) => id
        TFn(id) => id
        TNullable(id) => id
        TAdt(id) => id
        TRecord(id) => id
        TTrait(id) => id
        TTraitObject(id) => id
        TModuleRef(id) => id
        TGeneric(id) => id
        _ => 0
    }
}

// freshen:未绑非 rigid TypeVar → 全新 var(Fn 内部不收集,调用点由
// instantiate_fn_type 统一实例化)。
pub fun freshen_type(a: TypeArena, ty: u32): u32 {
    val free_vars = List.empty<u32>()
    collect_free_vars(a, ty, free_vars)
    if free_vars.len() == 0 {
        return ty
    }
    val subst = List.empty<Sub>()
    var i: usize = 0
    while i < free_vars.len() {
        subst.push(Sub(free_vars.get(i) ?? 0, fresh_type_var(a)))
        i = i + 1
    }
    substitute_type(a, ty, subst)
}

pub fun collect_free_vars(a: TypeArena, ty: u32, free_vars: List<u32>): void {
    val resolved = resolve(a, ty)
    match Arena.get(a, resolved) {
        TTypeVar(idx) => {
            if !tvar_is_rigid(a, idx) {
                var has = false
                var i: usize = 0
                while i < free_vars.len() && !has {
                    if (free_vars.get(i) ?? 0) == idx {
                        has = true
                    }
                    i = i + 1
                }
                if !has {
                    free_vars.push(idx)
                }
            }
        },
        TFn(_) => {},
        _ => {
            val kids = children(a, resolved)
            var i: usize = 0
            while i < kids.len() {
                collect_free_vars(a, kids[i], free_vars)
                i = i + 1
            }
        },
    }
}

// ─── Solver:等式定点 + 候选/歧义(Equality-only;Subtype/TraitBound/
//     Narrow 约束引擎从不产生)──────────────────────────────────────

fun solver_add_equality(ctx: ICtx, t1: u32, t2: u32): void {
    ctx.solver.pending.push(CEq(t1, t2))
}

// 候选多值记录(unify 前调用;rigid 不参与 —— get 原样返回 TypeVar)。
fun solver_record_candidate(ctx: ICtx, a: TypeArena, t1: u32, t2: u32): void {
    val c1 = Arena.get(a, t1)
    val c2 = Arena.get(a, t2)
    var var_idx: u32? = null
    var other: u32 = 0
    var record = false
    match c1 {
        TTypeVar(i) => {
            match c2 {
                TTypeVar(_) => {}
                _ => {
                    var_idx = if true { i } else { null }
                    other = t2
                    record = true
                },
            }
        },
        _ => {
            match c2 {
                TTypeVar(j) => {
                    var_idx = if true { j } else { null }
                    other = t1
                    record = true
                },
                _ => {},
            }
        },
    }
    if record {
        val key = "{var_idx ?? 0}"
        match ctx.solver.cands.get(key) {
            null => {
                val bucket = List.empty<u32>()
                bucket.push(other)
                ctx.solver.cands.set(key, bucket)
            },
            l => { l.push(other) },
        }
    }
}

// 批量求解(定点迭代;成功消费,失败含 TypeVar 重排,否则记错)。
pub fun solver_solve(ctx: ICtx, a: TypeArena): void {
    var pending = ctx.solver.pending
    ctx.solver.pending = List.empty<CEq>()
    var go = true
    while go {
        if pending.len() == 0 {
            go = false
        } else {
            var current = pending
            pending = List.empty<CEq>()
            var changed = false
            var i: usize = 0
            while i < current.len() {
                val c = current.get(i) ?? CEq(0, 0)
                solver_record_candidate(ctx, a, c.t1, c.t2)
                val r1 = resolve(a, c.t1)
                val r2 = resolve(a, c.t2)
                if r1 == r2 {
                    // 已同型:消费。
                } else {
                    if unify_ok(a, r1, r2) {
                        changed = true
                    } else {
                        if resolve_has_typevar(a, r1) || resolve_has_typevar(a, r2) {
                            pending.push(CEq(c.t1, c.t2))
                        } else {
                            ctx.solver.errors.push(CErr(c.t1, c.t2, "type mismatch"))
                        }
                    }
                }
                i = i + 1
            }
            if !changed {
                go = false
            }
        }
    }
    // 收敛后:候选去重 → 唯一写入;多者 null-join 或歧义。
    solver_finalize(ctx, a)
}

fun solver_finalize(ctx: ICtx, a: TypeArena): void {
    val keys = ctx.solver.cands.keys()
    var ki: usize = 0
    while ki < keys.len() {
        val key = keys[ki]
        val cands = ctx.solver.cands.get(key) ?? List.empty<u32>()
        val idx = parse_i64_dec(key) as u32
        // 结构相等去重(handle 不 intern)。
        val unique = List.empty<u32>()
        var i: usize = 0
        while i < cands.len() {
            val r = resolve(a, cands.get(i) ?? 0)
            var dup = false
            var k: usize = 0
            while k < unique.len() && !dup {
                if types_equal(a, unique.get(k) ?? 0, r) {
                    dup = true
                }
                k = k + 1
            }
            if !dup {
                unique.push(r)
            }
            i = i + 1
        }
        if unique.len() == 1 {
            val resolved = resolve(a, unique.get(0) ?? 0)
            bind_var(a, idx, resolved)
        } else {
            if unique.len() == 2 {
                // null-join:候选含 nullish(Null 或 Nullable<var>)与具体 X → X?。
                val u0 = unique.get(0) ?? 0u32
                val u1 = unique.get(1) ?? 0u32
                val n0 = is_nullish(a, u0)
                val n1 = is_nullish(a, u1)
                var base_h: u32 = 0
                var has_base = false
                if n0 && !n1 {
                    base_h = u1
                    has_base = true
                } else {
                    if n1 && !n0 {
                        base_h = u0
                        has_base = true
                    }
                }
                if has_base {
                    val nullable = make_nullable(a, resolve(a, base_h))
                    bind_var(a, idx, nullable)
                } else {
                    solver_ambiguous(ctx, a, idx, unique, cands)
                }
            } else {
                if unique.len() > 2 {
                    solver_ambiguous(ctx, a, idx, unique, cands)
                }
            }
        }
        ki = ki + 1
    }
}

fun solver_ambiguous(ctx: ICtx, a: TypeArena, idx: u32, unique: List<u32>, cands: List<u32>): void {
    val resolved = resolve(a, cands.get(0) ?? 0)
    bind_var(a, idx, resolved)
    ctx.solver.errors.push(CErr(unique.get(0) ?? 0, unique.get(1) ?? 0,
        "ambiguous inference for TypeVar{idx}: {unique.len()} distinct candidates"))
}

// nullish:Null 或内型未绑的 Nullable。
fun is_nullish(a: TypeArena, h: u32): bool {
    val r = resolve(a, h)
    match Arena.get(a, r) {
        TNull => { true }
        TNullable(_) => {
            match Arena.get(a, resolve(a, nullable_inner(a, r))) {
                TTypeVar(_) => { true }
                _ => { false }
            }
        },
        _ => { false }
    }
}

// ─── Flow:流窄化上下文 ────────────────────────────────────────────

fun flow_push_scope(ctx: ICtx): void {
    ctx.flow.scopes.push(FlowScope(List.empty<FFact>(), Map.empty<str, List<i64>>()))
}

fun flow_pop_scope(ctx: ICtx): void {
    if ctx.flow.scopes.len() > 1 {
        val dropped = ctx.flow.scopes.pop()
    }
}

fun flow_add_fact(ctx: ICtx, fact: FFact): void {
    var i: i64 = ctx.flow.scopes.len() as i64 - 1
    if i >= 0 {
        match ctx.flow.scopes.get(i as usize) {
            null => {}
            top => {
                val idx = top.facts.len() as i64
                match top.by_path.get(fact.path) {
                    null => {
                        val l = List.empty<i64>()
                        l.push(idx)
                        top.by_path.set(fact.path, l)
                    },
                    l => { l.push(idx) },
                }
                top.facts.push(fact)
            },
        }
    }
}

// path 窄化查询:内层遮蔽外层;ConstructorMatch 的 bound_vars 含 path
// 时跳过(模式变量遮蔽 scrutinee;Bug#35)。
fun flow_lookup_narrowed(ctx: ICtx, path: str): u32? {
    var i: i64 = ctx.flow.scopes.len() as i64 - 1
    while i >= 0 {
        match ctx.flow.scopes.get(i as usize) {
            null => {}
            scope => {
                match scope.by_path.get(path) {
                    null => {}
                    idxs => {
                        val last = idxs.get(idxs.len() - 1) ?? 0
                        match scope.facts.get(last as usize) {
                            null => {}
                            fact => {
                                match fact.kind {
                                    NKCtorMatch(_, bound_vars) => {
                                        if arr_has_str(bound_vars, path) {
                                            // 遮蔽:此 fact 不适用,继续向外层。
                                        } else {
                                            return fact.narrowed_ty
                                        }
                                    },
                                    _ => { return fact.narrowed_ty },
                                }
                            },
                        }
                    },
                }
            },
        }
        i = i - 1
    }
    null
}

// 表达式规范路径:Ident → 名;FieldAccess → "recv.field";其余 null。

// str[] 包含测试(流事实 bound_vars 为数组形态)。
fun arr_has_str(arr: str[], key: str): bool {
    var i: usize = 0
    while i < arr.len() {
        if arr[i] == key {
            return true
        }
        i = i + 1
    }
    false
}

fun expr_path(ast: AstArena, expr: i64): str? {
    match ast.expr(expr).node {
        Ident(name) => { name }
        FieldAccessE(recv, field) => {
            match expr_path(ast, recv) {
                null => { null }
                p => { "{p}.{field}" }
            }
        },
        _ => { null }
    }
}

// 点分路径字段类型静默解析(env 根变量 + 逐段字段)。
fun resolve_field_path(ctx: ICtx, a: TypeArena, s: SemaRes, env: u32, path: str): u32? {
    val pos = find_last_sub(path, ".")
    if pos < 0 {
        return null
    }
    val root = Str.substring(path, 0, pos as usize)
    val rest = Str.substring(path, (pos + 1) as usize, path.len())
    var ty = lookup(s.env, env, root)
    if ty == null {
        return null
    }
    var cur = ty ?? 0
    val segs = Str.split(rest, ".")
    var i: usize = 0
    while i < segs.len() {
        match try_field_type_quiet(ctx, a, s, cur, segs[i]) {
            null => { return null }
            t => { cur = t }
        }
        i = i + 1
    }
    cur
}

// 无诊断的字段类型解析(命名类型走 sema 定义;匿名 record 走字段表)。
fun try_field_type_quiet(ctx: ICtx, a: TypeArena, s: SemaRes, recv_ty: u32, field: str): u32? {
    val resolved = resolve(a, recv_ty)
    match Arena.get(a, resolved) {
        TRef(_) => {
            return try_field_type_quiet(ctx, a, s, ref_parts(a, resolved).a, field)
        },
        _ => {},
    }
    match Relate.type_name(a, resolved) {
        null => {}
        name => {
            match lookup_field_id(s, name, field) {
                null => { return null }
                field_id => {
                    match get_type_def(s, name) {
                        null => { return null }
                        def => {
                            var idx = field_id
                            if def.kind != Data.TRecord {
                                if field_id > 0 {
                                    idx = field_id - 1
                                } else {
                                    idx = 0
                                }
                            }
                            var ci: usize = 0
                            while ci < def.constructors.len() {
                                val ctor = def.constructors[ci]
                                var fi: usize = 0
                                while fi < ctor.field_names.len() {
                                    match ctor.field_names[fi] {
                                        null => {}
                                        fname => {
                                            if fname == field {
                                                if idx >= 0 && (idx as usize) < ctor.field_type_reprs.len() {
                                                    return type_repr_to_handle_ctx(ctx, a, s, ctor.field_type_reprs[idx as usize])
                                                }
                                                return null
                                            }
                                        },
                                    }
                                    fi = fi + 1
                                }
                                ci = ci + 1
                            }
                            return null
                        },
                    }
                },
            }
        },
    }
    val r2 = resolve(a, recv_ty)
    match Arena.get(a, r2) {
        TRecord(_) => {
            val fs = record_fields(a, r2)
            var i: usize = 0
            while i < fs.len() {
                match fs[i].name {
                    null => {}
                    n => {
                        if n == field {
                            return fs[i].ty
                        }
                    },
                }
                i = i + 1
            }
            null
        },
        _ => { null },
    }
}

// then/else 事实对。
pub type FF2 = FF2(pub then_facts: List<FFact>, pub else_facts: List<FFact>)

// nullable 路径 + null 字面 → NonNull 事实。
fun nonnull_fact(ctx: ICtx, a: TypeArena, s: SemaRes, ast: AstArena, env: u32,
    path_expr: i64, null_expr: i64): FFact? {
    val path = expr_path(ast, path_expr)
    if path == null {
        return null
    }
    match ast.expr(null_expr).node {
        NullLit => {}
        _ => { return null }
    }
    var ty = lookup(s.env, env, path ?? "")
    if ty == null {
        ty = resolve_field_path(ctx, a, s, env, path ?? "")
    }
    if ty == null {
        return null
    }
    val resolved = resolve(a, ty ?? 0)
    match Arena.get(a, resolved) {
        TNullable(_) => {
            FFact(path ?? "", nullable_inner(a, resolved), NKNonNull)
        },
        _ => { null },
    }
}

// `x != null` → then NonNull;`x == null` → else NonNull。
fun analyze_null_check_facts(ctx: ICtx, a: TypeArena, s: SemaRes, ast: AstArena,
    cond: i64, env: u32): FF2 {
    val then_facts = List.empty<FFact>()
    val else_facts = List.empty<FFact>()
    match ast.expr(cond).node {
        BinaryE(op, lhs, rhs) => {
            match op {
                Neq => {
                    match nonnull_fact(ctx, a, s, ast, env, lhs, rhs) {
                        null => {}
                        f => { then_facts.push(f) }
                    }
                    match nonnull_fact(ctx, a, s, ast, env, rhs, lhs) {
                        null => {}
                        f => { then_facts.push(f) }
                    }
                },
                Eq => {
                    match nonnull_fact(ctx, a, s, ast, env, lhs, rhs) {
                        null => {}
                        f => { else_facts.push(f) }
                    }
                    match nonnull_fact(ctx, a, s, ast, env, rhs, lhs) {
                        null => {}
                        f => { else_facts.push(f) }
                    }
                },
                _ => {},
            }
        },
        _ => {},
    }
    FF2(then_facts, else_facts)
}

// 构造器模式 → (ctor 名, 绑定变量名集)。
fun extract_constructor_pattern(ast: AstArena, pat: i64): PairCV? {
    match ast.pat(pat).node {
        PCtor(name, patterns) => {
            val bound = List.empty<str>()
            var i: usize = 0
            while i < patterns.len() {
                collect_pattern_binds(ast, patterns[i], bound)
                i = i + 1
            }
            PairCV(name, bound)
        },
        _ => { null }
    }
}

pub type PairCV = PairCV(pub name: str, pub bound: List<str>)

fun collect_pattern_binds(ast: AstArena, pref: i64, out: List<str>): void {
    match ast.pat(pref).node {
        PVar(name) => { out.push(name) }
        PCtor(_, patterns) => {
            var i: usize = 0
            while i < patterns.len() {
                collect_pattern_binds(ast, patterns[i], out)
                i = i + 1
            }
        },
        PRecord(fields) => {
            var i: usize = 0
            while i < fields.len() {
                collect_pattern_binds(ast, fields[i].pattern, out)
                i = i + 1
            }
        },
        POr(left, right) => {
            collect_pattern_binds(ast, left, out)
            collect_pattern_binds(ast, right, out)
        },
        PGuard(pattern, _) => {
            collect_pattern_binds(ast, pattern, out)
        },
        _ => {},
    }
}

// ─── Helpers:字面量/数值/迭代器/reflect/lib/隐私门 ────────────────

fun expr_is_literal(ast: AstArena, expr: i64): bool {
    match ast.expr(expr).node {
        IntLit(_, _) => { true }
        FloatLit(_, _) => { true }
        BoolLit(_) => { true }
        CharLit(_) => { true }
        StrLit(_) => { true }
        NullLit => { true }
        VoidLit => { true }
        _ => { false }
    }
}

fun expr_is_explicitly_typed_numeric(ast: AstArena, expr: i64): bool {
    match ast.expr(expr).node {
        IntLit(_, suffix) => { suffix != null }
        FloatLit(_, suffix) => { suffix != null }
        Ident(_) => { true }
        _ => { false }
    }
}

// ref/nullable 解包(SafeAccess 与数值检查用)。
fun unwrap_ref(a: TypeArena, ty: u32): u32 {
    val resolved = resolve(a, ty)
    match Arena.get(a, resolved) {
        TRef(_) => { ref_parts(a, resolved).a }
        TNullable(_) => { nullable_inner(a, resolved) }
        _ => { resolved }
    }
}

// 数值二元兼容(Bug#73/#74):跨类恒错;同类异宽仅双侧显式类型才错。
fun check_numeric_binop_compat(ctx: ICtx, a: TypeArena, s: SemaRes, ast: AstArena,
    lhs: i64, rhs: i64, left_ty0: u32, right_ty0: u32, line: i64, column: i64): void {
    val left_ty = unwrap_ref(a, left_ty0)
    val right_ty = unwrap_ref(a, right_ty0)
    if types_equal(a, left_ty, right_ty) {
        return
    }
    val lc = Arena.get(a, left_ty)
    val rc = Arena.get(a, right_ty)
    val left_str = display(a, left_ty)
    val right_str = display(a, right_ty)
    if (ty_is_int(lc) && ty_is_float(rc)) || (ty_is_float(lc) && ty_is_int(rc)) {
        add_error_at(s,
            "type mismatch: cannot operate on '{left_str}' and '{right_str}' without explicit cast (int/float category mismatch)",
            line, column)
        return
    }
    if expr_is_explicitly_typed_numeric(ast, lhs) && expr_is_explicitly_typed_numeric(ast, rhs) {
        add_error_at(s,
            "type mismatch: cannot operate on '{left_str}' and '{right_str}' without explicit cast (different bit widths)",
            line, column)
    }
}

// 迭代器元素类型结构提取。
fun extract_iterator_element(a: TypeArena, ty: u32): u32? {
    match Arena.get(a, ty) {
        TArray(_) => {
            array_parts(a, ty).a
        },
        TStr => {
            make(a, TChar)
        },
        TGeneric(_) => {
            val p = generic_parts(a, ty)
            if (p.a == "ArrayIter" || p.a == "Iter") && p.b.len() == 1 {
                p.b[0]
            } else {
                if p.a == "RangeIterator" {
                    make(a, TI64)
                } else {
                    if (p.a == "MapIter" || p.a == "MapKeys" || p.a == "MapValues") && p.b.len() == 1 {
                        p.b[0]
                    } else {
                        if p.a == "Map" && p.b.len() == 2 {
                            make_generic(a, "Entry", [p.b[0], p.b[1]])
                        } else {
                            null
                        }
                    }
                }
            }
        },
        TThrow(_) => {
            thr_parts(a, ty).a
        },
        _ => { null },
    }
}

// reflect 自动实现方法返回类型(空参方法须 arg_count==0;field_name 一参)。
fun reflect_method_return_type(a: TypeArena, method: str, arg_count: i64, recv_ty: u32): u32? {
    match method {
        "repr" => { if arg_count == 0 { make(a, TStr) } else { null } }
        "type_name" => { if arg_count == 0 { make(a, TStr) } else { null } }
        "kind" => { if arg_count == 0 { make(a, TStr) } else { null } }
        "constructor" => { if arg_count == 0 { make(a, TStr) } else { null } }
        "size" => { if arg_count == 0 { make(a, TU32) } else { null } }
        "alignment" => { if arg_count == 0 { make(a, TU32) } else { null } }
        "field_count" => { if arg_count == 0 { make(a, TU16) } else { null } }
        "clone" => { if arg_count == 0 { resolve(a, recv_ty) } else { null } }
        "field_name" => { if arg_count == 1 { make(a, TStr) } else { null } }
        _ => { null }
    }
}

fun ffi_error_ty(a: TypeArena): u32 {
    make_adt(a, "FfiError", [])
}

// Lib/ForeignFn 内建方法返回类型(lookup 的 R 为新 var,由下游求解)。
fun lib_method_return_type(ctx: ICtx, a: TypeArena, s: SemaRes, recv_ct: Ty, recv_h: u32,
    method: str, arg_count: i64, expected: u32?): u32? {
    match recv_ct {
        TLib(_) => {
            if method == "lookup" && arg_count == 2 {
                val r = fresh_type_var(a)
                val ff = make_foreign_fn(a, r)
                val err = ffi_error_ty(a)
                val ret = make_throw(a, ff, err)
                match expected {
                    null => {}
                    exp => { unify_or_constrain(ctx, a, ret, exp) }
                }
                ret
            } else {
                if method == "has_symbol" && arg_count == 1 {
                    make(a, TBool)
                } else {
                    if method == "address_of" && arg_count == 1 {
                        make(a, TU64)
                    } else {
                        if method == "close" && arg_count == 0 {
                            make(a, TVoid)
                        } else {
                            null
                        }
                    }
                }
            }
        },
        TForeignFn(_) => {
            if method == "call" {
                val ret = foreign_fn_ret(a, recv_h)
                val err = ffi_error_ty(a)
                make_throw(a, ret, err)
            } else {
                null
            }
        },
        _ => { null },
    }
}

// 整数后缀 → 类型(数值名单内且 int 族)。
fun int_suffix_to_type(a: TypeArena, suffix: str): u32? {
    match from_type_name_full(suffix) {
        null => { null }
        t => {
            if ty_is_int(t) {
                make(a, t)
            } else {
                null
            }
        },
    }
}

fun float_suffix_to_type(a: TypeArena, suffix: str): u32? {
    match from_type_name_full(suffix) {
        null => { null }
        t => {
            if ty_is_float(t) {
                make(a, t)
            } else {
                null
            }
        },
    }
}

// 注解显示(Bug#61:命名 alias 注解保留别名拼写)。
fun display_type_annotation(ctx: ICtx, a: TypeArena, s: SemaRes, ta: i64, ast: AstArena,
    annot_ty: u32): str {
    match ast.ty(ta).node {
        TNamed(name) => {
            match get_type_def(s, name) {
                null => {}
                td => {
                    if td.kind == TAlias {
                        return name
                    }
                },
            }
        },
        _ => {},
    }
    display(a, annot_ty)
}

// 隐私门:字段默认模块作用域;构造器跨模块须全 pub 字段;方法默认私。
fun field_privacy_error(ctx: ICtx, s: SemaRes, type_name: str, field: str): str? {
    val def = get_type_def(s, type_name)
    if def == null {
        return null
    }
    var target = def ?? TDef("", TAlias, [], [], null, null, [], [])
    var ci: usize = 0
    while ci < target.constructors.len() {
        val ctor = target.constructors[ci]
        var fi: usize = 0
        while fi < ctor.field_names.len() {
            match ctor.field_names[fi] {
                null => {}
                fname => {
                    if fname == field {
                        if ctor.def_module == ctx.current_module_name {
                            return null
                        }
                        var is_pub = true
                        if fi < ctor.field_is_pub.len() {
                            is_pub = ctor.field_is_pub[fi]
                        }
                        if is_pub {
                            return null
                        }
                        return "field '{type_name}.{field}' is private (module-scoped): mark it pub or use an accessor"
                    }
                },
            }
            fi = fi + 1
        }
        ci = ci + 1
    }
    null
}

fun ctor_privacy_error(ctx: ICtx, s: SemaRes, type_name: str, ctor_name: str): str? {
    val def = get_type_def(s, type_name)
    if def == null {
        return null
    }
    var target = def ?? TDef("", TAlias, [], [], null, null, [], [])
    var ci: usize = 0
    while ci < target.constructors.len() {
        val ctor = target.constructors[ci]
        if ctor.name == ctor_name {
            if ctor.def_module == ctx.current_module_name {
                return null
            }
            var any_private = false
            var fi: usize = 0
            while fi < ctor.field_names.len() && !any_private {
                match ctor.field_names[fi] {
                    null => {}
                    _ => {
                        if fi < ctor.field_is_pub.len() {
                            if !ctor.field_is_pub[fi] {
                                any_private = true
                            }
                        }
                    },
                }
                fi = fi + 1
            }
            if any_private {
                return "constructor '{type_name}.{ctor_name}' has private fields: cannot be constructed outside module '{ctor.def_module}'"
            }
            return null
        }
        ci = ci + 1
    }
    null
}

fun method_privacy_error(ctx: ICtx, s: SemaRes, type_name: str, method: str): str? {
    val def = get_type_def(s, type_name)
    if def == null {
        return null
    }
    var target = def ?? TDef("", TAlias, [], [], null, null, [], [])
    var def_module = ""
    if target.constructors.len() > 0 {
        def_module = target.constructors[0].def_module
    }
    if def_module == ctx.current_module_name {
        return null
    }
    var mi: usize = 0
    while mi < target.methods.len() {
        if target.methods[mi].name == method {
            if target.methods[mi].is_pub {
                return null
            }
            return "method '{type_name}.{method}' is private (module-scoped): mark it pub to call outside module '{def_module}'"
        }
        mi = mi + 1
    }
    null
}

// ─── 缺失返回值检查(Bug 族:非 void 声明 + 无尾表达式/return)─────

fun body_stmt_has_exit(ast: AstArena, stmt: i64): bool {
    match ast.stmt(stmt).node {
        ReturnS(value) => { value != null }
        ThrowS(_) => { true }
        LocalDeclS(_) => { false }
        DeferS(_) => { false }
        LoopS(body) => { body_expr_has_exit(ast, body) || !stmt_tree_has_break(ast, body) }
        ForS(_, _, body) => { body_expr_has_exit(ast, body) }
        WhileS(_, body) => { body_expr_has_exit(ast, body) }
        ExprS(expr) => { body_expr_has_exit(ast, expr) }
        _ => { false }
    }
}

fun body_expr_has_exit(ast: AstArena, expr: i64): bool {
    match ast.expr(expr).node {
        LambdaE(_, _, _, _) => { false }
        BlockE(stmts, trailing) => {
            var found = false
            var i: usize = 0
            while i < stmts.len() && !found {
                if body_stmt_has_exit(ast, stmts[i]) {
                    found = true
                }
                i = i + 1
            }
            if found {
                return true
            }
            match trailing {
                null => { false }
                t => { body_expr_has_exit(ast, t) }
            }
        },
        IfE(_, then_branch, else_branch) => {
            if body_expr_has_exit(ast, then_branch) {
                return true
            }
            match else_branch {
                null => { false }
                e => { body_expr_has_exit(ast, e) }
            }
        },
        MatchE(_, arms) => {
            var found = false
            var i: usize = 0
            while i < arms.len() && !found {
                if body_expr_has_exit(ast, arms[i].body) {
                    found = true
                }
                i = i + 1
            }
            found
        },
        _ => { false }
    }
}

fun stmt_tree_has_break(ast: AstArena, expr: i64): bool {
    match ast.expr(expr).node {
        LambdaE(_, _, _, _) => { false }
        BlockE(stmts, trailing) => {
            var found = false
            var i: usize = 0
            while i < stmts.len() && !found {
                match ast.stmt(stmts[i]).node {
                    BreakS => { found = true }
                    ExprS(e) => {
                        if stmt_tree_has_break(ast, e) {
                            found = true
                        }
                    },
                    ForS(_, _, b) => {
                        if stmt_tree_has_break(ast, b) {
                            found = true
                        }
                    },
                    WhileS(_, b) => {
                        if stmt_tree_has_break(ast, b) {
                            found = true
                        }
                    },
                    LoopS(b) => {
                        if stmt_tree_has_break(ast, b) {
                            found = true
                        }
                    },
                    _ => {},
                }
                i = i + 1
            }
            if found {
                return true
            }
            match trailing {
                null => { false }
                t => { stmt_tree_has_break(ast, t) }
            }
        },
        IfE(_, then_branch, else_branch) => {
            if stmt_tree_has_break(ast, then_branch) {
                return true
            }
            match else_branch {
                null => { false }
                e => { stmt_tree_has_break(ast, e) }
            }
        },
        MatchE(_, arms) => {
            var found = false
            var i: usize = 0
            while i < arms.len() && !found {
                if stmt_tree_has_break(ast, arms[i].body) {
                    found = true
                }
                i = i + 1
            }
            found
        },
        _ => { false }
    }
}

// 非声明非 void 返回 + 块体无尾表达式且无 return/throw → 报错。
fun check_missing_return_value(ctx: ICtx, a: TypeArena, s: SemaRes, what: str, ret_ty0: u32,
    body: i64, ast: AstArena, line: i64, column: i64): void {
    var ret_ty = ret_ty0
    var go = true
    while go {
        val resolved = resolve(a, ret_ty)
        match Arena.get(a, resolved) {
            TVoid => { return }
            TAsync(_) => { ret_ty = async_value(a, resolved) }
            _ => { go = false }
        }
    }
    var stmts: i64[] = []
    var trailing: i64? = null
    match ast.expr(body).node {
        BlockE(sts, trail) => {
            stmts = sts
            trailing = trail
        },
        _ => { return },
    }
    if trailing != null {
        return
    }
    var i: usize = 0
    while i < stmts.len() {
        if body_stmt_has_exit(ast, stmts[i]) {
            return
        }
        i = i + 1
    }
    add_error_at(s,
        "missing return value: {what} declares return type '{display(a, ret_ty)}' but its body has no trailing expression and no 'return'/'throw' statement",
        line, column)
}

// 同步函数声明 Throw 但尾部裸值(from_datetime_utc/scanln 泄漏类)。
fun check_throw_tail_wrapped(ctx: ICtx, a: TypeArena, s: SemaRes, what: str, ret_ty: u32,
    body: i64, body_ty: u32, ast: AstArena, line: i64, column: i64): void {
    match Arena.get(a, resolve(a, ret_ty)) {
        TThrow(_) => {}
        _ => { return }
    }
    match Arena.get(a, resolve(a, body_ty)) {
        TThrow(_) => { return }
        TTypeVar(_) => { return }
        TUnknown => { return }
        TNever => { return }
        TVoid => { return }
        _ => {},
    }
    match ast.expr(body).node {
        BlockE(_, null) => { return }
        _ => {},
    }
    add_error_at(s,
        "{what} declares return type '{display(a, ret_ty)}' but its tail evaluates to '{display(a, body_ty)}': wrap it in Ok(..) — sync functions do not auto-wrap (a trailing '?' unwraps)",
        line, column)
}

// ─── Unify:统一/放宽/传播检查 ─────────────────────────────────────

// 即时统一;失败入等式约束(定点重试)。Lazy 子sume 双向展开。
// 实例化模式(片5)跳过 HM 约束。
pub fun unify_or_constrain(ctx: ICtx, a: TypeArena, t1: u32, t2: u32): void {
    if ctx.inst != null {
        return
    }
    val ra = resolve(a, t1)
    val rb = resolve(a, t2)
    var a_is_lazy = false
    var b_is_lazy = false
    match Arena.get(a, ra) {
        TLazy(_) => { a_is_lazy = true }
        _ => {},
    }
    match Arena.get(a, rb) {
        TLazy(_) => { b_is_lazy = true }
        _ => {},
    }
    if a_is_lazy && !b_is_lazy {
        unify_or_constrain(ctx, a, lazy_value(a, ra), t2)
        return
    }
    if b_is_lazy && !a_is_lazy {
        unify_or_constrain(ctx, a, t1, lazy_value(a, rb))
        return
    }
    solver_record_candidate(ctx, a, t1, t2)
    if !unify_ok(a, t1, t2) {
        solver_add_equality(ctx, t1, t2)
    }
}

// 解包泄漏检测:值带 Nullable/Throw 包装而目标不带 → 泄漏种类。
fun unwrap_leak_kind(a: TypeArena, target: u32, value: u32): str? {
    val rt = resolve(a, target)
    val rv = resolve(a, value)
    val ct = Arena.get(a, rt)
    val cv = Arena.get(a, rv)
    match ct {
        TNullable(_) => { null }
        TTypeVar(_) => { null }
        _ => {
            match cv {
                TTypeVar(_) => { null }
                TNullable(_) => { "nullable" }
                _ => {
                    match ct {
                        TThrow(_) => { null }
                        _ => {
                            match cv {
                                TThrow(_) => { "throw" }
                                _ => { null }
                            }
                        },
                    }
                },
            }
        },
    }
}

// 继承替换裁决:SSNo=无关;SSYes=可替换(首基链或非首基经方法分发)。
pub type SSub = | SSNo | SSYes | SSMsg(str)

fun inheritance_substitutable(ctx: ICtx, a: TypeArena, s: SemaRes, param: u32, arg: u32): SSub {
    val rp = resolve(a, param)
    val ra = resolve(a, arg)
    var pname = ""
    match Arena.get(a, rp) {
        TAdt(_) => { pname = adt_parts(a, rp).a }
        _ => { return SSNo }
    }
    var aname = ""
    match Arena.get(a, ra) {
        TAdt(_) => { aname = adt_parts(a, ra).a }
        _ => { return SSNo }
    }
    if pname == aname {
        return SSNo
    }
    // 沿 arg 妹基链走:命中(含非首基)即可替换(方法按子类型分发)。
    var ok = false
    var late = false
    var current: str? = aname
    var hops: i64 = 0
    while current != null && hops <= 64 {
        val cn = current ?? ""
        val def = get_type_def(s, cn)
        if def == null {
            return SSNo
        }
        val target = def ?? TDef("", TAlias, [], [], null, null, [], [])
        var next: str? = null
        var i: usize = 0
        while i < target.bases.len() {
            val b = target.bases[i]
            if b == pname {
                if i == 0 && !late {
                    ok = true
                } else {
                    late = true
                    ok = false
                }
            }
            if i == 0 {
                next = if true { b } else { null }
            }
            i = i + 1
        }
        if ok || late {
            break
        }
        current = next
        hops = hops + 1
    }
    if ok || late {
        return SSYes
    }
    SSNo
}

// 调用点实参检查:硬具体对失配即报;数值/错误接口豁免;解包泄漏守卫;
// nullable/throw 结构提升;继承/trait 见证替换。
fun unify_call_arg(ctx: ICtx, a: TypeArena, s: SemaRes, param: u32, arg: u32,
    line: i64, column: i64, arg_is_null_lit: bool): void {
    val rp = resolve(a, param)
    val ra = resolve(a, arg)
    val concrete_pair = !type_contains_typevar(a, rp) && !type_contains_typevar(a, ra)
    val hard_fail = !unify_ok(a, rp, ra)
    val both_numeric = ty_is_numeric(Arena.get(a, rp)) && ty_is_numeric(Arena.get(a, ra))
    // Error 接口协变豁免(param Adt 名 "Error")。
    var param_is_error_iface = false
    match Arena.get(a, rp) {
        TAdt(_) => {
            if adt_parts(a, rp).a == "Error" {
                param_is_error_iface = true
            }
        },
        _ => {},
    }
    if concrete_pair && !both_numeric && !param_is_error_iface && hard_fail {
        match unwrap_leak_kind(a, param, arg) {
            null => {}
            kind => {
                if !arg_is_null_lit {
                    add_error_at(s,
                        "argument type incompatible: cannot pass a {kind} value where '{display(a, rp)}' is expected — unwrap explicitly ('?? default', '!', '?', or an '!= null' narrowed branch)",
                        line, column)
                    return
                }
            },
        }
        var widened = false
        match try_widen_unify(ctx, a, param, arg) {
            TWOk(_) => { widened = true }
            TWErr(_) => { widened = false }
        }
        if !widened {
            match inheritance_substitutable(ctx, a, s, param, arg) {
                SSYes => { return }
                SSMsg(m) => {
                    add_error_at(s, m, line, column)
                    return
                }
                SSNo => {},
            }
        }
        if !widened {
            // trait 形参替换:具体类型有该 trait(或其子 trait)见证 → 通过。
            var tname: str? = null
            match Arena.get(a, rp) {
                TTrait(_) => { tname = if true { trait_parts(a, rp).a } else { null } }
                TAdt(_) => {
                    val n = adt_parts(a, rp).a
                    if get_trait_def(s, n) != null {
                        tname = if true { n } else { null }
                    }
                },
                _ => {},
            }
            match tname {
                null => {}
                tn => {
                    match Arena.get(a, ra) {
                        TAdt(_) => {
                            val aname = adt_parts(a, ra).a
                            var has_witness = false
                            var wi: usize = 0
                            while wi < s.witness_entries.len() && !has_witness {
                                val e = s.witness_entries.get(wi) ?? WEnt("", 0, Map.empty<str, i64>(), "")
                                if e.trait_name == tn {
                                    if e.type_name == aname {
                                        has_witness = true
                                    }
                                }
                                wi = wi + 1
                            }
                            if has_witness {
                                return
                            }
                        },
                        _ => {},
                    }
                },
            }
        }
        if !widened {
            add_error_at(s,
                "argument type mismatch: cannot pass '{display(a, ra)}' where '{display(a, rp)}' is expected",
                line, column)
            return
        }
    }
    unify_or_constrain(ctx, a, param, arg)
}

// 声明返回类型 × 体推断类型统一(nullable/throw 放宽;async 展开;
// 解包泄漏守卫)。Ok=true。
fun unify_return_type(ctx: ICtx, a: TypeArena, s: SemaRes, declared: u32, inferred: u32,
    line: i64, column: i64): bool {
    val r_declared = resolve(a, declared)
    val r_inferred = resolve(a, inferred)
    val declared_ty = Arena.get(a, r_declared)
    val inferred_ty = Arena.get(a, r_inferred)
    // Async 双侧 → 内型递归;声明 Async + 体裸值 → 内型 vs 体。
    match declared_ty {
        TAsync(_) => {
            val da = async_value(a, r_declared)
            match inferred_ty {
                TAsync(_) => {
                    return unify_return_type(ctx, a, s, da, async_value(a, r_inferred), line, column)
                }
                _ => {
                    return unify_return_type(ctx, a, s, da, r_inferred, line, column)
                },
            }
        },
        _ => {},
    }
    match declared_ty {
        TNullable(_) => {
            match inferred_ty {
                TNullable(_) => { unify_ok(a, declared, inferred) }
                TVoid => { true }
                _ => {
                    val inner = nullable_inner(a, r_declared)
                    match try_widen_unify(ctx, a, inner, r_inferred) {
                        TWOk(_) => { true }
                        TWErr(_) => { unify_ok(a, inner, r_inferred) }
                    }
                },
            }
        },
        TThrow(_) => {
            match inferred_ty {
                TThrow(_) => {
                    match try_widen_unify(ctx, a, declared, inferred) {
                        TWOk(_) => { true }
                        TWErr(_) => { unify_ok(a, declared, inferred) }
                    }
                }
                TVoid => { true }
                _ => {
                    val p = thr_parts(a, r_declared)
                    match try_widen_unify(ctx, a, p.a, r_inferred) {
                        TWOk(_) => { true }
                        TWErr(_) => { unify_ok(a, p.a, r_inferred) }
                    }
                },
            }
        },
        _ => {
            // 解包泄漏守卫(void 载荷 Throw 例外)。
            match unwrap_leak_kind(a, r_declared, r_inferred) {
                null => {}
                kind => {
                    var void_payload = false
                    if kind == "throw" {
                        val p = thr_parts(a, r_inferred)
                        match Arena.get(a, resolve(a, p.a)) {
                            TVoid => { void_payload = true }
                            _ => {},
                        }
                    }
                    if !void_payload {
                        add_error_at(s,
                            "return type mismatch: body evaluates to a {kind} value ('{display(a, r_inferred)}') but the declared return type is '{display(a, r_declared)}' — unwrap explicitly ('?? default', '!', '?', or an '!= null' narrowed branch)",
                            line, column)
                        return false
                    }
                },
            }
            match try_widen_unify(ctx, a, r_declared, r_inferred) {
                TWOk(_) => { true }
                TWErr(_) => { unify_ok(a, declared, inferred) }
            }
        },
    }
}

// 放宽统一:strict unify → never 吸收 → async 展开 → nullable/throw/
// void 结构互通(无数值放宽,#60 全严)。
// 放宽统一结果(Ok 携带统一类型;Err 携带诊断文案)。
pub type TW = | TWOk(u32) | TWErr(str)

fun try_widen_unify(ctx: ICtx, a: TypeArena, t1: u32, t2: u32): TW {
    val r1 = resolve(a, t1)
    val r2 = resolve(a, t2)
    match Arena.get(a, r1) {
        TNever => { return TWOk(r2) }
        _ => {},
    }
    match Arena.get(a, r2) {
        TNever => { return TWOk(r1) }
        _ => {},
    }
    if unify_ok(a, r1, r2) {
        return TWOk(r1)
    }
    val c1 = Arena.get(a, r1)
    val c2 = Arena.get(a, r2)
    match c1 {
        TAsync(_) => {
            return try_widen_unify(ctx, a, async_value(a, r1), r2)
        },
        _ => {},
    }
    match c2 {
        TAsync(_) => {
            return try_widen_unify(ctx, a, r1, async_value(a, r2))
        },
        _ => {},
    }
    match c1 {
        TNullable(_) => {
            match c2 {
                TNullable(_) => {
                    val i1 = resolve(a, nullable_inner(a, r1))
                    val i2 = resolve(a, nullable_inner(a, r2))
                    if unify_ok(a, i1, i2) {
                        return TWOk(r1)
                    }
                    return TWErr("type mismatch")
                },
                TVoid => { return TWOk(r1) },
                _ => {
                    if unify_ok(a, nullable_inner(a, r1), r2) {
                        return TWOk(r1)
                    }
                    return TWErr("type mismatch")
                },
            }
        },
        TThrow(_) => {
            match c2 {
                TThrow(_) => {
                    val p1 = thr_parts(a, r1)
                    val p2 = thr_parts(a, r2)
                    if !unify_ok(a, p1.b, p2.b) {
                        return TWErr("type mismatch")
                    }
                    if unify_ok(a, p1.a, p2.a) {
                        return TWOk(r1)
                    }
                    match try_widen_unify(ctx, a, p1.a, p2.a) {
                        TWOk(_) => { return TWOk(r1) }
                        TWErr(_) => { return TWErr("type mismatch") }
                    }
                },
                TVoid => { return TWOk(r1) },
                _ => {
                    if unify_ok(a, thr_parts(a, r1).a, r2) {
                        return TWOk(r1)
                    }
                    return TWErr("type mismatch")
                },
            }
        },
        TVoid => {
            match c2 {
                TNullable(_) => { return TWOk(r2) }
                TThrow(_) => { return TWOk(r2) }
                _ => { return TWErr("type mismatch") }
            }
        },
        _ => {
            match c2 {
                TNullable(_) => {
                    if unify_ok(a, r1, nullable_inner(a, r2)) {
                        return TWOk(r2)
                    }
                    return TWErr("type mismatch")
                },
                TThrow(_) => {
                    if unify_ok(a, r1, thr_parts(a, r2).a) {
                        return TWOk(r2)
                    }
                    return TWErr("type mismatch")
                },
                _ => { return TWErr("type mismatch") }
            }
        },
    }
}

// `?` 传播符合法性:nullable 展开;throw 展开值型 + 错型与外层返回
// 统一;TypeVar 挂起;其余报错。
fun check_propagate(ctx: ICtx, a: TypeArena, s: SemaRes, resolved_inner: u32, inner_ty: u32,
    expected_return: u32?, line: i64, column: i64): u32 {
    match Arena.get(a, resolved_inner) {
        TNullable(_) => { nullable_inner(a, resolved_inner) }
        TThrow(_) => {
            val p = thr_parts(a, resolved_inner)
            match expected_return {
                null => {}
                er => {
                    val er_resolved = resolve(a, er ?? 0)
                    var outer_resolved = er_resolved
                    match Arena.get(a, er_resolved) {
                        TAsync(_) => {
                            outer_resolved = resolve(a, async_value(a, er_resolved))
                        },
                        _ => {},
                    }
                    match Arena.get(a, outer_resolved) {
                        TThrow(_) => {
                            unify_or_constrain(ctx, a, p.b, thr_parts(a, outer_resolved).b)
                        },
                        _ => {},
                    }
                },
            }
            p.a
        }
        TTypeVar(_) => { fresh_type_var(a) }
        _ => {
            add_error_at(s,
                "propagation operator '?' cannot be used on a non-nullable, non-throw expression",
                line, column)
            inner_ty
        },
    }
}

fun check_throw_stmt(ctx: ICtx, a: TypeArena, s: SemaRes, thrown_ty: u32, line: i64, column: i64): void {
    // 宽容:throw 是通用提升机制(引擎全臂放行;保持调用形状一致)。
}

// ─── TypeRepr → TypeHandle(签名恢复;ctx 感知 this/解析链)────────

pub fun type_repr_to_handle_ctx(ctx: ICtx, a: TypeArena, s: SemaRes, r: TR): u32 {
    match r {
        TRNamed(name) => {
            val visiting = List.empty<str>()
            resolve_name_to_type(ctx, a, s, name, Map.empty<str, u32>(), visiting)
        },
        TRThis => {
            match current_this_type(ctx) {
                null => { fresh_type_var(a) }
                ty => { ty }
            }
        },
        TRGeneric(name, args) => {
            var hs: u32[] = []
            var i: usize = 0
            while i < args.len() {
                hs = hs ++ [type_repr_to_handle_ctx(ctx, a, s, args[i])]
                i = i + 1
            }
            if is_builtin_generic_type(name) {
                return make_builtin_generic(a, name, hs)
            }
            if get_trait_def(s, name) != null {
                val canonical = resolve_trait_key(s, name)
                return make_trait(a, canonical, hs)
            }
            var has_params = false
            match get_type_def(s, name) {
                null => {}
                d => {
                    if d.type_params.len() > 0 {
                        has_params = true
                    }
                },
            }
            if has_params {
                return make_adt(a, name, hs)
            }
            make_generic(a, name, hs)
        },
        TRNullable(inner) => {
            make_nullable(a, type_repr_to_handle_ctx(ctx, a, s, inner))
        },
        TRRef(inner) => {
            make_ref(a, type_repr_to_handle_ctx(ctx, a, s, inner), false)
        },
        TRRaw(inner) => {
            make_ref(a, type_repr_to_handle_ctx(ctx, a, s, inner), true)
        },
        TRFun(ps, ret) => {
            var hs: u32[] = []
            var i: usize = 0
            while i < ps.len() {
                hs = hs ++ [type_repr_to_handle_ctx(ctx, a, s, ps[i])]
                i = i + 1
            }
            make_fn(a, hs, type_repr_to_handle_ctx(ctx, a, s, ret))
        },
        TRArray(elem, _) => {
            make_array(a, type_repr_to_handle_ctx(ctx, a, s, elem), null)
        },
    }
}

// ─── 表达式类型存储 ───────────────────────────────────────────────

fun store_expr_info(ctx: ICtx, a: TypeArena, s: SemaRes, expr: i64, ty: u32): void {
    val resolved = resolve(a, ty)
    match ctx.inst {
        null => {
            put_expr(s, module_expr_key(ctx.current_module_name, expr), resolved)
        },
        ictx => {
            // 局部对表(实例内表小,线性查重=旧 Map 键唯一+last-wins 覆盖)。
            var j: usize = 0
            var hit = false
            while j < ictx.local_expr_types.len() && !hit {
                val cur = ictx.local_expr_types.get(j) ?? ETMap(0, 0)
                if cur.expr == expr {
                    ictx.local_expr_types.set(j, ETMap(expr, resolved))
                    hit = true
                }
                j = j + 1
            }
            if !hit {
                ictx.local_expr_types.push(ETMap(expr, resolved))
            }
            s.resolved_types.set(module_expr_key(ictx.module_name, expr), resolved)
        },
    }
}

// ─── Match:构造器查找/模式推断/穷尽性(Maranget)──────────────────

// 限定构造器访问裁决:Type.Ctor → (ctor 拥有类型, 字段 reprs)。
fun check_qualified_ctor(ctx: ICtx, s: SemaRes, type_name: str, ctor_name: str): QC? {
    val canonical = resolve_type_key(s, type_name)
    match type_def_idx(s, canonical) {
        null => { null }
        type_idx => {
            match s.type_defs.get(type_idx as usize) {
                null => { null }
                def => {
                    var ci: usize = 0
                    while ci < def.constructors.len() {
                        val ctor = def.constructors[ci]
                        if ctor.name == ctor_name {
                            return QC(ctor.type_name, ctor.field_type_reprs)
                        }
                        ci = ci + 1
                    }
                    null
                },
            }
        },
    }
}

pub type QC = QC(pub type_name: str, pub field_reprs: TR[])

// 按名 + 期望类型消歧构造器(限定拼写走模块限定词锚定)。
fun find_ctor_def(ctx: ICtx, a: TypeArena, s: SemaRes, ctor_name: str, expected_ty: u32): Ctor? {
    if Str.contains(ctor_name, ".") {
        val bare = tail_seg(ctor_name)
        val pos = find_last_sub(ctor_name, ".")
        val qual = Str.substring(ctor_name, 0, pos as usize)
        val anchor = resolve_module_qualifier(s, s.current_module_name, qual)
        val all = ctor_defs_of(s, bare)
        val cands = List.empty<Ctor>()
        var i: usize = 0
        while i < all.len() {
            val c = all.get(i) ?? Ctor("", "", [], [], [], false, null, null, [], Span(0, 0), "")
            var in_module = false
            match anchor {
                null => { in_module = false }
                QRes(_, true) => { in_module = !Str.contains(c.type_name, ".") }
                QRes(anchor_path, false) => {
                    in_module = Str.starts_with(c.type_name, "{anchor_path}.")
                },
            }
            if in_module {
                cands.push(c)
            }
            i = i + 1
        }
        if cands.len() == 1 {
            return cands.get(0)
        }
        if cands.len() > 1 {
            val exp_resolved = resolve(a, expected_ty)
            match Arena.get(a, exp_resolved) {
                TAdt(_) => {
                    val exp_type_name = adt_parts(a, exp_resolved).a
                    var ci: usize = 0
                    var hit: Ctor? = null
                    var hits: i64 = 0
                    while ci < cands.len() {
                        val c = cands.get(ci) ?? Ctor("", "", [], [], [], false, null, null, [], Span(0, 0), "")
                        if c.type_name == exp_type_name {
                            hit = if true { c } else { null }
                            hits = hits + 1
                        }
                        ci = ci + 1
                    }
                    if hits == 1 {
                        return hit
                    }
                }
                _ => {},
            }
        }
        if cands.len() > 0 {
            return cands.get(0)
        }
        return null
    }
    val cands = ctor_defs_of(s, ctor_name)
    if cands.len() <= 1 {
        if cands.len() == 1 {
            return cands.get(0)
        }
        return null
    }
    // 期望类型定向消歧。
    val exp_resolved = resolve(a, expected_ty)
    match Arena.get(a, exp_resolved) {
        TAdt(_) => {
            val exp_type_name = adt_parts(a, exp_resolved).a
            var ci: usize = 0
            var hit: Ctor? = null
            var hits: i64 = 0
            while ci < cands.len() {
                val c = cands.get(ci) ?? Ctor("", "", [], [], [], false, null, null, [], Span(0, 0), "")
                if c.type_name == exp_type_name {
                    hit = if true { c } else { null }
                    hits = hits + 1
                }
                ci = ci + 1
            }
            if hits == 1 {
                return hit
            }
        },
        _ => {},
    }
    cands.get(0)
}

// 构造器模式 GADT 细化:Throw 变体绑定值/错臂;注册 ctor 统一返回
// 类型与期望;子模式按字段类型绑定。
fun refine_constructor_pattern(ctx: ICtx, a: TypeArena, s: SemaRes, ctor_name: str,
    sub_patterns: i64[], expected_ty: u32, ast: AstArena, env: u32): bool {
    val resolved_expected = resolve(a, expected_ty)
    val ctor_info = find_ctor_def(ctx, a, s, ctor_name, expected_ty)
    // Throw 内建变体:Ok → 值臂;"Error"/"Err"/注册错误构造器 → 错臂。
    match Arena.get(a, resolved_expected) {
        TThrow(_) => {
            val p = thr_parts(a, resolved_expected)
            var is_error_variant = ctor_name == "Error" || ctor_name == "Err"
            if ctor_info != null {
                is_error_variant = true
            }
            val branch_ty = if is_error_variant { p.b } else { p.a }
            var i: usize = 0
            while i < sub_patterns.len() {
                infer_pattern(ctx, a, s, sub_patterns[i], ast, branch_ty, env)
                i = i + 1
            }
            return true
        },
        _ => {},
    }
    if ctor_info == null {
        return false
    }
    val ctor = ctor_info ?? Ctor("", "", [], [], [], false, null, null, [], Span(0, 0), "")
    // 构造器返回类型:GADT return_type_node → type_from_ast;常规 → Adt。
    val ctor_return_ty = match ctor.return_type_node {
        null => { make_adt(a, ctor.type_name, []) }
        rtn => { type_from_ast(ctx, a, s, rtn, ast) }
    }
    // 兼容统一(nullable 剥壳后 unify;失败入约束)。
    var unify_target = expected_ty
    val r = resolve(a, expected_ty)
    match Arena.get(a, r) {
        TNullable(_) => { unify_target = nullable_inner(a, r) }
        _ => {},
    }
    val ctor_compatible = unify_ok(a, ctor_return_ty, unify_target)
    if !ctor_compatible {
        unify_or_constrain(ctx, a, ctor_return_ty, unify_target)
    }
    var i: usize = 0
    while i < sub_patterns.len() {
        var sub_ty = expected_ty
        if ctor_compatible {
            if i < ctor.field_type_reprs.len() {
                sub_ty = type_repr_to_handle_ctx(ctx, a, s, ctor.field_type_reprs[i])
            } else {
                sub_ty = fresh_type_var(a)
            }
        }
        infer_pattern(ctx, a, s, sub_patterns[i], ast, sub_ty, env)
        i = i + 1
    }
    true
}

// 模式推断 + 绑定变量入 env。
fun infer_pattern(ctx: ICtx, a: TypeArena, s: SemaRes, pat: i64, ast: AstArena,
    expected_ty: u32, env: u32): void {
    val st = ast.pat(pat)
    match st.node {
        PWild => {},
        PLit(lit) => {
            var lit_ty: u32? = null
            match lit {
                PLInt(_) => { lit_ty = if true { make(a, TI32) } else { null } }
                PLFloat(_) => { lit_ty = if true { make(a, TF64) } else { null } }
                PLBool(_) => { lit_ty = if true { make(a, TBool) } else { null } }
                PLChar(_) => { lit_ty = if true { make(a, TChar) } else { null } }
                PLStr(_) => { lit_ty = if true { make(a, TStr) } else { null } }
                PLNull => {},
            }
            match lit_ty {
                null => {}
                lt => {
                    val resolved = resolve(a, expected_ty)
                    var is_int_expected = false
                    match Arena.get(a, resolved) {
                        TBool => {}
                        TChar => {}
                        TStr => {}
                        TNull => {}
                        t2 => { is_int_expected = ty_is_int(t2) }
                    }
                    var is_int_lit = false
                    match lit {
                        PLInt(_) => { is_int_lit = true }
                        _ => {},
                    }
                    if !(is_int_lit && is_int_expected) {
                        unify_or_constrain(ctx, a, lt ?? 0, expected_ty)
                    }
                },
            }
        },
        PVar(name) => {
            if is_upper_name(name) {
                refine_constructor_pattern(ctx, a, s, name, [], expected_ty, ast, env)
            } else {
                define(s.env, env, name, expected_ty)
            }
        },
        PCtor(name, patterns) => {
            if !refine_constructor_pattern(ctx, a, s, name, patterns, expected_ty, ast, env) {
                // 未注册构造器回退:reprs 取自首个同名 ctor。
                var reprs: TR[] = []
                match get_ctor_def(s, name) {
                    null => {
                        add_error_at(s,
                            "unknown constructor pattern '{name}': no constructor of this name exists (T? matches with `null => ...` plus a binding arm)",
                            st.span.line, st.span.column)
                    }
                    c => { reprs = c.field_type_reprs },
                }
                var i: usize = 0
                while i < patterns.len() {
                    var sub_ty = fresh_type_var(a)
                    if i < reprs.len() {
                        sub_ty = type_repr_to_handle_ctx(ctx, a, s, reprs[i])
                    }
                    infer_pattern(ctx, a, s, patterns[i], ast, sub_ty, env)
                    i = i + 1
                }
            }
        },
        PRecord(fields) => {
            var i: usize = 0
            while i < fields.len() {
                val field_ty = fresh_type_var(a)
                infer_pattern(ctx, a, s, fields[i].pattern, ast, field_ty, env)
                i = i + 1
            }
        },
        POr(left, right) => {
            infer_pattern(ctx, a, s, left, ast, expected_ty, env)
            infer_pattern(ctx, a, s, right, ast, expected_ty, env)
        },
        PGuard(pattern, condition) => {
            infer_pattern(ctx, a, s, pattern, ast, expected_ty, env)
            val cond_ty = infer_expr(ctx, a, s, condition, ast, env, null)
            val bool_ty = make(a, TBool)
            unify_or_constrain(ctx, a, cond_ty, bool_ty)
        },
    }
}

fun is_upper_name(name: str): bool {
    val b = name.bytes()
    if b.len() == 0 {
        return false
    }
    b[0] >= 65 && b[0] <= 90
}

// ── 穷尽性(Maranget 有用性矩阵)──

// 构造器标识。
pub type PC =
    | PCAdt(str)
    | PCBool(bool)
    | PCInt(str)
    | PCFloat(str)
    | PCChar(i64)
    | PCStr(str)
    | PCNull

// 规范化模式(Or 展开为多备选)。
pub type NP =
    | NPWild
    | NPCtor(PC, List<NP>)

fun pc_eq(x: PC, y: PC): bool {
    x == y
}

fun np_list_has(list: List<PC>, c: PC): bool {
    var i: usize = 0
    while i < list.len() {
        if pc_eq(list.get(i) ?? PCNull, c) {
            return true
        }
        i = i + 1
    }
    false
}

// 内联 Guard 剥壳。
fun unwrap_guard_pat(ast: AstArena, pat: i64): i64 {
    match ast.pat(pat).node {
        PGuard(pattern, _) => { pattern }
        _ => { pat }
    }
}

// AST 模式 → 规范化备选集(子模式 Or 笛卡尔积;限定拼写取尾段)。
fun normalize_pattern(ast: AstArena, pat: i64): List<NP> {
    val out = List.empty<NP>()
    match ast.pat(pat).node {
        PWild => { out.push(NPWild) }
        PVar(name) => {
            if is_upper_name(name) {
                out.push(NPCtor(PCAdt(name), List.empty<NP>()))
            } else {
                out.push(NPWild)
            }
        },
        PCtor(name, patterns) => {
            val bare = tail_seg(name)
            val ctor = PCAdt(bare)
            // 子模式备选笛卡尔积。
            var alternatives = List.empty<List<NP>>()
            alternatives.push(List.empty<NP>())
            var i: usize = 0
            while i < patterns.len() {
                val sub_alts = normalize_pattern(ast, patterns[i])
                var next = List.empty<List<NP>>()
                var k: usize = 0
                while k < alternatives.len() {
                    var j: usize = 0
                    while j < sub_alts.len() {
                        val combined = List.empty<NP>()
                        val existing = alternatives.get(k) ?? List.empty<NP>()
                        var m: usize = 0
                        while m < existing.len() {
                            combined.push(existing.get(m) ?? NPWild)
                            m = m + 1
                        }
                        combined.push(sub_alts.get(j) ?? NPWild)
                        next.push(combined)
                        j = j + 1
                    }
                    k = k + 1
                }
                alternatives = next
                i = i + 1
            }
            var k: usize = 0
            while k < alternatives.len() {
                out.push(NPCtor(ctor, alternatives.get(k) ?? List.empty<NP>()))
                k = k + 1
            }
        },
        PLit(lit) => {
            match lit {
                PLBool(b) => { out.push(NPCtor(PCBool(b), List.empty<NP>())) }
                PLInt(v) => { out.push(NPCtor(PCInt(v), List.empty<NP>())) }
                PLFloat(v) => { out.push(NPCtor(PCFloat(v), List.empty<NP>())) }
                PLChar(c) => { out.push(NPCtor(PCChar(c), List.empty<NP>())) }
                PLStr(v) => { out.push(NPCtor(PCStr(v), List.empty<NP>())) }
                PLNull => { out.push(NPCtor(PCNull, List.empty<NP>())) }
            }
        },
        PRecord(_) => { out.push(NPWild) }
        POr(left, right) => {
            val ls = normalize_pattern(ast, left)
            val rs = normalize_pattern(ast, right)
            var i: usize = 0
            while i < ls.len() {
                out.push(ls.get(i) ?? NPWild)
                i = i + 1
            }
            i = 0
            while i < rs.len() {
                out.push(rs.get(i) ?? NPWild)
                i = i + 1
            }
        },
        PGuard(pattern, _) => {
            val subs = normalize_pattern(ast, pattern)
            var i: usize = 0
            while i < subs.len() {
                out.push(subs.get(i) ?? NPWild)
                i = i + 1
            }
        },
    }
    out
}

// 构造器元数 + 字段类型(Throw 内建 Ok/Error;泛型参数按 scrutinee
// 实参替换)。
pub type AF = AF(pub arity: i64, pub fields: u32[])

fun ctor_field_type_sub(ctx: ICtx, a: TypeArena, s: SemaRes, r0: TR, params: str[], args: u32[]): u32 {
    // 参数即席重绑:match 会窄化 var,尾部调用须用未窄化句柄。
    val r = r0
    match r {
        TRNamed(name) => {
            var i: usize = 0
            while i < params.len() {
                if params[i] == name {
                    if i < args.len() {
                        return args[i]
                    }
                }
                i = i + 1
            }
            type_repr_to_handle_ctx(ctx, a, s, r0)
        },
        _ => { type_repr_to_handle_ctx(ctx, a, s, r) }
    }
}

fun ctor_arity_and_fields(ctx: ICtx, a: TypeArena, s: SemaRes, col_type: u32, ctor: PC): AF {
    match ctor {
        PCAdt(name) => {
            val resolved = resolve(a, col_type)
            match Arena.get(a, resolved) {
                TThrow(_) => {
                    val p = thr_parts(a, resolved)
                    val field_ty = if name == "Ok" { p.a } else { p.b }
                    AF(1, [field_ty])
                },
                TAdt(_) => {
                    val parts = adt_parts(a, resolved)
                    match get_type_def(s, parts.a) {
                        null => { AF(0, []) }
                        td => {
                            val target = td ?? TDef("", TAlias, [], [], null, null, [], [])
                            var ci: usize = 0
                            while ci < target.constructors.len() {
                                val c = target.constructors[ci]
                                if c.name == name {
                                    var fields: u32[] = []
                                    var fi: usize = 0
                                    while fi < c.field_type_reprs.len() {
                                        fields = fields ++ [ctor_field_type_sub(ctx, a, s, c.field_type_reprs[fi], target.type_params, parts.b)]
                                        fi = fi + 1
                                    }
                                    return AF(fields.len() as i64, fields)
                                }
                                ci = ci + 1
                            }
                            AF(0, [])
                        },
                    }
                },
                _ => {
                    match get_ctor_def(s, name) {
                        null => { AF(0, []) }
                        c => {
                            var cfields: u32[] = []
                            var cfi: usize = 0
                            while cfi < c.field_type_reprs.len() {
                                cfields = cfields ++ [ctor_field_type_sub(ctx, a, s, c.field_type_reprs[cfi], [], [])]
                                cfi = cfi + 1
                            }
                            AF(cfields.len() as i64, cfields)
                        }
                    }
                },
            }
        },
        _ => { AF(0, []) },
    }
}

// 有限构造器全集(Adt/Bool);无穷类型 null。
fun type_all_ctors(ctx: ICtx, a: TypeArena, s: SemaRes, col_type: u32): List<PC>? {
    val resolved = resolve(a, col_type)
    match Arena.get(a, resolved) {
        TAdt(_) => {
            val name = adt_parts(a, resolved).a
            match get_type_def(s, name) {
                null => { null }
                td => {
                    val target = td ?? TDef("", TAlias, [], [], null, null, [], [])
                    if target.constructors.len() == 0 {
                        return null
                    }
                    val out = List.empty<PC>()
                    var ci: usize = 0
                    while ci < target.constructors.len() {
                        out.push(PCAdt(target.constructors[ci].name))
                        ci = ci + 1
                    }
                    out
                },
            }
        },
        TBool => {
            val out = List.empty<PC>()
            out.push(PCBool(true))
            out.push(PCBool(false))
            out
        },
        _ => { null },
    }
}

// 特化矩阵:构造器 target × 元数 arity。
pub type MN = MN(pub matrix: List<List<NP>>, pub col_types: u32[])

fun specialize_matrix(matrix: List<List<NP>>, col_types: u32[], target: PC, arity: i64,
    field_types: u32[]): MN {
    val new_matrix = List.empty<List<NP>>()
    var ri: usize = 0
    while ri < matrix.len() {
        val row = matrix.get(ri) ?? List.empty<NP>()
        if row.len() > 0 {
            val head = row.get(0) ?? NPWild
            var hit = false
            match head {
                NPWild => { hit = true }
                NPCtor(c, sub) => {
                    if pc_eq(c, target) {
                        hit = true
                        val new_row = List.empty<NP>()
                        var k: usize = 0
                        while k < sub.len() {
                            new_row.push(sub.get(k) ?? NPWild)
                            k = k + 1
                        }
                        while new_row.len() as i64 > arity {
                            val dropped = new_row.pop()
                        }
                        while new_row.len() as i64 < arity {
                            new_row.push(NPWild)
                        }
                        var j: usize = 1
                        while j < row.len() {
                            new_row.push(row.get(j) ?? NPWild)
                            j = j + 1
                        }
                        new_matrix.push(new_row)
                    }
                },
            }
            match head {
                NPWild => {
                    val new_row = List.empty<NP>()
                    var k: i64 = 0
                    while k < arity {
                        new_row.push(NPWild)
                        k = k + 1
                    }
                    var j: usize = 1
                    while j < row.len() {
                        new_row.push(row.get(j) ?? NPWild)
                        j = j + 1
                    }
                    new_matrix.push(new_row)
                }
                _ => {},
            }
        }
        ri = ri + 1
    }
    var new_col_types: u32[] = []
    var fi: usize = 0
    while fi < field_types.len() {
        new_col_types = new_col_types ++ [field_types[fi]]
        fi = fi + 1
    }
    var ci: usize = 1
    while ci < col_types.len() {
        new_col_types = new_col_types ++ [col_types[ci]]
        ci = ci + 1
    }
    MN(new_matrix, new_col_types)
}

// 默认矩阵:通配行去首列。
fun default_matrix(matrix: List<List<NP>>, col_types: u32[]): MN {
    val new_matrix = List.empty<List<NP>>()
    var ri: usize = 0
    while ri < matrix.len() {
        val row = matrix.get(ri) ?? List.empty<NP>()
        if row.len() == 0 {
            new_matrix.push(List.empty<NP>())
        } else {
            match row.get(0) ?? NPWild {
                NPWild => {
                    val new_row = List.empty<NP>()
                    var j: usize = 1
                    while j < row.len() {
                        new_row.push(row.get(j) ?? NPWild)
                        j = j + 1
                    }
                    new_matrix.push(new_row)
                }
                _ => {},
            }
        }
        ri = ri + 1
    }
    var new_col_types: u32[] = []
    var ci: usize = 1
    while ci < col_types.len() {
        new_col_types = new_col_types ++ [col_types[ci]]
        ci = ci + 1
    }
    MN(new_matrix, new_col_types)
}

// 有用性核心:query 对 matrix 是否有用(深度保险丝 48)。
fun is_useful(ctx: ICtx, a: TypeArena, s: SemaRes, matrix: List<List<NP>>, col_types: u32[],
    query: List<NP>, depth: i64): bool {
    if query.len() == 0 {
        return matrix.len() == 0
    }
    if col_types.len() == 0 {
        return false
    }
    if depth > 48 {
        return false
    }
    val col_type = col_types[0]
    match query.get(0) ?? NPWild {
        NPWild => {
            // 首列出现过的构造器集。
            val seen = List.empty<PC>()
            var ri: usize = 0
            while ri < matrix.len() {
                val row = matrix.get(ri) ?? List.empty<NP>()
                if row.len() > 0 {
                    match row.get(0) ?? NPWild {
                        NPWild => {}
                        NPCtor(c, _) => {
                            if !np_list_has(seen, c) {
                                seen.push(c)
                            }
                        },
                    }
                }
                ri = ri + 1
            }
            if seen.len() == 0 {
                val dm = default_matrix(matrix, col_types)
                val rest = List.empty<NP>()
                var qi: usize = 1
                while qi < query.len() {
                    rest.push(query.get(qi) ?? NPWild)
                    qi = qi + 1
                }
                return is_useful(ctx, a, s, dm.matrix, dm.col_types, rest, depth + 1)
            }
            var si: usize = 0
            var useful = false
            while si < seen.len() && !useful {
                val ctor = seen.get(si) ?? PCNull
                val af = ctor_arity_and_fields(ctx, a, s, col_type, ctor)
                val sm = specialize_matrix(matrix, col_types, ctor, af.arity, af.fields)
                val sq = List.empty<NP>()
                var k: i64 = 0
                while k < af.arity {
                    sq.push(NPWild)
                    k = k + 1
                }
                var qi: usize = 1
                while qi < query.len() {
                    sq.push(query.get(qi) ?? NPWild)
                    qi = qi + 1
                }
                if is_useful(ctx, a, s, sm.matrix, sm.col_types, sq, depth + 1) {
                    useful = true
                }
                si = si + 1
            }
            if useful {
                return true
            }
            // 全构造器签名完整 → 通配无用。
            var is_complete = false
            match type_all_ctors(ctx, a, s, col_type) {
                null => {}
                all => {
                    var complete = true
                    var ai: usize = 0
                    while ai < all.len() && complete {
                        if !np_list_has(seen, all.get(ai) ?? PCNull) {
                            complete = false
                        }
                        ai = ai + 1
                    }
                    is_complete = complete
                },
            }
            if is_complete {
                return false
            }
            val dm = default_matrix(matrix, col_types)
            val rest = List.empty<NP>()
            var qi: usize = 1
            while qi < query.len() {
                rest.push(query.get(qi) ?? NPWild)
                qi = qi + 1
            }
            is_useful(ctx, a, s, dm.matrix, dm.col_types, rest, depth + 1)
        },
        NPCtor(target, sub) => {
            val af = ctor_arity_and_fields(ctx, a, s, col_type, target)
            val sm = specialize_matrix(matrix, col_types, target, af.arity, af.fields)
            val sq = List.empty<NP>()
            var k: usize = 0
            while k < sub.len() {
                sq.push(sub.get(k) ?? NPWild)
                k = k + 1
            }
            while sq.len() as i64 > af.arity {
                val dropped = sq.pop()
            }
            while sq.len() as i64 < af.arity {
                sq.push(NPWild)
            }
            var qi: usize = 1
            while qi < query.len() {
                sq.push(query.get(qi) ?? NPWild)
                qi = qi + 1
            }
            is_useful(ctx, a, s, sm.matrix, sm.col_types, sq, depth + 1)
        },
    }
}

// 非穷尽见证(缺哪些构造器/子模式)。
fun witness_str(ctx: ICtx, a: TypeArena, s: SemaRes, matrix: List<List<NP>>, col_types: u32[],
    depth: i64): str {
    if col_types.len() == 0 || depth > 8 {
        return ""
    }
    val col_type = col_types[0]
    val resolved = resolve(a, col_type)
    val ty = Arena.get(a, resolved)
    val seen = List.empty<PC>()
    var has_wild = false
    var ri: usize = 0
    while ri < matrix.len() {
        val row = matrix.get(ri) ?? List.empty<NP>()
        if row.len() > 0 {
            match row.get(0) ?? NPWild {
                NPWild => { has_wild = true }
                NPCtor(c, _) => { seen.push(c) }
            }
        }
        ri = ri + 1
    }
    match ty {
        TAdt(_) => {
            val type_name = adt_parts(a, resolved).a
            var ctor_names: str[] = []
            match get_type_def(s, type_name) {
                null => {}
                td => {
                    val target = td ?? TDef("", TAlias, [], [], null, null, [], [])
                    var ci: usize = 0
                    while ci < target.constructors.len() {
                        ctor_names = ctor_names ++ [target.constructors[ci].name]
                        ci = ci + 1
                    }
                },
            }
            var missing: str[] = []
            var mi: usize = 0
            while mi < ctor_names.len() {
                var found = false
                var si: usize = 0
                while si < seen.len() && !found {
                    match seen.get(si) ?? PCNull {
                        PCAdt(n) => {
                            if n == ctor_names[mi] {
                                found = true
                            }
                        },
                        _ => {},
                    }
                    si = si + 1
                }
                if !found {
                    missing = missing ++ [ctor_names[mi]]
                }
                mi = mi + 1
            }
            if missing.len() > 0 {
                return ": missing {Semares.str_join(missing, ", ")}"
            }
            // 全构造器在场:递归子模式。
            var ci: usize = 0
            while ci < ctor_names.len() {
                val pc = PCAdt(ctor_names[ci])
                if np_list_has(seen, pc) {
                    val af = ctor_arity_and_fields(ctx, a, s, col_type, pc)
                    val sm = specialize_matrix(matrix, col_types, pc, af.arity, af.fields)
                    val q = List.empty<NP>()
                    var k: i64 = 0
                    while k < af.arity {
                        q.push(NPWild)
                        k = k + 1
                    }
                    if is_useful(ctx, a, s, sm.matrix, sm.col_types, q, 0) {
                        return ": `{ctor_names[ci]}` not exhaustive{witness_str(ctx, a, s, sm.matrix, sm.col_types, depth + 1)}"
                    }
                }
                ci = ci + 1
            }
            ""
        },
        TBool => {
            var has_true = false
            var has_false = false
            var si: usize = 0
            while si < seen.len() {
                match seen.get(si) ?? PCNull {
                    PCBool(b) => {
                        if b {
                            has_true = true
                        } else {
                            has_false = true
                        }
                    },
                    _ => {},
                }
                si = si + 1
            }
            if !has_true {
                ": missing `true`"
            } else {
                if !has_false {
                    ": missing `false`"
                } else {
                    ""
                }
            }
        },
        _ => {
            if !has_wild {
                ": missing catch-all `_`"
            } else {
                ""
            }
        },
    }
}

// 穷尽性 + 不可达臂检查。
fun check_match_exhaustive(ctx: ICtx, a: TypeArena, s: SemaRes, ast: AstArena,
    scrutinee: i64, scrutinee_ty: u32, arms: Marm[]): void {
    val col_types = [scrutinee_ty]
    // guard 臂(臂级 guard 或内联 Guard)不保证覆盖。
    var ai: usize = 0
    val exhaust_matrix = List.empty<List<NP>>()
    while ai < arms.len() {
        val arm = arms[ai]
        var guarded = arm.guard != null
        match ast.pat(arm.pattern).node {
            PGuard(_, _) => { guarded = true }
            _ => {},
        }
        if !guarded {
            val alts = normalize_pattern(ast, unwrap_guard_pat(ast, arm.pattern))
            var k: usize = 0
            while k < alts.len() {
                val row = List.empty<NP>()
                row.push(alts.get(k) ?? NPWild)
                exhaust_matrix.push(row)
                k = k + 1
            }
        }
        ai = ai + 1
    }
    // 有限类型(Adt/Bool)才报非穷尽。
    var is_finite = false
    match Arena.get(a, resolve(a, scrutinee_ty)) {
        TAdt(_) => { is_finite = true }
        TBool => { is_finite = true }
        _ => {},
    }
    if is_finite {
        val q = List.empty<NP>()
        q.push(NPWild)
        if is_useful(ctx, a, s, exhaust_matrix, col_types, q, 0) {
            val sp = ast.expr(scrutinee).span
            add_error_at(s, "non-exhaustive match{witness_str(ctx, a, s, exhaust_matrix, col_types, 0)}",
                sp.line, sp.column)
        }
    }
    // 不可达臂:相对此前无 guard 臂矩阵无用 → 警告。
    val prev_matrix = List.empty<List<NP>>()
    ai = 0
    while ai < arms.len() {
        val arm = arms[ai]
        val alts = normalize_pattern(ast, unwrap_guard_pat(ast, arm.pattern))
        var any_useful = false
        var k: usize = 0
        while k < alts.len() && !any_useful {
            val q = List.empty<NP>()
            q.push(alts.get(k) ?? NPWild)
            if is_useful(ctx, a, s, prev_matrix, col_types, q, 0) {
                any_useful = true
            }
            k = k + 1
        }
        if !any_useful && alts.len() > 0 {
            val sp = ast.pat(arm.pattern).span
            add_warning_at(s, "unreachable match arm", sp.line, sp.column)
        }
        var guarded = arm.guard != null
        match ast.pat(arm.pattern).node {
            PGuard(_, _) => { guarded = true }
            _ => {},
        }
        if !guarded {
            var k2: usize = 0
            while k2 < alts.len() {
                val row = List.empty<NP>()
                row.push(alts.get(k2) ?? NPWild)
                prev_matrix.push(row)
                k2 = k2 + 1
            }
        }
        ai = ai + 1
    }
}

// match 表达式推断(scrutinee → Throw 扩宽 → 臂模式/guard/体 → peer
// join → 期望约束 → 穷尽性)。
fun infer_match_expr(ctx: ICtx, a: TypeArena, s: SemaRes, expr: i64, ast: AstArena,
    env: u32, expected: u32?): u32 {
    match ast.expr(expr).node {
        MatchE(scrutinee, arms) => {
            val scrutinee_ty = infer_expr(ctx, a, s, scrutinee, ast, env, null)
            var resolved_scrutinee = resolve(a, scrutinee_ty)
            // Throw 扩宽:含 Ok 臂而 scrutinee 非 Throw → Throw<..., scrutinee>。
            var is_throw = false
            match Arena.get(a, resolved_scrutinee) {
                TThrow(_) => { is_throw = true }
                _ => {},
            }
            var has_ok_arm = false
            var ai: usize = 0
            while ai < arms.len() && !has_ok_arm {
                match ast.pat(arms[ai].pattern).node {
                    PCtor(name, _) => {
                        if name == "Ok" {
                            has_ok_arm = true
                        }
                    },
                    PVar(name) => {
                        if name == "Ok" {
                            has_ok_arm = true
                        }
                    },
                    _ => {},
                }
                ai = ai + 1
            }
            if !is_throw && has_ok_arm {
                var implements_err = false
                match Relate.type_name(a, resolved_scrutinee) {
                    null => {}
                    tn => {
                        val canonical = resolve_type_key(s, tn)
                        match type_def_idx(s, canonical) {
                            null => {}
                            idx => {
                                val tid = dynamic_type_id(idx)
                                var wi: usize = 0
                                while wi < s.witness_entries.len() && !implements_err {
                                    val e = s.witness_entries.get(wi) ?? WEnt("", 0, Map.empty<str, i64>(), "")
                                    if e.trait_name == "Err" && e.type_id == tid {
                                        implements_err = true
                                    }
                                    wi = wi + 1
                                }
                            },
                        }
                    },
                }
                var widened: u32 = 0
                if implements_err {
                    val fresh_val = fresh_type_var(a)
                    widened = make_throw(a, fresh_val, resolved_scrutinee)
                } else {
                    val fresh_err = fresh_type_var(a)
                    widened = make_throw(a, resolved_scrutinee, fresh_err)
                }
                unify_or_constrain(ctx, a, scrutinee_ty, widened)
                resolved_scrutinee = resolve(a, widened)
            }
            val scrutinee_path = expr_path(ast, scrutinee)
            val arm_tys = List.empty<u32>()
            // nullable 臂窄化:null 臂后的绑定臂取内型。
            var scrutinee_nullable = false
            match Arena.get(a, resolved_scrutinee) {
                TNullable(_) => { scrutinee_nullable = true }
                _ => {},
            }
            var null_arm_seen = false
            ai = 0
            while ai < arms.len() {
                val arm = arms[ai]
                val child_env = Envs.child(s.env, env)
                var is_null_arm = false
                match ast.pat(arm.pattern).node {
                    PLit(PLNull) => { is_null_arm = true }
                    _ => {},
                }
                val arm_pattern_ty = if scrutinee_nullable && null_arm_seen && !is_null_arm {
                    nullable_inner(a, resolved_scrutinee)
                } else {
                    resolved_scrutinee
                }
                if is_null_arm {
                    null_arm_seen = true
                }
                flow_push_scope(ctx)
                match scrutinee_path {
                    null => {}
                    path => {
                        match extract_constructor_pattern(ast, arm.pattern) {
                            null => {}
                            cv => {
                                val hit = cv ?? PairCV("", List.empty<str>())
                                val narrowed_ty = make_adt(a, hit.name, [])
                                var bvs: str[] = []
                                var bi: usize = 0
                                while bi < hit.bound.len() {
                                    bvs = bvs ++ [hit.bound.get(bi) ?? ""]
                                    bi = bi + 1
                                }
                                flow_add_fact(ctx, FFact(path ?? "", narrowed_ty, NKCtorMatch(hit.name, bvs)))
                            },
                        }
                    },
                }
                infer_pattern(ctx, a, s, arm.pattern, ast, arm_pattern_ty, child_env)
                match arm.guard {
                    null => {}
                    g => {
                        val _gt = infer_expr(ctx, a, s, g, ast, child_env, null)
                    }
                }
                val body_ty = infer_expr(ctx, a, s, arm.body, ast, child_env, expected)
                flow_pop_scope(ctx)
                arm_tys.push(body_ty)
                ai = ai + 1
            }
            var result_ty = make(a, TVoid)
            if arm_tys.len() > 0 {
                var arr: u32[] = []
                var ti: usize = 0
                while ti < arm_tys.len() {
                    arr = arr ++ [arm_tys.get(ti) ?? 0]
                    ti = ti + 1
                }
                result_ty = peer_type(a, arr)
            }
            match expected {
                null => {}
                exp => { unify_or_constrain(ctx, a, result_ty, exp) }
            }
            check_match_exhaustive(ctx, a, s, ast, scrutinee, resolved_scrutinee, arms)
            result_ty
        },
        _ => { fresh_type_var(a) }
    }
}

// ─── Stm tinfer:局部声明 + 语句推断 ─────────────────────────────────

// val/var 局部声明:注解 kind 检查 + 值推断 + 注解统一(unwrap 泄漏
// 守卫 + 字面量 nullable 再推断)+ Bug#76 遮蔽检测 + 绑定。
fun check_local_decl(ctx: ICtx, a: TypeArena, s: SemaRes, name: str, type_annotation: i64?,
    value: i64, is_mutable: bool, ast: AstArena, env: u32, stmt: i64): u32 {
    var expected_ty: u32? = null
    match type_annotation {
        null => {}
        ta => {
            expected_ty = if true { type_from_ast(ctx, a, s, ta, ast) } else { null }
        },
    }
    val val_ty = infer_expr(ctx, a, s, value, ast, env, expected_ty)
    var bind_ty = val_ty
    match type_annotation {
        null => {}
        ta => {
            val annot_ty = expected_ty ?? 0
            match unwrap_leak_kind(a, annot_ty, val_ty) {
                null => {}
                kind => {
                    val annot_str = display_type_annotation(ctx, a, s, ta, ast, annot_ty)
                    val sp = ast.ty(ta).span
                    add_error_at(s,
                        "type annotation mismatch: cannot bind a {kind} value ('{display(a, val_ty)}') to '{annot_str}' — unwrap explicitly ('?? default', '!', '?', or an '!= null' narrowed branch)",
                        sp.line, sp.column)
                },
            }
            var ok = false
            match try_widen_unify(ctx, a, annot_ty, val_ty) {
                TWOk(_) => { ok = true }
                TWErr(_) => { ok = false }
            }
            if !ok {
                // 字面量 → nullable 注解:按内型重推再试。
                if expr_is_literal(ast, value) {
                    val annot_resolved = resolve(a, annot_ty)
                    match Arena.get(a, annot_resolved) {
                        TNullable(_) => {
                            val inner = nullable_inner(a, annot_resolved)
                            val re_ty = infer_expr(ctx, a, s, value, ast, env, inner)
                            match try_widen_unify(ctx, a, inner, re_ty) {
                                TWOk(_) => { ok = true }
                                TWErr(_) => { ok = false }
                            }
                        },
                        _ => {},
                    }
                }
                if !ok {
                    val annot_str = display_type_annotation(ctx, a, s, ta, ast, annot_ty)
                    add_error_at(s,
                        "type annotation mismatch: expected '{annot_str}', found '{display(a, val_ty)}'",
                        ast.ty(ta).span.line, ast.ty(ta).span.column)
                }
            }
            bind_ty = annot_ty
        },
    }
    // Bug#76:可变性变更遮蔽检测。
    val key = "{env}\u{0}{name}"
    match ctx.local_mutability.get(key) {
        null => {}
        prev => {
            if (prev ?? false) != is_mutable {
                val prev_kw = if prev ?? false { "var" } else { "val" }
                val new_kw = if is_mutable { "var" } else { "val" }
                val sp = ast.stmt(stmt).span
                add_error_at(s,
                    "cannot shadow {prev_kw} '{name}' with {new_kw} {name}: mutability mismatch",
                    sp.line, sp.column)
            }
        },
    }
    ctx.local_mutability.set(key, is_mutable)
    if define(s.env, env, name, bind_ty) {
        // 新绑定。
    } else {
        redefine(s.env, env, name, bind_ty)
    }
    val_ty
}

// 语句推断:产值语句返 Some(类型),其余 null。
fun infer_stmt(ctx: ICtx, a: TypeArena, s: SemaRes, stmt: i64, ast: AstArena, env: u32): u32? {
    val st = ast.stmt(stmt)
    match st.node {
        ValDeclS(name, ta, value, _) => {
            val val_ty = check_local_decl(ctx, a, s, name, ta, value, false, ast, env, stmt)
            match Arena.get(a, resolve(a, val_ty)) {
                TNever => { val_ty }
                _ => { null }
            }
        },
        VarDeclS(name, ta, value, _) => {
            val val_ty = check_local_decl(ctx, a, s, name, ta, value, true, ast, env, stmt)
            match Arena.get(a, resolve(a, val_ty)) {
                TNever => { val_ty }
                _ => { null }
            }
        },
        AssignS(target, value) => {
            val target_ty = infer_expr(ctx, a, s, target, ast, env, null)
            val val_ty = infer_expr(ctx, a, s, value, ast, env, target_ty)
            if !unify_ok(a, target_ty, val_ty) {
                add_error_at(s,
                    "assignment type mismatch: cannot assign '{display(a, val_ty)}' to '{display(a, target_ty)}'",
                    st.span.line, st.span.column)
            }
            null
        },
        FieldAssignS(object, _, value) => {
            val _ot = infer_expr(ctx, a, s, object, ast, env, null)
            val _vt = infer_expr(ctx, a, s, value, ast, env, null)
            null
        },
        CompAssignS(target, _, value) => {
            val target_ty = infer_expr(ctx, a, s, target, ast, env, null)
            val value_ty = infer_expr(ctx, a, s, value, ast, env, null)
            val rt = resolve(a, target_ty)
            val rv = resolve(a, value_ty)
            var both_numeric = false
            if ty_is_numeric(Arena.get(a, rt)) && ty_is_numeric(Arena.get(a, rv)) {
                both_numeric = true
            }
            if both_numeric {
                check_numeric_binop_compat(ctx, a, s, ast, target, value, rt, rv, st.span.line, st.span.column)
                val _peer = peer_type_binary(a, rt, rv,
                    expr_is_literal(ast, target), expr_is_literal(ast, value))
            } else {
                if !unify_ok(a, rt, rv) {
                    add_error_at(s,
                        "compound assignment type mismatch: target '{display(a, rt)}' is not compatible with value '{display(a, rv)}'",
                        st.span.line, st.span.column)
                }
            }
            null
        },
        ExprS(expr) => {
            infer_expr(ctx, a, s, expr, ast, env, null)
        },
        ReturnS(value) => {
            match value {
                null => { make(a, TVoid) }
                v => {
                    val expected = ctx.expected_return
                    val val_ty = infer_expr(ctx, a, s, v, ast, env, expected)
                    match ctx.expected_return {
                        null => {}
                        fn_ret => {
                            if !unify_return_type(ctx, a, s, fn_ret ?? 0, val_ty, st.span.line, st.span.column) {
                                add_error_at(s,
                                    "return type mismatch: expected '{display(a, fn_ret ?? 0)}', found '{display(a, val_ty)}'",
                                    st.span.line, st.span.column)
                            }
                            // 同步 Throw 返回须返 Throw 值(payload 泄漏类)。
                            match Arena.get(a, resolve(a, fn_ret ?? 0)) {
                                TThrow(_) => {
                                    match Arena.get(a, resolve(a, val_ty)) {
                                        TThrow(_) => {}
                                        TTypeVar(_) => {}
                                        TUnknown => {}
                                        TNever => {}
                                        _ => {
                                            add_error_at(s,
                                                "'return' value must be Throw-wrapped: expected '{display(a, fn_ret ?? 0)}', found '{display(a, val_ty)}' (wrap in Ok(..)/Err(..) or return the Throw value directly; 'expr?' unwraps)",
                                                st.span.line, st.span.column)
                                        },
                                    }
                                },
                                _ => {},
                            }
                        },
                    }
                    val_ty
                },
            }
        },
        DeferS(body) => {
            val _bt = infer_expr(ctx, a, s, body, ast, env, null)
            null
        },
        ThrowS(x) => {
            val thrown_ty = infer_expr(ctx, a, s, x, ast, env, null)
            check_throw_stmt(ctx, a, s, thrown_ty, st.span.line, st.span.column)
            null
        },
        BreakS => { null }
        ContinueS => { null }
        ForS(name, iterable, body) => {
            val iterable_ty = infer_expr(ctx, a, s, iterable, ast, env, null)
            val child_env = Envs.child(s.env, env)
            val resolved = resolve(a, iterable_ty)
            val ct = Arena.get(a, resolved)
            // 非迭代器类型(数组/str/标量)→ 报错。
            var is_non_iterator = false
            match ct {
                TArray(_) => { is_non_iterator = true }
                TStr => { is_non_iterator = true }
                _ => {
                    if ty_is_numeric(ct) {
                        is_non_iterator = true
                    }
                },
            }
            if is_non_iterator {
                var type_name2 = ty_source_name(ct)
                match ct {
                    TArray(_) => {
                        match type_name_concrete(a, resolved) {
                            null => {}
                            n => { type_name2 = n }
                        }
                    },
                    _ => {},
                }
                add_error_at(s,
                    "type '{type_name2}' does not implement Iterator; For loops require an iterator type. Use arr.iter() for arrays, str_iter(s) for strings",
                    st.span.line, st.span.column)
            }
            // 元素 nullable 拒绝(null 终止协议)。
            match extract_iterator_element(a, resolved) {
                null => {}
                elem => {
                    match Arena.get(a, resolve(a, elem ?? 0)) {
                        TNullable(_) => {
                            add_error_at(s,
                                "cannot use for-in over an iterator whose element type is nullable: the null-terminated iterator protocol treats a null element as end-of-iteration. Iterate by index instead: `var i: usize = 0; while i < arr.len() \{ val e = arr[i] ... \}`",
                                st.span.line, st.span.column)
                        },
                        _ => {},
                    }
                },
            }
            var item_ty = extract_iterator_element(a, resolved)
            if item_ty == null {
                val fv = fresh_type_var(a)
                val expected_iter = make_generic(a, "ArrayIter", [fv])
                unify_or_constrain(ctx, a, iterable_ty, expected_iter)
                item_ty = if true { fv } else { null }
            }
            define(s.env, child_env, name, item_ty ?? 0)
            val _bt = infer_expr(ctx, a, s, body, ast, child_env, null)
            null
        },
        WhileS(condition, body) => {
            val cond_ty = infer_expr(ctx, a, s, condition, ast, env, null)
            val bool_ty = make(a, TBool)
            if !unify_ok(a, cond_ty, bool_ty) {
                add_error_at(s,
                    "while condition must be bool, found '{display(a, cond_ty)}'",
                    st.span.line, st.span.column)
            }
            val _bt = infer_expr(ctx, a, s, body, ast, env, null)
            null
        },
        LoopS(body) => {
            val _bt = infer_expr(ctx, a, s, body, ast, env, null)
            null
        },
        LocalDeclS(d) => {
            check_decl(ctx, a, s, d, st.span, ast, env)
            null
        },
    }
}

// ─── Exprinfer:表达式推断 ─────────────────────────────────────────

// 顶层入口:推断 + 存表(每次调用恰好存一次)。
fun infer_expr(ctx: ICtx, a: TypeArena, s: SemaRes, expr: i64, ast: AstArena,
    env: u32, expected: u32?): u32 {
    val ty = infer_expr_inner(ctx, a, s, expr, ast, env, expected)
    store_expr_info(ctx, a, s, expr, ty)
    ty
}

// 整数字面量范围检查(简化:i64 域解析;溢出按目标位宽裁决)。
fun check_int_literal_range(raw: str, suffix: str): str? {
    val b = raw.bytes()
    // 去 '_'。
    var digits_b: u8[] = []
    var i: usize = 0
    while i < b.len() {
        if b[i] != 95 {
            digits_b = digits_b ++ [b[i]]
        }
        i = i + 1
    }
    var radix: i64 = 10
    if digits_b.len() > 2 && digits_b[0] == 48 {
        if digits_b[1] == 120 || digits_b[1] == 88 {
            radix = 16
            digits_b = arr_drop(digits_b, 2)
        } else {
            if digits_b[1] == 111 || digits_b[1] == 79 {
                radix = 8
                digits_b = arr_drop(digits_b, 2)
            } else {
                if digits_b[1] == 98 || digits_b[1] == 66 {
                    radix = 2
                    digits_b = arr_drop(digits_b, 2)
                }
            }
        }
    }
    var neg = false
    if digits_b.len() > 0 && digits_b[0] == 45 {
        neg = true
        digits_b = arr_drop(digits_b, 1)
    }
    var value: i64 = 0
    var overflow = false
    i = 0
    while i < digits_b.len() {
        val c = digits_b[i]
        var d: i64 = -1
        if c >= 48 && c <= 57 {
            d = c as i64 - 48
        } else {
            if c >= 97 && c <= 102 {
                d = c as i64 - 87
            } else {
                if c >= 65 && c <= 70 {
                    d = c as i64 - 55
                }
            }
        }
        if d < 0 || d >= radix {
            return "invalid integer literal '{raw}'"
        }
        if value > (9223372036854775807 as i64 - d) / radix {
            overflow = true
        }
        if !overflow {
            value = value * radix + d
        }
        i = i + 1
    }
    if overflow {
        if suffix == "i128" || suffix == "u128" {
            return null
        }
        return "integer literal '{raw}' is out of range for {suffix}"
    }
    if neg {
        value = -value
    }
    var limits_ok = match suffix {
        "i8" => { value >= -128 && value <= 127 }
        "i16" => { value >= -32768 && value <= 32767 }
        "i32" => { value >= -2147483648 && value <= 2147483647 }
        "i64" => { true }
        "u8" => { value >= 0 && value <= 255 }
        "u16" => { value >= 0 && value <= 65535 }
        "u32" => { value >= 0 && value <= 4294967295 }
        "u64" => { value >= 0 }
        "isize" => { true }
        "usize" => { value >= 0 }
        _ => { true }
    }
    if !limits_ok {
        return "integer literal '{raw}' is out of range for {suffix}"
    }
    null
}

// 前 n 字节截除。
fun arr_drop(b: u8[], n: usize): u8[] {
    var out: u8[] = []
    var i: usize = n
    while i < b.len() {
        out = out ++ [b[i]]
        i = i + 1
    }
    out
}

// 数值后缀名单匹配(i8..f128/bool/char)。
fun is_numeric_ctor_name(name: str): bool {
    arr_has_str(numeric_builtin_names(), name)
}

fun infer_expr_inner(ctx: ICtx, a: TypeArena, s: SemaRes, expr: i64, ast: AstArena,
    env: u32, expected: u32?): u32 {
    val e = ast.expr(expr)
    match e.node {
        // ── 字面量 ──
        IntLit(raw, suffix) => {
            match suffix {
                null => {}
                suf => {
                    if is_numeric_ctor_name(suf ?? "") {
                        val err = check_int_literal_range(raw, suf ?? "")
                        match err {
                            null => {}
                            m => { add_error(s, m ?? "") }
                        }
                    }
                },
            }
            match suffix {
                null => {}
                suf => {
                    match int_suffix_to_type(a, suf ?? "") {
                        null => {}
                        ty => { return ty ?? 0 }
                    }
                },
            }
            match expected {
                null => {}
                exp => {
                    match Arena.get(a, resolve(a, exp ?? 0)) {
                        TBool => {}
                        TChar => {}
                        TStr => {}
                        TNull => {}
                        TVoid => {}
                        t => {
                            if ty_is_int(t) {
                                return exp ?? 0
                            }
                        },
                    }
                },
            }
            make(a, TI32)
        },
        FloatLit(_, suffix) => {
            match suffix {
                null => {}
                suf => {
                    match float_suffix_to_type(a, suf ?? "") {
                        null => {}
                        ty => { return ty ?? 0 }
                    }
                },
            }
            match expected {
                null => {}
                exp => {
                    match Arena.get(a, resolve(a, exp ?? 0)) {
                        t => {
                            if ty_is_float(t) {
                                return exp ?? 0
                            }
                        },
                    }
                },
            }
            make(a, TF64)
        },
        BoolLit(_) => { make(a, TBool) }
        CharLit(_) => { make(a, TChar) }
        StrLit(_) => { make(a, TStr) }
        StrInterp(parts) => {
            var i: usize = 0
            while i < parts.len() {
                match parts[i] {
                    IpExpr(x) => {
                        val _t = infer_expr(ctx, a, s, x, ast, env, null)
                    },
                    IpLit(_) => {},
                }
                i = i + 1
            }
            make(a, TStr)
        },
        NullLit => {
            val tv = fresh_type_var(a)
            val ty = make_nullable(a, tv)
            match expected {
                null => {}
                exp => {
                    match try_widen_unify(ctx, a, exp ?? 0, ty) {
                        TWOk(_) => {}
                        TWErr(msg) => {
                            add_error(s, "null literal incompatible with expected type: {msg}")
                        }
                    }
                },
            }
            ty
        },
        VoidLit => { make(a, TVoid) },
        // ── 标识符 ──
        Ident(name) => {
            match expected {
                null => {}
                exp => {
                    match infer_nullary_ctor_with_expected(ctx, a, s, expr, name, exp ?? 0) {
                        null => {}
                        ty => { return ty ?? 0 }
                    }
                },
            }
            infer_ident_expr(ctx, a, s, expr, ast, env)
        },
        // ── 赋值 ──
        AssignE(target, value) => {
            val target_ty = infer_expr(ctx, a, s, target, ast, env, null)
            val val_ty = infer_expr(ctx, a, s, value, ast, env, target_ty)
            unify_or_constrain(ctx, a, target_ty, val_ty)
            make(a, TVoid)
        },
        CompAssignE(_, target, value) => {
            val target_ty = infer_expr(ctx, a, s, target, ast, env, null)
            val val_ty = infer_expr(ctx, a, s, value, ast, env, target_ty)
            unify_or_constrain(ctx, a, target_ty, val_ty)
            target_ty
        },
        // ── 二元/一元 ──
        BinaryE(_, _, _) => { infer_binary_expr(ctx, a, s, expr, ast, env) },
        UnaryE(op, operand) => {
            val opnd_ty = infer_expr(ctx, a, s, operand, ast, env, null)
            match op {
                Not => {
                    // `!` 是逻辑非:仅 bool(软类型宽容)。
                    val r = resolve(a, opnd_ty)
                    var non_bool = true
                    match Arena.get(a, r) {
                        TBool => { non_bool = false }
                        TTypeVar(_) => { non_bool = false }
                        TUnknown => { non_bool = false }
                        _ => {},
                    }
                    if non_bool {
                        val sp = ast.expr(operand).span
                        var ty_desc = "value"
                        match type_name_concrete(a, r) {
                            null => {}
                            n => { ty_desc = n }
                        }
                        add_error_at(s,
                            "'!' is logical not and requires a bool operand (found '{ty_desc}'); use '~' for bitwise not",
                            sp.line, sp.column)
                    }
                    return make(a, TBool)
                },
                _ => { opnd_ty }
            }
        },
        // ── as 转换 ──
        AsCast(src, target) => {
            val target_ty = type_from_ast(ctx, a, s, target, ast)
            val _st = infer_expr(ctx, a, s, src, ast, env, null)
            var lit_numeric = false
            match ast.expr(src).node {
                IntLit(_, _) => { lit_numeric = true }
                FloatLit(_, _) => { lit_numeric = true }
                _ => {},
            }
            if lit_numeric {
                val resolved = resolve(a, target_ty)
                var cmp = resolved
                match Arena.get(a, resolved) {
                    TNullable(_) => { cmp = nullable_inner(a, resolved) }
                    _ => {},
                }
                if ty_is_numeric(Arena.get(a, cmp)) {
                    val _rt = infer_expr(ctx, a, s, src, ast, env, cmp)
                }
            }
            target_ty
        },
        // ── 引用/解引用 ──
        RefOfE(operand) => {
            val node = ast.expr(operand).node
            val sp = e.span
            var is_place = false
            match node {
                Ident(_) => { is_place = true }
                IndexE(_, _) => { is_place = true }
                FieldAccessE(_, _) => { is_place = true }
                _ => {},
            }
            if !is_place {
                add_error_at(s,
                    "cannot take a reference to this expression: only variables, arr[i], and rec.field are addressable",
                    sp.line, sp.column)
            }
            match node {
                FieldAccessE(recv, field) => {
                    match ast.expr(recv).node {
                        Ident(type_name) => {
                            match check_qualified_ctor(ctx, s, type_name, field) {
                                null => {}
                                _ => {
                                    add_error_at(s,
                                        "'{type_name}.{field}' is a constructor call, not a variable; constructors are not addressable",
                                        sp.line, sp.column)
                                },
                            }
                        },
                        _ => {},
                    }
                },
                IndexE(recv, _) => {
                    val recv_ty = infer_expr(ctx, a, s, recv, ast, env, null)
                    match Arena.get(a, resolve(a, recv_ty)) {
                        TStr => {
                            add_error_at(s,
                                "cannot take a reference to a str element: str is immutable",
                                sp.line, sp.column)
                        },
                        _ => {},
                    }
                },
                _ => {},
            }
            val inner_ty = infer_expr(ctx, a, s, operand, ast, env, null)
            make_ref(a, inner_ty, false)
        },
        DerefE(operand) => {
            val operand_ty = infer_expr(ctx, a, s, operand, ast, env, null)
            val resolved = resolve(a, operand_ty)
            match Arena.get(a, resolved) {
                TRef(_) => { ref_parts(a, resolved).a }
                _ => { operand_ty }
            }
        },
        // ── 调用 ──
        CallE(_, _, _) => { infer_call_expr(ctx, a, s, expr, ast, env, expected) },
        MethodCallE(_, _, _, _) => { infer_method_call_expr(ctx, a, s, expr, ast, env, expected) }
        SafeMethodCallE(_, _, _, _) => { infer_method_call_expr(ctx, a, s, expr, ast, env, expected) },
        // ── 字段访问 ──
        FieldAccessE(recv, field) => {
            // 限定零参构造器 Type.Ctor。
            match ast.expr(recv).node {
                Ident(type_name) => {
                    match check_qualified_ctor(ctx, s, type_name, field) {
                        null => {}
                        qc => {
                            val hit = qc ?? QC("", [])
                            if hit.field_reprs.len() == 0 {
                                return make_adt(a, hit.type_name, [])
                            }
                            add_error_at(s,
                                "constructor '{field}' of type '{type_name}' requires arguments; use {field}('{type_name}') syntax",
                                e.span.line, e.span.column)
                            return fresh_type_var(a)
                        },
                    }
                },
                _ => {},
            }
            // 流窄化优先(点分路径)。
            match expr_path(ast, expr) {
                null => {}
                path => {
                    match flow_lookup_narrowed(ctx, path ?? "") {
                        null => {}
                        narrowed => { return narrowed ?? 0 }
                    }
                },
            }
            val recv_ty = infer_expr(ctx, a, s, recv, ast, env, null)
            lookup_field_type(ctx, a, s, recv_ty, field, e.span.line, e.span.column)
        },
        SafeAccessE(recv, field) => {
            val recv_ty = infer_expr(ctx, a, s, recv, ast, env, null)
            val resolved = resolve(a, recv_ty)
            var is_nullable = false
            match Arena.get(a, resolved) {
                TNullable(_) => { is_nullable = true }
                _ => {},
            }
            val inner = unwrap_ref(a, recv_ty)
            val field_ty = lookup_field_type(ctx, a, s, inner, field, e.span.line, e.span.column)
            if is_nullable {
                make_nullable(a, field_ty)
            } else {
                field_ty
            }
        },
        // ── 索引/切片 ──
        IndexE(recv, index) => {
            val recv_ty = infer_expr(ctx, a, s, recv, ast, env, null)
            val _it = infer_expr(ctx, a, s, index, ast, env, null)
            val resolved = resolve(a, recv_ty)
            match Arena.get(a, resolved) {
                TArray(_) => { array_parts(a, resolved).a }
                TStr => { make(a, TChar) }
                _ => { fresh_type_var(a) }
            }
        },
        SliceE(recv, start, end, _) => {
            val recv_ty = infer_expr(ctx, a, s, recv, ast, env, null)
            val _s1 = infer_expr(ctx, a, s, start, ast, env, null)
            val _s2 = infer_expr(ctx, a, s, end, ast, env, null)
            recv_ty
        },
        // ── 传播/断言/合并 ──
        PropagateE(operand) => {
            val inner_ty = infer_expr(ctx, a, s, operand, ast, env, null)
            val resolved = resolve(a, inner_ty)
            match expected {
                null => {}
                exp => {
                    match Arena.get(a, resolved) {
                        TThrow(_) => {
                            val p = thr_parts(a, resolved)
                            unify_or_constrain(ctx, a, p.a, exp ?? 0)
                        },
                        _ => {},
                    }
                },
            }
            check_propagate(ctx, a, s, resolved, inner_ty, ctx.expected_return, e.span.line, e.span.column)
        },
        NonNullAssertE(operand) => {
            val operand_ty = infer_expr(ctx, a, s, operand, ast, env, null)
            val resolved = resolve(a, operand_ty)
            match Arena.get(a, resolved) {
                TNullable(_) => { nullable_inner(a, resolved) }
                _ => { operand_ty }
            }
        },
        ElvisE(lhs, rhs) => {
            val left_ty = infer_expr(ctx, a, s, lhs, ast, env, null)
            val right_ty = infer_expr(ctx, a, s, rhs, ast, env, null)
            val rl = resolve(a, left_ty)
            match Arena.get(a, rl) {
                TNullable(_) => {
                    val inner = nullable_inner(a, rl)
                    match try_widen_unify(ctx, a, inner, right_ty) {
                        TWOk(_) => {}
                        TWErr(msg) => {
                            add_error(s, "?? default value incompatible with Nullable inner type: {msg}")
                        }
                    }
                    inner
                },
                TThrow(_) => {
                    val p = thr_parts(a, rl)
                    match try_widen_unify(ctx, a, p.a, right_ty) {
                        TWOk(_) => {}
                        TWErr(msg) => {
                            add_error(s, "?? default value incompatible with Throw value type: {msg}")
                        }
                    }
                    p.a
                },
                TTypeVar(_) => { left_ty }
                TUnknown => { left_ty }
                _ => { left_ty }
            }
        },
        // ── 数组字面量 ──
        ArrayLitE(elements, fill_v, fill_c, has_fill) => {
            var expected_elem: u32? = null
            match expected {
                null => {}
                exp => {
                    val r = resolve(a, exp ?? 0)
                    match Arena.get(a, r) {
                        TArray(_) => { expected_elem = if true { array_parts(a, r).a } else { null } }
                        _ => {},
                    }
                },
            }
            if has_fill {
                val value_ty = infer_expr(ctx, a, s, fill_v, ast, env, expected_elem)
                val _ct = infer_expr(ctx, a, s, fill_c, ast, env, null)
                return make_array(a, value_ty, null)
            }
            if elements.len() == 0 {
                var elem_ty = fresh_type_var(a)
                match expected_elem {
                    null => {}
                    ee => { elem_ty = ee ?? 0 }
                }
                return make_array(a, elem_ty, null)
            }
            val first_ty = infer_expr(ctx, a, s, elements[0], ast, env, expected_elem)
            var elem_tys = [first_ty]
            var i: usize = 1
            while i < elements.len() {
                val elem_ty = infer_expr(ctx, a, s, elements[i], ast, env, expected_elem)
                match try_widen_unify(ctx, a, first_ty, elem_ty) {
                    TWOk(_) => {}
                    TWErr(msg) => {
                        val sp = ast.expr(elements[i]).span
                        add_error_at(s, "array element type mismatch: {msg}", sp.line, sp.column)
                    }
                }
                elem_tys = elem_tys ++ [elem_ty]
                i = i + 1
            }
            // 元素级 null 提升(T?[] 字面量)。
            var has_null_elem = false
            var base_ty: u32? = null
            i = 0
            while i < elem_tys.len() {
                val r = resolve(a, elem_tys[i])
                match Arena.get(a, r) {
                    TNull => { has_null_elem = true }
                    TNullable(_) => {
                        has_null_elem = true
                        if base_ty == null {
                            base_ty = if true { nullable_inner(a, r) } else { null }
                        }
                    },
                    _ => {
                        if base_ty == null {
                            base_ty = if true { elem_tys[i] } else { null }
                        }
                    },
                }
                i = i + 1
            }
            var final_elem = first_ty
            if has_null_elem {
                match base_ty {
                    null => {
                        val fv = fresh_type_var(a)
                        match expected_elem {
                            null => { final_elem = make_nullable(a, fv) }
                            exp2 => {
                                val r = resolve(a, exp2 ?? 0)
                                match Arena.get(a, r) {
                                    TNullable(_) => { final_elem = exp2 ?? 0 }
                                    _ => { final_elem = make_nullable(a, fv) }
                                }
                            },
                        }
                    },
                    b => { final_elem = make_nullable(a, b ?? 0) },
                }
            } else {
                match expected_elem {
                    null => {}
                    exp2 => {
                        // 注解 nullable → 元素升 nullable。
                        val r = resolve(a, exp2 ?? 0)
                        match Arena.get(a, r) {
                            TNullable(_) => { final_elem = make_nullable(a, first_ty) }
                            _ => {},
                        }
                    },
                }
            }
            make_array(a, final_elem, elements.len() as i64)
        },
        // ── record 字面量 ──
        RecordLitE(fields) => {
            var fs: FT[] = []
            var i: usize = 0
            while i < fields.len() {
                val vty = infer_expr(ctx, a, s, fields[i].value, ast, env, null)
                fs = fs ++ [FT(fields[i].name, vty)]
                i = i + 1
            }
            make_record(a, fs, null)
        },
        RecordExtendE(base, updates) => {
            val base_ty = infer_expr(ctx, a, s, base, ast, env, null)
            val resolved = resolve(a, base_ty)
            match Arena.get(a, resolved) {
                TRecord(_) => {
                    var all_fields: FT[] = record_fields(a, resolved)
                    val name = record_name_local(a, resolved)
                    var i: usize = 0
                    while i < updates.len() {
                        val update_ty = infer_expr(ctx, a, s, updates[i].value, ast, env, null)
                        var found = false
                        var k: usize = 0
                        while k < all_fields.len() && !found {
                            match all_fields[k].name {
                                null => {}
                                n => {
                                    if n == updates[i].name {
                                        all_fields[k] = FT(n, update_ty)
                                        found = true
                                    }
                                },
                            }
                            k = k + 1
                        }
                        if !found {
                            all_fields = all_fields ++ [FT(updates[i].name, update_ty)]
                        }
                        i = i + 1
                    }
                    make_record(a, all_fields, name)
                },
                _ => {
                    add_error_at(s, "record extend requires record type", e.span.line, e.span.column)
                    fresh_type_var(a)
                },
            }
        },
        // ── lambda ──
        LambdaE(params, body, is_async, return_type) => {
            if return_type == null {
                add_error(s, "lambda requires an explicit return type annotation: fun(params): T \{ ... \}")
            }
            val child_env = Envs.child(s.env, env)
            var param_types: u32[] = []
            var pi: usize = 0
            while pi < params.len() {
                var param_ty = fresh_type_var(a)
                match params[pi].ta {
                    null => {}
                    ta => { param_ty = type_from_ast(ctx, a, s, ta, ast) }
                }
                define(s.env, child_env, params[pi].name, param_ty)
                param_types = param_types ++ [param_ty]
                pi = pi + 1
            }
            val saved_expected_return = ctx.expected_return
            match return_type {
                null => {}
                rt => { ctx.expected_return = type_from_ast(ctx, a, s, rt, ast) }
            }
            var body_ty = make(a, TVoid)
            match body {
                LBlock(b) => { body_ty = infer_expr(ctx, a, s, b, ast, child_env, null) }
                LExpr(x) => { body_ty = infer_expr(ctx, a, s, x, ast, child_env, null) }
            }
            ctx.expected_return = saved_expected_return
            var effective_body_ty = body_ty
            match return_type {
                null => {}
                rt => {
                    val annot_ty = type_from_ast(ctx, a, s, rt, ast)
                    match try_widen_unify(ctx, a, annot_ty, body_ty) {
                        TWOk(_) => {}
                        TWErr(msg) => {
                            add_error_at(s,
                                "lambda body type incompatible with declared return type: {msg}",
                                e.span.line, e.span.column)
                        }
                    }
                    match body {
                        LBlock(b) => {
                            check_missing_return_value(ctx, a, s, "lambda", annot_ty, b, ast, e.span.line, e.span.column)
                        },
                        LExpr(_) => {},
                    }
                    if !is_async {
                        var body_root: i64 = 0
                        match body {
                            LBlock(b) => { body_root = b }
                            LExpr(x) => { body_root = x }
                        }
                        check_throw_tail_wrapped(ctx, a, s, "lambda", annot_ty, body_root, body_ty, ast, e.span.line, e.span.column)
                    }
                    effective_body_ty = annot_ty
                },
            }
            var ret_ty = effective_body_ty
            if is_async {
                ret_ty = make_async(a, effective_body_ty)
            }
            make_fn(a, param_types, ret_ty)
        },
        // ── if 表达式 ──
        IfE(cond, then_branch, else_branch) => {
            val cond_ty = infer_expr(ctx, a, s, cond, ast, env, null)
            val bool_ty = make(a, TBool)
            unify_or_constrain(ctx, a, cond_ty, bool_ty)
            val facts = analyze_null_check_facts(ctx, a, s, ast, cond, env)
            val then_env = Envs.child(s.env, env)
            flow_push_scope(ctx)
            var fi: usize = 0
            while fi < facts.then_facts.len() {
                flow_add_fact(ctx, facts.then_facts.get(fi) ?? FFact("", 0, NKNonNull))
                fi = fi + 1
            }
            val then_ty = infer_expr(ctx, a, s, then_branch, ast, then_env, expected)
            flow_pop_scope(ctx)
            match else_branch {
                null => {
                    val void_ty = make(a, TVoid)
                    peer_type(a, [then_ty, void_ty])
                }
                else_br => {
                    val else_env = Envs.child(s.env, env)
                    flow_push_scope(ctx)
                    var ei: usize = 0
                    while ei < facts.else_facts.len() {
                        flow_add_fact(ctx, facts.else_facts.get(ei) ?? FFact("", 0, NKNonNull))
                        ei = ei + 1
                    }
                    val else_ty = infer_expr(ctx, a, s, else_br, ast, else_env, expected)
                    flow_pop_scope(ctx)
                    peer_type(a, [then_ty, else_ty])
                },
            }
        },
        // ── 块表达式 ──
        BlockE(stmts, trailing) => {
            val child_env = Envs.child(s.env, env)
            var diverges = false
            var i: usize = 0
            while i < stmts.len() {
                if diverges {
                    val sp = ast.stmt(stmts[i]).span
                    add_warning_at(s, "unreachable code after throw/return/break/continue", sp.line, sp.column)
                }
                val stmt_ty = infer_stmt(ctx, a, s, stmts[i], ast, child_env)
                var is_direct_exit = false
                match ast.stmt(stmts[i]).node {
                    ReturnS(_) => { is_direct_exit = true }
                    ThrowS(_) => { is_direct_exit = true }
                    BreakS => { is_direct_exit = true }
                    ContinueS => { is_direct_exit = true }
                    _ => {},
                }
                var is_never = false
                match stmt_ty {
                    null => {}
                    t => {
                        match Arena.get(a, resolve(a, t ?? 0)) {
                            TNever => { is_never = true }
                            _ => {},
                        }
                    },
                }
                if !diverges && (is_direct_exit || is_never) {
                    diverges = true
                }
                i = i + 1
            }
            match trailing {
                null => {
                    if diverges {
                        make(a, TNever)
                    } else {
                        make(a, TVoid)
                    }
                }
                te => {
                    if diverges {
                        val sp = ast.expr(te ?? 0).span
                        add_warning_at(s, "unreachable code after throw/return/break/continue", sp.line, sp.column)
                        val _tt = infer_expr(ctx, a, s, te ?? 0, ast, child_env, expected)
                        make(a, TNever)
                    } else {
                        infer_expr(ctx, a, s, te ?? 0, ast, child_env, expected)
                    }
                },
            }
        },
        // ── match ──
        MatchE(_, _) => { infer_match_expr(ctx, a, s, expr, ast, env, expected) },
        // ── Atomic/Lazy ──
        AtomicE(operand) => {
            val inner_ty = infer_expr(ctx, a, s, operand, ast, env, null)
            make_atomic(a, inner_ty)
        },
        LazyE(operand) => {
            val inner_ty = infer_expr(ctx, a, s, operand, ast, env, null)
            make_lazy(a, inner_ty)
        },
        // ── select ──
        SelectE(arms) => {
            val arm_tys = List.empty<u32>()
            var i: usize = 0
            while i < arms.len() {
                val child_env = Envs.child(s.env, env)
                flow_push_scope(ctx)
                match arms[i] {
                    SelRecv(channel_expr, binding, body) => {
                        val chan_ty = infer_expr(ctx, a, s, channel_expr, ast, child_env, null)
                        val resolved = resolve(a, chan_ty)
                        var elem_ty = chan_ty
                        match Arena.get(a, resolved) {
                            TNullable(_) => {
                                val inner = nullable_inner(a, resolved)
                                val inner_resolved = resolve(a, inner)
                                match Arena.get(a, inner_resolved) {
                                    TChannel(_) => { elem_ty = channel_elem(a, inner_resolved) }
                                    _ => { elem_ty = chan_ty }
                                }
                            },
                            TChannel(_) => { elem_ty = channel_elem(a, resolved) },
                            _ => { elem_ty = chan_ty },
                        }
                        match binding {
                            null => {}
                            name => {
                                define(s.env, child_env, name ?? "", elem_ty)
                            },
                        }
                        val body_ty = infer_expr(ctx, a, s, body, ast, child_env, null)
                        arm_tys.push(body_ty)
                    },
                    SelTimeout(duration, body) => {
                        val _dt = infer_expr(ctx, a, s, duration, ast, child_env, null)
                        val body_ty = infer_expr(ctx, a, s, body, ast, child_env, null)
                        arm_tys.push(body_ty)
                    },
                }
                flow_pop_scope(ctx)
                i = i + 1
            }
            if arm_tys.len() == 0 {
                make(a, TVoid)
            } else {
                var arr: u32[] = []
                var k: usize = 0
                while k < arm_tys.len() {
                    arr = arr ++ [arm_tys.get(k) ?? 0]
                    k = k + 1
                }
                peer_type(a, arr)
            }
        },
        // ── inline_trait ──
        InlineTraitE(methods) => { infer_inline_trait_expr(ctx, a, s, expr, ast, env, expected) },
    }
}

// 标识符推断(解析序:流窄化 → 局部 → 隐式 this 字段 → 全链 →
// trait 默认方法字段回退;未定义报错)。
fun infer_ident_expr(ctx: ICtx, a: TypeArena, s: SemaRes, expr: i64, ast: AstArena,
    env: u32): u32 {
    match ast.expr(expr).node {
        Ident(name) => {
            if name == "super" {
                val sp = ast.expr(expr).span
                add_error_at(s, "super is not a value; use it as a method-call receiver (super.method(...))",
                    sp.line, sp.column)
                return fresh_type_var(a)
            }
            // 流窄化优先。
            match flow_lookup_narrowed(ctx, name) {
                null => {}
                narrowed => { return narrowed ?? 0 }
            }
            val this_ty_opt = current_this_type(ctx)
            match this_ty_opt {
                null => {
                    // 方法体外:全链查找。
                    match lookup(s.env, env, name) {
                        null => {}
                        scheme => { return freshen_type(a, scheme ?? 0) }
                    }
                },
                this_ty => {
                    // 1. 仅本层局部。
                    match lookup_local(s.env, env, name) {
                        null => {}
                        scheme => { return freshen_type(a, scheme ?? 0) }
                    }
                    var is_typevar = false
                    match Arena.get(a, resolve(a, this_ty ?? 0)) {
                        TTypeVar(_) => { is_typevar = true }
                        _ => {},
                    }
                    // 2. 具体类型:字段先于同名方法。
                    if !is_typevar {
                        match try_implicit_this_field(ctx, a, s, this_ty ?? 0, name) {
                            null => {}
                            field_ty => { return field_ty ?? 0 }
                        }
                    }
                    // 3. 全链。
                    match lookup(s.env, env, name) {
                        null => {}
                        scheme => { return freshen_type(a, scheme ?? 0) }
                    }
                    // 4. trait 默认方法:字段宽容回退。
                    if is_typevar {
                        match try_implicit_this_field(ctx, a, s, this_ty ?? 0, name) {
                            null => {}
                            field_ty => { return field_ty ?? 0 }
                        }
                    }
                },
            }
            // 实例化模式:HM 已解析,查 expr_types 回放;查不到静默新 var。
            if ctx.inst != null {
                val key = module_expr_key(ctx.current_module_name, expr)
                match get_expr(s, key) {
                    null => {}
                    info => { return info ?? 0 }
                }
                return fresh_type_var(a)
            }
            val sp = ast.expr(expr).span
            add_error_at(s, "undefined variable '{name}'", sp.line, sp.column)
            fresh_type_var(a)
        },
        _ => { fresh_type_var(a) }
    }
}

// 二元表达式推断。
fun infer_binary_expr(ctx: ICtx, a: TypeArena, s: SemaRes, expr: i64, ast: AstArena,
    env: u32): u32 {
    match ast.expr(expr).node {
        BinaryE(op, lhs, rhs) => {
            val left_ty = infer_expr(ctx, a, s, lhs, ast, env, null)
            val right_ty = infer_expr(ctx, a, s, rhs, ast, env, null)
            val left_is_lit = expr_is_literal(ast, lhs)
            val right_is_lit = expr_is_literal(ast, rhs)
            val sp = ast.expr(expr).span
            // Lazy 子sume。
            var left_unwrapped = left_ty
            val rl0 = resolve(a, left_ty)
            match Arena.get(a, rl0) {
                TLazy(_) => { left_unwrapped = lazy_value(a, rl0) }
                _ => {},
            }
            var right_unwrapped = right_ty
            val rr0 = resolve(a, right_ty)
            match Arena.get(a, rr0) {
                TLazy(_) => { right_unwrapped = lazy_value(a, rr0) }
                _ => {},
            }
            match op {
                Add | Sub | Mul | Div | Mod => {
                    val rl = resolve(a, left_unwrapped)
                    val rr = resolve(a, right_unwrapped)
                    var has_array = false
                    match Arena.get(a, rl) {
                        TArray(_) => { has_array = true }
                        _ => {},
                    }
                    match Arena.get(a, rr) {
                        TArray(_) => { has_array = true }
                        _ => {},
                    }
                    if has_array {
                        add_error_at(s,
                            "arrays support no arithmetic; use ++ for concatenation and [v, ..n] for fill",
                            sp.line, sp.column)
                        return left_unwrapped
                    }
                    if ty_is_numeric(Arena.get(a, rl)) && ty_is_numeric(Arena.get(a, rr)) {
                        check_numeric_binop_compat(ctx, a, s, ast, lhs, rhs, rl, rr, sp.line, sp.column)
                        val peer_ty = peer_type_binary(a, left_unwrapped, right_unwrapped, left_is_lit, right_is_lit)
                        // Bug#96:字面量侧重打类型(IR 常量按 ExprInfo 读宽)。
                        if right_is_lit {
                            store_expr_info(ctx, a, s, rhs, peer_ty)
                        }
                        if left_is_lit {
                            store_expr_info(ctx, a, s, lhs, peer_ty)
                        }
                        return peer_ty
                    }
                    unify_or_constrain(ctx, a, left_unwrapped, right_unwrapped)
                    left_unwrapped
                },
                Eq | Neq | RefEq | RefNeq | Lt | Gt | LtEq | GtEq => {
                    val rl = resolve(a, left_unwrapped)
                    val rr = resolve(a, right_unwrapped)
                    // nullable 剥壳取内层数值比较。
                    var l_cmp = rl
                    match Arena.get(a, rl) {
                        TNullable(_) => { l_cmp = nullable_inner(a, rl) }
                        _ => {},
                    }
                    var r_cmp = rr
                    match Arena.get(a, rr) {
                        TNullable(_) => { r_cmp = nullable_inner(a, rr) }
                        _ => {},
                    }
                    if ty_is_numeric(Arena.get(a, l_cmp)) && ty_is_numeric(Arena.get(a, r_cmp)) {
                        check_numeric_binop_compat(ctx, a, s, ast, lhs, rhs, l_cmp, r_cmp, sp.line, sp.column)
                        val peer_ty = peer_type_binary(a, l_cmp, r_cmp, left_is_lit, right_is_lit)
                        if right_is_lit {
                            store_expr_info(ctx, a, s, rhs, peer_ty)
                        }
                        if left_is_lit {
                            store_expr_info(ctx, a, s, lhs, peer_ty)
                        }
                    } else {
                        unify_or_constrain(ctx, a, left_unwrapped, right_unwrapped)
                    }
                    make(a, TBool)
                },
                And | Or => {
                    val bool_ty = make(a, TBool)
                    unify_or_constrain(ctx, a, left_unwrapped, bool_ty)
                    unify_or_constrain(ctx, a, right_unwrapped, bool_ty)
                    bool_ty
                },
                BitAnd | BitOr | BitXor | Shl | Shr => {
                    unify_or_constrain(ctx, a, left_unwrapped, right_unwrapped)
                    left_unwrapped
                },
                ConcatList => {
                    val left_elem = fresh_type_var(a)
                    val left_arr = make_array(a, left_elem, null)
                    unify_or_constrain(ctx, a, left_unwrapped, left_arr)
                    val right_arr = make_array(a, left_elem, null)
                    unify_or_constrain(ctx, a, right_unwrapped, right_arr)
                    make_array(a, left_elem, null)
                },
                Range | RangeIncl => {
                    // 操作数须整型(运行期 i64 包裹)。
                    if !range_side_is_int(a, left_unwrapped) {
                        val rs = resolve(a, left_unwrapped)
                        add_error_at(s,
                            "range start operand must be an integer type, found '{display(a, rs)}'",
                            sp.line, sp.column)
                    }
                    if !range_side_is_int(a, right_unwrapped) {
                        val rs = resolve(a, right_unwrapped)
                        add_error_at(s,
                            "range end operand must be an integer type, found '{display(a, rs)}'",
                            sp.line, sp.column)
                    }
                    make_generic(a, "RangeIterator", [])
                },
                ElvisOp => {
                    val rl = resolve(a, left_ty)
                    match Arena.get(a, rl) {
                        TNullable(_) => {
                            val inner = nullable_inner(a, rl)
                            // 1 号案根修:pending 内型绑定到默认值类型。
                            val rr = resolve(a, right_ty)
                            var rr_pending = false
                            match Arena.get(a, rr) {
                                TTypeVar(_) => { rr_pending = true }
                                TUnknown => { rr_pending = true }
                                _ => {},
                            }
                            if rr_pending {
                                unify_or_constrain(ctx, a, inner, right_ty)
                            } else {
                                match try_widen_unify(ctx, a, inner, right_ty) {
                                    TWOk(_) => {}
                                    TWErr(_) => {},
                                }
                            }
                            inner
                        },
                        TThrow(_) => {
                            val p = thr_parts(a, rl)
                            match try_widen_unify(ctx, a, p.a, right_ty) {
                                TWOk(_) => {}
                                TWErr(msg) => {
                                    add_error(s, "?? default value incompatible with Throw value type: {msg}")
                                }
                            }
                            p.a
                        },
                        _ => { left_ty }
                    }
                },
            }
        },
        _ => { fresh_type_var(a) }
    }
}

// range 操作数整型判定。
fun range_side_is_int(a: TypeArena, ty: u32): bool {
    match Arena.get(a, resolve(a, ty)) {
        TI8 => { true }
        TI16 => { true }
        TI32 => { true }
        TI64 => { true }
        TI128 => { true }
        TU8 => { true }
        TU16 => { true }
        TU32 => { true }
        TU64 => { true }
        TU128 => { true }
        TIsize => { true }
        TUsize => { true }
        _ => { false }
    }
}

// Bug K:裸零参构造器 + 期望具体泛型 ADT → 按期望实参实例化。
fun infer_nullary_ctor_with_expected(ctx: ICtx, a: TypeArena, s: SemaRes, expr: i64,
    name: str, expected: u32): u32? {
    val ctors = ctor_defs_of(s, name)
    if ctors.len() == 0 {
        return null
    }
    var is_nullary = false
    var ci: usize = 0
    while ci < ctors.len() && !is_nullary {
        val c = ctors.get(ci) ?? Ctor("", "", [], [], [], false, null, null, [], Span(0, 0), "")
        if c.field_type_reprs.len() == 0 {
            is_nullary = true
        }
        ci = ci + 1
    }
    if !is_nullary {
        return null
    }
    val exp_resolved = resolve(a, expected)
    var exp_type_name = ""
    var exp_args: u32[] = []
    match Arena.get(a, exp_resolved) {
        TAdt(_) => {
            val p = adt_parts(a, exp_resolved)
            exp_type_name = p.a
            exp_args = p.b
        },
        TGeneric(_) => {
            val p = generic_parts(a, exp_resolved)
            exp_type_name = p.a
            exp_args = p.b
        },
        _ => { return null }
    }
    // 同名消歧:期望类型名匹配的零参构造器。
    var type_name = ""
    var matched = false
    ci = 0
    while ci < ctors.len() && !matched {
        val c = ctors.get(ci) ?? Ctor("", "", [], [], [], false, null, null, [], Span(0, 0), "")
        if c.field_type_reprs.len() == 0 && c.type_name == exp_type_name {
            type_name = c.type_name
            matched = true
        }
        ci = ci + 1
    }
    if !matched {
        if ctors.len() == 1 {
            type_name = (ctors.get(0) ?? Ctor("", "", [], [], [], false, null, null, [], Span(0, 0), "")).type_name
        } else {
            return null
        }
    }
    make_adt(a, type_name, exp_args)
}

// inline_trait:期望类型取 trait 名 → 方法完整性检查 + 方法体推断 →
// TraitObject。
fun infer_inline_trait_expr(ctx: ICtx, a: TypeArena, s: SemaRes, expr: i64, ast: AstArena,
    env: u32, expected: u32?): u32 {
    match ast.expr(expr).node {
        InlineTraitE(methods) => {
            var trait_name: str? = null
            match expected {
                null => {}
                exp => {
                    val resolved = resolve(a, exp ?? 0)
                    match Arena.get(a, resolved) {
                        TTrait(_) => { trait_name = if true { trait_parts(a, resolved).a } else { null } }
                        TTraitObject(_) => { trait_name = if true { trait_object_parts(a, resolved).a } else { null } }
                        _ => {},
                    }
                },
            }
            // 方法签名收集。
            val sigs = List.empty<TMS>()
            var mi: usize = 0
            while mi < methods.len() {
                val m = methods[mi]
                var return_type = make(a, TVoid)
                match m.rt {
                    null => {}
                    rt => { return_type = type_from_ast(ctx, a, s, rt, ast) }
                }
                sigs.push(TMS(m.name, m.params.len() as i64, return_type, m.is_async, m.body != null))
                mi = mi + 1
            }
            match trait_name {
                null => {
                    add_error_at(s,
                        "inline_trait cannot infer trait name: explicit type annotation required",
                        ast.expr(expr).span.line, ast.expr(expr).span.column)
                    fresh_type_var(a)
                }
                tname => {
                    // 完整性:trait 无体方法须全数在场。
                    match get_trait_def(s, tname ?? "") {
                        null => {}
                        td => {
                            var ri: usize = 0
                            while ri < td.methods.len() {
                                val req = td.methods[ri]
                                if !req.has_body {
                                    var found = false
                                    var si: usize = 0
                                    while si < sigs.len() && !found {
                                        val sig = sigs.get(si) ?? TMS("", 0, 0, false, false)
                                        if sig.name == req.name && sig.param_count == req.param_count {
                                            found = true
                                        }
                                        si = si + 1
                                    }
                                    if !found {
                                        add_error_at(s,
                                            "inline_trait missing required method {req.name} of trait {tname} (param count {req.param_count})",
                                            ast.expr(expr).span.line, ast.expr(expr).span.column)
                                    }
                                }
                                ri = ri + 1
                            }
                        },
                    }
                    // 方法体推断。
                    mi = 0
                    while mi < methods.len() {
                        val m = methods[mi]
                        match m.body {
                            null => {}
                            body => {
                                val method_env = Envs.child(s.env, env)
                                var pi: usize = 0
                                while pi < m.params.len() {
                                    var param_ty = fresh_type_var(a)
                                    match m.params[pi].ta {
                                        null => {}
                                        ta => { param_ty = type_from_ast(ctx, a, s, ta, ast) }
                                    }
                                    define(s.env, method_env, m.params[pi].name, param_ty)
                                    pi = pi + 1
                                }
                                val prev_return = ctx.expected_return
                                match m.rt {
                                    null => { ctx.expected_return = null }
                                    rt => { ctx.expected_return = type_from_ast(ctx, a, s, rt, ast) }
                                }
                                val _bt = infer_expr(ctx, a, s, body ?? 0, ast, method_env, ctx.expected_return)
                                ctx.expected_return = prev_return
                            },
                        }
                        mi = mi + 1
                    }
                    var arr: TMS[] = []
                    var si: usize = 0
                    while si < sigs.len() {
                        arr = arr ++ [sigs.get(si) ?? TMS("", 0, 0, false, false)]
                        si = si + 1
                    }
                    make_trait_object(a, tname ?? "", arr)
                },
            }
        },
        _ => { fresh_type_var(a) }
    }
}

// ─── Callinfer:调用/方法调用/成员查找 ─────────────────────────────

// 目录模块语义:同目录兄弟模块 env 里查自由函数。
fun lookup_sibling_module_fn(s: SemaRes, mod_path: str, self_env: u32, method: str): u32? {
    val dot_pos = find_last_sub(mod_path, ".")
    if dot_pos < 0 {
        return null
    }
    val dir_prefix = Str.substring(mod_path, 0, dot_pos as usize)
    val sibling_prefix = "{dir_prefix}."
    val keys = s.module_envs.keys()
    var i: usize = 0
    while i < keys.len() {
        val path = keys[i]
        if Str.starts_with(path, sibling_prefix) && path != mod_path {
            match s.module_envs.get(path) {
                null => {}
                env_id => {
                    if env_id != self_env {
                        match lookup_local(s.env, env_id ?? 0, method) {
                            null => {}
                            ty => { return ty }
                        }
                    }
                },
            }
        }
        i = i + 1
    }
    null
}

// Call 表达式推断(标量 ctor 拒绝 → 多 ctor 消歧 → 零参 ctor →
// 隐式 this → callee 推断 → ModuleRef → 通用调用)。
fun infer_call_expr(ctx: ICtx, a: TypeArena, s: SemaRes, expr: i64, ast: AstArena,
    env: u32, expected: u32?): u32 {
    match ast.expr(expr).node {
        CallE(callee, args, _) => {
            val e = ast.expr(expr)
            // 标量类型名作构造调用 → 报错(u64(x) 须写 as)。
            match ast.expr(callee).node {
                Ident(name) => {
                    if is_numeric_ctor_name(name) {
                        add_error_at(s,
                            "'{name}' is a scalar type and has no constructor; use 'x as {name}' for conversion",
                            e.span.line, e.span.column)
                        var zi: usize = 0
                        while zi < args.len() {
                            val _t = infer_expr(ctx, a, s, args[zi], ast, env, null)
                            zi = zi + 1
                        }
                        return make(a, TUnknown)
                    }
                },
                _ => {},
            }
            // callee 类型解析。
            var callee_ty: u32 = 0
            var resolved_directly = false
            match ast.expr(callee).node {
                Ident(name) => {
                    val ctors = ctor_defs_of(s, name)
                    if ctors.len() == 1 {
                        val c = ctors.get(0) ?? Ctor("", "", [], [], [], false, null, null, [], Span(0, 0), "")
                        match ctor_privacy_error(ctx, s, c.type_name, c.name) {
                            null => {}
                            msg => {
                                add_error_at(s, msg ?? "", e.span.line, e.span.column)
                                return fresh_type_var(a)
                            }
                        }
                    }
                    if ctors.len() > 1 {
                        // 消歧:期望类型定向 → 元数。
                        var found: Ctor? = null
                        match expected {
                            null => {}
                            exp => {
                                val exp_resolved = resolve(a, exp ?? 0)
                                match Arena.get(a, exp_resolved) {
                                    TAdt(_) => {
                                        val exp_type_name = adt_parts(a, exp_resolved).a
                                        var hits: i64 = 0
                                        var hit: Ctor? = null
                                        var ci: usize = 0
                                        while ci < ctors.len() {
                                            val c = ctors.get(ci) ?? Ctor("", "", [], [], [], false, null, null, [], Span(0, 0), "")
                                            if c.type_name == exp_type_name {
                                                hit = if true { c } else { null }
                                                hits = hits + 1
                                            }
                                            ci = ci + 1
                                        }
                                        if hits == 1 {
                                            found = hit
                                        }
                                    },
                                    _ => {},
                                }
                            },
                        }
                        if found == null {
                            var hits: i64 = 0
                            var hit: Ctor? = null
                            var ci: usize = 0
                            while ci < ctors.len() {
                                val c = ctors.get(ci) ?? Ctor("", "", [], [], [], false, null, null, [], Span(0, 0), "")
                                if c.field_type_reprs.len() == args.len() {
                                    hit = if true { c } else { null }
                                    hits = hits + 1
                                }
                                ci = ci + 1
                            }
                            if hits == 1 {
                                found = hit
                            }
                        }
                        match found {
                            null => {
                                var names: str[] = []
                                var ci: usize = 0
                                while ci < ctors.len() {
                                    names = names ++ [(ctors.get(ci) ?? Ctor("", "", [], [], [], false, null, null, [], Span(0, 0), "")).type_name]
                                    ci = ci + 1
                                }
                                add_error_at(s,
                                    "ambiguous constructor '{name}': defined by types [{Semares.str_join(names, ", ")}]; use Type.{name} to disambiguate or provide a type context",
                                    e.span.line, e.span.column)
                                return fresh_type_var(a)
                            }
                            c0 => {
                                val c = c0 ?? Ctor("", "", [], [], [], false, null, null, [], Span(0, 0), "")
                                match ctor_privacy_error(ctx, s, c.type_name, name) {
                                    null => {}
                                    msg => {
                                        add_error_at(s, msg ?? "", e.span.line, e.span.column)
                                        return fresh_type_var(a)
                                    }
                                }
                                var param_types: u32[] = []
                                var fi: usize = 0
                                while fi < c.field_type_reprs.len() {
                                    param_types = param_types ++ [type_repr_to_handle_ctx(ctx, a, s, c.field_type_reprs[fi])]
                                    fi = fi + 1
                                }
                                val ret_ty = make_adt(a, c.type_name, [])
                                if param_types.len() == 0 {
                                    callee_ty = ret_ty
                                } else {
                                    callee_ty = make_fn(a, param_types, ret_ty)
                                }
                                resolved_directly = true
                            },
                        }
                    } else {
                        if ctors.len() == 1 && args.len() == 0 {
                            val c = ctors.get(0) ?? Ctor("", "", [], [], [], false, null, null, [], Span(0, 0), "")
                            if c.field_type_reprs.len() == 0 {
                                // Bug#69:零参构造器 `()` 调用 = 裸值。
                                val ret_ty = make_adt(a, c.type_name, [])
                                match expected {
                                    null => {}
                                    exp => { unify_or_constrain(ctx, a, ret_ty, exp ?? 0) }
                                }
                                return ret_ty
                            }
                        }
                        // 隐式 this:this.method(args) 快路径。
                        var handled = false
                        match current_this_type(ctx) {
                            null => {}
                            this_ty => {
                                match lookup_method_type(ctx, a, s, this_ty ?? 0, name, e.span.line, e.span.column) {
                                    null => {}
                                    fn_ty => {
                                        val inst_fn = instantiate_fn_type(a, fn_ty ?? 0)
                                        match Arena.get(a, inst_fn) {
                                            TFn(_) => {
                                                val f = fn_parts(a, inst_fn)
                                                val n = if f.ps.len() < args.len() + 1 { f.ps.len() } else { args.len() + 1 }
                                                var k: usize = 1
                                                while k < n {
                                                    val arg_ty = infer_expr(ctx, a, s, args[k - 1], ast, env, f.ps[k])
                                                    var is_null_lit = false
                                                    match ast.expr(args[k - 1]).node {
                                                        NullLit => { is_null_lit = true }
                                                        _ => {},
                                                    }
                                                    val sp = ast.expr(args[k - 1]).span
                                                    unify_call_arg(ctx, a, s, f.ps[k], arg_ty, sp.line, sp.column, is_null_lit)
                                                    k = k + 1
                                                }
                                                store_expr_info(ctx, a, s, callee, fn_ty ?? 0)
                                                handled = true
                                                return f.ret
                                            },
                                            _ => {},
                                        }
                                    },
                                }
                            },
                        }
                        if !handled {
                            // S2c 镜像(引擎 CallInfer 同步):裸名自由调用经
                            // root 层解析且全局多主 → 调用点歧义错(消息与
                            // 引擎逐字节一致);本模块自有定义与显式选择性
                            // 条目豁免(优先级格:显式 > std 预declare 层)。
                            match Envs.lookup_at_root(s.env, env, name) {
                                null => {}
                                _ => {
                                    match s.func_sig_owners.get(name) {
                                        null => {}
                                        owners_csv => {
                                            val oc = owners_csv ?? ""
                                            val oparts = Str.split(oc, ",")
                                            var own = false
                                            var oi: usize = 0
                                            while oi < oparts.len() {
                                                if oparts[oi] == ctx.current_module_name {
                                                    own = true
                                                }
                                                oi = oi + 1
                                            }
                                            val alias_key = ctx.current_module_name + "\u{0}" + name
                                            if oparts.len() >= 2 && !own && !s.import_alias_owners.has(alias_key) {
                                                add_error_at(s,
                                                    "ambiguous call '" + name + "': [" + oc + "] — qualify the call or bind it with a selective import",
                                                    e.span.line, e.span.column)
                                            }
                                        },
                                    }
                                },
                            }
                            callee_ty = infer_expr(ctx, a, s, callee, ast, env, null)
                            resolved_directly = true
                        }
                    }
                },
                _ => {
                    callee_ty = infer_expr(ctx, a, s, callee, ast, env, null)
                    resolved_directly = true
                },
            }
            val resolved_callee = resolve(a, callee_ty)
            // 实例化模式:HM 已检过,跳 unify;只推实参、返返回类型。
            if ctx.inst != null {
                match Arena.get(a, resolved_callee) {
                    TModuleRef(_) => {
                        val p = module_ref_parts(a, resolved_callee)
                        val func_name0 = tail_seg(p.a)
                        match lookup_local(s.env, p.b, func_name0) {
                            null => {}
                            fn_ty0 => {
                                val inst_fn0 = instantiate_fn_type(a, fn_ty0 ?? 0)
                                match Arena.get(a, inst_fn0) {
                                    TFn(_) => {
                                        val f0 = fn_parts(a, inst_fn0)
                                        var k0: usize = 0
                                        while k0 < f0.ps.len() && k0 < args.len() {
                                            val _t0 = infer_expr(ctx, a, s, args[k0], ast, env, f0.ps[k0])
                                            k0 = k0 + 1
                                        }
                                        return f0.ret
                                    },
                                    _ => {},
                                }
                            },
                        }
                    },
                    _ => {},
                }
                val inst_callee0 = instantiate_fn_type(a, resolved_callee)
                match Arena.get(a, inst_callee0) {
                    TFn(_) => {
                        val f0 = fn_parts(a, inst_callee0)
                        var k0: usize = 0
                        while k0 < f0.ps.len() && k0 < args.len() {
                            val _t0 = infer_expr(ctx, a, s, args[k0], ast, env, f0.ps[k0])
                            k0 = k0 + 1
                        }
                        return f0.ret
                    },
                    _ => {},
                }
                add_error_at(s,
                    "cannot call non-function value of type '{display(a, resolved_callee)}'",
                    e.span.line, e.span.column)
                var z0: usize = 0
                while z0 < args.len() {
                    val _t0 = infer_expr(ctx, a, s, args[z0], ast, env, null)
                    z0 = z0 + 1
                }
                return make(a, TUnknown)
            }
            // ModuleRef 调用:模块 env 按尾段名查签名。
            match Arena.get(a, resolved_callee) {
                TModuleRef(_) => {
                    val p = module_ref_parts(a, resolved_callee)
                    val func_name = tail_seg(p.a)
                    match lookup_local(s.env, p.b, func_name) {
                        null => {}
                        fn_ty => {
                            val inst_fn = instantiate_fn_type(a, fn_ty ?? 0)
                            match Arena.get(a, inst_fn) {
                                TFn(_) => {
                                    val f = fn_parts(a, inst_fn)
                                    if f.ps.len() == args.len() {
                                        var k: usize = 0
                                        while k < f.ps.len() {
                                            val arg_ty = infer_expr(ctx, a, s, args[k], ast, env, f.ps[k])
                                            match unwrap_leak_kind(a, f.ps[k], arg_ty) {
                                                null => {}
                                                kind => {
                                                    var is_null_lit = false
                                                    match ast.expr(args[k]).node {
                                                        NullLit => { is_null_lit = true }
                                                        _ => {},
                                                    }
                                                    if !is_null_lit {
                                                        add_error(s,
                                                            "argument type incompatible with parameter type: cannot pass a {kind} value where '{display(a, resolve(a, f.ps[k]))}' is expected — unwrap explicitly ('?? default', '!', '?', or an '!= null' narrowed branch)")
                                                    }
                                                },
                                            }
                                            match try_widen_unify(ctx, a, f.ps[k], arg_ty) {
                                                TWOk(_) => {}
                                                TWErr(msg) => {
                                                    add_error(s, "argument type incompatible with parameter type: {msg}")
                                                }
                                            }
                                            k = k + 1
                                        }
                                        return f.ret
                                    }
                                },
                                _ => {},
                            }
                        },
                    }
                },
                _ => {},
            }
            // 通用调用:签名实例化 + 逐参统一。
            val inst_callee = instantiate_fn_type(a, resolved_callee)
            match Arena.get(a, inst_callee) {
                TFn(_) => {
                    val f = fn_parts(a, inst_callee)
                    if f.ps.len() == args.len() {
                        var k: usize = 0
                        while k < f.ps.len() {
                            val arg_ty = infer_expr(ctx, a, s, args[k], ast, env, f.ps[k])
                            var is_null_lit = false
                            match ast.expr(args[k]).node {
                                NullLit => { is_null_lit = true }
                                _ => {},
                            }
                            val sp = ast.expr(args[k]).span
                            unify_call_arg(ctx, a, s, f.ps[k], arg_ty, sp.line, sp.column, is_null_lit)
                            k = k + 1
                        }
                    }
                    match expected {
                        null => {}
                        exp => { unify_or_constrain(ctx, a, f.ret, exp ?? 0) }
                    }
                    return f.ret
                },
                _ => {},
            }
            // 回退:推断实参 + 与 (args -> ret) 约束。
            val ret_ty = fresh_type_var(a)
            var arg_types: u32[] = []
            var k: usize = 0
            while k < args.len() {
                arg_types = arg_types ++ [infer_expr(ctx, a, s, args[k], ast, env, null)]
                k = k + 1
            }
            val expected_fn = make_fn(a, arg_types, ret_ty)
            unify_or_constrain(ctx, a, callee_ty, expected_fn)
            ret_ty
        },
        _ => { fresh_type_var(a) }
    }
}

// MethodCall/SafeMethodCall 推断。
fun infer_method_call_expr(ctx: ICtx, a: TypeArena, s: SemaRes, expr: i64, ast: AstArena,
    env: u32, expected: u32?): u32 {
    val e = ast.expr(expr)
    var recv: i64 = 0
    var method = ""
    var args: i64[] = []
    match e.node {
        MethodCallE(r, m, as_, _) => {
            recv = r
            method = m
            args = as_
        },
        SafeMethodCallE(r, m, as_, _) => {
            recv = r
            method = m
            args = as_
        },
        _ => { return fresh_type_var(a) }
    }
    // super.method(...):静态分派到绑定 trait 默认层。
    match ast.expr(recv).node {
        Ident("super") => {
            return infer_super_method_call(ctx, a, s, expr, ast, env, expected, method, args)
        },
        _ => {},
    }
    // Lib.open/Lib.embed 内建构造(未被局部绑定遮蔽)。
    match ast.expr(recv).node {
        Ident("Lib") => {
            var shadowed = false
            match lookup(s.env, env, "Lib") {
                null => {}
                _ => { shadowed = true }
            }
            if !shadowed && (method == "open" || method == "embed") {
                if args.len() != 1 {
                    add_error_at(s,
                        "Lib.{method} takes exactly 1 argument (path: str), got {args.len()}",
                        e.span.line, e.span.column)
                    return fresh_type_var(a)
                }
                val str_ty = make(a, TStr)
                val arg_ty = infer_expr(ctx, a, s, args[0], ast, env, str_ty)
                unify_or_constrain(ctx, a, str_ty, arg_ty)
                val lib_ty = make(a, TLib)
                val err_ty = ffi_error_ty(a)
                s.module_func_recv_exprs.set(module_expr_key(ctx.current_module_name, recv), true)
                return make_throw(a, lib_ty, err_ty)
            }
        },
        _ => {},
    }
    // 限定构造器调用 Type.Ctor(args)。
    match ast.expr(recv).node {
        Ident(type_name) => {
            match check_qualified_ctor(ctx, s, type_name, method) {
                null => {}
                qc => {
                    val hit = qc ?? QC("", [])
                    match ctor_privacy_error(ctx, s, type_name, method) {
                        null => {}
                        msg => {
                            add_error_at(s, msg ?? "", e.span.line, e.span.column)
                            return fresh_type_var(a)
                        }
                    }
                    if hit.field_reprs.len() > 0 {
                        var param_types: u32[] = []
                        var fi: usize = 0
                        while fi < hit.field_reprs.len() {
                            param_types = param_types ++ [type_repr_to_handle_ctx(ctx, a, s, hit.field_reprs[fi])]
                            fi = fi + 1
                        }
                        val ret_ty = make_adt(a, hit.type_name, [])
                        val fn_ty = make_fn(a, param_types, ret_ty)
                        val f = fn_parts(a, fn_ty)
                        if f.ps.len() == args.len() {
                            var k: usize = 0
                            while k < f.ps.len() {
                                val arg_ty = infer_expr(ctx, a, s, args[k], ast, env, f.ps[k])
                                unify_or_constrain(ctx, a, f.ps[k], arg_ty)
                                k = k + 1
                            }
                        }
                        match expected {
                            null => {}
                            exp => { unify_or_constrain(ctx, a, f.ret, exp ?? 0) }
                        }
                        s.module_func_recv_exprs.set(module_expr_key(ctx.current_module_name, recv), true)
                        return f.ret
                    }
                    // 零参构造器带 () → 报错。
                    add_error_at(s,
                        "constructor '{method}' of type '{type_name}' takes no arguments; use {type_name}.{method} syntax",
                        e.span.line, e.span.column)
                    return fresh_type_var(a)
                },
            }
        },
        _ => {},
    }
    val recv_ty = infer_expr(ctx, a, s, recv, ast, env, null)
    // 1 号案:裸 TypeVar/Unknown 接收者 → 挂起(求解后 9.2 重试)。
    val recv_resolved_0a = resolve(a, recv_ty)
    var bare_var_recv = false
    if ctx.inst == null {
        match Arena.get(a, recv_resolved_0a) {
            TTypeVar(_) => { bare_var_recv = true }
            TUnknown => { bare_var_recv = true }
            _ => {},
        }
    }
    if bare_var_recv {
        ctx.deferred_calls.push(DCall(expr, env))
    }
    // Path 0a:ModuleRef 接收者 → 模块路径函数调用。
    match Arena.get(a, recv_resolved_0a) {
        TModuleRef(_) => {
            val p = module_ref_parts(a, recv_resolved_0a)
            var found = lookup_local(s.env, p.b, method)
            if found == null {
                found = lookup_sibling_module_fn(s, p.a, p.b, method)
            }
            match found {
                null => {}
                binding => {
                    val inst_fn = instantiate_fn_type(a, binding ?? 0)
                    match Arena.get(a, inst_fn) {
                        TFn(_) => {
                            val f = fn_parts(a, inst_fn)
                            val n = if f.ps.len() < args.len() { f.ps.len() } else { args.len() }
                            var k: usize = 0
                            while k < n {
                                val arg_ty = infer_expr(ctx, a, s, args[k], ast, env, f.ps[k])
                                var is_null_lit = false
                                match ast.expr(args[k]).node {
                                    NullLit => { is_null_lit = true }
                                    _ => {},
                                }
                                val sp = ast.expr(args[k]).span
                                unify_call_arg(ctx, a, s, f.ps[k], arg_ty, sp.line, sp.column, is_null_lit)
                                k = k + 1
                            }
                            s.module_func_recv_exprs.set(module_expr_key(ctx.current_module_name, recv), true)
                            return f.ret
                        },
                        _ => {
                            // 零参构造器 `A.TEf()` 形态(Bug#69 族)。
                            if args.len() == 0 {
                                val v_resolved = resolve(a, binding ?? 0)
                                match Arena.get(a, v_resolved) {
                                    TAdt(_) => {
                                        return binding ?? 0
                                    },
                                    _ => {},
                                }
                            }
                        },
                    }
                },
            }
        },
        _ => {},
    }
    // Path 0b:构造器接收者(类型名 == 模块名)→ 模块函数调用。
    match Arena.get(a, recv_resolved_0a) {
        TFn(_) => {
            val f = fn_parts(a, recv_resolved_0a)
            val ret_resolved = resolve(a, f.ret)
            match Arena.get(a, ret_resolved) {
                TAdt(_) => {
                    val type_name = adt_parts(a, ret_resolved).a
                    var mod_env = ctx.ctor_module_envs.get(type_name)
                    if mod_env == null && Str.contains(type_name, ".") {
                        mod_env = ctx.ctor_module_envs.get(tail_seg(type_name))
                    }
                    match mod_env {
                        null => {}
                        me => {
                            match lookup_local(s.env, me ?? 0, method) {
                                null => {}
                                fn_ty => {
                                    // 类型方法守卫:方法属类型表 → 报错。
                                    var is_type_method = false
                                    match get_type_def(s, type_name) {
                                        null => {}
                                        def => {
                                            var mi: usize = 0
                                            while mi < def.methods.len() && !is_type_method {
                                                if def.methods[mi].name == method {
                                                    is_type_method = true
                                                }
                                                mi = mi + 1
                                            }
                                        },
                                    }
                                    if is_type_method {
                                        add_error_at(s,
                                            "method '{type_name}.{method}' cannot be called through the type name; call it on an instance (x.{method}(..)) or via the bare form {method}(instance, ..), or move the factory to module level",
                                            e.span.line, e.span.column)
                                        return fresh_type_var(a)
                                    }
                                    val inst_fn = instantiate_fn_type(a, fn_ty ?? 0)
                                    match Arena.get(a, inst_fn) {
                                        TFn(_) => {
                                            val f2 = fn_parts(a, inst_fn)
                                            val n = if f2.ps.len() < args.len() { f2.ps.len() } else { args.len() }
                                            var k: usize = 0
                                            while k < n {
                                                val arg_ty = infer_expr(ctx, a, s, args[k], ast, env, f2.ps[k])
                                                var is_null_lit = false
                                                match ast.expr(args[k]).node {
                                                    NullLit => { is_null_lit = true }
                                                    _ => {},
                                                }
                                                val sp = ast.expr(args[k]).span
                                                unify_call_arg(ctx, a, s, f2.ps[k], arg_ty, sp.line, sp.column, is_null_lit)
                                                k = k + 1
                                            }
                                            s.module_func_recv_exprs.set(module_expr_key(ctx.current_module_name, recv), true)
                                            return f2.ret
                                        },
                                        _ => {},
                                    }
                                },
                            }
                        },
                    }
                },
                _ => {},
            }
        },
        _ => {},
    }
    // 语言级 intrinsic 标记:await(通用)/recv(Channel/Receiver)。
    var intrinsic_hit = false
    if method == "await" && args.len() == 0 {
        intrinsic_hit = true
    } else {
        if method == "recv" && args.len() == 0 {
            match Arena.get(a, recv_resolved_0a) {
                TChannel(_) => { intrinsic_hit = true }
                TReceiver(_) => { intrinsic_hit = true }
                _ => {},
            }
        }
    }
    if intrinsic_hit {
        put_dispatch(s, module_expr_key(ctx.current_module_name, expr))
    }
    // Path 1:类型感知方法查找(见证表/类型方法表)。
    match lookup_method_type(ctx, a, s, recv_ty, method, e.span.line, e.span.column) {
        null => {}
        fn_ty => {
            val inst_fn = instantiate_fn_type(a, fn_ty ?? 0)
            match Arena.get(a, inst_fn) {
                TFn(_) => {
                    val f = fn_parts(a, inst_fn)
                    // this 参与接收者统一(1 号案:签名类型参从 recv 绑定)。
                    if f.ps.len() > 0 {
                        val _u = unify(a, f.ps[0], recv_ty)
                    }
                    val n = if f.ps.len() < args.len() + 1 { f.ps.len() } else { args.len() + 1 }
                    var k: usize = 1
                    while k < n {
                        val arg_ty = infer_expr(ctx, a, s, args[k - 1], ast, env, f.ps[k])
                        var is_null_lit = false
                        match ast.expr(args[k - 1]).node {
                            NullLit => { is_null_lit = true }
                            _ => {},
                        }
                        val sp = ast.expr(args[k - 1]).span
                        unify_call_arg(ctx, a, s, f.ps[k], arg_ty, sp.line, sp.column, is_null_lit)
                        k = k + 1
                    }
                    return f.ret
                },
                _ => {},
            }
        },
    }
    // Path 0:自由函数回退(recv.m(args) 糖 = m(recv, args));裸 var
    // 接收者跳过(首绑劫持向量)。
    if !bare_var_recv {
        match env_lookup_with_pred(s, a, env, method, true) {
            null => {}
            fn_ty => {
                val inst_fn = instantiate_fn_type(a, fn_ty ?? 0)
                match Arena.get(a, inst_fn) {
                    TFn(_) => {
                        val f = fn_parts(a, inst_fn)
                        // 候选门(Bug#103):元数 + 首参可纳接收者。
                        var arity_ok = f.ps.len() == args.len() + 1
                        var recv_ok = true
                        if f.ps.len() == 0 {
                            recv_ok = true
                        } else {
                            if unify_ok(a, f.ps[0], recv_ty) {
                                recv_ok = true
                            } else {
                                // 深含 TypeVar → 宽容约束;全具体失配 → 拒。
                                if type_contains_typevar(a, f.ps[0]) || type_contains_typevar(a, recv_ty) {
                                    unify_or_constrain(ctx, a, f.ps[0], recv_ty)
                                    recv_ok = true
                                } else {
                                    recv_ok = false
                                }
                            }
                        }
                        if arity_ok && recv_ok {
                            if f.ps.len() > 0 {
                                unify_or_constrain(ctx, a, f.ps[0], recv_ty)
                            }
                            val n = if f.ps.len() < args.len() + 1 { f.ps.len() } else { args.len() + 1 }
                            var k: usize = 1
                            while k < n {
                                val arg_ty = infer_expr(ctx, a, s, args[k - 1], ast, env, f.ps[k])
                                var is_null_lit = false
                                match ast.expr(args[k - 1]).node {
                                    NullLit => { is_null_lit = true }
                                    _ => {},
                                }
                                val sp = ast.expr(args[k - 1]).span
                                unify_call_arg(ctx, a, s, f.ps[k], arg_ty, sp.line, sp.column, is_null_lit)
                                k = k + 1
                            }
                            return f.ret
                        }
                        // 非候选:继续后续路径。
                    },
                    _ => {},
                }
            },
        }
    }
    // await 通用挂起语义:不产值。
    if method == "await" && args.len() == 0 {
        return make(a, TVoid)
    }
    // reflect 自动实现方法。
    match reflect_method_return_type(a, method, args.len() as i64, recv_ty) {
        null => {}
        ret_ty => {
            var zi: usize = 0
            while zi < args.len() {
                val _t = infer_expr(ctx, a, s, args[zi], ast, env, null)
                zi = zi + 1
            }
            return ret_ty ?? 0
        },
    }
    // Lib/ForeignFn 结构方法。
    {
        val recv_resolved_l = resolve(a, recv_ty)
        val recv_ct = Arena.get(a, recv_resolved_l)
        var needs_lib_dispatch = false
        match recv_ct {
            TLib(_) => { needs_lib_dispatch = true }
            TForeignFn(_) => {
                if method == "call" {
                    needs_lib_dispatch = true
                }
            },
            _ => {},
        }
        if needs_lib_dispatch {
            var zi: usize = 0
            while zi < args.len() {
                val _t = infer_expr(ctx, a, s, args[zi], ast, env, null)
                zi = zi + 1
            }
            match lib_method_return_type(ctx, a, s, recv_ct, recv_resolved_l, method, args.len() as i64, expected) {
                null => {
                    add_error_at(s,
                        "bad Lib method call '{method}': lookup takes (name: str, args: str); has_symbol takes (name: str); close takes no args",
                        e.span.line, e.span.column)
                    return fresh_type_var(a)
                }
                t => { return t ?? 0 }
            }
        }
    }
    // 回退:接收者已定且非 pending → "方法不存在";pending → 新 var。
    val recv_resolved = resolve(a, recv_ty)
    match Arena.get(a, recv_resolved) {
        TTypeVar(_) => {}
        TUnknown => {}
        TNever => {}
        TVoid => {}
        ct => {
            var recv_name = ty_source_name(ct)
            match Relate.type_name(a, recv_resolved) {
                null => {}
                n => { recv_name = n }
            }
            add_error_at(s, "no method '{method}' on type '{recv_name}'", e.span.line, e.span.column)
        },
    }
    var zi: usize = 0
    while zi < args.len() {
        val _t = infer_expr(ctx, a, s, args[zi], ast, env, null)
        zi = zi + 1
    }
    fresh_type_var(a)
}

// super.method(args):基类型 super → trait 父默认 → 类型声明 trait 绑定层。
fun infer_super_method_call(ctx: ICtx, a: TypeArena, s: SemaRes, expr: i64, ast: AstArena,
    env: u32, expected: u32?, method: str, args: i64[]): u32 {
    val sp = ast.expr(expr).span
    // ── 基类型 super:方法在基上 → 基实现一层 ──
    var type_name2 = ""
    match current_this_type(ctx) {
        null => {}
        this_ty => {
            val r = resolve(a, this_ty ?? 0)
            match Arena.get(a, r) {
                TAdt(_) => { type_name2 = adt_parts(a, r).a }
                _ => {},
            }
        },
    }
    if type_name2.len() > 0 {
        val bases = List.empty<str>()
        match get_type_def(s, type_name2) {
            null => {}
            def => {
                var bi: usize = 0
                while bi < def.bases.len() {
                    bases.push(def.bases[bi])
                    bi = bi + 1
                }
            },
        }
        val hits = List.empty<Sub2>()
        var bi: usize = 0
        while bi < bases.len() {
            match lookup_method_idx(s, bases.get(bi) ?? "", method) {
                null => {}
                mi => { hits.push(Sub2(bases.get(bi) ?? "", mi ?? 0)) }
            }
            bi = bi + 1
        }
        if hits.len() > 1 {
            var names: str[] = []
            var hi: usize = 0
            while hi < hits.len() {
                names = names ++ [(hits.get(hi) ?? Sub2("", 0)).a]
                hi = hi + 1
            }
            add_error_at(s,
                "ambiguous super: method '{method}' exists on multiple bases [{Semares.str_join(names, ", ")}]; disambiguate by overriding and calling the base explicitly",
                sp.line, sp.column)
            return fresh_type_var(a)
        }
        if hits.len() == 1 {
            val hit = hits.get(0) ?? Sub2("", 0)
            var sig_owned: MSig? = null
            match get_type_def(s, hit.a) {
                null => {}
                def => {
                    val target = def ?? TDef("", TAlias, [], [], null, null, [], [])
                    if hit.b >= 0 && (hit.b as usize) < target.methods.len() {
                        sig_owned = if true { target.methods[hit.b as usize] } else { null }
                    }
                },
            }
            match sig_owned {
                null => {}
                sig => {
                    val m = sig ?? MSig("", [], false, false, false, [], null, null, false, null, false)
                    var pt: u32[] = []
                    var pi: usize = 0
                    while pi < m.param_type_reprs.len() {
                        pt = pt ++ [type_repr_to_handle_ctx(ctx, a, s, m.param_type_reprs[pi])]
                        pi = pi + 1
                    }
                    var rt = make(a, TUnknown)
                    match m.return_type_repr {
                        null => {}
                        r0 => {
                            val rr = match r0 {
                                null => { TRNamed("") }
                                v => { v }
                            }
                            rt = type_repr_to_handle_ctx(ctx, a, s, rr)
                        }
                    }
                    val inst_fn = make_fn(a, pt, rt)
                    match Arena.get(a, inst_fn) {
                        TFn(_) => {
                            val f = fn_parts(a, inst_fn)
                            val n = if f.ps.len() < args.len() + 1 { f.ps.len() } else { args.len() + 1 }
                            var k: usize = 1
                            while k < n {
                                val arg_ty = infer_expr(ctx, a, s, args[k - 1], ast, env, f.ps[k])
                                var is_null_lit = false
                                match ast.expr(args[k - 1]).node {
                                    NullLit => { is_null_lit = true }
                                    _ => {},
                                }
                                val asp = ast.expr(args[k - 1]).span
                                unify_call_arg(ctx, a, s, f.ps[k], arg_ty, asp.line, asp.column, is_null_lit)
                                k = k + 1
                            }
                            return f.ret
                        },
                        _ => {},
                    }
                },
            }
        }
    }
    // ── 子 trait 默认内的 super:父 trait 默认 ──
    match ctx.current_trait_name {
        null => {}
        trait_name0 => {
            val trait_name = trait_name0 ?? ""
            val parents = trait_parent_closure(s, trait_name)
            val providers = List.empty<str>()
            var pi2: usize = 0
            while pi2 < parents.len() {
                val p = parents.get(pi2) ?? ""
                var has_default = false
                match get_trait_def(s, p) {
                    null => {}
                    td => {
                        var mi: usize = 0
                        while mi < td.methods.len() && !has_default {
                            val m = td.methods[mi]
                            if m.name == method && m.has_body {
                                has_default = true
                            }
                            mi = mi + 1
                        }
                    },
                }
                if has_default {
                    providers.push(p)
                }
                pi2 = pi2 + 1
            }
            // 后代遮蔽:近父重声明胜出。
            if providers.len() > 1 {
                var winner: i64 = -1
                var i: usize = 0
                while i < providers.len() && winner < 0 {
                    val c = providers.get(i) ?? ""
                    var all_covered = true
                    var k: usize = 0
                    while k < providers.len() && all_covered {
                        val o = providers.get(k) ?? ""
                        if o != c {
                            if !list_has_str(trait_parent_closure(s, c), o) {
                                all_covered = false
                            }
                        }
                        k = k + 1
                    }
                    if all_covered {
                        winner = i as i64
                    }
                    i = i + 1
                }
                if winner >= 0 {
                    providers.set(winner as usize, providers.get(providers.len() - 1) ?? "")
                    while providers.len() > 1 {
                        val dropped = providers.pop()
                    }
                }
            }
            if providers.len() == 0 {
                add_error_at(s,
                    "super: no parent trait of '{trait_name}' provides a default '{method}'",
                    sp.line, sp.column)
                return fresh_type_var(a)
            }
            if providers.len() == 1 {
                val parent = providers.get(0) ?? ""
                var sig: TMS? = null
                match get_trait_def(s, parent) {
                    null => {}
                    td => {
                        var mi: usize = 0
                        while mi < td.methods.len() && sig == null {
                            val m = td.methods[mi]
                            if m.name == method {
                                sig = if true { m } else { null }
                            }
                            mi = mi + 1
                        }
                    },
                }
                match sig {
                    null => {
                        add_error_at(s,
                            "super: parent trait '{parent}' method '{method}' could not be resolved",
                            sp.line, sp.column)
                        return fresh_type_var(a)
                    }
                    sig0 => {
                        val m = sig0 ?? TMS("", 0, 0, false, false)
                        if !m.has_body {
                            add_error_at(s,
                                "super: parent trait '{parent}' method '{method}' has no default body",
                                sp.line, sp.column)
                            return fresh_type_var(a)
                        }
                        return m.return_type
                    },
                }
            }
            var list: str[] = []
            var i: usize = 0
            while i < providers.len() {
                list = list ++ [providers.get(i) ?? ""]
                i = i + 1
            }
            add_error_at(s,
                "ambiguous super: parents of '{trait_name}' [{Semares.str_join(list, ", ")}] all provide a default '{method}'",
                sp.line, sp.column)
            return fresh_type_var(a)
        },
    }
    // ── 类型方法内的 super:绑定 trait 默认层 ──
    val traits = ctx.current_type_decl_traits
    if traits == null {
        add_error_at(s, "super is only valid inside a type method", sp.line, sp.column)
        return fresh_type_var(a)
    }
    var type_name = ""
    match current_this_type(ctx) {
        null => {}
        this_ty => {
            val r = resolve(a, this_ty ?? 0)
            match Arena.get(a, r) {
                TAdt(_) => { type_name = adt_parts(a, r).a }
                _ => {},
            }
        },
    }
    if type_name.len() == 0 {
        add_error_at(s, "super: the enclosing type could not be determined", sp.line, sp.column)
        return fresh_type_var(a)
    }
    val binding = resolve_method_binding(s, traits ?? List.empty<str>(), type_name, method)
    var trait_name3 = ""
    match binding {
        MBBound(t, _) => { trait_name3 = t }
        MBAmbiguous(list) => {
            add_error_at(s,
                "ambiguous super: '{method}' has default implementations from [{Semares.str_join(list, ", ")}]; bind it explicitly on the method ('... = Trait.{method}')",
                sp.line, sp.column)
            return fresh_type_var(a)
        },
        MBUnbound => {
            add_error_at(s,
                "no trait default '{method}' is available via super on type '{type_name}'",
                sp.line, sp.column)
            return fresh_type_var(a)
        },
    }
    // trait 方法签名(位置与形状)。
    var sig: TMS? = null
    match get_trait_def(s, trait_name3) {
        null => {}
        td => {
            var mi: usize = 0
            while mi < td.methods.len() && sig == null {
                val m = td.methods[mi]
                if m.name == method {
                    sig = if true { m } else { null }
                }
                mi = mi + 1
            }
        },
    }
    match sig {
        null => {
            add_error_at(s,
                "super: trait '{trait_name3}' or its method '{method}' could not be resolved",
                sp.line, sp.column)
            return fresh_type_var(a)
        },
        sig0 => {
            val m = sig0 ?? TMS("", 0, 0, false, false)
            if !m.has_body {
                add_error_at(s,
                    "super: trait '{trait_name3}' method '{method}' has no default body to call",
                    sp.line, sp.column)
                return fresh_type_var(a)
            }
            // 可调用类型:params[0] = this;余参新 var。
            var this_ty2 = fresh_type_var(a)
            match current_this_type(ctx) {
                null => {}
                t => { this_ty2 = t ?? 0 }
            }
            var params: u32[] = [this_ty2]
            var k: i64 = 1
            while k < m.param_count {
                params = params ++ [fresh_type_var(a)]
                k = k + 1
            }
            val fn_ty = make_fn(a, params, m.return_type)
            val inst_fn = instantiate_fn_type(a, fn_ty)
            match Arena.get(a, inst_fn) {
                TFn(_) => {
                    val f = fn_parts(a, inst_fn)
                    val n = if f.ps.len() < args.len() + 1 { f.ps.len() } else { args.len() + 1 }
                    var ai: usize = 1
                    while ai < n {
                        val arg_ty = infer_expr(ctx, a, s, args[ai - 1], ast, env, f.ps[ai])
                        var is_null_lit = false
                        match ast.expr(args[ai - 1]).node {
                            NullLit => { is_null_lit = true }
                            _ => {},
                        }
                        val asp = ast.expr(args[ai - 1]).span
                        unify_call_arg(ctx, a, s, f.ps[ai], arg_ty, asp.line, asp.column, is_null_lit)
                        ai = ai + 1
                    }
                    match expected {
                        null => {}
                        exp => { unify_or_constrain(ctx, a, f.ret, exp ?? 0) }
                    }
                    s.super_targets.set("{type_name}" + "\u{0}" + "{trait_name3}" + "\u{0}" + "{method}", true)
                    return f.ret
                },
                _ => { fresh_type_var(a) }
            }
        },
    }
}

pub type Sub2 = Sub2(pub a: str, pub b: i64)

// ─── 方法签名查找(见证表 → TraitObject → 类型方法表)─────────────

// 方法签名恢复(reprs → 句柄;this 由 this 栈解析)。
fun build_fn_type_from_sig(ctx: ICtx, a: TypeArena, s: SemaRes, param_type_reprs: TR[],
    return_type_repr: TR?): u32 {
    var params: u32[] = []
    var pi: usize = 0
    while pi < param_type_reprs.len() {
        params = params ++ [type_repr_to_handle_ctx(ctx, a, s, param_type_reprs[pi])]
        pi = pi + 1
    }
    var rt = fresh_type_var(a)
    match return_type_repr {
        null => {}
        r0 => {
                            val rr = match r0 { null => { TRNamed("") } v => { v } }
                            rt = type_repr_to_handle_ctx(ctx, a, s, rr)
                        }
    }
    make_fn(a, params, rt)
}

// 接收者归一(Nullable 非 is_null 转发内型;Ref 自动解引用)+ 签名
// 模块上下文切换(签名在声明模块解析)。
fun lookup_method_type(ctx: ICtx, a: TypeArena, s: SemaRes, recv_ty: u32, method: str,
    line: i64, column: i64): u32? {
    val resolved = resolve(a, recv_ty)
    match Arena.get(a, resolved) {
        TNullable(_) => {
            if method != "is_null" {
                return lookup_method_type(ctx, a, s, nullable_inner(a, resolved), method, line, column)
            }
        },
        TRef(_) => {
            return lookup_method_type(ctx, a, s, ref_parts(a, resolved).a, method, line, column)
        },
        _ => {},
    }
    // 签名模块:接收者类型定义首个 ctor 的 def_module。
    var sig_module: str? = null
    match Relate.type_name(a, resolved) {
        null => {}
        tn => {
            var def: TDef? = null
            if Str.contains(tn ?? "", ".") {
                def = get_type_def(s, tn ?? "")
            } else {
                match type_def_idx(s, tn ?? "") {
                    null => {}
                    idx => { def = s.type_defs.get((idx ?? 0) as usize) }
                }
            }
            match def {
                null => {}
                d => {
                    if d.constructors.len() > 0 {
                        sig_module = if true { d.constructors[0].def_module } else { null }
                    }
                },
            }
        },
    }
    val saved_module_ctx = s.current_module_name
    match sig_module {
        null => {}
        m => { s.current_module_name = m ?? "" }
    }
    val result = lookup_method_type_impl(ctx, a, s, resolved, method, line, column)
    s.current_module_name = saved_module_ctx
    result
}

fun lookup_method_type_impl(ctx: ICtx, a: TypeArena, s: SemaRes, resolved: u32, method: str,
    line: i64, column: i64): u32? {
    // 隐私门:报错但继续解析签名。
    match Relate.type_name(a, resolved) {
        null => {}
        tn => {
            match method_privacy_error(ctx, s, tn ?? "", method) {
                null => {}
                msg => { add_error_at(s, msg ?? "", line, column) }
            }
        },
    }
    push_this_type(ctx, resolved)
    // 泛型绑定:类型定义形参 ← 接收者实参。
    var pushed_bindings = false
    var bind_name = ""
    var bind_args: u32[] = []
    match Arena.get(a, resolved) {
        TAdt(_) => {
            val p = adt_parts(a, resolved)
            bind_name = p.a
            bind_args = p.b
        },
        TArray(_) => {
            bind_name = "array"
            bind_args = [array_parts(a, resolved).a]
        },
        TNullable(_) => {
            bind_name = "nullable"
            bind_args = [nullable_inner(a, resolved)]
        },
        TThrow(_) => {
            val p = thr_parts(a, resolved)
            bind_name = "Throw"
            bind_args = [p.a, p.b]
        },
        TChannel(_) => {
            bind_name = "Channel"
            bind_args = [channel_elem(a, resolved)]
        },
        TAsync(_) => {
            bind_name = "Async"
            bind_args = [async_value(a, resolved)]
        },
        TLazy(_) => {
            bind_name = "Lazy"
            bind_args = [lazy_value(a, resolved)]
        },
        TAtomic(_) => {
            bind_name = "Atomic"
            bind_args = [atomic_elem(a, resolved)]
        },
        TSender(_) => {
            bind_name = "Sender"
            bind_args = [sender_elem(a, resolved)]
        },
        TReceiver(_) => {
            bind_name = "Receiver"
            bind_args = [receiver_elem(a, resolved)]
        },
        TGeneric(_) => {
            val p = generic_parts(a, resolved)
            bind_name = p.a
            bind_args = p.b
        },
        _ => {},
    }
    if bind_name.len() > 0 {
        match get_type_def(s, bind_name) {
            null => {}
            def => {
                val target = def ?? TDef("", TAlias, [], [], null, null, [], [])
                if target.type_params.len() > 0 && target.type_params.len() == bind_args.len() {
                    push_frame(ctx)
                    var i: usize = 0
                    while i < target.type_params.len() {
                        insert_top(ctx, target.type_params[i], bind_args[i])
                        i = i + 1
                    }
                    pushed_bindings = true
                }
            },
        }
    }
    val result = lookup_method_type_inner(ctx, a, s, resolved, method)
    if pushed_bindings {
        pop_frame(ctx)
    }
    pop_this_type(ctx)
    result
}

fun lookup_method_type_inner(ctx: ICtx, a: TypeArena, s: SemaRes, resolved: u32,
    method: str): u32? {
    match Arena.get(a, resolved) {
        TTrait(_) => {
            // trait 类型接收者:trait_def.methods 恢复签名(余参新 var)。
            val name = trait_parts(a, resolved).a
            match get_trait_def(s, name) {
                null => {}
                td => {
                    var mi: usize = 0
                    while mi < td.methods.len() {
                        val sig = td.methods[mi]
                        if sig.name == method {
                            var params: u32[] = [resolved]
                            var k: i64 = 1
                            while k < sig.param_count {
                                params = params ++ [fresh_type_var(a)]
                                k = k + 1
                            }
                            return make_fn(a, params, sig.return_type)
                        }
                        mi = mi + 1
                    }
                },
            }
        },
        TTypeVar(idx) => {
            // trait 默认方法内的刚性 Self:查当前 trait 方法面。
            if tvar_is_rigid(a, idx) {
                match ctx.current_trait_name {
                    null => {}
                    trait_name0 => {
                        val trait_name = trait_name0 ?? ""
                        var sig: TMS? = null
                        match get_trait_def(s, trait_name) {
                            null => {}
                            td => {
                                var mi: usize = 0
                                while mi < td.methods.len() && sig == null {
                                    if td.methods[mi].name == method {
                                        sig = if true { td.methods[mi] } else { null }
                                    }
                                    mi = mi + 1
                                }
                            },
                        }
                        if sig == null {
                            val eff = trait_effective_methods(s, trait_name)
                            var ei: usize = 0
                            while ei < eff.len() && sig == null {
                                val pair = eff.get(ei) ?? ET("", TMS("", 0, 0, false, false))
                                if pair.m.name == method {
                                    sig = if true { pair.m } else { null }
                                }
                                ei = ei + 1
                            }
                        }
                        match sig {
                            null => {}
                            sig0 => {
                                val m = sig0 ?? TMS("", 0, 0, false, false)
                                var params: u32[] = [resolved]
                                var k: i64 = 1
                                while k < m.param_count {
                                    params = params ++ [fresh_type_var(a)]
                                    k = k + 1
                                }
                                return make_fn(a, params, m.return_type)
                            },
                        }
                    },
                }
            }
        },
        _ => {},
    }
    // 统一类型名(Array/Str/Nullable/Throw 映射合成名)。
    var type_name: str? = null
    match Arena.get(a, resolved) {
        TArray(_) => { type_name = if true { "array" } else { null } }
        TStr => { type_name = if true { "str" } else { null } }
        TNullable(_) => { type_name = if true { "nullable" } else { null } }
        TThrow(_) => { type_name = if true { "Throw" } else { null } }
        _ => { type_name = Relate.type_name(a, resolved) }
    }
    // Path 1:见证表(trait 方法分派)。
    match type_name {
        null => {}
        name => {
            match type_def_idx(s, name ?? "") {
                null => {}
                idx => {
                    val tid = dynamic_type_id(idx ?? 0)
                    var wi: usize = 0
                    var done = false
                    while wi < s.witness_entries.len() && !done {
                        val ent = s.witness_entries.get(wi) ?? WEnt("", 0, Map.empty<str, i64>(), "")
                        if ent.type_id == tid {
                            // 类型方法表优先。
                            match get_type_def(s, name ?? "") {
                                null => {}
                                def => {
                                    val target = def ?? TDef("", TAlias, [], [], null, null, [], [])
                                    var mi: usize = 0
                                    while mi < target.methods.len() && !done {
                                        if target.methods[mi].name == method {
                                            return build_fn_type_from_sig(ctx, a, s,
                                                target.methods[mi].param_type_reprs,
                                                target.methods[mi].return_type_repr)
                                        }
                                        mi = mi + 1
                                    }
                                },
                            }
                            // trait 默认方法签名。
                            match get_trait_def(s, ent.trait_name) {
                                null => {}
                                td => {
                                    var mi: usize = 0
                                    while mi < td.methods.len() && !done {
                                        val sig = td.methods[mi]
                                        if sig.name == method {
                                            var params: u32[] = [resolved]
                                            var k: i64 = 1
                                            while k < sig.param_count {
                                                params = params ++ [fresh_type_var(a)]
                                                k = k + 1
                                            }
                                            done = true
                                            return make_fn(a, params, sig.return_type)
                                        }
                                        mi = mi + 1
                                    }
                                },
                            }
                        }
                        wi = wi + 1
                    }
                },
            }
        },
    }
    // Path 1.5:TraitObject 接收者。
    match Arena.get(a, resolved) {
        TTraitObject(_) => {
            val p = trait_object_parts(a, resolved)
            var mi: usize = 0
            while mi < p.b.len() {
                val sig = p.b[mi]
                if sig.name == method {
                    var params: u32[] = [resolved]
                    var k: i64 = 1
                    while k < sig.param_count {
                        params = params ++ [fresh_type_var(a)]
                        k = k + 1
                    }
                    return make_fn(a, params, sig.return_type)
                }
                mi = mi + 1
            }
        },
        _ => {},
    }
    // Path 2:类型自身方法表。
    match type_name {
        null => {}
        name => {
            match get_type_def(s, name ?? "") {
                null => {}
                def => {
                    val target = def ?? TDef("", TAlias, [], [], null, null, [], [])
                    var mi: usize = 0
                    while mi < target.methods.len() {
                        if target.methods[mi].name == method {
                            return build_fn_type_from_sig(ctx, a, s,
                                target.methods[mi].param_type_reprs,
                                target.methods[mi].return_type_repr)
                        }
                        mi = mi + 1
                    }
                },
            }
        },
    }
    null
}

// 隐式 this 字段解析(方法体内裸字段名)。
fun try_implicit_this_field(ctx: ICtx, a: TypeArena, s: SemaRes, this_ty: u32, name: str): u32? {
    val resolved = resolve(a, this_ty)
    var inner = resolved
    match Arena.get(a, resolved) {
        TRef(_) => { inner = ref_parts(a, resolved).a }
        _ => {},
    }
    // trait 默认方法内刚性 Self:宽容新 var。
    match Arena.get(a, inner) {
        TTypeVar(_) => { return fresh_type_var(a) }
        _ => {},
    }
    match Relate.type_name(a, inner) {
        null => { null }
        type_name0 => {
            val type_name = type_name0 ?? ""
            match lookup_field_id(s, type_name, name) {
                null => { null }
                field_id => {
                    match get_type_def(s, type_name) {
                        null => { null }
                        def => {
                            val target = def ?? TDef("", TAlias, [], [], null, null, [], [])
                            var idx = field_id ?? 0
                            if target.kind != Data.TRecord {
                                if (field_id ?? 0) > 0 {
                                    idx = (field_id ?? 0) - 1
                                } else {
                                    idx = 0
                                }
                            }
                            var ci: usize = 0
                            while ci < target.constructors.len() {
                                val ctor = target.constructors[ci]
                                var fi: usize = 0
                                while fi < ctor.field_names.len() {
                                    match ctor.field_names[fi] {
                                        null => {}
                                        fname => {
                                            if fname == name {
                                                if idx >= 0 && (idx as usize) < ctor.field_type_reprs.len() {
                                                    return type_repr_to_handle_ctx(ctx, a, s, ctor.field_type_reprs[idx as usize])
                                                }
                                                return null
                                            }
                                        },
                                    }
                                    fi = fi + 1
                                }
                                ci = ci + 1
                            }
                            null
                        },
                    }
                },
            }
        },
    }
}

// 字段类型查找(Ref 解引用 → ModuleRef 模块 env → 命名类型 ctor reprs →
// record 字段 → Channel sender/receiver → 诊断回退)。
fun lookup_field_type(ctx: ICtx, a: TypeArena, s: SemaRes, recv_ty: u32, field: str,
    line: i64, column: i64): u32 {
    val resolved = resolve(a, recv_ty)
    match Arena.get(a, resolved) {
        TRef(_) => {
            return lookup_field_type(ctx, a, s, ref_parts(a, resolved).a, field, line, column)
        },
        TModuleRef(_) => {
            val p = module_ref_parts(a, resolved)
            match lookup_local(s.env, p.b, field) {
                null => {}
                sym_ty => { return sym_ty ?? 0 }
            }
            add_error_at(s, "no module or symbol '{p.a}.{field}'", line, column)
            return make(a, TUnknown)
        },
        _ => {},
    }
    match Relate.type_name(a, resolved) {
        null => {}
        name0 => {
            val name = name0 ?? ""
            match lookup_field_id(s, name, field) {
                null => {}
                field_id0 => {
                    val field_id = field_id0 ?? 0
                    match field_privacy_error(ctx, s, name, field) {
                        null => {}
                        msg => { add_error_at(s, msg ?? "", line, column) }
                    }
                    match get_type_def(s, name) {
                        null => {}
                        def => {
                            val target = def ?? TDef("", TAlias, [], [], null, null, [], [])
                            var idx = field_id
                            if target.kind != Data.TRecord {
                                if field_id > 0 {
                                    idx = field_id - 1
                                } else {
                                    idx = 0
                                }
                            }
                            var ci: usize = 0
                            while ci < target.constructors.len() {
                                val ctor = target.constructors[ci]
                                var fi: usize = 0
                                while fi < ctor.field_names.len() {
                                    match ctor.field_names[fi] {
                                        null => {}
                                        fname => {
                                            if fname == field {
                                                if idx >= 0 && (idx as usize) < ctor.field_type_reprs.len() {
                                                    return type_repr_to_handle_ctx(ctx, a, s, ctor.field_type_reprs[idx as usize])
                                                }
                                                return fresh_type_var(a)
                                            }
                                        },
                                    }
                                    fi = fi + 1
                                }
                                ci = ci + 1
                            }
                            return fresh_type_var(a)
                        },
                    }
                },
            }
        },
    }
    // record 结构字段。
    val ct = Arena.get(a, resolved)
    match ct {
        TRecord(_) => {
            val fs = record_fields(a, resolved)
            var i: usize = 0
            while i < fs.len() {
                match fs[i].name {
                    null => {}
                    n => {
                        if n == field {
                            return fs[i].ty
                        }
                    },
                }
                i = i + 1
            }
        },
        TChannel(_) => {
            val elem = channel_elem(a, resolved)
            if field == "sender" {
                return make_sender(a, elem)
            }
            if field == "receiver" {
                return make_receiver(a, elem)
            }
        },
        _ => {},
    }
    // 未命中诊断(record 报字段;注册 Adt 报字段;pending 静默)。
    match ct {
        TRecord(_) => {
            add_error_at(s, "no such field '{field}' on this type", line, column)
            fresh_type_var(a)
        },
        TAdt(_) => {
            val name = adt_parts(a, resolved).a
            if get_type_def(s, name) != null {
                add_error_at(s, "no such field '{field}' on type '{name}'", line, column)
            }
            fresh_type_var(a)
        },
        TTypeVar(_) => { fresh_type_var(a) }
        TUnknown => { fresh_type_var(a) }
        TNever => { fresh_type_var(a) }
        TVoid => { fresh_type_var(a) }
        _ => {
            var recv_name = ty_source_name(ct)
            match Relate.type_name(a, resolved) {
                null => {}
                n => { recv_name = n }
            }
            add_error_at(s, "no such field '{field}' on type '{recv_name}'", line, column)
            fresh_type_var(a)
        },
    }
}

// ─── this 参数 ────────────────────────────────────────────────────

// 引擎口径:ThisType 或 RefType<ThisType>。
fun is_this_param_full(ta: i64?, ast: AstArena): bool {
    match ta {
        null => { false }
        tr => {
            match ast.ty(tr ?? 0).node {
                TThis => { true }
                TRef(inner) => {
                    match ast.ty(inner).node {
                        TThis => { true }
                        _ => { false }
                    }
                },
                _ => { false }
            }
        },
    }
}

// this 参数类型:ThisType → 域类型;RefType<ThisType> → Ref<域类型>;
// 显式注解 → 报错 + 新 var。
fun infer_this_param(ctx: ICtx, a: TypeArena, s: SemaRes, ta: i64?, ast: AstArena): u32 {
    val this_ty = current_this_type(ctx)
    if this_ty == null {
        var line: i64 = 0
        var column: i64 = 0
        match ta {
            null => {}
            tr => {
                line = ast.ty(tr ?? 0).span.line
                column = ast.ty(tr ?? 0).span.column
            },
        }
        add_error_at(s, "this parameter requires enclosing type or trait block", line, column)
        return fresh_type_var(a)
    }
    match ta {
        null => { this_ty ?? 0 }
        tr => {
            val st = ast.ty(tr ?? 0)
            match st.node {
                TThis => { this_ty ?? 0 }
                TRef(inner) => {
                    match ast.ty(inner).node {
                        TThis => { make_ref(a, this_ty ?? 0, false) }
                        _ => {
                            add_error_at(s, "this parameter does not allow explicit type annotation",
                                st.span.line, st.span.column)
                            fresh_type_var(a)
                        },
                    }
                },
                _ => {
                    add_error_at(s, "this parameter does not allow explicit type annotation",
                        st.span.line, st.span.column)
                    fresh_type_var(a)
                },
            }
        },
    }
}

// ─── check_decl:声明体检查(ModuleEnv.rs check_decl)──────────────

// async 返回包装(与 Modenv 同义;局部复用避免依赖)。
fun wrap_async_return_l(a: TypeArena, ret_ty: u32, is_async: bool): u32 {
    if !is_async {
        return ret_ty
    }
    val resolved = resolve(a, ret_ty)
    match Arena.get(a, resolved) {
        TAsync(_) => { ret_ty }
        _ => { make_async(a, ret_ty) }
    }
}

pub fun check_decl(ctx: ICtx, a: TypeArena, s: SemaRes, decl: Decl, decl_span: Span,
    ast: AstArena, env: u32): void {
    match decl {
        FunDeclD(_, name, type_params, params, return_type, body, is_async, _, attributes, extern_c) => {
            // FFI 权限:builtin 模块专属。
            val is_builtin = Str.starts_with(ctx.current_module_name, "builtin/")
            val is_stdlib = is_builtin || Str.starts_with(ctx.current_module_name, "std/")
            if !is_builtin {
                var ai: usize = 0
                while ai < attributes.len() {
                    val attr = attributes[ai]
                    if attr.name == "internal" && !is_stdlib {
                        add_error_at(s,
                            "attribute '@internal' is reserved for the standard library implementation",
                            decl_span.line, decl_span.column)
                    }
                    if attr.name == "extern" || attr.name == "c_include" {
                        add_error_at(s,
                            "attribute '@{attr.name}' is only allowed in builtin (stdlib) modules",
                            decl_span.line, decl_span.column)
                    }
                    ai = ai + 1
                }
                if extern_c != null {
                    add_error_at(s,
                        "inline C body (#\{ \}#) is only allowed in builtin (stdlib) modules",
                        decl_span.line, decl_span.column)
                }
            }
            // 顶层函数禁 this 参数。
            if params.len() > 0 && is_this_param_full(params[0].ta, ast) {
                add_error_at(s, "this parameter is not allowed in top-level function",
                    decl_span.line, decl_span.column)
            }
            val fn_env = Envs.child(s.env, env)
            if type_params.len() > 0 {
                push_type_bindings(ctx, a, type_params)
            }
            // @extern("C"):只注册签名。
            if extern_c != null {
                if type_params.len() > 0 {
                    pop_frame(ctx)
                }
                return
            }
            var param_types: u32[] = []
            var pi: usize = 0
            while pi < params.len() {
                var param_ty = fresh_type_var(a)
                match params[pi].ta {
                    null => {}
                    ta => { param_ty = type_from_ast(ctx, a, s, ta, ast) }
                }
                define(s.env, fn_env, params[pi].name, param_ty)
                param_types = param_types ++ [param_ty]
                pi = pi + 1
            }
            var ret_ty_raw = fresh_type_var(a)
            match return_type {
                null => {}
                rt => { ret_ty_raw = type_from_ast(ctx, a, s, rt, ast) }
            }
            val ret_ty = wrap_async_return_l(a, ret_ty_raw, is_async)
            val fn_ty = make_fn(a, param_types, ret_ty)
            define(s.env, fn_env, name, fn_ty)
            define(s.env, env, name, fn_ty)
            val prev_return = ctx.expected_return
            ctx.expected_return = ret_ty
            val body_ty = infer_expr(ctx, a, s, body, ast, fn_env, ctx.expected_return)
            ctx.expected_return = prev_return
            if return_type == null {
                unify_or_constrain(ctx, a, ret_ty, body_ty)
            } else {
                if !unify_return_type(ctx, a, s, ret_ty, body_ty, decl_span.line, decl_span.column) {
                    solver_add_equality(ctx, ret_ty, body_ty)
                }
            }
            if return_type != null {
                check_missing_return_value(ctx, a, s, "function '{name}'", ret_ty, body, ast, decl_span.line, decl_span.column)
                check_throw_tail_wrapped(ctx, a, s, "function '{name}'", ret_ty, body, body_ty, ast, decl_span.line, decl_span.column)
            }
            if type_params.len() > 0 {
                pop_frame(ctx)
            }
        },
        ExprDeclD(expr, stmt) => {
            match stmt {
                null => {
                    val _t = infer_expr(ctx, a, s, expr, ast, env, null)
                }
                st => {
                    val _t = infer_stmt(ctx, a, s, st ?? 0, ast, env)
                },
            }
        },
        TypeDeclD(_, name, type_params, base_types, implemented_traits, def, methods) => {
            // 嵌套类型注册 + 方法表。
            ast_type_decl_to_type_def(a, s, name, type_params, base_types, def, ast, decl_span, s.current_module_name)
            var mi: usize = 0
            while mi < methods.len() {
                ast_method_to_func_sig(a, s, name, methods[mi], ast)
                mi = mi + 1
            }
            if type_params.len() > 0 {
                push_type_bindings(ctx, a, type_params)
            }
            val canonical = resolve_type_key(s, name)
            var self_ty: u32 = 0
            if type_params.len() == 0 {
                self_ty = make_adt(a, canonical, [])
            } else {
                var type_args: u32[] = []
                var ti: usize = 0
                while ti < type_params.len() {
                    match lookup_type_binding(ctx, type_params[ti].name) {
                        null => { type_args = type_args ++ [fresh_type_var(a)] }
                        h => { type_args = type_args ++ [h ?? 0] }
                    }
                    ti = ti + 1
                }
                self_ty = make_adt(a, canonical, type_args)
            }
            // 构造器 env 注册(继承合并视图)。
            var merged_reprs = List.empty<TR>()
            if base_types.len() > 0 {
                match get_type_def(s, name) {
                    null => {}
                    d => {
                        val target = d ?? TDef("", TAlias, [], [], null, null, [], [])
                        if target.constructors.len() > 0 {
                            var fi: usize = 0
                            while fi < target.constructors[0].field_type_reprs.len() {
                                merged_reprs.push(target.constructors[0].field_type_reprs[fi])
                                fi = fi + 1
                            }
                        }
                    },
                }
            }
            match def {
                RecordD(fields) => {
                    var param_types: u32[] = []
                    var fi: usize = 0
                    while fi < fields.len() {
                        param_types = param_types ++ [type_from_ast(ctx, a, s, fields[fi].ty, ast)]
                        fi = fi + 1
                    }
                    val fn_ty = make_fn(a, param_types, self_ty)
                    define(s.env, env, name, fn_ty)
                },
                AdtD(constructors) => {
                    var ci: usize = 0
                    while ci < constructors.len() {
                        val ctor = constructors[ci]
                        var ctor_fn_ty: u32 = 0
                        if merged_reprs.len() > 0 {
                            val child_adt = make_adt(a, canonical, [])
                            var param_types: u32[] = []
                            var ri: usize = 0
                            while ri < merged_reprs.len() {
                                param_types = param_types ++ [type_repr_to_handle_ctx(ctx, a, s, merged_reprs.get(ri) ?? TRNamed(""))]
                                ri = ri + 1
                            }
                            if param_types.len() == 0 {
                                ctor_fn_ty = child_adt
                            } else {
                                ctor_fn_ty = make_fn(a, param_types, child_adt)
                            }
                        } else {
                            var param_types: u32[] = []
                            var fi: usize = 0
                            while fi < ctor.fields.len() {
                                param_types = param_types ++ [type_from_ast(ctx, a, s, ctor.fields[fi].ty, ast)]
                                fi = fi + 1
                            }
                            if param_types.len() == 0 {
                                ctor_fn_ty = self_ty
                            } else {
                                ctor_fn_ty = make_fn(a, param_types, self_ty)
                            }
                        }
                        define(s.env, env, ctor.name, ctor_fn_ty)
                        ci = ci + 1
                    }
                },
                _ => {},
            }
            // 方法体检查:this 绑定 + trait 闭包暴露 + 先注册后检查。
            push_this_type(ctx, self_ty)
            {
                val ts = List.empty<str>()
                var ti: usize = 0
                while ti < implemented_traits.len() {
                    val tkey = resolve_trait_key(s, implemented_traits[ti].trait_name)
                    if !list_has_str(ts, tkey) {
                        ts.push(tkey)
                    }
                    ti = ti + 1
                }
                var bi: usize = 0
                while bi < ts.len() {
                    val t = ts.get(bi) ?? ""
                    val closure = trait_parent_closure(s, t)
                    var ci: usize = 0
                    while ci < closure.len() {
                        val pt = closure.get(ci) ?? ""
                        if !list_has_str(ts, pt) {
                            ts.push(pt)
                        }
                        ci = ci + 1
                    }
                    bi = bi + 1
                }
                ctx.current_type_decl_traits = ts
            }
            // 先把方法注册为 env 函数(支持裸名调用 + 前向引用)。
            mi = 0
            while mi < methods.len() {
                val m = methods[mi]
                var m_param_types: u32[] = []
                var pi: usize = 0
                while pi < m.params.len() {
                    if pi == 0 && is_this_param_full(m.params[0].ta, ast) {
                        m_param_types = m_param_types ++ [self_ty]
                    } else {
                        var param_ty = fresh_type_var(a)
                        match m.params[pi].ta {
                            null => {}
                            ta => { param_ty = type_from_ast(ctx, a, s, ta, ast) }
                        }
                        m_param_types = m_param_types ++ [param_ty]
                    }
                    pi = pi + 1
                }
                var m_ret_raw = fresh_type_var(a)
                match m.rt {
                    null => {}
                    rt => { m_ret_raw = type_from_ast(ctx, a, s, rt, ast) }
                }
                val m_ret_ty = wrap_async_return_l(a, m_ret_raw, m.is_async)
                val m_fn_ty = make_fn(a, m_param_types, m_ret_ty)
                define(s.env, env, m.name, m_fn_ty)
                mi = mi + 1
            }
            // 方法体检查。
            mi = 0
            while mi < methods.len() {
                val m = methods[mi]
                match m.body {
                    null => {}
                    body => {
                        val method_env = Envs.child(s.env, env)
                        var pi: usize = 0
                        while pi < m.params.len() {
                            var param_ty = fresh_type_var(a)
                            if is_this_param_full(m.params[pi].ta, ast) {
                                param_ty = infer_this_param(ctx, a, s, m.params[pi].ta, ast)
                            } else {
                                match m.params[pi].ta {
                                    null => {}
                                    ta => { param_ty = type_from_ast(ctx, a, s, ta, ast) }
                                }
                            }
                            define(s.env, method_env, m.params[pi].name, param_ty)
                            pi = pi + 1
                        }
                        val prev_return = ctx.expected_return
                        var ret_ty: u32? = null
                        match m.rt {
                            null => {}
                            rt => {
                                ret_ty = if true { wrap_async_return_l(a, type_from_ast(ctx, a, s, rt, ast), m.is_async) } else { null }
                            },
                        }
                        ctx.expected_return = ret_ty
                        val body_ty = infer_expr(ctx, a, s, body ?? 0, ast, method_env, ret_ty)
                        ctx.expected_return = prev_return
                        match ret_ty {
                            null => {}
                            r => {
                                check_missing_return_value(ctx, a, s, "method '{m.name}'", r ?? 0, body ?? 0, ast, decl_span.line, decl_span.column)
                            },
                        }
                        var ret_fallback = fresh_type_var(a)
                        if ret_ty != null {
                            ret_fallback = ret_ty ?? 0
                        }
                        if m.rt == null {
                            unify_or_constrain(ctx, a, ret_fallback, body_ty)
                        } else {
                            if !unify_return_type(ctx, a, s, ret_fallback, body_ty, decl_span.line, decl_span.column) {
                                solver_add_equality(ctx, ret_fallback, body_ty)
                            }
                        }
                        match ret_ty {
                            null => {}
                            r => {
                                check_throw_tail_wrapped(ctx, a, s, "method '{m.name}'", r ?? 0, body ?? 0, body_ty, ast, decl_span.line, decl_span.column)
                            },
                        }
                    },
                }
                mi = mi + 1
            }
            ctx.current_type_decl_traits = null
            pop_this_type(ctx)
            if type_params.len() > 0 {
                pop_frame(ctx)
            }
        },
        TraitDeclD(_, name, type_params, parents, _, methods) => {
            ast_trait_decl_to_trait_def(a, s, name, parents, methods, ast, s.current_module_name)
            if type_params.len() > 0 {
                push_type_bindings(ctx, a, type_params)
            }
            // Self = 新刚性 var(实现期由 unify 求解)。
            val self_var = fresh_rigid_var(a)
            push_this_type(ctx, self_var)
            ctx.current_trait_name = resolve_trait_key(s, name)
            var mi: usize = 0
            while mi < methods.len() {
                val m = methods[mi]
                match m.body {
                    null => {}
                    body => {
                        val method_env = Envs.child(s.env, env)
                        var pi: usize = 0
                        while pi < m.params.len() {
                            var param_ty = fresh_type_var(a)
                            if is_this_param_full(m.params[pi].ta, ast) {
                                param_ty = infer_this_param(ctx, a, s, m.params[pi].ta, ast)
                            } else {
                                match m.params[pi].ta {
                                    null => {}
                                    ta => { param_ty = type_from_ast(ctx, a, s, ta, ast) }
                                }
                            }
                            define(s.env, method_env, m.params[pi].name, param_ty)
                            pi = pi + 1
                        }
                        val prev_return = ctx.expected_return
                        var ret_ty: u32? = null
                        match m.rt {
                            null => {}
                            rt => {
                                ret_ty = if true { wrap_async_return_l(a, type_from_ast(ctx, a, s, rt, ast), m.is_async) } else { null }
                            },
                        }
                        ctx.expected_return = ret_ty
                        val body_ty = infer_expr(ctx, a, s, body ?? 0, ast, method_env, ret_ty)
                        ctx.expected_return = prev_return
                        match ret_ty {
                            null => {}
                            r => {
                                check_missing_return_value(ctx, a, s, "method '{m.name}'", r ?? 0, body ?? 0, ast, decl_span.line, decl_span.column)
                            },
                        }
                        var ret_fallback = fresh_type_var(a)
                        if ret_ty != null {
                            ret_fallback = ret_ty ?? 0
                        }
                        if m.rt == null {
                            unify_or_constrain(ctx, a, ret_fallback, body_ty)
                        } else {
                            if !unify_return_type(ctx, a, s, ret_fallback, body_ty, decl_span.line, decl_span.column) {
                                solver_add_equality(ctx, ret_fallback, body_ty)
                            }
                        }
                        match ret_ty {
                            null => {}
                            r => {
                                check_throw_tail_wrapped(ctx, a, s, "method '{m.name}'", r ?? 0, body ?? 0, body_ty, ast, decl_span.line, decl_span.column)
                            },
                        }
                    },
                }
                mi = mi + 1
            }
            pop_this_type(ctx)
            ctx.current_trait_name = null
            if type_params.len() > 0 {
                pop_frame(ctx)
            }
        },
        _ => {},
    }
}
