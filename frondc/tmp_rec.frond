// 临时探针:数组字面量/fill/索引/len + str 字面量/相等/len(用毕即删)。
type Box = (v: i64, tag: str)

fun main(): i64 {
    val a = [10, 20, 30]
    val b = [7 as i64, ..4]
    var s = 0 as i64
    var i = 0 as usize
    while i < a.len() {
        s = s + a[i]
        i = i + 1
    }
    b[2] = 100
    s = s + b[2]
    val t = "héllo"
    if t == "héllo" && t.len() == 5 {
        s = s + 1
    }
    val bx = Box(9, "nine")
    bx.v = 42
    s = s + bx.v + bx.tag.len()
    println("s={s}")
    s
}
