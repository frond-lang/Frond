// Info.frond — host identification
//
// Sync API. All values are derived from compile-time platform macros or
// cheap host calls, so they are safe to call anywhere.
import std.io.Path

// Host operating system name: "windows" / "macos" / "linux" / "unknown".
pub fun os_name(): str {
    val buf: u8[] = [0, ..32]
    val n = __os_platform_into(buf)
    if n <= 0 { return "unknown" }
    (buf[0..n as usize]) as str
}

// Host CPU architecture: "x86_64" / "aarch64" / "x86" / "arm" / "unknown".
pub fun arch(): str {
    val buf: u8[] = [0, ..32]
    val n = __os_arch_into(buf)
    if n <= 0 { return "unknown" }
    (buf[0..n as usize]) as str
}

// Host machine name (computer name). Empty string on failure.
pub fun hostname(): str {
    val buf: u8[] = [0, ..256]
    val n = __os_hostname_into(buf)
    if n <= 0 { return "" }
    (buf[0..n as usize]) as str
}

// Native path-component separator: "\\" on Windows, "/" elsewhere.
pub fun path_sep(): str {
    if os_name() == "windows" { "\\" } else { "/" }
}

// Native line separator: "\r\n" on Windows, "\n" elsewhere.
pub fun line_sep(): str {
    if os_name() == "windows" { "\r\n" } else { "\n" }
}

// Temporary directory (TMP/TEMP on Windows, TMPDIR on POSIX, "/tmp" fallback).
// Returns a Path; use .to_str() for the raw string. "" (relative empty path)
// only in pathological host states.
pub fun tmp_dir(): Path {
    val buf: u8[] = [0, ..4096]
    val n = __os_tmp_dir_into(buf)
    if n <= 0 { return Path.from("") }
    Path.from((buf[0..n as usize]) as str)
}

// User home directory (USERPROFILE on Windows, HOME on POSIX) as a Path.
pub fun home_dir(): Throw<Path, OsError> {
    val buf: u8[] = [0, ..4096]
    val n = __os_home_dir_into(buf)
    if n < 0 {
        throw OsError(NotFound, "home directory is not set on this host", 0)
    }
    Ok(Path.from((buf[0..n as usize]) as str))
}

// Current user's login name (USERNAME on Windows, USER/LOGNAME on POSIX).
pub fun user_name(): Throw<str, OsError> {
    val buf: u8[] = [0, ..4096]
    val n = __os_user_name_into(buf)
    if n < 0 {
        throw OsError(NotFound, "user name is not set on this host", 0)
    }
    Ok((buf[0..n as usize]) as str)
}

// ─── Host resources ───────────────────────────────────────────────

// Number of logical processors available to the process. 0 = unknown
// (host reported nothing usable); never negative.
pub fun cpu_count(): i64 {
    val n = __os_cpu_count()
    if n < 0 { return 0 }
    n
}

// Read LE u64 from the disk-space buffer (local twin of File.__read_u64_le —
// @internal helpers are not shared across packs).
@internal
fun __read_u64_at(buf: u8[], offset: usize): u64 {
    ((buf[offset]) as u64)
        | (((buf[offset + 1]) as u64) << 8)
        | (((buf[offset + 2]) as u64) << 16)
        | (((buf[offset + 3]) as u64) << 24)
        | (((buf[offset + 4]) as u64) << 32)
        | (((buf[offset + 5]) as u64) << 40)
        | (((buf[offset + 6]) as u64) << 48)
        | (((buf[offset + 7]) as u64) << 56)
}

// Query one filesystem field via __os_disk_space_into.
// 0 = free bytes, 8 = total bytes (buffer offsets).
@internal
fun __disk_field(path: Path, offset: usize): Throw<u64, OsError> {
    val buf: u8[] = [0, ..16]
    val rc = __os_disk_space_into(path.to_str(), buf)
    if rc < 0 {
        throw OsError(NotFound, "disk space query failed for " + path.to_str(), 0)
    }
    Ok(__read_u64_at(buf, offset))
}

// Free space (bytes) on the filesystem containing `path`, as available to
// the calling user (quota-aware). Any path on the volume works.
pub fun disk_free(path: Path): Throw<u64, OsError> {
    __disk_field(path, 0)
}

// Total capacity (bytes) of the filesystem containing `path`.
pub fun disk_total(path: Path): Throw<u64, OsError> {
    __disk_field(path, 8)
}
