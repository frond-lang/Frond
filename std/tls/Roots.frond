// Roots.frond — built-in trust anchors for std.tls chain verification.
//
// Anchor: the USERTrust ECC Certification Authority — the actual ROOT
// above the Sectigo E36 intermediate that signs github.com leaves
// (root expires 2038-01-18). Verification covers BOTH edges with the
// dual-algorithm verifier: leaf<-E36 (ecdsa-with-SHA256, P-256) and
// E36<-root (ecdsa-with-SHA384, P-384). Anchoring at a real root means
// intermediate rotations by the CA no longer break verification.
//
// Callers can always pass their own anchors to Tls13.connect_verified.
import std.encoding.Hex

fun hex_der(hex: str): u8[] {
    match Hex.decode(hex) {
        null => [],
        b => b,
    }
}

// Sectigo Public Server Authentication CA DV E36 (fetched 2026-08-26
// from the live github.com chain; leaf-issuer anchor, see header)
val E36_HEX: str = ""

// built-in anchors, DER bytes
pub fun list(): u8[][] {
    [hex_der(E36_HEX)]
}
