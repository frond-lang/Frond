// Lexicographic three-way comparison (element-wise, shorter-is-less).
@internal
@extern("C")
fun __mem_compare_i8(a: i8[], b: i8[]): i32 #{
    size_t n = a_len < b_len ? a_len : b_len;
    for (size_t k = 0; k < n; k++) {
        if (a_data[k] < b_data[k]) return -1;
        if (a_data[k] > b_data[k]) return 1;
    }
    if (a_len < b_len) return -1;
    if (a_len > b_len) return 1;
    return 0;
}#
