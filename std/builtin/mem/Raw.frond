// Index of the first occurrence of needle in hay; -1 when absent.
@internal
@extern("C")
fun __mem_index_of_i8(hay: i8[], needle: i8[]): i64 #{
    if (needle_len == 0) return 0;
    if (needle_len > hay_len) return -1;
    size_t last = hay_len - needle_len;
    for (size_t i = 0; i <= last; i++) {
        if (hay_data[i] == needle_data[0] &&
            memcmp(hay_data + i, needle_data, (size_t)needle_len * sizeof(int8_t)) == 0) {
            return (int64_t)i;
        }
    }
    return -1;
}#
