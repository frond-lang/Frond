// Copies count elements src[src_at..] → dst[dst_at..] (memmove: overlapping
// windows of the same buffer behave as if taken out first, then written).
@internal
@extern("C")
fun __mem_copy_i8(dst: i8[], dst_at: usize, src: i8[], src_at: usize, count: usize): void #{
    if (count == 0) return;
    if (dst_at > dst_len || count > dst_len - dst_at) {
        fprintf(stderr, "mem.copy: destination range [%llu, %llu) out of bounds (len %llu)\n",
                (unsigned long long)dst_at, (unsigned long long)(dst_at + count),
                (unsigned long long)dst_len);
        abort();
    }
    if (src_at > src_len || count > src_len - src_at) {
        fprintf(stderr, "mem.copy: source range [%llu, %llu) out of bounds (len %llu)\n",
                (unsigned long long)src_at, (unsigned long long)(src_at + count),
                (unsigned long long)src_len);
        abort();
    }
    memmove(dst_data + dst_at, src_data + src_at, (size_t)count * sizeof(int8_t));
}#
