// Index of the first occurrence of needle in hay; -1 when absent. IEEE
// equality loop: NaN never matches (matches the engine's != semantics).
@internal
@extern("C")
fun __mem_index_of_f32(hay: f32[], needle: f32[]): i64 #{
    if (needle_len == 0) return 0;
    if (needle_len > hay_len) return -1;
    size_t last = hay_len - needle_len;
    for (size_t i = 0; i <= last; i++) {
        size_t j = 0;
        while (j < needle_len && hay_data[i + j] == needle_data[j]) j++;
        if (j == needle_len) return (int64_t)i;
    }
    return -1;
}#
// Index of the first occurrence of needle in hay; -1 when absent. IEEE
