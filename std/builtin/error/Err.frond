// Err trait: trait implemented by all error types
//
// The message() default implementation returns msg — all error_newtypes are required to have a message: str field.
// If a type has no msg field or needs a custom message, override message().
// The type_name() default implementation returns "Error"; subtypes can override it.
trait Err {
    fun message(): str {
        msg
    }
    fun type_name(): str {
        "Error"
    }
}
