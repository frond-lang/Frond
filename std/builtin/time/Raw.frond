// builtin/time/Raw.frond — Time primitives @extern("C") declarations (builtin, visible by default)
//
// Low-level POSIX/Windows time capabilities, compiled from emit-c generated .c by the cc crate.
// Cross-platform logic is implemented via #if conditional compilation in the C body.
// Called by wrappers in std/time/*.frond.

@c_include("time.h")
@c_include("windows.h")
@internal
@extern("C")
@export
fun __instant_now_ns(): i64 #{
    #if defined(_WIN32) || defined(_WIN64)
        static LARGE_INTEGER freq = {0};
        if (freq.QuadPart == 0) QueryPerformanceFrequency(&freq);
        LARGE_INTEGER counter;
        QueryPerformanceCounter(&counter);
        return (int64_t)((counter.QuadPart * 1000000000ULL) / freq.QuadPart);
    #else
        struct timespec ts;
        clock_gettime(CLOCK_MONOTONIC, &ts);
        return (int64_t)ts.tv_sec * 1000000000LL + ts.tv_nsec;
    #endif
}#

@c_include("time.h")
@internal
@extern("C")
@export
fun __systemtime_now_ns(): i64 #{
    #if defined(_WIN32) || defined(_WIN64)
        FILETIME ft;
        GetSystemTimeAsFileTime(&ft);
        ULARGE_INTEGER uli;
        uli.LowPart = ft.dwLowDateTime;
        uli.HighPart = ft.dwHighDateTime;
        return (int64_t)(uli.QuadPart - 116444736000000000ULL) * 100;
    #else
        struct timespec ts;
        clock_gettime(CLOCK_REALTIME, &ts);
        return (int64_t)ts.tv_sec * 1000000000LL + ts.tv_nsec;
    #endif
}#

@c_include("time.h")
@internal
@extern("C")
fun __sleep_ns(ns: i64): void #{
    if (ns <= 0) return;
    #if defined(_WIN32) || defined(_WIN64)
        DWORD ms = (DWORD)((ns + 999999) / 1000000);
        Sleep(ms);
    #else
        struct timespec ts;
        ts.tv_sec = (time_t)(ns / 1000000000LL);
        ts.tv_nsec = (long)(ns % 1000000000LL);
        nanosleep(&ts, NULL);
    #endif
}#

@c_include("time.h")
@internal
@extern("C")
@export
fun __localtime_offset_minutes(): i32 #{
    #if defined(_WIN32) || defined(_WIN64)
        TIME_ZONE_INFORMATION tzi;
        GetTimeZoneInformation(&tzi);
        return -(int32_t)tzi.Bias;
    #else
        time_t now = time(NULL);
        struct tm tm_local;
        localtime_r(&now, &tm_local);
        return (int32_t)(tm_local.tm_gmtoff / 60);
    #endif
}#
