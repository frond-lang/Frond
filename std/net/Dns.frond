// Dns.frond — DNS / hostname resolution
//
// Design doc §6.5: DNS resolution.
// Phase 1: IP literal resolution only (not full DNS), returns a single-element array or empty array.
// DNS (HostName.lookup) will be completed in phase 2.

// ─── buffer read helpers (local, to avoid cross-package dependency on std.io.File) ──────────

@internal
fun __dns_read_u32_be(buf: u8[], offset: usize): u32 {
    ((buf[offset] as u32) << 24)
        | ((buf[offset + 1] as u32) << 16)
        | ((buf[offset + 2] as u32) << 8)
        | (buf[offset + 3] as u32)
}

@internal
fun __dns_read_u64_be(buf: u8[], offset: usize): u64 {
    ((buf[offset] as u64) << 56)
        | ((buf[offset + 1] as u64) << 48)
        | ((buf[offset + 2] as u64) << 40)
        | ((buf[offset + 3] as u64) << 32)
        | ((buf[offset + 4] as u64) << 24)
        | ((buf[offset + 5] as u64) << 16)
        | ((buf[offset + 6] as u64) << 8)
        | (buf[offset + 7] as u64)
}

// ─── Frond wrapper: __net_resolve_into → Throw<IpAddr[], IOError> ──

// __net_resolve(host: str): Throw<IpAddr[], IOError>
// Fills the out-buffer via __net_resolve_into (17 bytes per entry), then assembles IpAddr[]
// Buffer size: 16 entries max, 16 * 17 = 272 bytes
@internal
fun __net_resolve(host: str): Throw<IpAddr[], IOError> {
    val max_count: usize = 16
    var buf: u8[] = []
    var i: usize = 0
    while i < 272 {
        buf = buf ++ [0u8]
        i = i + 1
    }
    val count = __net_resolve_into(host, buf, max_count)
    if count < 0 {
        // Resolution failed: return empty array (IP literal resolution failure is not an error)
        Ok([])
    } else {
        // Parse buffer to assemble IpAddr[]
        var addrs: IpAddr[] = []
        var idx: usize = 0
        while idx < count as usize {
            val base = idx * 17
            val family = (buf[base + 16]) as i32
            if family == 4 {
                // IPv4: first 4 bytes are the u32 address (network order)
                val bits = __dns_read_u32_be(buf, base)
                addrs = addrs ++ [V4(Ipv4Addr(bits))]
            } else {
                // IPv6: first 16 bytes are two u64 (hi, lo), network order
                val hi = __dns_read_u64_be(buf, base)
                val lo = __dns_read_u64_be(buf, base + 8)
                addrs = addrs ++ [V6(Ipv6Addr(hi, lo))]
            }
            idx = idx + 1
        }
        Ok(addrs)
    }
}

// ─── Public API ─────────────────────────────────────────────────────

// Resolves a hostname to an IpAddr array.
// Phase 1: IP literal (IPv4/IPv6) resolution success → single-element array; failure → empty array (not an error).
pub async fun resolve(host: str): Async<Throw<IpAddr[], IOError>> {
    __net_resolve(host)?
}
