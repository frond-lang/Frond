// UdpSocket.frond — UDP socket
//
// Design doc §6.4: UdpSocket newtype + send_to/recv_from/close.
// All IO operations are async, return Async<Throw<T, IOError>>.
//
// Underlying @extern("C") primitives (__net_udp_bind_v4 / __net_udp_send_to_v4 etc.)
// are declared in builtin/net/Raw.frond. __net_udp_bind / __net_udp_send_to are Frond wrappers.
// __net_tcp_close is defined in TcpStream.frond (shared by TCP/UDP).
// async function bodies currently call synchronous primitives directly; spawn semantics
// will be added once the IR/Engine async model is ready.
//
// RecvFromResult layout (aligned with syscall/net.zig makeRecordWithNames):
//   fields = [__tag=0, data=u8[], src_addr=SocketAddr]

// ─── Frond wrapper: @extern("C") raw return value → Throw ──────────────

// __net_udp_bind(ip: IpAddr, port: u16, reuse_addr: bool): Throw<i64, IOError>
@internal
fun __net_udp_bind(ip: IpAddr, port: u16, reuse_addr: bool): Throw<i64, IOError> {
    match ip {
        V4(v4_addr) => {
            val fd = __net_udp_bind_v4(v4_addr.bits, port, reuse_addr)
            if fd < 0 {
                throw IOError(AddrInUse, "udp bind failed", 0, null)
            }
            Ok(fd)
        },
        V6(v6_addr) => {
            val fd = __net_udp_bind_v6(v6_addr.hi, v6_addr.lo, port, reuse_addr)
            if fd < 0 {
                throw IOError(AddrInUse, "udp bind failed", 0, null)
            }
            Ok(fd)
        },
    }
}

// __net_udp_send_to(fd: i64, ip: IpAddr, port: u16, buf: u8[]): Throw<usize, IOError>
@internal
fun __net_udp_send_to(fd: i64, ip: IpAddr, port: u16, buf: u8[]): Throw<usize, IOError> {
    match ip {
        V4(v4_addr) => {
            val n = __net_udp_send_to_v4(fd, v4_addr.bits, port, buf, buf.len())
            if n < 0 {
                throw IOError(Other, "udp send_to failed", 0, null)
            }
            Ok(n as usize)
        },
        V6(v6_addr) => {
            val n = __net_udp_send_to_v6(fd, v6_addr.hi, v6_addr.lo, port, buf, buf.len())
            if n < 0 {
                throw IOError(Other, "udp send_to failed", 0, null)
            }
            Ok(n as usize)
        },
    }
}

// ─── Type definitions ──────────────────────────────────────────────────────

// RecvFromResult: newtype, fields = [__tag=0, data=u8[], src_addr=SocketAddr]
// data is the received byte array; length can be obtained via data.len().
pub type RecvFromResult = RecvFromResult(pub data: u8[], pub src_addr: SocketAddr)

// UdpSocket: newtype, fd is cross-platform i64 storage handle
pub type UdpSocket = UdpSocket(fd: i64, local_addr: SocketAddr, is_closed: bool) {
    // Returns the bound address (local address passed in at construction)
    pub fun local_addr(): SocketAddr {
        local_addr
    }

    // Sends a UDP datagram to the target address. Returns the actual number of bytes sent.
    // send_to uses the full length of buf directly (syscall has no len parameter).
    pub async fun send_to(dst: SocketAddr, buf: u8[]): Async<Throw<usize, IOError>> {
        if is_closed {
            throw IOError(InvalidInput, "socket closed", 0, null)
        }
        __net_udp_send_to(fd, dst.ip, dst.port, buf)?
    }

    // Receives a UDP datagram. Returns RecvFromResult(data, src_addr).
    // Currently calls synchronous C primitive directly; will switch to spawn + channel
    // mode once the IR/Engine async model is ready.
    // Note: __net_udp_recv_from_v4/v6 currently does not return src_addr; an extra call
    // is needed to get the sender address.
    // Temporarily uses local_addr as a placeholder; the syscall layer will add a src_addr
    // output parameter to recvfrom later.
    // Dispatches to the corresponding primitive based on local_addr.ip's family
    // (family is fixed at socket creation).
    pub async fun recv_from(len: usize): Async<Throw<RecvFromResult, IOError>> {
        if is_closed {
            throw IOError(InvalidInput, "socket closed", 0, null)
        }
        val buf: u8[] = [0, ..len]
        val n = match local_addr.ip {
            V4(_) => __net_udp_recv_from_v4(fd, buf, len),
            V6(_) => __net_udp_recv_from_v6(fd, buf, len),
        }
        if n < 0 {
            throw IOError(ConnectionReset, "udp recv_from failed", 0, null)
        }
        Ok(RecvFromResult(buf[0..n as usize], local_addr))
    }

    // Closes the socket. Idempotent: repeated close does not error.
    // UDP socket reuses __net_tcp_close (both are close(fd) underneath).
    pub async fun close(): Async<Throw<void, IOError>> {
        if is_closed {
            Ok(void)
        } else {
            is_closed = true
            __net_tcp_close(fd)?
            Ok(void)
        }
    }
}

// ─── Top-level async functions ("static method" semantics) ───────────────────────────

// Binds a UDP address. reuse_addr is a reserved parameter (currently unused by the syscall layer).
pub async fun bind(addr: SocketAddr, reuse_addr: bool): Async<Throw<UdpSocket, IOError>> {
    val fd = __net_udp_bind(addr.ip, addr.port, reuse_addr)?
    Ok(UdpSocket(fd, addr, false))
}
