// IntSet.frond — i64 hash set (part of std.collections)
//
// The i64 fast-path child of Set<i64>: the ONLY override is `hash_of`
// (Hash.mix_i64 direct integer mixing — no per-op string formatting).
// Everything else is inherited.

import std.core.hash

type IntSet(Set<i64>) = IntSet() {
    fun hash_of(key: i64): u64 { Hash.mix_i64(key) }
}

pub fun empty(): IntSet {
    val empty: i64[] = []
    IntSet([empty, ..16], 0)
}
