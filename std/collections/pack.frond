// std/collections package declaration
//
// Containers. List<T> is the growable sequence (amortized O(1) push — the
// dynamic counterpart to fixed-length T[]). HashMap/HashSet take fully
// generic keys: hashing goes through the key's `"{k}"` representation
// (every value formats) and equality uses engine-level deep `==`, so any
// type — str, scalars, bool, records, ADTs, arrays — works as a key.
// IntMap/IntSet are the i64 fast path (direct integer hashing, no per-op
// string formatting).
//
//   List<T>       — growable list  HashMap<K, V> — generic keys
//   HashSet<K>    — generic elems  IntMap<V>     — i64 → V fast
//   IntSet        — i64 fast
//   ArrayList<T>(List<T>)  — the array-backed list, explicit name
//   LinkedList<T>(List<T>) — doubly-linked storage (O(1) ends + push_front)
//
// The hash tables are separate-chaining: bucket arrays hold small entry
// arrays, grow ×2 at load factor 2, and rebuild buckets on remove.
pub pack List
pub pack ArrayList
pub pack LinkedList
pub pack Map
pub pack Set
pub pack HashMap
pub pack IntMap
pub pack HashSet
pub pack IntSet
