// Dir.frond — Directory listing/creation/deletion/traversal
//
// Design doc §4.6: Dir convenience API
// All operations are async, returning Async<Throw<T, IOError>>.
// DirEntry is returned via __dir_list syscall, kind field is FileKind ADT.

// ─── Type definitions ──────────────────────────────────────────────

// Directory entry (name + kind), aligned with syscall/io.zig dir_list return structure
pub type DirEntry = DirEntry(pub name: str, pub kind: FileKind)

// ─── Frond wrapper: @extern("C") raw return value → Throw ──────────

// __dir_create(path: str, recursive: bool): Throw<void, IOError>
fun __dir_create(path: str, recursive: bool): Throw<void, IOError> {
    val rc = __dir_create_raw(path, recursive)
    if rc < 0 {
        throw IOError(NotFound, "dir create failed", 0, path)
    }
    Ok(void)
}

// __dir_remove(path: str, recursive: bool): Throw<void, IOError>
fun __dir_remove(path: str, recursive: bool): Throw<void, IOError> {
    val rc = __dir_remove_raw(path, recursive)
    if rc < 0 {
        throw IOError(NotFound, "dir remove failed", 0, path)
    }
    Ok(void)
}

// __dir_list(path: str): Throw<DirEntry[], IOError>
// Fill three out-buffers via __dir_list_into, then assemble DirEntry[]
// Buffer sizes: 256 entries max, 8KB name space, 1KB offset space
fun __dir_list(path: str): Throw<DirEntry[], IOError> {
    val max_count: usize = 256
    var names_buf: u8[] = [0, ..8192]
    var name_offsets: u8[] = [0, ..1024]
    var kinds_buf: u8[] = [0, ..256]
    val count = __dir_list_into(path, names_buf, name_offsets, kinds_buf, max_count)
    if count < 0 {
        throw IOError(NotFound, "dir list failed", 0, path)
    }
    // Parse buffer to assemble DirEntry[] (single pass — the engine-level
    // var-aliasing bug is fixed at the Builder, no workaround needed here).
    var entries: DirEntry[] = []
    var idx: usize = 0
    while idx < count as usize {
        val kind = __kind_from_int((kinds_buf[idx]) as i32)
        val off_base = idx * 4
        val name_start = (__read_i32_le(name_offsets, off_base)) as usize
        val name_end = if idx + 1 < count as usize {
            (__read_i32_le(name_offsets, off_base + 4)) as usize
        } else {
            var end_pos = name_start
            while end_pos < names_buf.len() && names_buf[end_pos] != 0 {
                end_pos = end_pos + 1
            }
            end_pos
        }
        val name = if name_end > name_start {
            (names_buf[name_start..name_end]) as str
        } else {
            ""
        }
        entries = entries ++ [DirEntry(name, kind)]
        idx = idx + 1
    }
    Ok(entries)
}

// ─── Directory operations (async) ──────────────────────────────────

// List direct child entries of directory
pub async fun list(path: Path): Async<Throw<DirEntry[], IOError>> {
    __dir_list(path.to_str())?
}

// Create a single directory (parent must exist)
pub async fun create(path: Path): Async<Throw<void, IOError>> {
    __dir_create(path.to_str(), false)?
    Ok(void)
}

// Remove an empty directory
pub async fun remove(path: Path): Async<Throw<void, IOError>> {
    __dir_remove(path.to_str(), false)?
    Ok(void)
}

// Recursively traverse directory tree (depth-first), return all entries (including entries in subdirectories)
// Optimization: collect current-level entries into local array first (small array ++ has low overhead), batch concatenate subdirectory results,
// avoid repeated ++ on accumulated large result causing O(n²)
pub async fun walk(path: Path): Async<Throw<DirEntry[], IOError>> {
    val entries = __dir_list(path.to_str())?
    // All current-level entries enter result at once (entries is already an array, used directly as initial value)
    var result: DirEntry[] = entries
    // Collect subdirectory paths, recurse uniformly then batch concatenate
    var sub_paths: Path[] = []
    for e in entries.iter() {
        match e.kind {
            Directory => {
                sub_paths = sub_paths ++ [path.join_str(e.name)]
            },
            _ => {},
        }
    }
    // Recurse into each subdirectory one by one, batch concatenating results each time
    for sp in sub_paths.iter() {
        val sub_entries = walk(sp).await()?
        result = result ++ sub_entries
    }
    Ok(result)
}
