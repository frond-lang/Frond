// Usize.frond — the usize type module (part of std.core.types)
//
// Boundary constant + decimal parse. MAX comes from the C toolchain
// (builtin __os_usize_max -> UINTPTR_MAX), so it follows the target
// pointer width instead of a hardcoded 64-bit decimal. parse accepts an
// optional leading '+' (the unsigned family rejects '-') and returns
// Throw<_, ParseError>: Malformed on bad syntax, Overflow on values above
// usize MAX — the same overflow-to-error contract as the float family
// (F*.parse), never a silent wrap.

pub val MAX: usize = __os_usize_max()

pub fun parse(s: str): Throw<usize, ParseError> {
    val b = s.bytes()
    if b.len() == 0 { throw ParseError(Malformed, "empty input is not a usize literal", s) }
    var i = 0 as usize
    if b[0] == 43 { i = 1 as usize }
    if b[0] == 45 { throw ParseError(Malformed, "negative input is not a usize literal", s) }
    if i >= b.len() { throw ParseError(Malformed, "sign with no digits is not a usize literal", s) }
    var v: u128 = 0
    val limit: u128 = Usize.MAX as u128
    while i < b.len() {
        val d = (b[i] as u128) - 48
        if d > 9 { throw ParseError(Malformed, "invalid digit in usize literal", s) }
        if v > (limit - d) / 10 { throw ParseError(Overflow, "value out of range for usize", s) }
        v = v * 10 + d
        i = i + 1
    }
    Ok(v as usize)
}
