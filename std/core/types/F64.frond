// F64.frond — the f64 type module (part of std.core.types)
//
// IEEE 754 binary64 boundary constants + string conversion. parse is
// correctly rounded (round to nearest, ties to even — the IEEE 754 default
// rounding attribute) via the C99 strtod kernel; it accepts decimal
// [+-]?(digits[.digits]?|.digits)([eE][+-]?digits)?, hexadecimal floats
// (0x1.8p3), and the inf/infinity/nan spellings (case-insensitive).
// Throws ParseError: Malformed on bad syntax, Overflow when the value
// overflows to infinity; underflow is not an error — it rounds to 0.0 or a
// subnormal per IEEE 754.

pub val MAX: f64 = 0x1.fffffffffffffp+1023
pub val MIN: f64 = 0x1p-1022
pub val MIN_SUBNORMAL: f64 = 0x1p-1074
pub val EPSILON: f64 = 0x1p-52

pub fun parse(s: str): Throw<f64, ParseError> {
    val ok: u8[] = [0 as u8]
    val v = __fp_parse_f64(s, ok)
    if ok[0] == 0 { throw ParseError(Malformed, "not a valid f64 literal", s) }
    if ok[0] == 2 { throw ParseError(Overflow, "value overflows f64 to infinity", s) }
    Ok(v)
}
