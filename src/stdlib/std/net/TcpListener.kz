// TcpListener.kz — TCP listener
//
// Design doc §6.3: TcpListener newtype + accept/close.
// All IO operations are async, return Async<Throw<T, IOError>>.
//
// Underlying @extern("C") primitives (__net_tcp_listen_v4 / __net_tcp_close_raw)
// are declared in builtin/net/Raw.kz. __net_tcp_listen is a Kuzo wrapper.
// __net_tcp_close is defined in TcpStream.kz (shared by TCP/UDP).
// async function bodies currently call synchronous primitives directly; spawn semantics
// will be added once the IR/Engine async model is ready.
//
// AcceptResult layout (aligned with syscall/net.zig makeRecordWithNames):
//   fields = [__tag=0, stream_fd=i64, peer_addr=SocketAddr]
// After accept succeeds, stream_fd can be used to construct a TcpStream (see TcpStream.from_accept_fd).

// ─── Kuzo wrapper: @extern("C") raw return value → Throw ──────────────

// __net_tcp_listen(ip: IpAddr, port: u16, reuse_addr: bool): Throw<i64, IOError>
fun __net_tcp_listen(ip: IpAddr, port: u16, reuse_addr: bool): Throw<i64, IOError> {
    match ip {
        V4(v4_addr) => {
            val fd = __net_tcp_listen_v4(v4_addr.bits, port, reuse_addr)
            if fd < 0 {
                throw IOError(AddrInUse, "tcp listen failed", 0, null)
            }
            Ok(fd)
        },
        V6(v6_addr) => {
            val fd = __net_tcp_listen_v6(v6_addr.hi, v6_addr.lo, port, reuse_addr)
            if fd < 0 {
                throw IOError(AddrInUse, "tcp listen failed", 0, null)
            }
            Ok(fd)
        },
    }
}

// ─── Type definitions ──────────────────────────────────────────────────────

// AcceptResult: newtype, fields = [__tag=0, stream_fd=i64, peer_addr=SocketAddr]
pub type AcceptResult = AcceptResult(stream_fd: i64, peer_addr: SocketAddr)

// TcpListener: newtype, fd is cross-platform i64 storage handle
pub type TcpListener = TcpListener(fd: i64, local_addr: SocketAddr, is_closed: bool) {
    // Returns the listen address (local address passed in at construction)
    pub fun local_addr(): SocketAddr {
        local_addr
    }

    // Accepts a TCP connection.
    // Currently calls synchronous C primitive directly; will switch to spawn + channel
    // mode once the IR/Engine async model is ready.
    // Returns AcceptResult(stream_fd, peer_addr).
    // Note: __net_tcp_accept currently does not return peer_addr; an extra call is needed
    // to get the peer address.
    // Temporarily uses local_addr as a placeholder; the syscall layer will add getpeername later.
    pub async fun accept(): Async<Throw<AcceptResult, IOError>> {
        if is_closed {
            throw IOError(InvalidInput, "listener closed", 0, null)
        }
        val client_fd = __net_tcp_accept(fd)
        if client_fd < 0 {
            throw IOError(ConnectionRefused, "tcp accept failed", 0, null)
        }
        Ok(AcceptResult(client_fd, local_addr))
    }

    // Closes the listener. Idempotent: repeated close does not error.
    pub async fun close(): Async<Throw<void, IOError>> {
        if is_closed {
            Ok(void)
        } else {
            is_closed = true
            __net_tcp_close(fd)?
            Ok(void)
        }
    }
}

// ─── Top-level async functions ("static method" semantics) ───────────────────────────

// Binds and listens on a TCP address. reuse_addr controls SO_REUSEADDR.
pub async fun bind(addr: SocketAddr, reuse_addr: bool): Async<Throw<TcpListener, IOError>> {
    val fd = __net_tcp_listen(addr.ip, addr.port, reuse_addr)?
    Ok(TcpListener(fd, addr, false))
}
