// UdpSocket.kz — UDP 套接字
//
// 设计文档 §6.4：UdpSocket newtype + send_to/recv_from/close。
// 所有 IO 操作为 async，返回 Async<Throw<T, IOError>>。
//
// 底层 @extern("C") 原语（__net_udp_bind_v4 / __net_udp_send_to_v4 等）
// 由 builtin/net/Raw.kz 声明。__net_udp_bind / __net_udp_send_to 为 Kuzo wrapper。
// __net_tcp_close 由 TcpStream.kz 定义（TCP/UDP 共用）。
// async 函数体当前直接调用同步原语，等 IR/Engine 异步模型就绪后再补 spawn 语义。
//
// RecvFromResult 布局（与 syscall/net.zig makeRecordWithNames 对齐）：
//   fields = [__tag=0, data=u8[], src_addr=SocketAddr]

// ─── Kuzo wrapper：@extern("C") 原始返回值 → Throw ──────────────

// __net_udp_bind(ip: IpAddr, port: u16, reuse_addr: bool): Throw<i64, IOError>
fun __net_udp_bind(ip: IpAddr, port: u16, reuse_addr: bool): Throw<i64, IOError> {
    match ip {
        V4(v4_addr) => {
            val fd = __net_udp_bind_v4(v4_addr.bits, port, reuse_addr)
            if fd < 0 {
                throw IOError(AddrInUse, "udp bind failed", 0, null)
            }
            Ok(fd)
        },
        V6(v6_addr) => {
            val fd = __net_udp_bind_v6(v6_addr.hi, v6_addr.lo, port, reuse_addr)
            if fd < 0 {
                throw IOError(AddrInUse, "udp bind failed", 0, null)
            }
            Ok(fd)
        },
    }
}

// __net_udp_send_to(fd: i64, ip: IpAddr, port: u16, buf: u8[]): Throw<usize, IOError>
fun __net_udp_send_to(fd: i64, ip: IpAddr, port: u16, buf: u8[]): Throw<usize, IOError> {
    match ip {
        V4(v4_addr) => {
            val n = __net_udp_send_to_v4(fd, v4_addr.bits, port, buf, buf.len())
            if n < 0 {
                throw IOError(Other, "udp send_to failed", 0, null)
            }
            Ok(cast(n).to(usize))
        },
        V6(v6_addr) => {
            val n = __net_udp_send_to_v6(fd, v6_addr.hi, v6_addr.lo, port, buf, buf.len())
            if n < 0 {
                throw IOError(Other, "udp send_to failed", 0, null)
            }
            Ok(cast(n).to(usize))
        },
    }
}

// ─── 类型定义 ──────────────────────────────────────────────────────

// RecvFromResult：newtype，fields = [__tag=0, data=u8[], src_addr=SocketAddr]
// data 为收到的字节数组，长度可通过 data.len() 获取。
pub type RecvFromResult = RecvFromResult(data: u8[], src_addr: SocketAddr)

// UdpSocket：newtype，fd 跨平台 i64 存储句柄
pub type UdpSocket = UdpSocket(fd: i64, local_addr: SocketAddr, is_closed: bool) {
    // 返回绑定地址（构造时传入的本地地址）
    pub fun local_addr(): SocketAddr {
        local_addr
    }

    // 向目标地址发送 UDP 数据报。返回实际发送字节数。
    // send_to 直接使用 buf 的完整长度（syscall 无 len 参数）。
    pub async fun send_to(dst: SocketAddr, buf: u8[]): Async<Throw<usize, IOError>> {
        if is_closed {
            throw IOError(InvalidInput, "socket closed", 0, null)
        }
        __net_udp_send_to(fd, dst.ip, dst.port, buf)?
    }

    // 接收 UDP 数据报。返回 RecvFromResult(data, src_addr)。
    // 当前直接调用同步 C 原语，等 IR/Engine 异步模型就绪后改为 spawn + channel 模式。
    // 注意：__net_udp_recv_from_v4/v6 当前不返回 src_addr，需要额外调用获取发送方地址。
    // 暂用 local_addr 作为占位，后续 syscall 层补 recvfrom 的 src_addr 输出参数。
    // 按 local_addr.ip 的 family 分派到对应原语（socket 创建时 family 已固定）。
    pub async fun recv_from(len: usize): Async<Throw<RecvFromResult, IOError>> {
        if is_closed {
            throw IOError(InvalidInput, "socket closed", 0, null)
        }
        val buf: u8[] = [0u8] * len
        val n = match local_addr.ip {
            V4(_) => __net_udp_recv_from_v4(fd, buf, len),
            V6(_) => __net_udp_recv_from_v6(fd, buf, len),
        }
        if n < 0 {
            throw IOError(ConnectionReset, "udp recv_from failed", 0, null)
        }
        Ok(RecvFromResult(buf[0..cast(n).to(usize)], local_addr))
    }

    // 关闭套接字。幂等：重复 close 不报错。
    // UDP 套接字复用 __net_tcp_close（底层都是 close(fd)）。
    pub async fun close(): Async<Throw<void, IOError>> {
        if is_closed {
            Ok(void)
        } else {
            is_closed = true
            __net_tcp_close(fd)?
            Ok(void)
        }
    }
}

// ─── 顶层 async 函数（"静态方法"语义） ───────────────────────────

// 绑定 UDP 地址。reuse_addr 为预留参数（syscall 层当前未使用）。
pub async fun bind(addr: SocketAddr, reuse_addr: bool): Async<Throw<UdpSocket, IOError>> {
    val fd = __net_udp_bind(addr.ip, addr.port, reuse_addr)?
    Ok(UdpSocket(fd, addr, false))
}
