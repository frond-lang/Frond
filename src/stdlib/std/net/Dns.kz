// Dns.kz — DNS / 主机名解析
//
// 设计文档 §6.5：DNS 解析。
// 一期：仅 IP 字面量解析（非完整 DNS），返回单元素数组或空数组。
// DNS（HostName.lookup）为二期补全。

// ─── buffer 读取辅助（local，避免跨包依赖 std.io.File） ──────────

fun __dns_read_u32_le(buf: u8[], offset: usize): u32 {
    u32(buf[offset])
        | (u32(buf[offset + 1]) << 8u32)
        | (u32(buf[offset + 2]) << 16u32)
        | (u32(buf[offset + 3]) << 24u32)
}

fun __dns_read_u64_le(buf: u8[], offset: usize): u64 {
    u64(buf[offset])
        | (u64(buf[offset + 1]) << 8u64)
        | (u64(buf[offset + 2]) << 16u64)
        | (u64(buf[offset + 3]) << 24u64)
        | (u64(buf[offset + 4]) << 32u64)
        | (u64(buf[offset + 5]) << 40u64)
        | (u64(buf[offset + 6]) << 48u64)
        | (u64(buf[offset + 7]) << 56u64)
}

// ─── Kuzo wrapper：__net_resolve_into → Throw<IpAddr[], IOError> ──

// __net_resolve(host: str): Throw<IpAddr[], IOError>
// 通过 __net_resolve_into 填充 out-buffer（每条目 17 字节），然后组装 IpAddr[]
// 缓冲区大小：16 条目上限，16 * 17 = 272 字节
fun __net_resolve(host: str): Throw<IpAddr[], IOError> {
    val max_count: usize = 16
    var buf: u8[] = []
    var i: usize = 0
    while i < 272 {
        buf = buf ++ [0u8]
        i = i + 1
    }
    val count = __net_resolve_into(host, buf, max_count)
    if count < 0 {
        // 解析失败：返回空数组（IP 字面量解析失败非错误）
        Ok([])
    } else {
        // 解析 buffer 组装 IpAddr[]
        var addrs: IpAddr[] = []
        var idx: usize = 0
        while idx < cast(count).to(usize) {
            val base = idx * 17
            val family = cast(buf[base + 16]).to(i32)
            if family == 4 {
                // IPv4: 前 4 字节为 u32 地址
                val bits = __dns_read_u32_le(buf, base)
                addrs = addrs ++ [V4(Ipv4Addr(bits))]
            } else {
                // IPv6: 前 16 字节为两个 u64（hi, lo）
                val hi = __dns_read_u64_le(buf, base)
                val lo = __dns_read_u64_le(buf, base + 8)
                addrs = addrs ++ [V6(Ipv6Addr(hi, lo))]
            }
            idx = idx + 1
        }
        Ok(addrs)
    }
}

// ─── 公开 API ─────────────────────────────────────────────────────

// 解析主机名为 IpAddr 数组。
// 一期：IP 字面量（IPv4/IPv6）解析成功 → 单元素数组；失败 → 空数组（非错误）。
pub async fun resolve(host: str): Async<Throw<IpAddr[], IOError>> {
    __net_resolve(host)?
}
