// Hex.frond — hexadecimal codec (part of std.codec)
//
// encode: two lowercase digits per byte ("ff00").
// decode: accepts upper and lower case, null on odd length or non-hex bytes.
// Round-trip guarantee: decode(encode(data)) == data.

// Hex digit value of a byte, -1 if it is not a hex digit.
@internal
fun __hex_value(c: u8): i32 {
    if c >= 48 && c <= 57 { (c as i32) - 48 }        // '0'..'9'
    else if c >= 97 && c <= 102 { (c as i32) - 87 }  // 'a'..'f'
    else if c >= 65 && c <= 70 { (c as i32) - 55 }   // 'A'..'F'
    else { -1 }
}

// Hex digit byte for a nibble 0..15 (lowercase).
@internal
fun __hex_digit(n: u8): u8 {
    if n < 10 { (48 + (n as i32)) as u8 } else { (87 + (n as i32)) as u8 }
}

pub fun encode(data: u8[]): str {
    var out: u8[] = [0, ..data.len() * 2]
    var i: usize = 0
    while i < data.len() {
        val b = data[i]
        out[i * 2] = __hex_digit((b >> 4))
        out[i * 2 + 1] = __hex_digit((b & 15))
        i = i + 1
    }
    out as str
}

pub fun decode(s: str): u8[]? {
    val b = s.bytes()
    if b.len() % 2 != 0 { return null }
    var out: u8[] = [0, ..b.len() / 2]
    var i: usize = 0
    while i < out.len() {
        val hi = __hex_value(b[i * 2])
        val lo = __hex_value(b[i * 2 + 1])
        if hi < 0 || lo < 0 { return null }
        out[i] = (hi * 16 + lo) as u8
        i = i + 1
    }
    out
}
