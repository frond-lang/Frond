// Base64.frond — base64 codec (part of std.codec)
//
// Standard alphabet (RFC 4648 §4: A-Z a-z 0-9 + /) with mandatory '=' padding
// on encode. decode is strict: null on wrong length (mod 4), invalid
// characters, '=' anywhere but the tail, or more than two pad characters.
// Round-trip guarantee: decode(encode(data)) == data.

// Base64 value of a byte, -1 if it is not part of the standard alphabet.
@internal
fun __b64_value(c: u8): i32 {
    if c >= 65 && c <= 90 { (c as i32) - 65 }        // 'A'..'Z' -> 0..25
    else if c >= 97 && c <= 122 { (c as i32) - 71 }  // 'a'..'z' -> 26..51
    else if c >= 48 && c <= 57 { (c as i32) + 4 }    // '0'..'9' -> 52..61
    else if c == 43 { 62 }                           // '+'
    else if c == 47 { 63 }                           // '/'
    else { -1 }
}

pub fun encode(data: u8[]): str {
    val alpha = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/".bytes()
    var out_len = (data.len() / 3) * 4
    if data.len() % 3 != 0 { out_len = out_len + 4 }
    var out: u8[] = [0, ..out_len]
    var i: usize = 0
    var j: usize = 0
    while i + 3 <= data.len() {
        val n = (((data[i]) as u32) << 16) | ((((data[i + 1]) as u32)) << 8) | ((data[i + 2]) as u32)
        out[j] = alpha[((n >> 18) & 63) as usize]
        out[j + 1] = alpha[((n >> 12) & 63) as usize]
        out[j + 2] = alpha[((n >> 6) & 63) as usize]
        out[j + 3] = alpha[(n & 63) as usize]
        i = i + 3
        j = j + 4
    }
    val rem = data.len() % 3
    if rem == 1 {
        val n = ((data[i]) as u32) << 16
        out[j] = alpha[((n >> 18) & 63) as usize]
        out[j + 1] = alpha[((n >> 12) & 63) as usize]
        out[j + 2] = 61  // '='
        out[j + 3] = 61
    } else if rem == 2 {
        val n = (((data[i]) as u32) << 16) | ((((data[i + 1]) as u32)) << 8)
        out[j] = alpha[((n >> 18) & 63) as usize]
        out[j + 1] = alpha[((n >> 12) & 63) as usize]
        out[j + 2] = alpha[((n >> 6) & 63) as usize]
        out[j + 3] = 61  // '='
    }
    out as str
}

pub fun decode(s: str): u8[]? {
    val b = s.bytes()
    if b.len() % 4 != 0 { return null }
    var out: u8[] = [0, ..(b.len() / 4) * 3]
    // trailing '=' count (0..2); a third '=' fails the tail check below
    var pad: usize = 0
    if b.len() > 0 && b[b.len() - 1] == 61 { pad = pad + 1 }
    if b.len() > 1 && b[b.len() - 2] == 61 { pad = pad + 1 }
    // '=' is only legal in the last two positions; every kept char must
    // be a valid alphabet byte
    var check: usize = 0
    while check < b.len() {
        if check < b.len() - pad {
            if __b64_value(b[check]) < 0 { return null }
        } else if b[check] != 61 {
            return null
        }
        check = check + 1
    }
    // decode 6-bit groups; pad positions contribute zero and are sliced off
    var g: usize = 0
    var k: usize = 0
    while g < b.len() {
        var v: u32 = 0
        var q: usize = 0
        while q < 4 {
            var six: i32 = 0
            if g + q < b.len() - pad { six = __b64_value(b[g + q]) }
            v = (v << 6) | ((six as u32) & 63)
            q = q + 1
        }
        out[k] = ((v >> 16) & 255) as u8
        out[k + 1] = ((v >> 8) & 255) as u8
        out[k + 2] = (v & 255) as u8
        g = g + 4
        k = k + 3
    }
    out[0..out.len() - pad]
}
