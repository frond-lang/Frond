// Env.frond — environment variables
//
// Sync API (microsecond-level host calls; no async wrapper needed).
// get follows the Go os.Getenv convention: a missing key yields ""
// (same as an empty value — branch on the result when the distinction
// matters).

// Read an environment variable. Returns "" when the key is not set.
pub fun get(key: str): str {
    val buf: u8[] = [0, ..4096]
    val n = __os_env_get_into(key, buf)
    if n <= 0 { return "" }
    (buf[0..n as usize]) as str
}

// All environment entries as "KEY=VALUE" strings (Go os.Environ convention;
// no Map type — split on the first '=' at the call site when needed).
pub fun vars(): str[] {
    val n = __os_env_vars_count()
    var out: str[] = []
    var i: i64 = 0
    while i < n {
        val buf: u8[] = [0, ..32768]
        val len = __os_env_var_get_into(i, buf)
        if len > 0 {
            out = out ++ [(buf[0..len as usize]) as str]
        }
        i = i + 1
    }
    out
}

// Set an environment variable for the current process.
pub fun set(key: str, value: str): Throw<void, OsError> {
    val rc = __os_env_set(key, value)
    if rc < 0 {
        throw OsError(EnvFailed, "failed to set environment variable: " + key, 0)
    }
    Ok(void)
}

// Remove an environment variable from the current process.
pub fun remove(key: str): Throw<void, OsError> {
    val rc = __os_env_remove(key)
    if rc < 0 {
        throw OsError(EnvFailed, "failed to remove environment variable: " + key, 0)
    }
    Ok(void)
}
