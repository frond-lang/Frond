// Proc.frond — current-process information and termination
//
// Sync API. Command-line arguments are intentionally NOT here: Frond passes
// them to `main(args)` directly, which is the single source of truth.

// Process id of the current process.
pub fun getpid(): i64 {
    __os_getpid()
}

// Terminate the process immediately with the given exit code.
//
// This is a HARD exit — by design it does NOT participate in any deferred or
// asynchronous machinery (same family as C exit() / Go os.Exit / Rust
// std::process::exit):
//   - `defer` blocks that have not run yet: NOT executed
//   - lazy values not yet forced: never evaluated
//   - suspended async tasks: dropped with the process
// Statements after the exit call never execute. Output is safe: print-family
// calls write through directly (no user-space buffering to lose).
//
// For graceful shutdown (defers run, code propagates to the caller), return
// from the enclosing function instead of calling exit.
pub fun exit(code: i32): void {
    __os_exit(code)
}

// Run a shell command through the system shell (cmd on Windows, sh on POSIX),
// blocking until completion. Returns the command's exit code.
pub fun system(cmd: str): Throw<i32, OsError> {
    val rc = __os_system(cmd)
    if rc == -1 {
        throw OsError(Other, "failed to launch shell command: " + cmd, 0)
    }
    Ok(rc)
}
