// Os.kz — working directory (process attribute, Go os.Getwd/Chdir counterpart)
//
// Sync API. The working directory belongs to the process, not the file
// system's structure, hence it lives in std.os rather than std.io.

// Get the current working directory as an absolute path.
pub fun current_dir(): Throw<str, OsError> {
    val buf: u8[] = [0u8, ..4096]
    val n = __os_cwd_into(buf)
    if n < 0 {
        throw OsError(NotFound, "failed to get current directory", 0)
    }
    if n == -2 || n as usize >= buf.len() {
        throw OsError(BufferTooSmall, "current directory exceeds buffer", 0)
    }
    Ok((buf[0..n as usize]) as str)
}

// Change the current working directory.
pub fun set_current_dir(path: str): Throw<void, OsError> {
    val rc = __os_set_cwd(path)
    if rc < 0 {
        throw OsError(NotFound, "failed to change directory: " + path, 0)
    }
    Ok(void)
}
