// HashSet.frond — generic hash set (part of std.collections)
//
// The generic-hashing child of Set<K>: everything is inherited and the
// default `hash_of` (FNV-1a over the element's "{k}" representation) is the
// wanted behavior — the child body is empty. For i64 elements prefer IntSet
// (integer-hash override).

type HashSet<K>(Set<K>) = HashSet() {
}

pub fun empty<K>(): HashSet<K> {
    val empty: K[] = []
    HashSet([empty, ..16], 0)
}
