// HashSet.frond — generic hash set (part of std.collections)
//
// Same hashing scheme as HashMap<K, V>: FNV-1a over the key's `"{k}"`
// representation plus `==` deep equality — any type works as an element.
// add() reports whether the key was newly inserted. For i64 elements prefer
// IntSet (integer hashing, no string formatting per operation).

fun set_hash_key<K>(k: K): u64 {
    val s = "{k}"
    var h: u64 = 1469598103934665603
    val b = s.bytes()
    var i = 0 as usize
    while i < b.len() {
        h = (h ^ (b[i] as u64)) * 1099511628211
        i = i + 1
    }
    h
}

type HashSet<K> = HashSet(buckets: K[][], count: usize) {

    pub fun len(): usize { count }

    pub fun is_empty(): bool { count == 0 }

    pub fun has(key: K): bool {
        val row = buckets[(set_hash_key(key) & ((buckets.len() - 1) as u64)) as usize]
        var i = 0 as usize
        while i < row.len() {
            if row[i] == key { return true }
            i = i + 1
        }
        false
    }

    // Returns true when the key was newly inserted, false when it was present.
    pub fun &add(key: K): bool {
        val slot = (set_hash_key(key) & ((buckets.len() - 1) as u64)) as usize
        val row = buckets[slot]
        var i = 0 as usize
        while i < row.len() {
            if row[i] == key { return false }
            i = i + 1
        }
        buckets[slot] = row ++ [key]
        count = count + 1
        grow_if_needed()
        true
    }

    pub fun &remove(key: K): bool {
        val slot = (set_hash_key(key) & ((buckets.len() - 1) as u64)) as usize
        val row = buckets[slot]
        var kept: K[] = []
        var found = false
        var i = 0 as usize
        while i < row.len() {
            if row[i] == key {
                found = true
            } else {
                kept = kept ++ [row[i]]
            }
            i = i + 1
        }
        if found {
            buckets[slot] = kept
            count = count - 1
        }
        found
    }

    pub fun items(): K[] {
        var out: K[] = []
        var b = 0 as usize
        while b < buckets.len() {
            var i = 0 as usize
            while i < buckets[b].len() {
                out = out ++ [buckets[b][i]]
                i = i + 1
            }
            b = b + 1
        }
        out
    }

    pub fun entries(): HashIterator<K> {
        hash_iter(buckets)
    }

    pub fun &clear(): void {
        var fresh: K[][] = []
        var i = 0 as usize
        while i < buckets.len() {
            var empty: K[] = []
            fresh = fresh ++ [empty]
            i = i + 1
        }
        buckets = fresh
        count = 0
    }

    fun &grow_if_needed(): void {
        if count <= buckets.len() * 2 { return }
        var all: K[] = []
        var b = 0 as usize
        while b < buckets.len() {
            var i = 0 as usize
            while i < buckets[b].len() {
                all = all ++ [buckets[b][i]]
                i = i + 1
            }
            b = b + 1
        }
        var fresh: K[][] = []
        var j = 0 as usize
        while j < buckets.len() * 2 {
            var empty: K[] = []
            fresh = fresh ++ [empty]
            j = j + 1
        }
        buckets = fresh
        var k = 0 as usize
        while k < all.len() {
            val key = all[k]
            val slot = (set_hash_key(key) & ((buckets.len() - 1) as u64)) as usize
            buckets[slot] = buckets[slot] ++ [key]
            k = k + 1
        }
    }
}



pub fun new<K>(): HashSet<K> {
    var fresh: K[][] = []
    var i = 0 as usize
    while i < 16 {
        var empty: K[] = []
        fresh = fresh ++ [empty]
        i = i + 1
    }
    HashSet(fresh, 0)
}
