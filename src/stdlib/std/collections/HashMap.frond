// HashMap.frond — K → V hash map with generic keys (part of std.collections)
//
// Any K works: keys hash with Hash.key (std.core.hash: FNV-1a over the
// `"{k}"` representation, every value formats) and compare with `==`
// (engine-level deep equality), so equal keys always match — hash
// collisions only cost bucket walks. Records, ADTs,
// arrays, bool, str, scalars are all valid keys (NaN keys never match since
// NaN != NaN; wrap them if needed).
//
// Separate chaining, ×2 growth at load factor 2, bucket rebuild on remove.
// For i64 keys prefer IntMap — it hashes integers directly (no string
// formatting per operation).
//
//   val m = HashMap.new()
//   m.set("a", 1)
//   m.set(Point(1, 2), "origin")   // record key: compared by content

import std.core.hash

pub type MapEntry<K, V> = MapEntry(pub key: K, pub value: V)

type HashMap<K, V> = HashMap(buckets: MapEntry<K, V>[][], count: usize) {

    pub fun len(): usize { count }

    pub fun is_empty(): bool { count == 0 }

    pub fun has(key: K): bool {
        val row = buckets[(Hash.key(key) & ((buckets.len() - 1) as u64)) as usize]
        var i = 0 as usize
        while i < row.len() {
            if row[i].key == key { return true }
            i = i + 1
        }
        false
    }

    pub fun get(key: K): V? {
        val row = buckets[(Hash.key(key) & ((buckets.len() - 1) as u64)) as usize]
        var i = 0 as usize
        while i < row.len() {
            if row[i].key == key { return row[i].value }
            i = i + 1
        }
        null
    }

    pub fun &set(key: K, value: V): void {
        val slot = (Hash.key(key) & ((buckets.len() - 1) as u64)) as usize
        val row = buckets[slot]
        var i = 0 as usize
        while i < row.len() {
            if row[i].key == key {
                buckets[slot][i] = MapEntry(key, value)
                return
            }
            i = i + 1
        }
        buckets[slot] = row ++ [MapEntry(key, value)]
        count = count + 1
        grow_if_needed()
    }

    pub fun &remove(key: K): bool {
        val slot = (Hash.key(key) & ((buckets.len() - 1) as u64)) as usize
        val row = buckets[slot]
        var kept: MapEntry<K, V>[] = []
        var found = false
        var i = 0 as usize
        while i < row.len() {
            if row[i].key == key {
                found = true
            } else {
                kept = kept ++ [row[i]]
            }
            i = i + 1
        }
        if found {
            buckets[slot] = kept
            count = count - 1
        }
        found
    }

    pub fun keys(): K[] {
        var out: K[] = []
        var b = 0 as usize
        while b < buckets.len() {
            var i = 0 as usize
            while i < buckets[b].len() {
                out = out ++ [buckets[b][i].key]
                i = i + 1
            }
            b = b + 1
        }
        out
    }

    pub fun values(): V[] {
        var out: V[] = []
        var b = 0 as usize
        while b < buckets.len() {
            var i = 0 as usize
            while i < buckets[b].len() {
                out = out ++ [buckets[b][i].value]
                i = i + 1
            }
            b = b + 1
        }
        out
    }

    // Lazy bucket walker (builtin HashIterator): O(n) iteration with zero
    // allocation — no snapshot. Mutation semantics: see HashIterator docs.
    pub fun entries(): HashIterator<MapEntry<K, V>> {
        hash_iter(buckets)
    }

    pub fun &clear(): void {
        var fresh: MapEntry<K, V>[][] = []
        var i = 0 as usize
        while i < buckets.len() {
            var empty: MapEntry<K, V>[] = []
            fresh = fresh ++ [empty]
            i = i + 1
        }
        buckets = fresh
        count = 0
    }

    // Double the bucket array and re-distribute every entry. Inlined inserts
    // (no self-call to set) so growth cannot recurse.
    fun &grow_if_needed(): void {
        if count <= buckets.len() * 2 { return }
        var all: MapEntry<K, V>[] = []
        var b = 0 as usize
        while b < buckets.len() {
            var i = 0 as usize
            while i < buckets[b].len() {
                all = all ++ [buckets[b][i]]
                i = i + 1
            }
            b = b + 1
        }
        var fresh: MapEntry<K, V>[][] = []
        var j = 0 as usize
        while j < buckets.len() * 2 {
            var empty: MapEntry<K, V>[] = []
            fresh = fresh ++ [empty]
            j = j + 1
        }
        buckets = fresh
        var k = 0 as usize
        while k < all.len() {
            val e = all[k]
            val slot = (Hash.key(e.key) & ((buckets.len() - 1) as u64)) as usize
            buckets[slot] = buckets[slot] ++ [e]
            k = k + 1
        }
    }
}



pub fun new<K, V>(): HashMap<K, V> {
    var fresh: MapEntry<K, V>[][] = []
    var i = 0 as usize
    while i < 16 {
        var empty: MapEntry<K, V>[] = []
        fresh = fresh ++ [empty]
        i = i + 1
    }
    HashMap(fresh, 0)
}
