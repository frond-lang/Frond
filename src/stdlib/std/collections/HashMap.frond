// HashMap.frond — generic-key hash map (part of std.collections)
//
// The generic-hashing child of Map<K, V>: everything (lookup, insertion,
// growth, iteration) is inherited; the default `hash_of` (FNV-1a over the
// key's "{k}" representation) is exactly what this container wants, so the
// child body is empty. For i64 keys prefer IntMap (integer-hash override).

type HashMap<K, V>(Map<K, V>) = HashMap() {
}

pub fun empty<K, V>(): HashMap<K, V> {
    val empty: MapEntry<K, V>[] = []
    HashMap([empty, ..16], 0)
}
