// IntMap.frond — i64 → V hash map (part of std.collections)
//
// The i64 fast-path child of Map<i64, V>: the ONLY override is `hash_of`,
// which mixes integers directly through Hash.mix_i64 (std.core.hash fmix64
// mixer — dense and negative key patterns spread evenly; `i64 as u64` keeps
// the bit pattern, so -1 and -2 hash differently) instead of formatting the
// key to a string per operation. Everything else is inherited.

import std.core.hash

type IntMap<V>(Map<i64, V>) = IntMap() {
    fun hash_of(key: i64): u64 { Hash.mix_i64(key) }
}

pub fun empty<V>(): IntMap<V> {
    val empty: MapEntry<i64, V>[] = []
    IntMap([empty, ..16], 0)
}
