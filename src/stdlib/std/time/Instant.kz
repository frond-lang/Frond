// Instant.kz — monotonic clock (synchronous)
//
// Design doc §5.4: Instant newtype + monotonic clock operations
// Instant is based on CLOCK_MONOTONIC, suitable for measuring time intervals (unaffected by system time adjustments).
// Synchronous implementation (cheap syscall, making it async would be more verbose) — decision S04.
// When passing across coroutines, deep copying the i128 internal value is legal — decision S12.

pub type Instant = Instant(nanos: i128) {
    // ─── Time intervals ──────────────────────────────────────────────────────

    // The length of time from now to this
    pub fun elapsed(): Duration {
        Duration(__instant_now_ns() - nanos)
    }

    // The length of time of this relative to earlier (this - earlier, can be negative)
    pub fun duration_since(earlier: Instant): Duration {
        Duration(nanos - earlier.nanos)
    }

    // ─── Add/subtract Duration ─────────────────────────────────────────────────

    pub fun add_duration(d: Duration): Instant {
        Instant(nanos + d.nanos)
    }

    pub fun sub_duration(d: Duration): Instant {
        Instant(nanos - d.nanos)
    }
}

// ─── Current instant ──────────────────────────────────────────────────────

// Gets the current monotonic clock instant
pub fun now(): Instant {
    Instant(__instant_now_ns())
}
