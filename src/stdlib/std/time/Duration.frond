// Duration.frond — time length (nanosecond precision)
//
// Design doc §5.3: Duration newtype + operators
// Internal storage nanos: i128, can express about ±10^11 seconds (3000+ years)
// Differences between Instant / SystemTime / DateTime are all represented as Duration

pub type Duration = Duration(pub nanos: i128) {
    // ─── Converters (convert to various time units) ───────────────────────────────────

    pub fun as_secs(): i64 {
        (nanos / 1_000_000_000) as i64
    }

    pub fun as_millis(): i64 {
        (nanos / 1_000_000) as i64
    }

    pub fun as_micros(): i64 {
        (nanos / 1_000) as i64
    }

    pub fun as_nanos(): i128 {
        nanos
    }

    // Subsecond nanoseconds part (the part less than 1 second), 0..999_999_999
    pub fun subsec_nanos(): u32 {
        (nanos % 1_000_000_000) as u32
    }

    // ─── Operators ──────────────────────────────────────────────────────────

    pub fun add(other: Duration): Duration {
        Duration(nanos + other.nanos)
    }

    pub fun sub(other: Duration): Duration {
        Duration(nanos - other.nanos)
    }

    pub fun mul(factor: i64): Duration {
        Duration(nanos * factor as i128)
    }

    pub fun div(factor: i64): Duration {
        Duration(nanos / factor as i128)
    }

    pub fun is_zero(): bool {
        nanos == 0
    }
}

// ─── Constructors (from various time units) ───────────────────────────────────────

pub fun from_secs(s: i64): Duration {
    Duration(s as i128 * 1_000_000_000)
}

pub fun from_millis(ms: i64): Duration {
    Duration(ms as i128 * 1_000_000)
}

pub fun from_micros(us: i64): Duration {
    Duration(us as i128 * 1_000)
}

pub fun from_nanos(ns: i64): Duration {
    Duration(ns as i128)
}

pub fun from_mins(m: i64): Duration {
    Duration(m as i128 * 60_000_000_000i128)
}

pub fun from_hours(h: i64): Duration {
    Duration(h as i128 * 3_600_000_000_000i128)
}

pub fun from_days(d: i64): Duration {
    Duration(d as i128 * 86_400_000_000_000i128)
}
