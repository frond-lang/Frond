// Timer.frond — async sleep + ticker
//
// Design doc §5.8: async sleep/ticker/timeout
// Only the Time operations in this module are async (sleep blocks the current coroutine); clock reads are synchronous — decision S04.
// ticker/timeout are implemented via channel + background ticker_loop; channel<Instant>(1)
// allows deep copying of newtype elements — decision S12.
//
// sleep implements non-blocking suspension via the Timer type:
// sleep(d) constructs Timer(duration_ns) → Timer.await() → EventSourceKind::Timer
// → resolve_and_check_await lazily starts the timer → frame suspends on TimerFired event
// → timer expires → on_event_arrived wakes the frame (does not block the thread, does not occupy a worker).
// No runtime special-casing: Timer and Channel/Async go through the same generic event source path.

// ─── Timer type ───────────────────────────────────────────────────

// Timer: a timer to be started, internally stores nanosecond-level duration.
// await Timer → EventSourceKind::Timer → runtime lazily starts the timer and suspends the frame.
pub type Timer = Timer(duration_ns: i64)

// ─── sleep ─────────────────────────────────────────────────────────

// Sleeps for the specified Duration (suspends the current coroutine, does not block the thread)
// Duration.as_nanos() returns i128, Timer.duration_ns is i64 (sufficient to cover the practical range)
pub async fun sleep(d: Duration): Async<void> {
    Timer((d.as_nanos()) as i64).await()
}

// Sleeps for the specified number of seconds (convenience overload)
pub async fun sleep_secs(secs: i64): Async<void> {
    Timer(secs * 1_000_000_000).await()
}

// ─── ticker: periodically pushes the current Instant to a channel ────────────────────

// Background loop: sends the current Instant.now() to ch every period
pub async fun ticker_loop(ch: Channel<Instant>, period: Duration): Async<void> {
    loop {
        sleep(period).await()
        ch.send(Instant.now())
    }
}

// Starts a ticker, returns Receiver<Instant>; the caller periodically recv to get timestamps
pub async fun ticker(period: Duration): Async<Receiver<Instant>> {
    val ch = channel<Instant>(1)
    ticker_loop(ch, period)
    ch.receiver
}

// ─── timeout: pushes a single void to a channel after d ───────────────────────

// Background worker: sends a single void to ch after sleep(d), then exits
pub async fun timeout_worker(ch: Channel<void>, d: Duration): Async<void> {
    sleep(d).await()
    ch.send(void)
}

// One-shot timer: returns Receiver<void> immediately; the channel receives void after d
// The caller's recv will block until the timeout triggers (non-await blocking)
// Fix: start timeout_worker in the background (without await), return receiver immediately,
// to avoid the original implementation where sleep(d).await() blocks the timeout function itself,
// causing the caller's await to block for d
pub async fun timeout(d: Duration): Async<Receiver<void>> {
    val ch = channel<void>(1)
    timeout_worker(ch, d)
    ch.receiver
}
