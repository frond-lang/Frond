// Calendar.kz — calendar algorithms (pure Kuzo implementation)
//
// Design doc §5.6: leap year/month days/Julian day/weekday, all written in Kuzo
// Uses Howard Hinnant's Julian day algorithm (refer to std::chrono::year_month_day implementation)
// Because Kuzo's built-in `/` is truncating division (rounds toward 0), while the Julian day
// algorithm requires floor division (rounds toward -∞), floor_div / floor_mod helper functions
// are provided

// ─── Floor division (rounds toward negative infinity) ────────────────────────────────────

// Kuzo's built-in `/` is truncating division (rounds toward 0); floor division needs to be
// corrected based on the sign of the remainder
pub fun floor_div(a: i64, b: i64): i64 {
    val q = a / b
    val r = a % b
    if r != 0 && (r < 0) != (b < 0) {
        q - 1
    } else {
        q
    }
}

pub fun floor_mod(a: i64, b: i64): i64 {
    val r = a % b
    if r != 0 && (r < 0) != (b < 0) {
        r + b
    } else {
        r
    }
}

// i128 version (used for time component conversion, ns precision arithmetic)
pub fun floor_div_i128(a: i128, b: i128): i128 {
    val q = a / b
    val r = a % b
    if r != 0 && (r < 0) != (b < 0) {
        q - 1
    } else {
        q
    }
}

pub fun floor_mod_i128(a: i128, b: i128): i128 {
    val r = a % b
    if r != 0 && (r < 0) != (b < 0) {
        r + b
    } else {
        r
    }
}

// ─── Leap year / month days ────────────────────────────────────────────────

pub fun is_leap_year(year: i32): bool {
    (year % 4 == 0 && year % 100 != 0) || year % 400 == 0
}

pub fun days_in_month(year: i32, month: u8): u8 {
    match month {
        1 | 3 | 5 | 7 | 8 | 10 | 12 => 31,
        4 | 6 | 9 | 11 => 30,
        2 => if is_leap_year(year) { 29 } else { 28 },
        _ => 0,
    }
}

pub fun day_of_year(year: i32, month: u8, day: u8): u16 {
    var total: u16 = 0
    var m: u8 = 1
    while m < month {
        total = total + cast(days_in_month(year, m)).to(u16)
        m = m + 1
    }
    total + cast(day).to(u16)
}

// ─── Julian day (Howard Hinnant algorithm) ────────────────────────────────

// Gregorian date → Julian day (consecutive days since January 1, 4713 BC)
// Algorithm reference: http://howardhinnant.github.io/date_algorithms.html
pub fun to_julian_day(year: i32, month: u8, day: u8): i64 {
    var y = year
    var m = cast(month).to(i32)
    if m <= 2 {
        y = y - 1
        m = m + 12
    }
    val era = if y >= 0 { y } else { y - 399 }
    val era_div = floor_div(cast(era).to(i64), 400)
    val yoe = cast(era).to(i64) - era_div * 400
    val doy = floor_div(cast(153 * (m - 3) + 2).to(i64), 5) + cast(day).to(i64) - 1
    val doe = yoe * 365 + floor_div(yoe, 4) - floor_div(yoe, 100) + doy
    era_div * 146097 + doe + 1721120
}

// Julian day → Gregorian date (returns a record of year/month/day)
pub fun from_julian_day(jd: i64): (year: i32, month: u8, day: u8) {
    val z = jd - 1721120
    val era = floor_div(if z >= 0 { z } else { z - 146096 }, 146097)
    val doe = z - era * 146097
    val yoe = floor_div(doe - floor_div(doe, 1460) + floor_div(doe, 36524) - floor_div(doe, 146096), 365)
    val y = cast(yoe).to(i32) + cast(era).to(i32) * 400
    val doy = doe - (365 * yoe + floor_div(yoe, 4) - floor_div(yoe, 100))
    val mp = floor_div(5 * doy + 2, 153)
    val d = cast(doy - floor_div(153 * mp + 2, 5) + 1).to(u8)
    val m = cast(if mp < 10 { mp + 3 } else { mp - 9 }).to(u8)
    val final_year = if m <= 2 { y + 1 } else { y }
    return (year: final_year, month: m, day: d)
}

// ─── Epoch-related (days since 1970-01-01, pure Kuzo algorithm) ──────────────
//
// Replaces the original daysFromCivil + std.time.epoch implementation in syscall/time.zig.
// days_from_civil is consistent with Howard Hinnant's algorithm; civil_from_days is its inverse.
// Julian day of 1970-01-01 = 2440588 (Julian Day Number).

pub val EPOCH_JULIAN_DAY: i64 = 2440588

// Gregorian date → days since 1970-01-01 (can be negative, meaning before 1970)
pub fun days_from_civil(year: i32, month: u8, day: u8): i64 {
    to_julian_day(year, month, day) - EPOCH_JULIAN_DAY
}

// Days since 1970-01-01 → Gregorian date
pub fun civil_from_days(days: i64): (year: i32, month: u8, day: u8) {
    from_julian_day(days + EPOCH_JULIAN_DAY)
}

// Days since 1970-01-01 → weekday (0=Sunday, 1970-01-01 is Thursday)
pub fun weekday_from_days(days: i64): u8 {
    cast(floor_mod(days + 4, 7)).to(u8)
}

// ─── Weekday ─────────────────────────────────────────────────────────

// Gregorian date → weekday (0=Sunday, 1=Monday, ..., 6=Saturday)
pub fun weekday_of(year: i32, month: u8, day: u8): u8 {
    val jd = to_julian_day(year, month, day)
    cast(floor_mod(jd + 1, 7)).to(u8)
}

// ─── Date arithmetic ─────────────────────────────────────────────────────

// Adds/subtracts days to/from a date, returns the new date
pub fun add_days(year: i32, month: u8, day: u8, days: i64): (year: i32, month: u8, day: u8) {
    val jd = to_julian_day(year, month, day) + days
    from_julian_day(jd)
}

// Number of days between two dates (y2/m2/d2 - y1/m1/d1)
pub fun days_between(y1: i32, m1: u8, d1: u8, y2: i32, m2: u8, d2: u8): i64 {
    to_julian_day(y2, m2, d2) - to_julian_day(y1, m1, d1)
}
