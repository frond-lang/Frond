// Buffered.frond — BufReader + BufWriter
//
// Design doc §4.5: Buffered IO wrapper
// BufReader maintains (inner File, buf u8[], pos usize, cap usize) state machine:
//   pos is the current read position, cap is the filled byte length; when pos >= cap, trigger lower-level read to fill.
// BufWriter maintains (inner File, buf u8[], pos usize) state machine:
//   pos is the current write position; when pos == buf.len(), trigger flush to lower-level write.
// All methods are async, returning Async<Throw<T, IOError>>.

// ─── Type definitions ──────────────────────────────────────────────

pub type BufReader = BufReader(inner: File, buf: u8[], pos: usize, cap: usize) {
    // ─── BufReader methods ──────────────────────────────────────────

    // Read one line (until '\n' or EOF)
    // Return content without '\n'; return empty string at EOF to indicate end of stream
    // Optimization: accumulate entire slices with str (via concatInPlace amortized O(n)), avoid O(n²) of u8[] ++
    pub async fun read_line(): Async<Throw<str, IOError>> {
        var result: str = ""
        loop {
            if pos >= cap {
                pos = 0
                buf = inner.read(File.DEFAULT_BUF_SIZE).await()?
                cap = buf.len()
                if cap == 0 {
                    return Ok(result)
                }
            }
            // Scan buf for '\n', record current segment start
            val seg_start = pos
            var found_newline = false
            while pos < cap {
                val b = buf[pos]
                pos = pos + 1
                if b == '\n' as u8 {
                    found_newline = true
                    break
                }
            }
            // Append this segment (without '\n') to result
            val seg_end = if found_newline { pos - 1 } else { pos }
            if seg_end > seg_start {
                result = result + (buf[seg_start..seg_end]) as str
            }
            if found_newline {
                return Ok(result)
            }
        }
    }

    // Read all remaining bytes into u8[]
    // Optimization: accumulate entire slices with str (amortized O(n)), finally .bytes() converts to u8[]
    pub async fun read_to_end(): Async<Throw<u8[], IOError>> {
        var result: str = ""
        loop {
            if pos >= cap {
                pos = 0
                buf = inner.read(File.DEFAULT_BUF_SIZE).await()?
                cap = buf.len()
                if cap == 0 {
                    return Ok(result.bytes())
                }
            }
            val chunk = buf[pos..cap]
            result = result + chunk as str
            pos = cap
        }
    }

    // Read all remaining bytes and decode as str using UTF-8
    pub async fun read_to_string(): Async<Throw<str, IOError>> {
        val bytes = read_to_end().await()?
        bytes as str
    }

    // Read a single byte; return null at EOF
    pub async fun read_byte(): Async<Throw<u8?, IOError>> {
        if pos >= cap {
            pos = 0
            buf = inner.read(File.DEFAULT_BUF_SIZE).await()?
            cap = buf.len()
            if cap == 0 { return Ok(null) }
        }
        val b = buf[pos]
        pos = pos + 1
        Ok(b)
    }
}

pub type BufWriter = BufWriter(inner: File, buf: u8[], pos: usize) {
    // ─── BufWriter methods ──────────────────────────────────────────

    // Write byte sequence; auto flush when buffer is full
    pub async fun write(data: u8[]): Async<Throw<void, IOError>> {
        var i: usize = 0
        while i < data.len() {
            while pos < buf.len() && i < data.len() {
                buf[pos] = data[i]
                pos = pos + 1
                i = i + 1
            }
            if pos == buf.len() {
                flush().await()?
            }
        }
        Ok(void)
    }

    // Write string (UTF-8 byte sequence)
    pub async fun write_str(s: str): Async<Throw<void, IOError>> {
        write(s.bytes()).await()?
        Ok(void)
    }

    // Write string and append newline
    pub async fun write_line(s: str): Async<Throw<void, IOError>> {
        write_str(s).await()?
        write_str("\n").await()?
        Ok(void)
    }

    // Write all remaining bytes in buffer to lower-level File
    pub async fun flush(): Async<Throw<void, IOError>> {
        if pos > 0 {
            var written: usize = 0
            while written < pos {
                val chunk = buf[written..pos]
                val n = inner.write(chunk, chunk.len()).await()?
                if n == 0 {
                    // Wrote 0 bytes but still has unwritten data — avoid infinite loop, treat as BrokenPipe
                    throw IOError(BrokenPipe, "flush: write returned 0", 32, inner.path.to_str())
                }
                written = written + n
            }
            pos = 0
        }
        Ok(void)
    }
}

// ─── Constructors ──────────────────────────────────────────────────

pub fun new_reader(file: File): BufReader {
    BufReader(file, [], 0, 0)
}

pub fun new_writer(file: File): BufWriter {
    BufWriter(file, [0, ..File.DEFAULT_BUF_SIZE], 0)
}
