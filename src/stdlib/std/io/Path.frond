// Path.frond — Cross-platform path abstraction (pure Frond implementation, no syscall dependency)
//
// Design doc §4.4: Path newtype + path operations
// Path internally stores segments (normalized non-empty segment list) + is_absolute flag
//
// Phase 2 refactor: completely remove __path_* syscall dependency
// - Separator normalization: '\' → '/', remove redundant '.'
// - Path splitting: split by '/' and filter empty segments and current directory markers
// - Absoluteness: detect whether the first character is '/'
// - Path join: segments array concatenation + absoluteness inheritance

pub type Path = Path(segments: str[], is_absolute: bool) {
    // ─── Conversion ─────────────────────────────────────────────────

    pub fun to_str(): str {
        join_segments_to_str(segments, is_absolute)
    }

    // ─── Join ───────────────────────────────────────────────────────

    pub fun join(other: Path): Path {
        Path(segments ++ other.segments, is_absolute)
    }

    pub fun join_str(other: str): Path {
        join(path_from(other))
    }

    // ─── Path decomposition ─────────────────────────────────────────

    // Parent directory: remove the last segment. Root path or empty segments return null
    pub fun parent(): Path? {
        val len = segments.len()
        if len == 0 {
            null
        } else {
            val parent_segs = segments[0..len - 1]
            Path(parent_segs, is_absolute)
        }
    }

    // Trailing segment (filename). Empty segments return null
    pub fun filename(): str? {
        val len = segments.len()
        if len == 0 {
            null
        } else {
            segments[len - 1]
        }
    }

    // Extension (without dot). No dot or dot at first position returns null
    pub fun extension(): str? {
        val fname = filename()
        match fname {
            null => null,
            name => {
                val dot = std.io.Path.last_index_of(name, '.')
                if dot <= 0 {
                    null
                } else {
                    val dot_idx = dot as usize
                    name[dot_idx + 1..name.len()]
                }
            },
        }
    }

    // Filename (without extension). No dot returns full filename
    pub fun file_stem(): str? {
        match filename() {
            null => null,
            name => {
                val dot = last_index_of(name, '.')
                if dot <= 0 {
                    name
                } else {
                    val dot_idx = dot as usize
                    name[0..dot_idx]
                }
            },
        }
    }

    // ─── Query ─────────────────────────────────────────────────────────

    pub fun is_absolute_path(): bool { is_absolute }

    pub fun is_relative_path(): bool { !is_absolute }
}

// ─── Helper functions ────────────────────────────────────────────

// Path separator normalization: '\' → '/'
// Does not call syscall, pure string scan and replace
// Optimization: accumulate with str (via concatInPlace amortized O(n)), avoid O(n²) of u8[] ++
pub fun normalize_seps(s: str): str {
    var out: str = ""
    var i: usize = 0
    var seg_start: usize = 0
    // Accumulate by segment: on backslash record the previous segment and append '/', otherwise append as-is
    while i < s.len() {
        val c = s[i]
        if c == '\\' {
            if i > seg_start {
                out = out + s[seg_start..i]
            }
            out = out + "/"
            seg_start = i + 1
        }
        i = i + 1
    }
    // Append trailing segment
    if seg_start < s.len() {
        out = out + s[seg_start..s.len()]
    }
    out
}

// Split string by separator, filter empty segments and "." (current directory)
// Return list of segments that are non-empty and not "."
pub fun split_segments(s: str): str[] {
    var result: str[] = []
    var start: usize = 0
    var i: usize = 0
    while i < s.len() {
        val c = s[i]
        if c == '/' || c == '\\' {
            if i > start {
                val seg = s[start..i]
                if seg != "." && seg != "" {
                    result = result ++ [seg]
                }
            }
            start = i + 1
        }
        i = i + 1
    }
    // Handle trailing segment
    if start < s.len() {
        val seg = s[start..s.len()]
        if seg != "." && seg != "" {
            result = result ++ [seg]
        }
    }
    result
}

// Join path segments into a string
// When abs=true prefix with '/', otherwise no prefix
// Use __str_array_join for one-shot O(n) join, avoid O(n²) of loop result = result + seg
pub fun join_segments_to_str(segs: str[], abs: bool): str {
    if abs {
        return "/" + __str_array_join(segs, "/")
    }
    __str_array_join(segs, "/")
}

// Find the last position of a character in a string (character index, Unicode scalar value)
// Returns -1 if not found
pub fun last_index_of(s: str, ch: char): i64 {
    var i: usize = s.len()
    while i > 0 {
        i = i - 1
        if s[i] == ch {
            return i as i64
        }
    }
    return -1
}

// ─── Construction ────────────────────────────────────────────────

// Construct Path from string: normalize separators → split → record absoluteness
pub fun path_from(s: str): Path {
    val normalized = normalize_seps(s)
    val parts = split_segments(normalized)
    val abs = normalized.len() > 0 && normalized[0] == '/'
    Path(parts, abs)
}
