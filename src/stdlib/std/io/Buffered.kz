// Buffered.kz — BufReader + BufWriter
//
// 设计文档 §4.5：缓冲 IO 包装
// BufReader 维护 (inner File, buf u8[], pos usize, cap usize) 状态机：
//   pos 当前读位置，cap 已填充字节长度；pos >= cap 时触发下层 read 填充。
// BufWriter 维护 (inner File, buf u8[], pos usize) 状态机：
//   pos 当前写位置；pos == buf.len() 时触发 flush 到下层 write。
// 所有方法为 async，返回 Async<Throw<T, IOError>>。

// ─── 类型定义 ──────────────────────────────────────────────────────

pub type BufReader = BufReader(inner: File, buf: u8[], pos: usize, cap: usize) {
    // ─── BufReader 方法 ────────────────────────────────────────────

    // 读取一行（直到 '\n' 或 EOF）
    // 返回不含 '\n' 的内容；EOF 时返回空串表示流结束
    // 优化：用 str 累积整段切片（走 concatInPlace amortized O(n)），避免 u8[] ++ 的 O(n²)
    pub async fun read_line(): Async<Throw<str, IOError>> {
        var result: str = ""
        loop {
            if pos >= cap {
                pos = 0
                buf = inner.read(File.DEFAULT_BUF_SIZE).await()?
                cap = buf.len()
                if cap == 0 {
                    return Ok(result)
                }
            }
            // 扫描 buf 寻找 '\n'，记录本段起点
            val seg_start = pos
            var found_newline = false
            while pos < cap {
                val b = buf[pos]
                pos = pos + 1
                if b == cast('\n').to(u8) {
                    found_newline = true
                    break
                }
            }
            // 将本段（不含 '\n'）追加到 result
            val seg_end = if found_newline { pos - 1 } else { pos }
            if seg_end > seg_start {
                result = result + cast(buf[seg_start..seg_end]).to(str)
            }
            if found_newline {
                return Ok(result)
            }
        }
    }

    // 读取全部剩余字节到 u8[]
    // 优化：用 str 累积整段切片（amortized O(n)），最后 .bytes() 转 u8[]
    pub async fun read_to_end(): Async<Throw<u8[], IOError>> {
        var result: str = ""
        loop {
            if pos >= cap {
                pos = 0
                buf = inner.read(File.DEFAULT_BUF_SIZE).await()?
                cap = buf.len()
                if cap == 0 {
                    return Ok(result.bytes())
                }
            }
            val chunk = buf[pos..cap]
            result = result + cast(chunk).to(str)
            pos = cap
        }
    }

    // 读取全部剩余字节并按 UTF-8 解码为 str
    pub async fun read_to_string(): Async<Throw<str, IOError>> {
        val bytes = read_to_end().await()?
        cast(bytes).to(str)
    }

    // 读取单字节；EOF 返回 null
    pub async fun read_byte(): Async<Throw<u8?, IOError>> {
        if pos >= cap {
            pos = 0
            buf = inner.read(File.DEFAULT_BUF_SIZE).await()?
            cap = buf.len()
            if cap == 0 { return Ok(null) }
        }
        val b = buf[pos]
        pos = pos + 1
        Ok(b)
    }
}

pub type BufWriter = BufWriter(inner: File, buf: u8[], pos: usize) {
    // ─── BufWriter 方法 ────────────────────────────────────────────

    // 写入字节序列；缓冲满时自动 flush
    pub async fun write(data: u8[]): Async<Throw<void, IOError>> {
        var i: usize = 0
        while i < data.len() {
            while pos < buf.len() && i < data.len() {
                buf[pos] = data[i]
                pos = pos + 1
                i = i + 1
            }
            if pos == buf.len() {
                flush().await()?
            }
        }
        Ok(void)
    }

    // 写入字符串（UTF-8 字节序列）
    pub async fun write_str(s: str): Async<Throw<void, IOError>> {
        write(s.bytes()).await()?
        Ok(void)
    }

    // 写入字符串并追加换行
    pub async fun write_line(s: str): Async<Throw<void, IOError>> {
        write_str(s).await()?
        write_str("\n").await()?
        Ok(void)
    }

    // 将缓冲区剩余字节全部写入下层 File
    pub async fun flush(): Async<Throw<void, IOError>> {
        if pos > 0 {
            var written: usize = 0
            while written < pos {
                val chunk = buf[written..pos]
                val n = inner.write(chunk, chunk.len()).await()?
                if n == 0 {
                    // 写入 0 字节但仍有未写数据——避免死循环，按 BrokenPipe 处理
                    throw IOError(BrokenPipe, "flush: write returned 0", 32, inner.path)
                }
                written = written + n
            }
            pos = 0
        }
        Ok(void)
    }
}

// ─── 构造器 ────────────────────────────────────────────────────────

pub fun new_reader(file: File): BufReader {
    BufReader(file, [], 0, 0)
}

pub fun new_writer(file: File): BufWriter {
    BufWriter(file, [0u8, ..File.DEFAULT_BUF_SIZE], 0)
}
