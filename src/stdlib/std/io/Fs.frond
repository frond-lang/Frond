// Fs.frond — One-shot read/write convenience functions
//
// Design doc §4.7: Fs convenience API
// Combine File.open + read/write + close three steps into a single call,
// suitable for scripting scenarios; for high-throughput scenarios use File + Buffered directly.
//
// API convention (2026-08-17): io APIs take/return Path only — the single
// path currency across std (str spellings go through Path.from / .to_str()).

// ─── Text IO ──────────────────────────────────────────────────────

// One-shot read entire file content as str
pub async fun read_file(path: Path): Async<Throw<str, IOError>> {
    val f = File.open(path, File.read_only()).await()?
    defer f.close().await()
    val reader = Buffered.new_reader(f)
    reader.read_to_string().await()?
}

// One-shot write str to file (overwrite existing content)
pub async fun write_file(path: Path, content: str): Async<Throw<void, IOError>> {
    val f = File.open(path, File.create_rw()).await()?
    defer f.close().await()
    val writer = Buffered.new_writer(f)
    writer.write_str(content).await()?
    writer.flush().await()?
    Ok(void)
}

// Append write str to end of file
pub async fun append_file(path: Path, content: str): Async<Throw<void, IOError>> {
    val f = File.open(path, File.append_mode()).await()?
    defer f.close().await()
    val bytes = content.bytes()
    f.write(bytes, bytes.len()).await()?
    Ok(void)
}

// ─── Byte IO ──────────────────────────────────────────────────────

// One-shot read entire file bytes
pub async fun read_file_bytes(path: Path): Async<Throw<u8[], IOError>> {
    val f = File.open(path, File.read_only()).await()?
    defer f.close().await()
    val reader = Buffered.new_reader(f)
    reader.read_to_end().await()?
}

// One-shot write bytes to file (overwrite existing content)
pub async fun write_file_bytes(path: Path, content: u8[]): Async<Throw<void, IOError>> {
    val f = File.open(path, File.create_rw()).await()?
    defer f.close().await()
    f.write(content, content.len()).await()?
    Ok(void)
}

// ─── File-system management ───────────────────────────────────────

// Whether the path exists (false for a missing path is NOT an error;
// a Throw Err is reserved for host-level failures).
pub async fun exists(path: Path): Async<Throw<bool, IOError>> {
    Ok(__file_exists_raw(path.to_str()) != 0)
}

// Copy a file, overwriting dst if it exists. Metadata is not preserved
// (a fresh destination file is created), matching a plain byte copy.
pub async fun copy_file(src: Path, dst: Path): Async<Throw<void, IOError>> {
    val rc = __file_copy_raw(src.to_str(), dst.to_str())
    if rc < 0 {
        throw IOError(Other, "copy failed: " + src.to_str() + " -> " + dst.to_str(), 0, dst.to_str())
    }
    Ok(void)
}

// Change file permission bits.
// NOTE Windows semantics downgrade: only the read-only bit is honored
// (setting any write bit clears read-only, clearing all write bits sets it).
pub async fun chmod(path: Path, mode: i32): Async<Throw<void, IOError>> {
    val rc = __file_chmod_raw(path.to_str(), mode)
    if rc < 0 {
        throw IOError(Other, "chmod failed", 0, path.to_str())
    }
    Ok(void)
}

// Resolve a path to its absolute, normalized form (realpath(3) semantics:
// resolves symlinks and ../ segments against the working directory).
// Windows: _fullpath — separator normalization and ..-removal only, no
// symlink resolution (the Windows io layer has no symlink support at all).
pub async fun realpath(path: Path): Async<Throw<Path, IOError>> {
    val buf: u8[] = [0, ..4096]
    val n = __fs_realpath_into(path.to_str(), buf)
    if n < 0 {
        throw IOError(NotFound, "realpath failed: " + path.to_str(), 0, path.to_str())
    }
    Ok(Path.from((buf[0..n as usize]) as str))
}
