// I64.frond — the i64 integer type module (part of std.core)
//
// Boundary constants + decimal parse. parse returns null on malformed input
// (empty, bad sign position, non-digit); accumulation wraps on overflow by
// design — check ranges yourself when inputs are untrusted.

pub val MAX: i64 = 9223372036854775807
pub val MIN: i64 = -9223372036854775808

pub fun parse(s: str): i64? {
    val b = s.bytes()
    if b.len() == 0 { return null }
    var neg = false
    var i = 0 as usize
    if b[0] == (45 as u8) { neg = true; i = 1 as usize }
    if i >= b.len() { return null }
    var v: i64 = 0
    while i < b.len() {
        val d = (b[i] as i64) - 48
        if d < 0 || d > 9 { return null }
        v = v * 10 + d
        i = i + 1
    }
    if neg { 0 - v } else { v }
}
