// std/core package declaration
//
// std.core is the root library: each sub-library is a directory whose
// pack.frond declares its packs. `import std.core` loads EVERY sub-library
// declared below; individual sub-libraries stay importable on their own
// (`import std.core.types`).
//
//   types/  — value-type namespaces: Str, I8..I128, U8..U128, F16..F128, Bool
//   fmt/    — number formatting: integer radix 2..36, hex/oct/bin, padding
//   hash/   — hash algorithm collection: FNV-1a, CRC-32, Adler-32, xxHash64
//             (+ the collections key scheme and fmix64 mixer in Hash)
pub pack types
pub pack fmt
pub pack hash
