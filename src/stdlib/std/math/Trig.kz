// Math standard library — Trigonometric and hyperbolic functions
//
// Pure Frond implementation, algorithm: Taylor series + argument reduction.
// Depends on Round.kz for fmod implementation, Power.kz for exp/log/sqrt implementation.
// Generic functions use match x.type_name() to dispatch to the corresponding precision implementation.

// ─── sin (sine, argument reduction + Taylor) ───
// r = fmod(x, 2π), reduced to [-π,π]; sin(r) = r - r³/3! + r⁵/5! - ...

@internal
fun sin_f64_impl(x: f64): f64 {
    val two_pi = 0x1.921fb54442d18p+2
    val pi = 0x1.921fb54442d18p+1
    var r = fmod_f64_impl(x, two_pi)
    if r > pi { r = r - two_pi }
    if r < 0.0 - pi { r = r + two_pi }
    val r2 = r * r
    var term = r
    var sum = term
    var f1 = 2
    var f2 = 3
    while f2 <= 29 {
        term = (0.0 - term * r2) / f1 as f64 / f2 as f64
        sum = sum + term
        f1 = f1 + 2
        f2 = f2 + 2
    }
    sum
}
@internal
fun sin_f32_impl(x: f32): f32 {
    val two_pi: f32 = 0x1.921fb6p+2f32
    val pi: f32 = 0x1.921fb6p+1f32
    var r = fmod_f32_impl(x, two_pi)
    if r > pi { r = r - two_pi }
    if r < 0.0 - pi { r = r + two_pi }
    val r2 = r * r
    var term = r
    var sum = term
    var f1 = 2
    var f2 = 3
    while f2 <= 19 {
        term = (0.0 - term * r2) / f1 as f32 / f2 as f32
        sum = sum + term
        f1 = f1 + 2
        f2 = f2 + 2
    }
    sum
}
@internal
fun sin_f16_impl(x: f16): f16 {
    val two_pi: f16 = 0x1.92p+2f16
    val pi: f16 = 0x1.92p+1f16
    var r = fmod_f16_impl(x, two_pi)
    if r > pi { r = r - two_pi }
    if r < 0.0 - pi { r = r + two_pi }
    val r2 = r * r
    var term = r
    var sum = term
    var f1 = 2
    var f2 = 3
    while f2 <= 9 {
        term = (0.0 - term * r2) / f1 as f16 / f2 as f16
        sum = sum + term
        f1 = f1 + 2
        f2 = f2 + 2
    }
    sum
}
@internal
fun sin_f128_impl(x: f128): f128 {
    val two_pi = 0x1.921fb54442d18469898cc51701b8p+2f128
    val pi = 0x1.921fb54442d18469898cc51701b8p+1f128
    var r = fmod_f128_impl(x, two_pi)
    if r > pi { r = r - two_pi }
    if r < 0.0 - pi { r = r + two_pi }
    val r2 = r * r
    var term = r
    var sum = term
    var f1 = 2
    var f2 = 3
    while f2 <= 59 {
        term = (0.0 - term * r2) / f1 as f128 / f2 as f128
        sum = sum + term
        f1 = f1 + 2
        f2 = f2 + 2
    }
    sum
}

pub fun sin<T>(x: T): T {
    match x.type_name() {
        "f64" => (sin_f64_impl(x as f64)) as T,
        "f32" => (sin_f32_impl(x as f32)) as T,
        "f16" => (sin_f16_impl(x as f16)) as T,
        "f128" => (sin_f128_impl(x as f128)) as T,
        _ => x
    }
}

// ─── cos (cosine, cos(x) = sin(x + π/2)) ───

@internal
fun cos_f64_impl(x: f64): f64 {
    val pi_half = 0x1.921fb54442d18p+0
    sin_f64_impl(x + pi_half)
}
@internal
fun cos_f32_impl(x: f32): f32 {
    val pi_half: f32 = 0x1.921fb6p+0f32
    sin_f32_impl(x + pi_half)
}
@internal
fun cos_f16_impl(x: f16): f16 {
    val pi_half: f16 = 0x1.92p+0f16
    sin_f16_impl(x + pi_half)
}
@internal
fun cos_f128_impl(x: f128): f128 {
    val pi_half = 0x1.921fb54442d18469898cc51701b8p+0f128
    sin_f128_impl(x + pi_half)
}

pub fun cos<T>(x: T): T {
    match x.type_name() {
        "f64" => (cos_f64_impl(x as f64)) as T,
        "f32" => (cos_f32_impl(x as f32)) as T,
        "f16" => (cos_f16_impl(x as f16)) as T,
        "f128" => (cos_f128_impl(x as f128)) as T,
        _ => x
    }
}

// ─── tan (tangent, sin(x)/cos(x), returns Inf when cos==0) ───

@internal
fun tan_f64_impl(x: f64): f64 {
    val s = sin_f64_impl(x)
    val c = cos_f64_impl(x)
    if c == 0.0 { return 1.0 / 0.0 }
    s / c
}
@internal
fun tan_f32_impl(x: f32): f32 {
    val s = sin_f32_impl(x)
    val c = cos_f32_impl(x)
    if c == 0.0 { return 1.0f32 / 0.0f32 }
    s / c
}
@internal
fun tan_f16_impl(x: f16): f16 {
    val s = sin_f16_impl(x)
    val c = cos_f16_impl(x)
    if c == 0.0 { return 1.0f16 / 0.0f16 }
    s / c
}
@internal
fun tan_f128_impl(x: f128): f128 {
    val s = sin_f128_impl(x)
    val c = cos_f128_impl(x)
    if c == 0.0 { return 1.0f128 / 0.0f128 }
    s / c
}

pub fun tan<T>(x: T): T {
    match x.type_name() {
        "f64" => (tan_f64_impl(x as f64)) as T,
        "f32" => (tan_f32_impl(x as f32)) as T,
        "f16" => (tan_f16_impl(x as f16)) as T,
        "f128" => (tan_f128_impl(x as f128)) as T,
        _ => x
    }
}

// ─── sinh (hyperbolic sine, (exp(x) - exp(-x)) / 2) ───

@internal
fun sinh_f64_impl(x: f64): f64 {
    val ex = exp_f64_impl(x)
    val enx = exp_f64_impl(0.0 - x)
    val diff = ex - enx
    diff / 2.0
}
@internal
fun sinh_f32_impl(x: f32): f32 {
    val ex = exp_f32_impl(x)
    val enx = exp_f32_impl(0.0 - x)
    val diff = ex - enx
    diff / 2.0
}
@internal
fun sinh_f16_impl(x: f16): f16 {
    val ex = exp_f16_impl(x)
    val enx = exp_f16_impl(0.0 - x)
    val diff = ex - enx
    diff / 2.0
}
@internal
fun sinh_f128_impl(x: f128): f128 {
    val ex = exp_f128_impl(x)
    val enx = exp_f128_impl(0.0 - x)
    val diff = ex - enx
    diff / 2.0
}

pub fun sinh<T>(x: T): T {
    match x.type_name() {
        "f64" => (sinh_f64_impl(x as f64)) as T,
        "f32" => (sinh_f32_impl(x as f32)) as T,
        "f16" => (sinh_f16_impl(x as f16)) as T,
        "f128" => (sinh_f128_impl(x as f128)) as T,
        _ => x
    }
}

// ─── cosh (hyperbolic cosine, (exp(x) + exp(-x)) / 2) ───

@internal
fun cosh_f64_impl(x: f64): f64 {
    val ex = exp_f64_impl(x)
    val enx = exp_f64_impl(0.0 - x)
    val sum = ex + enx
    sum / 2.0
}
@internal
fun cosh_f32_impl(x: f32): f32 {
    val ex = exp_f32_impl(x)
    val enx = exp_f32_impl(0.0 - x)
    val sum = ex + enx
    sum / 2.0
}
@internal
fun cosh_f16_impl(x: f16): f16 {
    val ex = exp_f16_impl(x)
    val enx = exp_f16_impl(0.0 - x)
    val sum = ex + enx
    sum / 2.0
}
@internal
fun cosh_f128_impl(x: f128): f128 {
    val ex = exp_f128_impl(x)
    val enx = exp_f128_impl(0.0 - x)
    val sum = ex + enx
    sum / 2.0
}

pub fun cosh<T>(x: T): T {
    match x.type_name() {
        "f64" => (cosh_f64_impl(x as f64)) as T,
        "f32" => (cosh_f32_impl(x as f32)) as T,
        "f16" => (cosh_f16_impl(x as f16)) as T,
        "f128" => (cosh_f128_impl(x as f128)) as T,
        _ => x
    }
}

// ─── tanh (hyperbolic tangent, (exp(x) - exp(-x)) / (exp(x) + exp(-x))) ───

@internal
fun tanh_f64_impl(x: f64): f64 {
    val ex = exp_f64_impl(x)
    val enx = exp_f64_impl(0.0 - x)
    val diff = ex - enx
    val sum = ex + enx
    diff / sum
}
@internal
fun tanh_f32_impl(x: f32): f32 {
    val ex = exp_f32_impl(x)
    val enx = exp_f32_impl(0.0 - x)
    val diff = ex - enx
    val sum = ex + enx
    diff / sum
}
@internal
fun tanh_f16_impl(x: f16): f16 {
    val ex = exp_f16_impl(x)
    val enx = exp_f16_impl(0.0 - x)
    val diff = ex - enx
    val sum = ex + enx
    diff / sum
}
@internal
fun tanh_f128_impl(x: f128): f128 {
    val ex = exp_f128_impl(x)
    val enx = exp_f128_impl(0.0 - x)
    val diff = ex - enx
    val sum = ex + enx
    diff / sum
}

pub fun tanh<T>(x: T): T {
    match x.type_name() {
        "f64" => (tanh_f64_impl(x as f64)) as T,
        "f32" => (tanh_f32_impl(x as f32)) as T,
        "f16" => (tanh_f16_impl(x as f16)) as T,
        "f128" => (tanh_f128_impl(x as f128)) as T,
        _ => x
    }
}

// ─── atan (arctangent, polynomial approximation) ───
// |x|<=1: atan(x) = x - x³/3 + x⁵/5 - ...
// |x|>1:  atan(x) = ±(π/2 - atan(1/|x|))

@internal
fun atan_f64_impl(x: f64): f64 {
    val pi_half = 0x1.921fb54442d18p+0
    if x == 0.0 { return 0.0 }
    var a = if x < 0.0 { 0.0 - x } else { x }
    var inv = 0
    if a > 1.0 {
        inv = 1
        a = 1.0 / a
    }
    val x2 = a * a
    var term = a
    var sum = term
    var d = 3
    while d <= 39 {
        term = term * x2
        val t = term / d as f64
        if d % 4 == 3 { sum = sum - t } else { sum = sum + t }
        d = d + 2
    }
    var result = sum
    if inv == 1 { result = pi_half - sum }
    if x < 0.0 { result = 0.0 - result }
    result
}
@internal
fun atan_f32_impl(x: f32): f32 {
    val pi_half: f32 = 0x1.921fb6p+0f32
    if x == 0.0 { return 0.0 }
    var a = if x < 0.0 { 0.0 - x } else { x }
    var inv = 0
    if a > 1.0 {
        inv = 1
        a = 1.0 / a
    }
    val x2 = a * a
    var term = a
    var sum = term
    var d = 3
    while d <= 29 {
        term = term * x2
        val t = term / d as f32
        if d % 4 == 3 { sum = sum - t } else { sum = sum + t }
        d = d + 2
    }
    var result = sum
    if inv == 1 { result = pi_half - sum }
    if x < 0.0 { result = 0.0 - result }
    result
}
@internal
fun atan_f16_impl(x: f16): f16 {
    val pi_half: f16 = 0x1.92p+0f16
    if x == 0.0 { return 0.0 }
    var a = if x < 0.0 { 0.0 - x } else { x }
    var inv = 0
    if a > 1.0 {
        inv = 1
        a = 1.0 / a
    }
    val x2 = a * a
    var term = a
    var sum = term
    var d = 3
    while d <= 15 {
        term = term * x2
        val t = term / d as f16
        if d % 4 == 3 { sum = sum - t } else { sum = sum + t }
        d = d + 2
    }
    var result = sum
    if inv == 1 { result = pi_half - sum }
    if x < 0.0 { result = 0.0 - result }
    result
}
@internal
fun atan_f128_impl(x: f128): f128 {
    val pi_half = 0x1.921fb54442d18469898cc51701b8p+0f128
    if x == 0.0 { return 0.0 }
    var a = if x < 0.0 { 0.0 - x } else { x }
    var inv = 0
    if a > 1.0 {
        inv = 1
        a = 1.0 / a
    }
    val x2 = a * a
    var term = a
    var sum = term
    var d = 3
    while d <= 79 {
        term = term * x2
        val t = term / d as f128
        if d % 4 == 3 { sum = sum - t } else { sum = sum + t }
        d = d + 2
    }
    var result = sum
    if inv == 1 { result = pi_half - sum }
    if x < 0.0 { result = 0.0 - result }
    result
}

pub fun atan<T>(x: T): T {
    match x.type_name() {
        "f64" => (atan_f64_impl(x as f64)) as T,
        "f32" => (atan_f32_impl(x as f32)) as T,
        "f16" => (atan_f16_impl(x as f16)) as T,
        "f128" => (atan_f128_impl(x as f128)) as T,
        _ => x
    }
}

// ─── asin (arcsine, atan(x / sqrt(1-x²))) ───
// |x|>1 returns NaN, x==±1 returns ±π/2

@internal
fun asin_f64_impl(x: f64): f64 {
    val pi_half = 0x1.921fb54442d18p+0
    if x > 1.0 || x < 0.0 - 1.0 { return 0.0 / 0.0 }
    if x == 1.0 { return pi_half }
    if x == 0.0 - 1.0 { return 0.0 - pi_half }
    atan_f64_impl(x / sqrt_f64_impl(1.0 - x * x))
}
@internal
fun asin_f32_impl(x: f32): f32 {
    val pi_half: f32 = 0x1.921fb6p+0f32
    if x > 1.0 || x < 0.0 - 1.0 { return 0.0f32 / 0.0f32 }
    if x == 1.0 { return pi_half }
    if x == 0.0 - 1.0 { return 0.0 - pi_half }
    atan_f32_impl(x / sqrt_f32_impl(1.0 - x * x))
}
@internal
fun asin_f16_impl(x: f16): f16 {
    val pi_half: f16 = 0x1.92p+0f16
    if x > 1.0 || x < 0.0 - 1.0 { return 0.0f16 / 0.0f16 }
    if x == 1.0 { return pi_half }
    if x == 0.0 - 1.0 { return 0.0 - pi_half }
    atan_f16_impl(x / sqrt_f16_impl(1.0 - x * x))
}
@internal
fun asin_f128_impl(x: f128): f128 {
    val pi_half = 0x1.921fb54442d18469898cc51701b8p+0f128
    if x > 1.0 || x < 0.0 - 1.0 { return 0.0f128 / 0.0f128 }
    if x == 1.0 { return pi_half }
    if x == 0.0 - 1.0 { return 0.0 - pi_half }
    atan_f128_impl(x / sqrt_f128_impl(1.0 - x * x))
}

pub fun asin<T>(x: T): T {
    match x.type_name() {
        "f64" => (asin_f64_impl(x as f64)) as T,
        "f32" => (asin_f32_impl(x as f32)) as T,
        "f16" => (asin_f16_impl(x as f16)) as T,
        "f128" => (asin_f128_impl(x as f128)) as T,
        _ => x
    }
}

// ─── acos (arccosine, π/2 - asin(x)) ───

@internal
fun acos_f64_impl(x: f64): f64 {
    val pi_half = 0x1.921fb54442d18p+0
    pi_half - asin_f64_impl(x)
}
@internal
fun acos_f32_impl(x: f32): f32 {
    val pi_half: f32 = 0x1.921fb6p+0f32
    pi_half - asin_f32_impl(x)
}
@internal
fun acos_f16_impl(x: f16): f16 {
    val pi_half: f16 = 0x1.92p+0f16
    pi_half - asin_f16_impl(x)
}
@internal
fun acos_f128_impl(x: f128): f128 {
    val pi_half = 0x1.921fb54442d18469898cc51701b8p+0f128
    pi_half - asin_f128_impl(x)
}

pub fun acos<T>(x: T): T {
    match x.type_name() {
        "f64" => (acos_f64_impl(x as f64)) as T,
        "f32" => (acos_f32_impl(x as f32)) as T,
        "f16" => (acos_f16_impl(x as f16)) as T,
        "f128" => (acos_f128_impl(x as f128)) as T,
        _ => x
    }
}

// ─── atan2 (four-quadrant arctangent) ───
// x>0: atan(y/x); x<0: y>=0 → atan(y/x)+π, y<0 → atan(y/x)-π; x==0: y>0 → π/2, y<0 → -π/2, y==0 → 0

@internal
fun atan2_f64_impl(y: f64, x: f64): f64 {
    val pi = 0x1.921fb54442d18p+1
    val pi_half = 0x1.921fb54442d18p+0
    if x > 0.0 { return atan_f64_impl(y / x) }
    if x < 0.0 {
        if y >= 0.0 { return atan_f64_impl(y / x) + pi }
        return atan_f64_impl(y / x) - pi
    }
    if y > 0.0 { return pi_half }
    if y < 0.0 { return 0.0 - pi_half }
    0.0
}
@internal
fun atan2_f32_impl(y: f32, x: f32): f32 {
    val pi: f32 = 0x1.921fb6p+1f32
    val pi_half: f32 = 0x1.921fb6p+0f32
    if x > 0.0 { return atan_f32_impl(y / x) }
    if x < 0.0 {
        if y >= 0.0 { return atan_f32_impl(y / x) + pi }
        return atan_f32_impl(y / x) - pi
    }
    if y > 0.0 { return pi_half }
    if y < 0.0 { return 0.0 - pi_half }
    0.0
}
@internal
fun atan2_f16_impl(y: f16, x: f16): f16 {
    val pi: f16 = 0x1.92p+1f16
    val pi_half: f16 = 0x1.92p+0f16
    if x > 0.0 { return atan_f16_impl(y / x) }
    if x < 0.0 {
        if y >= 0.0 { return atan_f16_impl(y / x) + pi }
        return atan_f16_impl(y / x) - pi
    }
    if y > 0.0 { return pi_half }
    if y < 0.0 { return 0.0 - pi_half }
    0.0
}
@internal
fun atan2_f128_impl(y: f128, x: f128): f128 {
    val pi = 0x1.921fb54442d18469898cc51701b8p+1f128
    val pi_half = 0x1.921fb54442d18469898cc51701b8p+0f128
    if x > 0.0 { return atan_f128_impl(y / x) }
    if x < 0.0 {
        if y >= 0.0 { return atan_f128_impl(y / x) + pi }
        return atan_f128_impl(y / x) - pi
    }
    if y > 0.0 { return pi_half }
    if y < 0.0 { return 0.0 - pi_half }
    0.0
}

pub fun atan2<T>(y: T, x: T): T {
    match x.type_name() {
        "f64" => (atan2_f64_impl(y as f64, x as f64)) as T,
        "f32" => (atan2_f32_impl(y as f32, x as f32)) as T,
        "f16" => (atan2_f16_impl(y as f16, x as f16)) as T,
        "f128" => (atan2_f128_impl(y as f128, x as f128)) as T,
        _ => x
    }
}

// ─── asinh (inverse hyperbolic sine, log(x + sqrt(x² + 1))) ───

@internal
fun asinh_f64_impl(x: f64): f64 {
    log_f64_impl(x + sqrt_f64_impl(x * x + 1.0))
}
@internal
fun asinh_f32_impl(x: f32): f32 {
    log_f32_impl(x + sqrt_f32_impl(x * x + 1.0))
}
@internal
fun asinh_f16_impl(x: f16): f16 {
    log_f16_impl(x + sqrt_f16_impl(x * x + 1.0))
}
@internal
fun asinh_f128_impl(x: f128): f128 {
    log_f128_impl(x + sqrt_f128_impl(x * x + 1.0))
}

pub fun asinh<T>(x: T): T {
    match x.type_name() {
        "f64" => (asinh_f64_impl(x as f64)) as T,
        "f32" => (asinh_f32_impl(x as f32)) as T,
        "f16" => (asinh_f16_impl(x as f16)) as T,
        "f128" => (asinh_f128_impl(x as f128)) as T,
        _ => x
    }
}

// ─── acosh (inverse hyperbolic cosine, log(x + sqrt(x² - 1))) ───
// x<1 returns NaN

@internal
fun acosh_f64_impl(x: f64): f64 {
    if x < 1.0 { return 0.0 / 0.0 }
    log_f64_impl(x + sqrt_f64_impl(x * x - 1.0))
}
@internal
fun acosh_f32_impl(x: f32): f32 {
    if x < 1.0 { return 0.0f32 / 0.0f32 }
    log_f32_impl(x + sqrt_f32_impl(x * x - 1.0))
}
@internal
fun acosh_f16_impl(x: f16): f16 {
    if x < 1.0 { return 0.0f16 / 0.0f16 }
    log_f16_impl(x + sqrt_f16_impl(x * x - 1.0))
}
@internal
fun acosh_f128_impl(x: f128): f128 {
    if x < 1.0 { return 0.0f128 / 0.0f128 }
    log_f128_impl(x + sqrt_f128_impl(x * x - 1.0))
}

pub fun acosh<T>(x: T): T {
    match x.type_name() {
        "f64" => (acosh_f64_impl(x as f64)) as T,
        "f32" => (acosh_f32_impl(x as f32)) as T,
        "f16" => (acosh_f16_impl(x as f16)) as T,
        "f128" => (acosh_f128_impl(x as f128)) as T,
        _ => x
    }
}

// ─── atanh (inverse hyperbolic tangent, 0.5 * log((1+x)/(1-x))) ───
// |x|>=1 returns NaN

@internal
fun atanh_f64_impl(x: f64): f64 {
    if x >= 1.0 || x <= 0.0 - 1.0 { return 0.0 / 0.0 }
    0.5 * log_f64_impl((1.0 + x) / (1.0 - x))
}
@internal
fun atanh_f32_impl(x: f32): f32 {
    if x >= 1.0 || x <= 0.0 - 1.0 { return 0.0f32 / 0.0f32 }
    0.5 * log_f32_impl((1.0 + x) / (1.0 - x))
}
@internal
fun atanh_f16_impl(x: f16): f16 {
    if x >= 1.0 || x <= 0.0 - 1.0 { return 0.0f16 / 0.0f16 }
    0.5 * log_f16_impl((1.0 + x) / (1.0 - x))
}
@internal
fun atanh_f128_impl(x: f128): f128 {
    if x >= 1.0 || x <= 0.0 - 1.0 { return 0.0f128 / 0.0f128 }
    0.5 * log_f128_impl((1.0 + x) / (1.0 - x))
}

pub fun atanh<T>(x: T): T {
    match x.type_name() {
        "f64" => (atanh_f64_impl(x as f64)) as T,
        "f32" => (atanh_f32_impl(x as f32)) as T,
        "f16" => (atanh_f16_impl(x as f16)) as T,
        "f128" => (atanh_f128_impl(x as f128)) as T,
        _ => x
    }
}
