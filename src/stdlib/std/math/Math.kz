// Math standard library — General functions + constants + NaN/Inf
//
// Pure Kuzo implementation, zero FFI dependency.
// NaN/Inf constructed using IEEE 754 floating point division by zero semantics.
// Generic functions use match x.type_name() to dispatch to corresponding precision implementations by type.

// ─── f64 constants (hexadecimal floating point literals, IEEE 754 exact bit patterns) ───
pub val PI: f64      = 0x1.921fb54442d18p+1
pub val E: f64       = 0x1.5bf0a8b145769p+1
pub val LN2: f64     = 0x1.62e42fefa39efp-1
pub val LN10: f64    = 0x1.26bb1bbb55516p+1
pub val SQRT2: f64   = 0x1.6a09e667f3bcdp+0
pub val LOG2E: f64   = 0x1.71547652b82fep+0
pub val LOG10E: f64  = 0x1.bcb7b1526e50ep-2

// ─── f32 constants ───
pub val PI_F32: f32    = 0x1.921fb6p+1f32
pub val E_F32: f32     = 0x1.5bf0a8p+1f32
pub val LN2_F32: f32   = 0x1.62e43p-1f32

// ─── f128 high-precision constants (hexadecimal floating point literals, IEEE 754 binary128 exact bit patterns) ───
pub val PI_F128: f128  = 0x1.921fb54442d18469898cc51701b8p+1f128
pub val E_F128: f128   = 0x1.5bf0a8b1457695355fb8ac404e7ap+1f128
pub val LN2_F128: f128 = 0x1.62e42fefa39ef35793c7673007e6p-1f128

// ─── f16 constants ───
pub val PI_F16: f16    = 0x1.92p+1f16
pub val E_F16: f16     = 0x1.5cp+1f16

// ─── NaN/Inf construction (pure Kuzo semantics, using IEEE 754 floating point division by zero) ───
// 0.0/0.0 = NaN, 1.0/0.0 = +Inf, -1.0/0.0 = -Inf

pub fun nan_f64(): f64       { 0.0 / 0.0 }
pub fun inf_f64(): f64       { 1.0 / 0.0 }
pub fun neg_inf_f64(): f64   { -1.0 / 0.0 }

pub fun nan_f32(): f32       { 0.0 / 0.0 }
pub fun inf_f32(): f32       { 1.0 / 0.0 }
pub fun neg_inf_f32(): f32   { -1.0 / 0.0 }

pub fun nan_f16(): f16       { 0.0 / 0.0 }
pub fun inf_f16(): f16       { 1.0 / 0.0 }
pub fun neg_inf_f16(): f16   { -1.0 / 0.0 }

pub fun nan_f128(): f128     { 0.0 / 0.0 }
pub fun inf_f128(): f128     { 1.0 / 0.0 }
pub fun neg_inf_f128(): f128 { -1.0 / 0.0 }

// ─── NaN/Inf detection (using IEEE 754: NaN != NaN) ───

pub fun is_nan_f64(x: f64): bool { x != x }
pub fun is_inf_f64(x: f64): bool { x == 1.0 / 0.0 || x == -1.0 / 0.0 }

pub fun is_nan_f32(x: f32): bool { x != x }
pub fun is_inf_f32(x: f32): bool { x == 1.0 / 0.0 || x == -1.0 / 0.0 }

pub fun is_nan_f16(x: f16): bool { x != x }
pub fun is_inf_f16(x: f16): bool { x == 1.0 / 0.0 || x == -1.0 / 0.0 }

pub fun is_nan_f128(x: f128): bool { x != x }
pub fun is_inf_f128(x: f128): bool { x == 1.0 / 0.0 || x == -1.0 / 0.0 }

// ─── abs (generic, dispatch by type; unsigned is no-op) ───

fun abs_i8_impl(x: i8): i8 { if x < 0 { 0 - x } else { x } }
fun abs_i16_impl(x: i16): i16 { if x < 0 { 0 - x } else { x } }
fun abs_i32_impl(x: i32): i32 { if x < 0 { 0 - x } else { x } }
fun abs_i64_impl(x: i64): i64 { if x < 0 { 0 - x } else { x } }
fun abs_i128_impl(x: i128): i128 { if x < 0 { 0 - x } else { x } }
fun abs_isize_impl(x: isize): isize { if x < 0 { 0 - x } else { x } }
fun abs_f16_impl(x: f16): f16 { if x < 0.0 { 0.0 - x } else { x } }
fun abs_f32_impl(x: f32): f32 { if x < 0.0 { 0.0 - x } else { x } }
fun abs_f64_impl(x: f64): f64 { if x < 0.0 { 0.0 - x } else { x } }
fun abs_f128_impl(x: f128): f128 { if x < 0.0 { 0.0 - x } else { x } }

pub fun abs<T>(x: T): T {
    match x.type_name() {
        "i8" => (abs_i8_impl(x as i8)) as T,
        "i16" => (abs_i16_impl(x as i16)) as T,
        "i32" => (abs_i32_impl(x as i32)) as T,
        "i64" => (abs_i64_impl(x as i64)) as T,
        "i128" => (abs_i128_impl(x as i128)) as T,
        "isize" => (abs_isize_impl(x as isize)) as T,
        "f16" => (abs_f16_impl(x as f16)) as T,
        "f32" => (abs_f32_impl(x as f32)) as T,
        "f64" => (abs_f64_impl(x as f64)) as T,
        "f128" => (abs_f128_impl(x as f128)) as T,
        _ => x
    }
}

// ─── min/max (generic, direct comparison) ───

pub fun min<T>(a: T, b: T): T {
    if a < b { a } else { b }
}

pub fun max<T>(a: T, b: T): T {
    if a > b { a } else { b }
}

// ─── clamp (generic, clamp x within [lo, hi] range) ───

pub fun clamp<T>(x: T, lo: T, hi: T): T {
    if x < lo { lo } else if x > hi { hi } else { x }
}

// ─── sign (generic, return -1/0/1 of same type) ───

pub fun sign<T>(x: T): T {
    match x.type_name() {
        "i8" => if x as i8 > 0 { 1 as T } else if x as i8 < 0 { (0 - 1) as T } else { 0 as T },
        "i16" => if x as i16 > 0 { 1 as T } else if x as i16 < 0 { (0 - 1) as T } else { 0 as T },
        "i32" => if x as i32 > 0 { 1 as T } else if x as i32 < 0 { (0 - 1) as T } else { 0 as T },
        "i64" => if x as i64 > 0 { 1 as T } else if x as i64 < 0 { (0 - 1) as T } else { 0 as T },
        "i128" => if x as i128 > 0 { 1 as T } else if x as i128 < 0 { (0 - 1) as T } else { 0 as T },
        "isize" => if x as isize > 0 { 1 as T } else if x as isize < 0 { (0 - 1) as T } else { 0 as T },
        "f32" => if x as f32 > 0.0 { 1.0 as T } else if x as f32 < 0.0 { (0.0 - 1.0) as T } else { 0.0 as T },
        "f64" => if x as f64 > 0.0 { 1.0 as T } else if x as f64 < 0.0 { (0.0 - 1.0) as T } else { 0.0 as T },
        "f16" => if x as f16 > 0.0 { 1.0 as T } else if x as f16 < 0.0 { (0.0 - 1.0) as T } else { 0.0 as T },
        "f128" => if x as f128 > 0.0 { 1.0 as T } else if x as f128 < 0.0 { (0.0 - 1.0) as T } else { 0.0 as T },
        "u8" => x,
        "u16" => x,
        "u32" => x,
        "u64" => x,
        "u128" => x,
        "usize" => x,
        _ => x
    }
}

// ─── Floating point classification detection ───

// isfinite: NaN/Inf → false, others → true (integers always true)
pub fun isfinite<T>(x: T): bool {
    match x.type_name() {
        "f64" => {
            val v = x as f64
            !is_nan_f64(v) && !is_inf_f64(v)
        },
        "f32" => {
            val v = x as f32
            !is_nan_f32(v) && !is_inf_f32(v)
        },
        "f16" => {
            val v = x as f16
            !is_nan_f16(v) && !is_inf_f16(v)
        },
        "f128" => {
            val v = x as f128
            !is_nan_f128(v) && !is_inf_f128(v)
        },
        _ => true
    }
}

// signbit: negative or -0.0 → true, others → false
fun signbit_f64_impl(x: f64): bool {
    x < 0.0 || (x == 0.0 && (1.0 / x) < 0.0)
}
fun signbit_f32_impl(x: f32): bool {
    x < 0.0 || (x == 0.0 && (1.0 / x) < 0.0)
}
fun signbit_f16_impl(x: f16): bool {
    x < 0.0 || (x == 0.0 && (1.0 / x) < 0.0)
}
fun signbit_f128_impl(x: f128): bool {
    x < 0.0 || (x == 0.0 && (1.0 / x) < 0.0)
}

pub fun signbit<T>(x: T): bool {
    match x.type_name() {
        "f64" => signbit_f64_impl(x as f64),
        "f32" => signbit_f32_impl(x as f32),
        "f16" => signbit_f16_impl(x as f16),
        "f128" => signbit_f128_impl(x as f128),
        "i8" => x as i8 < 0,
        "i16" => x as i16 < 0,
        "i32" => x as i32 < 0,
        "i64" => x as i64 < 0,
        "i128" => x as i128 < 0,
        "isize" => x as isize < 0,
        _ => false
    }
}

// isnormal: non-zero, finite, and exponent in normal range (not subnormal)
// Algorithm: extract exponent e so |x|/2^e ∈ [1,2), check whether e is in normal range
fun isnormal_f64_impl(x: f64): bool {
    if is_nan_f64(x) || is_inf_f64(x) { return false }
    if x == 0.0 { return false }
    var a = if x < 0.0 { 0.0 - x } else { x }
    var e = 0
    while a >= 2.0 {
        a = a / 2.0
        e = e + 1
    }
    while a < 1.0 {
        a = a * 2.0
        e = e - 1
    }
    e >= -1022 && e <= 1023
}
fun isnormal_f32_impl(x: f32): bool {
    if is_nan_f32(x) || is_inf_f32(x) { return false }
    if x == 0.0 { return false }
    var a = if x < 0.0 { 0.0 - x } else { x }
    var e = 0
    while a >= 2.0 {
        a = a / 2.0
        e = e + 1
    }
    while a < 1.0 {
        a = a * 2.0
        e = e - 1
    }
    e >= -126 && e <= 127
}
fun isnormal_f16_impl(x: f16): bool {
    if is_nan_f16(x) || is_inf_f16(x) { return false }
    if x == 0.0 { return false }
    var a = if x < 0.0 { 0.0 - x } else { x }
    var e = 0
    while a >= 2.0 {
        a = a / 2.0
        e = e + 1
    }
    while a < 1.0 {
        a = a * 2.0
        e = e - 1
    }
    e >= -14 && e <= 15
}
fun isnormal_f128_impl(x: f128): bool {
    if is_nan_f128(x) || is_inf_f128(x) { return false }
    if x == 0.0 { return false }
    var a = if x < 0.0 { 0.0 - x } else { x }
    var e = 0
    while a >= 2.0 {
        a = a / 2.0
        e = e + 1
    }
    while a < 1.0 {
        a = a * 2.0
        e = e - 1
    }
    e >= -16382 && e <= 16383
}

pub fun isnormal<T>(x: T): bool {
    match x.type_name() {
        "f64" => isnormal_f64_impl(x as f64),
        "f32" => isnormal_f32_impl(x as f32),
        "f16" => isnormal_f16_impl(x as f16),
        "f128" => isnormal_f128_impl(x as f128),
        _ => x != 0 as T
    }
}

// ─── wrapping arithmetic (Kuzo integer operations already use wrapping semantics, here providing explicit API) ───

pub fun wrapping_add<T>(a: T, b: T): T { a + b }
pub fun wrapping_sub<T>(a: T, b: T): T { a - b }
pub fun wrapping_mul<T>(a: T, b: T): T { a * b }

// ─── Integer bit tools ───
// Provide implementations by bit width (8/16/32/64/128), signed types reuse after cast to unsigned

// is_power_of_two: x > 0 and only one bit is 1
fun is_pow2_8_impl(x: u8): bool { x != 0 && (x & (x - 1)) == 0 }
fun is_pow2_16_impl(x: u16): bool { x != 0 && (x & (x - 1)) == 0 }
fun is_pow2_32_impl(x: u32): bool { x != 0 && (x & (x - 1)) == 0 }
fun is_pow2_64_impl(x: u64): bool { x != 0 && (x & (x - 1)) == 0 }
fun is_pow2_128_impl(x: u128): bool { x != 0 && (x & (x - 1)) == 0 }

pub fun is_power_of_two<T>(x: T): bool {
    match x.type_name() {
        "i8" => is_pow2_8_impl(x as u8),
        "u8" => is_pow2_8_impl(x as u8),
        "i16" => is_pow2_16_impl(x as u16),
        "u16" => is_pow2_16_impl(x as u16),
        "i32" => is_pow2_32_impl(x as u32),
        "u32" => is_pow2_32_impl(x as u32),
        "i64" => is_pow2_64_impl(x as u64),
        "u64" => is_pow2_64_impl(x as u64),
        "i128" => is_pow2_128_impl(x as u128),
        "u128" => is_pow2_128_impl(x as u128),
        "isize" => is_pow2_64_impl(x as u64),
        "usize" => is_pow2_64_impl(x as u64),
        _ => false
    }
}

// count_ones: Brian Kernighan algorithm, clear lowest bit until zero
fun count_ones_8_impl(x: u8): u8 {
    var c = 0
    var v = x
    while v != 0 {
        v = v & (v - 1)
        c = c + 1
    }
    c
}
fun count_ones_16_impl(x: u16): u16 {
    var c = 0
    var v = x
    while v != 0 {
        v = v & (v - 1)
        c = c + 1
    }
    c
}
fun count_ones_32_impl(x: u32): u32 {
    var c = 0
    var v = x
    while v != 0 {
        v = v & (v - 1)
        c = c + 1
    }
    c
}
fun count_ones_64_impl(x: u64): u64 {
    var c = 0
    var v = x
    while v != 0 {
        v = v & (v - 1)
        c = c + 1
    }
    c
}
fun count_ones_128_impl(x: u128): u128 {
    var c = 0
    var v = x
    while v != 0 {
        v = v & (v - 1)
        c = c + 1
    }
    c
}

pub fun count_ones<T>(x: T): T {
    match x.type_name() {
        "i8" => (count_ones_8_impl(x as u8)) as T,
        "u8" => (count_ones_8_impl(x as u8)) as T,
        "i16" => (count_ones_16_impl(x as u16)) as T,
        "u16" => (count_ones_16_impl(x as u16)) as T,
        "i32" => (count_ones_32_impl(x as u32)) as T,
        "u32" => (count_ones_32_impl(x as u32)) as T,
        "i64" => (count_ones_64_impl(x as u64)) as T,
        "u64" => (count_ones_64_impl(x as u64)) as T,
        "i128" => (count_ones_128_impl(x as u128)) as T,
        "u128" => (count_ones_128_impl(x as u128)) as T,
        "isize" => (count_ones_64_impl(x as u64)) as T,
        "usize" => (count_ones_64_impl(x as u64)) as T,
        _ => 0 as T
    }
}

// leading_zeros: scan consecutive 0 bits from MSB
fun leading_zeros_8_impl(x: u8): u8 {
    if x == 0 { return 8 }
    var c = 0
    var v = x
    while v < 128 {
        v = v << 1
        c = c + 1
    }
    c
}
fun leading_zeros_16_impl(x: u16): u16 {
    if x == 0 { return 16 }
    var c = 0
    var v = x
    while v < 32768 {
        v = v << 1
        c = c + 1
    }
    c
}
fun leading_zeros_32_impl(x: u32): u32 {
    if x == 0 { return 32 }
    var c = 0
    var v = x
    while v < (1u32 << 31) {
        v = v << 1
        c = c + 1
    }
    c
}
fun leading_zeros_64_impl(x: u64): u64 {
    if x == 0 { return 64 }
    var c = 0
    var v = x
    while v < (1u64 << 63) {
        v = v << 1
        c = c + 1
    }
    c
}
fun leading_zeros_128_impl(x: u128): u128 {
    if x == 0 { return 128 }
    var c = 0
    var v = x
    while v < (1u128 << 127) {
        v = v << 1
        c = c + 1
    }
    c
}

pub fun leading_zeros<T>(x: T): T {
    match x.type_name() {
        "i8" => (leading_zeros_8_impl(x as u8)) as T,
        "u8" => (leading_zeros_8_impl(x as u8)) as T,
        "i16" => (leading_zeros_16_impl(x as u16)) as T,
        "u16" => (leading_zeros_16_impl(x as u16)) as T,
        "i32" => (leading_zeros_32_impl(x as u32)) as T,
        "u32" => (leading_zeros_32_impl(x as u32)) as T,
        "i64" => (leading_zeros_64_impl(x as u64)) as T,
        "u64" => (leading_zeros_64_impl(x as u64)) as T,
        "i128" => (leading_zeros_128_impl(x as u128)) as T,
        "u128" => (leading_zeros_128_impl(x as u128)) as T,
        "isize" => (leading_zeros_64_impl(x as u64)) as T,
        "usize" => (leading_zeros_64_impl(x as u64)) as T,
        _ => 0 as T
    }
}

// trailing_zeros: scan consecutive 0 bits from LSB
fun trailing_zeros_8_impl(x: u8): u8 {
    if x == 0 { return 8 }
    var c = 0
    var v = x
    while (v & 1) == 0 {
        v = v >> 1
        c = c + 1
    }
    c
}
fun trailing_zeros_16_impl(x: u16): u16 {
    if x == 0 { return 16 }
    var c = 0
    var v = x
    while (v & 1) == 0 {
        v = v >> 1
        c = c + 1
    }
    c
}
fun trailing_zeros_32_impl(x: u32): u32 {
    if x == 0 { return 32 }
    var c = 0
    var v = x
    while (v & 1) == 0 {
        v = v >> 1
        c = c + 1
    }
    c
}
fun trailing_zeros_64_impl(x: u64): u64 {
    if x == 0 { return 64 }
    var c = 0
    var v = x
    while (v & 1) == 0 {
        v = v >> 1
        c = c + 1
    }
    c
}
fun trailing_zeros_128_impl(x: u128): u128 {
    if x == 0 { return 128 }
    var c = 0
    var v = x
    while (v & 1) == 0 {
        v = v >> 1
        c = c + 1
    }
    c
}

pub fun trailing_zeros<T>(x: T): T {
    match x.type_name() {
        "i8" => (trailing_zeros_8_impl(x as u8)) as T,
        "u8" => (trailing_zeros_8_impl(x as u8)) as T,
        "i16" => (trailing_zeros_16_impl(x as u16)) as T,
        "u16" => (trailing_zeros_16_impl(x as u16)) as T,
        "i32" => (trailing_zeros_32_impl(x as u32)) as T,
        "u32" => (trailing_zeros_32_impl(x as u32)) as T,
        "i64" => (trailing_zeros_64_impl(x as u64)) as T,
        "u64" => (trailing_zeros_64_impl(x as u64)) as T,
        "i128" => (trailing_zeros_128_impl(x as u128)) as T,
        "u128" => (trailing_zeros_128_impl(x as u128)) as T,
        "isize" => (trailing_zeros_64_impl(x as u64)) as T,
        "usize" => (trailing_zeros_64_impl(x as u64)) as T,
        _ => 0 as T
    }
}

// next_power_of_two: bit filling method, v |= v>>1|2|4|... then +1
fun next_pow2_8_impl(x: u8): u8 {
    if x <= 1 { return 1 }
    var v = x - 1
    v = v | (v >> 1)
    v = v | (v >> 2)
    v = v | (v >> 4)
    v + 1
}
fun next_pow2_16_impl(x: u16): u16 {
    if x <= 1 { return 1 }
    var v = x - 1
    v = v | (v >> 1)
    v = v | (v >> 2)
    v = v | (v >> 4)
    v = v | (v >> 8)
    v + 1
}
fun next_pow2_32_impl(x: u32): u32 {
    if x <= 1 { return 1 }
    var v = x - 1
    v = v | (v >> 1)
    v = v | (v >> 2)
    v = v | (v >> 4)
    v = v | (v >> 8)
    v = v | (v >> 16)
    v + 1
}
fun next_pow2_64_impl(x: u64): u64 {
    if x <= 1 { return 1 }
    var v = x - 1
    v = v | (v >> 1)
    v = v | (v >> 2)
    v = v | (v >> 4)
    v = v | (v >> 8)
    v = v | (v >> 16)
    v = v | (v >> 32)
    v + 1
}
fun next_pow2_128_impl(x: u128): u128 {
    if x <= 1 { return 1 }
    var v = x - 1
    v = v | (v >> 1)
    v = v | (v >> 2)
    v = v | (v >> 4)
    v = v | (v >> 8)
    v = v | (v >> 16)
    v = v | (v >> 32)
    v = v | (v >> 64)
    v + 1
}

pub fun next_power_of_two<T>(x: T): T {
    match x.type_name() {
        "i8" => (next_pow2_8_impl(x as u8)) as T,
        "u8" => (next_pow2_8_impl(x as u8)) as T,
        "i16" => (next_pow2_16_impl(x as u16)) as T,
        "u16" => (next_pow2_16_impl(x as u16)) as T,
        "i32" => (next_pow2_32_impl(x as u32)) as T,
        "u32" => (next_pow2_32_impl(x as u32)) as T,
        "i64" => (next_pow2_64_impl(x as u64)) as T,
        "u64" => (next_pow2_64_impl(x as u64)) as T,
        "i128" => (next_pow2_128_impl(x as u128)) as T,
        "u128" => (next_pow2_128_impl(x as u128)) as T,
        "isize" => (next_pow2_64_impl(x as u64)) as T,
        "usize" => (next_pow2_64_impl(x as u64)) as T,
        _ => x
    }
}

// rotate_left: (x << n) | (x >> (bits - n)), wrapping shift automatically handles n >= bits
fun rotate_left_8_impl(x: u8, n: u8): u8 { (x << n) | (x >> (8 - n)) }
fun rotate_left_16_impl(x: u16, n: u16): u16 { (x << n) | (x >> (16 - n)) }
fun rotate_left_32_impl(x: u32, n: u32): u32 { (x << n) | (x >> (32 - n)) }
fun rotate_left_64_impl(x: u64, n: u64): u64 { (x << n) | (x >> (64 - n)) }
fun rotate_left_128_impl(x: u128, n: u128): u128 { (x << n) | (x >> (128 - n)) }

pub fun rotate_left<T>(x: T, n: T): T {
    match x.type_name() {
        "i8" => (rotate_left_8_impl(x as u8, n as u8)) as T,
        "u8" => (rotate_left_8_impl(x as u8, n as u8)) as T,
        "i16" => (rotate_left_16_impl(x as u16, n as u16)) as T,
        "u16" => (rotate_left_16_impl(x as u16, n as u16)) as T,
        "i32" => (rotate_left_32_impl(x as u32, n as u32)) as T,
        "u32" => (rotate_left_32_impl(x as u32, n as u32)) as T,
        "i64" => (rotate_left_64_impl(x as u64, n as u64)) as T,
        "u64" => (rotate_left_64_impl(x as u64, n as u64)) as T,
        "i128" => (rotate_left_128_impl(x as u128, n as u128)) as T,
        "u128" => (rotate_left_128_impl(x as u128, n as u128)) as T,
        "isize" => (rotate_left_64_impl(x as u64, n as u64)) as T,
        "usize" => (rotate_left_64_impl(x as u64, n as u64)) as T,
        _ => x
    }
}

// rotate_right: (x >> n) | (x << (bits - n))
fun rotate_right_8_impl(x: u8, n: u8): u8 { (x >> n) | (x << (8 - n)) }
fun rotate_right_16_impl(x: u16, n: u16): u16 { (x >> n) | (x << (16 - n)) }
fun rotate_right_32_impl(x: u32, n: u32): u32 { (x >> n) | (x << (32 - n)) }
fun rotate_right_64_impl(x: u64, n: u64): u64 { (x >> n) | (x << (64 - n)) }
fun rotate_right_128_impl(x: u128, n: u128): u128 { (x >> n) | (x << (128 - n)) }

pub fun rotate_right<T>(x: T, n: T): T {
    match x.type_name() {
        "i8" => (rotate_right_8_impl(x as u8, n as u8)) as T,
        "u8" => (rotate_right_8_impl(x as u8, n as u8)) as T,
        "i16" => (rotate_right_16_impl(x as u16, n as u16)) as T,
        "u16" => (rotate_right_16_impl(x as u16, n as u16)) as T,
        "i32" => (rotate_right_32_impl(x as u32, n as u32)) as T,
        "u32" => (rotate_right_32_impl(x as u32, n as u32)) as T,
        "i64" => (rotate_right_64_impl(x as u64, n as u64)) as T,
        "u64" => (rotate_right_64_impl(x as u64, n as u64)) as T,
        "i128" => (rotate_right_128_impl(x as u128, n as u128)) as T,
        "u128" => (rotate_right_128_impl(x as u128, n as u128)) as T,
        "isize" => (rotate_right_64_impl(x as u64, n as u64)) as T,
        "usize" => (rotate_right_64_impl(x as u64, n as u64)) as T,
        _ => x
    }
}
