// Math standard library — Rounding and integer operations
//
// Contains: floor/ceil/round/trunc/fabs/copysign/fmod/ldexp
// Pure Frond implementation, no FFI dependency.
// Generic functions use match x.type_name() to dispatch to corresponding precision implementations by type.

// ─── trunc (truncation toward zero) ───
// Implemented by casting to integer and back to achieve truncation

@internal
fun trunc_f64_impl(x: f64): f64 {
    (x as i64) as f64
}
@internal
fun trunc_f32_impl(x: f32): f32 {
    (x as i64) as f32
}
@internal
fun trunc_f16_impl(x: f16): f16 {
    (x as i16) as f16
}
@internal
fun trunc_f128_impl(x: f128): f128 {
    (x as i128) as f128
}

pub fun trunc<T>(x: T): T {
    match x.type_name() {
        "f64" => (trunc_f64_impl(x as f64)) as T,
        "f32" => (trunc_f32_impl(x as f32)) as T,
        "f16" => (trunc_f16_impl(x as f16)) as T,
        "f128" => (trunc_f128_impl(x as f128)) as T,
        _ => x
    }
}

// ─── floor (rounding toward negative infinity) ───

@internal
fun floor_f64_impl(x: f64): f64 {
    val t = trunc_f64_impl(x)
    if x < 0.0 && x != t { t - 1.0 } else { t }
}
@internal
fun floor_f32_impl(x: f32): f32 {
    val t = trunc_f32_impl(x)
    if x < 0.0 && x != t { t - 1.0 } else { t }
}
@internal
fun floor_f16_impl(x: f16): f16 {
    val t = trunc_f16_impl(x)
    if x < 0.0 && x != t { t - 1.0 } else { t }
}
@internal
fun floor_f128_impl(x: f128): f128 {
    val t = trunc_f128_impl(x)
    if x < 0.0 && x != t { t - 1.0 } else { t }
}

pub fun floor<T>(x: T): T {
    match x.type_name() {
        "f64" => (floor_f64_impl(x as f64)) as T,
        "f32" => (floor_f32_impl(x as f32)) as T,
        "f16" => (floor_f16_impl(x as f16)) as T,
        "f128" => (floor_f128_impl(x as f128)) as T,
        _ => x
    }
}

// ─── ceil (rounding toward positive infinity) ───

@internal
fun ceil_f64_impl(x: f64): f64 {
    val t = trunc_f64_impl(x)
    if x > 0.0 && x != t { t + 1.0 } else { t }
}
@internal
fun ceil_f32_impl(x: f32): f32 {
    val t = trunc_f32_impl(x)
    if x > 0.0 && x != t { t + 1.0 } else { t }
}
@internal
fun ceil_f16_impl(x: f16): f16 {
    val t = trunc_f16_impl(x)
    if x > 0.0 && x != t { t + 1.0 } else { t }
}
@internal
fun ceil_f128_impl(x: f128): f128 {
    val t = trunc_f128_impl(x)
    if x > 0.0 && x != t { t + 1.0 } else { t }
}

pub fun ceil<T>(x: T): T {
    match x.type_name() {
        "f64" => (ceil_f64_impl(x as f64)) as T,
        "f32" => (ceil_f32_impl(x as f32)) as T,
        "f16" => (ceil_f16_impl(x as f16)) as T,
        "f128" => (ceil_f128_impl(x as f128)) as T,
        _ => x
    }
}

// ─── round (round to nearest integer) ───

@internal
fun round_f64_impl(x: f64): f64 {
    val t = trunc_f64_impl(x)
    val frac = x - t
    if frac > 0.5 { t + 1.0 }
    else if frac < -0.5 { t - 1.0 }
    else { t }
}
@internal
fun round_f32_impl(x: f32): f32 {
    val t = trunc_f32_impl(x)
    val frac = x - t
    if frac > 0.5 { t + 1.0 }
    else if frac < -0.5 { t - 1.0 }
    else { t }
}
@internal
fun round_f16_impl(x: f16): f16 {
    val t = trunc_f16_impl(x)
    val frac = x - t
    if frac > 0.5 { t + 1.0 }
    else if frac < -0.5 { t - 1.0 }
    else { t }
}
@internal
fun round_f128_impl(x: f128): f128 {
    val t = trunc_f128_impl(x)
    val frac = x - t
    if frac > 0.5 { t + 1.0 }
    else if frac < -0.5 { t - 1.0 }
    else { t }
}

pub fun round<T>(x: T): T {
    match x.type_name() {
        "f64" => (round_f64_impl(x as f64)) as T,
        "f32" => (round_f32_impl(x as f32)) as T,
        "f16" => (round_f16_impl(x as f16)) as T,
        "f128" => (round_f128_impl(x as f128)) as T,
        _ => x
    }
}

// ─── fabs (absolute value, floating point only) ───

pub fun fabs<T>(x: T): T {
    match x.type_name() {
        "f64" => if x as f64 < 0.0 { (0.0 - x as f64) as T } else { x },
        "f32" => if x as f32 < 0.0 { (0.0 - x as f32) as T } else { x },
        "f16" => if x as f16 < 0.0 { (0.0 - x as f16) as T } else { x },
        "f128" => if x as f128 < 0.0 { (0.0 - x as f128) as T } else { x },
        _ => x
    }
}

// ─── copysign (take sign of y and assign to x) ───

pub fun copysign<T>(x: T, y: T): T {
    match x.type_name() {
        "f64" => {
            val xv = x as f64
            val yv = y as f64
            if (yv < 0.0) != (xv < 0.0) { (0.0 - xv) as T } else { x }
        },
        "f32" => {
            val xv = x as f32
            val yv = y as f32
            if (yv < 0.0) != (xv < 0.0) { (0.0 - xv) as T } else { x }
        },
        "f16" => {
            val xv = x as f16
            val yv = y as f16
            if (yv < 0.0) != (xv < 0.0) { (0.0 - xv) as T } else { x }
        },
        "f128" => {
            val xv = x as f128
            val yv = y as f128
            if (yv < 0.0) != (xv < 0.0) { (0.0 - xv) as T } else { x }
        },
        _ => x
    }
}

// ─── fmod (floating point modulo, result has same sign as x) ───

@internal
fun fmod_f64_impl(x: f64, y: f64): f64 {
    if y == 0.0 { return 0.0 / 0.0 }
    val quotient = x / y
    val truncated = trunc_f64_impl(quotient)
    x - truncated * y
}
@internal
fun fmod_f32_impl(x: f32, y: f32): f32 {
    if y == 0.0 { return 0.0f32 / 0.0f32 }
    val quotient = x / y
    val truncated = trunc_f32_impl(quotient)
    x - truncated * y
}
@internal
fun fmod_f16_impl(x: f16, y: f16): f16 {
    if y == 0.0 { return 0.0f16 / 0.0f16 }
    val quotient = x / y
    val truncated = trunc_f16_impl(quotient)
    x - truncated * y
}
@internal
fun fmod_f128_impl(x: f128, y: f128): f128 {
    if y == 0.0 { return 0.0f128 / 0.0f128 }
    val quotient = x / y
    val truncated = trunc_f128_impl(quotient)
    x - truncated * y
}

pub fun fmod<T>(x: T, y: T): T {
    match x.type_name() {
        "f64" => (fmod_f64_impl(x as f64, y as f64)) as T,
        "f32" => (fmod_f32_impl(x as f32, y as f32)) as T,
        "f16" => (fmod_f16_impl(x as f16, y as f16)) as T,
        "f128" => (fmod_f128_impl(x as f128, y as f128)) as T,
        _ => x
    }
}

// ─── ldexp (x * 2^exp) ───
// Implemented by repeated multiplication by 2

@internal
fun ldexp_f64_impl(x: f64, exp: i32): f64 {
    var result = x
    var n = exp
    while n > 0 {
        result = result * 2.0
        n = n - 1
    }
    while n < 0 {
        result = result / 2.0
        n = n + 1
    }
    result
}
@internal
fun ldexp_f32_impl(x: f32, exp: i32): f32 {
    var result = x
    var n = exp
    while n > 0 {
        result = result * 2.0
        n = n - 1
    }
    while n < 0 {
        result = result / 2.0
        n = n + 1
    }
    result
}
@internal
fun ldexp_f16_impl(x: f16, exp: i32): f16 {
    var result = x
    var n = exp
    while n > 0 {
        result = result * 2.0
        n = n - 1
    }
    while n < 0 {
        result = result / 2.0
        n = n + 1
    }
    result
}
@internal
fun ldexp_f128_impl(x: f128, exp: i32): f128 {
    var result = x
    var n = exp
    while n > 0 {
        result = result * 2.0
        n = n - 1
    }
    while n < 0 {
        result = result / 2.0
        n = n + 1
    }
    result
}

pub fun ldexp<T>(x: T, exp: i32): T {
    match x.type_name() {
        "f64" => (ldexp_f64_impl(x as f64, exp)) as T,
        "f32" => (ldexp_f32_impl(x as f32, exp)) as T,
        "f16" => (ldexp_f16_impl(x as f16, exp)) as T,
        "f128" => (ldexp_f128_impl(x as f128, exp)) as T,
        _ => x
    }
}

// ─── frexp (decompose into mantissa m∈[0.5,1) and exponent e, x = m * 2^e) ───
// x==0 → m=0,e=0; NaN/Inf returned as-is with m=x,e=0
// Frond has no tuples, split into frexp_mantissa and frexp_exponent two functions

@internal
fun frexp_f64_mantissa_impl(x: f64): f64 {
    if x == 0.0 { return 0.0 }
    if x != x { return x }
    if x == 1.0 / 0.0 || x == -1.0 / 0.0 { return x }
    var m = if x < 0.0 { 0.0 - x } else { x }
    while m >= 1.0 { m = m / 2.0 }
    while m < 0.5 { m = m * 2.0 }
    if x < 0.0 { 0.0 - m } else { m }
}
@internal
fun frexp_f64_exponent_impl(x: f64): i32 {
    if x == 0.0 { return 0 }
    if x != x { return 0 }
    if x == 1.0 / 0.0 || x == -1.0 / 0.0 { return 0 }
    var m = if x < 0.0 { 0.0 - x } else { x }
    var e = 0
    while m >= 1.0 {
        m = m / 2.0
        e = e + 1
    }
    while m < 0.5 {
        m = m * 2.0
        e = e - 1
    }
    e
}
@internal
fun frexp_f32_mantissa_impl(x: f32): f32 {
    if x == 0.0 { return 0.0 }
    if x != x { return x }
    if x == 1.0 / 0.0 || x == -1.0 / 0.0 { return x }
    var m = if x < 0.0 { 0.0 - x } else { x }
    while m >= 1.0 { m = m / 2.0 }
    while m < 0.5 { m = m * 2.0 }
    if x < 0.0 { 0.0 - m } else { m }
}
@internal
fun frexp_f32_exponent_impl(x: f32): i32 {
    if x == 0.0 { return 0 }
    if x != x { return 0 }
    if x == 1.0 / 0.0 || x == -1.0 / 0.0 { return 0 }
    var m = if x < 0.0 { 0.0 - x } else { x }
    var e = 0
    while m >= 1.0 {
        m = m / 2.0
        e = e + 1
    }
    while m < 0.5 {
        m = m * 2.0
        e = e - 1
    }
    e
}
@internal
fun frexp_f16_mantissa_impl(x: f16): f16 {
    if x == 0.0 { return 0.0 }
    if x != x { return x }
    if x == 1.0 / 0.0 || x == -1.0 / 0.0 { return x }
    var m = if x < 0.0 { 0.0 - x } else { x }
    while m >= 1.0 { m = m / 2.0 }
    while m < 0.5 { m = m * 2.0 }
    if x < 0.0 { 0.0 - m } else { m }
}
@internal
fun frexp_f16_exponent_impl(x: f16): i32 {
    if x == 0.0 { return 0 }
    if x != x { return 0 }
    if x == 1.0 / 0.0 || x == -1.0 / 0.0 { return 0 }
    var m = if x < 0.0 { 0.0 - x } else { x }
    var e = 0
    while m >= 1.0 {
        m = m / 2.0
        e = e + 1
    }
    while m < 0.5 {
        m = m * 2.0
        e = e - 1
    }
    e
}
@internal
fun frexp_f128_mantissa_impl(x: f128): f128 {
    if x == 0.0 { return 0.0 }
    if x != x { return x }
    if x == 1.0 / 0.0 || x == -1.0 / 0.0 { return x }
    var m = if x < 0.0 { 0.0 - x } else { x }
    while m >= 1.0 { m = m / 2.0 }
    while m < 0.5 { m = m * 2.0 }
    if x < 0.0 { 0.0 - m } else { m }
}
@internal
fun frexp_f128_exponent_impl(x: f128): i32 {
    if x == 0.0 { return 0 }
    if x != x { return 0 }
    if x == 1.0 / 0.0 || x == -1.0 / 0.0 { return 0 }
    var m = if x < 0.0 { 0.0 - x } else { x }
    var e = 0
    while m >= 1.0 {
        m = m / 2.0
        e = e + 1
    }
    while m < 0.5 {
        m = m * 2.0
        e = e - 1
    }
    e
}

pub fun frexp_mantissa<T>(x: T): T {
    match x.type_name() {
        "f64" => (frexp_f64_mantissa_impl(x as f64)) as T,
        "f32" => (frexp_f32_mantissa_impl(x as f32)) as T,
        "f16" => (frexp_f16_mantissa_impl(x as f16)) as T,
        "f128" => (frexp_f128_mantissa_impl(x as f128)) as T,
        _ => x
    }
}

pub fun frexp_exponent<T>(x: T): i32 {
    match x.type_name() {
        "f64" => frexp_f64_exponent_impl(x as f64),
        "f32" => frexp_f32_exponent_impl(x as f32),
        "f16" => frexp_f16_exponent_impl(x as f16),
        "f128" => frexp_f128_exponent_impl(x as f128),
        _ => 0
    }
}

// ─── modf (separate integer and fractional parts, both with same sign as x) ───
// integral = trunc(x); fractional = x - trunc(x)

@internal
fun modf_f64_integral_impl(x: f64): f64 { trunc_f64_impl(x) }
@internal
fun modf_f64_fractional_impl(x: f64): f64 { x - trunc_f64_impl(x) }
@internal
fun modf_f32_integral_impl(x: f32): f32 { trunc_f32_impl(x) }
@internal
fun modf_f32_fractional_impl(x: f32): f32 { x - trunc_f32_impl(x) }
@internal
fun modf_f16_integral_impl(x: f16): f16 { trunc_f16_impl(x) }
@internal
fun modf_f16_fractional_impl(x: f16): f16 { x - trunc_f16_impl(x) }
@internal
fun modf_f128_integral_impl(x: f128): f128 { trunc_f128_impl(x) }
@internal
fun modf_f128_fractional_impl(x: f128): f128 { x - trunc_f128_impl(x) }

pub fun modf_integral<T>(x: T): T {
    match x.type_name() {
        "f64" => (modf_f64_integral_impl(x as f64)) as T,
        "f32" => (modf_f32_integral_impl(x as f32)) as T,
        "f16" => (modf_f16_integral_impl(x as f16)) as T,
        "f128" => (modf_f128_integral_impl(x as f128)) as T,
        _ => x
    }
}

pub fun modf_fractional<T>(x: T): T {
    match x.type_name() {
        "f64" => (modf_f64_fractional_impl(x as f64)) as T,
        "f32" => (modf_f32_fractional_impl(x as f32)) as T,
        "f16" => (modf_f16_fractional_impl(x as f16)) as T,
        "f128" => (modf_f128_fractional_impl(x as f128)) as T,
        _ => x
    }
}

// ─── ilogb (base-2 exponent, integer return) ───
// x = m * 2^e, m∈[1,2), return e; x==0 returns 0 (simplified); NaN/Inf returns 0

@internal
fun ilogb_f64_impl(x: f64): i32 {
    if x == 0.0 { return 0 }
    if x != x { return 0 }
    if x == 1.0 / 0.0 || x == -1.0 / 0.0 { return 0 }
    var m = if x < 0.0 { 0.0 - x } else { x }
    var e = 0
    while m >= 2.0 {
        m = m / 2.0
        e = e + 1
    }
    while m < 1.0 {
        m = m * 2.0
        e = e - 1
    }
    e
}
@internal
fun ilogb_f32_impl(x: f32): i32 {
    if x == 0.0 { return 0 }
    if x != x { return 0 }
    if x == 1.0 / 0.0 || x == -1.0 / 0.0 { return 0 }
    var m = if x < 0.0 { 0.0 - x } else { x }
    var e = 0
    while m >= 2.0 {
        m = m / 2.0
        e = e + 1
    }
    while m < 1.0 {
        m = m * 2.0
        e = e - 1
    }
    e
}
@internal
fun ilogb_f16_impl(x: f16): i32 {
    if x == 0.0 { return 0 }
    if x != x { return 0 }
    if x == 1.0 / 0.0 || x == -1.0 / 0.0 { return 0 }
    var m = if x < 0.0 { 0.0 - x } else { x }
    var e = 0
    while m >= 2.0 {
        m = m / 2.0
        e = e + 1
    }
    while m < 1.0 {
        m = m * 2.0
        e = e - 1
    }
    e
}
@internal
fun ilogb_f128_impl(x: f128): i32 {
    if x == 0.0 { return 0 }
    if x != x { return 0 }
    if x == 1.0 / 0.0 || x == -1.0 / 0.0 { return 0 }
    var m = if x < 0.0 { 0.0 - x } else { x }
    var e = 0
    while m >= 2.0 {
        m = m / 2.0
        e = e + 1
    }
    while m < 1.0 {
        m = m * 2.0
        e = e - 1
    }
    e
}

pub fun ilogb<T>(x: T): i32 {
    match x.type_name() {
        "f64" => ilogb_f64_impl(x as f64),
        "f32" => ilogb_f32_impl(x as f32),
        "f16" => ilogb_f16_impl(x as f16),
        "f128" => ilogb_f128_impl(x as f128),
        _ => 0
    }
}

// ─── logb (base-2 exponent, floating point return) ───
// logb(x) = (ilogb(x)) as T

@internal
fun logb_f64_impl(x: f64): f64 { (ilogb_f64_impl(x)) as f64 }
@internal
fun logb_f32_impl(x: f32): f32 { (ilogb_f32_impl(x)) as f32 }
@internal
fun logb_f16_impl(x: f16): f16 { (ilogb_f16_impl(x)) as f16 }
@internal
fun logb_f128_impl(x: f128): f128 { (ilogb_f128_impl(x)) as f128 }

pub fun logb<T>(x: T): T {
    match x.type_name() {
        "f64" => (logb_f64_impl(x as f64)) as T,
        "f32" => (logb_f32_impl(x as f32)) as T,
        "f16" => (logb_f16_impl(x as f16)) as T,
        "f128" => (logb_f128_impl(x as f128)) as T,
        _ => x
    }
}

// ─── scalbn (x * 2^n, same semantics as ldexp, math function naming) ───

@internal
fun scalbn_f64_impl(x: f64, n: i32): f64 { ldexp_f64_impl(x, n) }
@internal
fun scalbn_f32_impl(x: f32, n: i32): f32 { ldexp_f32_impl(x, n) }
@internal
fun scalbn_f16_impl(x: f16, n: i32): f16 { ldexp_f16_impl(x, n) }
@internal
fun scalbn_f128_impl(x: f128, n: i32): f128 { ldexp_f128_impl(x, n) }

pub fun scalbn<T>(x: T, n: i32): T {
    match x.type_name() {
        "f64" => (scalbn_f64_impl(x as f64, n)) as T,
        "f32" => (scalbn_f32_impl(x as f32, n)) as T,
        "f16" => (scalbn_f16_impl(x as f16, n)) as T,
        "f128" => (scalbn_f128_impl(x as f128, n)) as T,
        _ => x
    }
}
