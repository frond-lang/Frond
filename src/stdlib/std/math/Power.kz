// Math standard library — Power/exponential/logarithm + number theory
//
// Pure Frond implementation, algorithm: Newton-Raphson (sqrt/cbrt), Taylor + argument reduction (exp/log).
// Depends on Round.kz floor/trunc/fmod/ldexp implementation.
// Generic functions use match x.type_name() to dispatch to corresponding precision implementations by type.

// ─── sqrt (square root, Newton-Raphson) ───
// g_{n+1} = (g_n + x/g_n) / 2, negative returns NaN, 0 returns 0
// First normalize x to [1, 4) to extract even exponent e, iterate on mantissa then restore with ldexp

@internal
fun sqrt_f64_impl(x: f64): f64 {
    if x < 0.0 { return 0.0 / 0.0 }
    if x == 0.0 { return 0.0 }
    var e = 0
    var m = x
    while m >= 4.0 {
        m = m / 4.0
        e = e + 1
    }
    while m < 1.0 {
        m = m * 4.0
        e = e - 1
    }
    var g = (m + 1.0) / 2.0
    var i = 0
    while i < 20 {
        g = (g + m / g) / 2.0
        i = i + 1
    }
    ldexp_f64_impl(g, e)
}
@internal
fun sqrt_f32_impl(x: f32): f32 {
    if x < 0.0 { return 0.0f32 / 0.0f32 }
    if x == 0.0 { return 0.0 }
    var e = 0
    var m = x
    while m >= 4.0 {
        m = m / 4.0
        e = e + 1
    }
    while m < 1.0 {
        m = m * 4.0
        e = e - 1
    }
    var g = (m + 1.0) / 2.0
    var i = 0
    while i < 12 {
        g = (g + m / g) / 2.0
        i = i + 1
    }
    ldexp_f32_impl(g, e)
}
@internal
fun sqrt_f16_impl(x: f16): f16 {
    if x < 0.0 { return 0.0f16 / 0.0f16 }
    if x == 0.0 { return 0.0 }
    var e = 0
    var m = x
    while m >= 4.0 {
        m = m / 4.0
        e = e + 1
    }
    while m < 1.0 {
        m = m * 4.0
        e = e - 1
    }
    var g = (m + 1.0) / 2.0
    var i = 0
    while i < 6 {
        g = (g + m / g) / 2.0
        i = i + 1
    }
    ldexp_f16_impl(g, e)
}
@internal
fun sqrt_f128_impl(x: f128): f128 {
    if x < 0.0 { return 0.0f128 / 0.0f128 }
    if x == 0.0 { return 0.0 }
    var e = 0
    var m = x
    while m >= 4.0 {
        m = m / 4.0
        e = e + 1
    }
    while m < 1.0 {
        m = m * 4.0
        e = e - 1
    }
    var g = (m + 1.0) / 2.0
    var i = 0
    while i < 40 {
        g = (g + m / g) / 2.0
        i = i + 1
    }
    ldexp_f128_impl(g, e)
}

pub fun sqrt<T>(x: T): T {
    match x.type_name() {
        "f64" => (sqrt_f64_impl(x as f64)) as T,
        "f32" => (sqrt_f32_impl(x as f32)) as T,
        "f16" => (sqrt_f16_impl(x as f16)) as T,
        "f128" => (sqrt_f128_impl(x as f128)) as T,
        _ => x
    }
}

// ─── cbrt (cube root, Newton-Raphson) ───
// g_{n+1} = (2*g + x/(g*g)) / 3, 0 returns 0
// Take absolute value then normalize to [1, 8) to extract exponent e, cbrt(x) = cbrt(m) * 2^e, finally restore sign

@internal
fun cbrt_f64_impl(x: f64): f64 {
    if x == 0.0 { return 0.0 }
    var a = if x < 0.0 { 0.0 - x } else { x }
    var e = 0
    var m = a
    while m >= 8.0 {
        m = m / 8.0
        e = e + 1
    }
    while m < 1.0 {
        m = m * 8.0
        e = e - 1
    }
    var g = m
    var i = 0
    while i < 25 {
        g = (2.0 * g + m / (g * g)) / 3.0
        i = i + 1
    }
    val r = ldexp_f64_impl(g, e)
    if x < 0.0 { 0.0 - r } else { r }
}
@internal
fun cbrt_f32_impl(x: f32): f32 {
    if x == 0.0 { return 0.0 }
    var a = if x < 0.0 { 0.0 - x } else { x }
    var e = 0
    var m = a
    while m >= 8.0 {
        m = m / 8.0
        e = e + 1
    }
    while m < 1.0 {
        m = m * 8.0
        e = e - 1
    }
    var g = m
    var i = 0
    while i < 15 {
        g = (2.0 * g + m / (g * g)) / 3.0
        i = i + 1
    }
    val r = ldexp_f32_impl(g, e)
    if x < 0.0 { 0.0 - r } else { r }
}
@internal
fun cbrt_f16_impl(x: f16): f16 {
    if x == 0.0 { return 0.0 }
    var a = if x < 0.0 { 0.0 - x } else { x }
    var e = 0
    var m = a
    while m >= 8.0 {
        m = m / 8.0
        e = e + 1
    }
    while m < 1.0 {
        m = m * 8.0
        e = e - 1
    }
    var g = m
    var i = 0
    while i < 8 {
        g = (2.0 * g + m / (g * g)) / 3.0
        i = i + 1
    }
    val r = ldexp_f16_impl(g, e)
    if x < 0.0 { 0.0 - r } else { r }
}
@internal
fun cbrt_f128_impl(x: f128): f128 {
    if x == 0.0 { return 0.0 }
    var a = if x < 0.0 { 0.0 - x } else { x }
    var e = 0
    var m = a
    while m >= 8.0 {
        m = m / 8.0
        e = e + 1
    }
    while m < 1.0 {
        m = m * 8.0
        e = e - 1
    }
    var g = m
    var i = 0
    while i < 50 {
        g = (2.0 * g + m / (g * g)) / 3.0
        i = i + 1
    }
    val r = ldexp_f128_impl(g, e)
    if x < 0.0 { 0.0 - r } else { r }
}

pub fun cbrt<T>(x: T): T {
    match x.type_name() {
        "f64" => (cbrt_f64_impl(x as f64)) as T,
        "f32" => (cbrt_f32_impl(x as f32)) as T,
        "f16" => (cbrt_f16_impl(x as f16)) as T,
        "f128" => (cbrt_f128_impl(x as f128)) as T,
        _ => x
    }
}

// ─── exp (exponential, Taylor + argument reduction) ───
// x = k*ln2 + r, |r| <= ln2/2, exp(x) = 2^k * exp(r)
// exp(r) = 1 + r + r²/2! + r³/3! + ...
// Large x returns Inf/0 directly to avoid ldexp infinite loop

@internal
fun exp_f64_impl(x: f64): f64 {
    val ln2 = 0x1.62e42fefa39efp-1
    if x == 0.0 { return 1.0 }
    if x > 709.782712893384 { return 1.0 / 0.0 }
    if x < -745.1332191019412 { return 0.0 }
    val k = (floor_f64_impl(x / ln2 + 0.5)) as i32
    val r = x - k as f64 * ln2
    var term = 1.0
    var sum = 1.0
    var i = 1
    while i < 15 {
        term = term * r / i as f64
        sum = sum + term
        i = i + 1
    }
    ldexp_f64_impl(sum, k)
}
@internal
fun exp_f32_impl(x: f32): f32 {
    val ln2: f32 = 0x1.62e42fefa39efp-1
    if x == 0.0 { return 1.0 }
    if x > 88.722839052 { return 1.0f32 / 0.0f32 }
    if x < -103.972085 { return 0.0 }
    val k = (floor_f32_impl(x / ln2 + 0.5)) as i32
    val r = x - k as f32 * ln2
    var term: f32 = 1.0
    var sum: f32 = 1.0
    var i = 1
    while i < 10 {
        term = term * r / i as f32
        sum = sum + term
        i = i + 1
    }
    ldexp_f32_impl(sum, k)
}
@internal
fun exp_f16_impl(x: f16): f16 {
    val ln2 = 0x1.63p-1f16
    if x == 0.0 { return 1.0 }
    if x > 11.09 { return 1.0f16 / 0.0f16 }
    if x < -17.32 { return 0.0 }
    val k = (floor_f16_impl(x / ln2 + 0.5)) as i32
    val r = x - k as f16 * ln2
    var term: f16 = 1.0
    var sum: f16 = 1.0
    var i = 1
    while i < 5 {
        term = term * r / i as f16
        sum = sum + term
        i = i + 1
    }
    ldexp_f16_impl(sum, k)
}
@internal
fun exp_f128_impl(x: f128): f128 {
    val ln2: f128 = 0x1.62e42fefa39ef35793c7673007e6p-1f128
    if x == 0.0 { return 1.0 as f128 }
    if x > 11356.523711074 { return 1.0f128 / 0.0f128 }
    if x < -11399.0 { return 0.0 as f128 }
    val k = (floor_f128_impl(x / ln2 + 0.5)) as i32
    val r = x - k as f128 * ln2
    var term: f128 = 1.0
    var sum: f128 = 1.0
    var i = 1
    while i < 30 {
        term = term * r / i as f128
        sum = sum + term
        i = i + 1
    }
    ldexp_f128_impl(sum, k)
}

pub fun exp<T>(x: T): T {
    match x.type_name() {
        "f64" => (exp_f64_impl(x as f64)) as T,
        "f32" => (exp_f32_impl(x as f32)) as T,
        "f16" => (exp_f16_impl(x as f16)) as T,
        "f128" => (exp_f128_impl(x as f128)) as T,
        _ => x
    }
}

// ─── log (natural logarithm, argument reduction + atanh series) ───
// Extract exponent e so m = x/2^e ∈ [1, 2), log(x) = e*ln2 + log(m)
// Let s = (m-1)/(m+1) ∈ [0, 1/3], log(m) = 2*(s + s³/3 + s⁵/5 + ...)
// atanh series |s|≤1/3 converges fast, no sign branch, no alternating cancellation, accuracy far better than Taylor
// x == 0 returns -Inf, x < 0 returns NaN

@internal
fun log_f64_impl(x: f64): f64 {
    val ln2 = 0x1.62e42fefa39efp-1
    if x == 0.0 { return -1.0 / 0.0 }
    if x < 0.0 { return 0.0 / 0.0 }
    var e = 0
    var m = x
    while m >= 2.0 {
        m = m / 2.0
        e = e + 1
    }
    while m < 1.0 {
        m = m * 2.0
        e = e - 1
    }
    val s = (m - 1.0) / (m + 1.0)
    val s2 = s * s
    var term = s
    var sum = s
    var i = 3
    while i <= 41 {
        term = term * s2
        sum = sum + term / i as f64
        i = i + 2
    }
    2.0 * sum + e as f64 * ln2
}
@internal
fun log_f32_impl(x: f32): f32 {
    val ln2 = 0x1.62e42fefa39efp-1
    if x == 0.0 { return -1.0f32 / 0.0f32 }
    if x < 0.0 { return 0.0f32 / 0.0f32 }
    var e = 0
    var m = x
    while m >= 2.0 {
        m = m / 2.0
        e = e + 1
    }
    while m < 1.0 {
        m = m * 2.0
        e = e - 1
    }
    val s = (m - 1.0) / (m + 1.0)
    val s2 = s * s
    var term = s
    var sum = s
    var i = 3
    while i <= 25 {
        term = term * s2
        sum = sum + term / i as f32
        i = i + 2
    }
    2.0 * sum + e as f32 * ln2
}
@internal
fun log_f16_impl(x: f16): f16 {
    val ln2 = 0x1.63p-1f16
    if x == 0.0 { return -1.0f16 / 0.0f16 }
    if x < 0.0 { return 0.0f16 / 0.0f16 }
    var e = 0
    var m = x
    while m >= 2.0 {
        m = m / 2.0
        e = e + 1
    }
    while m < 1.0 {
        m = m * 2.0
        e = e - 1
    }
    val s = (m - 1.0) / (m + 1.0)
    val s2 = s * s
    var term = s
    var sum = s
    var i = 3
    while i <= 13 {
        term = term * s2
        sum = sum + term / i as f16
        i = i + 2
    }
    2.0 * sum + e as f16 * ln2
}
@internal
fun log_f128_impl(x: f128): f128 {
    val ln2: f128 = 0x1.62e42fefa39ef35793c7673007e6p-1f128
    if x == 0.0 { return -1.0f128 / 0.0f128 }
    if x < 0.0 { return 0.0f128 / 0.0f128 }
    var e = 0
    var m = x
    while m >= 2.0 {
        m = m / 2.0
        e = e + 1
    }
    while m < 1.0 {
        m = m * 2.0
        e = e - 1
    }
    val s = (m - 1.0 as f128) / (m + 1.0 as f128)
    val s2 = s * s
    var term: f128 = s
    var sum: f128 = s
    var i = 3
    while i <= 121 {
        term = term * s2
        sum = sum + term / i as f128
        i = i + 2
    }
    2.0 as f128 * sum + e as f128 * ln2
}

pub fun log<T>(x: T): T {
    match x.type_name() {
        "f64" => (log_f64_impl(x as f64)) as T,
        "f32" => (log_f32_impl(x as f32)) as T,
        "f16" => (log_f16_impl(x as f16)) as T,
        "f128" => (log_f128_impl(x as f128)) as T,
        _ => x
    }
}

// ─── pow (power, exp(exp * log(base))) ───
// Handle base <= 0 boundary: base>0 uses formula; base==0 returns by exp sign; base<0 returns NaN

@internal
fun pow_f64_impl(base: f64, exp: f64): f64 {
    if base > 0.0 { return exp_f64_impl(exp * log_f64_impl(base)) }
    if base == 0.0 {
        if exp == 0.0 { return 1.0 }
        if exp > 0.0 { return 0.0 }
        return 1.0 / 0.0
    }
    0.0 / 0.0
}
@internal
fun pow_f32_impl(base: f32, exp: f32): f32 {
    if base > 0.0 { return exp_f32_impl(exp * log_f32_impl(base)) }
    if base == 0.0 {
        if exp == 0.0 { return 1.0 }
        if exp > 0.0 { return 0.0 }
        return 1.0f32 / 0.0f32
    }
    0.0 / 0.0
}
@internal
fun pow_f16_impl(base: f16, exp: f16): f16 {
    if base > 0.0 { return exp_f16_impl(exp * log_f16_impl(base)) }
    if base == 0.0 {
        if exp == 0.0 { return 1.0 }
        if exp > 0.0 { return 0.0 }
        return 1.0f16 / 0.0f16
    }
    0.0 / 0.0
}
@internal
fun pow_f128_impl(base: f128, exp: f128): f128 {
    if base > 0.0 { return exp_f128_impl(exp * log_f128_impl(base)) }
    if base == 0.0 {
        if exp == 0.0 { return 1.0 }
        if exp > 0.0 { return 0.0 }
        return 1.0f128 / 0.0f128
    }
    0.0 / 0.0
}

pub fun pow<T>(base: T, exp: T): T {
    match base.type_name() {
        "f64" => (pow_f64_impl(base as f64, exp as f64)) as T,
        "f32" => (pow_f32_impl(base as f32, exp as f32)) as T,
        "f16" => (pow_f16_impl(base as f16, exp as f16)) as T,
        "f128" => (pow_f128_impl(base as f128, exp as f128)) as T,
        _ => base
    }
}

// ─── exp2 / exp10 (2^x and 10^x) ───
// exp2(x) = exp(x * ln2), exp10(x) = exp(x * ln10)

@internal
fun exp2_f64_impl(x: f64): f64 {
    val ln2 = 0x1.62e42fefa39efp-1
    exp_f64_impl(x * ln2)
}
@internal
fun exp2_f32_impl(x: f32): f32 {
    val ln2: f32 = 0x1.62e42fefa39efp-1
    exp_f32_impl(x * ln2)
}
@internal
fun exp2_f16_impl(x: f16): f16 {
    val ln2 = 0x1.63p-1f16
    exp_f16_impl(x * ln2)
}
@internal
fun exp2_f128_impl(x: f128): f128 {
    val ln2: f128 = 0x1.62e42fefa39ef35793c7673007e6p-1f128
    exp_f128_impl(x * ln2)
}

pub fun exp2<T>(x: T): T {
    match x.type_name() {
        "f64" => (exp2_f64_impl(x as f64)) as T,
        "f32" => (exp2_f32_impl(x as f32)) as T,
        "f16" => (exp2_f16_impl(x as f16)) as T,
        "f128" => (exp2_f128_impl(x as f128)) as T,
        _ => x
    }
}

@internal
fun exp10_f64_impl(x: f64): f64 {
    val ln10 = 0x1.26bb1bbb55516p+1
    exp_f64_impl(x * ln10)
}
@internal
fun exp10_f32_impl(x: f32): f32 {
    val ln10: f32 = 0x1.26bb1bbb55516p+1
    exp_f32_impl(x * ln10)
}
@internal
fun exp10_f16_impl(x: f16): f16 {
    val ln10 = 0x1.26cp+1f16
    exp_f16_impl(x * ln10)
}
@internal
fun exp10_f128_impl(x: f128): f128 {
    val ln10 = 0x1.26bb1bbb5551582dd9ad3a9f9f6ep+1f128
    exp_f128_impl(x * ln10)
}

pub fun exp10<T>(x: T): T {
    match x.type_name() {
        "f64" => (exp10_f64_impl(x as f64)) as T,
        "f32" => (exp10_f32_impl(x as f32)) as T,
        "f16" => (exp10_f16_impl(x as f16)) as T,
        "f128" => (exp10_f128_impl(x as f128)) as T,
        _ => x
    }
}

// ─── log2 / log10 (change of base formula) ───
// log2(x) = log(x) / ln2, log10(x) = log(x) / ln10

@internal
fun log2_f64_impl(x: f64): f64 {
    val ln2 = 0x1.62e42fefa39efp-1
    log_f64_impl(x) / ln2
}
@internal
fun log2_f32_impl(x: f32): f32 {
    val ln2 = 0x1.62e42fefa39efp-1
    log_f32_impl(x) / ln2
}
@internal
fun log2_f16_impl(x: f16): f16 {
    val ln2 = 0x1.63p-1f16
    log_f16_impl(x) / ln2
}
@internal
fun log2_f128_impl(x: f128): f128 {
    val ln2: f128 = 0x1.62e42fefa39ef35793c7673007e6p-1f128
    log_f128_impl(x) / ln2
}

pub fun log2<T>(x: T): T {
    match x.type_name() {
        "f64" => (log2_f64_impl(x as f64)) as T,
        "f32" => (log2_f32_impl(x as f32)) as T,
        "f16" => (log2_f16_impl(x as f16)) as T,
        "f128" => (log2_f128_impl(x as f128)) as T,
        _ => x
    }
}

@internal
fun log10_f64_impl(x: f64): f64 {
    val ln10 = 0x1.26bb1bbb55516p+1
    log_f64_impl(x) / ln10
}
@internal
fun log10_f32_impl(x: f32): f32 {
    val ln10 = 0x1.26bb1bbb55516p+1
    log_f32_impl(x) / ln10
}
@internal
fun log10_f16_impl(x: f16): f16 {
    val ln10 = 0x1.26cp+1f16
    log_f16_impl(x) / ln10
}
@internal
fun log10_f128_impl(x: f128): f128 {
    val ln10 = 0x1.26bb1bbb5551582dd9ad3a9f9f6ep+1f128
    log_f128_impl(x) / ln10
}

pub fun log10<T>(x: T): T {
    match x.type_name() {
        "f64" => (log10_f64_impl(x as f64)) as T,
        "f32" => (log10_f32_impl(x as f32)) as T,
        "f16" => (log10_f16_impl(x as f16)) as T,
        "f128" => (log10_f128_impl(x as f128)) as T,
        _ => x
    }
}

// ─── gcd (greatest common divisor, Euclidean algorithm) ───
// Signed integers take absolute value first, unsigned compute directly

@internal
fun gcd_i32_impl(a: i32, b: i32): i32 {
    var x = if a < 0 { 0 - a } else { a }
    var y = if b < 0 { 0 - b } else { b }
    while y != 0 {
        val t = x % y
        x = y
        y = t
    }
    x
}
@internal
fun gcd_i64_impl(a: i64, b: i64): i64 {
    var x = if a < 0 { 0 - a } else { a }
    var y = if b < 0 { 0 - b } else { b }
    while y != 0 {
        val t = x % y
        x = y
        y = t
    }
    x
}
@internal
fun gcd_i128_impl(a: i128, b: i128): i128 {
    var x = if a < 0 { 0 - a } else { a }
    var y = if b < 0 { 0 - b } else { b }
    while y != 0 {
        val t = x % y
        x = y
        y = t
    }
    x
}
@internal
fun gcd_u32_impl(a: u32, b: u32): u32 {
    var x = a
    var y = b
    while y != 0 {
        val t = x % y
        x = y
        y = t
    }
    x
}
@internal
fun gcd_u64_impl(a: u64, b: u64): u64 {
    var x = a
    var y = b
    while y != 0 {
        val t = x % y
        x = y
        y = t
    }
    x
}
@internal
fun gcd_i8_impl(a: i8, b: i8): i8 {
    var x = if a < 0 { 0 - a } else { a }
    var y = if b < 0 { 0 - b } else { b }
    while y != 0 {
        val t = x % y
        x = y
        y = t
    }
    x
}
@internal
fun gcd_i16_impl(a: i16, b: i16): i16 {
    var x = if a < 0 { 0 - a } else { a }
    var y = if b < 0 { 0 - b } else { b }
    while y != 0 {
        val t = x % y
        x = y
        y = t
    }
    x
}
@internal
fun gcd_isize_impl(a: isize, b: isize): isize {
    var x = if a < 0 { 0 - a } else { a }
    var y = if b < 0 { 0 - b } else { b }
    while y != 0 {
        val t = x % y
        x = y
        y = t
    }
    x
}
@internal
fun gcd_u8_impl(a: u8, b: u8): u8 {
    var x = a
    var y = b
    while y != 0 {
        val t = x % y
        x = y
        y = t
    }
    x
}
@internal
fun gcd_u16_impl(a: u16, b: u16): u16 {
    var x = a
    var y = b
    while y != 0 {
        val t = x % y
        x = y
        y = t
    }
    x
}
@internal
fun gcd_u128_impl(a: u128, b: u128): u128 {
    var x = a
    var y = b
    while y != 0 {
        val t = x % y
        x = y
        y = t
    }
    x
}
@internal
fun gcd_usize_impl(a: usize, b: usize): usize {
    var x = a
    var y = b
    while y != 0 {
        val t = x % y
        x = y
        y = t
    }
    x
}

pub fun gcd<T>(a: T, b: T): T {
    match a.type_name() {
        "i8" => (gcd_i8_impl(a as i8, b as i8)) as T,
        "i16" => (gcd_i16_impl(a as i16, b as i16)) as T,
        "i32" => (gcd_i32_impl(a as i32, b as i32)) as T,
        "i64" => (gcd_i64_impl(a as i64, b as i64)) as T,
        "i128" => (gcd_i128_impl(a as i128, b as i128)) as T,
        "isize" => (gcd_isize_impl(a as isize, b as isize)) as T,
        "u8" => (gcd_u8_impl(a as u8, b as u8)) as T,
        "u16" => (gcd_u16_impl(a as u16, b as u16)) as T,
        "u32" => (gcd_u32_impl(a as u32, b as u32)) as T,
        "u64" => (gcd_u64_impl(a as u64, b as u64)) as T,
        "u128" => (gcd_u128_impl(a as u128, b as u128)) as T,
        "usize" => (gcd_usize_impl(a as usize, b as usize)) as T,
        _ => a
    }
}

// ─── lcm (least common multiple) ───
// lcm = a/gcd(a,b)*b, a==0 || b==0 returns 0

@internal
fun lcm_i32_impl(a: i32, b: i32): i32 {
    if a == 0 || b == 0 { return 0 }
    val g = gcd_i32_impl(a, b)
    val q = a / g
    q * b
}
@internal
fun lcm_i64_impl(a: i64, b: i64): i64 {
    if a == 0 || b == 0 { return 0 }
    val g = gcd_i64_impl(a, b)
    val q = a / g
    q * b
}
@internal
fun lcm_i128_impl(a: i128, b: i128): i128 {
    if a == 0 || b == 0 { return 0 }
    val g = gcd_i128_impl(a, b)
    val q = a / g
    q * b
}
@internal
fun lcm_u32_impl(a: u32, b: u32): u32 {
    if a == 0 || b == 0 { return 0 }
    val g = gcd_u32_impl(a, b)
    val q = a / g
    q * b
}
@internal
fun lcm_u64_impl(a: u64, b: u64): u64 {
    if a == 0 || b == 0 { return 0 }
    val g = gcd_u64_impl(a, b)
    val q = a / g
    q * b
}
@internal
fun lcm_i8_impl(a: i8, b: i8): i8 {
    if a == 0 || b == 0 { return 0 }
    val g = gcd_i8_impl(a, b)
    val q = a / g
    q * b
}
@internal
fun lcm_i16_impl(a: i16, b: i16): i16 {
    if a == 0 || b == 0 { return 0 }
    val g = gcd_i16_impl(a, b)
    val q = a / g
    q * b
}
@internal
fun lcm_isize_impl(a: isize, b: isize): isize {
    if a == 0 || b == 0 { return 0 }
    val g = gcd_isize_impl(a, b)
    val q = a / g
    q * b
}
@internal
fun lcm_u8_impl(a: u8, b: u8): u8 {
    if a == 0 || b == 0 { return 0 }
    val g = gcd_u8_impl(a, b)
    val q = a / g
    q * b
}
@internal
fun lcm_u16_impl(a: u16, b: u16): u16 {
    if a == 0 || b == 0 { return 0 }
    val g = gcd_u16_impl(a, b)
    val q = a / g
    q * b
}
@internal
fun lcm_u128_impl(a: u128, b: u128): u128 {
    if a == 0 || b == 0 { return 0 }
    val g = gcd_u128_impl(a, b)
    val q = a / g
    q * b
}
@internal
fun lcm_usize_impl(a: usize, b: usize): usize {
    if a == 0 || b == 0 { return 0 }
    val g = gcd_usize_impl(a, b)
    val q = a / g
    q * b
}

pub fun lcm<T>(a: T, b: T): T {
    match a.type_name() {
        "i8" => (lcm_i8_impl(a as i8, b as i8)) as T,
        "i16" => (lcm_i16_impl(a as i16, b as i16)) as T,
        "i32" => (lcm_i32_impl(a as i32, b as i32)) as T,
        "i64" => (lcm_i64_impl(a as i64, b as i64)) as T,
        "i128" => (lcm_i128_impl(a as i128, b as i128)) as T,
        "isize" => (lcm_isize_impl(a as isize, b as isize)) as T,
        "u8" => (lcm_u8_impl(a as u8, b as u8)) as T,
        "u16" => (lcm_u16_impl(a as u16, b as u16)) as T,
        "u32" => (lcm_u32_impl(a as u32, b as u32)) as T,
        "u64" => (lcm_u64_impl(a as u64, b as u64)) as T,
        "u128" => (lcm_u128_impl(a as u128, b as u128)) as T,
        "usize" => (lcm_usize_impl(a as usize, b as usize)) as T,
        _ => a
    }
}

// ─── div_floor (floor division) ───
// q = a/b, r = a%b; if r!=0 and r and b have opposite signs then q-1

@internal
fun div_floor_i32_impl(a: i32, b: i32): i32 {
    val q = a / b
    val r = a % b
    if r != 0 && ((r < 0) != (b < 0)) { q - 1 } else { q }
}
@internal
fun div_floor_i64_impl(a: i64, b: i64): i64 {
    val q = a / b
    val r = a % b
    if r != 0 && ((r < 0) != (b < 0)) { q - 1 } else { q }
}
@internal
fun div_floor_i128_impl(a: i128, b: i128): i128 {
    val q = a / b
    val r = a % b
    if r != 0 && ((r < 0) != (b < 0)) { q - 1 } else { q }
}
@internal
fun div_floor_u32_impl(a: u32, b: u32): u32 {
    a / b
}
@internal
fun div_floor_u64_impl(a: u64, b: u64): u64 {
    a / b
}
@internal
fun div_floor_i8_impl(a: i8, b: i8): i8 {
    val q = a / b
    val r = a % b
    if r != 0 && ((r < 0) != (b < 0)) { q - 1 } else { q }
}
@internal
fun div_floor_i16_impl(a: i16, b: i16): i16 {
    val q = a / b
    val r = a % b
    if r != 0 && ((r < 0) != (b < 0)) { q - 1 } else { q }
}
@internal
fun div_floor_isize_impl(a: isize, b: isize): isize {
    val q = a / b
    val r = a % b
    if r != 0 && ((r < 0) != (b < 0)) { q - 1 } else { q }
}
@internal
fun div_floor_u8_impl(a: u8, b: u8): u8 {
    a / b
}
@internal
fun div_floor_u16_impl(a: u16, b: u16): u16 {
    a / b
}
@internal
fun div_floor_u128_impl(a: u128, b: u128): u128 {
    a / b
}
@internal
fun div_floor_usize_impl(a: usize, b: usize): usize {
    a / b
}

pub fun div_floor<T>(a: T, b: T): T {
    match a.type_name() {
        "i8" => (div_floor_i8_impl(a as i8, b as i8)) as T,
        "i16" => (div_floor_i16_impl(a as i16, b as i16)) as T,
        "i32" => (div_floor_i32_impl(a as i32, b as i32)) as T,
        "i64" => (div_floor_i64_impl(a as i64, b as i64)) as T,
        "i128" => (div_floor_i128_impl(a as i128, b as i128)) as T,
        "isize" => (div_floor_isize_impl(a as isize, b as isize)) as T,
        "u8" => (div_floor_u8_impl(a as u8, b as u8)) as T,
        "u16" => (div_floor_u16_impl(a as u16, b as u16)) as T,
        "u32" => (div_floor_u32_impl(a as u32, b as u32)) as T,
        "u64" => (div_floor_u64_impl(a as u64, b as u64)) as T,
        "u128" => (div_floor_u128_impl(a as u128, b as u128)) as T,
        "usize" => (div_floor_usize_impl(a as usize, b as usize)) as T,
        _ => a
    }
}

// ─── div_ceil (ceiling division) ───
// q = a/b, r = a%b; if r!=0 and r and b have same sign then q+1

@internal
fun div_ceil_i32_impl(a: i32, b: i32): i32 {
    val q = a / b
    val r = a % b
    if r != 0 && ((r > 0) == (b > 0)) { q + 1 } else { q }
}
@internal
fun div_ceil_i64_impl(a: i64, b: i64): i64 {
    val q = a / b
    val r = a % b
    if r != 0 && ((r > 0) == (b > 0)) { q + 1 } else { q }
}
@internal
fun div_ceil_i128_impl(a: i128, b: i128): i128 {
    val q = a / b
    val r = a % b
    if r != 0 && ((r > 0) == (b > 0)) { q + 1 } else { q }
}
@internal
fun div_ceil_u32_impl(a: u32, b: u32): u32 {
    val q = a / b
    val r = a % b
    if r != 0 { q + 1 } else { q }
}
@internal
fun div_ceil_u64_impl(a: u64, b: u64): u64 {
    val q = a / b
    val r = a % b
    if r != 0 { q + 1 } else { q }
}
@internal
fun div_ceil_i8_impl(a: i8, b: i8): i8 {
    val q = a / b
    val r = a % b
    if r != 0 && ((r > 0) == (b > 0)) { q + 1 } else { q }
}
@internal
fun div_ceil_i16_impl(a: i16, b: i16): i16 {
    val q = a / b
    val r = a % b
    if r != 0 && ((r > 0) == (b > 0)) { q + 1 } else { q }
}
@internal
fun div_ceil_isize_impl(a: isize, b: isize): isize {
    val q = a / b
    val r = a % b
    if r != 0 && ((r > 0) == (b > 0)) { q + 1 } else { q }
}
@internal
fun div_ceil_u8_impl(a: u8, b: u8): u8 {
    val q = a / b
    val r = a % b
    if r != 0 { q + 1 } else { q }
}
@internal
fun div_ceil_u16_impl(a: u16, b: u16): u16 {
    val q = a / b
    val r = a % b
    if r != 0 { q + 1 } else { q }
}
@internal
fun div_ceil_u128_impl(a: u128, b: u128): u128 {
    val q = a / b
    val r = a % b
    if r != 0 { q + 1 } else { q }
}
@internal
fun div_ceil_usize_impl(a: usize, b: usize): usize {
    val q = a / b
    val r = a % b
    if r != 0 { q + 1 } else { q }
}

pub fun div_ceil<T>(a: T, b: T): T {
    match a.type_name() {
        "i8" => (div_ceil_i8_impl(a as i8, b as i8)) as T,
        "i16" => (div_ceil_i16_impl(a as i16, b as i16)) as T,
        "i32" => (div_ceil_i32_impl(a as i32, b as i32)) as T,
        "i64" => (div_ceil_i64_impl(a as i64, b as i64)) as T,
        "i128" => (div_ceil_i128_impl(a as i128, b as i128)) as T,
        "isize" => (div_ceil_isize_impl(a as isize, b as isize)) as T,
        "u8" => (div_ceil_u8_impl(a as u8, b as u8)) as T,
        "u16" => (div_ceil_u16_impl(a as u16, b as u16)) as T,
        "u32" => (div_ceil_u32_impl(a as u32, b as u32)) as T,
        "u64" => (div_ceil_u64_impl(a as u64, b as u64)) as T,
        "u128" => (div_ceil_u128_impl(a as u128, b as u128)) as T,
        "usize" => (div_ceil_usize_impl(a as usize, b as usize)) as T,
        _ => a
    }
}

// ─── expm1 (exp(x) - 1, high precision for x→0) ───
// |x| < 0.5: Taylor series x + x²/2! + x³/3! + ... to avoid cancellation loss
// |x| >= 0.5: exp(x) - 1

@internal
fun expm1_f64_impl(x: f64): f64 {
    var a = if x < 0.0 { 0.0 - x } else { x }
    if a < 0.5 {
        var term = x
        var sum = x
        var i = 2
        while i <= 20 {
            term = term * x / i as f64
            sum = sum + term
            i = i + 1
        }
        sum
    } else {
        exp_f64_impl(x) - 1.0
    }
}
@internal
fun expm1_f32_impl(x: f32): f32 {
    var a = if x < 0.0 { 0.0 - x } else { x }
    if a < 0.5 {
        var term = x
        var sum = x
        var i = 2
        while i <= 12 {
            term = term * x / i as f32
            sum = sum + term
            i = i + 1
        }
        sum
    } else {
        exp_f32_impl(x) - 1.0
    }
}
@internal
fun expm1_f16_impl(x: f16): f16 {
    var a = if x < 0.0 { 0.0 - x } else { x }
    if a < 0.5 {
        var term = x
        var sum = x
        var i = 2
        while i <= 8 {
            term = term * x / i as f16
            sum = sum + term
            i = i + 1
        }
        sum
    } else {
        exp_f16_impl(x) - 1.0
    }
}
@internal
fun expm1_f128_impl(x: f128): f128 {
    var a = if x < 0.0 { 0.0 - x } else { x }
    if a < 0.5 {
        var term = x
        var sum = x
        var i = 2
        while i <= 40 {
            term = term * x / i as f128
            sum = sum + term
            i = i + 1
        }
        sum
    } else {
        exp_f128_impl(x) - 1.0
    }
}

pub fun expm1<T>(x: T): T {
    match x.type_name() {
        "f64" => (expm1_f64_impl(x as f64)) as T,
        "f32" => (expm1_f32_impl(x as f32)) as T,
        "f16" => (expm1_f16_impl(x as f16)) as T,
        "f128" => (expm1_f128_impl(x as f128)) as T,
        _ => x
    }
}

// ─── log1p (log(1+x), high precision for x→0) ───
// |x| < 0.5: Taylor series x - x²/2 + x³/3 - ... to avoid cancellation loss
// |x| >= 0.5: log(1+x); x <= -1 returns NaN

@internal
fun log1p_f64_impl(x: f64): f64 {
    if x <= -1.0 { return 0.0 / 0.0 }
    var a = if x < 0.0 { 0.0 - x } else { x }
    if a < 0.5 {
        var sum = x
        var tpow = x
        var i = 2
        while i <= 30 {
            tpow = tpow * x
            val term = tpow / i as f64
            if i % 2 == 0 { sum = sum - term } else { sum = sum + term }
            i = i + 1
        }
        sum
    } else {
        log_f64_impl(1.0 + x)
    }
}
@internal
fun log1p_f32_impl(x: f32): f32 {
    if x <= -1.0 { return 0.0f32 / 0.0f32 }
    var a = if x < 0.0 { 0.0 - x } else { x }
    if a < 0.5 {
        var sum = x
        var tpow = x
        var i = 2
        while i <= 20 {
            tpow = tpow * x
            val term = tpow / i as f32
            if i % 2 == 0 { sum = sum - term } else { sum = sum + term }
            i = i + 1
        }
        sum
    } else {
        log_f32_impl(1.0 + x)
    }
}
@internal
fun log1p_f16_impl(x: f16): f16 {
    if x <= -1.0 { return 0.0f16 / 0.0f16 }
    var a = if x < 0.0 { 0.0 - x } else { x }
    if a < 0.5 {
        var sum = x
        var tpow = x
        var i = 2
        while i <= 12 {
            tpow = tpow * x
            val term = tpow / i as f16
            if i % 2 == 0 { sum = sum - term } else { sum = sum + term }
            i = i + 1
        }
        sum
    } else {
        log_f16_impl(1.0 + x)
    }
}
@internal
fun log1p_f128_impl(x: f128): f128 {
    if x <= -1.0 { return 0.0f128 / 0.0f128 }
    var a = if x < 0.0 { 0.0 - x } else { x }
    if a < 0.5 {
        var sum = x
        var tpow = x
        var i = 2
        while i <= 60 {
            tpow = tpow * x
            val term = tpow / i as f128
            if i % 2 == 0 { sum = sum - term } else { sum = sum + term }
            i = i + 1
        }
        sum
    } else {
        log_f128_impl(1.0 + x)
    }
}

pub fun log1p<T>(x: T): T {
    match x.type_name() {
        "f64" => (log1p_f64_impl(x as f64)) as T,
        "f32" => (log1p_f32_impl(x as f32)) as T,
        "f16" => (log1p_f16_impl(x as f16)) as T,
        "f128" => (log1p_f128_impl(x as f128)) as T,
        _ => x
    }
}

// ─── hypot (sqrt(x²+y²), avoid overflow) ───
// a = max(|x|,|y|), b = min(|x|,|y|); a==0 returns 0
// hypot = a * sqrt(1 + (b/a)²)

@internal
fun hypot_f64_impl(x: f64, y: f64): f64 {
    var ax = if x < 0.0 { 0.0 - x } else { x }
    var ay = if y < 0.0 { 0.0 - y } else { y }
    var a = ax
    var b = ay
    if b > a {
        a = ay
        b = ax
    }
    if a == 0.0 { return 0.0 }
    val ratio = b / a
    a * sqrt_f64_impl(1.0 + ratio * ratio)
}
@internal
fun hypot_f32_impl(x: f32, y: f32): f32 {
    var ax = if x < 0.0 { 0.0 - x } else { x }
    var ay = if y < 0.0 { 0.0 - y } else { y }
    var a = ax
    var b = ay
    if b > a {
        a = ay
        b = ax
    }
    if a == 0.0 { return 0.0 }
    val ratio = b / a
    a * sqrt_f32_impl(1.0 + ratio * ratio)
}
@internal
fun hypot_f16_impl(x: f16, y: f16): f16 {
    var ax = if x < 0.0 { 0.0 - x } else { x }
    var ay = if y < 0.0 { 0.0 - y } else { y }
    var a = ax
    var b = ay
    if b > a {
        a = ay
        b = ax
    }
    if a == 0.0 { return 0.0 }
    val ratio = b / a
    a * sqrt_f16_impl(1.0 + ratio * ratio)
}
@internal
fun hypot_f128_impl(x: f128, y: f128): f128 {
    var ax = if x < 0.0 { 0.0 - x } else { x }
    var ay = if y < 0.0 { 0.0 - y } else { y }
    var a = ax
    var b = ay
    if b > a {
        a = ay
        b = ax
    }
    if a == 0.0 { return 0.0 }
    val ratio = b / a
    a * sqrt_f128_impl(1.0 + ratio * ratio)
}

pub fun hypot<T>(x: T, y: T): T {
    match x.type_name() {
        "f64" => (hypot_f64_impl(x as f64, y as f64)) as T,
        "f32" => (hypot_f32_impl(x as f32, y as f32)) as T,
        "f16" => (hypot_f16_impl(x as f16, y as f16)) as T,
        "f128" => (hypot_f128_impl(x as f128, y as f128)) as T,
        _ => x
    }
}
