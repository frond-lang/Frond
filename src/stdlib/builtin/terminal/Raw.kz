// builtin/terminal/Raw.kz — Terminal primitives @extern("C") declarations (builtin, visible by default)
//
// Low-level terminal control: raw mode, non-blocking read, size query, raw write.
// Cross-platform logic is implemented in the C body via #if conditional compilation.
// Called by wrappers in std/terminal/Session.kz.

@c_include("termios.h")
@c_include("unistd.h")
@c_include("sys/ioctl.h")
@c_include("string.h")
@c_include("windows.h")
@internal
@extern("C")
fun __terminal_enable_raw_mode(orig_buf: u8[]): i32 #{
    #if defined(_WIN32) || defined(_WIN64)
        #ifndef ENABLE_VIRTUAL_TERMINAL_INPUT
        #define ENABLE_VIRTUAL_TERMINAL_INPUT 0x0200
        #endif
        HANDLE h = GetStdHandle(STD_INPUT_HANDLE);
        DWORD mode;
        if (!GetConsoleMode(h, &mode)) return -1;
        memcpy(orig_buf_data, &mode, sizeof(DWORD));
        DWORD new_mode = mode & ~(ENABLE_ECHO_INPUT | ENABLE_LINE_INPUT
                                  | ENABLE_PROCESSED_INPUT);
        // Deliver arrow/Home/End/Page/F-keys as VT escape sequences (ESC[A etc.)
        // instead of char-less key events that ReadFile never returns.
        new_mode |= ENABLE_VIRTUAL_TERMINAL_INPUT;
        if (!SetConsoleMode(h, new_mode)) return -1;
        return 0;
    #else
        struct termios orig, raw;
        if (tcgetattr(STDIN_FILENO, &orig) < 0) return -1;
        memcpy(orig_buf_data, &orig, sizeof(struct termios));
        raw = orig;
        raw.c_lflag &= ~(ECHO | ICANON | ISIG | IEXTEN);
        raw.c_iflag &= ~(BRKINT | ICRNL | INPCK | ISTRIP | IXON);
        // Note: OPOST is LEFT enabled so ANSI sequences are correctly processed
        // raw.c_oflag &= ~(OPOST);
        raw.c_cflag |= (CS8);
        raw.c_cc[VMIN] = 0;
        raw.c_cc[VTIME] = 1;
        if (tcsetattr(STDIN_FILENO, TCSAFLUSH, &raw) < 0) return -1;
        return 0;
    #endif
}#

@c_include("termios.h")
@c_include("unistd.h")
@c_include("string.h")
@internal
@extern("C")
fun __terminal_disable_raw_mode(orig_buf: u8[]): i32 #{
    #if defined(_WIN32) || defined(_WIN64)
        HANDLE h = GetStdHandle(STD_INPUT_HANDLE);
        DWORD mode;
        memcpy(&mode, orig_buf_data, sizeof(DWORD));
        if (!SetConsoleMode(h, mode)) return -1;
        return 0;
    #else
        struct termios orig;
        memcpy(&orig, orig_buf_data, sizeof(struct termios));
        if (tcsetattr(STDIN_FILENO, TCSAFLUSH, &orig) < 0) return -1;
        return 0;
    #endif
}#

@c_include("unistd.h")
@internal
@extern("C")
fun __terminal_read_key_bytes(buf: u8[]): i64 #{
    #if defined(_WIN32) || defined(_WIN64)
        HANDLE h = GetStdHandle(STD_INPUT_HANDLE);
        DWORD n;
        if (!ReadFile(h, buf_data, 1, &n, NULL)) return -1;
        return (int64_t)n;
    #else
        ssize_t n = read(STDIN_FILENO, buf_data, 1);
        if (n < 0) return -1;
        return (int64_t)n;
    #endif
}#

@c_include("sys/ioctl.h")
@c_include("string.h")
@internal
@extern("C")
fun __terminal_get_size_into(buf: u8[]): i32 #{
    #if defined(_WIN32) || defined(_WIN64)
        HANDLE h = GetStdHandle(STD_OUTPUT_HANDLE);
        CONSOLE_SCREEN_BUFFER_INFO info;
        if (!GetConsoleScreenBufferInfo(h, &info)) return -1;
        unsigned short rows = (unsigned short)(info.srWindow.Bottom - info.srWindow.Top + 1);
        unsigned short cols = (unsigned short)(info.srWindow.Right - info.srWindow.Left + 1);
        memcpy(buf_data, &rows, 2);
        memcpy(buf_data + 2, &cols, 2);
        return 0;
    #else
        struct winsize ws;
        if (ioctl(STDOUT_FILENO, TIOCGWINSZ, &ws) < 0) return -1;
        unsigned short rows = ws.ws_row;
        unsigned short cols = ws.ws_col;
        memcpy(buf_data, &rows, 2);
        memcpy(buf_data + 2, &cols, 2);
        return 0;
    #endif
}#

@c_include("unistd.h")
@c_include("termios.h")
@c_include("sys/ioctl.h")
@internal
@extern("C")
fun __terminal_write_raw_bytes(buf: u8[], len: usize): i64 #{
    #if defined(_WIN32) || defined(_WIN64)
        HANDLE h = GetStdHandle(STD_OUTPUT_HANDLE);
        DWORD written;
        if (!WriteFile(h, buf_data, (DWORD)len, &written, NULL)) return -1;
        return (int64_t)written;
    #else
        // Loop to handle partial writes
        size_t total = 0;
        while (total < len) {
            ssize_t n = write(STDOUT_FILENO, buf_data + total, len - total);
            if (n < 0) return -1;
            total += (size_t)n;
        }
        // Ensure all output is flushed to the terminal
        tcdrain(STDOUT_FILENO);
        return (int64_t)total;
    #endif
}#
