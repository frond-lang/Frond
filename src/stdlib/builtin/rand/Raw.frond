// builtin/rand/Raw.frond — PRNG primitives
//
// A single pure step function: xorshift64 with the splitmix-style final
// multiply folded in. The caller owns the state (std/rand/Rand.frond keeps
// it in a top-level var), so no C-side shared state is needed.

@internal
@extern("C")
fun __rand_step(state: u64): u64 #{
    uint64_t x = state;
    x ^= x >> 12;
    x ^= x << 25;
    x ^= x >> 27;
    return x * 0x2545F4914F6CDD1DULL;
}#
