            if (buf_data[root] >= buf_data[child]) break;
            uint8_t t = buf_data[root]; buf_data[root] = buf_data[child]; buf_data[child] = t;
            root = child;
        }
    }
    for (size_t e = n - 1; e > 0; e--) {
        uint8_t t = buf_data[0]; buf_data[0] = buf_data[e]; buf_data[e] = t;
        size_t root = 0;
        while (2 * root + 1 < e) {
            size_t child = 2 * root + 1;
            if (child + 1 < e && buf_data[child + 1] > buf_data[child]) child++;
            if (buf_data[root] >= buf_data[child]) break;
            uint8_t t2 = buf_data[root]; buf_data[root] = buf_data[child]; buf_data[child] = t2;
            root = child;
