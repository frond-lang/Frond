// In-place heapsort over the bool[] buffer (ascending, unstable).
@internal
@extern("C")
fun __sort_bool(buf: bool[]): void #{
    if (buf_len < 2) return;
    size_t n = buf_len;
    for (size_t s = n / 2; s-- > 0; ) {
        size_t root = s;
        while (2 * root + 1 < n) {
            size_t child = 2 * root + 1;
