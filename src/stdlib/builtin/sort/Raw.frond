// builtin/sort/Raw.frond — per-type in-place heapsort C primitives (builtin)
//
// The C fast path of the array sort facade (builtin/sort/Sort.frond): scalar
// element arrays route here by type_name(); every other element type (str[],
// records, mixed) uses the pure-Frond heapsort in Sort.frond. Marshaling
// reuses the scalar-array contract (SoA column → native bytes, {p}_len =
// ELEMENT count, mutations written back into the array) — the same machinery
// as builtin/mem. Self-contained heapsorts (no qsort): a comparator function
// pointer cannot cross the FFI boundary, and typed comparisons inline anyway.

@c_include("stdint.h")
@c_include("stddef.h")

// In-place heapsort over the i8[] buffer (ascending). Unstable; NaN
// ordering (floats) is unspecified — an inconsistent comparator just yields
// some permutation, never UB (no library qsort involved).
@internal
@extern("C")
fun __sort_i8(buf: i8[]): void #{
    if (buf_len < 2) return;
    size_t n = buf_len;
    for (size_t s = n / 2; s-- > 0; ) {
        size_t root = s;
        while (2 * root + 1 < n) {
            size_t child = 2 * root + 1;
            if (child + 1 < n && buf_data[child + 1] > buf_data[child]) child++;
            if (buf_data[root] >= buf_data[child]) break;
            int8_t t = buf_data[root]; buf_data[root] = buf_data[child]; buf_data[child] = t;
            root = child;
        }
    }
    for (size_t e = n - 1; e > 0; e--) {
        int8_t t = buf_data[0]; buf_data[0] = buf_data[e]; buf_data[e] = t;
        size_t root = 0;
        while (2 * root + 1 < e) {
            size_t child = 2 * root + 1;
            if (child + 1 < e && buf_data[child + 1] > buf_data[child]) child++;
            if (buf_data[root] >= buf_data[child]) break;
            int8_t t2 = buf_data[root]; buf_data[root] = buf_data[child]; buf_data[child] = t2;
            root = child;
        }
    }
}#
