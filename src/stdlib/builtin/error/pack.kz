// builtin error package declaration (decision #20: subdirectories need a pack.kz)
//
// Exposes Err / Error / CastError / IOError / TimeError to all Kuzo user code as visible by default (decision #19: fully visible by default).
// builtin packages are not loaded via the normal import mechanism, but are registered directly into the global environment by sema at startup.
pub pack Err
pub pack Error
pub pack CastError
pub pack IOError
pub pack TimeError
pub pack TerminalError
