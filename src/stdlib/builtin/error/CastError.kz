// CastError: error type returned when a cast builder conversion fails
//
// Usage:
//   - cast(x).try_to(T) returns Throw<T, CastError> on out-of-range value / str parse failure / Inf produced
//   - Field semantics:
//       msg   : error description (human readable)
//       from  : source type name (e.g. "i64")
//       to    : target type name (e.g. "i32")
//       value : string representation of the source value (e.g. "9999999999")
//
// As a builtin error_newtype, it automatically gets the Error trait's message() default implementation (reads the msg field).
// type_name() override returns "cast error" for easy identification in logs.
type CastError: Err = CastError(
    msg: str,
    from: str,
    to: str,
    value: str,
) {
    override fun type_name(): str { "cast error" }
}
