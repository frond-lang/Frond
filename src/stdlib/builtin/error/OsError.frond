// OsError: error type returned when a process-environment operation fails
// (std.os: env vars, cwd, tty detection, process info)
//
// Usage:
//   - Constructed by std/os wrappers (Env/Info/Os) when the underlying host
//     call fails
//   - Field semantics:
//       kind : error category (exhaustive ADT, used for match handling)
//       msg  : error description (human readable)
//       code : host raw error code (Windows GetLastError() / POSIX errno-ish
//              negative return; 0 if N/A)
//
// As a builtin error_newtype, it automatically gets the Err trait's message()
// default implementation (reads the msg field). type_name() override returns
// "os error" for easy identification in logs.
type OsError: Err = OsError(
    pub kind: OsErrorKind,
    pub message: str,
    pub code: i32,
) {
    override fun type_name(): str { "os error" }
}

// OS error categories (exhaustive ADT)
type OsErrorKind =
    | EnvFailed          // environment variable set/remove failed
    | NotFound           // path or entry does not exist
    | PermissionDenied   // permission denied by the OS
    | BufferTooSmall     // out-buffer too small for the host value
    | Unsupported        // capability not available on this platform
    | Other              // unclassified (check code field)
