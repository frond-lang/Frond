// builtin/io/Raw.frond — IO primitives @extern("C") declarations (builtin, visible by default)
//
// Low-level POSIX/Windows IO capabilities, compiled by the cc crate from the .c generated by emit-c.
// Cross-platform logic is implemented in the C body via #if conditional compilation.
// Called by wrappers in builtin/io/Console.frond and std/io/*.frond.

@c_include("fcntl.h")
@c_include("sys/stat.h")
@c_include("unistd.h")
@c_include("stdio.h")
@c_include("string.h")
@c_include("windows.h")
@c_include("io.h")
@c_include("direct.h")
@internal
@extern("C")
fun __file_open_raw(path: str, flags: i32, mode: i32): i64 #{
    #if defined(_WIN32) || defined(_WIN64)
        int posix_flags = 0;
        // Access mode must be decided MUTUALLY EXCLUSIVELY: OR-ing _O_WRONLY with
        // _O_RDWR (what the old bit-by-bit mapping produced for READ|WRITE) is an
        // invalid combination that makes MSVCRT abort the process.
        if ((flags & 3) == 3) {
            posix_flags |= _O_RDWR;
        } else if (flags & 2) {
            posix_flags |= _O_WRONLY;
        } else {
            posix_flags |= _O_RDONLY;
        }
        if (flags & 4) posix_flags |= _O_CREAT;
        if (flags & 8) posix_flags |= _O_TRUNC;
        if (flags & 16) posix_flags |= _O_APPEND;
        return _open(path_data, posix_flags | _O_BINARY, mode);
    #else
        int posix_flags = 0;
        if ((flags & 3) == 3) {
            posix_flags |= O_RDWR;
        } else if (flags & 2) {
            posix_flags |= O_WRONLY;
        } else {
            posix_flags |= O_RDONLY;
        }
        if (flags & 4) posix_flags |= O_CREAT;
        if (flags & 8) posix_flags |= O_TRUNC;
        if (flags & 16) posix_flags |= O_APPEND;
        return open(path_data, posix_flags, mode);
    #endif
}#

@c_include("unistd.h")
@internal
@extern("C")
fun __file_close_raw(fd: i64): i32 #{
    #if defined(_WIN32) || defined(_WIN64)
        return _close((int)fd);
    #else
        return close((int)fd);
    #endif
}#

@c_include("unistd.h")
@internal
@extern("C")
fun __file_read_into(fd: i64, buf: u8[], len: usize): i64 #{
    #if defined(_WIN32) || defined(_WIN64)
        return _read((int)fd, buf_data, (unsigned int)buf_len);
    #else
        return read((int)fd, buf_data, buf_len);
    #endif
}#

@c_include("unistd.h")
@internal
@extern("C")
fun __file_write(fd: i64, buf: u8[], len: usize): i64 #{
    #if defined(_WIN32) || defined(_WIN64)
        return _write((int)fd, buf_data, (unsigned int)buf_len);
    #else
        return write((int)fd, buf_data, buf_len);
    #endif
}#

@c_include("unistd.h")
@internal
@extern("C")
fun __file_seek_raw(fd: i64, offset: i64, whence: i32): i64 #{
    #if defined(_WIN32) || defined(_WIN64)
        int origin = whence == 0 ? FILE_BEGIN : (whence == 1 ? FILE_CURRENT : FILE_END);
        LONG high = (LONG)(offset >> 32);
        DWORD low = SetFilePointer((HANDLE)(intptr_t)fd, (LONG)(offset & 0xFFFFFFFF), &high, origin);
        if (low == INVALID_SET_FILE_POINTER) return -1;
        return ((int64_t)high << 32) | (int64_t)low;
    #else
        int posix_whence = whence == 0 ? SEEK_SET : (whence == 1 ? SEEK_CUR : SEEK_END);
        return lseek((int)fd, offset, posix_whence);
    #endif
}#

@c_include("unistd.h")
@internal
@extern("C")
fun __file_remove_raw(path: str): i32 #{
    #if defined(_WIN32) || defined(_WIN64)
        return _unlink(path_data);
    #else
        return unlink(path_data);
    #endif
}#

@c_include("stdio.h")
@internal
@extern("C")
fun __file_rename_raw(old: str, new: str): i32 #{
    return rename(old_data, new_data);
}#

@c_include("unistd.h")
@internal
@extern("C")
fun __stdout_write_raw(s: str): i32 #{
    #if defined(_WIN32) || defined(_WIN64)
        HANDLE h = GetStdHandle(STD_OUTPUT_HANDLE);
        DWORD written;
        if (!WriteFile(h, s_data, (DWORD)s_len, &written, NULL)) return -1;
        return 0;
    #else
        ssize_t n = write(STDOUT_FILENO, s_data, s_len);
        return n < 0 ? -1 : 0;
    #endif
}#

@c_include("unistd.h")
@internal
@extern("C")
fun __stderr_write_raw(s: str): i32 #{
    #if defined(_WIN32) || defined(_WIN64)
        HANDLE h = GetStdHandle(STD_ERROR_HANDLE);
        DWORD written;
        if (!WriteFile(h, s_data, (DWORD)s_len, &written, NULL)) return -1;
        return 0;
    #else
        ssize_t n = write(STDERR_FILENO, s_data, s_len);
        return n < 0 ? -1 : 0;
    #endif
}#

// Reads one line into buffer, returns number of bytes read (>=0 success, 1 EOF, -1 error)
// buf_data/buf_len are automatically provided by u8[] marshal
@c_include("unistd.h")
@c_include("io.h")
@internal
@extern("C")
fun __stdin_readln_into(buf: u8[]): i64 #{
    size_t total = 0;
    char ch;
    #if defined(_WIN32) || defined(_WIN64)
        int n;
        while (total < buf_len) {
            n = _read(0, &ch, 1);
            if (n < 0) return -1;
            if (n == 0) return total == 0 ? 1 : (int64_t)total;
            if (ch == '\n') return (int64_t)total;
            buf_data[total++] = ch;
        }
    #else
        ssize_t n;
        while (total < buf_len) {
            n = read(STDIN_FILENO, &ch, 1);
            if (n < 0) return -1;
            if (n == 0) return total == 0 ? 1 : (int64_t)total;
            if (ch == '\n') return (int64_t)total;
            buf_data[total++] = ch;
        }
    #endif
    return (int64_t)total;
}#

@c_include("sys/stat.h")
@internal
@extern("C")
fun __dir_create_raw(path: str, recursive: bool): i32 #{
    #if defined(_WIN32) || defined(_WIN64)
        if (recursive) {
            char buf[4096];
            size_t len = path_len < sizeof(buf)-1 ? path_len : sizeof(buf)-1;
            memcpy(buf, path_data, len);
            buf[len] = 0;
            for (char* p = buf+1; *p; p++) {
                if (*p == '/' || *p == '\\') { *p = 0; _mkdir(buf); *p = '/'; }
            }
            return _mkdir(buf);
        }
        return _mkdir(path_data);
    #else
        if (recursive) {
            char buf[4096];
            size_t len = path_len < sizeof(buf)-1 ? path_len : sizeof(buf)-1;
            memcpy(buf, path_data, len);
            buf[len] = 0;
            for (char* p = buf+1; *p; p++) {
                if (*p == '/') { *p = 0; mkdir(buf, 0755); *p = '/'; }
            }
            return mkdir(buf, 0755);
        }
        return mkdir(path_data, 0755);
    #endif
}#

@c_include("unistd.h")
@internal
@extern("C")
fun __dir_remove_raw(path: str, recursive: bool): i32 #{
    (void)recursive;
    #if defined(_WIN32) || defined(_WIN64)
        return _rmdir(path_data);
    #else
        return rmdir(path_data);
    #endif
}#

// ─── chmod ───────────────────────────────────────────────────────

@c_include("sys/stat.h")
@internal
@extern("C")
fun __file_chmod_raw(path: str, mode: i32): i32 #{
    #if defined(_WIN32) || defined(_WIN64)
        return _chmod(path_data, mode);
    #else
        return chmod(path_data, mode);
    #endif
}#

// ─── stat/fstat: returns structured data via u8[] out-buffer ───────────────
//
// buf layout (28 bytes, native endian):
//   [0..8)   size     u64
//   [8..16)  mtime_ns i64 (POSIX seconds → nanoseconds conversion)
//   [16..24) ctime_ns i64
//   [24..28) kind     i32 (0=file, 1=dir, 2=symlink, 3=other)
//
// Returns 0=success, -1=failure

@c_include("sys/stat.h")
@internal
@extern("C")
fun __file_stat_into(path: str, buf: u8[]): i32 #{
    #if defined(_WIN32) || defined(_WIN64)
        struct _stat64 st;
        if (_stat64(path_data, &st) < 0) return -1;
        uint64_t size = (uint64_t)st.st_size;
        int64_t mtime = (int64_t)st.st_mtime * 1000000000LL;
        int64_t ctime = (int64_t)st.st_ctime * 1000000000LL;
        int32_t kind = (st.st_mode & _S_IFREG) ? 0 : (st.st_mode & _S_IFDIR) ? 1 : 3;
        memcpy(buf_data, &size, 8);
        memcpy(buf_data + 8, &mtime, 8);
        memcpy(buf_data + 16, &ctime, 8);
        memcpy(buf_data + 24, &kind, 4);
        return 0;
    #elif defined(__APPLE__)
        struct stat st;
        if (stat(path_data, &st) < 0) return -1;
        uint64_t size = (uint64_t)st.st_size;
        int64_t mtime = (int64_t)st.st_mtimespec.tv_sec * 1000000000LL + st.st_mtimespec.tv_nsec;
        int64_t ctime = (int64_t)st.st_ctimespec.tv_sec * 1000000000LL + st.st_ctimespec.tv_nsec;
        int32_t kind = S_ISREG(st.st_mode) ? 0 : S_ISDIR(st.st_mode) ? 1 : S_ISLNK(st.st_mode) ? 2 : 3;
        memcpy(buf_data, &size, 8);
        memcpy(buf_data + 8, &mtime, 8);
        memcpy(buf_data + 16, &ctime, 8);
        memcpy(buf_data + 24, &kind, 4);
        return 0;
    #else
        struct stat st;
        if (stat(path_data, &st) < 0) return -1;
        uint64_t size = (uint64_t)st.st_size;
        int64_t mtime = (int64_t)st.st_mtim.tv_sec * 1000000000LL + st.st_mtim.tv_nsec;
        int64_t ctime = (int64_t)st.st_ctim.tv_sec * 1000000000LL + st.st_ctim.tv_nsec;
        int32_t kind = S_ISREG(st.st_mode) ? 0 : S_ISDIR(st.st_mode) ? 1 : S_ISLNK(st.st_mode) ? 2 : 3;
        memcpy(buf_data, &size, 8);
        memcpy(buf_data + 8, &mtime, 8);
        memcpy(buf_data + 16, &ctime, 8);
        memcpy(buf_data + 24, &kind, 4);
        return 0;
    #endif
}#

@c_include("sys/stat.h")
@internal
@extern("C")
fun __file_fstat_into(fd: i64, buf: u8[]): i32 #{
    #if defined(_WIN32) || defined(_WIN64)
        struct _stat64 st;
        if (_fstat64((int)fd, &st) < 0) return -1;
        uint64_t size = (uint64_t)st.st_size;
        int64_t mtime = (int64_t)st.st_mtime * 1000000000LL;
        int64_t ctime = (int64_t)st.st_ctime * 1000000000LL;
        int32_t kind = (st.st_mode & _S_IFREG) ? 0 : (st.st_mode & _S_IFDIR) ? 1 : 3;
        memcpy(buf_data, &size, 8);
        memcpy(buf_data + 8, &mtime, 8);
        memcpy(buf_data + 16, &ctime, 8);
        memcpy(buf_data + 24, &kind, 4);
        return 0;
    #elif defined(__APPLE__)
        struct stat st;
        if (fstat((int)fd, &st) < 0) return -1;
        uint64_t size = (uint64_t)st.st_size;
        int64_t mtime = (int64_t)st.st_mtimespec.tv_sec * 1000000000LL + st.st_mtimespec.tv_nsec;
        int64_t ctime = (int64_t)st.st_ctimespec.tv_sec * 1000000000LL + st.st_ctimespec.tv_nsec;
        int32_t kind = S_ISREG(st.st_mode) ? 0 : S_ISDIR(st.st_mode) ? 1 : S_ISLNK(st.st_mode) ? 2 : 3;
        memcpy(buf_data, &size, 8);
        memcpy(buf_data + 8, &mtime, 8);
        memcpy(buf_data + 16, &ctime, 8);
        memcpy(buf_data + 24, &kind, 4);
        return 0;
    #else
        struct stat st;
        if (fstat((int)fd, &st) < 0) return -1;
        uint64_t size = (uint64_t)st.st_size;
        int64_t mtime = (int64_t)st.st_mtim.tv_sec * 1000000000LL + st.st_mtim.tv_nsec;
        int64_t ctime = (int64_t)st.st_ctim.tv_sec * 1000000000LL + st.st_ctim.tv_nsec;
        int32_t kind = S_ISREG(st.st_mode) ? 0 : S_ISDIR(st.st_mode) ? 1 : S_ISLNK(st.st_mode) ? 2 : 3;
        memcpy(buf_data, &size, 8);
        memcpy(buf_data + 8, &mtime, 8);
        memcpy(buf_data + 16, &ctime, 8);
        memcpy(buf_data + 24, &kind, 4);
        return 0;
    #endif
}#

// ─── Directory listing (out-buffer mode)──────────────────────────────────
//
// Low-level scalar capability sink: the C layer traverses the directory and fills entry names and kind into three out-buffers.
// The upper-layer runtime builtin (__dir_list) calls this primitive, then assembles the DirEntry[] heap object from the buffers.
//
// Three out-buffers working together:
//   names_buf     continuously stores all entry name bytes (no separator, delimited by name_offsets)
//   name_offsets  4 bytes u32 LE per entry, offset relative to the start of names_buf
//   kinds_buf     1 byte kind per entry (0=file, 1=dir, 2=symlink, 3=other)
//
// Return value:
//   >=0  actual number of entries ("." and ".." already skipped)
//   -1   error (path does not exist / no permission)
//   -2   some buffer capacity insufficient
//   -3   max_count insufficient (number of entries exceeds upper limit)
@c_include("string.h")
@internal
@extern("C")
fun __dir_list_into(path: str, names_buf: u8[], name_offsets: u8[], kinds_buf: u8[], max_count: usize): i64 #{
    #if defined(_WIN32) || defined(_WIN64)
        WIN32_FIND_DATAA fd;
        char pattern[4096];
        size_t plen = path_len < sizeof(pattern) - 3 ? path_len : sizeof(pattern) - 3;
        memcpy(pattern, path_data, plen);
        pattern[plen] = '\\';
        pattern[plen + 1] = '*';
        pattern[plen + 2] = 0;
        HANDLE h = FindFirstFileA(pattern, &fd);
        if (h == INVALID_HANDLE_VALUE) return -1;
        size_t count = 0;
        size_t names_pos = 0;
        do {
            if (strcmp(fd.cFileName, ".") == 0 || strcmp(fd.cFileName, "..") == 0) continue;
            if (count >= max_count) { FindClose(h); return -3; }
            size_t nlen = strlen(fd.cFileName);
            if (names_pos + nlen > names_buf_len) { FindClose(h); return -2; }
            if ((count + 1) * 4 > name_offsets_len) { FindClose(h); return -2; }
            if (count >= kinds_buf_len) { FindClose(h); return -2; }
            memcpy(names_buf_data + names_pos, fd.cFileName, nlen);
            uint32_t off = (uint32_t)names_pos;
            memcpy(name_offsets_data + count * 4, &off, 4);
            uint8_t kind = 0;
            DWORD attr = fd.dwFileAttributes;
            if (attr & FILE_ATTRIBUTE_DIRECTORY) kind = 1;
            else if (attr & FILE_ATTRIBUTE_REPARSE_POINT) kind = 2;
            else kind = 0;
            kinds_buf_data[count] = kind;
            names_pos += nlen;
            count++;
        } while (FindNextFileA(h, &fd));
        FindClose(h);
        return (int64_t)count;
    #else
        #if defined(__APPLE__) || defined(__linux__) || defined(__unix__)
            #include <dirent.h>
        #endif
        DIR* d = opendir(path_data);
        if (!d) return -1;
        size_t count = 0;
        size_t names_pos = 0;
        struct dirent* e;
        while ((e = readdir(d)) != NULL) {
            if (strcmp(e->d_name, ".") == 0 || strcmp(e->d_name, "..") == 0) continue;
            if (count >= max_count) { closedir(d); return -3; }
            size_t nlen = strlen(e->d_name);
            if (names_pos + nlen > names_buf_len) { closedir(d); return -2; }
            if ((count + 1) * 4 > name_offsets_len) { closedir(d); return -2; }
            if (count >= kinds_buf_len) { closedir(d); return -2; }
            memcpy(names_buf_data + names_pos, e->d_name, nlen);
            uint32_t off = (uint32_t)names_pos;
            memcpy(name_offsets_data + count * 4, &off, 4);
            uint8_t kind = 3;
            switch (e->d_type) {
                case DT_REG: kind = 0; break;
                case DT_DIR: kind = 1; break;
                case DT_LNK: kind = 2; break;
                default: kind = 3; break;
            }
            kinds_buf_data[count] = kind;
            names_pos += nlen;
            count++;
        }
        closedir(d);
        return (int64_t)count;
    #endif
}#

// ─── Existence / copy ──────────────────────────────────────────────────────

// Whether the path exists (file, directory, or otherwise). 1=yes, 0=no.
@c_include("windows.h")
@c_include("unistd.h")
@internal
@extern("C")
fun __file_exists_raw(path: str): i32 #{
    #if defined(_WIN32) || defined(_WIN64)
        DWORD attr = GetFileAttributesA(path_data);
        return attr != INVALID_FILE_ATTRIBUTES ? 1 : 0;
    #else
        return access(path_data, F_OK) == 0 ? 1 : 0;
    #endif
}#

// Copy a file (overwrites dst). Windows: CopyFileA; POSIX: read/write loop.
@c_include("windows.h")
@c_include("fcntl.h")
@c_include("unistd.h")
@internal
@extern("C")
fun __file_copy_raw(src: str, dst: str): i32 #{
    #if defined(_WIN32) || defined(_WIN64)
        return CopyFileA(src_data, dst_data, FALSE) ? 0 : -1;
    #else
        int in = open(src_data, O_RDONLY);
        if (in < 0) return -1;
        int out = open(dst_data, O_WRONLY | O_CREAT | O_TRUNC, 0644);
        if (out < 0) { close(in); return -1; }
        char buf[65536];
        for (;;) {
            ssize_t n = read(in, buf, sizeof(buf));
            if (n < 0) { close(in); close(out); return -1; }
            if (n == 0) break;
            ssize_t w = write(out, buf, (size_t)n);
            if (w != n) { close(in); close(out); return -1; }
        }
        close(in);
        close(out);
        return 0;
    #endif
}#
