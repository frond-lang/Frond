// Writer trait: byte write abstraction
//
// Implementers provide the async IO semantics of write:
// - &write(buf, len) writes the first len bytes of buf, returns the actual number of bytes written
// - &write_all(buf, len) writes all bytes, returns void
trait Writer {
    // Core write method: returns the actual number of bytes written
    async fun &write(buf: u8[], len: usize): Async<Throw<usize, IOError>>

    // Writes all bytes; throws BrokenPipe when write returns 0
    async fun &write_all(buf: u8[], len: usize): Async<Throw<void, IOError>>
}
