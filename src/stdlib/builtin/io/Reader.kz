// Reader trait: byte read abstraction
//
// Implementers provide the async IO semantics of read:
// - &read(len) reads at most len bytes, returns u8[]; empty array means EOF
// - &read_byte() reads a single byte, returns u8?; null means EOF
trait Reader {
    // Core read method: returns at most len bytes, empty array = EOF
    async fun &read(len: usize): Async<Throw<u8[], IOError>>

    // Reads a single byte, returns null on EOF
    async fun &read_byte(): Async<Throw<u8?, IOError>>
}
