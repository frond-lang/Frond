// Reader trait: 字节读取抽象
//
// 实现者提供 read 的 async IO 语义：
// - &read(len) 读取最多 len 字节，返回 u8[]；空数组表示 EOF
// - &read_byte() 读取单个字节，返回 u8?；null 表示 EOF
trait Reader {
    // 核心读取方法：返回最多 len 字节，空数组 = EOF
    async fun &read(len: usize): Async<Throw<u8[], IOError>>

    // 读取单个字节，EOF 返回 null
    async fun &read_byte(): Async<Throw<u8?, IOError>>
}
