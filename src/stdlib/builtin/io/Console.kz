// builtin/io/Console.kz — 标准 IO 顶层入口（builtin，默认可见）
//
// println/print/eprintln/eprint 为同步函数，返回 Throw<void, IOError>。
// scan/scanln 为同步函数，返回 Throw<str?, IOError>（null = EOF）。
//
// 格式化委托给 builtin/reflect/Reflect.format（builtin 默认可见，无需 import）。
// 底层 @extern("C") 原语（__stdout_write_raw / __stderr_write_raw / __stdin_readln_into）
// 由 builtin/io/Raw.kz 声明，cc crate 编译为 kuzo_extern 静态库。
//
// 用法（builtin 默认可见，无需 import）：
//   println("hello")           // hello
//   println(Point(3, 4))       // Point(x: 3, y: 4)

// ─── Kuzo wrapper：C 原始返回值 → Throw ──────────────────────────

// __stdout_write_raw(s: str): i32 → Throw<void, IOError>
// rc < 0 = 写入失败
fun __stdout_write(s: str): Throw<void, IOError> {
    val rc = __stdout_write_raw(s)
    if rc < 0 {
        throw IOError(Other, "stdout write failed", 0, null)
    }
    Ok(void)
}

// __stderr_write_raw(s: str): i32 → Throw<void, IOError>
fun __stderr_write(s: str): Throw<void, IOError> {
    val rc = __stderr_write_raw(s)
    if rc < 0 {
        throw IOError(Other, "stderr write failed", 0, null)
    }
    Ok(void)
}

// __stdin_readln(): Throw<str?, IOError>
// 通过 @extern("C") __stdin_readln_into 读入 u8[] buffer，再 cast 为 str。
// 返回 None = EOF，Some(s) = 去除换行后的行。
fun __stdin_readln(): Throw<str?, IOError> {
    val buf: u8[] = [0u8] * 4096
    val n = __stdin_readln_into(buf)
    if n < 0 {
        throw IOError(Other, "stdin read failed", 0, null)
    }
    if n == 1 {
        Ok(null)
    } else {
        Ok(cast(buf[0..cast(n).to(usize)]).to(str))
    }
}

// ─── 标准输出 ──────────────────────────────────────────────────────

pub fun print<T>(x: T): Throw<void, IOError> {
    val s = format(x)
    __stdout_write(s)?
    Ok(void)
}

pub fun println<T>(x: T): Throw<void, IOError> {
    val s = format(x)
    __stdout_write(s)?
    __stdout_write("\n")?
    Ok(void)
}

// ─── 标准错误 ──────────────────────────────────────────────────────

pub fun eprint<T>(x: T): Throw<void, IOError> {
    val s = format(x)
    __stderr_write(s)?
    Ok(void)
}

pub fun eprintln<T>(x: T): Throw<void, IOError> {
    val s = format(x)
    __stderr_write(s)?
    __stderr_write("\n")?
    Ok(void)
}

// ─── 标准输入 ─────────────────────────────────────────────────────

// scanln: 读一行（不含换行），EOF 返回 null
pub fun scanln(): Throw<str?, IOError> {
    __stdin_readln()?
}

// scan: 读空白分隔 token，无 token（EOF 或空白行）返回 null
// 用现有 str 原语（len/index/slice）组合实现，无新增内置方法。
pub fun scan(): Throw<str?, IOError> {
    val line = __stdin_readln()?
    val token: str? = match line {
        null => null,
        s => {
            val n = s.len()
            var i: usize = 0
            while i < n && (s[i] == ' ' || s[i] == '\t' || s[i] == '\n' || s[i] == '\r') {
                i = i + 1
            }
            if i == n {
                null
            } else {
                var j: usize = i
                while j < n && !(s[j] == ' ' || s[j] == '\t' || s[j] == '\n' || s[j] == '\r') {
                    j = j + 1
                }
                s[i..j]
            }
        },
    }
    Ok(token)
}
