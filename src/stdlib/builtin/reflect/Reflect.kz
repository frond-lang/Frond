// builtin/reflect/Reflect.kz — runtime reflection (builtin, visible by default)
//
// Two-layer reflection API:
//   1. Value reflection: reflect(x)/format(x)/type_name(x) — receives a value, matches HeapObj at runtime
//   2. Type reflection: typeof(Type) — receives a type name, generates a TypeInfo record at compile time
//      typeof is intercepted by Sema (does not go through normal function lookup), the parameter is resolved as a type rather than a value variable
//
// Usage (builtin visible by default, no import needed):
//   val r = reflect(x)            // any value → Reflect
//   val s = format(x)             // any value → str
//   val tn = type_name(x)         // any value → type name (str)
//   val info = typeof(Point)      // type → TypeInfo record (compile-time reflection)
//   val info = typeof(T)          // generic parameter → TypeInfo (lookup after monomorphization)
//   val info = typeof(This)       // in trait default → TypeInfo
//   val info = typeof(T?)         // nullable → TypeInfo (kind="Nullable")

// ─── Type reflection type definitions ─────────────────────────────────────────────

// Type layout information
type LayoutInfo = LayoutInfo(size: u32, alignment: u32)

// trait implementation information
type TraitImplInfo = TraitImplInfo(
    parent_traits: str[],
    implemented_traits: str[],
    methods: str[],
    associated_types: str[]
)

// Type metadata (typeof return value)
// The structure field is of Value type, at runtime it is a record value (type_name returns "record")
type TypeInfo = TypeInfo(
    name: str,
    module: str,
    kind: str,
    layout: LayoutInfo,
    impls: TraitImplInfo,
    structure: Value,
    type_params: str[]
)

// ─── Reflect builtin type: wraps Value ──────────────────────────────
type Reflect = Reflect(inner: Value) {
    // ─── Type metadata methods ───────────────────────────────────────────
    pub fun kind(): u8 {
        __reflect_kind(inner)
    }

    pub fun type_name(): str {
        __reflect_type_name(inner)
    }

    pub fun size(): u8 {
        __reflect_size(inner)
    }

    pub fun field_count(): u16 {
        __reflect_field_count(inner)
    }

    // ─── Field metadata methods ───────────────────────────────────────────
    pub fun field_name(index: u16): str {
        __reflect_field_name(inner, index)
    }

    pub fun field_value(index: u16): Reflect {
        Reflect(__reflect_field_value(inner, index))
    }

    // ─── Array length ─────────────────────────────────────────────────
    pub fun array_len(): usize {
        __reflect_array_len(inner)
    }

    // ─── ADT constructor name ─────────────────────────────────────────────
    pub fun adt_constructor(): str {
        __reflect_adt_constructor(inner)
    }
}

// ─── Top-level reflection entry ─────────────────────────────────────────────────
// reflect(x): wraps Value as Reflect, no Sema interception, no type_id injection
pub fun reflect(x: Value): Reflect {
    Reflect(x)
}

// typeof(x: Value): value reflection, returns full TypeInfo record
pub fun typeof(x: Value): TypeInfo {
    val name = __reflect_type_name(x)
    val kind = __reflect_kind_str(x)
    val module = ""
    val size = __reflect_layout_size(x)
    val alignment = __reflect_layout_alignment(x)
    val layout = LayoutInfo(size, alignment)
    val empty_strs: str[] = []
    val impls = TraitImplInfo(empty_strs, empty_strs, empty_strs, empty_strs)
    val type_params: str[] = []
    val structure = x
    TypeInfo(name, module, kind, layout, impls, structure, type_params)
}

pub fun type_name(x: Value): str {
    __reflect_type_name(x)
}

pub fun format(x: Value): str {
    __reflect_format(x)
}
