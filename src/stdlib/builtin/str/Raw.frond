// builtin/str/Raw.frond — string UTF-8 decoding @extern("C") primitives (builtin, visible by default)
//
// Provides UTF-8 character-by-character decoding capability, used by StringIterator in builtin/iter/Iterator.frond.
// Low-level C bit decoding, compiled by the cc crate from the .c generated by emit-c.
//
// Primitives:
//   __str_utf8_decode_at(s, offset)   → i64 (code point, -1=end/invalid)
//   __str_utf8_char_len_at(s, offset) → usize (byte length of the character at this position 1-4, 0=out of range)

@c_include("stdint.h")

// Decodes one UTF-8 character at byte offset offset in string s, returns the Unicode code point.
// Returns -1 when offset is out of range or an invalid UTF-8 sequence is encountered.
@internal
@extern("C")
fun __str_utf8_decode_at(s: str, offset: usize): i64 #{
    if (offset >= s_len) return -1;
    unsigned char c = (unsigned char)s_data[offset];
    uint32_t cp;
    if (c < 0x80) {
        cp = c;
    } else if ((c & 0xE0) == 0xC0) {
        if (offset + 1 >= s_len) return -1;
        cp = ((uint32_t)(c & 0x1F) << 6)
           | ((uint32_t)(s_data[offset + 1] & 0x3F));
    } else if ((c & 0xF0) == 0xE0) {
        if (offset + 2 >= s_len) return -1;
        cp = ((uint32_t)(c & 0x0F) << 12)
           | ((uint32_t)(s_data[offset + 1] & 0x3F) << 6)
           | ((uint32_t)(s_data[offset + 2] & 0x3F));
    } else if ((c & 0xF8) == 0xF0) {
        if (offset + 3 >= s_len) return -1;
        cp = ((uint32_t)(c & 0x07) << 18)
           | ((uint32_t)(s_data[offset + 1] & 0x3F) << 12)
           | ((uint32_t)(s_data[offset + 2] & 0x3F) << 6)
           | ((uint32_t)(s_data[offset + 3] & 0x3F));
    } else {
        return -1;
    }
    return (int64_t)cp;
}#

// Returns the UTF-8 character byte length (1-4) at byte offset offset in string s.
// Returns 0 when offset is out of range. Invalid UTF-8 leading bytes are treated as 1.
@internal
@extern("C")
fun __str_utf8_char_len_at(s: str, offset: usize): usize #{
    if (offset >= s_len) return 0;
    unsigned char c = (unsigned char)s_data[offset];
    if (c < 0x80) return 1;
    else if ((c & 0xE0) == 0xC0) return 2;
    else if ((c & 0xF0) == 0xE0) return 3;
    else if ((c & 0xF8) == 0xF0) return 4;
    return 1;
}#

// Concatenates a string array in one pass: str[] + sep → str, O(n) time complexity.
// C body is empty (pure Rust logic, implemented in compute_ffi_call).
@internal
@extern("C")
fun __str_array_join(arr: str[], sep: str): str #{
}#
