// builtin/cast/Raw.kz — type cast @extern("C") primitives (builtin, visible by default)
//
// Low-level C bit cast primitives, compiled by the cc crate from the emit-c generated .c.
// The Kuzo wrappers in Cast.kz combine these primitives via two-step relay (S→i128→T).
//
// Cast strategy:
//   - integer → integer: relayed via i128 (widen S→i128, narrow i128→T)
//   - char → u8: direct truncation (char is internally a u32 codepoint)
//   - char → str: UTF-8 encode codepoint as a string
//   - [u8] → str: byte array to string (assumes valid UTF-8)

@c_include("stdint.h")

// ─── widening: integer → i128 ─────────────────────────────────────────
// All integer types losslessly widen to i128 (except i128 itself, identity needs no function).
// Result delivered via out_lo/out_hi (low/high 64 bits) — portable across GCC/Clang/MSVC.

@extern("C")
fun __cast_i8_to_i128(x: i8): i128 #{
    *out_lo = (uint64_t)(int64_t)x;
    *out_hi = (x < 0) ? (uint64_t)-1 : 0;
}#

@extern("C")
fun __cast_i16_to_i128(x: i16): i128 #{
    *out_lo = (uint64_t)(int64_t)x;
    *out_hi = (x < 0) ? (uint64_t)-1 : 0;
}#

@extern("C")
fun __cast_i32_to_i128(x: i32): i128 #{
    *out_lo = (uint64_t)(int64_t)x;
    *out_hi = (x < 0) ? (uint64_t)-1 : 0;
}#

@extern("C")
fun __cast_i64_to_i128(x: i64): i128 #{
    *out_lo = (uint64_t)x;
    *out_hi = (x < 0) ? (uint64_t)-1 : 0;
}#

@extern("C")
fun __cast_u8_to_i128(x: u8): i128 #{
    *out_lo = (uint64_t)x;
    *out_hi = 0;
}#

@extern("C")
fun __cast_u16_to_i128(x: u16): i128 #{
    *out_lo = (uint64_t)x;
    *out_hi = 0;
}#

@extern("C")
fun __cast_u32_to_i128(x: u32): i128 #{
    *out_lo = (uint64_t)x;
    *out_hi = 0;
}#

@extern("C")
fun __cast_u64_to_i128(x: u64): i128 #{
    *out_lo = x;
    *out_hi = 0;
}#

@extern("C")
fun __cast_usize_to_i128(x: usize): i128 #{
    *out_lo = (uint64_t)x;
    *out_hi = 0;
}#

// ─── narrowing: i128 → integer (wrapping) ────────────────────────────
// Truncates high bits, keeps low bits (C's default cast semantics).
// Only the low 64 bits matter for targets ≤ 64 bits, so we use x_lo directly
// (portable: avoids the __int128 reconstruction that MSVC cannot compile).

@extern("C")
fun __cast_i128_to_i8(x: i128): i8 #{
    return (int8_t)(int64_t)x_lo;
}#

@extern("C")
fun __cast_i128_to_i16(x: i128): i16 #{
    return (int16_t)(int64_t)x_lo;
}#

@extern("C")
fun __cast_i128_to_i32(x: i128): i32 #{
    return (int32_t)(int64_t)x_lo;
}#

@extern("C")
fun __cast_i128_to_i64(x: i128): i64 #{
    return (int64_t)x_lo;
}#

@extern("C")
fun __cast_i128_to_u8(x: i128): u8 #{
    return (uint8_t)x_lo;
}#

@extern("C")
fun __cast_i128_to_u16(x: i128): u16 #{
    return (uint16_t)x_lo;
}#

@extern("C")
fun __cast_i128_to_u32(x: i128): u32 #{
    return (uint32_t)x_lo;
}#

@extern("C")
fun __cast_i128_to_u64(x: i128): u64 #{
    return x_lo;
}#

@extern("C")
fun __cast_i128_to_usize(x: i128): usize #{
    return (size_t)x_lo;
}#

// ─── special: char casts ────────────────────────────────────────────

@extern("C")
fun __cast_char_to_u8(x: char): u8 #{
    return (uint8_t)x;
}#

@extern("C")
fun __cast_char_to_str(x: char): str #{
    // UTF-8 encode codepoint: 1-4 bytes
    // Use a thread-local static buffer to avoid dangling pointers.
    // __declspec(thread) is portable across MSVC/GCC/Clang; `__thread` alone
    // fails to parse as a function-local static on MSVC.
    static __declspec(thread) char buf[4];
    int len = 0;
    uint32_t cp = (uint32_t)x;
    if (cp <= 0x7F) {
        buf[0] = (char)cp;
        len = 1;
    } else if (cp <= 0x7FF) {
        buf[0] = (char)(0xC0 | (cp >> 6));
        buf[1] = (char)(0x80 | (cp & 0x3F));
        len = 2;
    } else if (cp <= 0xFFFF) {
        buf[0] = (char)(0xE0 | (cp >> 12));
        buf[1] = (char)(0x80 | ((cp >> 6) & 0x3F));
        buf[2] = (char)(0x80 | (cp & 0x3F));
        len = 3;
    } else {
        buf[0] = (char)(0xF0 | (cp >> 18));
        buf[1] = (char)(0x80 | ((cp >> 12) & 0x3F));
        buf[2] = (char)(0x80 | ((cp >> 6) & 0x3F));
        buf[3] = (char)(0x80 | (cp & 0x3F));
        len = 4;
    }
    *out_data = buf;
    *out_len = (size_t)len;
}#

// ─── special: [u8] → str ───────────────────────────────────────────

@extern("C")
fun __cast_bytes_to_str(buf: u8[]): str #{
    // Use the byte array directly as string content (assumes valid UTF-8)
    // out_data points to the input buffer, lifetime bound to the input &[u8]
    *out_data = (const char*)buf_data;
    *out_len = buf_len;
}#
