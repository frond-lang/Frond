// builtin/net/Raw.frond — Net primitives @extern("C") declarations (builtin, visible by default)
//
// Low-level POSIX/Windows network capabilities, compiled from emit-c generated .c by the cc crate.
// Cross-platform: every function has both a POSIX (sys/socket.h) and a Windows (winsock2.h) branch.
//
// Design notes:
// - IpAddr/Ipv6Addr and other record types are decomposed into scalars by the Frond-side wrapper before calling this layer.
// - For example, __net_tcp_connect_v4 receives u32 ip_bits; the connect wrapper in std/net/TcpStream.frond
//   extracts bits from IpAddr.V4(Ipv4Addr(bits)) and passes it in.
// - Timeout parameter timeout_ns: i64, <0 means infinite wait.
// - Return value convention: fd as i64 on success, -1 on error (POSIX) / SOCKET_ERROR mapped to -1 (Windows).
// - Winsock requires WSAStartup before any socket call; the four socket-creating entry points
//   (tcp_connect_v4/v6, tcp_listen_v4/v6, udp_bind_v4/v6) lazily initialize it via a refcount guard.

// ─── TCP IPv4 ──────────────────────────────────────────────────────────
//
// Winsock requires WSAStartup before any socket call. Each socket-creating
// entry point lazily initializes it via an inlined refcount guard (a separate
// @extern("C") helper cannot be used because Gen.rs prefixes every exported
// symbol with `frond_extern_`, which would break the cross-function call name).

@c_include("winsock2.h")
@c_include("ws2tcpip.h")
@c_include("string.h")
@internal
@extern("C")
fun __net_tcp_connect_v4(ip_bits: u32, port: u16, timeout_ns: i64): i64 #{
    #if defined(_WIN32) || defined(_WIN64)
        { static LONG _wsa_rc = 0; if (InterlockedExchangeAdd(&_wsa_rc, 1) == 0) { WSADATA _d; if (WSAStartup(MAKEWORD(2,2), &_d) != 0) { InterlockedDecrement(&_wsa_rc); return -1; } } }
        SOCKET s = socket(AF_INET, SOCK_STREAM, 0);
        if (s == INVALID_SOCKET) return -1;
        struct sockaddr_in addr;
        memset(&addr, 0, sizeof(addr));
        addr.sin_family = AF_INET;
        addr.sin_port = htons(port);
        addr.sin_addr.s_addr = htonl(ip_bits);
        if (connect(s, (struct sockaddr*)&addr, sizeof(addr)) == SOCKET_ERROR) {
            closesocket(s);
            return -1;
        }
        return (int64_t)s;
    #else
        int fd = socket(AF_INET, SOCK_STREAM, 0);
        if (fd < 0) return -1;
        struct sockaddr_in addr;
        memset(&addr, 0, sizeof(addr));
        addr.sin_family = AF_INET;
        addr.sin_port = htons(port);
        addr.sin_addr.s_addr = htonl(ip_bits);
        if (connect(fd, (struct sockaddr*)&addr, sizeof(addr)) < 0) {
            close(fd);
            return -1;
        }
        return (int64_t)fd;
    #endif
}#

@c_include("winsock2.h")
@c_include("ws2tcpip.h")
@c_include("string.h")
@internal
@extern("C")
fun __net_tcp_listen_v4(ip_bits: u32, port: u16, reuse_addr: bool): i64 #{
    #if defined(_WIN32) || defined(_WIN64)
        { static LONG _wsa_rc = 0; if (InterlockedExchangeAdd(&_wsa_rc, 1) == 0) { WSADATA _d; if (WSAStartup(MAKEWORD(2,2), &_d) != 0) { InterlockedDecrement(&_wsa_rc); return -1; } } }
        SOCKET s = socket(AF_INET, SOCK_STREAM, 0);
        if (s == INVALID_SOCKET) return -1;
        if (reuse_addr) {
            BOOL opt = TRUE;
            setsockopt(s, SOL_SOCKET, SO_REUSEADDR, (const char*)&opt, sizeof(opt));
        }
        struct sockaddr_in addr;
        memset(&addr, 0, sizeof(addr));
        addr.sin_family = AF_INET;
        addr.sin_port = htons(port);
        addr.sin_addr.s_addr = htonl(ip_bits);
        if (bind(s, (struct sockaddr*)&addr, sizeof(addr)) == SOCKET_ERROR) {
            closesocket(s);
            return -1;
        }
        if (listen(s, 128) == SOCKET_ERROR) {
            closesocket(s);
            return -1;
        }
        return (int64_t)s;
    #else
        int fd = socket(AF_INET, SOCK_STREAM, 0);
        if (fd < 0) return -1;
        if (reuse_addr) {
            int opt = 1;
            setsockopt(fd, SOL_SOCKET, SO_REUSEADDR, &opt, sizeof(opt));
        }
        struct sockaddr_in addr;
        memset(&addr, 0, sizeof(addr));
        addr.sin_family = AF_INET;
        addr.sin_port = htons(port);
        addr.sin_addr.s_addr = htonl(ip_bits);
        if (bind(fd, (struct sockaddr*)&addr, sizeof(addr)) < 0) {
            close(fd);
            return -1;
        }
        if (listen(fd, 128) < 0) {
            close(fd);
            return -1;
        }
        return (int64_t)fd;
    #endif
}#

@c_include("winsock2.h")
@c_include("ws2tcpip.h")
@internal
@extern("C")
fun __net_tcp_accept(fd: i64): i64 #{
    #if defined(_WIN32) || defined(_WIN64)
        struct sockaddr_in addr;
        int addr_len = sizeof(addr);
        SOCKET client = accept((SOCKET)fd, (struct sockaddr*)&addr, &addr_len);
        if (client == INVALID_SOCKET) return -1;
        return (int64_t)client;
    #else
        struct sockaddr_in addr;
        socklen_t addr_len = sizeof(addr);
        int client_fd = accept((int)fd, (struct sockaddr*)&addr, &addr_len);
        return (int64_t)client_fd;
    #endif
}#

@c_include("winsock2.h")
@internal
@extern("C")
fun __net_tcp_read(fd: i64, buf: u8[], len: usize): i64 #{
    #if defined(_WIN32) || defined(_WIN64)
        int n = recv((SOCKET)fd, (char*)buf_data, (int)buf_len, 0);
        if (n == SOCKET_ERROR) return -1;
        return (int64_t)n;
    #else
        ssize_t n = recv((int)fd, buf_data, buf_len, 0);
        return (int64_t)n;
    #endif
}#

@c_include("winsock2.h")
@internal
@extern("C")
fun __net_tcp_write(fd: i64, buf: u8[], len: usize): i64 #{
    #if defined(_WIN32) || defined(_WIN64)
        int n = send((SOCKET)fd, (const char*)buf_data, (int)buf_len, 0);
        if (n == SOCKET_ERROR) return -1;
        return (int64_t)n;
    #else
        ssize_t n = send((int)fd, buf_data, buf_len, 0);
        return (int64_t)n;
    #endif
}#

@c_include("winsock2.h")
@c_include("unistd.h")
@internal
@extern("C")
fun __net_tcp_close_raw(fd: i64): i32 #{
    #if defined(_WIN32) || defined(_WIN64)
        return closesocket((SOCKET)fd) == 0 ? 0 : -1;
    #else
        return close((int)fd);
    #endif
}#

// ─── UDP IPv4 ──────────────────────────────────────────────────────────

@c_include("winsock2.h")
@c_include("ws2tcpip.h")
@c_include("string.h")
@internal
@extern("C")
fun __net_udp_bind_v4(ip_bits: u32, port: u16, reuse_addr: bool): i64 #{
    #if defined(_WIN32) || defined(_WIN64)
        { static LONG _wsa_rc = 0; if (InterlockedExchangeAdd(&_wsa_rc, 1) == 0) { WSADATA _d; if (WSAStartup(MAKEWORD(2,2), &_d) != 0) { InterlockedDecrement(&_wsa_rc); return -1; } } }
        SOCKET s = socket(AF_INET, SOCK_DGRAM, 0);
        if (s == INVALID_SOCKET) return -1;
        if (reuse_addr) {
            BOOL opt = TRUE;
            setsockopt(s, SOL_SOCKET, SO_REUSEADDR, (const char*)&opt, sizeof(opt));
        }
        struct sockaddr_in addr;
        memset(&addr, 0, sizeof(addr));
        addr.sin_family = AF_INET;
        addr.sin_port = htons(port);
        addr.sin_addr.s_addr = htonl(ip_bits);
        if (bind(s, (struct sockaddr*)&addr, sizeof(addr)) == SOCKET_ERROR) {
            closesocket(s);
            return -1;
        }
        return (int64_t)s;
    #else
        int fd = socket(AF_INET, SOCK_DGRAM, 0);
        if (fd < 0) return -1;
        if (reuse_addr) {
            int opt = 1;
            setsockopt(fd, SOL_SOCKET, SO_REUSEADDR, &opt, sizeof(opt));
        }
        struct sockaddr_in addr;
        memset(&addr, 0, sizeof(addr));
        addr.sin_family = AF_INET;
        addr.sin_port = htons(port);
        addr.sin_addr.s_addr = htonl(ip_bits);
        if (bind(fd, (struct sockaddr*)&addr, sizeof(addr)) < 0) {
            close(fd);
            return -1;
        }
        return (int64_t)fd;
    #endif
}#

@c_include("winsock2.h")
@c_include("ws2tcpip.h")
@c_include("string.h")
@internal
@extern("C")
fun __net_udp_send_to_v4(fd: i64, ip_bits: u32, port: u16, buf: u8[], len: usize): i64 #{
    #if defined(_WIN32) || defined(_WIN64)
        struct sockaddr_in addr;
        memset(&addr, 0, sizeof(addr));
        addr.sin_family = AF_INET;
        addr.sin_port = htons(port);
        addr.sin_addr.s_addr = htonl(ip_bits);
        int n = sendto((SOCKET)fd, (const char*)buf_data, (int)buf_len, 0, (struct sockaddr*)&addr, sizeof(addr));
        if (n == SOCKET_ERROR) return -1;
        return (int64_t)n;
    #else
        struct sockaddr_in addr;
        memset(&addr, 0, sizeof(addr));
        addr.sin_family = AF_INET;
        addr.sin_port = htons(port);
        addr.sin_addr.s_addr = htonl(ip_bits);
        ssize_t n = sendto((int)fd, buf_data, buf_len, 0, (struct sockaddr*)&addr, sizeof(addr));
        return (int64_t)n;
    #endif
}#

@c_include("winsock2.h")
@c_include("ws2tcpip.h")
@internal
@extern("C")
fun __net_udp_recv_from_v4(fd: i64, buf: u8[], len: usize): i64 #{
    #if defined(_WIN32) || defined(_WIN64)
        struct sockaddr_in addr;
        int addr_len = sizeof(addr);
        int n = recvfrom((SOCKET)fd, (char*)buf_data, (int)buf_len, 0, (struct sockaddr*)&addr, &addr_len);
        if (n == SOCKET_ERROR) return -1;
        return (int64_t)n;
    #else
        struct sockaddr_in addr;
        socklen_t addr_len = sizeof(addr);
        ssize_t n = recvfrom((int)fd, buf_data, buf_len, 0, (struct sockaddr*)&addr, &addr_len);
        return (int64_t)n;
    #endif
}#

// ─── DNS resolution (out-buffer mode) ──────────────────────────────────
//
// Low-level scalar capability: the C layer uses getaddrinfo to resolve hostnames and fills the numeric address into out_buf.
// The upper-layer runtime builtin (__net_resolve) calls this primitive, then assembles an IpAddr[] heap object from the buffer.
//
// out_buf layout: each entry is 17 bytes
//   [0..16)  address (first 4 bytes valid when family=4, all 16 bytes valid when family=6)
//   [16]     family (4=IPv4, 6=IPv6)
//
// Return value:
//   >=0  number of addresses actually resolved
//   -1   resolution failed (domain does not exist / network error)
//   -2   out_buf capacity insufficient (needs max_count*17 bytes)
@c_include("winsock2.h")
@c_include("ws2tcpip.h")
@c_include("string.h")
@internal
@extern("C")
fun __net_resolve_into(host: str, out_buf: u8[], max_count: usize): i64 #{
    #if defined(_WIN32) || defined(_WIN64)
        { static LONG _wsa_rc = 0; if (InterlockedExchangeAdd(&_wsa_rc, 1) == 0) { WSADATA _d; if (WSAStartup(MAKEWORD(2,2), &_d) != 0) { InterlockedDecrement(&_wsa_rc); return -1; } } }
    #endif
    struct addrinfo hints;
    memset(&hints, 0, sizeof(hints));
    hints.ai_family = AF_UNSPEC;
    hints.ai_socktype = SOCK_STREAM;
    struct addrinfo* res;
    int err = getaddrinfo(host_data, NULL, &hints, &res);
    if (err != 0) return -1;
    size_t count = 0;
    for (struct addrinfo* p = res; p != NULL; p = p->ai_next) {
        if (count >= max_count) break;
        if (count * 17 + 17 > out_buf_len) { freeaddrinfo(res); return -2; }
        if (p->ai_family == AF_INET) {
            struct sockaddr_in* sa = (struct sockaddr_in*)p->ai_addr;
            uint32_t addr = sa->sin_addr.s_addr;
            memcpy(out_buf_data + count * 17, &addr, 4);
            out_buf_data[count * 17 + 16] = 4;
            count++;
        } else if (p->ai_family == AF_INET6) {
            struct sockaddr_in6* sa = (struct sockaddr_in6*)p->ai_addr;
            memcpy(out_buf_data + count * 17, &sa->sin6_addr.s6_addr, 16);
            out_buf_data[count * 17 + 16] = 6;
            count++;
        }
    }
    freeaddrinfo(res);
    return (int64_t)count;
}#

// ─── IPv6 TCP/UDP primitives ───────────────────────────────────────────
//
// Ipv6Addr is stored big-endian as (hi: u64, lo: u64) on the Frond side.
// The C-side struct in6_addr is a 16-byte array; this layer assembles hi/lo → in6_addr:
//   bytes[0..8)  = hi big-endian
//   bytes[8..16) = lo big-endian

@c_include("winsock2.h")
@c_include("ws2tcpip.h")
@c_include("string.h")
@internal
@extern("C")
fun __net_tcp_connect_v6(ip_hi: u64, ip_lo: u64, port: u16, timeout_ns: i64): i64 #{
    #if defined(_WIN32) || defined(_WIN64)
        { static LONG _wsa_rc = 0; if (InterlockedExchangeAdd(&_wsa_rc, 1) == 0) { WSADATA _d; if (WSAStartup(MAKEWORD(2,2), &_d) != 0) { InterlockedDecrement(&_wsa_rc); return -1; } } }
        SOCKET s = socket(AF_INET6, SOCK_STREAM, 0);
        if (s == INVALID_SOCKET) return -1;
        struct sockaddr_in6 addr;
        memset(&addr, 0, sizeof(addr));
        addr.sin6_family = AF_INET6;
        addr.sin6_port = htons(port);
        addr.sin6_addr.s6_addr[0] = (uint8_t)(ip_hi >> 56);
        addr.sin6_addr.s6_addr[1] = (uint8_t)(ip_hi >> 48);
        addr.sin6_addr.s6_addr[2] = (uint8_t)(ip_hi >> 40);
        addr.sin6_addr.s6_addr[3] = (uint8_t)(ip_hi >> 32);
        addr.sin6_addr.s6_addr[4] = (uint8_t)(ip_hi >> 24);
        addr.sin6_addr.s6_addr[5] = (uint8_t)(ip_hi >> 16);
        addr.sin6_addr.s6_addr[6] = (uint8_t)(ip_hi >> 8);
        addr.sin6_addr.s6_addr[7] = (uint8_t)(ip_hi);
        addr.sin6_addr.s6_addr[8] = (uint8_t)(ip_lo >> 56);
        addr.sin6_addr.s6_addr[9] = (uint8_t)(ip_lo >> 48);
        addr.sin6_addr.s6_addr[10] = (uint8_t)(ip_lo >> 40);
        addr.sin6_addr.s6_addr[11] = (uint8_t)(ip_lo >> 32);
        addr.sin6_addr.s6_addr[12] = (uint8_t)(ip_lo >> 24);
        addr.sin6_addr.s6_addr[13] = (uint8_t)(ip_lo >> 16);
        addr.sin6_addr.s6_addr[14] = (uint8_t)(ip_lo >> 8);
        addr.sin6_addr.s6_addr[15] = (uint8_t)(ip_lo);
        if (connect(s, (struct sockaddr*)&addr, sizeof(addr)) == SOCKET_ERROR) {
            closesocket(s);
            return -1;
        }
        return (int64_t)s;
    #else
        int fd = socket(AF_INET6, SOCK_STREAM, 0);
        if (fd < 0) return -1;
        struct sockaddr_in6 addr;
        memset(&addr, 0, sizeof(addr));
        addr.sin6_family = AF_INET6;
        addr.sin6_port = htons(port);
        addr.sin6_addr.s6_addr[0] = (uint8_t)(ip_hi >> 56);
        addr.sin6_addr.s6_addr[1] = (uint8_t)(ip_hi >> 48);
        addr.sin6_addr.s6_addr[2] = (uint8_t)(ip_hi >> 40);
        addr.sin6_addr.s6_addr[3] = (uint8_t)(ip_hi >> 32);
        addr.sin6_addr.s6_addr[4] = (uint8_t)(ip_hi >> 24);
        addr.sin6_addr.s6_addr[5] = (uint8_t)(ip_hi >> 16);
        addr.sin6_addr.s6_addr[6] = (uint8_t)(ip_hi >> 8);
        addr.sin6_addr.s6_addr[7] = (uint8_t)(ip_hi);
        addr.sin6_addr.s6_addr[8] = (uint8_t)(ip_lo >> 56);
        addr.sin6_addr.s6_addr[9] = (uint8_t)(ip_lo >> 48);
        addr.sin6_addr.s6_addr[10] = (uint8_t)(ip_lo >> 40);
        addr.sin6_addr.s6_addr[11] = (uint8_t)(ip_lo >> 32);
        addr.sin6_addr.s6_addr[12] = (uint8_t)(ip_lo >> 24);
        addr.sin6_addr.s6_addr[13] = (uint8_t)(ip_lo >> 16);
        addr.sin6_addr.s6_addr[14] = (uint8_t)(ip_lo >> 8);
        addr.sin6_addr.s6_addr[15] = (uint8_t)(ip_lo);
        if (connect(fd, (struct sockaddr*)&addr, sizeof(addr)) < 0) {
            close(fd);
            return -1;
        }
        return (int64_t)fd;
    #endif
}#

@c_include("winsock2.h")
@c_include("ws2tcpip.h")
@c_include("string.h")
@internal
@extern("C")
fun __net_tcp_listen_v6(ip_hi: u64, ip_lo: u64, port: u16, reuse_addr: bool): i64 #{
    #if defined(_WIN32) || defined(_WIN64)
        { static LONG _wsa_rc = 0; if (InterlockedExchangeAdd(&_wsa_rc, 1) == 0) { WSADATA _d; if (WSAStartup(MAKEWORD(2,2), &_d) != 0) { InterlockedDecrement(&_wsa_rc); return -1; } } }
        SOCKET s = socket(AF_INET6, SOCK_STREAM, 0);
        if (s == INVALID_SOCKET) return -1;
        if (reuse_addr) {
            BOOL opt = TRUE;
            setsockopt(s, SOL_SOCKET, SO_REUSEADDR, (const char*)&opt, sizeof(opt));
        }
        struct sockaddr_in6 addr;
        memset(&addr, 0, sizeof(addr));
        addr.sin6_family = AF_INET6;
        addr.sin6_port = htons(port);
        addr.sin6_addr.s6_addr[0] = (uint8_t)(ip_hi >> 56);
        addr.sin6_addr.s6_addr[1] = (uint8_t)(ip_hi >> 48);
        addr.sin6_addr.s6_addr[2] = (uint8_t)(ip_hi >> 40);
        addr.sin6_addr.s6_addr[3] = (uint8_t)(ip_hi >> 32);
        addr.sin6_addr.s6_addr[4] = (uint8_t)(ip_hi >> 24);
        addr.sin6_addr.s6_addr[5] = (uint8_t)(ip_hi >> 16);
        addr.sin6_addr.s6_addr[6] = (uint8_t)(ip_hi >> 8);
        addr.sin6_addr.s6_addr[7] = (uint8_t)(ip_hi);
        addr.sin6_addr.s6_addr[8] = (uint8_t)(ip_lo >> 56);
        addr.sin6_addr.s6_addr[9] = (uint8_t)(ip_lo >> 48);
        addr.sin6_addr.s6_addr[10] = (uint8_t)(ip_lo >> 40);
        addr.sin6_addr.s6_addr[11] = (uint8_t)(ip_lo >> 32);
        addr.sin6_addr.s6_addr[12] = (uint8_t)(ip_lo >> 24);
        addr.sin6_addr.s6_addr[13] = (uint8_t)(ip_lo >> 16);
        addr.sin6_addr.s6_addr[14] = (uint8_t)(ip_lo >> 8);
        addr.sin6_addr.s6_addr[15] = (uint8_t)(ip_lo);
        if (bind(s, (struct sockaddr*)&addr, sizeof(addr)) == SOCKET_ERROR) {
            closesocket(s);
            return -1;
        }
        if (listen(s, 128) == SOCKET_ERROR) {
            closesocket(s);
            return -1;
        }
        return (int64_t)s;
    #else
        int fd = socket(AF_INET6, SOCK_STREAM, 0);
        if (fd < 0) return -1;
        if (reuse_addr) {
            int opt = 1;
            setsockopt(fd, SOL_SOCKET, SO_REUSEADDR, &opt, sizeof(opt));
        }
        struct sockaddr_in6 addr;
        memset(&addr, 0, sizeof(addr));
        addr.sin6_family = AF_INET6;
        addr.sin6_port = htons(port);
        addr.sin6_addr.s6_addr[0] = (uint8_t)(ip_hi >> 56);
        addr.sin6_addr.s6_addr[1] = (uint8_t)(ip_hi >> 48);
        addr.sin6_addr.s6_addr[2] = (uint8_t)(ip_hi >> 40);
        addr.sin6_addr.s6_addr[3] = (uint8_t)(ip_hi >> 32);
        addr.sin6_addr.s6_addr[4] = (uint8_t)(ip_hi >> 24);
        addr.sin6_addr.s6_addr[5] = (uint8_t)(ip_hi >> 16);
        addr.sin6_addr.s6_addr[6] = (uint8_t)(ip_hi >> 8);
        addr.sin6_addr.s6_addr[7] = (uint8_t)(ip_hi);
        addr.sin6_addr.s6_addr[8] = (uint8_t)(ip_lo >> 56);
        addr.sin6_addr.s6_addr[9] = (uint8_t)(ip_lo >> 48);
        addr.sin6_addr.s6_addr[10] = (uint8_t)(ip_lo >> 40);
        addr.sin6_addr.s6_addr[11] = (uint8_t)(ip_lo >> 32);
        addr.sin6_addr.s6_addr[12] = (uint8_t)(ip_lo >> 24);
        addr.sin6_addr.s6_addr[13] = (uint8_t)(ip_lo >> 16);
        addr.sin6_addr.s6_addr[14] = (uint8_t)(ip_lo >> 8);
        addr.sin6_addr.s6_addr[15] = (uint8_t)(ip_lo);
        if (bind(fd, (struct sockaddr*)&addr, sizeof(addr)) < 0) {
            close(fd);
            return -1;
        }
        if (listen(fd, 128) < 0) {
            close(fd);
            return -1;
        }
        return (int64_t)fd;
    #endif
}#

// __net_tcp_accept is generic (shared by v4/v6), read/write/close are also generic, no v6 version needed

@c_include("winsock2.h")
@c_include("ws2tcpip.h")
@c_include("string.h")
@internal
@extern("C")
fun __net_udp_bind_v6(ip_hi: u64, ip_lo: u64, port: u16, reuse_addr: bool): i64 #{
    #if defined(_WIN32) || defined(_WIN64)
        { static LONG _wsa_rc = 0; if (InterlockedExchangeAdd(&_wsa_rc, 1) == 0) { WSADATA _d; if (WSAStartup(MAKEWORD(2,2), &_d) != 0) { InterlockedDecrement(&_wsa_rc); return -1; } } }
        SOCKET s = socket(AF_INET6, SOCK_DGRAM, 0);
        if (s == INVALID_SOCKET) return -1;
        if (reuse_addr) {
            BOOL opt = TRUE;
            setsockopt(s, SOL_SOCKET, SO_REUSEADDR, (const char*)&opt, sizeof(opt));
        }
        struct sockaddr_in6 addr;
        memset(&addr, 0, sizeof(addr));
        addr.sin6_family = AF_INET6;
        addr.sin6_port = htons(port);
        addr.sin6_addr.s6_addr[0] = (uint8_t)(ip_hi >> 56);
        addr.sin6_addr.s6_addr[1] = (uint8_t)(ip_hi >> 48);
        addr.sin6_addr.s6_addr[2] = (uint8_t)(ip_hi >> 40);
        addr.sin6_addr.s6_addr[3] = (uint8_t)(ip_hi >> 32);
        addr.sin6_addr.s6_addr[4] = (uint8_t)(ip_hi >> 24);
        addr.sin6_addr.s6_addr[5] = (uint8_t)(ip_hi >> 16);
        addr.sin6_addr.s6_addr[6] = (uint8_t)(ip_hi >> 8);
        addr.sin6_addr.s6_addr[7] = (uint8_t)(ip_hi);
        addr.sin6_addr.s6_addr[8] = (uint8_t)(ip_lo >> 56);
        addr.sin6_addr.s6_addr[9] = (uint8_t)(ip_lo >> 48);
        addr.sin6_addr.s6_addr[10] = (uint8_t)(ip_lo >> 40);
        addr.sin6_addr.s6_addr[11] = (uint8_t)(ip_lo >> 32);
        addr.sin6_addr.s6_addr[12] = (uint8_t)(ip_lo >> 24);
        addr.sin6_addr.s6_addr[13] = (uint8_t)(ip_lo >> 16);
        addr.sin6_addr.s6_addr[14] = (uint8_t)(ip_lo >> 8);
        addr.sin6_addr.s6_addr[15] = (uint8_t)(ip_lo);
        if (bind(s, (struct sockaddr*)&addr, sizeof(addr)) == SOCKET_ERROR) {
            closesocket(s);
            return -1;
        }
        return (int64_t)s;
    #else
        int fd = socket(AF_INET6, SOCK_DGRAM, 0);
        if (fd < 0) return -1;
        if (reuse_addr) {
            int opt = 1;
            setsockopt(fd, SOL_SOCKET, SO_REUSEADDR, &opt, sizeof(opt));
        }
        struct sockaddr_in6 addr;
        memset(&addr, 0, sizeof(addr));
        addr.sin6_family = AF_INET6;
        addr.sin6_port = htons(port);
        addr.sin6_addr.s6_addr[0] = (uint8_t)(ip_hi >> 56);
        addr.sin6_addr.s6_addr[1] = (uint8_t)(ip_hi >> 48);
        addr.sin6_addr.s6_addr[2] = (uint8_t)(ip_hi >> 40);
        addr.sin6_addr.s6_addr[3] = (uint8_t)(ip_hi >> 32);
        addr.sin6_addr.s6_addr[4] = (uint8_t)(ip_hi >> 24);
        addr.sin6_addr.s6_addr[5] = (uint8_t)(ip_hi >> 16);
        addr.sin6_addr.s6_addr[6] = (uint8_t)(ip_hi >> 8);
        addr.sin6_addr.s6_addr[7] = (uint8_t)(ip_hi);
        addr.sin6_addr.s6_addr[8] = (uint8_t)(ip_lo >> 56);
        addr.sin6_addr.s6_addr[9] = (uint8_t)(ip_lo >> 48);
        addr.sin6_addr.s6_addr[10] = (uint8_t)(ip_lo >> 40);
        addr.sin6_addr.s6_addr[11] = (uint8_t)(ip_lo >> 32);
        addr.sin6_addr.s6_addr[12] = (uint8_t)(ip_lo >> 24);
        addr.sin6_addr.s6_addr[13] = (uint8_t)(ip_lo >> 16);
        addr.sin6_addr.s6_addr[14] = (uint8_t)(ip_lo >> 8);
        addr.sin6_addr.s6_addr[15] = (uint8_t)(ip_lo);
        if (bind(fd, (struct sockaddr*)&addr, sizeof(addr)) < 0) {
            close(fd);
            return -1;
        }
        return (int64_t)fd;
    #endif
}#

@c_include("winsock2.h")
@c_include("ws2tcpip.h")
@c_include("string.h")
@internal
@extern("C")
fun __net_udp_send_to_v6(fd: i64, ip_hi: u64, ip_lo: u64, port: u16, buf: u8[], len: usize): i64 #{
    #if defined(_WIN32) || defined(_WIN64)
        struct sockaddr_in6 addr;
        memset(&addr, 0, sizeof(addr));
        addr.sin6_family = AF_INET6;
        addr.sin6_port = htons(port);
        addr.sin6_addr.s6_addr[0] = (uint8_t)(ip_hi >> 56);
        addr.sin6_addr.s6_addr[1] = (uint8_t)(ip_hi >> 48);
        addr.sin6_addr.s6_addr[2] = (uint8_t)(ip_hi >> 40);
        addr.sin6_addr.s6_addr[3] = (uint8_t)(ip_hi >> 32);
        addr.sin6_addr.s6_addr[4] = (uint8_t)(ip_hi >> 24);
        addr.sin6_addr.s6_addr[5] = (uint8_t)(ip_hi >> 16);
        addr.sin6_addr.s6_addr[6] = (uint8_t)(ip_hi >> 8);
        addr.sin6_addr.s6_addr[7] = (uint8_t)(ip_hi);
        addr.sin6_addr.s6_addr[8] = (uint8_t)(ip_lo >> 56);
        addr.sin6_addr.s6_addr[9] = (uint8_t)(ip_lo >> 48);
        addr.sin6_addr.s6_addr[10] = (uint8_t)(ip_lo >> 40);
        addr.sin6_addr.s6_addr[11] = (uint8_t)(ip_lo >> 32);
        addr.sin6_addr.s6_addr[12] = (uint8_t)(ip_lo >> 24);
        addr.sin6_addr.s6_addr[13] = (uint8_t)(ip_lo >> 16);
        addr.sin6_addr.s6_addr[14] = (uint8_t)(ip_lo >> 8);
        addr.sin6_addr.s6_addr[15] = (uint8_t)(ip_lo);
        int n = sendto((SOCKET)fd, (const char*)buf_data, (int)buf_len, 0, (struct sockaddr*)&addr, sizeof(addr));
        if (n == SOCKET_ERROR) return -1;
        return (int64_t)n;
    #else
        struct sockaddr_in6 addr;
        memset(&addr, 0, sizeof(addr));
        addr.sin6_family = AF_INET6;
        addr.sin6_port = htons(port);
        addr.sin6_addr.s6_addr[0] = (uint8_t)(ip_hi >> 56);
        addr.sin6_addr.s6_addr[1] = (uint8_t)(ip_hi >> 48);
        addr.sin6_addr.s6_addr[2] = (uint8_t)(ip_hi >> 40);
        addr.sin6_addr.s6_addr[3] = (uint8_t)(ip_hi >> 32);
        addr.sin6_addr.s6_addr[4] = (uint8_t)(ip_hi >> 24);
        addr.sin6_addr.s6_addr[5] = (uint8_t)(ip_hi >> 16);
        addr.sin6_addr.s6_addr[6] = (uint8_t)(ip_hi >> 8);
        addr.sin6_addr.s6_addr[7] = (uint8_t)(ip_hi);
        addr.sin6_addr.s6_addr[8] = (uint8_t)(ip_lo >> 56);
        addr.sin6_addr.s6_addr[9] = (uint8_t)(ip_lo >> 48);
        addr.sin6_addr.s6_addr[10] = (uint8_t)(ip_lo >> 40);
        addr.sin6_addr.s6_addr[11] = (uint8_t)(ip_lo >> 32);
        addr.sin6_addr.s6_addr[12] = (uint8_t)(ip_lo >> 24);
        addr.sin6_addr.s6_addr[13] = (uint8_t)(ip_lo >> 16);
        addr.sin6_addr.s6_addr[14] = (uint8_t)(ip_lo >> 8);
        addr.sin6_addr.s6_addr[15] = (uint8_t)(ip_lo);
        ssize_t n = sendto((int)fd, buf_data, buf_len, 0, (struct sockaddr*)&addr, sizeof(addr));
        return (int64_t)n;
    #endif
}#

@c_include("winsock2.h")
@c_include("ws2tcpip.h")
@internal
@extern("C")
fun __net_udp_recv_from_v6(fd: i64, buf: u8[], len: usize): i64 #{
    #if defined(_WIN32) || defined(_WIN64)
        struct sockaddr_in6 addr;
        int addr_len = sizeof(addr);
        int n = recvfrom((SOCKET)fd, (char*)buf_data, (int)buf_len, 0, (struct sockaddr*)&addr, &addr_len);
        if (n == SOCKET_ERROR) return -1;
        return (int64_t)n;
    #else
        struct sockaddr_in6 addr;
        socklen_t addr_len = sizeof(addr);
        ssize_t n = recvfrom((int)fd, buf_data, buf_len, 0, (struct sockaddr*)&addr, &addr_len);
        return (int64_t)n;
    #endif
}#
