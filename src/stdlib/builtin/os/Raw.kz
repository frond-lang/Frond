// builtin/os/Raw.kz — OS process-environment primitives @extern("C") declarations
//
// Covers the process-environment domain (everything that is NOT file-system
// related — that lives in builtin/io): environment variables, tty detection,
// process id/exit, working directory, host identification.
// Cross-platform logic is implemented in the C body via #if conditional compilation.
// Called by wrappers in std/os/*.
//
// Out-buffer convention (shared with the io Raw primitives):
//   __*_into functions fill `buf` and return the byte length written;
//   -1 = not found / failure, -2 = buffer too small.

@c_include("stdlib.h")
@c_include("string.h")
@internal
@extern("C")
fun __os_env_get_into(key: str, buf: u8[]): i64 #{
    #if defined(_WIN32) || defined(_WIN64)
        DWORD n = GetEnvironmentVariableA(key_data, (LPSTR)buf_data, (DWORD)buf_len);
        if (n == 0) {
            return GetLastError() == ERROR_ENVVAR_NOT_FOUND ? -1 : 0;
        }
        if (n >= buf_len) return -2;  // needs n+1 bytes incl. NUL
        return (int64_t)n;
    #else
        const char* v = getenv(key_data);
        if (!v) return -1;
        size_t n = strlen(v);
        if (n >= buf_len) return -2;
        memcpy(buf_data, v, n);
        return (int64_t)n;
    #endif
}#

@c_include("stdlib.h")
@internal
@extern("C")
fun __os_env_set(key: str, value: str): i32 #{
    #if defined(_WIN32) || defined(_WIN64)
        return _putenv_s(key_data, value_data) == 0 ? 0 : -1;
    #else
        return setenv(key_data, value_data, 1) == 0 ? 0 : -1;
    #endif
}#

@c_include("stdlib.h")
@internal
@extern("C")
fun __os_env_remove(key: str): i32 #{
    #if defined(_WIN32) || defined(_WIN64)
        // Setting an empty value removes the variable on Windows
        return _putenv_s(key_data, "") == 0 ? 0 : -1;
    #else
        return unsetenv(key_data) == 0 ? 0 : -1;
    #endif
}#

@c_include("io.h")
@c_include("windows.h")
@c_include("unistd.h")
@internal
@extern("C")
fun __os_is_tty(fd: i32): i32 #{
    #if defined(_WIN32) || defined(_WIN64)
        // _isatty misclassifies ANY character device (NUL, printers) as a tty.
        // Only real consoles support GetConsoleMode — use that as the test.
        HANDLE h = (HANDLE)_get_osfhandle(fd);
        DWORD mode;
        return GetConsoleMode(h, &mode) ? 1 : 0;
    #else
        return isatty(fd);
    #endif
}#

@c_include("windows.h")
@c_include("process.h")
@c_include("unistd.h")
@internal
@extern("C")
fun __os_getpid(): i64 #{
    #if defined(_WIN32) || defined(_WIN64)
        return (int64_t)GetCurrentProcessId();
    #else
        return (int64_t)getpid();
    #endif
}#

// Hard termination of the current process. Note: Frond `defer` blocks do NOT
// run and buffered output is NOT flushed on this path (same semantics as the
// C exit()). For graceful shutdown, return from main instead.
@c_include("stdlib.h")
@internal
@extern("C")
fun __os_exit(code: i32): void #{
    exit(code);
}#

@c_include("direct.h")
@c_include("unistd.h")
@internal
@extern("C")
fun __os_cwd_into(buf: u8[]): i64 #{
    #if defined(_WIN32) || defined(_WIN64)
        if (_getcwd((char*)buf_data, (int)buf_len) == NULL) return -1;
    #else
        if (getcwd((char*)buf_data, buf_len) == NULL) return -1;
    #endif
        return (int64_t)strlen((const char*)buf_data);
}#

@c_include("direct.h")
@c_include("unistd.h")
@internal
@extern("C")
fun __os_set_cwd(path: str): i32 #{
    #if defined(_WIN32) || defined(_WIN64)
        return _chdir(path_data) == 0 ? 0 : -1;
    #else
        return chdir(path_data) == 0 ? 0 : -1;
    #endif
}#

@c_include("windows.h")
@c_include("unistd.h")
@internal
@extern("C")
fun __os_hostname_into(buf: u8[]): i64 #{
    #if defined(_WIN32) || defined(_WIN64)
        DWORD n = (DWORD)buf_len;
        if (!GetComputerNameA((LPSTR)buf_data, &n)) return -1;
        return (int64_t)n;
    #else
        if (gethostname((char*)buf_data, buf_len) != 0) return -1;
        return (int64_t)strlen((char*)buf_data);
    #endif
}#

@c_include("string.h")
@internal
@extern("C")
fun __os_platform_into(buf: u8[]): i64 #{
    #if defined(_WIN32) || defined(_WIN64)
        const char* s = "windows";
    #elif defined(__APPLE__)
        const char* s = "macos";
    #elif defined(__linux__)
        const char* s = "linux";
    #else
        const char* s = "unknown";
    #endif
        size_t n = strlen(s);
        if (n >= buf_len) return -2;
        memcpy(buf_data, s, n);
        return (int64_t)n;
}#

@c_include("string.h")
@internal
@extern("C")
fun __os_arch_into(buf: u8[]): i64 #{
    #if defined(_M_X64) || defined(__x86_64__)
        const char* s = "x86_64";
    #elif defined(_M_ARM64) || defined(__aarch64__)
        const char* s = "aarch64";
    #elif defined(_M_IX86) || defined(__i386__)
        const char* s = "x86";
    #elif defined(_M_ARM) || defined(__arm__)
        const char* s = "arm";
    #else
        const char* s = "unknown";
    #endif
        size_t n = strlen(s);
        if (n >= buf_len) return -2;
        memcpy(buf_data, s, n);
        return (int64_t)n;
}#

// Run a shell command through the system shell, blocking until completion.
// Returns the exit code; -1 = the shell could not be launched.
// (POSIX: normalizes the wait status via WEXITSTATUS.)
@c_include("stdlib.h")
@c_include("sys/wait.h")
@internal
@extern("C")
fun __os_system(cmd: str): i32 #{
    #if defined(_WIN32) || defined(_WIN64)
        return system(cmd_data);
    #else
        int st = system(cmd_data);
        if (st == -1) return -1;
        if (WIFEXITED(st)) return WEXITSTATUS(st);
        return -1;
    #endif
}#
